import selfhost::backend::compiled_abi_params;
import selfhost::backend::compiled_canonical_facts;
import selfhost::backend::compiled_instance_context;
import selfhost::backend::compiled_llvm;
import selfhost::backend::compiled_signature;
import selfhost::backend::fact_tokens;
import selfhost::backend::ir_index;
import selfhost::ir::executable_functions;
import selfhost::ir::package_function_identity;
import selfhost::parser;
import selfhost::source;

struct PackageIdentityBounds {
    component_count: i64,
    function_count: i64,
}

fn package_identity_bounds(
    lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8
) -> !PackageIdentityBounds {
    let prefix = "package-identity-bounds ";
    let entry = ir_index::first_entry_with_fact_prefix(lookup_index, ir_bytes, prefix);
    if entry < 0 or !ir_index::entry_key_starts_with(lookup_index, ir_bytes, entry, prefix) {
        return error("package identity bounds missing");
    }
    let start = ir_index::entry_line_start(lookup_index, entry) + std::mem::len(prefix);
    let end = ir_index::entry_line_end(lookup_index, entry);
    let split = fact_tokens::token_end(ir_bytes, start, end);
    let component_count = try fact_tokens::parse_nonnegative_i64(ir_bytes, start, split);
    let function_count = try fact_tokens::parse_nonnegative_i64(ir_bytes, split + 1, end);
    if component_count <= 0 or function_count <= 0 {
        return error("package identity bounds invalid");
    }
    let next_entry = entry + 1;
    if ir_index::entry_key_starts_with(lookup_index, ir_bytes, next_entry, prefix) {
        return error("duplicate package identity bounds");
    }
    return PackageIdentityBounds {
        component_count: component_count,
        function_count: function_count
    };
}

pub fn dependency_record_from_line(bytes: []u8) -> !package_function_identity::DependencyRecord {
    let prefix_len = std::mem::len("package-dependency ");
    var start = prefix_len;
    let a_end = fact_tokens::token_end(bytes, start, std::mem::len(bytes));
    let caller_component = try fact_tokens::parse_nonnegative_i64(bytes, start, a_end);
    start = a_end + 1;
    let b_end = fact_tokens::token_end(bytes, start, std::mem::len(bytes));
    let caller_function = try fact_tokens::parse_nonnegative_i64(bytes, start, b_end);
    start = b_end + 1;
    let c_end = fact_tokens::token_end(bytes, start, std::mem::len(bytes));
    let target_component = try fact_tokens::parse_nonnegative_i64(bytes, start, c_end);
    start = c_end + 1;
    return package_function_identity::DependencyRecord {
        caller_component_id: caller_component,
        caller_function_id: caller_function,
        target_component_id: target_component,
        target_function_id: try fact_tokens::parse_nonnegative_i64(
            bytes, start, std::mem::len(bytes)
        )
    };
}

fn append_numeric_target_facts(index: &ir_index::IrIndex, ir_bytes: []u8, prefix: []u8, components: &var std::array::Array<i64>, functions: &var std::array::Array<i64>) -> !void {
    var entry = ir_index::first_entry_with_fact_prefix(index, ir_bytes, prefix);
    while entry >= 0 and ir_index::entry_key_starts_with(index, ir_bytes, entry, prefix) {
        let start = ir_index::entry_line_start(index, entry) + std::mem::len(prefix);
        let end = ir_index::entry_line_end(index, entry);
        let split = fact_tokens::token_end(ir_bytes, start, end);
        try components.append(try fact_tokens::parse_nonnegative_i64(
            ir_bytes, start, split
        ));
        try functions.append(try fact_tokens::parse_nonnegative_i64(
            ir_bytes, split + 1, end
        ));
        entry = entry + 1;
    }
    return;
}

// numeric_target_index finds one numeric (component, function) identity in the
// sparse package target facts. Function IDs are global-catalog IDs, so a dense
// component_count * function_count table allocates mostly impossible pairs.
// function_stride keeps the pair comparison collision-free after the caller's
// product-overflow check without making that Cartesian product an allocation size.
fn numeric_target_index(
    components: &std::array::Array<i64>,
    functions: &std::array::Array<i64>,
    function_stride: i64,
    component: i64,
    function: i64
) -> !i64 {
    let target_identity = component * function_stride + function;
    var index = 0;
    while index < components.len() {
        let candidate_identity = try components.get(index) * function_stride +
            try functions.get(index);
        if candidate_identity == target_identity { return index; }
        index = index + 1;
    }
    return -1;
}

fn exact_named_fact_count(index: &ir_index::IrIndex, ir_bytes: []u8, prefix: []u8, name: []u8) -> i64 {
    var entry = ir_index::first_matching_entry(index, ir_bytes, prefix, "", name);
    var count = 0;
    while ir_index::entry_matches_query(index, ir_bytes, entry, prefix, "", name) {
        if ir_index::entry_key_end(index, entry) ==
            ir_index::entry_line_start(index, entry) + std::mem::len(prefix) + std::mem::len(name) {
            count = count + 1;
        }
        entry = entry + 1;
    }
    return count;
}

fn emit_numeric_package_definition(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    target_component: i64,
    target_function: i64,
    name: []u8
) -> !void {
    let type_parameter_count = exact_named_fact_count(
        lookup_index, ir_bytes, "function-type-parameter ", name
    );
    var next_instance_id = try compiled_instance_context::next_instance_id(
        lookup_index, ir_bytes, target_component, target_function, -1
    );
    if next_instance_id >= 0 {
        while next_instance_id >= 0 {
            try emit_numeric_package_instance(
                out,
                lookup_index,
                canonical_facts,
                ir_bytes,
                target_component,
                target_function,
                name,
                next_instance_id,
                type_parameter_count
            );
            next_instance_id = try compiled_instance_context::next_instance_id(
                lookup_index,
                ir_bytes,
                target_component,
                target_function,
                next_instance_id
            );
        }
        return;
    }
    if type_parameter_count > 0 {
        return error("package generic definition has no concrete function instance");
    }
    if exact_named_fact_count(lookup_index, ir_bytes, "function-signature-return ", name) != 1 or
        exact_named_fact_count(lookup_index, ir_bytes, "body-node ", name) == 0 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("package numeric definition signature or body missing or duplicate: ");
        try message.append_bytes(name);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    var params_spec = std::string::String(std::mem::page_allocator());
    defer params_spec.deinit();
    try compiled_abi_params::append_params_spec_indexed(
        lookup_index, &var params_spec, ir_bytes, name
    );
    var llvm_symbol = std::string::String(std::mem::page_allocator());
    defer llvm_symbol.deinit();
    try compiled_signature::append_function_llvm_symbol(&var llvm_symbol, name);
    let params = params_spec.as_bytes();
    let symbol = llvm_symbol.as_bytes();
    try compiled_llvm::append_compiled_function_auto_indexed(
        lookup_index, canonical_facts, out, ir_bytes, name, symbol, params
    );
    return;
}

fn emit_numeric_package_instance(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    target_component: i64,
    target_function: i64,
    name: []u8,
    instance_id: i64,
    type_parameter_count: i64
) -> !void {
    var context = try compiled_instance_context::load(
        std::mem::page_allocator(),
        lookup_index,
        ir_bytes,
        target_component,
        target_function,
        instance_id,
        type_parameter_count
    );
    defer context.deinit();
    try compiled_canonical_facts::validate_instance_context(
        canonical_facts, &context
    );
    if !context.requires_body { return; }
    var instance_params = std::string::String(std::mem::page_allocator());
    defer instance_params.deinit();
    try compiled_abi_params::append_params_spec_instance_indexed(
        lookup_index, canonical_facts, &context, &var instance_params,
        ir_bytes, name
    );
    let instance_symbol = try compiled_instance_context::symbol(
        lookup_index, ir_bytes, &context
    );
    let return_type_id =
        try compiled_signature::instance_return_canonical_type_id_indexed(
            lookup_index, canonical_facts, &context, ir_bytes, name
        );
    let return_bytes = try compiled_canonical_facts::parsed_canonical_runtime_abi(
        lookup_index, canonical_facts, ir_bytes, return_type_id
    );
    let params_bytes = instance_params.as_bytes();
    return compiled_llvm::append_compiled_function_auto_return_instance_indexed(
        lookup_index, canonical_facts, &context, out, ir_bytes, name,
        &instance_symbol, return_bytes, &params_bytes
    );
}

pub fn generic_callsite_lowering_gate() -> !void {
    let facts = "canonical-type 0 intrinsic i64 6 -1 0
function-instance 7 11 0 callsite 1 1 0 0 -1 -1
function-instance-result 7 11 0 0";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var canonical = try compiled_canonical_facts::parse_and_validate(
        &index, facts
    );
    defer canonical.deinit();
    var context = try compiled_instance_context::load(
        std::mem::page_allocator(),
        &index,
        facts,
        7,
        11,
        0,
        1
    );
    defer context.deinit();
    std::testing::expect(!context.requires_body);
    print("generic-callsite-lowering-ok");
    return;
}

pub fn missing_generic_callsite_lowering_gate() -> !void {
    let facts = "canonical-type 0 intrinsic i64 6 -1 0";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var canonical = try compiled_canonical_facts::parse_and_validate(
        &index, facts
    );
    defer canonical.deinit();
    if try compiled_instance_context::next_instance_id(
        &index, facts, 7, 11, -1
    ) < 0 {
        return error("package generic definition has no concrete function instance");
    }
    return error("missing generic instance gate unexpectedly found an instance");
}

pub fn formal_generic_callsite_lowering_gate() -> !void {
    let facts = "canonical-type 0 intrinsic i64 6 -1 0
function-instance 7 11 0 body 1 1 0 0 -1 -1
function-instance-result 7 11 0 0";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var canonical = try compiled_canonical_facts::parse_and_validate(
        &index, facts
    );
    defer canonical.deinit();
    var context = try compiled_instance_context::load(
        std::mem::page_allocator(),
        &index,
        facts,
        7,
        11,
        0,
        1
    );
    defer context.deinit();
    if !context.requires_body {
        return error("generic body instance gate unexpectedly used callsite lowering");
    }
    print("generic-body-instance-ok");
    return;
}

pub fn generic_identity_instances_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let text = "fn identity<T>(value: T) -> T { return value; }
fn use_i64(value: i64) -> i64 { return identity<i64>(value); }
fn use_bool(value: bool) -> bool { return identity<bool>(value); }
";
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(source::SourceFile {
        id: 0,
        kind: source::SourceKind::User,
        package_name: "app",
        module_start: 0,
        module_end: 7,
        path: "generic",
        text: text
    });
    var parsed = try parser::parse_source_files(allocator, &files);
    var roots = std::array::Array<executable_functions::SourceFunctionRoot>(
        allocator
    );
    defer roots.deinit();
    let i64_start = try gate_find_bytes(text, "use_i64");
    let bool_start = try gate_find_bytes(text, "use_bool");
    try roots.append(executable_functions::SourceFunctionRoot {
        source_id: 0,
        name_start: i64_start,
        name_end: i64_start + std::mem::len("use_i64")
    });
    try roots.append(executable_functions::SourceFunctionRoot {
        source_id: 0,
        name_start: bool_start,
        name_end: bool_start + std::mem::len("use_bool")
    });
    var facts = std::string::String(allocator);
    defer facts.deinit();
    let fact_result = executable_functions::append_source_root_facts(
        allocator, &var facts, &files, &parsed, &roots
    );
    try parser::deinit_parsed_source_files(parsed);
    try fact_result;
    let fact_bytes = facts.as_bytes();
    try emit_generic_identity_gate_facts(&fact_bytes);
    return;
}

fn emit_generic_identity_gate_facts(
    fact_bytes: &[]u8
) -> !void {
    let allocator = std::mem::page_allocator();
    var index = try ir_index::build(fact_bytes.*);
    defer index.deinit();
    var canonical = try compiled_canonical_facts::parse_and_validate(
        &index, fact_bytes.*
    );
    defer canonical.deinit();
    var out = std::string::String(allocator);
    defer out.deinit();
    let emitted = try append_reachable_functions(
        &var out, &index, &canonical, fact_bytes.*
    );
    if emitted != 3 {
        return error("generic identity gate reachable definition count mismatch");
    }
    let bytes = out.as_bytes();
    print(bytes);
    return;
}

fn gate_find_bytes(haystack: []u8, needle: []u8) -> !i64 {
    var start = 0;
    while start + std::mem::len(needle) <= std::mem::len(haystack) {
        if std::mem::equal_bytes(
            haystack[start..start + std::mem::len(needle)], needle
        ) {
            return start;
        }
        start = start + 1;
    }
    return error("generic identity gate function name missing");
}

// append_reachable_functions validates the numeric package closure and emits each
// reachable definition using the caller-owned index and canonical fact table.
// It never reparses either structure.
pub fn append_reachable_functions(
    out: &var std::string::String,
    lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8
) -> !i64 {
    let allocator = std::mem::page_allocator();
    let bounds = try package_identity_bounds(lookup_index, ir_bytes);
    let component_count = bounds.component_count;
    let function_count = bounds.function_count;
    let prefix = "package-dependency ";
    var caller_components = std::array::Array<i64>(allocator);
    defer caller_components.deinit();
    var caller_functions = std::array::Array<i64>(allocator);
    defer caller_functions.deinit();
    var target_components = std::array::Array<i64>(allocator);
    defer target_components.deinit();
    var target_functions = std::array::Array<i64>(allocator);
    defer target_functions.deinit();
    var entry = ir_index::first_entry_with_fact_prefix(lookup_index, ir_bytes, prefix);
    while entry >= 0 and ir_index::entry_key_starts_with(lookup_index, ir_bytes, entry, prefix) {
        let line = ir_bytes[ir_index::entry_line_start(lookup_index, entry)..ir_index::entry_line_end(lookup_index, entry)];
        let dependency = try dependency_record_from_line(line);
        try caller_components.append(dependency.caller_component_id);
        try caller_functions.append(dependency.caller_function_id);
        try target_components.append(dependency.target_component_id);
        try target_functions.append(dependency.target_function_id);
        if dependency.caller_component_id < 0 or dependency.caller_component_id >= component_count or
            dependency.target_component_id < 0 or dependency.target_component_id >= component_count or
            dependency.caller_function_id < 0 or dependency.caller_function_id >= function_count or
            dependency.target_function_id < 0 or dependency.target_function_id >= function_count {
            return error("package dependency numeric ID out of bounds");
        }
        entry = entry + 1;
    }
    var definition_components = std::array::Array<i64>(allocator);
    defer definition_components.deinit();
    var definition_functions = std::array::Array<i64>(allocator);
    defer definition_functions.deinit();
    var reference_components = std::array::Array<i64>(allocator);
    defer reference_components.deinit();
    var reference_functions = std::array::Array<i64>(allocator);
    defer reference_functions.deinit();
    try append_numeric_target_facts(lookup_index, ir_bytes, "package-definition ", &var definition_components, &var definition_functions);
    try append_numeric_target_facts(lookup_index, ir_bytes, "package-reference ", &var reference_components, &var reference_functions);
    var fact = 0;
    while fact < definition_components.len() {
        let component = try definition_components.get(fact);
        let function = try definition_functions.get(fact);
        if component < 0 or component >= component_count or function < 0 or function >= function_count {
            return error("package definition numeric ID invalid");
        }
        fact = fact + 1;
    }
    fact = 0;
    while fact < reference_components.len() {
        let component = try reference_components.get(fact);
        let function = try reference_functions.get(fact);
        if component < 0 or component >= component_count or function < 0 or function >= function_count {
            return error("package reference numeric ID invalid");
        }
        fact = fact + 1;
    }
    let function_stride = function_count;
    if component_count > 9223372036854775807 / function_stride {
        return error("package identity table size overflow");
    }
    if definition_components.len() > 9223372036854775807 - reference_components.len() {
        return error("package identity table size overflow");
    }
    // Allocate only records represented by definition/reference facts. The full
    // catalog IDs are intentionally sparse, so their Cartesian product is not
    // bounded by (and need not fit within) this focused fact input.
    let identity_slot_count = definition_components.len() + reference_components.len();
    if identity_slot_count > std::mem::len(ir_bytes) {
        return error("package identity table exceeds fact input");
    }
    var name_starts = std::array::Array<i64>(allocator);
    defer name_starts.deinit();
    var name_ends = std::array::Array<i64>(allocator);
    defer name_ends.deinit();
    var name_counts = std::array::Array<i64>(allocator);
    defer name_counts.deinit();
    var mapped_name_slots = std::array::Array<i64>(allocator);
    defer mapped_name_slots.deinit();
    fact = 0;
    while fact < definition_components.len() {
        let component = try definition_components.get(fact);
        let function = try definition_functions.get(fact);
        let definition_slot = try numeric_target_index(
            &definition_components, &definition_functions, function_stride, component, function
        );
        if definition_slot != fact {
            return error("duplicate package numeric definition owner");
        }
        try name_starts.append(0);
        try name_ends.append(0);
        try name_counts.append(0);
        fact = fact + 1;
    }
    let name_prefix = "package-definition-name ";
    var name_entry = ir_index::first_entry_with_fact_prefix(lookup_index, ir_bytes, name_prefix);
    while name_entry >= 0 and ir_index::entry_key_starts_with(lookup_index, ir_bytes, name_entry, name_prefix) {
        let start = ir_index::entry_line_start(lookup_index, name_entry) + std::mem::len(name_prefix);
        let end = ir_index::entry_line_end(lookup_index, name_entry);
        let component_end = fact_tokens::token_end(ir_bytes, start, end);
        let function_start = component_end + 1;
        let function_end = fact_tokens::token_end(ir_bytes, function_start, end);
        let component = try fact_tokens::parse_nonnegative_i64(
            ir_bytes, start, component_end
        );
        let function = try fact_tokens::parse_nonnegative_i64(
            ir_bytes, function_start, function_end
        );
        if component < 0 or component >= component_count or
            function < 0 or function >= function_count or function_end + 1 >= end {
            return error("package definition name mapping invalid");
        }
        let name_slot = try numeric_target_index(
            &definition_components, &definition_functions, function_stride, component, function
        );
        if name_slot < 0 { return error("package definition name has no owner"); }
        if try name_counts.get(name_slot) != 0 { return error("duplicate package definition name mapping"); }
        let mapped_name = ir_bytes[function_end + 1..end];
        var prior_index = 0;
        while prior_index < mapped_name_slots.len() {
            let prior_slot = try mapped_name_slots.get(prior_index);
            if std::mem::equal_bytes(
                    ir_bytes[try name_starts.get(prior_slot)..try name_ends.get(prior_slot)],
                    mapped_name
                ) {
                return error("duplicate numeric package definition symbol owner");
            }
            prior_index = prior_index + 1;
        }
        try name_starts.set(name_slot, function_end + 1);
        try name_ends.set(name_slot, end);
        try name_counts.set(name_slot, 1);
        try mapped_name_slots.append(name_slot);
        name_entry = name_entry + 1;
    }
    var dependency_index = 0;
    while dependency_index < caller_components.len() {
        let caller_component = try caller_components.get(dependency_index);
        let caller_function = try caller_functions.get(dependency_index);
        let target_component = try target_components.get(dependency_index);
        let target_function = try target_functions.get(dependency_index);
        let caller_slot = try numeric_target_index(
            &definition_components, &definition_functions,
            function_stride, caller_component, caller_function
        );
        if caller_slot < 0 {
            return error("package dependency caller definition missing");
        }
        let claim_slot = try numeric_target_index(
            &reference_components, &reference_functions,
            function_stride, target_component, target_function
        );
        if claim_slot < 0 {
            return error("package dependency target reference missing");
        }
        let definition_claim_slot = try numeric_target_index(
            &definition_components, &definition_functions,
            function_stride, target_component, target_function
        );
        if definition_claim_slot < 0 {
            return error("package dependency target definition missing");
        }
        dependency_index = dependency_index + 1;
    }
    var emitted_count = 0;
    fact = 0;
    while fact < definition_components.len() {
        let definition_slot = fact;
        if try name_counts.get(definition_slot) != 1 {
            return error("package numeric definition name mapping missing");
        }
        let name = ir_bytes[try name_starts.get(definition_slot)..try name_ends.get(definition_slot)];
        try emit_numeric_package_definition(
            out, lookup_index, canonical_facts, ir_bytes,
            try definition_components.get(definition_slot),
            try definition_functions.get(definition_slot),
            name
        );
        emitted_count = emitted_count + 1;
        fact = fact + 1;
    }
    return emitted_count;
}
