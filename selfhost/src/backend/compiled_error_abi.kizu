import selfhost::abi::fixed_abi_contract;
import selfhost::backend::ir_index;

// derive_facts borrows the immutable source catalog and returns a separate
// owned catalog. No source-backed slice crosses the producer boundary.
pub fn derive_facts(source: &std::string::String) -> !std::string::String {
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();

    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Void);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Bool);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Integer8);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Integer16);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Integer32);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Integer64);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Float32);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Float64);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Pointer);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::SliceU8);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Owned);
    try append_fixed_seed_fact(&var out, fixed_abi_contract::FixedAbiKind::Handle);

    var line_start = 0;
    var cursor = 0;
    let source_len = source.len();
    while cursor <= source_len {
        if cursor == source_len or owned_byte_at(source, cursor) == cast<u8>(10) {
            let fact_kind = representation_fact_kind_owned(source, line_start, cursor);
            let is_abi_repr = fact_kind == 1;
            let is_type_llvm = fact_kind == 2;
            if is_abi_repr or is_type_llvm {
                let abi_start = last_token_start_owned(source, line_start, cursor);
                if abi_start >= cursor {
                    return error("compiled error ABI: malformed representation fact");
                }
                let seeded = is_seed_payload_owned(source, abi_start, cursor);
                let repeated_repr = is_abi_repr and abi_repr_seen_before(
                    source, line_start, abi_start, cursor
                );
                if !seeded and !repeated_repr {
                    try append_source_fact(
                        &var out, source, abi_start, cursor
                    );
                }
            }
            line_start = cursor + 1;
        }
        cursor = cursor + 1;
    }

    return out;
}

fn abi_repr_seen_before(
    source: &std::string::String,
    before: i64,
    abi_start: i64,
    abi_end: i64
) -> bool {
    var line_start = 0;
    var cursor = 0;
    while cursor < before {
        if owned_byte_at(source, cursor) == cast<u8>(10) {
            if representation_fact_kind_owned(source, line_start, cursor) == 1 {
                let prior_start = last_token_start_owned(source, line_start, cursor);
                if cursor - prior_start == abi_end - abi_start {
                    var equal = true;
                    var offset = 0;
                    while offset < abi_end - abi_start {
                        if owned_byte_at(source, prior_start + offset) !=
                            owned_byte_at(source, abi_start + offset) {
                            equal = false;
                        }
                        offset = offset + 1;
                    }
                    if equal { return true; }
                }
            }
            line_start = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return false;
}

fn is_seed_payload_owned(
    source: &std::string::String,
    start: i64,
    end: i64
) -> bool {
    let bytes = source.as_bytes();
    return fixed_abi_contract::from_llvm(bytes[start..end]).kind !=
        fixed_abi_contract::FixedAbiKind::Missing;
}

fn representation_fact_kind_owned(
    source: &std::string::String,
    start: i64,
    end: i64
) -> i64 {
    if end - start >= 9 and
        owned_byte_at(source, start) == cast<u8>(97) and
        owned_byte_at(source, start + 1) == cast<u8>(98) and
        owned_byte_at(source, start + 2) == cast<u8>(105) and
        owned_byte_at(source, start + 3) == cast<u8>(45) and
        owned_byte_at(source, start + 4) == cast<u8>(114) and
        owned_byte_at(source, start + 5) == cast<u8>(101) and
        owned_byte_at(source, start + 6) == cast<u8>(112) and
        owned_byte_at(source, start + 7) == cast<u8>(114) and
        owned_byte_at(source, start + 8) == cast<u8>(32) { return 1; }
    if end - start >= 10 and
        owned_byte_at(source, start) == cast<u8>(116) and
        owned_byte_at(source, start + 1) == cast<u8>(121) and
        owned_byte_at(source, start + 2) == cast<u8>(112) and
        owned_byte_at(source, start + 3) == cast<u8>(101) and
        owned_byte_at(source, start + 4) == cast<u8>(45) and
        owned_byte_at(source, start + 5) == cast<u8>(108) and
        owned_byte_at(source, start + 6) == cast<u8>(108) and
        owned_byte_at(source, start + 7) == cast<u8>(118) and
        owned_byte_at(source, start + 8) == cast<u8>(109) and
        owned_byte_at(source, start + 9) == cast<u8>(32) { return 2; }
    return 0;
}

fn last_token_start_owned(
    source: &std::string::String,
    start: i64,
    end: i64
) -> i64 {
    var cursor = end;
    while cursor > start and owned_byte_at(source, cursor - 1) != cast<u8>(32) {
        cursor = cursor - 1;
    }
    return cursor;
}

fn append_source_fact(
    out: &var std::string::String,
    source: &std::string::String,
    start: i64,
    end: i64
) -> !void {
    var name = std::string::String(std::mem::page_allocator());
    defer name.deinit();
    try name.append_bytes("%kizu.error.");
    if end > start and owned_byte_at(source, start) == cast<u8>(37) {
        var name_cursor = start + 1;
        while name_cursor < end {
            let byte = owned_byte_at(source, name_cursor);
            try name.append_byte(byte);
            name_cursor = name_cursor + 1;
        }
    } else {
        try name.append_bytes("hex.");
        var name_cursor = start;
        while name_cursor < end {
            let byte = owned_byte_at(source, name_cursor);
            try append_hex_byte(&var name, byte);
            name_cursor = name_cursor + 1;
        }
    }
    try out.append_bytes("error-llvm ");
    var payload_cursor = start;
    while payload_cursor < end {
        let byte = owned_byte_at(source, payload_cursor);
        try out.append_byte(byte);
        payload_cursor = payload_cursor + 1;
    }
    try out.append_byte(cast<u8>(32));
    try append_owned_bytes(out, &name);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_seed_fact(
    out: &var std::string::String,
    payload_abi: []u8
) -> !void {
    var name = try canonical_name(payload_abi);
    defer name.deinit();
    try out.append_bytes("error-llvm ");
    try out.append_bytes(payload_abi);
    try out.append_byte(cast<u8>(32));
    try append_owned_bytes(out, &name);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_fixed_seed_fact(
    out: &var std::string::String,
    kind: fixed_abi_contract::FixedAbiKind
) -> !void {
    let abi = fixed_abi_contract::describe(kind);
    return append_seed_fact(out, abi.llvm_name);
}

fn append_owned_bytes(
    out: &var std::string::String,
    value: &std::string::String
) -> !void {
    let length = value.len();
    var index = 0;
    while index < length {
        let byte = owned_byte_at(value, index);
        try out.append_byte(byte);
        index = index + 1;
    }
    return;
}

fn owned_byte_at(value: &std::string::String, index: i64) -> u8 {
    let bytes = value.as_bytes();
    return bytes[index];
}

// lookup_indexed resolves one payload ABI through exactly one error-llvm fact.
// Duplicate or conflicting producer output is rejected at this boundary.
pub fn lookup_indexed(
    index: &ir_index::IrIndex,
    facts: []u8,
    payload_abi: []u8
) -> ![]u8 borrows facts {
    var entry = ir_index::first_matching_entry(
        index, facts, "error-llvm ", facts[0..0], payload_abi
    );
    if entry < 0 {
        return error("compiled error ABI: payload fact not found");
    }
    let first = fact_value(index, facts, entry);
    entry = entry + 1;
    if ir_index::entry_matches_query(
        index, facts, entry, "error-llvm ", facts[0..0], payload_abi
    ) {
        let other = fact_value(index, facts, entry);
        if !std::mem::equal_bytes(first, other) {
            return error("compiled error ABI: conflicting payload fact");
        }
        return error("compiled error ABI: duplicate payload fact");
    }
    return first;
}

pub fn canonical_name(payload_abi: []u8) -> !std::string::String {
    var name = std::string::String(std::mem::page_allocator());
    errdefer name.deinit();
    let known = known_name(payload_abi);
    if std::mem::len(known) > 0 {
        try name.append_bytes(known);
    } else {
        try name.append_bytes("%kizu.error.");
        let len = std::mem::len(payload_abi);
        if len > 0 and payload_abi[0] == cast<u8>(37) {
            try name.append_bytes(payload_abi[1..len]);
        } else {
            try name.append_bytes("hex.");
            var cursor = 0;
            while cursor < len {
                try append_hex_byte(&var name, payload_abi[cursor]);
                cursor = cursor + 1;
            }
        }
    }
    return name;
}

fn known_name(payload_abi: []u8) -> []u8 {
    let fixed_abi = fixed_abi_contract::from_llvm(payload_abi);
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Void {
        return "%kizu.error.void";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Bool {
        return "%kizu.error.bool";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Integer8 {
        return "%kizu.error.u8";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Integer16 {
        return "%kizu.error.i16";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Integer32 {
        return "%kizu.error.i32";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Integer64 {
        return "%kizu.error.i64";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Float32 {
        return "%kizu.error.f32";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Float64 {
        return "%kizu.error.f64";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Pointer {
        return "%kizu.error.ptr";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::SliceU8 {
        return "%kizu.error.slice.u8";
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Owned {
        return "%kizu.error.owned";
    }
    if std::mem::equal_bytes(payload_abi, "%kizu.fs.metadata") {
        return "%kizu.error.metadata";
    }
    return payload_abi[0..0];
}

// wraps_success reports whether error_union is the canonical error-union ABI that carries
// success_abi as its success value. It mirrors canonical_name's derivation structurally rather
// than materializing the name: a fixed ABI has a known union spelling, and a named aggregate '%T'
// wraps into '%kizu.error.T'. canonical_name's hex escape for an unnamed ABI has no structural
// inverse, so such a success value is rejected rather than guessed.
pub fn wraps_success(error_union: []u8, success_abi: []u8) -> bool {
    let known = known_name(success_abi);
    if std::mem::len(known) > 0 {
        return std::mem::equal_bytes(error_union, known);
    }
    let prefix = "%kizu.error.";
    let prefix_len = std::mem::len(prefix);
    let union_len = std::mem::len(error_union);
    let success_len = std::mem::len(success_abi);
    if union_len <= prefix_len or success_len < 2 {
        return false;
    }
    if !std::mem::equal_bytes(error_union[0..prefix_len], prefix) {
        return false;
    }
    if success_abi[0] != cast<u8>(37) {
        return false;
    }
    return std::mem::equal_bytes(
        error_union[prefix_len..union_len], success_abi[1..success_len]
    );
}

pub fn success_flag_field_index() -> i64 {
    return 0;
}

pub fn message_field_index(payload_abi: []u8) -> !i64 {
    let fixed_abi = fixed_abi_contract::from_llvm(payload_abi);
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Missing {
        return error("compiled error ABI: unsupported payload layout");
    }
    if fixed_abi.kind == fixed_abi_contract::FixedAbiKind::Void {
        return 1;
    }
    return 2;
}

fn fact_value(
    index: &ir_index::IrIndex,
    facts: []u8,
    entry: i64
) -> []u8 borrows facts {
    let line_end = ir_index::entry_line_end(index, entry);
    var start = ir_index::entry_key_end(index, entry);
    while start < line_end and facts[start] == cast<u8>(32) {
        start = start + 1;
    }
    return facts[start..line_end];
}

fn append_hex_byte(out: &var std::string::String, byte: u8) -> !void {
    let digits = "0123456789abcdef";
    let value = cast<i64>(byte);
    try out.append_byte(digits[value / 16]);
    try out.append_byte(digits[value % 16]);
    return;
}

pub fn gate() -> !void {
    let source_fact_literal = "abi-repr std::array::Array %kizu.owned
abi-repr std::string::String %kizu.owned
type-llvm app::alpha::Model %kizu.app.alpha.model
type-llvm app::beta::Model %kizu.app.beta.model";
    var source_facts = std::string::String(std::mem::page_allocator());
    defer source_facts.deinit();
    try source_facts.append_bytes(source_fact_literal);
    let source_len = source_facts.len();
    var derived = try derive_facts(&source_facts);
    defer derived.deinit();
    if source_facts.len() != source_len {
        return error("compiled error ABI: borrowed source changed during derivation");
    }
    let produced = derived.as_bytes();
    print(produced);
    return;
}
