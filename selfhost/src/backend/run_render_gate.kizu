import selfhost::parser;
import selfhost::ir::codegen;
import selfhost::ir::code_render;
import selfhost::types::constructor_facts;

// run_render_gate lowers an on-disk kizu file onto the run codegen IR v1 tape and
// renders the run artifact LLVM module, writing it to target/selfhost/run_render.ll.
// It is the focused end-to-end proof of the tape renderer: a Go gate links the
// emitted module with the hosted runtime and runs it, asserting the program's
// real output. The render path here mirrors what the hosted run CLI will call once
// the tape replaces the per-shape Program dispatch (issue 1255 slice 4).
pub fn run_render_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let path = "target/selfhost/run_render_input.kizu";
    let text = try std::fs::read_file(io, path);
    let parsed = try parser::parse_checked_file(allocator, path, text);

    var code = std::array::Array<i64>(allocator);
    defer code.deinit();
    var kinds = std::array::Array<i64>(allocator);
    defer kinds.deinit();
    var local_starts = std::array::Array<i64>(allocator);
    defer local_starts.deinit();
    var local_ends = std::array::Array<i64>(allocator);
    defer local_ends.deinit();
    var local_values = std::array::Array<i64>(allocator);
    defer local_values.deinit();
    var args_scratch = std::array::Array<i64>(allocator);
    defer args_scratch.deinit();
    var defer_records = std::array::Array<i64>(allocator);
    defer defer_records.deinit();
    var constructor_identities = constructor_facts::init(allocator);
    defer constructor_identities.deinit();
    try constructor_facts::collect_checked(
        text,
        parsed.ast,
        parsed.root,
        &var constructor_identities
    );

    let lowered = try codegen::lower_code_module(
        text,
        parsed.ast,
        parsed.root,
        &constructor_identities,
        constructor_facts::constructor_atomic(),
        constructor_facts::constructor_channel(),
        &var code,
        &var kinds,
        &var local_starts,
        &var local_ends,
        &var local_values,
        &var args_scratch,
        &var defer_records
    );
    if !lowered.ok {
        return error("run render gate: tape lowering rejected the program");
    }

    var module = try code_render::render_tape_module(
        allocator,
        path,
        text,
        &code,
        &kinds
    );
    let module_bytes = module.as_bytes();
    try std::fs::write_file(io, "target/selfhost/run_render.ll", &module_bytes);
    module.deinit();
    print("run-render-ok");
    return;
}
