import selfhost::ir::executable_functions;
import selfhost::backend::compiled_abi_params;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_program_llvm;
import selfhost::backend::compiled_llvm;
import selfhost::backend::compiled_canonical_facts;
import selfhost::backend::ir_index;
import selfhost::backend::llvm;
import selfhost::source::loader;

// run_tape_lowering_gate drives the production compiled LLVM lowering over the
// run codegen IR v1 tape cluster (selfhost::ir::codegen::lower_code_expr and its
// record builders) and reports success only after the compiled MIR lowerer and
// LLVM renderer cross the real recursive expression descent. It emits the full
// production package graph and numeric closure facts, round-trips them through
// a file the same way the
// production backend reads target/selfhost/selfhost.ir back, then lowers every
// tape cluster member through compiled_llvm::append_compiled_function_auto --
// the production single-member lowering driver. While a measured blocker
// remains, the closing print is unreachable and the Go gate asserts the exact
// blocker instead.
pub fn run_tape_lowering_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();

    var facts = std::string::String(allocator);
    defer facts.deinit();

    var files = try loader::load_selfhost_sources(allocator, io, "selfhost");
    defer files.deinit();
    try executable_functions::append_facts(allocator, &var facts, &files);

    // Round-trip the facts through a file so ir_bytes is a freshly-read owned []u8
    // with external provenance, exactly like the production backend which reads
    // target/selfhost/selfhost.ir back before lowering.
    let facts_path = "target/selfhost/run_tape_gate.ir";
    if !(try std::fs::exists(io, "target")) {
        try std::fs::create_dir(io, "target");
    }
    if !(try std::fs::exists(io, "target/selfhost")) {
        try std::fs::create_dir(io, "target/selfhost");
    }
    let facts_bytes = facts.as_bytes();
    try std::fs::write_file(io, &facts_path, &facts_bytes);
    let ir_bytes = try std::fs::read_file(io, &facts_path);
    var lookup_index = try ir_index::build(ir_bytes);
    defer lookup_index.deinit();
    var canonical_facts = try compiled_canonical_facts::parse_and_validate(
        &lookup_index, ir_bytes
    );
    defer canonical_facts.deinit();

    // Drive the production package-definition consumer. The external ABI
    // manifest roots lower_code_module and the dependency graph owns its whole
    // tape closure.
    var registry = std::string::String(allocator);
    defer registry.deinit();
    let emitted = try compiled_program_llvm::append_reachable_functions(
        &var registry, &lookup_index, &canonical_facts, ir_bytes
    );
    if emitted < 1 { return error("run tape gate: package definitions missing"); }
    // The generalized traversal lowering also serves the node_count cluster and the
    // narrow declaration_count accessor; lowering them here guards the legacy arms.
    try run_tape_lower(allocator, ir_bytes, "selfhost::ast::node_count");
    try run_tape_lower(allocator, ir_bytes, "selfhost::ast::declaration_count");
    // The BinaryOp accessors are compiled std::kizu::ast members the tape's operator
    // mapping calls cross-module; their own enum-field-return bodies lower here.
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_add");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_sub");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_mul");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_div");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_mod");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_eq");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_not_eq");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_lt");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_lte");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_gt");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_gte");
    // The logical accessors back the tape's short-circuit and/or routing and the
    // prefix_not accessor its logical-not lowering; they lower through the same
    // enum-field-return path.
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_and");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::binary_or");
    try run_tape_lower(allocator, ir_bytes, "std::kizu::ast::prefix_not");

    print("run-tape-lowering-ok");
    return;
}

// run_stage_emit_gate drives the full production LLVM artifact emission over the
// on-disk IR facts (the same call the stage CLI makes), surfacing the exact
// blocker message through the interpreter when the hosted stage exits silently.
pub fn run_stage_emit_gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    let artifact = try llvm::emit_llvm_artifact(
        allocator,
        io,
        "target/selfhost/selfhost.ir",
        "target/selfhost/selfhost.ir.manifest"
    );
    std::testing::expect(artifact.bytes > 0);
    print("stage-emit-ok");
    return;
}

fn run_tape_lower(
    allocator: Allocator,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    var params_spec = std::string::String(allocator);
    defer params_spec.deinit();
    try compiled_abi_params::append_params_spec(&var params_spec, ir_bytes, function_name);
    let params_spec_bytes = params_spec.as_bytes();
    var llvm_symbol = std::string::String(allocator);
    defer llvm_symbol.deinit();
    try compiled_signature::append_function_llvm_symbol(&var llvm_symbol, function_name);
    let llvm_symbol_bytes = llvm_symbol.as_bytes();

    var out = std::string::String(allocator);
    defer out.deinit();
    try compiled_llvm::append_compiled_function_auto(
        &var out, ir_bytes, function_name, &llvm_symbol_bytes, &params_spec_bytes
    );
    return;
}
