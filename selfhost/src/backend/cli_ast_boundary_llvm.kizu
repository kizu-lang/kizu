fn append_parse_impl_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_impl_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %method_slots = alloca [16 x %kizu.kizu.ast.node_id], align 8");
    try append_line(out,
        "  %impl_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %impl_start = extractvalue %kizu.kizu.lexer.token %impl_token, 1");
    try append_line(out, "  %type_index = add i64 %index, 1");
    try append_line(out,
        "  %type_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_index)");
    try append_line(out, "  %type_kind = extractvalue %kizu.kizu.lexer.token %type_token, 0");
    try append_line(out, "  %type_ok = icmp eq i64 %type_kind, 27");
    try append_line(out, "  br i1 %type_ok, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 29");
    try append_line(out, "  br i1 %open_ok, label %methods_begin, label %fail");
    try append_line(out, "methods_begin:");
    try append_line(out, "  %first_method = add i64 %index, 3");
    try append_line(out, "  br label %method_loop");
    try append_line(out, "method_loop:");
    try append_line(out, "  %cursor = phi i64 [ %first_method, %methods_begin ], [ %method_next, %store_method ]");
    try append_line(out, "  %method_count = phi i64 [ 0, %methods_begin ], [ %method_count_next, %store_method ]");
    try append_line(out,
        "  %cursor_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %cursor)");
    try append_line(out, "  %cursor_kind = extractvalue %kizu.kizu.lexer.token %cursor_token, 0");
    try append_line(out, "  %is_close = icmp eq i64 %cursor_kind, 30");
    try append_line(out, "  br i1 %is_close, label %finish, label %maybe_method");
    try append_line(out, "maybe_method:");
    try append_line(out, "  %is_fn = icmp eq i64 %cursor_kind, 0");
    try append_line(out, "  br i1 %is_fn, label %parse_method, label %fail");
    try append_line(out, "parse_method:");
    try append_line(out,
        "  %method = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_fn_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %cursor)");
    try append_line(out, "  %method_ok = extractvalue %kizu.selfhost.cli.parse_node_result %method, 0");
    try append_line(out, "  br i1 %method_ok, label %method_ok_block, label %fail");
    try append_line(out, "method_ok_block:");
    try append_line(out, "  %method_next = extractvalue %kizu.selfhost.cli.parse_node_result %method, 1");
    try append_line(out, "  %method_node = extractvalue %kizu.selfhost.cli.parse_node_result %method, 2");
    try append_line(out, "  %advanced = icmp sgt i64 %method_next, %cursor");
    try append_line(out, "  %has_capacity = icmp slt i64 %method_count, 16");
    try append_line(out, "  %can_store = and i1 %advanced, %has_capacity");
    try append_line(out, "  br i1 %can_store, label %store_method, label %fail");
    try append_line(out, "store_method:");
    try append_line(out,
        "  %method_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %method_slots, i64 0, i64 %method_count");
    try append_line(out, "  store %kizu.kizu.ast.node_id %method_node, ptr %method_slot, align 8");
    try append_line(out, "  %method_count_next = add i64 %method_count, 1");
    try append_line(out, "  br label %method_loop");
    try append_line(out, "finish:");
    try append_line(out, "  %method_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  br label %append_methods");
    try append_line(out, "append_methods:");
    try append_line(out, "  %append_index = phi i64 [ 0, %finish ], [ %append_next, %append_ok ]");
    try append_line(out, "  %append_done = icmp eq i64 %append_index, %method_count");
    try append_line(out, "  br i1 %append_done, label %build, label %append_method");
    try append_line(out, "append_method:");
    try append_line(out,
        "  %append_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %method_slots, i64 0, i64 %append_index");
    try append_line(out, "  %append_node = load %kizu.kizu.ast.node_id, ptr %append_slot, align 8");
    try append_line(out,
        "  %append_result = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %append_node)");
    try append_line(out, "  %append_result_ok = extractvalue %kizu.error.void %append_result, 0");
    try append_line(out, "  br i1 %append_result_ok, label %append_ok, label %fail");
    try append_line(out, "append_ok:");
    try append_line(out, "  %append_next = add i64 %append_index, 1");
    try append_line(out, "  br label %append_methods");
    try append_line(out, "build:");
    try append_line(out, "  %type_start = extractvalue %kizu.kizu.lexer.token %type_token, 1");
    try append_line(out, "  %type_end = extractvalue %kizu.kizu.lexer.token %type_token, 2");
    try append_line(out, "  %close_end = extractvalue %kizu.kizu.lexer.token %cursor_token, 2");
    try append_line(out,
        "  %type_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_start, i64 %type_end, i64 3)");
    try append_line(out,
        "  %impl_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_impl_decl(%kizu.kizu.ast.ast %ast, i64 %impl_start, i64 %close_end, %kizu.kizu.ast.node_id %type_node, i64 %method_child_start, i64 %method_count)");
    try append_line(out, "  %next = add i64 %cursor, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %impl_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_block_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_block(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %open_index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %stmt_slots = alloca [32 x %kizu.kizu.ast.node_id], align 8");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %first_index = add i64 %open_index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ %first_index, %entry ], [ %stmt_next, %store_stmt ]");
    try append_line(out, "  %stmt_count = phi i64 [ 0, %entry ], [ %stmt_count_next, %store_stmt ]");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_rbrace = icmp eq i64 %kind, 30");
    try append_line(out, "  br i1 %is_rbrace, label %finish, label %maybe_eof");
    try append_line(out, "maybe_eof:");
    try append_line(out, "  %is_eof = icmp eq i64 %kind, 62");
    try append_line(out, "  br i1 %is_eof, label %fail, label %parse_stmt");
    try append_line(out, "parse_stmt:");
    try append_line(out,
        "  %stmt = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_statement(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %stmt_ok = extractvalue %kizu.selfhost.cli.parse_node_result %stmt, 0");
    try append_line(out, "  br i1 %stmt_ok, label %stmt_ok_block, label %fail");
    try append_line(out, "stmt_ok_block:");
    try append_line(out, "  %stmt_next = extractvalue %kizu.selfhost.cli.parse_node_result %stmt, 1");
    try append_line(out, "  %stmt_node = extractvalue %kizu.selfhost.cli.parse_node_result %stmt, 2");
    try append_line(out, "  %advanced = icmp sgt i64 %stmt_next, %index");
    try append_line(out, "  %has_capacity = icmp slt i64 %stmt_count, 32");
    try append_line(out, "  %can_store = and i1 %advanced, %has_capacity");
    try append_line(out, "  br i1 %can_store, label %store_stmt, label %fail");
    try append_line(out, "store_stmt:");
    try append_line(out,
        "  %stmt_slot = getelementptr inbounds [32 x %kizu.kizu.ast.node_id], ptr %stmt_slots, i64 0, i64 %stmt_count");
    try append_line(out, "  store %kizu.kizu.ast.node_id %stmt_node, ptr %stmt_slot, align 8");
    try append_line(out, "  %stmt_count_next = add i64 %stmt_count, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "finish:");
    try append_line(out, "  %child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  br label %append_stmts");
    try append_line(out, "append_stmts:");
    try append_line(out, "  %append_index = phi i64 [ 0, %finish ], [ %append_next, %append_ok ]");
    try append_line(out, "  %append_done = icmp eq i64 %append_index, %stmt_count");
    try append_line(out, "  br i1 %append_done, label %build, label %append_stmt");
    try append_line(out, "append_stmt:");
    try append_line(out,
        "  %append_slot = getelementptr inbounds [32 x %kizu.kizu.ast.node_id], ptr %stmt_slots, i64 0, i64 %append_index");
    try append_line(out, "  %append_node = load %kizu.kizu.ast.node_id, ptr %append_slot, align 8");
    try append_line(out,
        "  %append_result = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %append_node)");
    try append_line(out, "  %append_result_ok = extractvalue %kizu.error.void %append_result, 0");
    try append_line(out, "  br i1 %append_result_ok, label %append_ok, label %fail");
    try append_line(out, "append_ok:");
    try append_line(out, "  %append_next = add i64 %append_index, 1");
    try append_line(out, "  br label %append_stmts");
    try append_line(out, "build:");
    try append_line(out, "  %open_start = extractvalue %kizu.kizu.lexer.token %open_token, 1");
    try append_line(out, "  %close_end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %block = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_block(%kizu.kizu.ast.ast %ast, i64 %open_start, i64 %close_end, i64 %child_start, i64 %stmt_count)");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %block, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_statement_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_statement(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %stmt_start = extractvalue %kizu.kizu.lexer.token %token, 1");
    // An 'ident: while/for' prefix labels the loop; anything else falls through
    // to the ordinary statement dispatch.
    try append_line(out, "  %is_label_ident = icmp eq i64 %kind, 27");
    try append_line(out, "  br i1 %is_label_ident, label %label_check_colon, label %dispatch");
    try append_line(out, "label_check_colon:");
    try append_line(out, "  %label_colon_probe = add i64 %index, 1");
    try append_line(out,
        "  %label_colon_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %label_colon_probe)");
    try append_line(out, "  %label_colon_kind = extractvalue %kizu.kizu.lexer.token %label_colon_token, 0");
    try append_line(out, "  %label_has_colon = icmp eq i64 %label_colon_kind, 35");
    try append_line(out, "  br i1 %label_has_colon, label %label_check_loop, label %dispatch");
    try append_line(out, "label_check_loop:");
    try append_line(out, "  %label_loop_probe = add i64 %index, 2");
    try append_line(out,
        "  %label_loop_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %label_loop_probe)");
    try append_line(out, "  %label_loop_kind = extractvalue %kizu.kizu.lexer.token %label_loop_token, 0");
    try append_line(out, "  %label_is_while = icmp eq i64 %label_loop_kind, 15");
    try append_line(out, "  %label_is_for = icmp eq i64 %label_loop_kind, 16");
    try append_line(out, "  %label_is_loop = or i1 %label_is_while, %label_is_for");
    try append_line(out, "  br i1 %label_is_loop, label %parse_labeled_loop, label %dispatch");
    try append_line(out, "parse_labeled_loop:");
    try append_line(out, "  %label_end_pos = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %label_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %stmt_start, i64 %label_end_pos, i64 4)");
    try append_line(out, "  %labeled_index = add i64 %index, 2");
    try append_line(out, "  br i1 %label_is_while, label %parse_labeled_while, label %parse_labeled_for");
    try append_line(out, "parse_labeled_while:");
    try append_line(out,
        "  %labeled_while_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_while(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %label_node, i64 %labeled_index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %labeled_while_result");
    try append_line(out, "parse_labeled_for:");
    try append_line(out,
        "  %labeled_for_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_for(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %label_node, i64 %labeled_index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %labeled_for_result");
    try append_line(out, "dispatch:");
    try append_line(out, "  %is_let = icmp eq i64 %kind, 8");
    try append_line(out, "  br i1 %is_let, label %parse_let, label %maybe_var");
    try append_line(out, "maybe_var:");
    try append_line(out, "  %is_var = icmp eq i64 %kind, 9");
    try append_line(out, "  br i1 %is_var, label %parse_let, label %maybe_return");
    try append_line(out, "parse_let:");
    try append_line(out,
        "  %let_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_let(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %let_result");
    try append_line(out, "maybe_return:");
    try append_line(out, "  %is_return = icmp eq i64 %kind, 10");
    try append_line(out, "  br i1 %is_return, label %parse_return, label %maybe_defer");
    try append_line(out, "parse_return:");
    try append_line(out,
        "  %return_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_return(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %return_result");
    try append_line(out, "maybe_defer:");
    try append_line(out, "  %is_defer = icmp eq i64 %kind, 11");
    try append_line(out, "  br i1 %is_defer, label %parse_defer, label %maybe_if");
    try append_line(out, "parse_defer:");
    try append_line(out,
        "  %defer_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_defer(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %defer_result");
    try append_line(out, "maybe_if:");
    try append_line(out, "  %is_if = icmp eq i64 %kind, 13");
    try append_line(out, "  br i1 %is_if, label %parse_if, label %maybe_while");
    try append_line(out, "parse_if:");
    try append_line(out,
        "  %if_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_if(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %if_result");
    try append_line(out, "maybe_while:");
    try append_line(out, "  %is_while = icmp eq i64 %kind, 15");
    try append_line(out, "  br i1 %is_while, label %parse_while, label %maybe_for");
    try append_line(out, "parse_while:");
    try append_line(out,
        "  %while_label_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %stmt_start, i64 %stmt_start, i64 44)");
    try append_line(out,
        "  %while_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_while(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %while_label_empty, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %while_result");
    try append_line(out, "maybe_for:");
    try append_line(out, "  %is_for = icmp eq i64 %kind, 16");
    try append_line(out, "  br i1 %is_for, label %parse_for, label %maybe_break");
    try append_line(out, "parse_for:");
    try append_line(out,
        "  %for_label_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %stmt_start, i64 %stmt_start, i64 44)");
    try append_line(out,
        "  %for_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_for(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %for_label_empty, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %for_result");
    try append_line(out, "maybe_break:");
    try append_line(out, "  %is_break = icmp eq i64 %kind, 17");
    try append_line(out, "  br i1 %is_break, label %parse_break, label %maybe_continue");
    try append_line(out, "parse_break:");
    try append_line(out,
        "  %break_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_break(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %break_result");
    try append_line(out, "maybe_continue:");
    try append_line(out, "  %is_continue = icmp eq i64 %kind, 18");
    try append_line(out, "  br i1 %is_continue, label %parse_continue, label %maybe_match");
    try append_line(out, "parse_continue:");
    try append_line(out,
        "  %continue_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_continue(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %continue_result");
    try append_line(out, "maybe_match:");
    try append_line(out, "  %is_match = icmp eq i64 %kind, 19");
    try append_line(out, "  br i1 %is_match, label %parse_match, label %maybe_expr");
    try append_line(out, "parse_match:");
    try append_line(out,
        "  %match_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_match(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %match_result");
    try append_line(out, "maybe_expr:");
    try append_line(out, "  %is_ident = icmp eq i64 %kind, 27");
    try append_line(out, "  br i1 %is_ident, label %maybe_assign, label %maybe_try_expr");
    try append_line(out, "maybe_assign:");
    try append_line(out, "  %after_ident = add i64 %index, 1");
    try append_line(out,
        "  %after_ident_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %after_ident)");
    try append_line(out, "  %after_ident_kind = extractvalue %kizu.kizu.lexer.token %after_ident_token, 0");
    try append_line(out, "  %is_assign = icmp eq i64 %after_ident_kind, 37");
    try append_line(out, "  br i1 %is_assign, label %parse_assign, label %maybe_dot_assign");
    // A 'ident . ident =' prefix is a scalarized field assignment; the assign
    // parser's primary-expression target owns the dot chain itself.
    try append_line(out, "maybe_dot_assign:");
    try append_line(out, "  %is_dot_target = icmp eq i64 %after_ident_kind, 56");
    try append_line(out, "  br i1 %is_dot_target, label %dot_assign_peek, label %parse_expr_stmt");
    try append_line(out, "dot_assign_peek:");
    try append_line(out, "  %dot_field_probe = add i64 %index, 2");
    try append_line(out,
        "  %dot_field_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %dot_field_probe)");
    try append_line(out, "  %dot_field_kind = extractvalue %kizu.kizu.lexer.token %dot_field_token, 0");
    try append_line(out, "  %dot_field_is_ident = icmp eq i64 %dot_field_kind, 27");
    try append_line(out, "  br i1 %dot_field_is_ident, label %dot_assign_check, label %parse_expr_stmt");
    try append_line(out, "dot_assign_check:");
    try append_line(out, "  %dot_assign_probe = add i64 %index, 3");
    try append_line(out,
        "  %dot_assign_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %dot_assign_probe)");
    try append_line(out, "  %dot_assign_kind = extractvalue %kizu.kizu.lexer.token %dot_assign_token, 0");
    try append_line(out, "  %dot_is_assign = icmp eq i64 %dot_assign_kind, 37");
    try append_line(out, "  br i1 %dot_is_assign, label %parse_assign, label %parse_expr_stmt");
    try append_line(out, "parse_assign:");
    try append_line(out,
        "  %assign_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_assign(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %assign_result");
    try append_line(out, "maybe_try_expr:");
    try append_line(out, "  %is_try_expr = icmp eq i64 %kind, 22");
    try append_line(out, "  br i1 %is_try_expr, label %parse_expr_stmt, label %fail");
    try append_line(out, "parse_expr_stmt:");
    try append_line(out,
        "  %expr_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr_statement(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %expr_result");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_return_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_return(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %return_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %value_index = add i64 %index, 1");
    try append_line(out,
        "  %first = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  %first_kind = extractvalue %kizu.kizu.lexer.token %first, 0");
    try append_line(out, "  %empty_return = icmp eq i64 %first_kind, 33");
    try append_line(out, "  br i1 %empty_return, label %build_empty, label %parse_value");
    try append_line(out, "build_empty:");
    try append_line(out, "  %return_start = extractvalue %kizu.kizu.lexer.token %return_token, 1");
    try append_line(out, "  %semicolon_end = extractvalue %kizu.kizu.lexer.token %first, 2");
    try append_line(out,
        "  %empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %semicolon_end, i64 %semicolon_end, i64 44)");
    try append_line(out,
        "  %empty_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_return(%kizu.kizu.ast.ast %ast, i64 %return_start, i64 %semicolon_end, %kizu.kizu.ast.node_id %empty)");
    try append_line(out, "  %empty_next = add i64 %value_index, 1");
    try append_line(out,
        "  %empty_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %empty_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %empty_ok0, i64 %empty_next, 1");
    try append_line(out,
        "  %empty_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %empty_ok1, %kizu.kizu.ast.node_id %empty_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %empty_ok2");
    try append_line(out, "parse_value:");
    try append_line(out,
        "  %value_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  %value_ok = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 0");
    try append_line(out, "  br i1 %value_ok, label %check_semicolon, label %fail");
    try append_line(out, "check_semicolon:");
    try append_line(out, "  %value_next = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 1");
    try append_line(out, "  %value_node = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 2");
    try append_line(out,
        "  %semicolon = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %value_next)");
    try append_line(out, "  %semicolon_kind = extractvalue %kizu.kizu.lexer.token %semicolon, 0");
    try append_line(out, "  %semicolon_ok = icmp eq i64 %semicolon_kind, 33");
    try append_line(out, "  br i1 %semicolon_ok, label %build_value, label %fail");
    try append_line(out, "build_value:");
    try append_line(out, "  %value_return_start = extractvalue %kizu.kizu.lexer.token %return_token, 1");
    try append_line(out, "  %value_semicolon_end = extractvalue %kizu.kizu.lexer.token %semicolon, 2");
    try append_line(out,
        "  %node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_return(%kizu.kizu.ast.ast %ast, i64 %value_return_start, i64 %value_semicolon_end, %kizu.kizu.ast.node_id %value_node)");
    try append_line(out, "  %next = add i64 %value_next, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
