    try append_line(out, "  i64 %arg_start,");
    try append_line(out, "  i64 %arg_len");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %callee_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee)");
    try append_line(out, "  %callee_span = extractvalue %kizu.kizu.ast.ast_node %callee_node, 0");
    try append_line(out, "  %start = extractvalue %kizu.kizu.ast.span %callee_span, 0");
    try append_line(out, "  %range0 = insertvalue %kizu.kizu.ast.child_range poison, i64 %arg_start, 0");
    try append_line(out, "  %range = insertvalue %kizu.kizu.ast.child_range %range0, i64 %arg_len, 1");
    try append_line(out,
        "  %p0 = insertvalue %kizu.kizu.ast.call_node poison, %kizu.kizu.ast.node_id %callee, 0");
    try append_line(out,
        "  %payload = insertvalue %kizu.kizu.ast.call_node %p0, %kizu.kizu.ast.child_range %range, 1");
    try append_node_with_payload(out, "%kizu.kizu.ast.call_node", "payload", "10");
    return;
}

