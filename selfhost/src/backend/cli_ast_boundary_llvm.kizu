    try append_line(out, "  %f1_name_start_one = extractvalue %kizu.kizu.lexer.token %f1_token, 1");
    try append_line(out, "  %f1_name_end_one = extractvalue %kizu.kizu.lexer.token %f1_token, 2");
    try append_line(out,
        "  %f1_name_node_one = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %f1_name_start_one, i64 %f1_name_end_one, i64 4)");
    try append_line(out,
        "  %f1_init_one = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_struct_field_init(%kizu.kizu.ast.ast %ast, i64 %f1_name_start_one, i64 %f1_name_end_one, %kizu.kizu.ast.node_id %f1_name_node_one, %kizu.kizu.ast.node_id %f1_value_node)");
    try append_line(out, "  %one_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out,
        "  %one_append = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %f1_init_one)");
    try append_line(out, "  %one_append_ok = extractvalue %kizu.error.void %one_append, 0");
    try append_line(out, "  br i1 %one_append_ok, label %emit_one_node, label %fail");
    try append_line(out, "emit_one_node:");
    try append_line(out,
