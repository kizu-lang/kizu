    try append_line(out,
        "  %primary = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_additive_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %primary_ok = extractvalue %kizu.selfhost.cli.parse_node_result %primary, 0");
