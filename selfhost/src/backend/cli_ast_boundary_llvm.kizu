    try append_line(out, "  %after_index = add i64 %index, 1");
    try append_line(out,
        "  %after = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %after_index)");
    try append_line(out, "  %after_kind = extractvalue %kizu.kizu.lexer.token %after, 0");
    // ': <ident>' between the keyword and the semicolon names the target loop.
    try append_line(out, "  %has_label = icmp eq i64 %after_kind, 35");
    try append_line(out, "  br i1 %has_label, label %parse_label, label %plain");
    try append_line(out, "parse_label:");
    try append_line(out, "  %label_name_index = add i64 %index, 2");
    try append_line(out,
        "  %label_name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %label_name_index)");
    try append_line(out, "  %label_name_kind = extractvalue %kizu.kizu.lexer.token %label_name_token, 0");
    try append_line(out, "  %label_name_ok = icmp eq i64 %label_name_kind, 27");
    try append_line(out, "  br i1 %label_name_ok, label %label_semi, label %fail");
    try append_line(out, "label_semi:");
    try append_line(out, "  %label_semi_index = add i64 %index, 3");
    try append_line(out,
        "  %label_semi_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %label_semi_index)");
    try append_line(out, "  %label_semi_kind = extractvalue %kizu.kizu.lexer.token %label_semi_token, 0");
    try append_line(out, "  %label_semi_ok = icmp eq i64 %label_semi_kind, 33");
    try append_line(out, "  br i1 %label_semi_ok, label %build_labeled, label %fail");
    try append_line(out, "build_labeled:");
    try append_line(out, "  %label_name_start = extractvalue %kizu.kizu.lexer.token %label_name_token, 1");
    try append_line(out, "  %label_name_end = extractvalue %kizu.kizu.lexer.token %label_name_token, 2");
    try append_line(out, "  %labeled_end = extractvalue %kizu.kizu.lexer.token %label_semi_token, 2");
    try append_line(out,
        "  %label_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %label_name_start, i64 %label_name_end, i64 4)");
    try append_line(out,
        "  %labeled_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_continue(%kizu.kizu.ast.ast %ast, i64 %start, i64 %labeled_end, %kizu.kizu.ast.node_id %label_node)");
    try append_line(out, "  %labeled_next = add i64 %label_semi_index, 1");
    try append_line(out,
        "  %labeled_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %labeled_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %labeled_ok0, i64 %labeled_next, 1");
    try append_line(out,
        "  %labeled_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %labeled_ok1, %kizu.kizu.ast.node_id %labeled_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %labeled_ok2");
    try append_line(out, "plain:");
    try append_line(out, "  %semicolon_ok = icmp eq i64 %after_kind, 33");
    try append_line(out, "  br i1 %semicolon_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %end = extractvalue %kizu.kizu.lexer.token %after, 2");
    try append_line(out,
        "  %label_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %start, i64 %start, i64 44)");
    try append_line(out,
        "  %node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_continue(%kizu.kizu.ast.ast %ast, i64 %start, i64 %end, %kizu.kizu.ast.node_id %label_empty)");
    try append_line(out, "  %next = add i64 %after_index, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_expr_statement_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr_statement(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %start_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out,
        "  %expr = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %expr_ok = extractvalue %kizu.selfhost.cli.parse_node_result %expr, 0");
    try append_line(out, "  br i1 %expr_ok, label %check_semicolon, label %fail");
    try append_line(out, "check_semicolon:");
    try append_line(out, "  %expr_next = extractvalue %kizu.selfhost.cli.parse_node_result %expr, 1");
    try append_line(out, "  %expr_node = extractvalue %kizu.selfhost.cli.parse_node_result %expr, 2");
    try append_line(out,
        "  %semicolon = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %expr_next)");
    try append_line(out, "  %semicolon_kind = extractvalue %kizu.kizu.lexer.token %semicolon, 0");
    try append_line(out, "  %semicolon_ok = icmp eq i64 %semicolon_kind, 33");
    try append_line(out, "  br i1 %semicolon_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %start = extractvalue %kizu.kizu.lexer.token %start_token, 1");
    try append_line(out, "  %end = extractvalue %kizu.kizu.lexer.token %semicolon, 2");
    try append_line(out,
        "  %stmt = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_expr_stmt(%kizu.kizu.ast.ast %ast, i64 %start, i64 %end, %kizu.kizu.ast.node_id %expr_node)");
    try append_line(out, "  %next = add i64 %expr_next, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %stmt, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

// cli_parse_expr is the run-path expression entry: it parses a full binary
// expression with operator precedence and left associativity by delegating to the
// precedence-climbing cli_parse_binary_expr at the lowest binding power (0). This
// is the generic expression grammar (chained and nested binary operators), not the
// single-operator shape the earlier stopgap parsed.
fn append_parse_expr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_binary_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index, i64 0)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

// cli_parse_binary_expr is the precedence-climbing core. It parses a primary, then
// folds following 'op rhs' pairs while the operator's binding power is at least
// %min_prec, recursing at min_prec+1 for left associativity. Binding powers:
// '*' '/' = 4, '+' '-' = 3, '==' '<' = 2, 'and' = 1, 'or' = 0; a non-operator
// token (precedence -1) stops the fold. cli_add_binary records the (op, left,
// right) node spanning from the original %index start to the last consumed
// token's end.
fn append_parse_binary_expr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_binary_expr(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index,");
    try append_line(out, "  i64 %min_prec");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %primary = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_primary_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %primary_ok = extractvalue %kizu.selfhost.cli.parse_node_result %primary, 0");
    try append_line(out, "  br i1 %primary_ok, label %seed, label %fail");
    try append_line(out, "seed:");
    try append_line(out, "  %seed_next = extractvalue %kizu.selfhost.cli.parse_node_result %primary, 1");
    try append_line(out, "  %seed_node = extractvalue %kizu.selfhost.cli.parse_node_result %primary, 2");
    try append_line(out, "  br label %loop_head");
    try append_line(out, "loop_head:");
    try append_line(out, "  %cur_node = phi %kizu.kizu.ast.node_id [ %seed_node, %seed ], [ %new_node, %build ]");
    try append_line(out, "  %cur_next = phi i64 [ %seed_next, %seed ], [ %rhs_next, %build ]");
    try append_line(out,
        "  %op_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %cur_next)");
    try append_line(out, "  %op_kind = extractvalue %kizu.kizu.lexer.token %op_token, 0");
    try append_line(out, "  %is_plus = icmp eq i64 %op_kind, 51");
    try append_line(out, "  %is_minus = icmp eq i64 %op_kind, 52");
    try append_line(out, "  %is_star = icmp eq i64 %op_kind, 53");
    try append_line(out, "  %is_slash = icmp eq i64 %op_kind, 54");
    try append_line(out, "  %is_pct = icmp eq i64 %op_kind, 55");
    try append_line(out, "  %is_eq = icmp eq i64 %op_kind, 41");
    try append_line(out, "  %is_ne = icmp eq i64 %op_kind, 42");
    try append_line(out, "  %is_lt = icmp eq i64 %op_kind, 46");
    try append_line(out, "  %is_lte = icmp eq i64 %op_kind, 47");
    try append_line(out, "  %is_gt = icmp eq i64 %op_kind, 48");
    try append_line(out, "  %is_gte = icmp eq i64 %op_kind, 49");
    try append_line(out, "  %is_and = icmp eq i64 %op_kind, 25");
    try append_line(out, "  %is_or_kw = icmp eq i64 %op_kind, 26");
    try append_line(out, "  %code_a = select i1 %is_plus, i64 0, i64 -1");
    try append_line(out, "  %code_b = select i1 %is_minus, i64 1, i64 %code_a");
    try append_line(out, "  %code_c = select i1 %is_star, i64 2, i64 %code_b");
    try append_line(out, "  %code_d0 = select i1 %is_slash, i64 3, i64 %code_c");
    try append_line(out, "  %code_d = select i1 %is_pct, i64 4, i64 %code_d0");
    try append_line(out, "  %code_e = select i1 %is_eq, i64 5, i64 %code_d");
    try append_line(out, "  %code_f = select i1 %is_ne, i64 6, i64 %code_e");
    try append_line(out, "  %code_g = select i1 %is_lt, i64 7, i64 %code_f");
    try append_line(out, "  %code_h = select i1 %is_lte, i64 8, i64 %code_g");
    try append_line(out, "  %code_i = select i1 %is_gt, i64 9, i64 %code_h");
    try append_line(out, "  %code_j = select i1 %is_gte, i64 10, i64 %code_i");
    try append_line(out, "  %code_k = select i1 %is_and, i64 11, i64 %code_j");
    try append_line(out, "  %op_code = select i1 %is_or_kw, i64 12, i64 %code_k");
    try append_line(out, "  %is_mul_div = or i1 %is_star, %is_slash");
    try append_line(out, "  %is_mul_level = or i1 %is_mul_div, %is_pct");
    try append_line(out, "  %is_add_level = or i1 %is_plus, %is_minus");
    try append_line(out, "  %cmp_eq_ne = or i1 %is_eq, %is_ne");
    try append_line(out, "  %cmp_lt_lte = or i1 %is_lt, %is_lte");
    try append_line(out, "  %cmp_gt_gte = or i1 %is_gt, %is_gte");
    try append_line(out, "  %cmp_lo = or i1 %cmp_eq_ne, %cmp_lt_lte");
    try append_line(out, "  %is_cmp_level = or i1 %cmp_lo, %cmp_gt_gte");
    try append_line(out, "  %prec_a = select i1 %is_or_kw, i64 0, i64 -1");
    try append_line(out, "  %prec_b = select i1 %is_and, i64 1, i64 %prec_a");
    try append_line(out, "  %prec_c = select i1 %is_cmp_level, i64 2, i64 %prec_b");
    try append_line(out, "  %prec_d = select i1 %is_add_level, i64 3, i64 %prec_c");
    try append_line(out, "  %prec = select i1 %is_mul_level, i64 4, i64 %prec_d");
    try append_line(out, "  %meets = icmp sge i64 %prec, %min_prec");
    try append_line(out, "  br i1 %meets, label %climb, label %done");
    try append_line(out, "climb:");
    try append_line(out, "  %rhs_index = add i64 %cur_next, 1");
    try append_line(out, "  %next_min = add i64 %prec, 1");
    try append_line(out,
        "  %rhs = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_binary_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %rhs_index, i64 %next_min)");
    try append_line(out, "  %rhs_ok = extractvalue %kizu.selfhost.cli.parse_node_result %rhs, 0");
    try append_line(out, "  br i1 %rhs_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %rhs_next = extractvalue %kizu.selfhost.cli.parse_node_result %rhs, 1");
    try append_line(out, "  %rhs_node = extractvalue %kizu.selfhost.cli.parse_node_result %rhs, 2");
    try append_line(out,
        "  %start_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %start = extractvalue %kizu.kizu.lexer.token %start_token, 1");
    try append_line(out, "  %rhs_end_index = sub i64 %rhs_next, 1");
    try append_line(out,
        "  %rhs_end_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %rhs_end_index)");
    try append_line(out, "  %end = extractvalue %kizu.kizu.lexer.token %rhs_end_token, 2");
    try append_line(out,
        "  %new_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_binary(%kizu.kizu.ast.ast %ast, i64 %start, i64 %end, i64 %op_code, %kizu.kizu.ast.node_id %cur_node, %kizu.kizu.ast.node_id %rhs_node)");
    try append_line(out, "  br label %loop_head");
    try append_line(out, "done:");
    try append_line(out,
        "  %done0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %done1 = insertvalue %kizu.selfhost.cli.parse_node_result %done0, i64 %cur_next, 1");
    try append_line(out,
        "  %done2 = insertvalue %kizu.selfhost.cli.parse_node_result %done1, %kizu.kizu.ast.node_id %cur_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %done2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}


fn append_parse_primary_expr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_primary_expr(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_string = icmp eq i64 %kind, 61");
    try append_line(out, "  br i1 %is_string, label %string_expr, label %maybe_true");
    try append_line(out, "string_expr:");
    try append_line(out, "  %string_start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %string_end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %string_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %string_start, i64 %string_end, i64 2)");
    try append_line(out, "  %string_next = add i64 %index, 1");
    try append_line(out,
        "  %string_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %string_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %string_ok0, i64 %string_next, 1");
    try append_line(out,
        "  %string_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %string_ok1, %kizu.kizu.ast.node_id %string_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %string_ok2");
    try append_line(out, "maybe_true:");
    try append_line(out, "  %is_true = icmp eq i64 %kind, 23");
    try append_line(out, "  br i1 %is_true, label %bool_expr, label %maybe_false");
    try append_line(out, "maybe_false:");
    try append_line(out, "  %is_false = icmp eq i64 %kind, 24");
    try append_line(out, "  br i1 %is_false, label %bool_expr, label %maybe_number");
    try append_line(out, "bool_expr:");
    try append_line(out, "  %bool_start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %bool_end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %bool_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %bool_start, i64 %bool_end, i64 5)");
    try append_line(out, "  %bool_next = add i64 %index, 1");
    try append_line(out,
        "  %bool_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %bool_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %bool_ok0, i64 %bool_next, 1");
    try append_line(out,
        "  %bool_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %bool_ok1, %kizu.kizu.ast.node_id %bool_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %bool_ok2");
    try append_line(out, "maybe_number:");
    try append_line(out, "  %is_number = icmp eq i64 %kind, 28");
    try append_line(out, "  br i1 %is_number, label %number_expr, label %maybe_ident");
    try append_line(out, "number_expr:");
    try append_line(out, "  %number_start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %number_end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %number_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %number_start, i64 %number_end, i64 1)");
    try append_line(out, "  %number_next = add i64 %index, 1");
    try append_line(out,
        "  %number_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %number_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %number_ok0, i64 %number_next, 1");
    try append_line(out,
        "  %number_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %number_ok1, %kizu.kizu.ast.node_id %number_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %number_ok2");
    try append_line(out, "maybe_ident:");
    try append_line(out, "  %is_ident = icmp eq i64 %kind, 27");
    try append_line(out, "  br i1 %is_ident, label %maybe_cast, label %maybe_try");
    try append_line(out, "maybe_cast:");
    try append_line(out,
        "  %cast_keyword_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.ast_cast_keyword, i64 0, i64 0");
    try append_line(out, "  %cast_keyword0 = insertvalue %kizu.slice.u8 poison, ptr %cast_keyword_ptr, 0");
    try append_line(out, "  %cast_keyword_slice = insertvalue %kizu.slice.u8 %cast_keyword0, i64 4, 1");
    try append_line(out,
        "  %is_cast_name = call i1 @kizu_selfhost__cli_token_text_equal(%kizu.slice.u8 %source, %kizu.kizu.lexer.token %token, %kizu.slice.u8 %cast_keyword_slice)");
    try append_line(out, "  br i1 %is_cast_name, label %cast_check_lt, label %ident_expr");
    try append_line(out, "cast_check_lt:");
    try append_line(out, "  %cast_lt_index = add i64 %index, 1");
    try append_line(out,
        "  %cast_lt_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %cast_lt_index)");
    try append_line(out, "  %cast_lt_kind = extractvalue %kizu.kizu.lexer.token %cast_lt_token, 0");
    try append_line(out, "  %cast_has_lt = icmp eq i64 %cast_lt_kind, 46");
    try append_line(out, "  br i1 %cast_has_lt, label %cast_expr, label %ident_expr");
    try append_line(out, "cast_expr:");
    try append_line(out,
        "  %cast_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_cast_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %cast_result");
    try append_line(out, "ident_expr:");
    try append_line(out,
        "  %ident_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_ident_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ident_result");
    try append_line(out, "maybe_try:");
    try append_line(out, "  %is_try = icmp eq i64 %kind, 22");
    try append_line(out, "  br i1 %is_try, label %try_expr, label %maybe_paren");
    // '(' groups a full expression; the inner node is returned directly (the AST
    // has no paren node), consuming through the matching ')'.
    try append_line(out, "maybe_paren:");
    try append_line(out, "  %is_paren = icmp eq i64 %kind, 31");
    try append_line(out, "  br i1 %is_paren, label %paren_expr, label %maybe_bang");
    try append_line(out, "paren_expr:");
    try append_line(out, "  %paren_inner_index = add i64 %index, 1");
    try append_line(out,
        "  %paren_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %paren_inner_index)");
    try append_line(out, "  %paren_ok = extractvalue %kizu.selfhost.cli.parse_node_result %paren_result, 0");
    try append_line(out, "  br i1 %paren_ok, label %paren_close, label %fail");
    try append_line(out, "paren_close:");
    try append_line(out, "  %paren_next = extractvalue %kizu.selfhost.cli.parse_node_result %paren_result, 1");
    try append_line(out, "  %paren_node = extractvalue %kizu.selfhost.cli.parse_node_result %paren_result, 2");
    try append_line(out,
        "  %paren_close_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %paren_next)");
    try append_line(out, "  %paren_close_kind = extractvalue %kizu.kizu.lexer.token %paren_close_token, 0");
    try append_line(out, "  %paren_close_ok = icmp eq i64 %paren_close_kind, 32");
    try append_line(out, "  br i1 %paren_close_ok, label %paren_done, label %fail");
    try append_line(out, "paren_done:");
    try append_line(out, "  %paren_after = add i64 %paren_next, 1");
    try append_line(out,
        "  %paren_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %paren_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %paren_ok0, i64 %paren_after, 1");
    try append_line(out,
        "  %paren_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %paren_ok1, %kizu.kizu.ast.node_id %paren_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %paren_ok2");
    // '!' negates a primary operand (logical not binds tighter than any binary
    // operator); the Prefix node spans from the bang to the operand's end.
    try append_line(out, "maybe_bang:");
    try append_line(out, "  %is_bang = icmp eq i64 %kind, 40");
    try append_line(out, "  br i1 %is_bang, label %bang_expr, label %fail");
    try append_line(out, "bang_expr:");
    try append_line(out, "  %bang_operand_index = add i64 %index, 1");
    try append_line(out,
        "  %bang_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_primary_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %bang_operand_index)");
    try append_line(out, "  %bang_ok = extractvalue %kizu.selfhost.cli.parse_node_result %bang_result, 0");
    try append_line(out, "  br i1 %bang_ok, label %build_bang, label %fail");
    try append_line(out, "build_bang:");
    try append_line(out, "  %bang_start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %bang_next = extractvalue %kizu.selfhost.cli.parse_node_result %bang_result, 1");
    try append_line(out, "  %bang_value = extractvalue %kizu.selfhost.cli.parse_node_result %bang_result, 2");
    try append_line(out,
        "  %bang_value_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %bang_value)");
    try append_line(out, "  %bang_value_span = extractvalue %kizu.kizu.ast.ast_node %bang_value_ast, 0");
    try append_line(out, "  %bang_end = extractvalue %kizu.kizu.ast.span %bang_value_span, 1");
    try append_line(out,
        "  %bang_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_prefix(%kizu.kizu.ast.ast %ast, i64 %bang_start, i64 %bang_end, i64 0, %kizu.kizu.ast.node_id %bang_value)");
    try append_line(out,
        "  %bang_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %bang_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %bang_ok0, i64 %bang_next, 1");
    try append_line(out,
        "  %bang_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %bang_ok1, %kizu.kizu.ast.node_id %bang_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %bang_ok2");
    try append_line(out, "try_expr:");
    try append_line(out, "  %value_index = add i64 %index, 1");
    try append_line(out,
        "  %value_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  %value_ok = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 0");
    try append_line(out, "  br i1 %value_ok, label %build_try, label %fail");
    try append_line(out, "build_try:");
    try append_line(out, "  %try_start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %try_next = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 1");
    try append_line(out, "  %try_value = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 2");
    try append_line(out,
        "  %try_value_ast = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %try_value)");
    try append_line(out, "  %try_value_span = extractvalue %kizu.kizu.ast.ast_node %try_value_ast, 0");
    try append_line(out, "  %try_end = extractvalue %kizu.kizu.ast.span %try_value_span, 1");
    try append_line(out,
        "  %try_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_try_expr(%kizu.kizu.ast.ast %ast, i64 %try_start, i64 %try_end, %kizu.kizu.ast.node_id %try_value)");
    try append_line(out,
        "  %try_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %try_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %try_ok0, i64 %try_next, 1");
    try append_line(out,
        "  %try_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %try_ok1, %kizu.kizu.ast.node_id %try_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %try_ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_cast_expr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_cast_expr(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %cast_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %cast_start = extractvalue %kizu.kizu.lexer.token %cast_token, 1");
    try append_line(out, "  %lt_index = add i64 %index, 1");
    try append_line(out,
        "  %lt_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %lt_index)");
    try append_line(out, "  %lt_kind = extractvalue %kizu.kizu.lexer.token %lt_token, 0");
    try append_line(out, "  %lt_ok = icmp eq i64 %lt_kind, 46");
    try append_line(out, "  br i1 %lt_ok, label %parse_type, label %fail");
    try append_line(out, "parse_type:");
    try append_line(out, "  %type_index = add i64 %index, 2");
    try append_line(out,
        "  %type_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_index)");
    try append_line(out, "  %type_kind = extractvalue %kizu.kizu.lexer.token %type_token, 0");
    try append_line(out, "  %type_ok = icmp eq i64 %type_kind, 27");
    try append_line(out, "  br i1 %type_ok, label %check_gt, label %fail");
    try append_line(out, "check_gt:");
    try append_line(out, "  %type_start = extractvalue %kizu.kizu.lexer.token %type_token, 1");
    try append_line(out, "  %type_end = extractvalue %kizu.kizu.lexer.token %type_token, 2");
    try append_line(out,
        "  %type_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_start, i64 %type_end, i64 3)");
    try append_line(out, "  %gt_index = add i64 %index, 3");
    try append_line(out,
        "  %gt_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %gt_index)");
    try append_line(out, "  %gt_kind = extractvalue %kizu.kizu.lexer.token %gt_token, 0");
    try append_line(out, "  %gt_ok = icmp eq i64 %gt_kind, 48");
    try append_line(out, "  br i1 %gt_ok, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 4");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 31");
    try append_line(out, "  br i1 %open_ok, label %parse_value, label %fail");
    try append_line(out, "parse_value:");
    try append_line(out, "  %value_index = add i64 %index, 5");
    try append_line(out,
        "  %value_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  %value_ok = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 0");
    try append_line(out, "  br i1 %value_ok, label %check_close, label %fail");
    try append_line(out, "check_close:");
    try append_line(out, "  %value_next = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 1");
    try append_line(out, "  %value_node = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 2");
    try append_line(out,
        "  %close_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %value_next)");
    try append_line(out, "  %close_kind = extractvalue %kizu.kizu.lexer.token %close_token, 0");
    try append_line(out, "  %close_ok = icmp eq i64 %close_kind, 32");
    try append_line(out, "  br i1 %close_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %cast_end = extractvalue %kizu.kizu.lexer.token %close_token, 2");
    try append_line(out,
        "  %cast_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_cast_expr(%kizu.kizu.ast.ast %ast, i64 %cast_start, i64 %cast_end, %kizu.kizu.ast.node_id %type_node, %kizu.kizu.ast.node_id %value_node)");
    try append_line(out, "  %next = add i64 %value_next, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %cast_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_ident_expr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_ident_expr(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %base = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %start, i64 %end, i64 4)");
    try append_line(out, "  %first_next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out,
        "  %receiver = phi %kizu.kizu.ast.node_id [ %base, %entry ], [ %field_node, %field_ok ], [ %dot_node, %dot_ok ], [ %type_apply_node, %type_apply_emit ], [ %call_node, %call_ok ]");
    try append_line(out,
        "  %current = phi i64 [ %first_next, %entry ], [ %after_name, %field_ok ], [ %after_dot, %dot_ok ], [ %after_type_apply, %type_apply_emit ], [ %call_next, %call_ok ]");
    try append_line(out,
        "  %current_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %current)");
    try append_line(out, "  %current_kind = extractvalue %kizu.kizu.lexer.token %current_token, 0");
    try append_line(out, "  %is_double_colon = icmp eq i64 %current_kind, 36");
    try append_line(out, "  br i1 %is_double_colon, label %parse_field, label %maybe_dot");
    try append_line(out, "parse_field:");
    try append_line(out, "  %name_index = add i64 %current, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_ok = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_ok, label %field_ok, label %fail");
    try append_line(out, "field_ok:");
    try append_line(out, "  %name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
    try append_line(out, "  %name_end = extractvalue %kizu.kizu.lexer.token %name_token, 2");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %name_start, i64 %name_end, i64 4)");
    try append_line(out,
        "  %field_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_field_expr(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %receiver, %kizu.kizu.ast.node_id %name_node, i64 %name_end, i1 true)");
    try append_line(out, "  %after_name = add i64 %current, 2");
    try append_line(out, "  br label %loop");
    // A '.' chain mirrors the '::' chain but records the FieldExpr with
    // namespace=false, so the tape's struct field resolution owns the read.
    try append_line(out, "maybe_dot:");
    try append_line(out, "  %is_dot = icmp eq i64 %current_kind, 56");
    try append_line(out, "  br i1 %is_dot, label %parse_dot, label %maybe_type_apply");
    try append_line(out, "parse_dot:");
    try append_line(out, "  %dot_name_index = add i64 %current, 1");
    try append_line(out,
        "  %dot_name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %dot_name_index)");
    try append_line(out, "  %dot_name_kind = extractvalue %kizu.kizu.lexer.token %dot_name_token, 0");
    try append_line(out, "  %dot_name_ok = icmp eq i64 %dot_name_kind, 27");
    try append_line(out, "  br i1 %dot_name_ok, label %dot_ok, label %fail");
    try append_line(out, "dot_ok:");
    try append_line(out, "  %dot_name_start = extractvalue %kizu.kizu.lexer.token %dot_name_token, 1");
    try append_line(out, "  %dot_name_end = extractvalue %kizu.kizu.lexer.token %dot_name_token, 2");
    try append_line(out,
        "  %dot_name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %dot_name_start, i64 %dot_name_end, i64 4)");
    try append_line(out,
        "  %dot_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_field_expr(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %receiver, %kizu.kizu.ast.node_id %dot_name_node, i64 %dot_name_end, i1 false)");
    try append_line(out, "  %after_dot = add i64 %current, 2");
    try append_line(out, "  br label %loop");
    // Type applications carry the same AST shape as the source parser: the
    // callee plus a child range of TypeName nodes for the type arguments.
    try append_line(out, "maybe_type_apply:");
    try append_line(out, "  %is_type_apply = icmp eq i64 %current_kind, 46");
    try append_line(out, "  br i1 %is_type_apply, label %type_apply_probe, label %maybe_call");
    try append_line(out, "type_apply_probe:");
    try append_line(out, "  %type_apply_first = add i64 %current, 1");
    try append_line(out,
        "  %type_apply_first_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_apply_first)");
    try append_line(out, "  %type_apply_first_kind = extractvalue %kizu.kizu.lexer.token %type_apply_first_token, 0");
    try append_line(out, "  %type_apply_first_dyn = icmp eq i64 %type_apply_first_kind, 7");
    try append_line(out, "  %type_apply_first_ident = icmp eq i64 %type_apply_first_kind, 27");
    try append_line(out, "  %type_apply_first_bang = icmp eq i64 %type_apply_first_kind, 40");
    try append_line(out, "  %type_apply_first_amp = icmp eq i64 %type_apply_first_kind, 43");
    try append_line(out, "  %type_apply_first_slice = icmp eq i64 %type_apply_first_kind, 44");
    try append_line(out, "  %type_apply_first_question = icmp eq i64 %type_apply_first_kind, 50");
    try append_line(out, "  %type_apply_first_ok0 = or i1 %type_apply_first_dyn, %type_apply_first_ident");
    try append_line(out, "  %type_apply_first_ok1 = or i1 %type_apply_first_ok0, %type_apply_first_bang");
    try append_line(out, "  %type_apply_first_ok2 = or i1 %type_apply_first_ok1, %type_apply_first_amp");
    try append_line(out, "  %type_apply_first_ok3 = or i1 %type_apply_first_ok2, %type_apply_first_slice");
    try append_line(out, "  %type_apply_first_ok = or i1 %type_apply_first_ok3, %type_apply_first_question");
    try append_line(out, "  br i1 %type_apply_first_ok, label %type_apply_loop_entry, label %maybe_call");
    try append_line(out, "type_apply_loop_entry:");
    try append_line(out, "  %type_apply_first_start = extractvalue %kizu.kizu.lexer.token %type_apply_first_token, 1");
    try append_line(out, "  br label %type_apply_loop");
    try append_line(out, "type_apply_loop:");
    try append_line(out,
        "  %type_apply_index = phi i64 [ %type_apply_first, %type_apply_loop_entry ], [ %type_apply_next, %type_apply_advance ]");
    try append_line(out,
        "  %type_apply_depth = phi i64 [ 0, %type_apply_loop_entry ], [ %type_apply_depth_next, %type_apply_advance ]");
    try append_line(out,
        "  %type_apply_prev_end = phi i64 [ %type_apply_first_start, %type_apply_loop_entry ], [ %type_apply_token_end, %type_apply_advance ]");
    try append_line(out,
        "  %type_apply_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_apply_index)");
    try append_line(out, "  %type_apply_kind = extractvalue %kizu.kizu.lexer.token %type_apply_token, 0");
    try append_line(out, "  %type_apply_token_end = extractvalue %kizu.kizu.lexer.token %type_apply_token, 2");
    try append_line(out, "  %type_apply_eof = icmp eq i64 %type_apply_kind, 62");
    try append_line(out, "  br i1 %type_apply_eof, label %fail, label %type_apply_check_lt");
    try append_line(out, "type_apply_check_lt:");
    try append_line(out, "  %type_apply_is_lt = icmp eq i64 %type_apply_kind, 46");
    try append_line(out, "  br i1 %type_apply_is_lt, label %type_apply_inc, label %type_apply_check_gt");
    try append_line(out, "type_apply_inc:");
    try append_line(out, "  %type_apply_depth_inc = add i64 %type_apply_depth, 1");
    try append_line(out, "  br label %type_apply_advance");
    try append_line(out, "type_apply_check_gt:");
    try append_line(out, "  %type_apply_is_gt = icmp eq i64 %type_apply_kind, 48");
    try append_line(out, "  br i1 %type_apply_is_gt, label %type_apply_dec, label %type_apply_keep");
    try append_line(out, "type_apply_dec:");
    try append_line(out, "  %type_apply_depth_zero = icmp eq i64 %type_apply_depth, 0");
    try append_line(out, "  br i1 %type_apply_depth_zero, label %type_apply_one_done, label %type_apply_dec_continue");
    try append_line(out, "type_apply_dec_continue:");
    try append_line(out, "  %type_apply_depth_dec = sub i64 %type_apply_depth, 1");
    try append_line(out, "  br label %type_apply_advance");
    try append_line(out, "type_apply_keep:");
    try append_line(out, "  %type_apply_is_comma = icmp eq i64 %type_apply_kind, 34");
    try append_line(out, "  br i1 %type_apply_is_comma, label %type_apply_comma, label %type_apply_advance");
    try append_line(out, "type_apply_comma:");
    try append_line(out, "  %type_apply_comma_top = icmp eq i64 %type_apply_depth, 0");
    try append_line(out, "  br i1 %type_apply_comma_top, label %type_apply_second_probe, label %type_apply_advance");
    try append_line(out, "type_apply_advance:");
    try append_line(out,
        "  %type_apply_depth_next = phi i64 [ %type_apply_depth_inc, %type_apply_inc ], [ %type_apply_depth_dec, %type_apply_dec_continue ], [ %type_apply_depth, %type_apply_keep ], [ %type_apply_depth, %type_apply_comma ]");
    try append_line(out, "  %type_apply_next = add i64 %type_apply_index, 1");
    try append_line(out, "  br label %type_apply_loop");
    try append_line(out, "type_apply_one_done:");
    try append_line(out,
        "  %type_apply_arg1_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_apply_first_start, i64 %type_apply_prev_end, i64 3)");
    try append_line(out, "  %type_apply_one_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out,
        "  %type_apply_one_append = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %type_apply_arg1_node)");
    try append_line(out, "  %type_apply_one_append_ok = extractvalue %kizu.error.void %type_apply_one_append, 0");
    try append_line(out, "  br i1 %type_apply_one_append_ok, label %type_apply_one_emit, label %fail");
    try append_line(out, "type_apply_one_emit:");
    try append_line(out,
        "  %type_apply_one_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_type_apply_expr(%kizu.kizu.ast.ast %ast, i64 %type_apply_token_end, %kizu.kizu.ast.node_id %receiver, i64 %type_apply_one_child_start, i64 1)");
    try append_line(out, "  %after_type_apply_one = add i64 %type_apply_index, 1");
    try append_line(out, "  br label %type_apply_emit");
    try append_line(out, "type_apply_second_probe:");
    try append_line(out,
        "  %type_apply_arg1_node_two = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_apply_first_start, i64 %type_apply_prev_end, i64 3)");
    try append_line(out, "  %type_apply_second = add i64 %type_apply_index, 1");
    try append_line(out,
        "  %type_apply_second_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_apply_second)");
    try append_line(out, "  %type_apply_second_kind = extractvalue %kizu.kizu.lexer.token %type_apply_second_token, 0");
    try append_line(out, "  %type_apply_second_dyn = icmp eq i64 %type_apply_second_kind, 7");
    try append_line(out, "  %type_apply_second_ident = icmp eq i64 %type_apply_second_kind, 27");
    try append_line(out, "  %type_apply_second_bang = icmp eq i64 %type_apply_second_kind, 40");
    try append_line(out, "  %type_apply_second_amp = icmp eq i64 %type_apply_second_kind, 43");
    try append_line(out, "  %type_apply_second_slice = icmp eq i64 %type_apply_second_kind, 44");
    try append_line(out, "  %type_apply_second_question = icmp eq i64 %type_apply_second_kind, 50");
    try append_line(out, "  %type_apply_second_ok0 = or i1 %type_apply_second_dyn, %type_apply_second_ident");
    try append_line(out, "  %type_apply_second_ok1 = or i1 %type_apply_second_ok0, %type_apply_second_bang");
    try append_line(out, "  %type_apply_second_ok2 = or i1 %type_apply_second_ok1, %type_apply_second_amp");
    try append_line(out, "  %type_apply_second_ok3 = or i1 %type_apply_second_ok2, %type_apply_second_slice");
    try append_line(out, "  %type_apply_second_ok = or i1 %type_apply_second_ok3, %type_apply_second_question");
    try append_line(out, "  br i1 %type_apply_second_ok, label %type_apply_second_loop_entry, label %fail");
    try append_line(out, "type_apply_second_loop_entry:");
    try append_line(out, "  %type_apply_second_start = extractvalue %kizu.kizu.lexer.token %type_apply_second_token, 1");
    try append_line(out, "  br label %type_apply_second_loop");
    try append_line(out, "type_apply_second_loop:");
    try append_line(out,
        "  %type_apply_second_index = phi i64 [ %type_apply_second, %type_apply_second_loop_entry ], [ %type_apply_second_next, %type_apply_second_advance ]");
    try append_line(out,
        "  %type_apply_second_depth = phi i64 [ 0, %type_apply_second_loop_entry ], [ %type_apply_second_depth_next, %type_apply_second_advance ]");
    try append_line(out,
        "  %type_apply_second_prev_end = phi i64 [ %type_apply_second_start, %type_apply_second_loop_entry ], [ %type_apply_second_token_end, %type_apply_second_advance ]");
    try append_line(out,
        "  %type_apply_second_scan_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_apply_second_index)");
    try append_line(out, "  %type_apply_second_scan_kind = extractvalue %kizu.kizu.lexer.token %type_apply_second_scan_token, 0");
    try append_line(out, "  %type_apply_second_token_end = extractvalue %kizu.kizu.lexer.token %type_apply_second_scan_token, 2");
    try append_line(out, "  %type_apply_second_eof = icmp eq i64 %type_apply_second_scan_kind, 62");
    try append_line(out, "  br i1 %type_apply_second_eof, label %fail, label %type_apply_second_check_lt");
    try append_line(out, "type_apply_second_check_lt:");
    try append_line(out, "  %type_apply_second_is_lt = icmp eq i64 %type_apply_second_scan_kind, 46");
    try append_line(out, "  br i1 %type_apply_second_is_lt, label %type_apply_second_inc, label %type_apply_second_check_gt");
    try append_line(out, "type_apply_second_inc:");
    try append_line(out, "  %type_apply_second_depth_inc = add i64 %type_apply_second_depth, 1");
    try append_line(out, "  br label %type_apply_second_advance");
    try append_line(out, "type_apply_second_check_gt:");
    try append_line(out, "  %type_apply_second_is_gt = icmp eq i64 %type_apply_second_scan_kind, 48");
    try append_line(out, "  br i1 %type_apply_second_is_gt, label %type_apply_second_dec, label %type_apply_second_check_comma");
    try append_line(out, "type_apply_second_dec:");
    try append_line(out, "  %type_apply_second_depth_zero = icmp eq i64 %type_apply_second_depth, 0");
    try append_line(out, "  br i1 %type_apply_second_depth_zero, label %type_apply_two_done, label %type_apply_second_dec_continue");
    try append_line(out, "type_apply_second_dec_continue:");
    try append_line(out, "  %type_apply_second_depth_dec = sub i64 %type_apply_second_depth, 1");
    try append_line(out, "  br label %type_apply_second_advance");
    try append_line(out, "type_apply_second_check_comma:");
    try append_line(out, "  %type_apply_second_is_comma = icmp eq i64 %type_apply_second_scan_kind, 34");
    try append_line(out, "  %type_apply_second_comma_top = icmp eq i64 %type_apply_second_depth, 0");
    try append_line(out, "  %type_apply_second_extra_arg = and i1 %type_apply_second_is_comma, %type_apply_second_comma_top");
    try append_line(out, "  br i1 %type_apply_second_extra_arg, label %fail, label %type_apply_second_advance");
    try append_line(out, "type_apply_second_advance:");
    try append_line(out,
        "  %type_apply_second_depth_next = phi i64 [ %type_apply_second_depth_inc, %type_apply_second_inc ], [ %type_apply_second_depth_dec, %type_apply_second_dec_continue ], [ %type_apply_second_depth, %type_apply_second_check_comma ]");
    try append_line(out, "  %type_apply_second_next = add i64 %type_apply_second_index, 1");
    try append_line(out, "  br label %type_apply_second_loop");
    try append_line(out, "type_apply_two_done:");
    try append_line(out,
        "  %type_apply_arg2_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_apply_second_start, i64 %type_apply_second_prev_end, i64 3)");
    try append_line(out, "  %type_apply_two_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out,
        "  %type_apply_two_append1 = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %type_apply_arg1_node_two)");
    try append_line(out, "  %type_apply_two_append1_ok = extractvalue %kizu.error.void %type_apply_two_append1, 0");
    try append_line(out, "  br i1 %type_apply_two_append1_ok, label %type_apply_two_append_second, label %fail");
    try append_line(out, "type_apply_two_append_second:");
    try append_line(out,
        "  %type_apply_two_append2 = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %type_apply_arg2_node)");
    try append_line(out, "  %type_apply_two_append2_ok = extractvalue %kizu.error.void %type_apply_two_append2, 0");
    try append_line(out, "  br i1 %type_apply_two_append2_ok, label %type_apply_two_emit, label %fail");
    try append_line(out, "type_apply_two_emit:");
    try append_line(out,
        "  %type_apply_two_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_type_apply_expr(%kizu.kizu.ast.ast %ast, i64 %type_apply_second_token_end, %kizu.kizu.ast.node_id %receiver, i64 %type_apply_two_child_start, i64 2)");
    try append_line(out, "  %after_type_apply_two = add i64 %type_apply_second_index, 1");
    try append_line(out, "  br label %type_apply_emit");
    try append_line(out, "type_apply_emit:");
    try append_line(out,
        "  %type_apply_node = phi %kizu.kizu.ast.node_id [ %type_apply_one_node, %type_apply_one_emit ], [ %type_apply_two_node, %type_apply_two_emit ]");
    try append_line(out,
        "  %after_type_apply = phi i64 [ %after_type_apply_one, %type_apply_one_emit ], [ %after_type_apply_two, %type_apply_two_emit ]");
    try append_line(out, "  br label %loop");
    try append_line(out, "maybe_call:");
    try append_line(out, "  %is_lparen = icmp eq i64 %current_kind, 31");
    try append_line(out, "  br i1 %is_lparen, label %parse_call, label %done");
    try append_line(out, "parse_call:");
    try append_line(out,
        "  %call_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_call(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %receiver, i64 %current)");
    try append_line(out, "  %call_result_ok = extractvalue %kizu.selfhost.cli.parse_node_result %call_result, 0");
    try append_line(out, "  br i1 %call_result_ok, label %call_ok, label %fail");
    try append_line(out, "call_ok:");
    try append_line(out, "  %call_next = extractvalue %kizu.selfhost.cli.parse_node_result %call_result, 1");
    try append_line(out, "  %call_node = extractvalue %kizu.selfhost.cli.parse_node_result %call_result, 2");
    try append_line(out, "  br label %loop");
    try append_line(out, "done:");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %current, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %receiver, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_call_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_call(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  %kizu.kizu.ast.node_id %callee,");
    try append_line(out, "  i64 %open_index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %arg_index = add i64 %open_index, 1");
    try append_line(out,
        "  %first = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %arg_index)");
    try append_line(out, "  %first_kind = extractvalue %kizu.kizu.lexer.token %first, 0");
    try append_line(out, "  %no_args = icmp eq i64 %first_kind, 32");
    try append_line(out, "  br i1 %no_args, label %build_no_args, label %parse_arg");
    try append_line(out, "build_no_args:");
    try append_line(out, "  %child_start_empty = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  %close_end_empty = extractvalue %kizu.kizu.lexer.token %first, 2");
    try append_line(out,
        "  %call_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_call(%kizu.kizu.ast.ast %ast, i64 %close_end_empty, %kizu.kizu.ast.node_id %callee, i64 %child_start_empty, i64 0)");
    try append_line(out, "  %next_empty = add i64 %arg_index, 1");
    try append_line(out,
        "  %empty_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %empty_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %empty_ok0, i64 %next_empty, 1");
    try append_line(out,
        "  %empty_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %empty_ok1, %kizu.kizu.ast.node_id %call_empty, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %empty_ok2");
    try append_line(out, "parse_arg:");
    try append_line(out, "  %arg_is_ident = icmp eq i64 %first_kind, 27");
    try append_line(out, "  br i1 %arg_is_ident, label %arg_peek_struct, label %arg_expr");
    try append_line(out, "arg_peek_struct:");
    try append_line(out, "  %arg_brace_index = add i64 %arg_index, 1");
    try append_line(out,
        "  %arg_brace_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %arg_brace_index)");
    try append_line(out, "  %arg_brace_kind = extractvalue %kizu.kizu.lexer.token %arg_brace_token, 0");
    try append_line(out, "  %arg_is_struct = icmp eq i64 %arg_brace_kind, 29");
    try append_line(out, "  br i1 %arg_is_struct, label %arg_struct, label %arg_expr");
    try append_line(out, "arg_struct:");
    try append_line(out,
        "  %arg_struct_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_struct_literal(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %arg_index)");
    try append_line(out, "  br label %arg_join");
    try append_line(out, "arg_expr:");
    try append_line(out,
        "  %arg_expr_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %arg_index)");
    try append_line(out, "  br label %arg_join");
    try append_line(out, "arg_join:");
    try append_line(out,
