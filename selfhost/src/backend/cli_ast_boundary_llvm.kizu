// cli_add_match records a Match node (variant tag 39) carrying the matched
// value node and the contiguous arm child range.
fn append_add_match_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_match(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  %kizu.kizu.ast.node_id %value,");
    try append_line(out, "  i64 %arm_start,");
    try append_line(out, "  i64 %arm_len");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %range0 = insertvalue %kizu.kizu.ast.child_range poison, i64 %arm_start, 0");
    try append_line(out, "  %range = insertvalue %kizu.kizu.ast.child_range %range0, i64 %arm_len, 1");
    try append_line(out,
        "  %p0 = insertvalue %kizu.kizu.ast.match_node poison, %kizu.kizu.ast.node_id %value, 0");
    try append_line(out,
        "  %payload = insertvalue %kizu.kizu.ast.match_node %p0, %kizu.kizu.ast.child_range %range, 1");
    try append_node_with_payload(out, "%kizu.kizu.ast.match_node", "payload", "39");
    return;
}

// cli_add_match_arm records a MatchArm node (variant tag 40) spanning the
// pattern's start to the body's end.
fn append_add_match_arm_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_match_arm(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %pattern,");
    try append_line(out, "  %kizu.kizu.ast.node_id %binding,");
    try append_line(out, "  %kizu.kizu.ast.node_id %body");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %pattern_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %pattern)");
    try append_line(out, "  %pattern_span = extractvalue %kizu.kizu.ast.ast_node %pattern_node, 0");
    try append_line(out, "  %start = extractvalue %kizu.kizu.ast.span %pattern_span, 0");
    try append_line(out,
        "  %body_ast_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %body)");
    try append_line(out, "  %body_span = extractvalue %kizu.kizu.ast.ast_node %body_ast_node, 0");
    try append_line(out, "  %end = extractvalue %kizu.kizu.ast.span %body_span, 1");
    try append_line(out,
        "  %p0 = insertvalue %kizu.kizu.ast.match_arm_node poison, %kizu.kizu.ast.node_id %pattern, 0");
    try append_line(out,
        "  %p1 = insertvalue %kizu.kizu.ast.match_arm_node %p0, %kizu.kizu.ast.node_id %binding, 1");
    try append_line(out,
        "  %payload = insertvalue %kizu.kizu.ast.match_arm_node %p1, %kizu.kizu.ast.node_id %body, 2");
    try append_node_with_payload(out, "%kizu.kizu.ast.match_arm_node", "payload", "40");
    return;
}

