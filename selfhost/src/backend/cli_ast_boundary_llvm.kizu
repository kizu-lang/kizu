    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 29");
    try append_line(out, "  br i1 %open_ok, label %parse_body, label %fail");
    try append_line(out, "parse_body:");
    try append_line(out,
        "  %body_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_block(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %body_ok = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 0");
    try append_line(out, "  br i1 %body_ok, label %build, label %fail");
    try append_line(out, "build:");
