fn append_parse_for_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_for(");
    try append_line(out, "  %kizu.owned %allocator,");
