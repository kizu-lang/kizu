    try append_line(out, "  %test_end = extractvalue %kizu.kizu.lexer.token %body_close, 2");
    try append_line(out,
        "  %empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %test_start, i64 %test_start, i64 44)");
    try append_line(out,
        "  %fn_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_fn_decl(%kizu.kizu.ast.ast %ast, i64 %test_start, i64 %test_end, %kizu.kizu.ast.node_id %name_node, i64 0, i64 0, %kizu.kizu.ast.node_id %empty, %kizu.kizu.ast.node_id %empty, %kizu.kizu.ast.node_id %body_node)");
    try append_line(out,
