    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_is_string = icmp eq i64 %name_kind, 61");
    try append_line(out, "  br i1 %name_is_string, label %check_open, label %fail");
