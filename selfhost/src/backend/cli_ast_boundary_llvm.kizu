    try append_line(out, "  br label %op_ready");
    try append_line(out, "op_ready:");
    try append_line(out, "  %binary_op = phi i64 [ 5, %op_eq ], [ 7, %op_lt ]");
    try append_line(out, "  %rhs_index = add i64 %primary_next, 1");
    try append_line(out,
        "  %rhs = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_additive_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %rhs_index)");
