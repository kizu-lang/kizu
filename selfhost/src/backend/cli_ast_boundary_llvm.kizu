pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant_bytes(out, "ast_test_keyword", "test");
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_ast_new_function(out);
    try append_ast_child_len_function(out);
    try append_ast_append_child_function(out);
    try append_token_at_function(out);
    try append_token_text_equal_function(out);
    try append_unsupported_parse_result_function(out);
    try append_parse_validated_ast_function(out);
    try append_parse_decl_function(out);
    try append_parse_fn_decl_function(out);
    try append_parse_test_decl_function(out);
    try append_parse_block_function(out);
    try append_parse_statement_function(out);
    try append_parse_return_function(out);
    try append_parse_let_function(out);
    try append_parse_assign_function(out);
    try append_parse_if_function(out);
    try append_parse_while_function(out);
    try append_parse_for_function(out);
    try append_parse_break_function(out);
    try append_parse_continue_function(out);
    try append_parse_expr_statement_function(out);
    try append_parse_expr_function(out);
    try append_parse_binary_expr_function(out);
    try append_parse_primary_expr_function(out);
    try append_parse_ident_expr_function(out);
    try append_parse_call_function(out);
    try append_add_leaf_node_function(out);
    try append_add_program_function(out);
    try append_add_param_function(out);
    try append_add_fn_decl_function(out);
    try append_add_block_function(out);
    try append_add_let_function(out);
    try append_add_assign_function(out);
    try append_add_return_function(out);
    try append_add_expr_stmt_function(out);
    try append_add_if_function(out);
    try append_add_while_function(out);
    try append_add_for_function(out);
    try append_add_break_function(out);
    try append_add_continue_function(out);
    try append_add_binary_function(out);
    try append_add_field_expr_function(out);
    try append_add_call_function(out);
    try append_add_try_expr_function(out);
    try append_add_prefix_function(out);
    return;
}

fn append_ast_new_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %nodes = call %kizu.owned @kizu_rt_array_new(%kizu.owned %allocator, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.ast_node, ptr null, i32 1) to i64))");
    try append_line(out,
        "  %children = call %kizu.owned @kizu_rt_array_new(%kizu.owned %allocator, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.node_id, ptr null, i32 1) to i64))");
    try append_line(out,
        "  %file0 = insertvalue %kizu.kizu.ast.source_file poison, %kizu.slice.u8 %path, 0");
    try append_line(out,
        "  %file = insertvalue %kizu.kizu.ast.source_file %file0, %kizu.slice.u8 %source, 1");
    try append_line(out, "  %ast0 = insertvalue %kizu.kizu.ast.ast poison, %kizu.owned %nodes, 0");
    try append_line(out, "  %ast1 = insertvalue %kizu.kizu.ast.ast %ast0, %kizu.owned %children, 1");
    try append_line(out,
        "  %ast = insertvalue %kizu.kizu.ast.ast %ast1, %kizu.kizu.ast.source_file %file, 2");
    try append_line(out, "  ret %kizu.kizu.ast.ast %ast");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_ast_child_len_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_ast_child_len(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %children = extractvalue %kizu.kizu.ast.ast %ast, 1");
    try append_line(out, "  %len = call i64 @kizu_rt_array_len(%kizu.owned %children)");
    try append_line(out, "  ret i64 %len");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_ast_append_child_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__cli_ast_append_child(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %child");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.node_id, align 8");
    try append_line(out, "  store %kizu.kizu.ast.node_id %child, ptr %slot, align 8");
    try append_line(out, "  %slice0 = insertvalue %kizu.slice.u8 poison, ptr %slot, 0");
    try append_line(out,
        "  %slice = insertvalue %kizu.slice.u8 %slice0, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.node_id, ptr null, i32 1) to i64), 1");
    try append_line(out, "  %children = extractvalue %kizu.kizu.ast.ast %ast, 1");
    try append_line(out,
        "  %result = call %kizu.error.void @kizu_rt_array_append(%kizu.owned %children, %kizu.slice.u8 %slice)");
    try append_line(out, "  ret %kizu.error.void %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_token_at_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %view = call %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %ok = extractvalue %kizu.error.slice.u8 %view, 0");
    try append_line(out, "  br i1 %ok, label %load, label %fallback");
    try append_line(out, "load:");
    try append_line(out, "  %slice = extractvalue %kizu.error.slice.u8 %view, 1");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %slice, 0");
    try append_line(out, "  %token = load %kizu.kizu.lexer.token, ptr %ptr, align 8");
    try append_line(out, "  ret %kizu.kizu.lexer.token %token");
    try append_line(out, "fallback:");
    try append_line(out,
        "  %eof = insertvalue %kizu.kizu.lexer.token zeroinitializer, i64 61, 0");
    try append_line(out, "  ret %kizu.kizu.lexer.token %eof");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_token_text_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_text_equal(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.lexer.token %token,");
    try append_line(out, "  %kizu.slice.u8 %expected");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %slice0 = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %slice0, i64 %len, 1");
    try append_line(out,
        "  %same = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %slice, %kizu.slice.u8 %expected)");
    try append_line(out, "  ret i1 %same");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_unsupported_parse_result_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.parse_result @kizu_selfhost__cli_unsupported_parse_result(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %ast = call %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out,
        "  %root = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 0, i64 0, i64 44)");
    try append_line(out,
        "  %parsed = call %kizu.kizu.ast.parse_result @kizu_kizu__ast_parse_result(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %root)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %parsed");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_validated_ast_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.parse_result @kizu_selfhost__cli_parse_validated_ast(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %decl_slots = alloca [16 x %kizu.kizu.ast.node_id], align 8");
    try append_line(out,
        "  %tokens_result = call %kizu.error.owned @kizu_kizu__lexer_tokenize(%kizu.owned %allocator, %kizu.slice.u8 %source)");
    try append_line(out, "  %tokens_ok = extractvalue %kizu.error.owned %tokens_result, 0");
    try append_line(out, "  br i1 %tokens_ok, label %parse, label %unsupported");
    try append_line(out, "parse:");
    try append_line(out, "  %tokens = extractvalue %kizu.error.owned %tokens_result, 1");
    try append_line(out,
        "  %ast = call %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out, "  br label %parse_loop");
    try append_line(out, "parse_loop:");
    try append_line(out, "  %index = phi i64 [ 0, %parse ], [ %decl_next, %store_decl ]");
    try append_line(out, "  %decl_count = phi i64 [ 0, %parse ], [ %decl_count_next, %store_decl ]");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_eof = icmp eq i64 %kind, 62");
    try append_line(out, "  br i1 %is_eof, label %finish, label %parse_decl");
    try append_line(out, "parse_decl:");
    try append_line(out,
        "  %decl = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %decl_ok = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 0");
    try append_line(out, "  br i1 %decl_ok, label %decl_ok_block, label %unsupported");
    try append_line(out, "decl_ok_block:");
    try append_line(out, "  %decl_next = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 1");
    try append_line(out, "  %decl_node = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 2");
    try append_line(out, "  %advanced = icmp sgt i64 %decl_next, %index");
    try append_line(out, "  %has_capacity = icmp slt i64 %decl_count, 16");
    try append_line(out, "  %can_store = and i1 %advanced, %has_capacity");
    try append_line(out, "  br i1 %can_store, label %store_decl, label %unsupported");
    try append_line(out, "store_decl:");
    try append_line(out,
        "  %decl_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %decl_slots, i64 0, i64 %decl_count");
    try append_line(out, "  store %kizu.kizu.ast.node_id %decl_node, ptr %decl_slot, align 8");
    try append_line(out, "  %decl_count_next = add i64 %decl_count, 1");
    try append_line(out, "  br label %parse_loop");
    try append_line(out, "finish:");
    try append_line(out, "  %decl_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  br label %append_decls");
    try append_line(out, "append_decls:");
    try append_line(out, "  %append_index = phi i64 [ 0, %finish ], [ %append_next, %append_ok ]");
    try append_line(out, "  %append_done = icmp eq i64 %append_index, %decl_count");
    try append_line(out, "  br i1 %append_done, label %build_program, label %append_decl");
    try append_line(out, "append_decl:");
    try append_line(out,
        "  %append_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %decl_slots, i64 0, i64 %append_index");
    try append_line(out, "  %append_node = load %kizu.kizu.ast.node_id, ptr %append_slot, align 8");
    try append_line(out,
        "  %append_result = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %append_node)");
    try append_line(out, "  %append_result_ok = extractvalue %kizu.error.void %append_result, 0");
    try append_line(out, "  br i1 %append_result_ok, label %append_ok, label %unsupported");
    try append_line(out, "append_ok:");
    try append_line(out, "  %append_next = add i64 %append_index, 1");
    try append_line(out, "  br label %append_decls");
    try append_line(out, "build_program:");
    try append_line(out, "  %eof_end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %program = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_program(%kizu.kizu.ast.ast %ast, i64 0, i64 %eof_end, i64 %decl_start, i64 %decl_count)");
    try append_line(out,
        "  %parsed = call %kizu.kizu.ast.parse_result @kizu_kizu__ast_parse_result(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %program)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %parsed");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.kizu.ast.parse_result @kizu_selfhost__cli_unsupported_parse_result(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_fn = icmp eq i64 %kind, 0");
    try append_line(out, "  br i1 %is_fn, label %parse_fn, label %maybe_test");
    try append_line(out, "parse_fn:");
    try append_line(out,
        "  %fn_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_fn_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %fn_result");
    try append_line(out, "maybe_test:");
    try append_line(out, "  %is_ident = icmp eq i64 %kind, 27");
    try append_line(out, "  br i1 %is_ident, label %check_test, label %fail");
    try append_line(out, "check_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.ast_test_keyword, i64 0, i64 0");
    try append_line(out, "  %test0 = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test0, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__cli_token_text_equal(%kizu.slice.u8 %source, %kizu.kizu.lexer.token %token, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %parse_test, label %fail");
    try append_line(out, "parse_test:");
    try append_line(out,
        "  %test_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_test_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %test_result");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_fn_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_fn_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %fn_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_is_ident = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_is_ident, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 31");
    try append_line(out, "  br i1 %open_ok, label %check_params, label %fail");
    // The parameter list parses through one cursor loop: each iteration consumes
    // 'name: type' (appending its Param child contiguously), a comma continues the
    // loop, and ')' (at the loop head or after a param) closes it. Any parameter
    // count parses; nothing is special-cased per arity.
    try append_line(out, "check_params:");
    try append_line(out, "  %params_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  %first_param_index = add i64 %index, 3");
    try append_line(out, "  br label %param_loop");
    try append_line(out, "param_loop:");
    try append_line(out, "  %p_cursor = phi i64 [ %first_param_index, %check_params ], [ %p_after_comma, %param_sep_comma ]");
    try append_line(out, "  %p_count = phi i64 [ 0, %check_params ], [ %p_count_next, %param_sep_comma ]");
    try append_line(out,
        "  %p_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_cursor)");
    try append_line(out, "  %p_kind = extractvalue %kizu.kizu.lexer.token %p_token, 0");
    try append_line(out, "  %p_is_close = icmp eq i64 %p_kind, 32");
    try append_line(out, "  br i1 %p_is_close, label %params_done_head, label %param_name");
    try append_line(out, "param_name:");
    try append_line(out, "  %p_name_ok = icmp eq i64 %p_kind, 27");
    try append_line(out, "  br i1 %p_name_ok, label %param_colon, label %fail");
    try append_line(out, "param_colon:");
    try append_line(out, "  %p_colon_index = add i64 %p_cursor, 1");
    try append_line(out,
        "  %p_colon_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_colon_index)");
    try append_line(out, "  %p_colon_kind = extractvalue %kizu.kizu.lexer.token %p_colon_token, 0");
    try append_line(out, "  %p_colon_ok = icmp eq i64 %p_colon_kind, 35");
    try append_line(out, "  br i1 %p_colon_ok, label %param_type, label %fail");
    // A parameter type is either one ident token ('i64', 'bool') or the '[' ']'
    // ident token run of a slice type ('[]u8'); both build one TypeName leaf whose
    // span covers the whole type text, so the codegen param classifier reads it
    // without any boundary-specific shape.
    try append_line(out, "param_type:");
    try append_line(out, "  %p_type_index = add i64 %p_cursor, 2");
    try append_line(out,
        "  %p_type_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_type_index)");
    try append_line(out, "  %p_type_kind = extractvalue %kizu.kizu.lexer.token %p_type_token, 0");
    try append_line(out, "  %p_type_is_ident = icmp eq i64 %p_type_kind, 27");
    try append_line(out, "  br i1 %p_type_is_ident, label %param_type_ident, label %param_type_slice");
    try append_line(out, "param_type_ident:");
    try append_line(out, "  %p_type_end_ident = extractvalue %kizu.kizu.lexer.token %p_type_token, 2");
    try append_line(out, "  %p_after_type_ident = add i64 %p_cursor, 3");
    try append_line(out, "  br label %param_build");
    try append_line(out, "param_type_slice:");
    try append_line(out, "  %p_type_is_lbracket = icmp eq i64 %p_type_kind, 44");
    try append_line(out, "  br i1 %p_type_is_lbracket, label %param_type_slice_close, label %fail");
    try append_line(out, "param_type_slice_close:");
    try append_line(out, "  %p_rbracket_index = add i64 %p_cursor, 3");
    try append_line(out,
        "  %p_rbracket_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_rbracket_index)");
    try append_line(out, "  %p_rbracket_kind = extractvalue %kizu.kizu.lexer.token %p_rbracket_token, 0");
    try append_line(out, "  %p_rbracket_ok = icmp eq i64 %p_rbracket_kind, 45");
    try append_line(out, "  br i1 %p_rbracket_ok, label %param_type_slice_elem, label %fail");
    try append_line(out, "param_type_slice_elem:");
    try append_line(out, "  %p_elem_index = add i64 %p_cursor, 4");
    try append_line(out,
        "  %p_elem_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_elem_index)");
    try append_line(out, "  %p_elem_kind = extractvalue %kizu.kizu.lexer.token %p_elem_token, 0");
    try append_line(out, "  %p_elem_ok = icmp eq i64 %p_elem_kind, 27");
    try append_line(out, "  br i1 %p_elem_ok, label %param_type_slice_build, label %fail");
    try append_line(out, "param_type_slice_build:");
    try append_line(out, "  %p_type_end_slice = extractvalue %kizu.kizu.lexer.token %p_elem_token, 2");
    try append_line(out, "  %p_after_type_slice = add i64 %p_cursor, 5");
    try append_line(out, "  br label %param_build");
    try append_line(out, "param_build:");
    try append_line(out,
        "  %p_type_end = phi i64 [ %p_type_end_ident, %param_type_ident ], [ %p_type_end_slice, %param_type_slice_build ]");
    try append_line(out,
        "  %p_sep_index = phi i64 [ %p_after_type_ident, %param_type_ident ], [ %p_after_type_slice, %param_type_slice_build ]");
    try append_line(out, "  %p_name_start = extractvalue %kizu.kizu.lexer.token %p_token, 1");
    try append_line(out, "  %p_name_end = extractvalue %kizu.kizu.lexer.token %p_token, 2");
    try append_line(out, "  %p_type_start = extractvalue %kizu.kizu.lexer.token %p_type_token, 1");
    try append_line(out,
        "  %p_name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %p_name_start, i64 %p_name_end, i64 4)");
    try append_line(out,
        "  %p_type_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %p_type_start, i64 %p_type_end, i64 3)");
    try append_line(out,
        "  %p_param_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_param(%kizu.kizu.ast.ast %ast, i64 %p_name_start, i64 %p_type_end, %kizu.kizu.ast.node_id %p_name_node, %kizu.kizu.ast.node_id %p_type_node)");
    try append_line(out,
        "  %p_append = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %p_param_node)");
    try append_line(out, "  %p_append_ok = extractvalue %kizu.error.void %p_append, 0");
    try append_line(out, "  br i1 %p_append_ok, label %param_sep, label %fail");
    try append_line(out, "param_sep:");
    try append_line(out, "  %p_count_next = add i64 %p_count, 1");
    try append_line(out,
        "  %p_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_sep_index)");
    try append_line(out, "  %p_sep_kind = extractvalue %kizu.kizu.lexer.token %p_sep_token, 0");
    try append_line(out, "  %p_is_comma = icmp eq i64 %p_sep_kind, 34");
    try append_line(out, "  br i1 %p_is_comma, label %param_sep_comma, label %param_sep_close");
    try append_line(out, "param_sep_comma:");
    try append_line(out, "  %p_after_comma = add i64 %p_sep_index, 1");
    try append_line(out, "  br label %param_loop");
    try append_line(out, "param_sep_close:");
    try append_line(out, "  %p_sep_is_close = icmp eq i64 %p_sep_kind, 32");
    try append_line(out, "  br i1 %p_sep_is_close, label %params_done_sep, label %fail");
    try append_line(out, "params_done_head:");
    try append_line(out, "  br label %after_params");
    try append_line(out, "params_done_sep:");
    try append_line(out, "  br label %after_params");
    try append_line(out, "after_params:");
    try append_line(out, "  %p_close_index = phi i64 [ %p_cursor, %params_done_head ], [ %p_sep_index, %params_done_sep ]");
    try append_line(out, "  %param_len = phi i64 [ %p_count, %params_done_head ], [ %p_count_next, %params_done_sep ]");
    try append_line(out,
        "  %p_close_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_close_index)");
    try append_line(out, "  %params_close_end = extractvalue %kizu.kizu.lexer.token %p_close_token, 2");
    try append_line(out, "  %after_params_index = add i64 %p_close_index, 1");
    try append_line(out, "  %param_start = select i1 true, i64 %params_child_start, i64 %params_child_start");
    try append_line(out,
        "  %after_params_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %after_params_index)");
    try append_line(out, "  %after_params_kind = extractvalue %kizu.kizu.lexer.token %after_params_token, 0");
    try append_line(out, "  %has_arrow = icmp eq i64 %after_params_kind, 38");
    try append_line(out, "  br i1 %has_arrow, label %parse_return_type, label %no_return_type");
    try append_line(out, "no_return_type:");
    try append_line(out,
        "  %return_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %params_close_end, i64 %params_close_end, i64 44)");
    try append_line(out, "  br label %body_common");
    try append_line(out, "parse_return_type:");
    try append_line(out, "  %ret_token_index = add i64 %after_params_index, 1");
    try append_line(out,
        "  %ret_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %ret_token_index)");
    try append_line(out, "  %ret_kind = extractvalue %kizu.kizu.lexer.token %ret_token, 0");
    try append_line(out, "  %ret_is_bang = icmp eq i64 %ret_kind, 40");
    try append_line(out, "  br i1 %ret_is_bang, label %ret_after_bang, label %ret_direct");
    try append_line(out, "ret_after_bang:");
    try append_line(out, "  %type_index_bang = add i64 %ret_token_index, 1");
    try append_line(out, "  br label %ret_type_common");
    try append_line(out, "ret_direct:");
    try append_line(out, "  br label %ret_type_common");
    try append_line(out, "ret_type_common:");
    try append_line(out,
        "  %type_index = phi i64 [ %type_index_bang, %ret_after_bang ], [ %ret_token_index, %ret_direct ]");
    try append_line(out,
        "  %type_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_index)");
    try append_line(out, "  %type_kind = extractvalue %kizu.kizu.lexer.token %type_token, 0");
    try append_line(out, "  %type_is_ident = icmp eq i64 %type_kind, 27");
    try append_line(out, "  br i1 %type_is_ident, label %return_type_ok, label %fail");
    try append_line(out, "return_type_ok:");
    try append_line(out, "  %type_token_start = extractvalue %kizu.kizu.lexer.token %type_token, 1");
    try append_line(out, "  %bang_start = extractvalue %kizu.kizu.lexer.token %ret_token, 1");
    try append_line(out, "  %type_start = select i1 %ret_is_bang, i64 %bang_start, i64 %type_token_start");
    try append_line(out, "  %type_end = extractvalue %kizu.kizu.lexer.token %type_token, 2");
    try append_line(out,
        "  %return_type = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_start, i64 %type_end, i64 3)");
    try append_line(out, "  %body_index_from_return = add i64 %type_index, 1");
    try append_line(out, "  br label %body_common");
    try append_line(out, "body_common:");
    try append_line(out,
        "  %body_index = phi i64 [ %after_params_index, %no_return_type ], [ %body_index_from_return, %return_type_ok ]");
    try append_line(out,
        "  %return_type_node = phi %kizu.kizu.ast.node_id [ %return_empty, %no_return_type ], [ %return_type, %return_type_ok ]");
    try append_line(out,
        "  %body_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %body_index)");
    try append_line(out, "  %body_kind = extractvalue %kizu.kizu.lexer.token %body_token, 0");
    try append_line(out, "  %body_is_lbrace = icmp eq i64 %body_kind, 29");
    try append_line(out, "  br i1 %body_is_lbrace, label %parse_body, label %fail");
    try append_line(out, "parse_body:");
    try append_line(out,
        "  %body_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_block(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %body_index)");
    try append_line(out, "  %body_ok = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 0");
    try append_line(out, "  br i1 %body_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %body_next = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 1");
    try append_line(out, "  %body_node = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 2");
    try append_line(out, "  %name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
    try append_line(out, "  %name_end = extractvalue %kizu.kizu.lexer.token %name_token, 2");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %name_start, i64 %name_end, i64 4)");
    try append_line(out, "  %fn_start = extractvalue %kizu.kizu.lexer.token %fn_token, 1");
    try append_line(out, "  %body_close_index = sub i64 %body_next, 1");
    try append_line(out,
        "  %body_close = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %body_close_index)");
    try append_line(out, "  %fn_end = extractvalue %kizu.kizu.lexer.token %body_close, 2");
    try append_line(out,
        "  %empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %fn_start, i64 %fn_start, i64 44)");
    try append_line(out,
        "  %fn_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_fn_decl(%kizu.kizu.ast.ast %ast, i64 %fn_start, i64 %fn_end, %kizu.kizu.ast.node_id %name_node, i64 %param_start, i64 %param_len, %kizu.kizu.ast.node_id %return_type_node, %kizu.kizu.ast.node_id %empty, %kizu.kizu.ast.node_id %body_node)");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %body_next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %fn_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_test_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_test_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %test_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_is_string = icmp eq i64 %name_kind, 61");
    try append_line(out, "  br i1 %name_is_string, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 29");
    try append_line(out, "  br i1 %open_ok, label %parse_body, label %fail");
    try append_line(out, "parse_body:");
    try append_line(out,
        "  %body_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_block(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %body_ok = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 0");
    try append_line(out, "  br i1 %body_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %body_next = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 1");
    try append_line(out, "  %body_node = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 2");
    try append_line(out, "  %name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
    try append_line(out, "  %name_end = extractvalue %kizu.kizu.lexer.token %name_token, 2");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %name_start, i64 %name_end, i64 2)");
    try append_line(out, "  %test_start = extractvalue %kizu.kizu.lexer.token %test_token, 1");
    try append_line(out, "  %body_close_index = sub i64 %body_next, 1");
    try append_line(out,
        "  %body_close = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %body_close_index)");
    try append_line(out, "  %test_end = extractvalue %kizu.kizu.lexer.token %body_close, 2");
    try append_line(out,
        "  %empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %test_start, i64 %test_start, i64 44)");
    try append_line(out,
        "  %fn_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_fn_decl(%kizu.kizu.ast.ast %ast, i64 %test_start, i64 %test_end, %kizu.kizu.ast.node_id %name_node, i64 0, i64 0, %kizu.kizu.ast.node_id %empty, %kizu.kizu.ast.node_id %empty, %kizu.kizu.ast.node_id %body_node)");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %body_next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %fn_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_block_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_block(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %open_index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %stmt_slots = alloca [16 x %kizu.kizu.ast.node_id], align 8");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %first_index = add i64 %open_index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ %first_index, %entry ], [ %stmt_next, %store_stmt ]");
    try append_line(out, "  %stmt_count = phi i64 [ 0, %entry ], [ %stmt_count_next, %store_stmt ]");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_rbrace = icmp eq i64 %kind, 30");
    try append_line(out, "  br i1 %is_rbrace, label %finish, label %maybe_eof");
    try append_line(out, "maybe_eof:");
    try append_line(out, "  %is_eof = icmp eq i64 %kind, 62");
    try append_line(out, "  br i1 %is_eof, label %fail, label %parse_stmt");
    try append_line(out, "parse_stmt:");
    try append_line(out,
        "  %stmt = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_statement(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %stmt_ok = extractvalue %kizu.selfhost.cli.parse_node_result %stmt, 0");
    try append_line(out, "  br i1 %stmt_ok, label %stmt_ok_block, label %fail");
    try append_line(out, "stmt_ok_block:");
    try append_line(out, "  %stmt_next = extractvalue %kizu.selfhost.cli.parse_node_result %stmt, 1");
    try append_line(out, "  %stmt_node = extractvalue %kizu.selfhost.cli.parse_node_result %stmt, 2");
    try append_line(out, "  %advanced = icmp sgt i64 %stmt_next, %index");
    try append_line(out, "  %has_capacity = icmp slt i64 %stmt_count, 16");
    try append_line(out, "  %can_store = and i1 %advanced, %has_capacity");
    try append_line(out, "  br i1 %can_store, label %store_stmt, label %fail");
    try append_line(out, "store_stmt:");
    try append_line(out,
        "  %stmt_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %stmt_slots, i64 0, i64 %stmt_count");
    try append_line(out, "  store %kizu.kizu.ast.node_id %stmt_node, ptr %stmt_slot, align 8");
    try append_line(out, "  %stmt_count_next = add i64 %stmt_count, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "finish:");
    try append_line(out, "  %child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  br label %append_stmts");
    try append_line(out, "append_stmts:");
    try append_line(out, "  %append_index = phi i64 [ 0, %finish ], [ %append_next, %append_ok ]");
    try append_line(out, "  %append_done = icmp eq i64 %append_index, %stmt_count");
    try append_line(out, "  br i1 %append_done, label %build, label %append_stmt");
    try append_line(out, "append_stmt:");
    try append_line(out,
        "  %append_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %stmt_slots, i64 0, i64 %append_index");
    try append_line(out, "  %append_node = load %kizu.kizu.ast.node_id, ptr %append_slot, align 8");
    try append_line(out,
        "  %append_result = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %append_node)");
    try append_line(out, "  %append_result_ok = extractvalue %kizu.error.void %append_result, 0");
    try append_line(out, "  br i1 %append_result_ok, label %append_ok, label %fail");
    try append_line(out, "append_ok:");
    try append_line(out, "  %append_next = add i64 %append_index, 1");
    try append_line(out, "  br label %append_stmts");
    try append_line(out, "build:");
    try append_line(out, "  %open_start = extractvalue %kizu.kizu.lexer.token %open_token, 1");
    try append_line(out, "  %close_end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %block = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_block(%kizu.kizu.ast.ast %ast, i64 %open_start, i64 %close_end, i64 %child_start, i64 %stmt_count)");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %block, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_statement_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_statement(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %stmt_start = extractvalue %kizu.kizu.lexer.token %token, 1");
    // An 'ident: while/for' prefix labels the loop; anything else falls through
    // to the ordinary statement dispatch.
    try append_line(out, "  %is_label_ident = icmp eq i64 %kind, 27");
    try append_line(out, "  br i1 %is_label_ident, label %label_check_colon, label %dispatch");
    try append_line(out, "label_check_colon:");
    try append_line(out, "  %label_colon_probe = add i64 %index, 1");
    try append_line(out,
        "  %label_colon_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %label_colon_probe)");
    try append_line(out, "  %label_colon_kind = extractvalue %kizu.kizu.lexer.token %label_colon_token, 0");
    try append_line(out, "  %label_has_colon = icmp eq i64 %label_colon_kind, 35");
    try append_line(out, "  br i1 %label_has_colon, label %label_check_loop, label %dispatch");
    try append_line(out, "label_check_loop:");
    try append_line(out, "  %label_loop_probe = add i64 %index, 2");
    try append_line(out,
        "  %label_loop_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %label_loop_probe)");
    try append_line(out, "  %label_loop_kind = extractvalue %kizu.kizu.lexer.token %label_loop_token, 0");
    try append_line(out, "  %label_is_while = icmp eq i64 %label_loop_kind, 15");
    try append_line(out, "  %label_is_for = icmp eq i64 %label_loop_kind, 16");
    try append_line(out, "  %label_is_loop = or i1 %label_is_while, %label_is_for");
    try append_line(out, "  br i1 %label_is_loop, label %parse_labeled_loop, label %dispatch");
    try append_line(out, "parse_labeled_loop:");
    try append_line(out, "  %label_end_pos = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %label_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %stmt_start, i64 %label_end_pos, i64 4)");
    try append_line(out, "  %labeled_index = add i64 %index, 2");
    try append_line(out, "  br i1 %label_is_while, label %parse_labeled_while, label %parse_labeled_for");
    try append_line(out, "parse_labeled_while:");
    try append_line(out,
        "  %labeled_while_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_while(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %label_node, i64 %labeled_index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %labeled_while_result");
    try append_line(out, "parse_labeled_for:");
    try append_line(out,
        "  %labeled_for_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_for(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %label_node, i64 %labeled_index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %labeled_for_result");
    try append_line(out, "dispatch:");
    try append_line(out, "  %is_let = icmp eq i64 %kind, 8");
    try append_line(out, "  br i1 %is_let, label %parse_let, label %maybe_var");
    try append_line(out, "maybe_var:");
    try append_line(out, "  %is_var = icmp eq i64 %kind, 9");
    try append_line(out, "  br i1 %is_var, label %parse_let, label %maybe_return");
    try append_line(out, "parse_let:");
    try append_line(out,
        "  %let_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_let(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %let_result");
    try append_line(out, "maybe_return:");
    try append_line(out, "  %is_return = icmp eq i64 %kind, 10");
    try append_line(out, "  br i1 %is_return, label %parse_return, label %maybe_if");
    try append_line(out, "parse_return:");
    try append_line(out,
        "  %return_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_return(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %return_result");
    try append_line(out, "maybe_if:");
    try append_line(out, "  %is_if = icmp eq i64 %kind, 13");
    try append_line(out, "  br i1 %is_if, label %parse_if, label %maybe_while");
    try append_line(out, "parse_if:");
    try append_line(out,
        "  %if_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_if(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %if_result");
    try append_line(out, "maybe_while:");
    try append_line(out, "  %is_while = icmp eq i64 %kind, 15");
    try append_line(out, "  br i1 %is_while, label %parse_while, label %maybe_for");
    try append_line(out, "parse_while:");
    try append_line(out,
        "  %while_label_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %stmt_start, i64 %stmt_start, i64 44)");
    try append_line(out,
        "  %while_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_while(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %while_label_empty, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %while_result");
    try append_line(out, "maybe_for:");
    try append_line(out, "  %is_for = icmp eq i64 %kind, 16");
    try append_line(out, "  br i1 %is_for, label %parse_for, label %maybe_break");
    try append_line(out, "parse_for:");
    try append_line(out,
        "  %for_label_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %stmt_start, i64 %stmt_start, i64 44)");
    try append_line(out,
        "  %for_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_for(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, %kizu.kizu.ast.node_id %for_label_empty, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %for_result");
    try append_line(out, "maybe_break:");
    try append_line(out, "  %is_break = icmp eq i64 %kind, 17");
    try append_line(out, "  br i1 %is_break, label %parse_break, label %maybe_continue");
    try append_line(out, "parse_break:");
    try append_line(out,
        "  %break_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_break(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %break_result");
    try append_line(out, "maybe_continue:");
    try append_line(out, "  %is_continue = icmp eq i64 %kind, 18");
    try append_line(out, "  br i1 %is_continue, label %parse_continue, label %maybe_expr");
    try append_line(out, "parse_continue:");
    try append_line(out,
        "  %continue_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_continue(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %continue_result");
    try append_line(out, "maybe_expr:");
    try append_line(out, "  %is_ident = icmp eq i64 %kind, 27");
    try append_line(out, "  br i1 %is_ident, label %maybe_assign, label %maybe_try_expr");
    try append_line(out, "maybe_assign:");
    try append_line(out, "  %after_ident = add i64 %index, 1");
    try append_line(out,
        "  %after_ident_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %after_ident)");
    try append_line(out, "  %after_ident_kind = extractvalue %kizu.kizu.lexer.token %after_ident_token, 0");
    try append_line(out, "  %is_assign = icmp eq i64 %after_ident_kind, 37");
    try append_line(out, "  br i1 %is_assign, label %parse_assign, label %parse_expr_stmt");
    try append_line(out, "parse_assign:");
    try append_line(out,
        "  %assign_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_assign(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %assign_result");
    try append_line(out, "maybe_try_expr:");
    try append_line(out, "  %is_try_expr = icmp eq i64 %kind, 22");
    try append_line(out, "  br i1 %is_try_expr, label %parse_expr_stmt, label %fail");
    try append_line(out, "parse_expr_stmt:");
    try append_line(out,
        "  %expr_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr_statement(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %expr_result");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_return_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_return(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %return_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %value_index = add i64 %index, 1");
    try append_line(out,
        "  %first = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  %first_kind = extractvalue %kizu.kizu.lexer.token %first, 0");
    try append_line(out, "  %empty_return = icmp eq i64 %first_kind, 33");
    try append_line(out, "  br i1 %empty_return, label %build_empty, label %parse_value");
    try append_line(out, "build_empty:");
    try append_line(out, "  %return_start = extractvalue %kizu.kizu.lexer.token %return_token, 1");
    try append_line(out, "  %semicolon_end = extractvalue %kizu.kizu.lexer.token %first, 2");
    try append_line(out,
        "  %empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %semicolon_end, i64 %semicolon_end, i64 44)");
    try append_line(out,
        "  %empty_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_return(%kizu.kizu.ast.ast %ast, i64 %return_start, i64 %semicolon_end, %kizu.kizu.ast.node_id %empty)");
    try append_line(out, "  %empty_next = add i64 %value_index, 1");
    try append_line(out,
        "  %empty_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %empty_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %empty_ok0, i64 %empty_next, 1");
    try append_line(out,
        "  %empty_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %empty_ok1, %kizu.kizu.ast.node_id %empty_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %empty_ok2");
    try append_line(out, "parse_value:");
    try append_line(out,
        "  %value_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  %value_ok = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 0");
    try append_line(out, "  br i1 %value_ok, label %check_semicolon, label %fail");
    try append_line(out, "check_semicolon:");
    try append_line(out, "  %value_next = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 1");
    try append_line(out, "  %value_node = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 2");
    try append_line(out,
        "  %semicolon = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %value_next)");
    try append_line(out, "  %semicolon_kind = extractvalue %kizu.kizu.lexer.token %semicolon, 0");
    try append_line(out, "  %semicolon_ok = icmp eq i64 %semicolon_kind, 33");
    try append_line(out, "  br i1 %semicolon_ok, label %build_value, label %fail");
    try append_line(out, "build_value:");
    try append_line(out, "  %value_return_start = extractvalue %kizu.kizu.lexer.token %return_token, 1");
    try append_line(out, "  %value_semicolon_end = extractvalue %kizu.kizu.lexer.token %semicolon, 2");
    try append_line(out,
        "  %node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_return(%kizu.kizu.ast.ast %ast, i64 %value_return_start, i64 %value_semicolon_end, %kizu.kizu.ast.node_id %value_node)");
    try append_line(out, "  %next = add i64 %value_next, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_let_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_let(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %let_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_ok = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_ok, label %check_assign, label %fail");
    try append_line(out, "check_assign:");
    try append_line(out, "  %assign_index = add i64 %index, 2");
    try append_line(out,
        "  %assign_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %assign_index)");
    try append_line(out, "  %assign_kind = extractvalue %kizu.kizu.lexer.token %assign_token, 0");
    try append_line(out, "  %assign_ok = icmp eq i64 %assign_kind, 37");
    try append_line(out, "  br i1 %assign_ok, label %parse_value, label %fail");
    try append_line(out, "parse_value:");
    try append_line(out, "  %value_index = add i64 %index, 3");
    try append_line(out,
