fn append_parse_if_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_if(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %if_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %condition_index = add i64 %index, 1");
    try append_line(out,
        "  %condition_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %condition_index)");
    try append_line(out, "  %condition_ok = extractvalue %kizu.selfhost.cli.parse_node_result %condition_result, 0");
    try append_line(out, "  br i1 %condition_ok, label %parse_body, label %fail");
    try append_line(out, "parse_body:");
    try append_line(out, "  %body_index = extractvalue %kizu.selfhost.cli.parse_node_result %condition_result, 1");
    try append_line(out, "  %condition_node = extractvalue %kizu.selfhost.cli.parse_node_result %condition_result, 2");
    try append_line(out,
        "  %body_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_block(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %body_index)");
    try append_line(out, "  %body_ok = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 0");
    try append_line(out, "  br i1 %body_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %body_next = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 1");
    try append_line(out, "  %body_node = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 2");
    try append_line(out, "  %if_start = extractvalue %kizu.kizu.lexer.token %if_token, 1");
    try append_line(out, "  %body_close_index = sub i64 %body_next, 1");
    try append_line(out,
        "  %body_close = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %body_close_index)");
    try append_line(out, "  %then_end = extractvalue %kizu.kizu.lexer.token %body_close, 2");
    // An 'else' token (kind 14) after the then-block opens an else arm; otherwise the
    // else branch is the Empty leaf (kind 44) and the if ends at the then-block close.
    try append_line(out,
        "  %else_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %body_next)");
    try append_line(out, "  %else_kind = extractvalue %kizu.kizu.lexer.token %else_token, 0");
    try append_line(out, "  %has_else = icmp eq i64 %else_kind, 14");
    try append_line(out, "  br i1 %has_else, label %parse_else, label %no_else");
    try append_line(out, "no_else:");
    try append_line(out,
        "  %else_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %then_end, i64 %then_end, i64 44)");
    try append_line(out,
        "  %if_node_simple = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_if(%kizu.kizu.ast.ast %ast, i64 %if_start, i64 %then_end, %kizu.kizu.ast.node_id %condition_node, %kizu.kizu.ast.node_id %body_node, %kizu.kizu.ast.node_id %else_empty)");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %body_next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %if_node_simple, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "parse_else:");
    try append_line(out, "  %else_body_index = add i64 %body_next, 1");
    try append_line(out,
        "  %else_first = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %else_body_index)");
    try append_line(out, "  %else_first_kind = extractvalue %kizu.kizu.lexer.token %else_first, 0");
    try append_line(out, "  %is_else_if = icmp eq i64 %else_first_kind, 13");
    try append_line(out, "  br i1 %is_else_if, label %else_if, label %else_block");
    try append_line(out, "else_if:");
    try append_line(out,
        "  %elif = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_if(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %else_body_index)");
    try append_line(out, "  %elif_ok = extractvalue %kizu.selfhost.cli.parse_node_result %elif, 0");
    try append_line(out, "  br i1 %elif_ok, label %finalize_elif, label %fail");
    try append_line(out, "finalize_elif:");
    try append_line(out, "  %elif_next = extractvalue %kizu.selfhost.cli.parse_node_result %elif, 1");
    try append_line(out, "  %elif_node = extractvalue %kizu.selfhost.cli.parse_node_result %elif, 2");
    try append_line(out, "  br label %finalize_else");
    try append_line(out, "else_block:");
    try append_line(out,
        "  %elseb = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_block(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %else_body_index)");
    try append_line(out, "  %elseb_ok = extractvalue %kizu.selfhost.cli.parse_node_result %elseb, 0");
    try append_line(out, "  br i1 %elseb_ok, label %finalize_elseb, label %fail");
    try append_line(out, "finalize_elseb:");
    try append_line(out, "  %elseb_next = extractvalue %kizu.selfhost.cli.parse_node_result %elseb, 1");
    try append_line(out, "  %elseb_node = extractvalue %kizu.selfhost.cli.parse_node_result %elseb, 2");
    try append_line(out, "  br label %finalize_else");
    try append_line(out, "finalize_else:");
    try append_line(out,
        "  %else_node = phi %kizu.kizu.ast.node_id [ %elif_node, %finalize_elif ], [ %elseb_node, %finalize_elseb ]");
    try append_line(out, "  %else_next = phi i64 [ %elif_next, %finalize_elif ], [ %elseb_next, %finalize_elseb ]");
    try append_line(out, "  %else_close_index = sub i64 %else_next, 1");
    try append_line(out,
        "  %else_close = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %else_close_index)");
    try append_line(out, "  %else_end = extractvalue %kizu.kizu.lexer.token %else_close, 2");
    try append_line(out,
        "  %if_node_else = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_if(%kizu.kizu.ast.ast %ast, i64 %if_start, i64 %else_end, %kizu.kizu.ast.node_id %condition_node, %kizu.kizu.ast.node_id %body_node, %kizu.kizu.ast.node_id %else_node)");
    try append_line(out,
        "  %eok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %eok1 = insertvalue %kizu.selfhost.cli.parse_node_result %eok0, i64 %else_next, 1");
    try append_line(out,
        "  %eok2 = insertvalue %kizu.selfhost.cli.parse_node_result %eok1, %kizu.kizu.ast.node_id %if_node_else, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %eok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

