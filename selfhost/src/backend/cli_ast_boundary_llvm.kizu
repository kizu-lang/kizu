    try append_line(out, "  %ret_kind = extractvalue %kizu.kizu.lexer.token %ret_token, 0");
    try append_line(out, "  %ret_is_bang = icmp eq i64 %ret_kind, 40");
    try append_line(out, "  br i1 %ret_is_bang, label %ret_after_bang, label %ret_direct");
