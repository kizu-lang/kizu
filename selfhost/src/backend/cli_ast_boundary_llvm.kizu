fn append_ast_new_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %nodes = call %kizu.owned @kizu_rt_array_new(%kizu.owned %allocator, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.ast_node, ptr null, i32 1) to i64))");
    try append_line(out,
        "  %children = call %kizu.owned @kizu_rt_array_new(%kizu.owned %allocator, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.node_id, ptr null, i32 1) to i64))");
    try append_line(out,
        "  %file0 = insertvalue %kizu.kizu.ast.source_file poison, %kizu.slice.u8 %path, 0");
    try append_line(out,
        "  %file = insertvalue %kizu.kizu.ast.source_file %file0, %kizu.slice.u8 %source, 1");
    try append_line(out, "  %ast0 = insertvalue %kizu.kizu.ast.ast poison, %kizu.owned %nodes, 0");
    try append_line(out, "  %ast1 = insertvalue %kizu.kizu.ast.ast %ast0, %kizu.owned %children, 1");
    try append_line(out,
        "  %ast = insertvalue %kizu.kizu.ast.ast %ast1, %kizu.kizu.ast.source_file %file, 2");
    try append_line(out, "  ret %kizu.kizu.ast.ast %ast");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_ast_child_len_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_ast_child_len(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %children = extractvalue %kizu.kizu.ast.ast %ast, 1");
    try append_line(out, "  %len = call i64 @kizu_rt_array_len(%kizu.owned %children)");
    try append_line(out, "  ret i64 %len");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_ast_append_child_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__cli_ast_append_child(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %child");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.node_id, align 8");
    try append_line(out, "  store %kizu.kizu.ast.node_id %child, ptr %slot, align 8");
    try append_line(out, "  %slice0 = insertvalue %kizu.slice.u8 poison, ptr %slot, 0");
    try append_line(out,
        "  %slice = insertvalue %kizu.slice.u8 %slice0, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.node_id, ptr null, i32 1) to i64), 1");
    try append_line(out, "  %children = extractvalue %kizu.kizu.ast.ast %ast, 1");
    try append_line(out,
        "  %result = call %kizu.error.void @kizu_rt_array_append(%kizu.owned %children, %kizu.slice.u8 %slice)");
    try append_line(out, "  ret %kizu.error.void %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_token_at_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %view = call %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %ok = extractvalue %kizu.error.slice.u8 %view, 0");
    try append_line(out, "  br i1 %ok, label %load, label %fallback");
    try append_line(out, "load:");
    try append_line(out, "  %slice = extractvalue %kizu.error.slice.u8 %view, 1");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %slice, 0");
    try append_line(out, "  %token = load %kizu.kizu.lexer.token, ptr %ptr, align 8");
    try append_line(out, "  ret %kizu.kizu.lexer.token %token");
    try append_line(out, "fallback:");
    try append_line(out,
        "  %eof = insertvalue %kizu.kizu.lexer.token zeroinitializer, i64 61, 0");
    try append_line(out, "  ret %kizu.kizu.lexer.token %eof");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_token_text_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_text_equal(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.lexer.token %token,");
    try append_line(out, "  %kizu.slice.u8 %expected");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %slice0 = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %slice0, i64 %len, 1");
    try append_line(out,
        "  %same = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %slice, %kizu.slice.u8 %expected)");
    try append_line(out, "  ret i1 %same");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_unsupported_parse_result_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.parse_result @kizu_selfhost__cli_unsupported_parse_result(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %ast = call %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out,
        "  %root = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 0, i64 0, i64 44)");
    try append_line(out,
        "  %parsed = call %kizu.kizu.ast.parse_result @kizu_kizu__ast_parse_result(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %root)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %parsed");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_validated_ast_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.parse_result @kizu_selfhost__cli_parse_validated_ast(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %decl_slots = alloca [16 x %kizu.kizu.ast.node_id], align 8");
    try append_line(out,
        "  %tokens_result = call %kizu.error.owned @kizu_kizu__lexer_tokenize(%kizu.owned %allocator, %kizu.slice.u8 %source)");
    try append_line(out, "  %tokens_ok = extractvalue %kizu.error.owned %tokens_result, 0");
    try append_line(out, "  br i1 %tokens_ok, label %parse, label %unsupported");
    try append_line(out, "parse:");
    try append_line(out, "  %tokens = extractvalue %kizu.error.owned %tokens_result, 1");
    try append_line(out,
        "  %ast = call %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out, "  br label %parse_loop");
    try append_line(out, "parse_loop:");
    try append_line(out, "  %index = phi i64 [ 0, %parse ], [ %decl_next, %store_decl ]");
    try append_line(out, "  %decl_count = phi i64 [ 0, %parse ], [ %decl_count_next, %store_decl ]");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_eof = icmp eq i64 %kind, 62");
    try append_line(out, "  br i1 %is_eof, label %finish, label %parse_decl");
    try append_line(out, "parse_decl:");
    try append_line(out,
        "  %decl = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %decl_ok = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 0");
    try append_line(out, "  br i1 %decl_ok, label %decl_ok_block, label %unsupported");
    try append_line(out, "decl_ok_block:");
    try append_line(out, "  %decl_next = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 1");
    try append_line(out, "  %decl_node = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 2");
    try append_line(out, "  %advanced = icmp sgt i64 %decl_next, %index");
    try append_line(out, "  %has_capacity = icmp slt i64 %decl_count, 16");
    try append_line(out, "  %can_store = and i1 %advanced, %has_capacity");
    try append_line(out, "  br i1 %can_store, label %store_decl, label %unsupported");
    try append_line(out, "store_decl:");
    try append_line(out,
        "  %decl_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %decl_slots, i64 0, i64 %decl_count");
    try append_line(out, "  store %kizu.kizu.ast.node_id %decl_node, ptr %decl_slot, align 8");
    try append_line(out, "  %decl_count_next = add i64 %decl_count, 1");
    try append_line(out, "  br label %parse_loop");
    try append_line(out, "finish:");
    try append_line(out, "  %decl_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  br label %append_decls");
    try append_line(out, "append_decls:");
    try append_line(out, "  %append_index = phi i64 [ 0, %finish ], [ %append_next, %append_ok ]");
    try append_line(out, "  %append_done = icmp eq i64 %append_index, %decl_count");
    try append_line(out, "  br i1 %append_done, label %build_program, label %append_decl");
    try append_line(out, "append_decl:");
    try append_line(out,
        "  %append_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %decl_slots, i64 0, i64 %append_index");
    try append_line(out, "  %append_node = load %kizu.kizu.ast.node_id, ptr %append_slot, align 8");
    try append_line(out,
        "  %append_result = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %append_node)");
    try append_line(out, "  %append_result_ok = extractvalue %kizu.error.void %append_result, 0");
    try append_line(out, "  br i1 %append_result_ok, label %append_ok, label %unsupported");
    try append_line(out, "append_ok:");
    try append_line(out, "  %append_next = add i64 %append_index, 1");
    try append_line(out, "  br label %append_decls");
    try append_line(out, "build_program:");
    try append_line(out, "  %eof_end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %program = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_program(%kizu.kizu.ast.ast %ast, i64 0, i64 %eof_end, i64 %decl_start, i64 %decl_count)");
    try append_line(out,
        "  %parsed = call %kizu.kizu.ast.parse_result @kizu_kizu__ast_parse_result(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %program)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %parsed");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.kizu.ast.parse_result @kizu_selfhost__cli_unsupported_parse_result(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_fn = icmp eq i64 %kind, 0");
    try append_line(out, "  br i1 %is_fn, label %parse_fn, label %maybe_struct");
    try append_line(out, "parse_fn:");
    try append_line(out,
        "  %fn_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_fn_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %fn_result");
    try append_line(out, "maybe_struct:");
    try append_line(out, "  %is_struct = icmp eq i64 %kind, 3");
    try append_line(out, "  br i1 %is_struct, label %parse_struct, label %maybe_enum");
    try append_line(out, "parse_struct:");
    try append_line(out,
        "  %struct_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_struct_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %struct_result");
    try append_line(out, "maybe_enum:");
    try append_line(out, "  %is_enum = icmp eq i64 %kind, 4");
    try append_line(out, "  br i1 %is_enum, label %parse_enum, label %maybe_union");
    try append_line(out, "parse_enum:");
    try append_line(out,
        "  %enum_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_enum_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %enum_result");
    try append_line(out, "maybe_union:");
    try append_line(out, "  %is_union = icmp eq i64 %kind, 5");
    try append_line(out, "  br i1 %is_union, label %parse_union, label %maybe_test");
    try append_line(out, "parse_union:");
    try append_line(out,
        "  %union_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_union_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %union_result");
    try append_line(out, "maybe_test:");
    try append_line(out, "  %is_ident = icmp eq i64 %kind, 27");
    try append_line(out, "  br i1 %is_ident, label %check_test, label %fail");
    try append_line(out, "check_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.ast_test_keyword, i64 0, i64 0");
    try append_line(out, "  %test0 = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test0, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__cli_token_text_equal(%kizu.slice.u8 %source, %kizu.kizu.lexer.token %token, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %parse_test, label %check_impl");
    try append_line(out, "parse_test:");
    try append_line(out,
        "  %test_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_test_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %test_result");
    try append_line(out, "check_impl:");
    try append_line(out,
        "  %impl_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.ast_impl_keyword, i64 0, i64 0");
    try append_line(out, "  %impl0 = insertvalue %kizu.slice.u8 poison, ptr %impl_ptr, 0");
    try append_line(out, "  %impl_slice = insertvalue %kizu.slice.u8 %impl0, i64 4, 1");
    try append_line(out,
        "  %is_impl = call i1 @kizu_selfhost__cli_token_text_equal(%kizu.slice.u8 %source, %kizu.kizu.lexer.token %token, %kizu.slice.u8 %impl_slice)");
    try append_line(out, "  br i1 %is_impl, label %parse_impl, label %fail");
    try append_line(out, "parse_impl:");
    try append_line(out,
        "  %impl_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_impl_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %impl_result");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

// cli_parse_struct_decl parses 'struct Name { ... }' by scanning the flat field
// body to its closing brace (struct fields carry no nested braces) and builds a
// StructDecl node with empty type-param/field ranges: the run tape ignores the
// declaration (struct literals carry their own field names and the checked AST
// already validated them), so the boundary records only the name and span.
// cli_parse_match parses a statement-position 'match <ident> { arm, ... }' with
// one, two, or three arms (the same bounded SSA buffering the call-argument and
// struct-literal parsers use; wider matches stay with the real parser until
// issue 1157 replaces this boundary). Each arm parses through
// cli_parse_match_arm, which creates its MatchArm node without touching the
// child array, so the arm children append together at the end and the match
// node's arm range stays contiguous even though arm bodies append their own
// call-argument children while parsing.
fn append_parse_match_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_match(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %match_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %match_start = extractvalue %kizu.kizu.lexer.token %match_token, 1");
    try append_line(out, "  %value_index = add i64 %index, 1");
    try append_line(out,
        "  %value_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  %value_kind = extractvalue %kizu.kizu.lexer.token %value_token, 0");
    try append_line(out, "  %value_ok = icmp eq i64 %value_kind, 27");
    try append_line(out, "  br i1 %value_ok, label %check_brace, label %fail");
    try append_line(out, "check_brace:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 29");
    try append_line(out, "  br i1 %open_ok, label %arm1, label %fail");
    try append_line(out, "arm1:");
    try append_line(out, "  %value_start = extractvalue %kizu.kizu.lexer.token %value_token, 1");
    try append_line(out, "  %value_end = extractvalue %kizu.kizu.lexer.token %value_token, 2");
    try append_line(out,
        "  %value_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %value_start, i64 %value_end, i64 4)");
    try append_line(out, "  %a1_index = add i64 %index, 3");
    try append_line(out,
        "  %a1 = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_match_arm(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %a1_index)");
    try append_line(out, "  %a1_ok = extractvalue %kizu.selfhost.cli.parse_node_result %a1, 0");
    try append_line(out, "  br i1 %a1_ok, label %a1_sep, label %fail");
    try append_line(out, "a1_sep:");
    try append_line(out, "  %a1_next = extractvalue %kizu.selfhost.cli.parse_node_result %a1, 1");
    try append_line(out, "  %a1_node = extractvalue %kizu.selfhost.cli.parse_node_result %a1, 2");
    try append_line(out,
        "  %a1_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %a1_next)");
    try append_line(out, "  %a1_sep_kind = extractvalue %kizu.kizu.lexer.token %a1_sep_token, 0");
    try append_line(out, "  %a1_has_comma = icmp eq i64 %a1_sep_kind, 34");
    try append_line(out, "  br i1 %a1_has_comma, label %a1_comma, label %fail");
    try append_line(out, "a1_comma:");
    try append_line(out, "  %after_a1 = add i64 %a1_next, 1");
    try append_line(out,
        "  %after_a1_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %after_a1)");
    try append_line(out, "  %after_a1_kind = extractvalue %kizu.kizu.lexer.token %after_a1_token, 0");
    try append_line(out, "  %a1_close = icmp eq i64 %after_a1_kind, 30");
    try append_line(out, "  br i1 %a1_close, label %emit_one, label %arm2");
    try append_line(out, "arm2:");
    try append_line(out,
        "  %a2 = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_match_arm(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %after_a1)");
    try append_line(out, "  %a2_ok = extractvalue %kizu.selfhost.cli.parse_node_result %a2, 0");
    try append_line(out, "  br i1 %a2_ok, label %a2_sep, label %fail");
    try append_line(out, "a2_sep:");
    try append_line(out, "  %a2_next = extractvalue %kizu.selfhost.cli.parse_node_result %a2, 1");
    try append_line(out, "  %a2_node = extractvalue %kizu.selfhost.cli.parse_node_result %a2, 2");
    try append_line(out,
        "  %a2_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %a2_next)");
    try append_line(out, "  %a2_sep_kind = extractvalue %kizu.kizu.lexer.token %a2_sep_token, 0");
    try append_line(out, "  %a2_has_comma = icmp eq i64 %a2_sep_kind, 34");
    try append_line(out, "  br i1 %a2_has_comma, label %a2_comma, label %fail");
    try append_line(out, "a2_comma:");
    try append_line(out, "  %after_a2 = add i64 %a2_next, 1");
    try append_line(out,
        "  %after_a2_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %after_a2)");
    try append_line(out, "  %after_a2_kind = extractvalue %kizu.kizu.lexer.token %after_a2_token, 0");
    try append_line(out, "  %a2_close = icmp eq i64 %after_a2_kind, 30");
    try append_line(out, "  br i1 %a2_close, label %emit_two, label %arm3");
    try append_line(out, "arm3:");
    try append_line(out,
        "  %a3 = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_match_arm(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %after_a2)");
    try append_line(out, "  %a3_ok = extractvalue %kizu.selfhost.cli.parse_node_result %a3, 0");
    try append_line(out, "  br i1 %a3_ok, label %a3_sep, label %fail");
    try append_line(out, "a3_sep:");
    try append_line(out, "  %a3_next = extractvalue %kizu.selfhost.cli.parse_node_result %a3, 1");
    try append_line(out, "  %a3_node = extractvalue %kizu.selfhost.cli.parse_node_result %a3, 2");
    try append_line(out,
        "  %a3_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %a3_next)");
    try append_line(out, "  %a3_sep_kind = extractvalue %kizu.kizu.lexer.token %a3_sep_token, 0");
    try append_line(out, "  %a3_has_comma = icmp eq i64 %a3_sep_kind, 34");
    try append_line(out, "  br i1 %a3_has_comma, label %a3_comma, label %fail");
    try append_line(out, "a3_comma:");
    try append_line(out, "  %after_a3 = add i64 %a3_next, 1");
    try append_line(out,
        "  %after_a3_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %after_a3)");
    try append_line(out, "  %after_a3_kind = extractvalue %kizu.kizu.lexer.token %after_a3_token, 0");
    try append_line(out, "  %a3_close = icmp eq i64 %after_a3_kind, 30");
    try append_line(out, "  br i1 %a3_close, label %emit_three, label %fail");
    try append_line(out, "emit_one:");
    try append_line(out, "  %one_close_end = extractvalue %kizu.kizu.lexer.token %after_a1_token, 2");
    try append_line(out, "  %one_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out,
        "  %one_append = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %a1_node)");
    try append_line(out, "  %one_append_ok = extractvalue %kizu.error.void %one_append, 0");
    try append_line(out, "  br i1 %one_append_ok, label %emit_one_node, label %fail");
    try append_line(out, "emit_one_node:");
    try append_line(out,
        "  %one_match = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_match(%kizu.kizu.ast.ast %ast, i64 %match_start, i64 %one_close_end, %kizu.kizu.ast.node_id %value_node, i64 %one_child_start, i64 1)");
    try append_line(out, "  %one_next = add i64 %after_a1, 1");
    try append_line(out, "  %one_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %one_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %one_ok0, i64 %one_next, 1");
    try append_line(out,
        "  %one_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %one_ok1, %kizu.kizu.ast.node_id %one_match, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %one_ok2");
    try append_line(out, "emit_two:");
    try append_line(out, "  %two_close_end = extractvalue %kizu.kizu.lexer.token %after_a2_token, 2");
    try append_line(out, "  %two_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out,
        "  %two_append1 = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %a1_node)");
    try append_line(out, "  %two_append1_ok = extractvalue %kizu.error.void %two_append1, 0");
    try append_line(out, "  br i1 %two_append1_ok, label %emit_two_second, label %fail");
    try append_line(out, "emit_two_second:");
    try append_line(out,
        "  %two_append2 = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %a2_node)");
    try append_line(out, "  %two_append2_ok = extractvalue %kizu.error.void %two_append2, 0");
    try append_line(out, "  br i1 %two_append2_ok, label %emit_two_node, label %fail");
    try append_line(out, "emit_two_node:");
    try append_line(out,
        "  %two_match = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_match(%kizu.kizu.ast.ast %ast, i64 %match_start, i64 %two_close_end, %kizu.kizu.ast.node_id %value_node, i64 %two_child_start, i64 2)");
    try append_line(out, "  %two_next = add i64 %after_a2, 1");
    try append_line(out, "  %two_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %two_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %two_ok0, i64 %two_next, 1");
    try append_line(out,
        "  %two_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %two_ok1, %kizu.kizu.ast.node_id %two_match, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %two_ok2");
    try append_line(out, "emit_three:");
    try append_line(out, "  %three_close_end = extractvalue %kizu.kizu.lexer.token %after_a3_token, 2");
    try append_line(out, "  %three_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out,
        "  %three_append1 = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %a1_node)");
    try append_line(out, "  %three_append1_ok = extractvalue %kizu.error.void %three_append1, 0");
    try append_line(out, "  br i1 %three_append1_ok, label %emit_three_second, label %fail");
    try append_line(out, "emit_three_second:");
    try append_line(out,
        "  %three_append2 = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %a2_node)");
    try append_line(out, "  %three_append2_ok = extractvalue %kizu.error.void %three_append2, 0");
    try append_line(out, "  br i1 %three_append2_ok, label %emit_three_third, label %fail");
    try append_line(out, "emit_three_third:");
    try append_line(out,
        "  %three_append3 = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %a3_node)");
    try append_line(out, "  %three_append3_ok = extractvalue %kizu.error.void %three_append3, 0");
    try append_line(out, "  br i1 %three_append3_ok, label %emit_three_node, label %fail");
    try append_line(out, "emit_three_node:");
    try append_line(out,
        "  %three_match = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_match(%kizu.kizu.ast.ast %ast, i64 %match_start, i64 %three_close_end, %kizu.kizu.ast.node_id %value_node, i64 %three_child_start, i64 3)");
    try append_line(out, "  %three_next = add i64 %after_a3, 1");
    try append_line(out, "  %three_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %three_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %three_ok0, i64 %three_next, 1");
    try append_line(out,
        "  %three_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %three_ok1, %kizu.kizu.ast.node_id %three_match, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %three_ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

// cli_parse_match_arm parses one '<pattern>[(<binding>)] => <expr>' arm: the
// pattern is one ident token ('_' included), an optional '(<ident>)' names the
// payload binding, the body parses as a general expression, and the MatchArm
// node is created without touching the child array so the caller appends the
// arm children contiguously at the end.
fn append_parse_match_arm_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_match_arm(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %p_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %p_kind = extractvalue %kizu.kizu.lexer.token %p_token, 0");
    try append_line(out, "  %p_ok = icmp eq i64 %p_kind, 27");
    try append_line(out, "  br i1 %p_ok, label %check_payload, label %fail");
    try append_line(out, "check_payload:");
    try append_line(out, "  %pp_index = add i64 %index, 1");
    try append_line(out,
        "  %pp_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %pp_index)");
    try append_line(out, "  %pp_kind = extractvalue %kizu.kizu.lexer.token %pp_token, 0");
    try append_line(out, "  %pp_has_binding = icmp eq i64 %pp_kind, 31");
    try append_line(out, "  br i1 %pp_has_binding, label %payload_binding, label %no_binding");
    try append_line(out, "payload_binding:");
    try append_line(out, "  %pb_index = add i64 %index, 2");
    try append_line(out,
        "  %pb_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %pb_index)");
    try append_line(out, "  %pb_kind = extractvalue %kizu.kizu.lexer.token %pb_token, 0");
    try append_line(out, "  %pb_ok = icmp eq i64 %pb_kind, 27");
    try append_line(out, "  br i1 %pb_ok, label %payload_close, label %fail");
    try append_line(out, "payload_close:");
    try append_line(out, "  %pc_index = add i64 %index, 3");
    try append_line(out,
        "  %pc_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %pc_index)");
    try append_line(out, "  %pc_kind = extractvalue %kizu.kizu.lexer.token %pc_token, 0");
    try append_line(out, "  %pc_ok = icmp eq i64 %pc_kind, 32");
    try append_line(out, "  br i1 %pc_ok, label %arrow_payload, label %fail");
    try append_line(out, "arrow_payload:");
    try append_line(out, "  %arrow_index_p = add i64 %index, 4");
    try append_line(out, "  br label %check_arrow");
    try append_line(out, "no_binding:");
    try append_line(out, "  %arrow_index_n = add i64 %index, 1");
    try append_line(out, "  br label %check_arrow");
    try append_line(out, "check_arrow:");
    try append_line(out, "  %arrow_index = phi i64 [ %arrow_index_p, %arrow_payload ], [ %arrow_index_n, %no_binding ]");
    try append_line(out, "  %has_binding = phi i1 [ true, %arrow_payload ], [ false, %no_binding ]");
    try append_line(out,
        "  %arrow_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %arrow_index)");
    try append_line(out, "  %arrow_kind = extractvalue %kizu.kizu.lexer.token %arrow_token, 0");
    try append_line(out, "  %arrow_ok = icmp eq i64 %arrow_kind, 39");
    try append_line(out, "  br i1 %arrow_ok, label %body, label %fail");
    try append_line(out, "body:");
    try append_line(out, "  %body_index = add i64 %arrow_index, 1");
    try append_line(out,
        "  %body_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %body_index)");
    try append_line(out, "  %body_ok = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 0");
    try append_line(out, "  br i1 %body_ok, label %binding_pick, label %fail");
    try append_line(out, "binding_pick:");
    try append_line(out, "  %p_end_pre = extractvalue %kizu.kizu.lexer.token %p_token, 2");
    try append_line(out, "  br i1 %has_binding, label %bind_yes, label %bind_no");
    try append_line(out, "bind_yes:");
    try append_line(out, "  %pb_start = extractvalue %kizu.kizu.lexer.token %pb_token, 1");
    try append_line(out, "  %pb_end = extractvalue %kizu.kizu.lexer.token %pb_token, 2");
    try append_line(out,
        "  %b_node_y = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %pb_start, i64 %pb_end, i64 4)");
    try append_line(out, "  br label %build");
    try append_line(out, "bind_no:");
    try append_line(out,
        "  %b_node_n = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %p_end_pre, i64 %p_end_pre, i64 44)");
    try append_line(out, "  br label %build");
    try append_line(out, "build:");
    try append_line(out, "  %b_node = phi %kizu.kizu.ast.node_id [ %b_node_y, %bind_yes ], [ %b_node_n, %bind_no ]");
    try append_line(out, "  %body_next = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 1");
    try append_line(out, "  %body_node = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 2");
    try append_line(out, "  %p_start = extractvalue %kizu.kizu.lexer.token %p_token, 1");
    try append_line(out, "  %p_end = extractvalue %kizu.kizu.lexer.token %p_token, 2");
    try append_line(out,
        "  %p_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %p_start, i64 %p_end, i64 4)");
    try append_line(out,
        "  %arm_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_match_arm(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %p_node, %kizu.kizu.ast.node_id %b_node, %kizu.kizu.ast.node_id %body_node)");
    try append_line(out, "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %body_next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %arm_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

// cli_parse_union_decl parses 'union Name { Variant, Variant(<type>), ... }':
// every variant appends one UnionVariant child (name leaf plus a payload
// TypeName leaf spanning the tokens inside the parens, or an Empty leaf), kept
// contiguous because a union body carries no nested parses. The payload scan
// stops at the first ')' (a nested-paren payload type is outside this
// boundary, owned by issue 1157 like its other bounds); the run tape's union
// layout pass classifies the payload leaf text for the runtime union ABI.
fn append_parse_union_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_union_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %union_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %union_start = extractvalue %kizu.kizu.lexer.token %union_token, 1");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_ok = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_ok, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 29");
    try append_line(out, "  br i1 %open_ok, label %variants, label %fail");
    try append_line(out, "variants:");
    try append_line(out, "  %v_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  %first_variant_index = add i64 %index, 3");
    try append_line(out, "  br label %uv_loop");
    try append_line(out, "uv_loop:");
    try append_line(out, "  %u_cursor = phi i64 [ %first_variant_index, %variants ], [ %u_after_comma, %uv_sep_comma ]");
    try append_line(out, "  %u_count = phi i64 [ 0, %variants ], [ %u_count_next, %uv_sep_comma ]");
    try append_line(out,
        "  %u_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %u_cursor)");
    try append_line(out, "  %u_kind = extractvalue %kizu.kizu.lexer.token %u_token, 0");
    try append_line(out, "  %u_is_close = icmp eq i64 %u_kind, 30");
    try append_line(out, "  br i1 %u_is_close, label %uv_done_head, label %uv_name");
    try append_line(out, "uv_name:");
    try append_line(out, "  %u_name_ok = icmp eq i64 %u_kind, 27");
    try append_line(out, "  br i1 %u_name_ok, label %uv_paren_check, label %fail");
    try append_line(out, "uv_paren_check:");
    try append_line(out, "  %u_paren_index = add i64 %u_cursor, 1");
    try append_line(out,
        "  %u_paren_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %u_paren_index)");
    try append_line(out, "  %u_paren_kind = extractvalue %kizu.kizu.lexer.token %u_paren_token, 0");
    try append_line(out, "  %u_has_payload = icmp eq i64 %u_paren_kind, 31");
    try append_line(out, "  br i1 %u_has_payload, label %uv_scan, label %uv_no_payload");
    try append_line(out, "uv_scan:");
    try append_line(out, "  %s_first = add i64 %u_cursor, 2");
    try append_line(out,
        "  %s_first_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %s_first)");
    try append_line(out, "  %s_content_start = extractvalue %kizu.kizu.lexer.token %s_first_token, 1");
    try append_line(out, "  br label %uv_scan_loop");
    try append_line(out, "uv_scan_loop:");
    try append_line(out, "  %s_cursor = phi i64 [ %s_first, %uv_scan ], [ %s_next, %uv_scan_step ]");
    try append_line(out,
        "  %s_prev_end = phi i64 [ %s_content_start, %uv_scan ], [ %s_cur_end, %uv_scan_step ]");
    try append_line(out,
        "  %s_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %s_cursor)");
    try append_line(out, "  %s_kind = extractvalue %kizu.kizu.lexer.token %s_token, 0");
    try append_line(out, "  %s_is_close = icmp eq i64 %s_kind, 32");
    try append_line(out, "  br i1 %s_is_close, label %uv_payload_build, label %uv_scan_guard");
    try append_line(out, "uv_scan_guard:");
    try append_line(out, "  %s_is_eof = icmp eq i64 %s_kind, 62");
    try append_line(out, "  br i1 %s_is_eof, label %fail, label %uv_scan_step");
    try append_line(out, "uv_scan_step:");
    try append_line(out, "  %s_next = add i64 %s_cursor, 1");
    try append_line(out, "  %s_cur_end = extractvalue %kizu.kizu.lexer.token %s_token, 2");
    try append_line(out, "  br label %uv_scan_loop");
    // The payload TypeName leaf spans the tokens inside the parens (the real
    // parser's shape), so the codegen layout pass classifies 'i64'/'[]u8'
    // payload text without seeing the grouping parens.
    try append_line(out, "uv_payload_build:");
    try append_line(out,
        "  %pl_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %s_content_start, i64 %s_prev_end, i64 3)");
    try append_line(out, "  %u_sep_payload = add i64 %s_cursor, 1");
    try append_line(out, "  br label %uv_build");
    try append_line(out, "uv_no_payload:");
    try append_line(out, "  %np_name_end = extractvalue %kizu.kizu.lexer.token %u_token, 2");
    try append_line(out,
        "  %np_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %np_name_end, i64 %np_name_end, i64 44)");
    try append_line(out, "  %u_sep_np = add i64 %u_cursor, 1");
    try append_line(out, "  br label %uv_build");
    try append_line(out, "uv_build:");
    try append_line(out,
        "  %u_payload = phi %kizu.kizu.ast.node_id [ %pl_node, %uv_payload_build ], [ %np_node, %uv_no_payload ]");
    try append_line(out, "  %u_sep_index = phi i64 [ %u_sep_payload, %uv_payload_build ], [ %u_sep_np, %uv_no_payload ]");
    try append_line(out, "  %u_name_start = extractvalue %kizu.kizu.lexer.token %u_token, 1");
    try append_line(out, "  %u_name_end = extractvalue %kizu.kizu.lexer.token %u_token, 2");
    try append_line(out,
        "  %u_name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %u_name_start, i64 %u_name_end, i64 4)");
    try append_line(out,
        "  %u_variant = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_union_variant(%kizu.kizu.ast.ast %ast, i64 %u_name_start, i64 %u_name_end, %kizu.kizu.ast.node_id %u_name_node, %kizu.kizu.ast.node_id %u_payload)");
    try append_line(out,
        "  %u_append = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %u_variant)");
    try append_line(out, "  %u_append_ok = extractvalue %kizu.error.void %u_append, 0");
    try append_line(out, "  br i1 %u_append_ok, label %uv_sep, label %fail");
    try append_line(out, "uv_sep:");
    try append_line(out, "  %u_count_next = add i64 %u_count, 1");
    try append_line(out,
        "  %u_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %u_sep_index)");
    try append_line(out, "  %u_sep_kind = extractvalue %kizu.kizu.lexer.token %u_sep_token, 0");
    try append_line(out, "  %u_is_comma = icmp eq i64 %u_sep_kind, 34");
    try append_line(out, "  br i1 %u_is_comma, label %uv_sep_comma, label %uv_sep_close");
    try append_line(out, "uv_sep_comma:");
    try append_line(out, "  %u_after_comma = add i64 %u_sep_index, 1");
    try append_line(out, "  br label %uv_loop");
    try append_line(out, "uv_sep_close:");
    try append_line(out, "  %u_sep_is_close = icmp eq i64 %u_sep_kind, 30");
    try append_line(out, "  br i1 %u_sep_is_close, label %uv_done_sep, label %fail");
    try append_line(out, "uv_done_head:");
    try append_line(out, "  br label %uv_done");
    try append_line(out, "uv_done_sep:");
    try append_line(out, "  br label %uv_done");
    try append_line(out, "uv_done:");
    try append_line(out, "  %u_close_index = phi i64 [ %u_cursor, %uv_done_head ], [ %u_sep_index, %uv_done_sep ]");
    try append_line(out, "  %u_variant_len = phi i64 [ %u_count, %uv_done_head ], [ %u_count_next, %uv_done_sep ]");
    try append_line(out,
        "  %u_close_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %u_close_index)");
    try append_line(out, "  %u_close_end = extractvalue %kizu.kizu.lexer.token %u_close_token, 2");
    try append_line(out, "  %d_name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
    try append_line(out, "  %d_name_end = extractvalue %kizu.kizu.lexer.token %name_token, 2");
    try append_line(out,
        "  %d_name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %d_name_start, i64 %d_name_end, i64 4)");
    try append_line(out,
        "  %decl_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_union_decl(%kizu.kizu.ast.ast %ast, i64 %union_start, i64 %u_close_end, %kizu.kizu.ast.node_id %d_name_node, i64 %v_child_start, i64 %u_variant_len)");
    try append_line(out, "  %next = add i64 %u_close_index, 1");
    try append_line(out, "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %decl_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

// cli_parse_enum_decl parses 'enum Name { Variant, ... }': every variant ident
// appends one name leaf as a contiguous child (an enum body carries no nested
// parses), so the EnumDecl node's tag range lets the run tape resolve
// 'Enum::Variant' constants and match arm patterns by declaration order.
fn append_parse_enum_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_enum_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %enum_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %enum_start = extractvalue %kizu.kizu.lexer.token %enum_token, 1");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_ok = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_ok, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 29");
    try append_line(out, "  br i1 %open_ok, label %tags, label %fail");
    try append_line(out, "tags:");
    try append_line(out, "  %tags_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  %first_tag_index = add i64 %index, 3");
    try append_line(out, "  br label %tag_loop");
    try append_line(out, "tag_loop:");
    try append_line(out, "  %t_cursor = phi i64 [ %first_tag_index, %tags ], [ %t_after_comma, %tag_sep_comma ]");
    try append_line(out, "  %t_count = phi i64 [ 0, %tags ], [ %t_count_next, %tag_sep_comma ]");
    try append_line(out,
        "  %t_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %t_cursor)");
    try append_line(out, "  %t_kind = extractvalue %kizu.kizu.lexer.token %t_token, 0");
    try append_line(out, "  %t_is_close = icmp eq i64 %t_kind, 30");
    try append_line(out, "  br i1 %t_is_close, label %tags_done_head, label %tag_name");
    try append_line(out, "tag_name:");
    try append_line(out, "  %t_name_ok = icmp eq i64 %t_kind, 27");
    try append_line(out, "  br i1 %t_name_ok, label %tag_build, label %fail");
    try append_line(out, "tag_build:");
    try append_line(out, "  %t_start = extractvalue %kizu.kizu.lexer.token %t_token, 1");
    try append_line(out, "  %t_end = extractvalue %kizu.kizu.lexer.token %t_token, 2");
    try append_line(out,
        "  %t_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %t_start, i64 %t_end, i64 4)");
    try append_line(out,
        "  %t_append = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %t_node)");
    try append_line(out, "  %t_append_ok = extractvalue %kizu.error.void %t_append, 0");
    try append_line(out, "  br i1 %t_append_ok, label %tag_sep, label %fail");
    try append_line(out, "tag_sep:");
    try append_line(out, "  %t_count_next = add i64 %t_count, 1");
    try append_line(out, "  %t_sep_index = add i64 %t_cursor, 1");
    try append_line(out,
        "  %t_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %t_sep_index)");
    try append_line(out, "  %t_sep_kind = extractvalue %kizu.kizu.lexer.token %t_sep_token, 0");
    try append_line(out, "  %t_is_comma = icmp eq i64 %t_sep_kind, 34");
    try append_line(out, "  br i1 %t_is_comma, label %tag_sep_comma, label %tag_sep_close");
    try append_line(out, "tag_sep_comma:");
    try append_line(out, "  %t_after_comma = add i64 %t_cursor, 2");
    try append_line(out, "  br label %tag_loop");
    try append_line(out, "tag_sep_close:");
    try append_line(out, "  %t_sep_is_close = icmp eq i64 %t_sep_kind, 30");
    try append_line(out, "  br i1 %t_sep_is_close, label %tags_done_sep, label %fail");
    try append_line(out, "tags_done_head:");
    try append_line(out, "  br label %tags_done");
    try append_line(out, "tags_done_sep:");
    try append_line(out, "  br label %tags_done");
    try append_line(out, "tags_done:");
    try append_line(out, "  %t_close_index = phi i64 [ %t_cursor, %tags_done_head ], [ %t_sep_index, %tags_done_sep ]");
    try append_line(out, "  %tag_len = phi i64 [ %t_count, %tags_done_head ], [ %t_count_next, %tags_done_sep ]");
    try append_line(out,
        "  %close_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %t_close_index)");
    try append_line(out, "  %close_end = extractvalue %kizu.kizu.lexer.token %close_token, 2");
    try append_line(out, "  %name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
    try append_line(out, "  %name_end = extractvalue %kizu.kizu.lexer.token %name_token, 2");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %name_start, i64 %name_end, i64 4)");
    try append_line(out,
        "  %decl_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_enum_decl(%kizu.kizu.ast.ast %ast, i64 %enum_start, i64 %close_end, %kizu.kizu.ast.node_id %name_node, i64 %tags_child_start, i64 %tag_len)");
    try append_line(out, "  %next = add i64 %t_close_index, 1");
    try append_line(out, "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %decl_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_struct_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_struct_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %struct_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %struct_start = extractvalue %kizu.kizu.lexer.token %struct_token, 1");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_ok = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_ok, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 29");
    try append_line(out, "  br i1 %open_ok, label %fields_begin, label %fail");
    try append_line(out, "fields_begin:");
    try append_line(out, "  %fields_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  %first_field_index = add i64 %index, 3");
    try append_line(out, "  br label %field_loop");
    try append_line(out, "field_loop:");
    try append_line(out, "  %cursor = phi i64 [ %first_field_index, %fields_begin ], [ %after_comma, %field_sep_comma ]");
    try append_line(out, "  %field_count = phi i64 [ 0, %fields_begin ], [ %field_count_next, %field_sep_comma ]");
    try append_line(out,
        "  %cursor_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %cursor)");
    try append_line(out, "  %cursor_kind = extractvalue %kizu.kizu.lexer.token %cursor_token, 0");
    try append_line(out, "  %is_close = icmp eq i64 %cursor_kind, 30");
    try append_line(out, "  br i1 %is_close, label %fields_done_head, label %field_name");
    try append_line(out, "field_name:");
    try append_line(out, "  %field_name_ok = icmp eq i64 %cursor_kind, 27");
    try append_line(out, "  br i1 %field_name_ok, label %field_colon, label %fail");
    try append_line(out, "field_colon:");
    try append_line(out, "  %colon_index = add i64 %cursor, 1");
    try append_line(out,
        "  %colon_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %colon_index)");
    try append_line(out, "  %colon_kind = extractvalue %kizu.kizu.lexer.token %colon_token, 0");
    try append_line(out, "  %colon_ok = icmp eq i64 %colon_kind, 35");
    try append_line(out, "  br i1 %colon_ok, label %field_type, label %fail");
    try append_line(out, "field_type:");
    try append_line(out, "  %type_index = add i64 %cursor, 2");
    try append_line(out,
        "  %type_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_index)");
    try append_line(out, "  %type_kind = extractvalue %kizu.kizu.lexer.token %type_token, 0");
    try append_line(out, "  %type_is_ident = icmp eq i64 %type_kind, 27");
    try append_line(out, "  br i1 %type_is_ident, label %field_type_ident, label %field_type_slice");
    try append_line(out, "field_type_ident:");
    try append_line(out, "  %type_end_ident = extractvalue %kizu.kizu.lexer.token %type_token, 2");
    try append_line(out, "  %sep_index_ident = add i64 %cursor, 3");
    try append_line(out, "  br label %field_build");
    try append_line(out, "field_type_slice:");
    try append_line(out, "  %type_is_lbracket = icmp eq i64 %type_kind, 44");
    try append_line(out, "  br i1 %type_is_lbracket, label %field_type_slice_close, label %fail");
    try append_line(out, "field_type_slice_close:");
    try append_line(out, "  %rbracket_index = add i64 %cursor, 3");
    try append_line(out,
        "  %rbracket_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %rbracket_index)");
    try append_line(out, "  %rbracket_kind = extractvalue %kizu.kizu.lexer.token %rbracket_token, 0");
    try append_line(out, "  %rbracket_ok = icmp eq i64 %rbracket_kind, 45");
    try append_line(out, "  br i1 %rbracket_ok, label %field_type_slice_elem, label %fail");
    try append_line(out, "field_type_slice_elem:");
    try append_line(out, "  %elem_index = add i64 %cursor, 4");
    try append_line(out,
        "  %elem_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %elem_index)");
    try append_line(out, "  %elem_kind = extractvalue %kizu.kizu.lexer.token %elem_token, 0");
    try append_line(out, "  %elem_ok = icmp eq i64 %elem_kind, 27");
    try append_line(out, "  br i1 %elem_ok, label %field_type_slice_build, label %fail");
    try append_line(out, "field_type_slice_build:");
    try append_line(out, "  %type_end_slice = extractvalue %kizu.kizu.lexer.token %elem_token, 2");
    try append_line(out, "  %sep_index_slice = add i64 %cursor, 5");
    try append_line(out, "  br label %field_build");
    try append_line(out, "field_build:");
    try append_line(out,
        "  %type_end = phi i64 [ %type_end_ident, %field_type_ident ], [ %type_end_slice, %field_type_slice_build ]");
    try append_line(out,
        "  %sep_index = phi i64 [ %sep_index_ident, %field_type_ident ], [ %sep_index_slice, %field_type_slice_build ]");
    try append_line(out, "  %field_start = extractvalue %kizu.kizu.lexer.token %cursor_token, 1");
    try append_line(out, "  %field_name_end = extractvalue %kizu.kizu.lexer.token %cursor_token, 2");
    try append_line(out, "  %type_start = extractvalue %kizu.kizu.lexer.token %type_token, 1");
    try append_line(out,
        "  %field_name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %field_start, i64 %field_name_end, i64 4)");
    try append_line(out,
        "  %type_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_start, i64 %type_end, i64 3)");
    try append_line(out,
        "  %field_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_field(%kizu.kizu.ast.ast %ast, i64 %field_start, i64 %type_end, %kizu.kizu.ast.node_id %field_name_node, %kizu.kizu.ast.node_id %type_node)");
    try append_line(out,
        "  %field_append = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %field_node)");
    try append_line(out, "  %field_append_ok = extractvalue %kizu.error.void %field_append, 0");
    try append_line(out, "  br i1 %field_append_ok, label %field_sep, label %fail");
    try append_line(out, "field_sep:");
    try append_line(out, "  %field_count_next = add i64 %field_count, 1");
    try append_line(out,
        "  %sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %sep_index)");
    try append_line(out, "  %sep_kind = extractvalue %kizu.kizu.lexer.token %sep_token, 0");
    try append_line(out, "  %sep_is_comma = icmp eq i64 %sep_kind, 34");
    try append_line(out, "  br i1 %sep_is_comma, label %field_sep_comma, label %field_sep_close");
    try append_line(out, "field_sep_comma:");
    try append_line(out, "  %after_comma = add i64 %sep_index, 1");
    try append_line(out, "  br label %field_loop");
    try append_line(out, "field_sep_close:");
    try append_line(out, "  %sep_is_close = icmp eq i64 %sep_kind, 30");
    try append_line(out, "  br i1 %sep_is_close, label %fields_done_sep, label %fail");
    try append_line(out, "fields_done_head:");
    try append_line(out, "  br label %fields_done");
    try append_line(out, "fields_done_sep:");
    try append_line(out, "  br label %fields_done");
    try append_line(out, "fields_done:");
    try append_line(out, "  %close_index = phi i64 [ %cursor, %fields_done_head ], [ %sep_index, %fields_done_sep ]");
    try append_line(out, "  %field_len = phi i64 [ %field_count, %fields_done_head ], [ %field_count_next, %fields_done_sep ]");
    try append_line(out,
        "  %close_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %close_index)");
    try append_line(out, "  %close_end = extractvalue %kizu.kizu.lexer.token %close_token, 2");
    try append_line(out, "  %name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
    try append_line(out, "  %name_end = extractvalue %kizu.kizu.lexer.token %name_token, 2");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %name_start, i64 %name_end, i64 4)");
    try append_line(out,
        "  %decl_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_struct_decl(%kizu.kizu.ast.ast %ast, i64 %struct_start, i64 %close_end, %kizu.kizu.ast.node_id %name_node, i64 %fields_child_start, i64 %field_len)");
    try append_line(out, "  %next = add i64 %close_index, 1");
    try append_line(out, "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %decl_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_fn_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_fn_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %fn_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_is_ident = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_is_ident, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 31");
    try append_line(out, "  br i1 %open_ok, label %check_params, label %fail");
    // The parameter list parses through one cursor loop: each iteration consumes
    // 'name: type' (appending its Param child contiguously), a comma continues the
    // loop, and ')' (at the loop head or after a param) closes it. Any parameter
    // count parses; nothing is special-cased per arity.
    try append_line(out, "check_params:");
    try append_line(out, "  %params_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  %first_param_index = add i64 %index, 3");
    try append_line(out, "  br label %param_loop");
    try append_line(out, "param_loop:");
    try append_line(out, "  %p_cursor = phi i64 [ %first_param_index, %check_params ], [ %p_after_comma, %param_sep_comma ]");
    try append_line(out, "  %p_count = phi i64 [ 0, %check_params ], [ %p_count_next, %param_sep_comma ]");
    try append_line(out,
        "  %p_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_cursor)");
    try append_line(out, "  %p_kind = extractvalue %kizu.kizu.lexer.token %p_token, 0");
    try append_line(out, "  %p_is_close = icmp eq i64 %p_kind, 32");
    try append_line(out, "  br i1 %p_is_close, label %params_done_head, label %param_name");
    try append_line(out, "param_name:");
    try append_line(out, "  %p_name_ok = icmp eq i64 %p_kind, 27");
    try append_line(out, "  br i1 %p_name_ok, label %param_colon, label %fail");
    try append_line(out, "param_colon:");
    try append_line(out, "  %p_colon_index = add i64 %p_cursor, 1");
    try append_line(out,
        "  %p_colon_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_colon_index)");
    try append_line(out, "  %p_colon_kind = extractvalue %kizu.kizu.lexer.token %p_colon_token, 0");
    try append_line(out, "  %p_colon_ok = icmp eq i64 %p_colon_kind, 35");
    try append_line(out, "  br i1 %p_colon_ok, label %param_type, label %fail");
    // A parameter type is one ident token ('i64', 'bool', a union name), the
    // '[' ']' ident token run of a slice type ('[]u8'), or either form behind a
    // leading '&' borrow; the TypeName leaf spans the whole type text (borrow
    // included) so the codegen param classifier reads it without any
    // boundary-specific shape.
    try append_line(out, "param_type:");
    try append_line(out, "  %p_type_index = add i64 %p_cursor, 2");
    try append_line(out,
        "  %p_amp_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_type_index)");
    try append_line(out, "  %p_amp_kind = extractvalue %kizu.kizu.lexer.token %p_amp_token, 0");
    try append_line(out, "  %p_has_amp = icmp eq i64 %p_amp_kind, 43");
    try append_line(out, "  br i1 %p_has_amp, label %param_type_amp, label %param_type_base");
    try append_line(out, "param_type_amp:");
    try append_line(out, "  %p_type_index_amp = add i64 %p_cursor, 3");
    try append_line(out, "  br label %param_type_base");
    try append_line(out, "param_type_base:");
    try append_line(out,
        "  %p_type_base = phi i64 [ %p_type_index_amp, %param_type_amp ], [ %p_type_index, %param_type ]");
    try append_line(out,
        "  %p_type_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_type_base)");
    try append_line(out, "  %p_type_kind = extractvalue %kizu.kizu.lexer.token %p_type_token, 0");
    try append_line(out, "  %p_type_is_ident = icmp eq i64 %p_type_kind, 27");
    try append_line(out, "  br i1 %p_type_is_ident, label %param_type_ident, label %param_type_slice");
    try append_line(out, "param_type_ident:");
    try append_line(out, "  %p_type_end_ident = extractvalue %kizu.kizu.lexer.token %p_type_token, 2");
    try append_line(out, "  %p_after_type_ident = add i64 %p_type_base, 1");
    try append_line(out, "  br label %param_build");
    try append_line(out, "param_type_slice:");
    try append_line(out, "  %p_type_is_lbracket = icmp eq i64 %p_type_kind, 44");
    try append_line(out, "  br i1 %p_type_is_lbracket, label %param_type_slice_close, label %fail");
    try append_line(out, "param_type_slice_close:");
    try append_line(out, "  %p_rbracket_index = add i64 %p_type_base, 1");
    try append_line(out,
        "  %p_rbracket_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_rbracket_index)");
    try append_line(out, "  %p_rbracket_kind = extractvalue %kizu.kizu.lexer.token %p_rbracket_token, 0");
    try append_line(out, "  %p_rbracket_ok = icmp eq i64 %p_rbracket_kind, 45");
    try append_line(out, "  br i1 %p_rbracket_ok, label %param_type_slice_elem, label %fail");
    try append_line(out, "param_type_slice_elem:");
    try append_line(out, "  %p_elem_index = add i64 %p_type_base, 2");
    try append_line(out,
        "  %p_elem_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_elem_index)");
    try append_line(out, "  %p_elem_kind = extractvalue %kizu.kizu.lexer.token %p_elem_token, 0");
    try append_line(out, "  %p_elem_ok = icmp eq i64 %p_elem_kind, 27");
    try append_line(out, "  br i1 %p_elem_ok, label %param_type_slice_build, label %fail");
    try append_line(out, "param_type_slice_build:");
    try append_line(out, "  %p_type_end_slice = extractvalue %kizu.kizu.lexer.token %p_elem_token, 2");
    try append_line(out, "  %p_after_type_slice = add i64 %p_type_base, 3");
    try append_line(out, "  br label %param_build");
    try append_line(out, "param_build:");
    try append_line(out,
        "  %p_type_end = phi i64 [ %p_type_end_ident, %param_type_ident ], [ %p_type_end_slice, %param_type_slice_build ]");
    try append_line(out,
        "  %p_sep_index = phi i64 [ %p_after_type_ident, %param_type_ident ], [ %p_after_type_slice, %param_type_slice_build ]");
    try append_line(out, "  %p_name_start = extractvalue %kizu.kizu.lexer.token %p_token, 1");
    try append_line(out, "  %p_name_end = extractvalue %kizu.kizu.lexer.token %p_token, 2");
    try append_line(out, "  %p_type_start = extractvalue %kizu.kizu.lexer.token %p_amp_token, 1");
    try append_line(out,
        "  %p_name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %p_name_start, i64 %p_name_end, i64 4)");
    try append_line(out,
        "  %p_type_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %p_type_start, i64 %p_type_end, i64 3)");
    try append_line(out,
        "  %p_param_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_param(%kizu.kizu.ast.ast %ast, i64 %p_name_start, i64 %p_type_end, %kizu.kizu.ast.node_id %p_name_node, %kizu.kizu.ast.node_id %p_type_node)");
    try append_line(out,
        "  %p_append = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %p_param_node)");
    try append_line(out, "  %p_append_ok = extractvalue %kizu.error.void %p_append, 0");
    try append_line(out, "  br i1 %p_append_ok, label %param_sep, label %fail");
    try append_line(out, "param_sep:");
    try append_line(out, "  %p_count_next = add i64 %p_count, 1");
    try append_line(out,
        "  %p_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %p_sep_index)");
    try append_line(out, "  %p_sep_kind = extractvalue %kizu.kizu.lexer.token %p_sep_token, 0");
    try append_line(out, "  %p_is_comma = icmp eq i64 %p_sep_kind, 34");
    try append_line(out, "  br i1 %p_is_comma, label %param_sep_comma, label %param_sep_close");
    try append_line(out, "param_sep_comma:");
    try append_line(out, "  %p_after_comma = add i64 %p_sep_index, 1");
    try append_line(out, "  br label %param_loop");
    try append_line(out, "param_sep_close:");
    try append_line(out, "  %p_sep_is_close = icmp eq i64 %p_sep_kind, 32");
    try append_line(out, "  br i1 %p_sep_is_close, label %params_done_sep, label %fail");
    try append_line(out, "params_done_head:");
    try append_line(out, "  br label %after_params");
    try append_line(out, "params_done_sep:");
    try append_line(out, "  br label %after_params");
    try append_line(out, "after_params:");
    try append_line(out, "  %p_close_index = phi i64 [ %p_cursor, %params_done_head ], [ %p_sep_index, %params_done_sep ]");
    try append_line(out, "  %param_len = phi i64 [ %p_count, %params_done_head ], [ %p_count_next, %params_done_sep ]");
