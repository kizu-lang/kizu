    try append_line(out, "  %semicolon_kind = extractvalue %kizu.kizu.lexer.token %semicolon, 0");
    try append_line(out, "  %semicolon_ok = icmp eq i64 %semicolon_kind, 33");
    try append_line(out, "  br i1 %semicolon_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %let_start = extractvalue %kizu.kizu.lexer.token %let_token, 1");
    try append_line(out, "  %name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
