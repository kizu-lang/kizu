    try append_line(out, "  %for_end = extractvalue %kizu.kizu.lexer.token %body_close, 2");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %name_start, i64 %name_end, i64 4)");
    try append_line(out,
        "  %for_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_for(%kizu.kizu.ast.ast %ast, i64 %for_start, i64 %for_end, %kizu.kizu.ast.node_id %label, %kizu.kizu.ast.node_id %name_node, %kizu.kizu.ast.node_id %start_node, %kizu.kizu.ast.node_id %end_node, %kizu.kizu.ast.node_id %body_node)");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
