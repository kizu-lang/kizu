    try append_line(out, "  %let_kind = extractvalue %kizu.kizu.lexer.token %let_token, 0");
    try append_line(out, "  %mutable = icmp eq i64 %let_kind, 9");
    try append_line(out,
        "  %let_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_let(%kizu.kizu.ast.ast %ast, i64 %let_start, i64 %semicolon_end, i1 %mutable, %kizu.kizu.ast.node_id %name_node, %kizu.kizu.ast.node_id %value_node)");
    try append_line(out, "  %next = add i64 %value_next, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %let_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

