pub fn append_globals(out: &var std::string::String) -> !void {
    return;
}

pub fn append_functions(
    out: &var std::string::String,
    source_file_abi: []u8,
    parse_result_abi: []u8,
    source_file_path_index: i64,
    source_file_text_index: i64,
    parse_result_error_abi: []u8
) -> !void {
    try append_parse_validated_ast_function(
        out,
        source_file_abi,
        parse_result_abi,
        source_file_path_index,
        source_file_text_index,
        parse_result_error_abi
    );
    return;
}

// The static CLI boundary only constructs SourceFile and delegates parsing to
// the compiled parser. Validation normally prevents this error edge; if the
// parser still rejects the input, fail explicitly instead of manufacturing an
// AstData value that the parser never produced.
fn append_parse_validated_ast_function(
    out: &var std::string::String,
    source_file_abi: []u8,
    parse_result_abi: []u8,
    source_file_path_index: i64,
    source_file_text_index: i64,
    parse_result_error_abi: []u8
) -> !void {
    try out.append_bytes("define ");
    try out.append_bytes(parse_result_abi);
    try append_line(out, " @kizu_selfhost__cli_parse_validated_ast(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try out.append_bytes("  %file0 = insertvalue ");
    try out.append_bytes(source_file_abi);
    try out.append_bytes(" poison, %kizu.slice.u8 %path, ");
    try std::fmt::append_i64(out, source_file_path_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %file = insertvalue ");
    try out.append_bytes(source_file_abi);
    try out.append_bytes(" %file0, %kizu.slice.u8 %source, ");
    try std::fmt::append_i64(out, source_file_text_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %parsed_eu = call ");
    try out.append_bytes(parse_result_error_abi);
    try out.append_bytes(" @kizu_kizu__parser_parse_program(%kizu.owned %allocator, ");
    try out.append_bytes(source_file_abi);
    try append_line(out, " %file)");
    try out.append_bytes("  %parse_ok = extractvalue ");
    try out.append_bytes(parse_result_error_abi);
    try append_line(out, " %parsed_eu, 0");
    try append_line(out, "  br i1 %parse_ok, label %ok, label %parse_error");
    try append_line(out, "ok:");
    try out.append_bytes("  %parsed = extractvalue ");
    try out.append_bytes(parse_result_error_abi);
    try append_line(out, " %parsed_eu, 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(parse_result_abi);
    try append_line(out, " %parsed");
    try append_line(out, "parse_error:");
    try append_line(out, "  call void @kizu_rt_process_exit(i64 1)");
    try append_line(out, "  unreachable");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
