    try append_line(out, "  %params_close_end = extractvalue %kizu.kizu.lexer.token %p_close_token, 2");
    try append_line(out, "  %after_params_index = add i64 %p_close_index, 1");
    try append_line(out, "  %param_start = select i1 true, i64 %params_child_start, i64 %params_child_start");
    try append_line(out,
        "  %after_params_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %after_params_index)");
    try append_line(out, "  %after_params_kind = extractvalue %kizu.kizu.lexer.token %after_params_token, 0");
    try append_line(out, "  %has_arrow = icmp eq i64 %after_params_kind, 38");
    try append_line(out, "  br i1 %has_arrow, label %parse_return_type, label %no_return_type");
    try append_line(out, "no_return_type:");
    try append_line(out,
        "  %return_empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %params_close_end, i64 %params_close_end, i64 44)");
    try append_line(out, "  br label %body_common");
    try append_line(out, "parse_return_type:");
    try append_line(out, "  %ret_token_index = add i64 %after_params_index, 1");
