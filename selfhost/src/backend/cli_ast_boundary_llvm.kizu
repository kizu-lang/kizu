fn append_parse_test_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_test_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
