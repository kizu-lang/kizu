fn append_parse_let_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_let(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %let_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_ok = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_ok, label %check_assign, label %fail");
    try append_line(out, "check_assign:");
    try append_line(out, "  %assign_index = add i64 %index, 2");
    try append_line(out,
        "  %assign_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %assign_index)");
    try append_line(out, "  %assign_kind = extractvalue %kizu.kizu.lexer.token %assign_token, 0");
    try append_line(out, "  %assign_ok = icmp eq i64 %assign_kind, 37");
    try append_line(out, "  br i1 %assign_ok, label %parse_value, label %fail");
    // A let init starting with 'Ident {' is a struct literal (the only boundary
    // context that allows one, so 'while x {' style headers stay unambiguous).
    try append_line(out, "parse_value:");
    try append_line(out, "  %value_index = add i64 %index, 3");
    try append_line(out,
        "  %vi_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  %vi_kind = extractvalue %kizu.kizu.lexer.token %vi_token, 0");
    try append_line(out, "  %vi_is_ident = icmp eq i64 %vi_kind, 27");
    try append_line(out, "  br i1 %vi_is_ident, label %peek_brace, label %maybe_match_value");
    try append_line(out, "peek_brace:");
    try append_line(out, "  %vb_index = add i64 %index, 4");
    try append_line(out,
        "  %vb_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %vb_index)");
    try append_line(out, "  %vb_kind = extractvalue %kizu.kizu.lexer.token %vb_token, 0");
    try append_line(out, "  %vb_is_brace = icmp eq i64 %vb_kind, 29");
    try append_line(out, "  br i1 %vb_is_brace, label %parse_value_struct, label %parse_value_expr");
    try append_line(out, "parse_value_struct:");
    try append_line(out,
        "  %struct_value = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_struct_literal(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  br label %parse_value_join");
    // A 'match' keyword init is a match expression; the match parser already
    // builds expression arm bodies, so its node serves as the let value.
    try append_line(out, "maybe_match_value:");
    try append_line(out, "  %vi_is_match = icmp eq i64 %vi_kind, 19");
    try append_line(out, "  br i1 %vi_is_match, label %parse_value_match, label %parse_value_expr");
    try append_line(out, "parse_value_match:");
    try append_line(out,
        "  %match_value = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_match(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  br label %parse_value_join");
    try append_line(out, "parse_value_expr:");
    try append_line(out,
        "  %expr_value = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %value_index)");
    try append_line(out, "  br label %parse_value_join");
    try append_line(out, "parse_value_join:");
    try append_line(out,
        "  %value_result = phi %kizu.selfhost.cli.parse_node_result [ %struct_value, %parse_value_struct ], [ %match_value, %parse_value_match ], [ %expr_value, %parse_value_expr ]");
    try append_line(out, "  %value_ok = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 0");
    try append_line(out, "  br i1 %value_ok, label %check_semicolon, label %fail");
    try append_line(out, "check_semicolon:");
    try append_line(out, "  %value_next = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 1");
    try append_line(out, "  %value_node = extractvalue %kizu.selfhost.cli.parse_node_result %value_result, 2");
    try append_line(out,
        "  %semicolon = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %value_next)");
    try append_line(out, "  %semicolon_kind = extractvalue %kizu.kizu.lexer.token %semicolon, 0");
    try append_line(out, "  %semicolon_ok = icmp eq i64 %semicolon_kind, 33");
    try append_line(out, "  br i1 %semicolon_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %let_start = extractvalue %kizu.kizu.lexer.token %let_token, 1");
    try append_line(out, "  %name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
    try append_line(out, "  %name_end = extractvalue %kizu.kizu.lexer.token %name_token, 2");
    try append_line(out, "  %semicolon_end = extractvalue %kizu.kizu.lexer.token %semicolon, 2");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %name_start, i64 %name_end, i64 4)");
    try append_line(out, "  %let_kind = extractvalue %kizu.kizu.lexer.token %let_token, 0");
    try append_line(out, "  %mutable = icmp eq i64 %let_kind, 9");
    try append_line(out,
        "  %let_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_let(%kizu.kizu.ast.ast %ast, i64 %let_start, i64 %semicolon_end, i1 %mutable, %kizu.kizu.ast.node_id %name_node, %kizu.kizu.ast.node_id %value_node)");
    try append_line(out, "  %next = add i64 %value_next, 1");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %let_node, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %ok2");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

