pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant_bytes(out, "ast_test_keyword", "test");
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_ast_new_function(out);
    try append_ast_child_len_function(out);
    try append_ast_append_child_function(out);
    try append_token_at_function(out);
    try append_token_text_equal_function(out);
    try append_unsupported_parse_result_function(out);
    try append_parse_validated_ast_function(out);
    try append_parse_decl_function(out);
    try append_parse_fn_decl_function(out);
    try append_parse_test_decl_function(out);
    try append_parse_block_function(out);
    try append_parse_statement_function(out);
    try append_parse_return_function(out);
    try append_parse_let_function(out);
    try append_parse_assign_function(out);
    try append_parse_if_function(out);
    try append_parse_while_function(out);
    try append_parse_for_function(out);
    try append_parse_break_function(out);
    try append_parse_continue_function(out);
    try append_parse_expr_statement_function(out);
    try append_parse_expr_function(out);
    try append_parse_compare_expr_function(out);
    try append_parse_additive_expr_function(out);
    try append_parse_multiplicative_expr_function(out);
    try append_parse_primary_expr_function(out);
    try append_parse_ident_expr_function(out);
    try append_parse_call_function(out);
    try append_add_leaf_node_function(out);
    try append_add_program_function(out);
    try append_add_param_function(out);
    try append_add_fn_decl_function(out);
    try append_add_block_function(out);
    try append_add_let_function(out);
    try append_add_assign_function(out);
    try append_add_return_function(out);
    try append_add_expr_stmt_function(out);
    try append_add_if_function(out);
    try append_add_while_function(out);
    try append_add_for_function(out);
    try append_add_break_function(out);
    try append_add_continue_function(out);
    try append_add_binary_function(out);
    try append_add_field_expr_function(out);
    try append_add_call_function(out);
    try append_add_try_expr_function(out);
    return;
}

fn append_ast_new_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %nodes = call %kizu.owned @kizu_rt_array_new(%kizu.owned %allocator, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.ast_node, ptr null, i32 1) to i64))");
    try append_line(out,
        "  %children = call %kizu.owned @kizu_rt_array_new(%kizu.owned %allocator, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.node_id, ptr null, i32 1) to i64))");
    try append_line(out,
        "  %file0 = insertvalue %kizu.kizu.ast.source_file poison, %kizu.slice.u8 %path, 0");
    try append_line(out,
        "  %file = insertvalue %kizu.kizu.ast.source_file %file0, %kizu.slice.u8 %source, 1");
    try append_line(out, "  %ast0 = insertvalue %kizu.kizu.ast.ast poison, %kizu.owned %nodes, 0");
    try append_line(out, "  %ast1 = insertvalue %kizu.kizu.ast.ast %ast0, %kizu.owned %children, 1");
    try append_line(out,
        "  %ast = insertvalue %kizu.kizu.ast.ast %ast1, %kizu.kizu.ast.source_file %file, 2");
    try append_line(out, "  ret %kizu.kizu.ast.ast %ast");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_ast_child_len_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_ast_child_len(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %children = extractvalue %kizu.kizu.ast.ast %ast, 1");
    try append_line(out, "  %len = call i64 @kizu_rt_array_len(%kizu.owned %children)");
    try append_line(out, "  ret i64 %len");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_ast_append_child_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__cli_ast_append_child(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.kizu.ast.node_id %child");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %slot = alloca %kizu.kizu.ast.node_id, align 8");
    try append_line(out, "  store %kizu.kizu.ast.node_id %child, ptr %slot, align 8");
    try append_line(out, "  %slice0 = insertvalue %kizu.slice.u8 poison, ptr %slot, 0");
    try append_line(out,
        "  %slice = insertvalue %kizu.slice.u8 %slice0, i64 ptrtoint (ptr getelementptr (%kizu.kizu.ast.node_id, ptr null, i32 1) to i64), 1");
    try append_line(out, "  %children = extractvalue %kizu.kizu.ast.ast %ast, 1");
    try append_line(out,
        "  %result = call %kizu.error.void @kizu_rt_array_append(%kizu.owned %children, %kizu.slice.u8 %slice)");
    try append_line(out, "  ret %kizu.error.void %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_token_at_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %view = call %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %ok = extractvalue %kizu.error.slice.u8 %view, 0");
    try append_line(out, "  br i1 %ok, label %load, label %fallback");
    try append_line(out, "load:");
    try append_line(out, "  %slice = extractvalue %kizu.error.slice.u8 %view, 1");
    try append_line(out, "  %ptr = extractvalue %kizu.slice.u8 %slice, 0");
    try append_line(out, "  %token = load %kizu.kizu.lexer.token, ptr %ptr, align 8");
    try append_line(out, "  ret %kizu.kizu.lexer.token %token");
    try append_line(out, "fallback:");
    try append_line(out,
        "  %eof = insertvalue %kizu.kizu.lexer.token zeroinitializer, i64 61, 0");
    try append_line(out, "  ret %kizu.kizu.lexer.token %eof");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_token_text_equal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_text_equal(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.kizu.lexer.token %token,");
    try append_line(out, "  %kizu.slice.u8 %expected");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %start = extractvalue %kizu.kizu.lexer.token %token, 1");
    try append_line(out, "  %end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %slice0 = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %slice0, i64 %len, 1");
    try append_line(out,
        "  %same = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %slice, %kizu.slice.u8 %expected)");
    try append_line(out, "  ret i1 %same");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_unsupported_parse_result_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.parse_result @kizu_selfhost__cli_unsupported_parse_result(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %ast = call %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out,
        "  %root = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 0, i64 0, i64 44)");
    try append_line(out,
        "  %parsed = call %kizu.kizu.ast.parse_result @kizu_kizu__ast_parse_result(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %root)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %parsed");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_validated_ast_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.parse_result @kizu_selfhost__cli_parse_validated_ast(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %decl_slots = alloca [16 x %kizu.kizu.ast.node_id], align 8");
    try append_line(out,
        "  %tokens_result = call %kizu.error.owned @kizu_kizu__lexer_tokenize(%kizu.owned %allocator, %kizu.slice.u8 %source)");
    try append_line(out, "  %tokens_ok = extractvalue %kizu.error.owned %tokens_result, 0");
    try append_line(out, "  br i1 %tokens_ok, label %parse, label %unsupported");
    try append_line(out, "parse:");
    try append_line(out, "  %tokens = extractvalue %kizu.error.owned %tokens_result, 1");
    try append_line(out,
        "  %ast = call %kizu.kizu.ast.ast @kizu_selfhost__cli_ast_new(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out, "  br label %parse_loop");
    try append_line(out, "parse_loop:");
    try append_line(out, "  %index = phi i64 [ 0, %parse ], [ %decl_next, %store_decl ]");
    try append_line(out, "  %decl_count = phi i64 [ 0, %parse ], [ %decl_count_next, %store_decl ]");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_eof = icmp eq i64 %kind, 62");
    try append_line(out, "  br i1 %is_eof, label %finish, label %parse_decl");
    try append_line(out, "parse_decl:");
    try append_line(out,
        "  %decl = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %decl_ok = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 0");
    try append_line(out, "  br i1 %decl_ok, label %decl_ok_block, label %unsupported");
    try append_line(out, "decl_ok_block:");
    try append_line(out, "  %decl_next = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 1");
    try append_line(out, "  %decl_node = extractvalue %kizu.selfhost.cli.parse_node_result %decl, 2");
    try append_line(out, "  %advanced = icmp sgt i64 %decl_next, %index");
    try append_line(out, "  %has_capacity = icmp slt i64 %decl_count, 16");
    try append_line(out, "  %can_store = and i1 %advanced, %has_capacity");
    try append_line(out, "  br i1 %can_store, label %store_decl, label %unsupported");
    try append_line(out, "store_decl:");
    try append_line(out,
        "  %decl_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %decl_slots, i64 0, i64 %decl_count");
    try append_line(out, "  store %kizu.kizu.ast.node_id %decl_node, ptr %decl_slot, align 8");
    try append_line(out, "  %decl_count_next = add i64 %decl_count, 1");
    try append_line(out, "  br label %parse_loop");
    try append_line(out, "finish:");
    try append_line(out, "  %decl_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  br label %append_decls");
    try append_line(out, "append_decls:");
    try append_line(out, "  %append_index = phi i64 [ 0, %finish ], [ %append_next, %append_ok ]");
    try append_line(out, "  %append_done = icmp eq i64 %append_index, %decl_count");
    try append_line(out, "  br i1 %append_done, label %build_program, label %append_decl");
    try append_line(out, "append_decl:");
    try append_line(out,
        "  %append_slot = getelementptr inbounds [16 x %kizu.kizu.ast.node_id], ptr %decl_slots, i64 0, i64 %append_index");
    try append_line(out, "  %append_node = load %kizu.kizu.ast.node_id, ptr %append_slot, align 8");
    try append_line(out,
        "  %append_result = call %kizu.error.void @kizu_selfhost__cli_ast_append_child(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %append_node)");
    try append_line(out, "  %append_result_ok = extractvalue %kizu.error.void %append_result, 0");
    try append_line(out, "  br i1 %append_result_ok, label %append_ok, label %unsupported");
    try append_line(out, "append_ok:");
    try append_line(out, "  %append_next = add i64 %append_index, 1");
    try append_line(out, "  br label %append_decls");
    try append_line(out, "build_program:");
    try append_line(out, "  %eof_end = extractvalue %kizu.kizu.lexer.token %token, 2");
    try append_line(out,
        "  %program = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_program(%kizu.kizu.ast.ast %ast, i64 0, i64 %eof_end, i64 %decl_start, i64 %decl_count)");
    try append_line(out,
        "  %parsed = call %kizu.kizu.ast.parse_result @kizu_kizu__ast_parse_result(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %program)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %parsed");
    try append_line(out, "unsupported:");
    try append_line(out,
        "  %fallback = call %kizu.kizu.ast.parse_result @kizu_selfhost__cli_unsupported_parse_result(%kizu.owned %allocator, %kizu.slice.u8 %path, %kizu.slice.u8 %source)");
    try append_line(out, "  ret %kizu.kizu.ast.parse_result %fallback");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %kind = extractvalue %kizu.kizu.lexer.token %token, 0");
    try append_line(out, "  %is_fn = icmp eq i64 %kind, 0");
    try append_line(out, "  br i1 %is_fn, label %parse_fn, label %maybe_test");
    try append_line(out, "parse_fn:");
    try append_line(out,
        "  %fn_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_fn_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %fn_result");
    try append_line(out, "maybe_test:");
    try append_line(out, "  %is_ident = icmp eq i64 %kind, 27");
    try append_line(out, "  br i1 %is_ident, label %check_test, label %fail");
    try append_line(out, "check_test:");
    try append_line(out,
        "  %test_ptr = getelementptr inbounds [4 x i8], ptr @.kizu.cli.ast_test_keyword, i64 0, i64 0");
    try append_line(out, "  %test0 = insertvalue %kizu.slice.u8 poison, ptr %test_ptr, 0");
    try append_line(out, "  %test_slice = insertvalue %kizu.slice.u8 %test0, i64 4, 1");
    try append_line(out,
        "  %is_test = call i1 @kizu_selfhost__cli_token_text_equal(%kizu.slice.u8 %source, %kizu.kizu.lexer.token %token, %kizu.slice.u8 %test_slice)");
    try append_line(out, "  br i1 %is_test, label %parse_test, label %fail");
    try append_line(out, "parse_test:");
    try append_line(out,
        "  %test_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_test_decl(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %index)");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %test_result");
    try append_line(out, "fail:");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_fn_decl_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_fn_decl(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %fn_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %name_index = add i64 %index, 1");
    try append_line(out,
        "  %name_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %name_index)");
    try append_line(out, "  %name_kind = extractvalue %kizu.kizu.lexer.token %name_token, 0");
    try append_line(out, "  %name_is_ident = icmp eq i64 %name_kind, 27");
    try append_line(out, "  br i1 %name_is_ident, label %check_open, label %fail");
    try append_line(out, "check_open:");
    try append_line(out, "  %open_index = add i64 %index, 2");
    try append_line(out,
        "  %open_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %open_index)");
    try append_line(out, "  %open_kind = extractvalue %kizu.kizu.lexer.token %open_token, 0");
    try append_line(out, "  %open_ok = icmp eq i64 %open_kind, 31");
    try append_line(out, "  br i1 %open_ok, label %check_params, label %fail");
    try append_line(out, "check_params:");
    try append_line(out, "  %first_param_index = add i64 %index, 3");
    try append_line(out,
        "  %first_param_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %first_param_index)");
    try append_line(out, "  %first_param_kind = extractvalue %kizu.kizu.lexer.token %first_param_token, 0");
    try append_line(out, "  %no_params = icmp eq i64 %first_param_kind, 32");
    try append_line(out, "  br i1 %no_params, label %no_params_block, label %param0_name");
    try append_line(out, "no_params_block:");
    try append_line(out, "  %after_params_empty = add i64 %index, 4");
    try append_line(out, "  %param_start_empty = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out, "  %close_end_empty = extractvalue %kizu.kizu.lexer.token %first_param_token, 2");
    try append_line(out, "  br label %after_params");
    try append_line(out, "param0_name:");
    try append_line(out, "  %param0_name_ok = icmp eq i64 %first_param_kind, 27");
    try append_line(out, "  br i1 %param0_name_ok, label %param0_colon, label %fail");
    try append_line(out, "param0_colon:");
    try append_line(out, "  %param0_colon_index = add i64 %index, 4");
    try append_line(out,
        "  %param0_colon_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %param0_colon_index)");
