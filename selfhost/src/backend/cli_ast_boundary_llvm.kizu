        "  %p1 = insertvalue %kizu.kizu.ast.field_expr_node %p0, %kizu.kizu.ast.node_id %name, 1");
    try append_line(out, "  %payload = insertvalue %kizu.kizu.ast.field_expr_node %p1, i1 true, 2");
    try append_node_with_payload(out, "%kizu.kizu.ast.field_expr_node", "payload", "8");
    return;
}

fn append_add_call_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_call(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  %kizu.kizu.ast.node_id %callee,");
    try append_line(out, "  i64 %arg_start,");
    try append_line(out, "  i64 %arg_len");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %callee_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.node_id %callee)");
    try append_line(out, "  %callee_span = extractvalue %kizu.kizu.ast.ast_node %callee_node, 0");
    try append_line(out, "  %start = extractvalue %kizu.kizu.ast.span %callee_span, 0");
    try append_line(out, "  %range0 = insertvalue %kizu.kizu.ast.child_range poison, i64 %arg_start, 0");
    try append_line(out, "  %range = insertvalue %kizu.kizu.ast.child_range %range0, i64 %arg_len, 1");
    try append_line(out,
        "  %p0 = insertvalue %kizu.kizu.ast.call_node poison, %kizu.kizu.ast.node_id %callee, 0");
    try append_line(out,
        "  %payload = insertvalue %kizu.kizu.ast.call_node %p0, %kizu.kizu.ast.child_range %range, 1");
    try append_node_with_payload(out, "%kizu.kizu.ast.call_node", "payload", "10");
    return;
}

fn append_add_try_expr_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_try_expr(");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  %kizu.kizu.ast.node_id %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %payload = insertvalue %kizu.kizu.ast.try_expr_node poison, %kizu.kizu.ast.node_id %value, 0");
    try append_node_with_payload(out, "%kizu.kizu.ast.try_expr_node", "payload", "17");
    return;
}

fn append_node_with_payload(
    out: &var std::string::String,
    payload_type: []u8,
    payload_name: []u8,
    tag: []u8
) -> !void {
    try append_line(out, "  %span0 = insertvalue %kizu.kizu.ast.span poison, i64 %start, 0");
    try append_line(out, "  %span = insertvalue %kizu.kizu.ast.span %span0, i64 %end, 1");
    try out.append_bytes("  %data0 = insertvalue %kizu.kizu.ast.ast_data zeroinitializer, i64 ");
    try out.append_bytes(tag);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %data_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_line(out, "  store %kizu.kizu.ast.ast_data %data0, ptr %data_slot, align 8");
    try append_line(out,
        "  %payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %data_slot, i32 0, i32 1");
    try out.append_bytes("  store ");
    try out.append_bytes(payload_type);
    try out.append_bytes(" %");
    try out.append_bytes(payload_name);
    try out.append_bytes(", ptr %payload_ptr, align 8");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %data = load %kizu.kizu.ast.ast_data, ptr %data_slot, align 8");
    try append_line(out,
        "  %node = call %kizu.kizu.ast.node_id @kizu_kizu__ast_ast_add_node(%kizu.kizu.ast.ast %ast, %kizu.kizu.ast.span %span, %kizu.kizu.ast.ast_data %data)");
    try append_line(out, "  ret %kizu.kizu.ast.node_id %node");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_constant_bytes(
    out: &var std::string::String,
    name: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, std::mem::len(text));
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}
