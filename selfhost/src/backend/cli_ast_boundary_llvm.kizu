    try append_line(out, "  %one_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %one_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %one_ok0, i64 %one_next, 1");
    try append_line(out,
        "  %one_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %one_ok1, %kizu.kizu.ast.node_id %one_lit, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %one_ok2");
    try append_line(out, "build_two:");
    try append_line(out, "  %two_close_end_a = extractvalue %kizu.kizu.lexer.token %f2_sep_token, 2");
    try append_line(out, "  %two_next_a = add i64 %f2_next, 1");
