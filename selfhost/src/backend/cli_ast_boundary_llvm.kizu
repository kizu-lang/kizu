pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant_bytes(out, "ast_test_keyword", "test");
    try append_llvm_constant_bytes(out, "ast_cast_keyword", "cast");
    try append_llvm_constant_bytes(out, "ast_impl_keyword", "impl");
    return;
}

