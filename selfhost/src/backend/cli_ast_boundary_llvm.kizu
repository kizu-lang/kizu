        "  %start_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_primary_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %start_index)");
    try append_line(out, "  %start_ok = extractvalue %kizu.selfhost.cli.parse_node_result %start_result, 0");
    try append_line(out, "  br i1 %start_ok, label %check_range, label %fail");
