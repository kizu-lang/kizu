// cli_parse_struct_literal parses 'Ident { [name: value[, name: value[,]]] }'
// with zero, one, or two field inits (the same bounded SSA buffering the call
// argument parser uses; wider literals stay with the real parser until issue
// 1157 replaces this boundary). Each field value is a nested struct literal
// (an 'Ident {' peek) or a general expression; field-init children append after
// both values parse so the literal's child range stays contiguous even when a
// nested literal appended its own children first.
fn append_parse_struct_literal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_struct_literal(");
    try append_line(out, "  %kizu.owned %allocator,");
    try append_line(out, "  %kizu.kizu.ast.ast %ast,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  %kizu.owned %tokens,");
    try append_line(out, "  i64 %index");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %type_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %index)");
    try append_line(out, "  %type_start = extractvalue %kizu.kizu.lexer.token %type_token, 1");
    try append_line(out, "  %type_end = extractvalue %kizu.kizu.lexer.token %type_token, 2");
    try append_line(out, "  %f1_index = add i64 %index, 2");
    try append_line(out,
        "  %f1_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f1_index)");
    try append_line(out, "  %f1_kind = extractvalue %kizu.kizu.lexer.token %f1_token, 0");
    try append_line(out, "  %lit_empty = icmp eq i64 %f1_kind, 30");
    try append_line(out, "  br i1 %lit_empty, label %build_empty, label %field1_name");
    try append_line(out, "build_empty:");
    try append_line(out, "  %empty_close_end = extractvalue %kizu.kizu.lexer.token %f1_token, 2");
    try append_line(out, "  %empty_child_start = call i64 @kizu_selfhost__cli_ast_child_len(%kizu.kizu.ast.ast %ast)");
    try append_line(out,
        "  %empty_type_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_start, i64 %type_end, i64 3)");
    try append_line(out,
        "  %empty_lit = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_struct_literal(%kizu.kizu.ast.ast %ast, i64 %type_start, i64 %empty_close_end, %kizu.kizu.ast.node_id %empty_type_node, i64 %empty_child_start, i64 0)");
    try append_line(out, "  %empty_next = add i64 %f1_index, 1");
    try append_line(out, "  %empty_ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out, "  %empty_ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %empty_ok0, i64 %empty_next, 1");
    try append_line(out,
        "  %empty_ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %empty_ok1, %kizu.kizu.ast.node_id %empty_lit, 2");
    try append_line(out, "  ret %kizu.selfhost.cli.parse_node_result %empty_ok2");
    try append_line(out, "field1_name:");
    try append_line(out, "  %f1_name_ok = icmp eq i64 %f1_kind, 27");
    try append_line(out, "  br i1 %f1_name_ok, label %field1_colon, label %fail");
    try append_line(out, "field1_colon:");
    try append_line(out, "  %f1_colon_index = add i64 %f1_index, 1");
    try append_line(out,
        "  %f1_colon_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f1_colon_index)");
    try append_line(out, "  %f1_colon_kind = extractvalue %kizu.kizu.lexer.token %f1_colon_token, 0");
    try append_line(out, "  %f1_colon_ok = icmp eq i64 %f1_colon_kind, 35");
    try append_line(out, "  br i1 %f1_colon_ok, label %field1_value, label %fail");
    try append_line(out, "field1_value:");
    try append_line(out, "  %f1_value_index = add i64 %f1_index, 2");
    try append_line(out,
        "  %f1v_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f1_value_index)");
    try append_line(out, "  %f1v_kind = extractvalue %kizu.kizu.lexer.token %f1v_token, 0");
    try append_line(out, "  %f1v_is_ident = icmp eq i64 %f1v_kind, 27");
    try append_line(out, "  br i1 %f1v_is_ident, label %f1_peek, label %f1_expr");
    try append_line(out, "f1_peek:");
    try append_line(out, "  %f1b_index = add i64 %f1_value_index, 1");
    try append_line(out,
        "  %f1b_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f1b_index)");
    try append_line(out, "  %f1b_kind = extractvalue %kizu.kizu.lexer.token %f1b_token, 0");
    try append_line(out, "  %f1b_is_brace = icmp eq i64 %f1b_kind, 29");
    try append_line(out, "  br i1 %f1b_is_brace, label %f1_struct, label %f1_expr");
    try append_line(out, "f1_struct:");
    try append_line(out,
        "  %f1_struct_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_struct_literal(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %f1_value_index)");
    try append_line(out, "  br label %f1_join");
    try append_line(out, "f1_expr:");
    try append_line(out,
        "  %f1_expr_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %f1_value_index)");
    try append_line(out, "  br label %f1_join");
    try append_line(out, "f1_join:");
    try append_line(out,
        "  %f1_result = phi %kizu.selfhost.cli.parse_node_result [ %f1_struct_result, %f1_struct ], [ %f1_expr_result, %f1_expr ]");
    try append_line(out, "  %f1_ok = extractvalue %kizu.selfhost.cli.parse_node_result %f1_result, 0");
    try append_line(out, "  br i1 %f1_ok, label %f1_sep, label %fail");
    try append_line(out, "f1_sep:");
    try append_line(out, "  %f1_next = extractvalue %kizu.selfhost.cli.parse_node_result %f1_result, 1");
    try append_line(out, "  %f1_value_node = extractvalue %kizu.selfhost.cli.parse_node_result %f1_result, 2");
    try append_line(out,
        "  %f1_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f1_next)");
    try append_line(out, "  %f1_sep_kind = extractvalue %kizu.kizu.lexer.token %f1_sep_token, 0");
    try append_line(out, "  %f1_close = icmp eq i64 %f1_sep_kind, 30");
    try append_line(out, "  br i1 %f1_close, label %build_one, label %f1_comma");
    try append_line(out, "f1_comma:");
    try append_line(out, "  %f1_has_comma = icmp eq i64 %f1_sep_kind, 34");
    try append_line(out, "  br i1 %f1_has_comma, label %after_f1_comma, label %fail");
    try append_line(out, "after_f1_comma:");
    try append_line(out, "  %f2_index = add i64 %f1_next, 1");
    try append_line(out,
        "  %f2_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f2_index)");
    try append_line(out, "  %f2_kind = extractvalue %kizu.kizu.lexer.token %f2_token, 0");
    try append_line(out, "  %trailing_one = icmp eq i64 %f2_kind, 30");
    try append_line(out, "  br i1 %trailing_one, label %build_one_trailing, label %field2_name");
    try append_line(out, "field2_name:");
    try append_line(out, "  %f2_name_ok = icmp eq i64 %f2_kind, 27");
    try append_line(out, "  br i1 %f2_name_ok, label %field2_colon, label %fail");
    try append_line(out, "field2_colon:");
    try append_line(out, "  %f2_colon_index = add i64 %f2_index, 1");
    try append_line(out,
        "  %f2_colon_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f2_colon_index)");
    try append_line(out, "  %f2_colon_kind = extractvalue %kizu.kizu.lexer.token %f2_colon_token, 0");
    try append_line(out, "  %f2_colon_ok = icmp eq i64 %f2_colon_kind, 35");
    try append_line(out, "  br i1 %f2_colon_ok, label %field2_value, label %fail");
    try append_line(out, "field2_value:");
    try append_line(out, "  %f2_value_index = add i64 %f2_index, 2");
    try append_line(out,
        "  %f2v_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f2_value_index)");
    try append_line(out, "  %f2v_kind = extractvalue %kizu.kizu.lexer.token %f2v_token, 0");
    try append_line(out, "  %f2v_is_ident = icmp eq i64 %f2v_kind, 27");
    try append_line(out, "  br i1 %f2v_is_ident, label %f2_peek, label %f2_expr");
    try append_line(out, "f2_peek:");
    try append_line(out, "  %f2b_index = add i64 %f2_value_index, 1");
    try append_line(out,
        "  %f2b_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f2b_index)");
    try append_line(out, "  %f2b_kind = extractvalue %kizu.kizu.lexer.token %f2b_token, 0");
    try append_line(out, "  %f2b_is_brace = icmp eq i64 %f2b_kind, 29");
    try append_line(out, "  br i1 %f2b_is_brace, label %f2_struct, label %f2_expr");
    try append_line(out, "f2_struct:");
    try append_line(out,
        "  %f2_struct_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_struct_literal(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %f2_value_index)");
    try append_line(out, "  br label %f2_join");
    try append_line(out, "f2_expr:");
    try append_line(out,
        "  %f2_expr_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_expr(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %f2_value_index)");
    try append_line(out, "  br label %f2_join");
    try append_line(out, "f2_join:");
    try append_line(out,
        "  %f2_result = phi %kizu.selfhost.cli.parse_node_result [ %f2_struct_result, %f2_struct ], [ %f2_expr_result, %f2_expr ]");
    try append_line(out, "  %f2_ok = extractvalue %kizu.selfhost.cli.parse_node_result %f2_result, 0");
    try append_line(out, "  br i1 %f2_ok, label %f2_sep, label %fail");
    try append_line(out, "f2_sep:");
    try append_line(out, "  %f2_next = extractvalue %kizu.selfhost.cli.parse_node_result %f2_result, 1");
    try append_line(out, "  %f2_value_node = extractvalue %kizu.selfhost.cli.parse_node_result %f2_result, 2");
    try append_line(out,
        "  %f2_sep_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f2_next)");
    try append_line(out, "  %f2_sep_kind = extractvalue %kizu.kizu.lexer.token %f2_sep_token, 0");
    try append_line(out, "  %f2_close = icmp eq i64 %f2_sep_kind, 30");
    try append_line(out, "  br i1 %f2_close, label %build_two, label %f2_comma");
    try append_line(out, "f2_comma:");
    try append_line(out, "  %f2_has_comma = icmp eq i64 %f2_sep_kind, 34");
    try append_line(out, "  br i1 %f2_has_comma, label %f2_after_comma, label %fail");
    try append_line(out, "f2_after_comma:");
    try append_line(out, "  %f2_trail_index = add i64 %f2_next, 1");
    try append_line(out,
        "  %f2_trail_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %f2_trail_index)");
    try append_line(out, "  %f2_trail_kind = extractvalue %kizu.kizu.lexer.token %f2_trail_token, 0");
    try append_line(out, "  %f2_trail_close = icmp eq i64 %f2_trail_kind, 30");
    try append_line(out, "  br i1 %f2_trail_close, label %build_two_trailing, label %fail");
    try append_line(out, "build_one:");
