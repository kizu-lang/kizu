    try append_line(out, "  %type_index_bang = add i64 %ret_token_index, 1");
    try append_line(out, "  br label %ret_type_common");
    try append_line(out, "ret_direct:");
    try append_line(out, "  br label %ret_type_common");
    try append_line(out, "ret_type_common:");
    try append_line(out,
        "  %type_index = phi i64 [ %type_index_bang, %ret_after_bang ], [ %ret_token_index, %ret_direct ]");
    try append_line(out,
        "  %type_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %type_index)");
    try append_line(out, "  %type_kind = extractvalue %kizu.kizu.lexer.token %type_token, 0");
    try append_line(out, "  %type_is_ident = icmp eq i64 %type_kind, 27");
    try append_line(out, "  br i1 %type_is_ident, label %return_type_ok, label %fail");
    try append_line(out, "return_type_ok:");
    try append_line(out, "  %type_token_start = extractvalue %kizu.kizu.lexer.token %type_token, 1");
    try append_line(out, "  %bang_start = extractvalue %kizu.kizu.lexer.token %ret_token, 1");
    try append_line(out, "  %type_start = select i1 %ret_is_bang, i64 %bang_start, i64 %type_token_start");
    try append_line(out, "  %type_end = extractvalue %kizu.kizu.lexer.token %type_token, 2");
    try append_line(out,
        "  %return_type = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %type_start, i64 %type_end, i64 3)");
    try append_line(out, "  %body_index_from_return = add i64 %type_index, 1");
    try append_line(out, "  br label %body_common");
    try append_line(out, "body_common:");
    try append_line(out,
        "  %body_index = phi i64 [ %after_params_index, %no_return_type ], [ %body_index_from_return, %return_type_ok ]");
    try append_line(out,
        "  %return_type_node = phi %kizu.kizu.ast.node_id [ %return_empty, %no_return_type ], [ %return_type, %return_type_ok ]");
    try append_line(out,
        "  %body_token = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %body_index)");
    try append_line(out, "  %body_kind = extractvalue %kizu.kizu.lexer.token %body_token, 0");
    try append_line(out, "  %body_is_lbrace = icmp eq i64 %body_kind, 29");
    try append_line(out, "  br i1 %body_is_lbrace, label %parse_body, label %fail");
    try append_line(out, "parse_body:");
    try append_line(out,
        "  %body_result = call %kizu.selfhost.cli.parse_node_result @kizu_selfhost__cli_parse_block(%kizu.owned %allocator, %kizu.kizu.ast.ast %ast, %kizu.slice.u8 %source, %kizu.owned %tokens, i64 %body_index)");
    try append_line(out, "  %body_ok = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 0");
    try append_line(out, "  br i1 %body_ok, label %build, label %fail");
    try append_line(out, "build:");
    try append_line(out, "  %body_next = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 1");
    try append_line(out, "  %body_node = extractvalue %kizu.selfhost.cli.parse_node_result %body_result, 2");
    try append_line(out, "  %name_start = extractvalue %kizu.kizu.lexer.token %name_token, 1");
    try append_line(out, "  %name_end = extractvalue %kizu.kizu.lexer.token %name_token, 2");
    try append_line(out,
        "  %name_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %name_start, i64 %name_end, i64 4)");
    try append_line(out, "  %fn_start = extractvalue %kizu.kizu.lexer.token %fn_token, 1");
    try append_line(out, "  %body_close_index = sub i64 %body_next, 1");
    try append_line(out,
        "  %body_close = call %kizu.kizu.lexer.token @kizu_selfhost__cli_token_at(%kizu.owned %tokens, i64 %body_close_index)");
    try append_line(out, "  %fn_end = extractvalue %kizu.kizu.lexer.token %body_close, 2");
    try append_line(out,
        "  %empty = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_leaf_node(%kizu.kizu.ast.ast %ast, i64 %fn_start, i64 %fn_start, i64 44)");
    try append_line(out,
        "  %fn_node = call %kizu.kizu.ast.node_id @kizu_selfhost__cli_add_fn_decl(%kizu.kizu.ast.ast %ast, i64 %fn_start, i64 %fn_end, %kizu.kizu.ast.node_id %name_node, i64 %param_start, i64 %param_len, %kizu.kizu.ast.node_id %return_type_node, %kizu.kizu.ast.node_id %empty, %kizu.kizu.ast.node_id %body_node)");
    try append_line(out,
        "  %ok0 = insertvalue %kizu.selfhost.cli.parse_node_result zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %ok1 = insertvalue %kizu.selfhost.cli.parse_node_result %ok0, i64 %body_next, 1");
    try append_line(out,
        "  %ok2 = insertvalue %kizu.selfhost.cli.parse_node_result %ok1, %kizu.kizu.ast.node_id %fn_node, 2");
