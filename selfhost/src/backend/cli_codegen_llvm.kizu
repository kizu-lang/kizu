fn append_codegen_parse_checked_run_ast_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.run_ast @kizu_selfhost__cli_codegen_parse_checked_run_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %void_body_start = call i64 @kizu_selfhost__cli_run_void_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_void_body = icmp sge i64 %void_body_start, 0");
    try append_line(out, "  br i1 %has_void_body, label %body_known, label %check_regular_main");
    try append_line(out, "check_regular_main:");
    try append_line(out,
        "  %regular_body_start = call i64 @kizu_selfhost__cli_run_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_regular_body = icmp sge i64 %regular_body_start, 0");
    try append_line(out, "  br i1 %has_regular_body, label %body_known, label %unsupported");
    try append_line(out, "body_known:");
    try append_line(out,
        "  %body_start = phi i64 [ %void_body_start, %entry ], [ %regular_body_start, %check_regular_main ]");
    try append_line(out,
        "  %first_binding = call %kizu.selfhost.codegen.binding @kizu_selfhost__cli_codegen_parse_let_binding(%kizu.slice.u8 %source, i64 %body_start)");
    try append_line(out, "  %first_binding_ok = extractvalue %kizu.selfhost.codegen.binding %first_binding, 0");
    try append_line(out, "  br i1 %first_binding_ok, label %after_first_binding, label %direct_print");
    try append_line(out, "direct_print:");
    try append_line(out, "  %empty_slice = insertvalue %kizu.slice.u8 zeroinitializer, i64 0, 1");
    try append_line(out,
        "  %direct_payload = call %kizu.selfhost.codegen.payload @kizu_selfhost__cli_codegen_parse_print_statement(%kizu.slice.u8 %source, i64 %body_start, i1 false, %kizu.slice.u8 %empty_slice, %kizu.slice.u8 %empty_slice, i1 false, %kizu.slice.u8 %empty_slice, %kizu.slice.u8 %empty_slice)");
    try append_line(out, "  br label %finish_payload");
    try append_line(out, "after_first_binding:");
    try append_line(out, "  %first_name = extractvalue %kizu.selfhost.codegen.binding %first_binding, 1");
    try append_line(out, "  %first_payload = extractvalue %kizu.selfhost.codegen.binding %first_binding, 2");
    try append_line(out, "  %first_next = extractvalue %kizu.selfhost.codegen.binding %first_binding, 3");
    try append_line(out,
        "  %second_binding = call %kizu.selfhost.codegen.binding @kizu_selfhost__cli_codegen_parse_let_binding(%kizu.slice.u8 %source, i64 %first_next)");
    try append_line(out, "  %second_binding_ok = extractvalue %kizu.selfhost.codegen.binding %second_binding, 0");
    try append_line(out, "  br i1 %second_binding_ok, label %after_second_binding, label %first_local_print");
    try append_line(out, "first_local_print:");
    try append_line(out,
        "  %first_local_payload = call %kizu.selfhost.codegen.payload @kizu_selfhost__cli_codegen_parse_print_statement(%kizu.slice.u8 %source, i64 %first_next, i1 true, %kizu.slice.u8 %first_name, %kizu.slice.u8 %first_payload, i1 false, %kizu.slice.u8 %first_name, %kizu.slice.u8 %first_payload)");
    try append_line(out, "  br label %finish_payload");
    try append_line(out, "after_second_binding:");
    try append_line(out, "  %second_name = extractvalue %kizu.selfhost.codegen.binding %second_binding, 1");
    try append_line(out, "  %second_payload = extractvalue %kizu.selfhost.codegen.binding %second_binding, 2");
    try append_line(out, "  %second_next = extractvalue %kizu.selfhost.codegen.binding %second_binding, 3");
    try append_line(out,
        "  %duplicate_local = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %first_name, %kizu.slice.u8 %second_name)");
    try append_line(out, "  br i1 %duplicate_local, label %unsupported, label %second_local_print");
    try append_line(out, "second_local_print:");
    try append_line(out,
        "  %second_local_payload = call %kizu.selfhost.codegen.payload @kizu_selfhost__cli_codegen_parse_print_statement(%kizu.slice.u8 %source, i64 %second_next, i1 true, %kizu.slice.u8 %first_name, %kizu.slice.u8 %first_payload, i1 true, %kizu.slice.u8 %second_name, %kizu.slice.u8 %second_payload)");
    try append_line(out, "  br label %finish_payload");
    try append_line(out, "finish_payload:");
    try append_line(out,
        "  %payload_result = phi %kizu.selfhost.codegen.payload [ %direct_payload, %direct_print ], [ %first_local_payload, %first_local_print ], [ %second_local_payload, %second_local_print ]");
    try append_line(out, "  %payload_ok = extractvalue %kizu.selfhost.codegen.payload %payload_result, 0");
    try append_line(out, "  br i1 %payload_ok, label %return_ast, label %unsupported");
    try append_line(out, "return_ast:");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.codegen.payload %payload_result, 1");
    try append_global_slice(out, "main", "codegen_main", 4);
    try append_global_slice(out, "print", "codegen_print", 5);
    try append_line(out, "  %ast0 = insertvalue %kizu.selfhost.codegen.run_ast zeroinitializer, i1 true, 0");
    try append_line(out, "  %ast1 = insertvalue %kizu.selfhost.codegen.run_ast %ast0, i64 1, 1");
    try append_line(out, "  %ast2 = insertvalue %kizu.selfhost.codegen.run_ast %ast1, %kizu.slice.u8 %main_slice, 2");
    try append_line(out, "  %ast3 = insertvalue %kizu.selfhost.codegen.run_ast %ast2, i64 1, 3");
    try append_line(out, "  %ast4 = insertvalue %kizu.selfhost.codegen.run_ast %ast3, i64 1, 4");
    try append_line(out, "  %ast5 = insertvalue %kizu.selfhost.codegen.run_ast %ast4, i64 1, 5");
    try append_line(out, "  %ast6 = insertvalue %kizu.selfhost.codegen.run_ast %ast5, %kizu.slice.u8 %print_slice, 6");
    try append_line(out, "  %ast7 = insertvalue %kizu.selfhost.codegen.run_ast %ast6, i64 1, 7");
    try append_line(out, "  %ast8 = insertvalue %kizu.selfhost.codegen.run_ast %ast7, %kizu.slice.u8 %payload, 8");
    try append_line(out, "  ret %kizu.selfhost.codegen.run_ast %ast8");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret %kizu.selfhost.codegen.run_ast zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_codegen_lower_run_ast_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_run_ast(");
    try append_line(out, "  %kizu.selfhost.codegen.run_ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "main", "codegen_main", 4);
    try append_global_slice(out, "print", "codegen_print", 5);
    try append_line(out, "  %ok = extractvalue %kizu.selfhost.codegen.run_ast %ast, 0");
    try append_line(out, "  %function_count = extractvalue %kizu.selfhost.codegen.run_ast %ast, 1");
    try append_line(out, "  %function_name = extractvalue %kizu.selfhost.codegen.run_ast %ast, 2");
    try append_line(out, "  %block_count = extractvalue %kizu.selfhost.codegen.run_ast %ast, 3");
    try append_line(out, "  %statement_count = extractvalue %kizu.selfhost.codegen.run_ast %ast, 4");
    try append_line(out, "  %final_kind = extractvalue %kizu.selfhost.codegen.run_ast %ast, 5");
    try append_line(out, "  %callee = extractvalue %kizu.selfhost.codegen.run_ast %ast, 6");
    try append_line(out, "  %arg_kind = extractvalue %kizu.selfhost.codegen.run_ast %ast, 7");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.codegen.run_ast %ast, 8");
    try append_line(out, "  %one_function = icmp eq i64 %function_count, 1");
    try append_line(out, "  %main_name = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %function_name, %kizu.slice.u8 %main_slice)");
    try append_line(out, "  %one_block = icmp eq i64 %block_count, 1");
    try append_line(out, "  %has_statement = icmp sge i64 %statement_count, 1");
    try append_line(out, "  %print_statement = icmp eq i64 %final_kind, 1");
    try append_line(out, "  %print_callee = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %callee, %kizu.slice.u8 %print_slice)");
    try append_line(out, "  %const_arg = icmp eq i64 %arg_kind, 1");
    try append_line(out, "  %shape_01 = and i1 %ok, %one_function");
    try append_line(out, "  %shape_02 = and i1 %shape_01, %main_name");
    try append_line(out, "  %shape_03 = and i1 %shape_02, %one_block");
    try append_line(out, "  %shape_04 = and i1 %shape_03, %has_statement");
    try append_line(out, "  %shape_05 = and i1 %shape_04, %print_statement");
    try append_line(out, "  %shape_06 = and i1 %shape_05, %print_callee");
