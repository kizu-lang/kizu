    try append_line(out, "define %kizu.selfhost.codegen.value @kizu_selfhost__cli_codegen_const_string_value(");
    try append_line(out, "  %kizu.slice.u8 %name,");
    try append_line(out, "  %kizu.slice.u8 %payload");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %field0 = insertvalue %kizu.selfhost.codegen.value poison, i64 1, 0");
    try append_line(out, "  %field1 = insertvalue %kizu.selfhost.codegen.value %field0, %kizu.slice.u8 %name, 1");
    try append_line(out, "  %field2 = insertvalue %kizu.selfhost.codegen.value %field1, %kizu.slice.u8 %payload, 2");
    try append_line(out, "  ret %kizu.selfhost.codegen.value %field2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_codegen_const_string_instruction_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.instruction @kizu_selfhost__cli_codegen_const_string_instruction(");
    try append_line(out, "  %kizu.selfhost.codegen.value %value");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %kind = extractvalue %kizu.selfhost.codegen.value %value, 0");
    try append_line(out, "  %name = extractvalue %kizu.selfhost.codegen.value %value, 1");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.codegen.value %value, 2");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 zeroinitializer, i64 0, 1");
    try append_line(out, "  %field0 = insertvalue %kizu.selfhost.codegen.instruction poison, i64 1, 0");
    try append_line(out, "  %field1 = insertvalue %kizu.selfhost.codegen.instruction %field0, i64 %kind, 1");
    try append_line(out, "  %field2 = insertvalue %kizu.selfhost.codegen.instruction %field1, %kizu.slice.u8 %name, 2");
    try append_line(out, "  %field3 = insertvalue %kizu.selfhost.codegen.instruction %field2, %kizu.slice.u8 %payload, 3");
    try append_line(out, "  %field4 = insertvalue %kizu.selfhost.codegen.instruction %field3, %kizu.slice.u8 %empty, 4");
    try append_line(out, "  %field5 = insertvalue %kizu.selfhost.codegen.instruction %field4, i64 0, 5");
    try append_line(out, "  %field6 = insertvalue %kizu.selfhost.codegen.instruction %field5, %kizu.slice.u8 %empty, 6");
    try append_line(out, "  %field7 = insertvalue %kizu.selfhost.codegen.instruction %field6, %kizu.slice.u8 %empty, 7");
    try append_line(out, "  ret %kizu.selfhost.codegen.instruction %field7");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_codegen_call_instruction_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.instruction @kizu_selfhost__cli_codegen_call_instruction(");
    try append_line(out, "  %kizu.slice.u8 %callee,");
    try append_line(out, "  %kizu.selfhost.codegen.value %argument");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %argument_kind = extractvalue %kizu.selfhost.codegen.value %argument, 0");
    try append_line(out, "  %argument_name = extractvalue %kizu.selfhost.codegen.value %argument, 1");
    try append_line(out, "  %argument_payload = extractvalue %kizu.selfhost.codegen.value %argument, 2");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 zeroinitializer, i64 0, 1");
    try append_line(out, "  %field0 = insertvalue %kizu.selfhost.codegen.instruction poison, i64 2, 0");
    try append_line(out, "  %field1 = insertvalue %kizu.selfhost.codegen.instruction %field0, i64 0, 1");
    try append_line(out, "  %field2 = insertvalue %kizu.selfhost.codegen.instruction %field1, %kizu.slice.u8 %empty, 2");
    try append_line(out, "  %field3 = insertvalue %kizu.selfhost.codegen.instruction %field2, %kizu.slice.u8 %empty, 3");
    try append_line(out, "  %field4 = insertvalue %kizu.selfhost.codegen.instruction %field3, %kizu.slice.u8 %callee, 4");
    try append_line(out, "  %field5 = insertvalue %kizu.selfhost.codegen.instruction %field4, i64 %argument_kind, 5");
    try append_line(out, "  %field6 = insertvalue %kizu.selfhost.codegen.instruction %field5, %kizu.slice.u8 %argument_name, 6");
    try append_line(out, "  %field7 = insertvalue %kizu.selfhost.codegen.instruction %field6, %kizu.slice.u8 %argument_payload, 7");
    try append_line(out, "  ret %kizu.selfhost.codegen.instruction %field7");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

