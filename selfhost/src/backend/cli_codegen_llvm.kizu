import selfhost::backend::ir_contract;

pub fn append_globals(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_llvm_constant_from_metadata_line_body(
        out,
        "codegen_metadata_line",
        ir_bytes
    );
    try append_build_main_print_string_constant(out, "codegen_main", ir_bytes, "CodegenFunction", "name");
    try append_build_main_print_string_constant(out, "codegen_entry", ir_bytes, "CodegenBlock", "label");
    try append_build_main_print_call_string_constant(
        out,
        "codegen_s0",
        ir_bytes,
        "const_string_value",
        0,
        0
    );
    try append_build_main_print_call_string_constant(
        out,
        "codegen_print",
        ir_bytes,
        "call_instruction",
        0,
        0
    );
    return;
}

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_codegen_metadata_line_function(out, ir_bytes);
    try append_codegen_const_string_value_function(out, ir_bytes);
    try append_codegen_const_string_instruction_function(out, ir_bytes);
    try append_codegen_call_instruction_function(out, ir_bytes);
    try append_codegen_return_void_instruction_function(out, ir_bytes);
    try append_codegen_build_main_print_program_function(out, ir_bytes);
    try append_codegen_lowered_main_print_program_function(out);
    try append_codegen_lower_run_ast_function(out);
    try append_codegen_program_supported_function(out);
    try append_codegen_stdout_payload_function(out);
    try append_codegen_payload_llvm_c_string_function(out);
    return;
}

fn metadata_line_token_from_body(ir_bytes: []u8) -> ![]u8 {
    let function_name = "selfhost::ir::codegen::metadata_line";
    let statement = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        0,
        "statement",
        0
    );
    let statement_kind = try ir_contract::body_node_kind(ir_bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("invalid metadata_line body");
    }
    let value = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        statement,
        "value",
        0
    );
    let value_kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "String") {
        return error("invalid metadata_line body");
    }
    return try ir_contract::body_token_or_empty(ir_bytes, function_name, value);
}

pub fn metadata_line_body_decoded_len(ir_bytes: []u8) -> !i64 {
    let token = try metadata_line_token_from_body(ir_bytes);
    let token_len = std::mem::len(token);
    if token_len >= 4 and std::mem::equal_bytes(token[0..4], "hex:") {
        let decoded_len = try hex_token_decoded_len(token);
        if decoded_len < 2 {
            return error("invalid metadata_line body");
        }
        if try hex_pair_byte(token, 4) != cast<u8>(34) or
            try hex_pair_byte(token, token_len - 2) != cast<u8>(34) {
            return error("invalid metadata_line body");
        }
        return decoded_len - 2;
    }
    if token_len < 2 or token[0] != cast<u8>(34) or token[token_len - 1] != cast<u8>(34) {
        return error("invalid metadata_line body");
    }
    return token_len - 2;
}

pub fn append_metadata_line_body_payload(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let token = try metadata_line_token_from_body(ir_bytes);
    let token_len = std::mem::len(token);
    if token_len >= 4 and std::mem::equal_bytes(token[0..4], "hex:") {
        try append_hex_token_payload_without_quotes(out, token);
        return;
    }
    if token_len < 2 or token[0] != cast<u8>(34) or token[token_len - 1] != cast<u8>(34) {
        return error("invalid metadata_line body");
    }
    try append_llvm_c_string_payload(out, token[1..token_len - 1]);
    return;
}

fn append_codegen_metadata_line_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let metadata_len = try metadata_line_body_decoded_len(ir_bytes);
    try append_line(out, "define %kizu.slice.u8 @kizu_selfhost__ir_codegen_metadata_line() {");
    try append_line(out, "entry:");
    try append_global_slice(
        out,
        "metadata_line",
        "codegen_metadata_line",
        metadata_len
    );
    try append_line(out, "  ret %kizu.slice.u8 %metadata_line_slice");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_llvm_constant_from_metadata_line_body(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8
) -> !void {
    let size = try metadata_line_body_decoded_len(ir_bytes);
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try append_metadata_line_body_payload(out, ir_bytes);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_hex_token_payload_without_quotes(out: &var std::string::String, token: []u8) -> !void {
    let decoded_len = try hex_token_decoded_len(token);
    if decoded_len < 2 {
        return error("invalid metadata_line body");
    }
    var index = 0;
    while index < decoded_len {
        let byte = try hex_pair_byte(token, 4 + index * 2);
        if index == 0 or index + 1 == decoded_len {
            if byte != cast<u8>(34) {
                return error("invalid metadata_line body");
            }
        } else {
            try append_llvm_c_string_byte(out, byte);
        }
        index = index + 1;
    }
    return;
}

fn hex_token_decoded_len(token: []u8) -> !i64 {
    let token_len = std::mem::len(token);
    if token_len < 4 or !std::mem::equal_bytes(token[0..4], "hex:") {
        return error("invalid metadata_line body");
    }
    let hex_len = token_len - 4;
    if hex_len < 2 or (hex_len / 2) * 2 != hex_len {
        return error("invalid metadata_line body");
    }
    return hex_len / 2;
}

fn hex_pair_byte(token: []u8, index: i64) -> !u8 {
    let high = try hex_digit_value(token[index]);
    let low = try hex_digit_value(token[index + 1]);
    return cast<u8>(high * 16 + low);
}

fn hex_digit_value(byte: u8) -> !i64 {
    if byte >= cast<u8>(48) and byte <= cast<u8>(57) {
        return cast<i64>(byte - cast<u8>(48));
    }
    if byte >= cast<u8>(65) and byte <= cast<u8>(70) {
        return cast<i64>(byte - cast<u8>(55));
    }
    if byte >= cast<u8>(97) and byte <= cast<u8>(102) {
        return cast<i64>(byte - cast<u8>(87));
    }
    return error("invalid metadata_line body");
}

fn append_codegen_lowered_main_print_program_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lowered_main_print_program(");
    try append_line(out, "  %kizu.slice.u8 %payload");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %program = call %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_build_main_print_program(%kizu.slice.u8 %payload, i1 true)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %program");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_codegen_build_main_print_program_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let function_block_count = try build_main_print_program_int_field(
        ir_bytes,
        "CodegenFunction",
        "block_count"
    );
    let block_instruction_count = try build_main_print_program_int_field(
        ir_bytes,
        "CodegenBlock",
        "instruction_count"
    );
    let function_count = try build_main_print_program_int_field(
        ir_bytes,
        "Program",
        "function_count"
    );
    let main_len = try string_token_decoded_len(
        try build_main_print_program_string_field(ir_bytes, "CodegenFunction", "name"),
        "invalid build_main_print_program body"
    );
    let entry_len = try string_token_decoded_len(
        try build_main_print_program_string_field(ir_bytes, "CodegenBlock", "label"),
        "invalid build_main_print_program body"
    );
    let s0_len = try string_token_decoded_len(
        try build_main_print_program_call_string_arg(ir_bytes, "const_string_value", 0, 0),
        "invalid build_main_print_program body"
    );
    let print_len = try string_token_decoded_len(
        try build_main_print_program_call_string_arg(ir_bytes, "call_instruction", 0, 0),
        "invalid build_main_print_program body"
    );
    try require_build_main_print_program_call(ir_bytes, "const_string_value", 0);
    try require_build_main_print_program_call(ir_bytes, "const_string_instruction", 0);
    try require_build_main_print_program_call(ir_bytes, "const_string_value", 1);
    try require_build_main_print_program_call(ir_bytes, "call_instruction", 0);
    try require_build_main_print_program_call(ir_bytes, "return_void_instruction", 0);
    try require_build_main_print_program_var_field(ir_bytes, "from_codegen_lowering", "from_codegen_lowering");
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_build_main_print_program(");
    try append_line(out, "  %kizu.slice.u8 %payload,");
    try append_line(out, "  i1 %from_codegen_lowering");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "main", "codegen_main", main_len);
    try append_global_slice(out, "entry", "codegen_entry", entry_len);
    try append_global_slice(out, "s0", "codegen_s0", s0_len);
    try append_global_slice(out, "print", "codegen_print", print_len);
    try append_line(out,
        "  %function0 = insertvalue %kizu.selfhost.codegen.function poison, %kizu.slice.u8 %main_slice, 0");
    try out.append_bytes("  %function = insertvalue %kizu.selfhost.codegen.function %function0, i64 ");
    try std::fmt::append_i64(out, function_block_count);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try append_line(out,
        "  %block0 = insertvalue %kizu.selfhost.codegen.block poison, %kizu.slice.u8 %entry_slice, 0");
    try out.append_bytes("  %block = insertvalue %kizu.selfhost.codegen.block %block0, i64 ");
    try std::fmt::append_i64(out, block_instruction_count);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try append_line(out,
        "  %value = call %kizu.selfhost.codegen.value @kizu_selfhost__cli_codegen_const_string_value(%kizu.slice.u8 %s0_slice, %kizu.slice.u8 %payload)");
    try append_line(out,
        "  %first = call %kizu.selfhost.codegen.instruction @kizu_selfhost__cli_codegen_const_string_instruction(%kizu.selfhost.codegen.value %value)");
    try append_line(out,
        "  %argument = call %kizu.selfhost.codegen.value @kizu_selfhost__cli_codegen_const_string_value(%kizu.slice.u8 %s0_slice, %kizu.slice.u8 %payload)");
    try append_line(out,
        "  %second = call %kizu.selfhost.codegen.instruction @kizu_selfhost__cli_codegen_call_instruction(%kizu.slice.u8 %print_slice, %kizu.selfhost.codegen.value %argument)");
    try append_line(out,
        "  %third = call %kizu.selfhost.codegen.instruction @kizu_selfhost__cli_codegen_return_void_instruction()");
    try append_line(out, "  %function_name = extractvalue %kizu.selfhost.codegen.function %function, 0");
    try append_line(out, "  %function_block_count = extractvalue %kizu.selfhost.codegen.function %function, 1");
    try append_line(out, "  %block_label = extractvalue %kizu.selfhost.codegen.block %block, 0");
    try append_line(out, "  %block_instruction_count = extractvalue %kizu.selfhost.codegen.block %block, 1");
    try append_line(out, "  %first_kind = extractvalue %kizu.selfhost.codegen.instruction %first, 0");
    try append_line(out, "  %first_result_kind = extractvalue %kizu.selfhost.codegen.instruction %first, 1");
    try append_line(out, "  %first_result_name = extractvalue %kizu.selfhost.codegen.instruction %first, 2");
    try append_line(out, "  %first_result_payload = extractvalue %kizu.selfhost.codegen.instruction %first, 3");
    try append_line(out, "  %second_kind = extractvalue %kizu.selfhost.codegen.instruction %second, 0");
    try append_line(out, "  %second_callee = extractvalue %kizu.selfhost.codegen.instruction %second, 4");
    try append_line(out, "  %second_argument_kind = extractvalue %kizu.selfhost.codegen.instruction %second, 5");
    try append_line(out, "  %second_argument_name = extractvalue %kizu.selfhost.codegen.instruction %second, 6");
    try append_line(out, "  %second_argument_payload = extractvalue %kizu.selfhost.codegen.instruction %second, 7");
    try append_line(out, "  %third_kind = extractvalue %kizu.selfhost.codegen.instruction %third, 0");
    try out.append_bytes("  %field0 = insertvalue %kizu.selfhost.codegen.program poison, i64 ");
    try std::fmt::append_i64(out, function_count);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %field1 = insertvalue %kizu.selfhost.codegen.program %field0, %kizu.slice.u8 %function_name, 1");
    try append_line(out, "  %field2 = insertvalue %kizu.selfhost.codegen.program %field1, i64 %function_block_count, 2");
    try append_line(out, "  %field3 = insertvalue %kizu.selfhost.codegen.program %field2, %kizu.slice.u8 %block_label, 3");
    try append_line(out, "  %field4 = insertvalue %kizu.selfhost.codegen.program %field3, i64 %block_instruction_count, 4");
    try append_line(out, "  %field5 = insertvalue %kizu.selfhost.codegen.program %field4, i64 %first_kind, 5");
    try append_line(out, "  %field6 = insertvalue %kizu.selfhost.codegen.program %field5, i64 %first_result_kind, 6");
    try append_line(out, "  %field7 = insertvalue %kizu.selfhost.codegen.program %field6, %kizu.slice.u8 %first_result_name, 7");
    try append_line(out, "  %field8 = insertvalue %kizu.selfhost.codegen.program %field7, %kizu.slice.u8 %first_result_payload, 8");
    try append_line(out, "  %field9 = insertvalue %kizu.selfhost.codegen.program %field8, i64 %second_kind, 9");
    try append_line(out, "  %field10 = insertvalue %kizu.selfhost.codegen.program %field9, %kizu.slice.u8 %second_callee, 10");
    try append_line(out, "  %field11 = insertvalue %kizu.selfhost.codegen.program %field10, i64 %second_argument_kind, 11");
    try append_line(out, "  %field12 = insertvalue %kizu.selfhost.codegen.program %field11, %kizu.slice.u8 %second_argument_name, 12");
    try append_line(out, "  %field13 = insertvalue %kizu.selfhost.codegen.program %field12, %kizu.slice.u8 %second_argument_payload, 13");
    try append_line(out, "  %field14 = insertvalue %kizu.selfhost.codegen.program %field13, i64 %third_kind, 14");
    try append_line(out, "  %field15 = insertvalue %kizu.selfhost.codegen.program %field14, i1 %from_codegen_lowering, 15");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %field15");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_build_main_print_string_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    type_name: []u8,
    field_name: []u8
) -> !void {
    let token = try build_main_print_program_string_field(ir_bytes, type_name, field_name);
    try append_llvm_constant_from_string_token(out, name, token, "invalid build_main_print_program body");
    return;
}

fn append_build_main_print_call_string_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    callee: []u8,
    call_ordinal: i64,
    arg_ordinal: i64
) -> !void {
    let token = try build_main_print_program_call_string_arg(
        ir_bytes,
        callee,
        call_ordinal,
        arg_ordinal
    );
    try append_llvm_constant_from_string_token(out, name, token, "invalid build_main_print_program body");
    return;
}

fn append_llvm_constant_from_string_token(
    out: &var std::string::String,
    name: []u8,
    token: []u8,
    error_message: []u8
) -> !void {
    let size = try string_token_decoded_len(token, error_message);
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try append_string_token_payload(out, token, error_message);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn string_token_decoded_len(token: []u8, error_message: []u8) -> !i64 {
    let token_len = std::mem::len(token);
    if token_len < 2 or token[0] != cast<u8>(34) or token[token_len - 1] != cast<u8>(34) {
        return error(error_message);
    }
    return token_len - 2;
}

fn append_string_token_payload(
    out: &var std::string::String,
    token: []u8,
    error_message: []u8
) -> !void {
    let token_len = std::mem::len(token);
    if token_len < 2 or token[0] != cast<u8>(34) or token[token_len - 1] != cast<u8>(34) {
        return error(error_message);
    }
    try append_llvm_c_string_payload(out, token[1..token_len - 1]);
    return;
}

fn build_main_print_program_string_field(
    ir_bytes: []u8,
    type_name: []u8,
    field_name: []u8
) -> ![]u8 {
    let function_name = "selfhost::ir::codegen::build_main_print_program";
    let literal = try ir_contract::body_struct_literal_of_type(ir_bytes, function_name, type_name, 0);
    let value = try ir_contract::body_struct_field_value(ir_bytes, function_name, literal, field_name);
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(kind, "String") {
        return error("invalid build_main_print_program body");
    }
    return try ir_contract::body_token_or_empty(ir_bytes, function_name, value);
}

fn build_main_print_program_int_field(
    ir_bytes: []u8,
    type_name: []u8,
    field_name: []u8
) -> !i64 {
    let function_name = "selfhost::ir::codegen::build_main_print_program";
    let literal = try ir_contract::body_struct_literal_of_type(ir_bytes, function_name, type_name, 0);
    let value = try ir_contract::body_struct_field_value(ir_bytes, function_name, literal, field_name);
    return try ir_contract::body_int_value(ir_bytes, function_name, value);
}

fn build_main_print_program_call_string_arg(
    ir_bytes: []u8,
    callee: []u8,
    call_ordinal: i64,
    arg_ordinal: i64
) -> ![]u8 {
    let function_name = "selfhost::ir::codegen::build_main_print_program";
    let call = try build_main_print_program_call_sequence(ir_bytes, callee, call_ordinal);
    let arg = try ir_contract::body_child_sequence(ir_bytes, function_name, call, "arg", arg_ordinal);
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, arg);
    if !std::mem::equal_bytes(kind, "String") {
        return error("invalid build_main_print_program body");
    }
    return try ir_contract::body_token_or_empty(ir_bytes, function_name, arg);
}

fn require_build_main_print_program_call(
    ir_bytes: []u8,
    callee: []u8,
    call_ordinal: i64
) -> !void {
    let ignored = try build_main_print_program_call_sequence(ir_bytes, callee, call_ordinal);
    return;
}

fn build_main_print_program_call_sequence(
    ir_bytes: []u8,
    callee: []u8,
    call_ordinal: i64
) -> !i64 {
    let function_name = "selfhost::ir::codegen::build_main_print_program";
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    var matched = 0;
    while sequence < count {
        let actual = try ir_contract::body_call_callee_or_empty(ir_bytes, function_name, sequence);
        if std::mem::equal_bytes(actual, callee) {
            if matched == call_ordinal {
                return sequence;
            }
            matched = matched + 1;
        }
        sequence = sequence + 1;
    }
    return error("invalid build_main_print_program body");
}

fn require_build_main_print_program_var_field(
    ir_bytes: []u8,
    field_name: []u8,
    expected_var: []u8
) -> !void {
    let function_name = "selfhost::ir::codegen::build_main_print_program";
    let literal = try ir_contract::body_struct_literal_of_type(ir_bytes, function_name, "Program", 0);
    let value = try ir_contract::body_struct_field_value(ir_bytes, function_name, literal, field_name);
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(kind, "Var") {
        return error("invalid build_main_print_program body");
    }
    let actual = try ir_contract::body_token_or_empty(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(actual, expected_var) {
        return error("invalid build_main_print_program body");
    }
    return;
}

fn append_codegen_const_string_value_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    let kind_tag = try const_string_value_kind_tag_from_body(ir_bytes);
    try require_const_string_value_var_field(ir_bytes, "name", "name");
    try require_const_string_value_var_field(ir_bytes, "string_payload", "payload");
    try append_line(out, "define %kizu.selfhost.codegen.value @kizu_selfhost__cli_codegen_const_string_value(");
    try append_line(out, "  %kizu.slice.u8 %name,");
    try append_line(out, "  %kizu.slice.u8 %payload");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try out.append_bytes("  %field0 = insertvalue %kizu.selfhost.codegen.value poison, i64 ");
    try std::fmt::append_i64(out, kind_tag);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %field1 = insertvalue %kizu.selfhost.codegen.value %field0, %kizu.slice.u8 %name, 1");
    try append_line(out, "  %field2 = insertvalue %kizu.selfhost.codegen.value %field1, %kizu.slice.u8 %payload, 2");
    try append_line(out, "  ret %kizu.selfhost.codegen.value %field2");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn const_string_value_kind_tag_from_body(ir_bytes: []u8) -> !i64 {
    let function_name = "selfhost::ir::codegen::const_string_value";
    let literal = try const_string_value_return_literal(ir_bytes);
    let value = try ir_contract::body_struct_field_value(ir_bytes, function_name, literal, "kind");
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(kind, "FieldExpr") {
        return error("invalid const_string_value body");
    }
    let receiver = try ir_contract::body_child_sequence(ir_bytes, function_name, value, "receiver", 0);
    let receiver_name = try ir_contract::body_token_or_empty(ir_bytes, function_name, receiver);
    let variant = try ir_contract::body_field_expr_name(ir_bytes, function_name, value, "namespace");
    if !std::mem::equal_bytes(receiver_name, "ValueKind") or
        !std::mem::equal_bytes(variant, "ConstString") {
        return error("invalid const_string_value body");
    }
    return try ir_contract::enum_variant_tag(
        ir_bytes,
        "selfhost::ir::codegen::ValueKind",
        variant
    );
}

