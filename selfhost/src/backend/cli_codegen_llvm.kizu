fn append_codegen_string_payload_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.payload @kizu_selfhost__cli_codegen_string_payload(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %length = sub i64 %end, %start");
    try append_line(out, "  %long_enough = icmp sge i64 %length, 2");
    try append_line(out, "  br i1 %long_enough, label %check_quotes, label %unsupported");
    try append_line(out, "check_quotes:");
    try append_line(out, "  %first_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %first = load i8, ptr %first_ptr");
    try append_line(out, "  %last_index = sub i64 %end, 1");
    try append_line(out, "  %last_ptr = getelementptr i8, ptr %source_ptr, i64 %last_index");
    try append_line(out, "  %last = load i8, ptr %last_ptr");
    try append_line(out, "  %first_quote = icmp eq i8 %first, 34");
    try append_line(out, "  %last_quote = icmp eq i8 %last, 34");
    try append_line(out, "  %quoted = and i1 %first_quote, %last_quote");
    try append_line(out, "  br i1 %quoted, label %return_payload, label %unsupported");
    try append_line(out, "return_payload:");
    try append_line(out, "  %payload_start = add i64 %start, 1");
    try append_line(out, "  %payload_len = sub i64 %length, 2");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %source_ptr, i64 %payload_start");
    try append_line(out, "  %payload_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload = insertvalue %kizu.slice.u8 %payload_base, i64 %payload_len, 1");
    try append_line(out, "  %ok0 = insertvalue %kizu.selfhost.codegen.payload zeroinitializer, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.selfhost.codegen.payload %ok0, %kizu.slice.u8 %payload, 1");
    try append_line(out, "  %result = insertvalue %kizu.selfhost.codegen.payload %ok1, i64 %end, 2");
    try append_line(out, "  ret %kizu.selfhost.codegen.payload %result");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret %kizu.selfhost.codegen.payload zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

