    try append_line(out, "  %field3 = insertvalue %kizu.selfhost.codegen.instruction %field2, %kizu.slice.u8 %empty, 3");
    try append_line(out, "  %field4 = insertvalue %kizu.selfhost.codegen.instruction %field3, %kizu.slice.u8 %empty, 4");
    try out.append_bytes("  %field5 = insertvalue %kizu.selfhost.codegen.instruction %field4, i64 ");
    try std::fmt::append_i64(out, none_tag);
    try out.append_bytes(", 5");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %field6 = insertvalue %kizu.selfhost.codegen.instruction %field5, %kizu.slice.u8 %empty, 6");
    try append_line(out, "  %field7 = insertvalue %kizu.selfhost.codegen.instruction %field6, %kizu.slice.u8 %empty, 7");
    try append_line(out, "  ret %kizu.selfhost.codegen.instruction %field7");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn return_void_instruction_kind_tag_from_body(ir_bytes: []u8) -> !i64 {
    let variant = try return_void_instruction_namespace_field(
        ir_bytes,
        "kind",
        "InstructionKind",
        "ReturnVoid"
    );
    return try ir_contract::enum_variant_tag(
        ir_bytes,
        "selfhost::ir::codegen::InstructionKind",
        variant
    );
}

fn return_void_instruction_none_tag_from_body(ir_bytes: []u8) -> !i64 {
    let result_kind = try return_void_instruction_namespace_field(
        ir_bytes,
        "result_kind",
        "ValueKind",
        "None"
    );
    let argument_kind = try return_void_instruction_namespace_field(
        ir_bytes,
        "argument_kind",
        "ValueKind",
        "None"
    );
    if !std::mem::equal_bytes(result_kind, argument_kind) {
        return error("invalid return_void_instruction body");
    }
    return try ir_contract::enum_variant_tag(
        ir_bytes,
        "selfhost::ir::codegen::ValueKind",
        result_kind
    );
}

fn return_void_instruction_namespace_field(
    ir_bytes: []u8,
    field_name: []u8,
    expected_receiver: []u8,
    expected_variant: []u8
) -> ![]u8 {
    let function_name = "selfhost::ir::codegen::return_void_instruction";
    let literal = try return_void_instruction_return_literal(ir_bytes);
    let value = try ir_contract::body_struct_field_value(ir_bytes, function_name, literal, field_name);
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(kind, "FieldExpr") {
        return error("invalid return_void_instruction body");
    }
    let receiver = try ir_contract::body_child_sequence(ir_bytes, function_name, value, "receiver", 0);
    let receiver_name = try ir_contract::body_token_or_empty(ir_bytes, function_name, receiver);
    let variant = try ir_contract::body_field_expr_name(ir_bytes, function_name, value, "namespace");
    if !std::mem::equal_bytes(receiver_name, expected_receiver) or
        !std::mem::equal_bytes(variant, expected_variant) {
        return error("invalid return_void_instruction body");
    }
    return variant;
}

fn require_return_void_instruction_empty_string_field(
    ir_bytes: []u8,
    field_name: []u8
) -> !void {
    let function_name = "selfhost::ir::codegen::return_void_instruction";
    let literal = try return_void_instruction_return_literal(ir_bytes);
    let value = try ir_contract::body_struct_field_value(ir_bytes, function_name, literal, field_name);
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(kind, "String") {
        return error("invalid return_void_instruction body");
    }
    let token = try ir_contract::body_token_or_empty(ir_bytes, function_name, value);
    if !is_empty_string_literal_token(token) {
        return error("invalid return_void_instruction body");
    }
    return;
}

fn is_empty_string_literal_token(token: []u8) -> bool {
    return std::mem::len(token) == 2 and
        token[0] == cast<u8>(34) and
        token[1] == cast<u8>(34);
}

fn return_void_instruction_return_literal(ir_bytes: []u8) -> !i64 {
    let function_name = "selfhost::ir::codegen::return_void_instruction";
    let statement = try ir_contract::body_child_sequence(ir_bytes, function_name, 0, "statement", 0);
    let statement_kind = try ir_contract::body_node_kind(ir_bytes, function_name, statement);
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("invalid return_void_instruction body");
    }
    let value = try ir_contract::body_child_sequence(ir_bytes, function_name, statement, "value", 0);
    let value_kind = try ir_contract::body_node_kind(ir_bytes, function_name, value);
    if !std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        return error("invalid return_void_instruction body");
    }
    let type_name = try ir_contract::body_child_sequence(ir_bytes, function_name, value, "type", 0);
    let actual_type = try ir_contract::body_token_or_empty(ir_bytes, function_name, type_name);
    if !std::mem::equal_bytes(actual_type, "Instruction") {
        return error("invalid return_void_instruction body");
    }
    return value;
}

fn append_codegen_lower_run_ast_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lower_run_ast(");
    try append_line(out, "  %kizu.selfhost.codegen.run_ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "main", "codegen_main", 4);
    try append_global_slice(out, "print", "codegen_print", 5);
    try append_line(out, "  %ok = extractvalue %kizu.selfhost.codegen.run_ast %ast, 0");
    try append_line(out, "  %function_count = extractvalue %kizu.selfhost.codegen.run_ast %ast, 1");
    try append_line(out, "  %function_name = extractvalue %kizu.selfhost.codegen.run_ast %ast, 2");
    try append_line(out, "  %block_count = extractvalue %kizu.selfhost.codegen.run_ast %ast, 3");
    try append_line(out, "  %statement_count = extractvalue %kizu.selfhost.codegen.run_ast %ast, 4");
    try append_line(out, "  %final_kind = extractvalue %kizu.selfhost.codegen.run_ast %ast, 5");
    try append_line(out, "  %callee = extractvalue %kizu.selfhost.codegen.run_ast %ast, 6");
    try append_line(out, "  %arg_kind = extractvalue %kizu.selfhost.codegen.run_ast %ast, 7");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.codegen.run_ast %ast, 8");
    try append_line(out, "  %one_function = icmp eq i64 %function_count, 1");
    try append_line(out, "  %main_name = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %function_name, %kizu.slice.u8 %main_slice)");
    try append_line(out, "  %one_block = icmp eq i64 %block_count, 1");
    try append_line(out, "  %has_statement = icmp sge i64 %statement_count, 1");
    try append_line(out, "  %print_statement = icmp eq i64 %final_kind, 1");
    try append_line(out, "  %print_callee = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %callee, %kizu.slice.u8 %print_slice)");
    try append_line(out, "  %const_arg = icmp eq i64 %arg_kind, 1");
    try append_line(out, "  %shape_01 = and i1 %ok, %one_function");
    try append_line(out, "  %shape_02 = and i1 %shape_01, %main_name");
    try append_line(out, "  %shape_03 = and i1 %shape_02, %one_block");
    try append_line(out, "  %shape_04 = and i1 %shape_03, %has_statement");
    try append_line(out, "  %shape_05 = and i1 %shape_04, %print_statement");
    try append_line(out, "  %shape_06 = and i1 %shape_05, %print_callee");
    try append_line(out, "  %shape_ok = and i1 %shape_06, %const_arg");
    try append_line(out, "  br i1 %shape_ok, label %lower_program, label %unsupported");
    try append_line(out, "lower_program:");
    try append_line(out,
        "  %program = call %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lowered_main_print_program(%kizu.slice.u8 %payload)");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %program");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret %kizu.selfhost.codegen.program zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_codegen_program_supported_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_codegen_program_supported(");
    try append_line(out, "  %kizu.selfhost.codegen.program %program");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %payload = call %kizu.error.slice.u8 @kizu_selfhost__cli_codegen_stdout_payload(%kizu.selfhost.codegen.program %program)");
    try append_line(out, "  %ok = extractvalue %kizu.error.slice.u8 %payload, 0");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_codegen_stdout_payload_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__cli_codegen_stdout_payload(");
    try append_line(out, "  %kizu.selfhost.codegen.program %program");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_program_shape_extracts(out);
    try append_global_slice(out, "main", "codegen_main", 4);
    try append_global_slice(out, "entry", "codegen_entry", 5);
    try append_global_slice(out, "s0", "codegen_s0", 2);
    try append_global_slice(out, "print", "codegen_print", 5);
    try append_program_shape_checks(out);
    try append_line(out, "  br i1 %shape_ok, label %return_payload, label %unsupported");
    try append_line(out, "return_payload:");
    try append_line(out, "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %first_payload, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_codegen_payload_llvm_c_string_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.error.slice.u8 @kizu_selfhost__cli_codegen_payload_llvm_c_string(");
    try append_line(out, "  %kizu.slice.u8 %payload,");
    try append_line(out, "  i1 %append_newline");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %payload_len = extractvalue %kizu.slice.u8 %payload, 1");
    try append_line(out, "  br label %measure");
    try append_line(out, "measure:");
    try append_line(out, "  %measure_index = phi i64 [ 0, %entry ], [ %measure_next, %measure_advance ]");
    try append_line(out, "  %escaped_len = phi i64 [ 0, %entry ], [ %next_escaped_len, %measure_advance ]");
    try append_line(out, "  %measure_done = icmp eq i64 %measure_index, %payload_len");
    try append_line(out, "  br i1 %measure_done, label %allocate, label %measure_body");
    try append_line(out, "measure_body:");
    try append_payload_byte_load(out, "measure", "payload", "measure_index");
    try append_line(out, "  %measure_escape = call i1 @kizu_selfhost__cli_codegen_payload_byte_needs_escape(i8 %measure_byte)");
    try append_line(out, "  %measure_delta = select i1 %measure_escape, i64 3, i64 1");
    try append_line(out, "  %next_escaped_len = add i64 %escaped_len, %measure_delta");
    try append_line(out, "  br label %measure_advance");
    try append_line(out, "measure_advance:");
    try append_line(out, "  %measure_next = add i64 %measure_index, 1");
    try append_line(out, "  br label %measure");
    try append_line(out, "allocate:");
    try append_line(out, "  %newline_delta = select i1 %append_newline, i64 3, i64 0");
    try append_line(out, "  %total_len = add i64 %escaped_len, %newline_delta");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %total_len)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %copy, label %alloc_failed");
    try append_line(out, "copy:");
    try append_line(out, "  br label %copy_loop");
    try append_line(out, "copy_loop:");
    try append_line(out, "  %copy_index = phi i64 [ 0, %copy ], [ %copy_next, %copy_advance ]");
    try append_line(out, "  %write_index = phi i64 [ 0, %copy ], [ %next_write_index, %copy_advance ]");
    try append_line(out, "  %copy_done = icmp eq i64 %copy_index, %payload_len");
    try append_line(out, "  br i1 %copy_done, label %maybe_newline, label %copy_body");
    try append_line(out, "copy_body:");
    try append_payload_byte_load(out, "copy", "payload", "copy_index");
    try append_line(out, "  %copy_escape = call i1 @kizu_selfhost__cli_codegen_payload_byte_needs_escape(i8 %copy_byte)");
    try append_line(out, "  br i1 %copy_escape, label %write_escape, label %write_plain");
    try append_line(out, "write_plain:");
    try append_line(out, "  %plain_dest = getelementptr i8, ptr %buffer, i64 %write_index");
    try append_line(out, "  store i8 %copy_byte, ptr %plain_dest");
    try append_line(out, "  %plain_next_write = add i64 %write_index, 1");
    try append_line(out, "  br label %copy_advance");
    try append_line(out, "write_escape:");
    try append_line(out,
        "  %escape_next_write = call i64 @kizu_selfhost__cli_codegen_write_llvm_escape(ptr %buffer, i64 %write_index, i8 %copy_byte)");
    try append_line(out, "  br label %copy_advance");
    try append_line(out, "copy_advance:");
    try append_line(out,
        "  %next_write_index = phi i64 [ %plain_next_write, %write_plain ], [ %escape_next_write, %write_escape ]");
    try append_line(out, "  %copy_next = add i64 %copy_index, 1");
    try append_line(out, "  br label %copy_loop");
    try append_line(out, "maybe_newline:");
    try append_line(out, "  br i1 %append_newline, label %write_newline, label %return_payload");
    try append_line(out, "write_newline:");
    try append_line(out,
        "  %newline_next_write = call i64 @kizu_selfhost__cli_codegen_write_llvm_escape(ptr %buffer, i64 %write_index, i8 10)");
    try append_line(out, "  br label %return_payload");
    try append_line(out, "return_payload:");
    try append_line(out,
        "  %final_len = phi i64 [ %write_index, %maybe_newline ], [ %newline_next_write, %write_newline ]");
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %final_len, 1");
    try append_line(out, "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %body, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    try append_payload_byte_needs_escape_function(out);
    try append_write_llvm_escape_function(out);
    return;
}

fn append_payload_byte_load(
    out: &var std::string::String,
    prefix: []u8,
    slice: []u8,
    index: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(prefix);
    try out.append_bytes("_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(slice);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(prefix);
    try out.append_bytes("_byte_ptr = getelementptr i8, ptr %");
    try out.append_bytes(prefix);
    try out.append_bytes("_ptr, i64 %");
    try out.append_bytes(index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(prefix);
    try out.append_bytes("_byte = load i8, ptr %");
    try out.append_bytes(prefix);
    try out.append_bytes("_byte_ptr");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_payload_byte_needs_escape_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_codegen_payload_byte_needs_escape(i8 %byte) {");
    try append_line(out, "entry:");
    try append_line(out, "  %is_quote = icmp eq i8 %byte, 34");
    try append_line(out, "  %is_backslash = icmp eq i8 %byte, 92");
    try append_line(out, "  %is_newline = icmp eq i8 %byte, 10");
    try append_line(out, "  %quote_or_backslash = or i1 %is_quote, %is_backslash");
    try append_line(out, "  %needs_escape = or i1 %quote_or_backslash, %is_newline");
    try append_line(out, "  ret i1 %needs_escape");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_write_llvm_escape_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_codegen_write_llvm_escape(");
    try append_line(out, "  ptr %buffer,");
    try append_line(out, "  i64 %index,");
    try append_line(out, "  i8 %byte");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %slash_ptr = getelementptr i8, ptr %buffer, i64 %index");
    try append_line(out, "  store i8 92, ptr %slash_ptr");
    try append_line(out, "  %first_index = add i64 %index, 1");
    try append_line(out, "  %second_index = add i64 %index, 2");
    try append_line(out, "  %next_index = add i64 %index, 3");
    try append_line(out, "  %first_ptr = getelementptr i8, ptr %buffer, i64 %first_index");
    try append_line(out, "  %second_ptr = getelementptr i8, ptr %buffer, i64 %second_index");
    try append_line(out, "  %is_quote = icmp eq i8 %byte, 34");
    try append_line(out, "  %is_backslash = icmp eq i8 %byte, 92");
    try append_line(out, "  %first_digit = select i1 %is_backslash, i8 53, i8 48");
    try append_line(out, "  %quote_or_backslash = or i1 %is_quote, %is_backslash");
    try append_line(out, "  %second_quote_or_newline = select i1 %is_quote, i8 50, i8 65");
    try append_line(out, "  %second_digit = select i1 %is_backslash, i8 67, i8 %second_quote_or_newline");
    try append_line(out, "  store i8 %first_digit, ptr %first_ptr");
    try append_line(out, "  store i8 %second_digit, ptr %second_ptr");
    try append_line(out, "  ret i64 %next_index");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_program_shape_extracts(out: &var std::string::String) -> !void {
    try append_line(out, "  %function_count = extractvalue %kizu.selfhost.codegen.program %program, 0");
    try append_line(out, "  %function_name = extractvalue %kizu.selfhost.codegen.program %program, 1");
    try append_line(out, "  %block_count = extractvalue %kizu.selfhost.codegen.program %program, 2");
    try append_line(out, "  %block_label = extractvalue %kizu.selfhost.codegen.program %program, 3");
    try append_line(out, "  %instruction_count = extractvalue %kizu.selfhost.codegen.program %program, 4");
    try append_line(out, "  %first_kind = extractvalue %kizu.selfhost.codegen.program %program, 5");
    try append_line(out, "  %first_result_kind = extractvalue %kizu.selfhost.codegen.program %program, 6");
    try append_line(out, "  %first_name = extractvalue %kizu.selfhost.codegen.program %program, 7");
    try append_line(out, "  %first_payload = extractvalue %kizu.selfhost.codegen.program %program, 8");
    try append_line(out, "  %second_kind = extractvalue %kizu.selfhost.codegen.program %program, 9");
    try append_line(out, "  %second_callee = extractvalue %kizu.selfhost.codegen.program %program, 10");
    try append_line(out, "  %second_argument_kind = extractvalue %kizu.selfhost.codegen.program %program, 11");
    try append_line(out, "  %second_argument_name = extractvalue %kizu.selfhost.codegen.program %program, 12");
    try append_line(out, "  %third_kind = extractvalue %kizu.selfhost.codegen.program %program, 14");
    try append_line(out, "  %from_codegen_lowering = extractvalue %kizu.selfhost.codegen.program %program, 15");
    return;
}

fn append_program_shape_checks(out: &var std::string::String) -> !void {
    try append_line(out, "  %one_function = icmp eq i64 %function_count, 1");
    try append_line(out, "  %main_name = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %function_name, %kizu.slice.u8 %main_slice)");
    try append_line(out, "  %one_block = icmp eq i64 %block_count, 1");
    try append_line(out, "  %entry_label = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %block_label, %kizu.slice.u8 %entry_slice)");
    try append_line(out, "  %three_instructions = icmp eq i64 %instruction_count, 3");
    try append_line(out, "  %first_const = icmp eq i64 %first_kind, 1");
    try append_line(out, "  %first_value_const = icmp eq i64 %first_result_kind, 1");
    try append_line(out, "  %first_name_s0 = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %first_name, %kizu.slice.u8 %s0_slice)");
    try append_line(out, "  %second_call = icmp eq i64 %second_kind, 2");
    try append_line(out, "  %second_print = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %second_callee, %kizu.slice.u8 %print_slice)");
    try append_line(out, "  %second_arg_const = icmp eq i64 %second_argument_kind, 1");
    try append_line(out, "  %second_name_s0 = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %second_argument_name, %kizu.slice.u8 %s0_slice)");
    try append_line(out, "  %third_return = icmp eq i64 %third_kind, 3");
    try append_line(out, "  %shape_01 = and i1 %one_function, %main_name");
    try append_line(out, "  %shape_02 = and i1 %shape_01, %one_block");
    try append_line(out, "  %shape_03 = and i1 %shape_02, %entry_label");
    try append_line(out, "  %shape_04 = and i1 %shape_03, %three_instructions");
    try append_line(out, "  %shape_05 = and i1 %shape_04, %first_const");
    try append_line(out, "  %shape_06 = and i1 %shape_05, %first_value_const");
    try append_line(out, "  %shape_07 = and i1 %shape_06, %first_name_s0");
    try append_line(out, "  %shape_08 = and i1 %shape_07, %second_call");
    try append_line(out, "  %shape_09 = and i1 %shape_08, %second_print");
    try append_line(out, "  %shape_10 = and i1 %shape_09, %second_arg_const");
    try append_line(out, "  %shape_11 = and i1 %shape_10, %second_name_s0");
    try append_line(out, "  %shape_12 = and i1 %shape_11, %third_return");
    try append_line(out, "  %shape_ok = and i1 %shape_12, %from_codegen_lowering");
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    local: []u8,
    global: []u8,
    size: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_ptr = getelementptr [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(local);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(local);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_c_string_payload(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        try append_llvm_c_string_byte(out, payload[index]);
        index = index + 1;
    }
    return;
}

fn append_llvm_c_string_byte(out: &var std::string::String, byte: u8) -> !void {
    if byte == cast<u8>(34) {
        try out.append_bytes("\22");
    } else {
        if byte == cast<u8>(92) {
            try out.append_bytes("\5C");
        } else {
            if byte == cast<u8>(10) {
                try out.append_bytes("\0A");
            } else {
                try out.append_byte(byte);
            }
        }
    }
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
