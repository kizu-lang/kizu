pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(out, "codegen_main", "4", "main");
    try append_llvm_constant(out, "codegen_entry", "5", "entry");
    try append_llvm_constant(out, "codegen_s0", "2", "s0");
    try append_llvm_constant(out, "codegen_print", "5", "print");
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_codegen_const_string_value_function(out);
    try append_codegen_const_string_instruction_function(out);
    try append_codegen_call_instruction_function(out);
    try append_codegen_return_void_instruction_function(out);
    try append_codegen_lowered_main_print_program_function(out);
    try append_codegen_lower_run_ast_function(out);
    try append_codegen_program_supported_function(out);
    try append_codegen_stdout_payload_function(out);
    try append_codegen_payload_llvm_c_string_function(out);
    return;
}

fn append_codegen_lowered_main_print_program_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.program @kizu_selfhost__cli_codegen_lowered_main_print_program(");
    try append_line(out, "  %kizu.slice.u8 %payload");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "main", "codegen_main", 4);
    try append_global_slice(out, "entry", "codegen_entry", 5);
    try append_global_slice(out, "s0", "codegen_s0", 2);
    try append_global_slice(out, "print", "codegen_print", 5);
    try append_line(out,
        "  %function0 = insertvalue %kizu.selfhost.codegen.function poison, %kizu.slice.u8 %main_slice, 0");
    try append_line(out,
        "  %function = insertvalue %kizu.selfhost.codegen.function %function0, i64 1, 1");
    try append_line(out,
        "  %block0 = insertvalue %kizu.selfhost.codegen.block poison, %kizu.slice.u8 %entry_slice, 0");
    try append_line(out,
        "  %block = insertvalue %kizu.selfhost.codegen.block %block0, i64 3, 1");
    try append_line(out,
        "  %value = call %kizu.selfhost.codegen.value @kizu_selfhost__cli_codegen_const_string_value(%kizu.slice.u8 %s0_slice, %kizu.slice.u8 %payload)");
    try append_line(out,
        "  %first = call %kizu.selfhost.codegen.instruction @kizu_selfhost__cli_codegen_const_string_instruction(%kizu.selfhost.codegen.value %value)");
    try append_line(out,
        "  %argument = call %kizu.selfhost.codegen.value @kizu_selfhost__cli_codegen_const_string_value(%kizu.slice.u8 %s0_slice, %kizu.slice.u8 %payload)");
    try append_line(out,
        "  %second = call %kizu.selfhost.codegen.instruction @kizu_selfhost__cli_codegen_call_instruction(%kizu.slice.u8 %print_slice, %kizu.selfhost.codegen.value %argument)");
    try append_line(out,
        "  %third = call %kizu.selfhost.codegen.instruction @kizu_selfhost__cli_codegen_return_void_instruction()");
    try append_line(out, "  %function_name = extractvalue %kizu.selfhost.codegen.function %function, 0");
    try append_line(out, "  %function_block_count = extractvalue %kizu.selfhost.codegen.function %function, 1");
    try append_line(out, "  %block_label = extractvalue %kizu.selfhost.codegen.block %block, 0");
    try append_line(out, "  %block_instruction_count = extractvalue %kizu.selfhost.codegen.block %block, 1");
    try append_line(out, "  %first_kind = extractvalue %kizu.selfhost.codegen.instruction %first, 0");
    try append_line(out, "  %first_result_kind = extractvalue %kizu.selfhost.codegen.instruction %first, 1");
    try append_line(out, "  %first_result_name = extractvalue %kizu.selfhost.codegen.instruction %first, 2");
    try append_line(out, "  %first_result_payload = extractvalue %kizu.selfhost.codegen.instruction %first, 3");
    try append_line(out, "  %second_kind = extractvalue %kizu.selfhost.codegen.instruction %second, 0");
    try append_line(out, "  %second_callee = extractvalue %kizu.selfhost.codegen.instruction %second, 4");
    try append_line(out, "  %second_argument_kind = extractvalue %kizu.selfhost.codegen.instruction %second, 5");
    try append_line(out, "  %second_argument_name = extractvalue %kizu.selfhost.codegen.instruction %second, 6");
    try append_line(out, "  %second_argument_payload = extractvalue %kizu.selfhost.codegen.instruction %second, 7");
    try append_line(out, "  %third_kind = extractvalue %kizu.selfhost.codegen.instruction %third, 0");
    try append_line(out, "  %field0 = insertvalue %kizu.selfhost.codegen.program poison, i64 1, 0");
    try append_line(out, "  %field1 = insertvalue %kizu.selfhost.codegen.program %field0, %kizu.slice.u8 %function_name, 1");
    try append_line(out, "  %field2 = insertvalue %kizu.selfhost.codegen.program %field1, i64 %function_block_count, 2");
    try append_line(out, "  %field3 = insertvalue %kizu.selfhost.codegen.program %field2, %kizu.slice.u8 %block_label, 3");
    try append_line(out, "  %field4 = insertvalue %kizu.selfhost.codegen.program %field3, i64 %block_instruction_count, 4");
    try append_line(out, "  %field5 = insertvalue %kizu.selfhost.codegen.program %field4, i64 %first_kind, 5");
    try append_line(out, "  %field6 = insertvalue %kizu.selfhost.codegen.program %field5, i64 %first_result_kind, 6");
    try append_line(out, "  %field7 = insertvalue %kizu.selfhost.codegen.program %field6, %kizu.slice.u8 %first_result_name, 7");
    try append_line(out, "  %field8 = insertvalue %kizu.selfhost.codegen.program %field7, %kizu.slice.u8 %first_result_payload, 8");
    try append_line(out, "  %field9 = insertvalue %kizu.selfhost.codegen.program %field8, i64 %second_kind, 9");
    try append_line(out, "  %field10 = insertvalue %kizu.selfhost.codegen.program %field9, %kizu.slice.u8 %second_callee, 10");
    try append_line(out, "  %field11 = insertvalue %kizu.selfhost.codegen.program %field10, i64 %second_argument_kind, 11");
    try append_line(out, "  %field12 = insertvalue %kizu.selfhost.codegen.program %field11, %kizu.slice.u8 %second_argument_name, 12");
    try append_line(out, "  %field13 = insertvalue %kizu.selfhost.codegen.program %field12, %kizu.slice.u8 %second_argument_payload, 13");
    try append_line(out, "  %field14 = insertvalue %kizu.selfhost.codegen.program %field13, i64 %third_kind, 14");
    try append_line(out, "  %field15 = insertvalue %kizu.selfhost.codegen.program %field14, i1 true, 15");
    try append_line(out, "  ret %kizu.selfhost.codegen.program %field15");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

