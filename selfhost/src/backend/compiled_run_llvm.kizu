import selfhost::backend::compiled_canonical_facts;
import selfhost::backend::compiled_program_llvm;
import selfhost::backend::compiled_run_entry_llvm;
import selfhost::backend::compiled_runtime_declarations;
import selfhost::backend::compiled_type_declarations;
import selfhost::backend::ir_index;

fn append_line(out: &var std::string::String, line: []u8) -> !void {
    try out.append_bytes(line);
    try out.append_byte(cast<u8>(10));
    return;
}

fn validate_fact_bytes(facts: []u8) -> !void {
    let byte_len = std::mem::len(facts);
    if byte_len == 0 {
        return error("compiled run module: facts are empty");
    }
    var line_start = 0;
    var index = 0;
    while index < byte_len {
        let byte = facts[index];
        if byte == cast<u8>(0) or byte == cast<u8>(13) {
            return error("compiled run module: invalid fact byte");
        }
        if byte == cast<u8>(10) {
            if index == line_start {
                return error("compiled run module: empty fact line");
            }
            line_start = index + 1;
        }
        index = index + 1;
    }
    return;
}

fn hex_digit(value: u8) -> u8 {
    if value < cast<u8>(10) {
        return cast<u8>(cast<i64>(48) + cast<i64>(value));
    }
    return cast<u8>(cast<i64>(65) + cast<i64>(value) - cast<i64>(10));
}

fn append_quoted_source_name(
    out: &var std::string::String,
    source_name: []u8
) -> !void {
    if std::mem::len(source_name) == 0 {
        return error("compiled run module: source name is empty");
    }
    try out.append_byte(cast<u8>(34));
    var index = 0;
    while index < std::mem::len(source_name) {
        let byte = source_name[index];
        if byte == cast<u8>(34) or byte == cast<u8>(92) or
            byte < cast<u8>(32) or byte > cast<u8>(126) {
            try out.append_byte(cast<u8>(92));
            try out.append_byte(hex_digit(cast<u8>(
                cast<i64>(byte) / cast<i64>(16)
            )));
            try out.append_byte(hex_digit(cast<u8>(
                cast<i64>(byte) % cast<i64>(16)
            )));
        } else {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    try out.append_byte(cast<u8>(34));
    return;
}

// render_module is the pure source-root package-facts to LLVM boundary. It
// builds one index and one canonical table, then shares both immutable views
// across declaration and function emission. Host/storage implementations stay
// external link inputs.
pub fn render_module(
    allocator: Allocator,
    facts: []u8,
    source_name: []u8
) -> !std::string::String {
    try validate_fact_bytes(facts);
    var index = try ir_index::build(facts);
    defer index.deinit();
    if ir_index::entry_count(&index) == 0 {
        return error("compiled run module: facts contain no indexed entries");
    }
    var canonical_facts = try compiled_canonical_facts::parse_and_validate(
        &index, facts
    );
    defer canonical_facts.deinit();

    var out = std::string::String(allocator);
    errdefer out.deinit();
    try out.reserve(std::mem::len(facts) / 3);
    try append_line(&var out, "; Kizu compiled run module");
    try out.append_bytes("source_filename = ");
    try append_quoted_source_name(&var out, source_name);
    try out.append_byte(cast<u8>(10));
    try append_line(&var out, "");

    try compiled_runtime_declarations::append_foundation_types(&var out);
    try compiled_type_declarations::append_reachable_fact_declarations_indexed(
        &var out, &index, facts
    );
    try append_line(&var out, "");
    try compiled_runtime_declarations::append_linked_host_externals(&var out);
    try compiled_runtime_declarations::append_linked_storage_externals(&var out);
    try append_line(&var out, "");
    let emitted_function_count =
        try compiled_program_llvm::append_reachable_functions(
            &var out, &index, &canonical_facts, facts
        );
    if emitted_function_count < 1 {
        return error("compiled run module: no reachable functions emitted");
    }
    try compiled_run_entry_llvm::append_run_entry(&var out, &index, facts);
    return out;
}

pub fn minimal_module_gate() -> !void {
    let facts = "package-identity-bounds 1 1
program-entry 0 0 app::entry::start
package-definition 0 0
package-definition-name 0 0 app::entry::start
function-owner-module app::entry::start app::entry::
function-signature-return app::entry::start i64
reachable-type app::entry::start i64
body-node app::entry::start 0 depth 0 kind Block span 0 12
body-edge app::entry::start 0 statement 0 1
body-node app::entry::start 1 depth 1 kind Return span 0 11
body-edge app::entry::start 1 value 0 2
body-node app::entry::start 2 depth 2 kind Int span 7 8
body-token app::entry::start 2 0";
    var out = try render_module(
        std::mem::page_allocator(), facts, "entry.kizu"
    );
    defer out.deinit();
    let bytes = out.as_bytes();
    print(bytes);
    return;
}
