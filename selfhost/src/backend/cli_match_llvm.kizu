pub fn append_functions(out: &var std::string::String) -> !void {
    try append_cli_token_char_eq_function(out);
    try append_cli_token_pair_eq_function(out);
    try append_cli_token_word_eq_function(out);
    try append_cli_token_string_hello_eq_function(out);
    try append_cli_run_prints_hello_function(out);
    try append_cli_test_expect_value_function(out);
    return;
}

fn append_cli_token_char_eq_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_char_eq(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  i8 %want");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %len_ok = icmp eq i64 %len, 1");
    try append_line(out, "  br i1 %len_ok, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %ok = icmp eq i8 %byte, %want");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_token_pair_eq_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_pair_eq(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  i8 %b0,");
    try append_line(out, "  i8 %b1");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %len_ok = icmp eq i64 %len, 2");
    try append_line(out, "  br i1 %len_ok, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %p0 = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %i1 = add i64 %start, 1");
    try append_line(out, "  %p1 = getelementptr i8, ptr %source_ptr, i64 %i1");
    try append_line(out, "  %v0 = load i8, ptr %p0");
    try append_line(out, "  %v1 = load i8, ptr %p1");
    try append_line(out, "  %e0 = icmp eq i8 %v0, %b0");
    try append_line(out, "  %e1 = icmp eq i8 %v1, %b1");
    try append_line(out, "  %ok = and i1 %e0, %e1");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_token_word_eq_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_word_eq(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  i64 %want_len,");
    try append_line(out, "  i8 %b0,");
    try append_line(out, "  i8 %b1,");
    try append_line(out, "  i8 %b2,");
    try append_line(out, "  i8 %b3,");
    try append_line(out, "  i8 %b4,");
    try append_line(out, "  i8 %b5,");
    try append_line(out, "  i8 %b6");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %token_len = sub i64 %end, %start");
    try append_line(out, "  %same_len = icmp eq i64 %token_len, %want_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %want_len");
    try append_line(out, "  br i1 %done, label %true, label %compare");
    try append_line(out, "compare:");
    try append_line(out, "  switch i64 %index, label %false [");
    try append_line(out, "    i64 0, label %cmp0");
    try append_line(out, "    i64 1, label %cmp1");
    try append_line(out, "    i64 2, label %cmp2");
    try append_line(out, "    i64 3, label %cmp3");
    try append_line(out, "    i64 4, label %cmp4");
    try append_line(out, "    i64 5, label %cmp5");
    try append_line(out, "    i64 6, label %cmp6");
    try append_line(out, "  ]");
    try append_cli_word_compare_block(out, "cmp0", "at0", "ptr0", "v0", "ok0", "0", "%b0");
    try append_cli_word_compare_block(out, "cmp1", "at1", "ptr1", "v1", "ok1", "1", "%b1");
    try append_cli_word_compare_block(out, "cmp2", "at2", "ptr2", "v2", "ok2", "2", "%b2");
    try append_cli_word_compare_block(out, "cmp3", "at3", "ptr3", "v3", "ok3", "3", "%b3");
    try append_cli_word_compare_block(out, "cmp4", "at4", "ptr4", "v4", "ok4", "4", "%b4");
    try append_cli_word_compare_block(out, "cmp5", "at5", "ptr5", "v5", "ok5", "5", "%b5");
    try append_cli_word_compare_block(out, "cmp6", "at6", "ptr6", "v6", "ok6", "6", "%b6");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_word_compare_block(
    out: &var std::string::String,
    label: []u8,
    at: []u8,
    ptr: []u8,
    value: []u8,
    ok: []u8,
    offset: []u8,
    expected: []u8
) -> !void {
    try out.append_bytes(label);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(at);
    try out.append_bytes(" = add i64 %start, ");
    try out.append_bytes(offset);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(ptr);
    try out.append_bytes(" = getelementptr i8, ptr %source_ptr, i64 %");
    try out.append_bytes(at);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value);
    try out.append_bytes(" = load i8, ptr %");
    try out.append_bytes(ptr);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(ok);
    try out.append_bytes(" = icmp eq i8 %");
    try out.append_bytes(value);
    try out.append_bytes(", ");
    try out.append_bytes(expected);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(ok);
    try out.append_bytes(", label %advance, label %false");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_token_string_hello_eq_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_string_hello_eq(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %len_ok = icmp eq i64 %len, 13");
    try append_line(out, "  br i1 %len_ok, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_string_hello_byte_load(out, "0", "34");
    try append_string_hello_byte_load(out, "1", "104");
    try append_string_hello_byte_load(out, "2", "101");
    try append_string_hello_byte_load(out, "3", "108");
    try append_string_hello_byte_load(out, "4", "108");
    try append_string_hello_byte_load(out, "5", "111");
    try append_string_hello_byte_load(out, "6", "44");
    try append_string_hello_byte_load(out, "7", "32");
    try append_string_hello_byte_load(out, "8", "107");
    try append_string_hello_byte_load(out, "9", "105");
    try append_string_hello_byte_load(out, "10", "122");
    try append_string_hello_byte_load(out, "11", "117");
    try append_string_hello_byte_load(out, "12", "34");
    try append_line(out, "  %p01 = and i1 %e0, %e1");
    try append_line(out, "  %p23 = and i1 %e2, %e3");
    try append_line(out, "  %p45 = and i1 %e4, %e5");
    try append_line(out, "  %p67 = and i1 %e6, %e7");
    try append_line(out, "  %p89 = and i1 %e8, %e9");
    try append_line(out, "  %p1011 = and i1 %e10, %e11");
    try append_line(out, "  %q03 = and i1 %p01, %p23");
    try append_line(out, "  %q47 = and i1 %p45, %p67");
    try append_line(out, "  %q811 = and i1 %p89, %p1011");
    try append_line(out, "  %r07 = and i1 %q03, %q47");
    try append_line(out, "  %r011 = and i1 %r07, %q811");
    try append_line(out, "  %ok = and i1 %r011, %e12");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_string_hello_byte_load(
    out: &var std::string::String,
    offset: []u8,
    expected: []u8
) -> !void {
    try out.append_bytes("  %i");
    try out.append_bytes(offset);
    try out.append_bytes(" = add i64 %start, ");
    try out.append_bytes(offset);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %p");
    try out.append_bytes(offset);
    try out.append_bytes(" = getelementptr i8, ptr %source_ptr, i64 %i");
    try out.append_bytes(offset);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %v");
    try out.append_bytes(offset);
    try out.append_bytes(" = load i8, ptr %p");
    try out.append_bytes(offset);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %e");
    try out.append_bytes(offset);
    try out.append_bytes(" = icmp eq i8 %v");
    try out.append_bytes(offset);
    try out.append_bytes(", ");
    try out.append_bytes(expected);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_run_prints_hello_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_run_prints_hello(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %scan = phi i64 [ 0, %entry ], [ %token_end, %continue ]");
    try append_line(out,
        "  %index = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load_token, label %false");
    try append_line(out, "load_token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out,
        "  %is_print = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %index, i64 %token_end, i64 5, i8 112, i8 114, i8 105, i8 110, i8 116, i8 0, i8 0)");
    try append_line(out, "  br i1 %is_print, label %check_lparen, label %continue");
    try append_line(out, "check_lparen:");
    try append_line(out,
        "  %lparen_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %token_end)");
    try append_line(out, "  %lparen_in_bounds = icmp slt i64 %lparen_start, %source_len");
    try append_line(out, "  br i1 %lparen_in_bounds, label %load_lparen, label %continue");
    try append_line(out, "load_lparen:");
    try append_line(out,
        "  %lparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %lparen_start)");
    try append_line(out,
        "  %lparen_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %lparen_start, i64 %lparen_end, i8 40)");
    try append_line(out, "  br i1 %lparen_ok, label %check_arg, label %continue");
    try append_line(out, "check_arg:");
    try append_line(out,
        "  %arg_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %lparen_end)");
    try append_line(out, "  %arg_in_bounds = icmp slt i64 %arg_start, %source_len");
    try append_line(out, "  br i1 %arg_in_bounds, label %load_arg, label %continue");
    try append_line(out, "load_arg:");
    try append_line(out,
        "  %arg_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %arg_start)");
    try append_line(out,
        "  %arg_ok = call i1 @kizu_selfhost__cli_token_string_hello_eq(%kizu.slice.u8 %source, i64 %arg_start, i64 %arg_end)");
    try append_line(out, "  br i1 %arg_ok, label %check_rparen, label %continue");
    try append_line(out, "check_rparen:");
    try append_line(out,
        "  %rparen_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %arg_end)");
    try append_line(out, "  %rparen_in_bounds = icmp slt i64 %rparen_start, %source_len");
    try append_line(out, "  br i1 %rparen_in_bounds, label %load_rparen, label %continue");
    try append_line(out, "load_rparen:");
    try append_line(out,
        "  %rparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %rparen_start)");
    try append_line(out,
        "  %rparen_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %rparen_start, i64 %rparen_end, i8 41)");
    try append_line(out, "  br i1 %rparen_ok, label %true, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_test_expect_value_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_test_expect_value(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %scan = phi i64 [ 0, %entry ], [ %token_end, %continue ]");
    try append_line(out,
        "  %index = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load_token, label %not_found");
    try append_line(out, "load_token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out,
        "  %is_std = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %index, i64 %token_end, i64 3, i8 115, i8 116, i8 100, i8 0, i8 0, i8 0, i8 0)");
    try append_line(out, "  br i1 %is_std, label %check_colon_one, label %continue");
    try append_test_next_token_pair_check(out, "colon_one", "token_end", "check_testing", "continue");
    try append_test_next_word_check(
        out,
        "testing",
        "colon_one_end",
        "7",
        "116",
        "101",
        "115",
        "116",
        "105",
        "110",
        "103",
        "check_colon_two",
        "continue"
    );
    try append_test_next_token_pair_check(out, "colon_two", "testing_end", "check_expect", "continue");
    try append_test_next_word_check(
        out,
        "expect",
        "colon_two_end",
        "6",
        "101",
        "120",
        "112",
        "101",
        "99",
        "116",
        "0",
        "check_lparen",
        "continue"
    );
    try append_test_next_token_char_check(out, "lparen", "expect_end", "40", "check_bool", "continue");
    try append_line(out, "check_bool:");
    try append_line(out,
        "  %bool_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %lparen_end)");
    try append_line(out, "  %bool_in_bounds = icmp slt i64 %bool_start, %source_len");
    try append_line(out, "  br i1 %bool_in_bounds, label %load_bool, label %continue");
    try append_line(out, "load_bool:");
    try append_line(out,
        "  %bool_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %bool_start)");
    try append_line(out,
        "  %bool_true = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %bool_start, i64 %bool_end, i64 4, i8 116, i8 114, i8 117, i8 101, i8 0, i8 0, i8 0)");
    try append_line(out, "  br i1 %bool_true, label %bool_true_value, label %maybe_bool_false");
    try append_line(out, "maybe_bool_false:");
    try append_line(out,
        "  %bool_false = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %bool_start, i64 %bool_end, i64 5, i8 102, i8 97, i8 108, i8 115, i8 101, i8 0, i8 0)");
    try append_line(out, "  br i1 %bool_false, label %bool_false_value, label %continue");
    try append_line(out, "bool_true_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "bool_false_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "check_rparen:");
    try append_line(out, "  %expect_value = phi i64 [ 1, %bool_true_value ], [ 0, %bool_false_value ]");
    try append_line(out,
        "  %rparen_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %bool_end)");
    try append_line(out, "  %rparen_in_bounds = icmp slt i64 %rparen_start, %source_len");
    try append_line(out, "  br i1 %rparen_in_bounds, label %load_rparen, label %continue");
    try append_line(out, "load_rparen:");
    try append_line(out,
        "  %rparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %rparen_start)");
    try append_line(out,
        "  %rparen_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %rparen_start, i64 %rparen_end, i8 41)");
    try append_line(out, "  br i1 %rparen_ok, label %return_expect, label %continue");
    try append_line(out, "return_expect:");
    try append_line(out, "  ret i64 %expect_value");
    try append_line(out, "continue:");
    try append_line(out, "  br label %loop");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_test_next_token_pair_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_pair_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i8 58, i8 58)");
    try out.append_byte(cast<u8>(10));
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_test_next_token_char_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    want: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i8 ");
    try out.append_bytes(want);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_test_next_word_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    len: []u8,
    b0: []u8,
    b1: []u8,
    b2: []u8,
    b3: []u8,
    b4: []u8,
    b5: []u8,
    b6: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i64 ");
    try out.append_bytes(len);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b0);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b1);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b2);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b3);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b4);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b5);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b6);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_check_label(out: &var std::string::String, name: []u8) -> !void {
    try out.append_bytes("check_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_next_token_load(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(previous_end);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds = icmp slt i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, %source_len");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds, label %load_");
    try out.append_bytes(name);
    try out.append_bytes(", label %continue");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("load_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_named_branch(
    out: &var std::string::String,
    name: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_ok, label %");
    try out.append_bytes(ok_label);
    try out.append_bytes(", label %");
    try out.append_bytes(fail_label);
    try out.append_byte(cast<u8>(10));
    return;
}


fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
