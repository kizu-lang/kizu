        "125",
        "check_eof",
        "continue"
    );
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %found, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "found:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_test_expect_value_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_test_expect_value(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  %zero = add i64 0, 0");
    try append_line(out, "  br label %check_fn");
    try append_test_next_word_check(
        out,
        "fn",
        "zero",
        "2",
        "102",
        "110",
        "0",
        "0",
        "0",
        "0",
        "0",
        "check_main",
        "continue"
    );
    try append_test_next_word_check(
        out,
