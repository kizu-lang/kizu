pub fn append_functions(out: &var std::string::String) -> !void {
    try append_cli_token_char_eq_function(out);
    try append_cli_token_pair_eq_function(out);
    try append_cli_token_word_eq_function(out);
    try append_cli_run_payload_is_simple_function(out);
    try append_cli_run_print_payload_function(out);
    try append_cli_run_return_ok_function(out);
    try append_cli_test_expect_value_function(out);
    try append_cli_token_equals_range_function(out);
    try append_cli_moved_value_name_function(out);
    return;
}

fn append_cli_token_char_eq_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_char_eq(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  i8 %want");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %len_ok = icmp eq i64 %len, 1");
    try append_line(out, "  br i1 %len_ok, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %ok = icmp eq i8 %byte, %want");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_token_pair_eq_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_pair_eq(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  i8 %b0,");
    try append_line(out, "  i8 %b1");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %len_ok = icmp eq i64 %len, 2");
    try append_line(out, "  br i1 %len_ok, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %p0 = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %i1 = add i64 %start, 1");
    try append_line(out, "  %p1 = getelementptr i8, ptr %source_ptr, i64 %i1");
    try append_line(out, "  %v0 = load i8, ptr %p0");
    try append_line(out, "  %v1 = load i8, ptr %p1");
    try append_line(out, "  %e0 = icmp eq i8 %v0, %b0");
    try append_line(out, "  %e1 = icmp eq i8 %v1, %b1");
    try append_line(out, "  %ok = and i1 %e0, %e1");
    try append_line(out, "  ret i1 %ok");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_token_word_eq_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_token_word_eq(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end,");
    try append_line(out, "  i64 %want_len,");
    try append_line(out, "  i8 %b0,");
    try append_line(out, "  i8 %b1,");
    try append_line(out, "  i8 %b2,");
    try append_line(out, "  i8 %b3,");
    try append_line(out, "  i8 %b4,");
    try append_line(out, "  i8 %b5,");
    try append_line(out, "  i8 %b6");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %token_len = sub i64 %end, %start");
    try append_line(out, "  %same_len = icmp eq i64 %token_len, %want_len");
    try append_line(out, "  br i1 %same_len, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %index, %want_len");
    try append_line(out, "  br i1 %done, label %true, label %compare");
    try append_line(out, "compare:");
    try append_line(out, "  switch i64 %index, label %false [");
    try append_line(out, "    i64 0, label %cmp0");
    try append_line(out, "    i64 1, label %cmp1");
    try append_line(out, "    i64 2, label %cmp2");
    try append_line(out, "    i64 3, label %cmp3");
    try append_line(out, "    i64 4, label %cmp4");
    try append_line(out, "    i64 5, label %cmp5");
    try append_line(out, "    i64 6, label %cmp6");
    try append_line(out, "  ]");
    try append_cli_word_compare_block(out, "cmp0", "at0", "ptr0", "v0", "ok0", "0", "%b0");
    try append_cli_word_compare_block(out, "cmp1", "at1", "ptr1", "v1", "ok1", "1", "%b1");
    try append_cli_word_compare_block(out, "cmp2", "at2", "ptr2", "v2", "ok2", "2", "%b2");
    try append_cli_word_compare_block(out, "cmp3", "at3", "ptr3", "v3", "ok3", "3", "%b3");
    try append_cli_word_compare_block(out, "cmp4", "at4", "ptr4", "v4", "ok4", "4", "%b4");
    try append_cli_word_compare_block(out, "cmp5", "at5", "ptr5", "v5", "ok5", "5", "%b5");
    try append_cli_word_compare_block(out, "cmp6", "at6", "ptr6", "v6", "ok6", "6", "%b6");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_word_compare_block(
    out: &var std::string::String,
    label: []u8,
    at: []u8,
    ptr: []u8,
    value: []u8,
    ok: []u8,
    offset: []u8,
    expected: []u8
) -> !void {
    try out.append_bytes(label);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(at);
    try out.append_bytes(" = add i64 %start, ");
    try out.append_bytes(offset);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(ptr);
    try out.append_bytes(" = getelementptr i8, ptr %source_ptr, i64 %");
    try out.append_bytes(at);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(value);
    try out.append_bytes(" = load i8, ptr %");
    try out.append_bytes(ptr);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(ok);
    try out.append_bytes(" = icmp eq i8 %");
    try out.append_bytes(value);
    try out.append_bytes(", ");
    try out.append_bytes(expected);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(ok);
    try out.append_bytes(", label %advance, label %false");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_run_payload_is_simple_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_run_payload_is_simple(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %len");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %offset = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %offset, %len");
    try append_line(out, "  br i1 %done, label %true, label %load");
    try append_line(out, "load:");
    try append_line(out, "  %index = add i64 %start, %offset");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %min_ok = icmp uge i8 %byte, 32");
    try append_line(out, "  %max_ok = icmp ule i8 %byte, 126");
    try append_line(out, "  %range_ok = and i1 %min_ok, %max_ok");
    try append_line(out, "  %is_quote = icmp eq i8 %byte, 34");
    try append_line(out, "  %not_special = xor i1 %is_quote, true");
    try append_line(out, "  %safe = and i1 %range_ok, %not_special");
    try append_line(out, "  br i1 %safe, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %offset, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_run_print_payload_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__cli_run_print_payload(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  %zero = add i64 0, 0");
    try append_line(out, "  br label %check_fn");
    try append_test_next_word_check(
        out,
        "fn",
        "zero",
        "2",
        "102",
        "110",
        "0",
        "0",
        "0",
        "0",
        "0",
        "check_main",
        "continue"
    );
    try append_test_next_word_check(
        out,
        "main",
        "fn_end",
        "4",
        "109",
        "97",
        "105",
        "110",
        "0",
        "0",
        "0",
        "check_main_lparen",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "main_lparen",
        "main_end",
        "40",
        "check_main_rparen",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "main_rparen",
        "main_lparen_end",
        "41",
        "check_lbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "lbrace",
        "main_rparen_end",
        "123",
        "check_print",
        "continue"
    );
    try append_test_next_word_check(
        out,
        "print",
        "lbrace_end",
        "5",
        "112",
        "114",
        "105",
        "110",
        "116",
        "0",
        "0",
        "check_print_lparen",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "print_lparen",
        "print_end",
        "40",
        "check_arg",
        "continue"
    );
    try append_line(out, "check_arg:");
    try append_line(out,
        "  %arg_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %print_lparen_end)");
    try append_line(out, "  %arg_in_bounds = icmp slt i64 %arg_start, %source_len");
    try append_line(out, "  br i1 %arg_in_bounds, label %load_arg, label %continue");
    try append_line(out, "load_arg:");
    try append_line(out,
        "  %arg_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %arg_start)");
    try append_line(out,
        "  %arg_len = sub i64 %arg_end, %arg_start");
    try append_line(out, "  %arg_has_quotes = icmp sge i64 %arg_len, 2");
    try append_line(out, "  br i1 %arg_has_quotes, label %load_quote, label %continue");
    try append_line(out, "load_quote:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %quote_start_ptr = getelementptr i8, ptr %source_ptr, i64 %arg_start");
    try append_line(out, "  %quote_start = load i8, ptr %quote_start_ptr");
    try append_line(out, "  %quote_start_ok = icmp eq i8 %quote_start, 34");
    try append_line(out, "  %quote_end_index = sub i64 %arg_end, 1");
    try append_line(out, "  %quote_end_ptr = getelementptr i8, ptr %source_ptr, i64 %quote_end_index");
    try append_line(out, "  %quote_end = load i8, ptr %quote_end_ptr");
    try append_line(out, "  %quote_end_ok = icmp eq i8 %quote_end, 34");
    try append_line(out, "  %quotes_ok = and i1 %quote_start_ok, %quote_end_ok");
    try append_line(out, "  br i1 %quotes_ok, label %validate_payload, label %continue");
    try append_line(out, "validate_payload:");
    try append_line(out, "  %payload_start = add i64 %arg_start, 1");
    try append_line(out, "  %payload_len = sub i64 %arg_len, 2");
    try append_line(out,
        "  %payload_ok = call i1 @kizu_selfhost__cli_run_payload_is_simple(%kizu.slice.u8 %source, i64 %payload_start, i64 %payload_len)");
    try append_line(out, "  br i1 %payload_ok, label %check_print_rparen, label %continue");
    try append_test_next_token_char_check(
        out,
        "print_rparen",
        "arg_end",
        "41",
        "check_print_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "print_semicolon",
        "print_rparen_end",
        "59",
        "check_after_print",
        "continue"
    );
    try append_run_print_tail_checks(out);
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "found:");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %source_ptr, i64 %payload_start");
    try append_line(out, "  %payload_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload = insertvalue %kizu.slice.u8 %payload_base, i64 %payload_len, 1");
    try append_line(out,
        "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %payload, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "not_found:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_run_print_tail_checks(out: &var std::string::String) -> !void {
    try append_line(out, "check_after_print:");
    try append_line(out,
        "  %after_print_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %print_semicolon_end)");
    try append_line(out, "  %after_print_in_bounds = icmp slt i64 %after_print_start, %source_len");
    try append_line(out, "  br i1 %after_print_in_bounds, label %load_after_print, label %continue");
    try append_line(out, "load_after_print:");
    try append_line(out,
        "  %after_print_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %after_print_start)");
    try append_line(out,
        "  %after_print_rbrace_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %after_print_start, i64 %after_print_end, i8 125)");
    try append_line(out,
        "  br i1 %after_print_rbrace_ok, label %run_print_direct_rbrace, label %maybe_print_return");
    try append_line(out, "run_print_direct_rbrace:");
    try append_line(out, "  br label %check_eof");
    try append_line(out, "maybe_print_return:");
    try append_line(out,
        "  %after_print_return_ok = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %after_print_start, i64 %after_print_end, i64 6, i8 114, i8 101, i8 116, i8 117, i8 114, i8 110, i8 0)");
    try append_line(out,
        "  br i1 %after_print_return_ok, label %check_run_print_return_semicolon, label %continue");
    try append_test_next_token_char_check(
        out,
        "run_print_return_semicolon",
        "after_print_end",
        "59",
        "check_run_print_return_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "run_print_return_rbrace",
        "run_print_return_semicolon_end",
        "125",
        "run_print_return_rbrace_found",
        "continue"
    );
    try append_line(out, "run_print_return_rbrace_found:");
    try append_line(out, "  br label %check_eof");
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %run_print_rbrace_end = phi i64 [ %after_print_end, %run_print_direct_rbrace ], [ %run_print_return_rbrace_end, %run_print_return_rbrace_found ]");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %run_print_rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %found, label %continue");
    return;
}

fn append_cli_run_return_ok_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_run_return_ok(");
