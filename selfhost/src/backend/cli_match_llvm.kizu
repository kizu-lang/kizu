        "expect",
        "colon_two_end",
        "6",
        "101",
        "120",
        "112",
        "101",
        "99",
        "116",
        "0",
        "check_lparen",
        "continue"
    );
    try append_test_next_token_char_check(out, "lparen", "expect_end", "40", "check_bool", "continue");
    try append_line(out, "check_bool:");
    try append_line(out,
        "  %bool_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %lparen_end)");
    try append_line(out, "  %bool_in_bounds = icmp slt i64 %bool_start, %source_len");
    try append_line(out, "  br i1 %bool_in_bounds, label %load_bool, label %continue");
    try append_line(out, "load_bool:");
    try append_line(out,
        "  %bool_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %bool_start)");
    try append_line(out,
        "  %bool_true = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %bool_start, i64 %bool_end, i64 4, i8 116, i8 114, i8 117, i8 101, i8 0, i8 0, i8 0)");
    try append_line(out, "  br i1 %bool_true, label %bool_true_value, label %maybe_bool_false");
    try append_line(out, "maybe_bool_false:");
    try append_line(out,
        "  %bool_false = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %bool_start, i64 %bool_end, i64 5, i8 102, i8 97, i8 108, i8 115, i8 101, i8 0, i8 0)");
    try append_line(out, "  br i1 %bool_false, label %bool_false_value, label %continue");
    try append_line(out, "bool_true_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "bool_false_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "check_rparen:");
    try append_line(out, "  %expect_value = phi i64 [ 1, %bool_true_value ], [ 0, %bool_false_value ]");
    try append_line(out,
        "  %rparen_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %bool_end)");
    try append_line(out, "  %rparen_in_bounds = icmp slt i64 %rparen_start, %source_len");
    try append_line(out, "  br i1 %rparen_in_bounds, label %load_rparen, label %continue");
    try append_line(out, "load_rparen:");
    try append_line(out,
        "  %rparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %rparen_start)");
    try append_line(out,
        "  %rparen_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %rparen_start, i64 %rparen_end, i8 41)");
    try append_line(out, "  br i1 %rparen_ok, label %check_expect_semicolon, label %continue");
    try append_test_next_token_char_check(
        out,
        "expect_semicolon",
        "rparen_end",
        "59",
        "check_return",
        "continue"
    );
    try append_test_next_word_check(
        out,
        "return",
        "expect_semicolon_end",
        "6",
        "114",
        "101",
        "116",
        "117",
        "114",
        "110",
        "0",
        "check_return_semicolon",
