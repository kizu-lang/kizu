import selfhost::backend::cli_check_gate_llvm;
import selfhost::backend::cli_hosted_metadata_llvm;
import selfhost::backend::ir_contract;

pub fn append_globals(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let artifact_function = "selfhost::backend::hosted::emit_test_executable_artifact";
    let lowering_function = "selfhost::backend::hosted::lower_test_hosted_executable";
    let metadata_function = "selfhost::backend::hosted::write_test_metadata";
    try append_llvm_fact_constant(
        out,
        "test_dir",
        ir_bytes,
        "hosted-artifact-dir ",
        artifact_function
    );
    try append_llvm_fact_constant(
        out,
        "test_path_prefix",
        ir_bytes,
        "hosted-artifact-ll-prefix ",
        artifact_function
    );
    try append_llvm_fact_constant(
        out,
        "test_ll_suffix",
        ir_bytes,
        "hosted-artifact-ll-suffix ",
        artifact_function
    );
    try append_llvm_fact_constant(
        out,
        "test_metadata_path_prefix",
        ir_bytes,
        "hosted-artifact-metadata-prefix ",
        artifact_function
    );
    try append_llvm_fact_constant(
        out,
        "test_metadata_path_suffix",
        ir_bytes,
        "hosted-artifact-metadata-suffix ",
        artifact_function
    );
    try append_hosted_prefix_source_constant(
        out,
        "test_ok_ll_prefix",
        ir_bytes,
        lowering_function,
        0
    );
    try append_hosted_prefix_source_constant(
        out,
        "test_failure_ll_prefix",
        ir_bytes,
        lowering_function,
        1
    );
    try append_test_case_ll_suffix_constant(
        out,
        "test_ok_ll_suffix",
        ir_bytes,
        lowering_function,
        0
    );
    try append_test_case_ll_suffix_constant(
        out,
        "test_failure_ll_suffix",
        ir_bytes,
        lowering_function,
        1
    );
    try cli_hosted_metadata_llvm::append_prefix_constant(
        out,
        "test_meta_prefix",
        ir_bytes,
        metadata_function
    );
    try cli_hosted_metadata_llvm::append_suffix_constant(
        out,
        "test_ok_meta_suffix",
        ir_bytes,
        lowering_function,
        0,
        true,
        "runtime\20target/selfhost/stage2/selfhost.host.ll"
    );
    try cli_hosted_metadata_llvm::append_suffix_constant(
        out,
        "test_failure_meta_suffix",
        ir_bytes,
        lowering_function,
        1,
        true,
        "runtime\20target/selfhost/stage2/selfhost.host.ll"
    );
    return;
}

fn append_llvm_fact_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    prefix: []u8,
    fact_name: []u8
) -> !void {
    let value = try ir_contract::named_fact_value(ir_bytes, prefix, fact_name);
    try append_llvm_constant_bytes(out, name, value);
    return;
}

fn append_llvm_constant_bytes(
    out: &var std::string::String,
    name: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, std::mem::len(text));
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_constant_header(
    out: &var std::string::String,
    name: []u8,
    size: i64
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    return;
}

fn append_llvm_constant_footer(out: &var std::string::String) -> !void {
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_hosted_prefix_source_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> !void {
    let size = try hosted_prefix_source_size(ir_bytes, function_name, index);
    let comment = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-comment-llvm ",
        function_name,
        index
    );
    let suffix = "\0Asource_filename = \22";
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes("; ");
    try out.append_bytes(comment);
    try out.append_bytes(suffix);
    try append_llvm_constant_footer(out);
    return;
}

fn append_test_case_ll_suffix_constant(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> !void {
    let size = try test_case_ll_suffix_size(ir_bytes, function_name, index);
    let entry = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-entry ",
        function_name,
        index
    );
    let global = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-global ",
        function_name,
        index
    );
    let stream = try hosted_lowering_case_stream_name(ir_bytes, function_name, index);
    let append_newline = try hosted_lowering_case_bool(
        ir_bytes,
        "hosted-lowering-case-newline ",
        function_name,
        index
    );
    let exit_code = try hosted_lowering_case_i64(
        ir_bytes,
        "hosted-lowering-case-exit ",
        function_name,
        index
    );
    let payload = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-payload-llvm ",
        function_name,
        index
    );
    let output_len = hosted_output_len(payload, append_newline);
    let header =
        "\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A";
    let global_prefix = "%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.";
    let global_middle = " = private unnamed_addr constant [";
    let global_suffix = " x i8] c\22";
    let declare_head = "\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0A";
    let write_decl = "declare %kizu.error.void @kizu_rt_io_write_";
    let declare_tail =
        "(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0A";
    let entry_prefix = "define i64 @";
    let entry_suffix = "() {\0Aentry:\0A";
    let io = "  %io = call %kizu.owned @kizu_rt_io_blocking()\0A";
    let ptr_prefix = "  %ptr = getelementptr inbounds [";
    let ptr_middle = " x i8], ptr @.";
    let ptr_suffix = ", i64 0, i64 0\0A";
    let base = "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A";
    let slice_prefix = "  %slice = insertvalue %kizu.slice.u8 %base, i64 ";
    let slice_suffix = ", 1\0A";
    let write_prefix = "  %write = call %kizu.error.void @kizu_rt_io_write_";
    let write_suffix = "(%kizu.owned %io, %kizu.slice.u8 %slice)\0A";
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes(header);
    try out.append_bytes(global_prefix);
    try out.append_bytes(global);
    try out.append_bytes(global_middle);
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(global_suffix);
    try out.append_bytes(payload);
    if append_newline {
        try out.append_bytes("\5C0A");
    }
    try out.append_bytes(declare_head);
    try out.append_bytes(write_decl);
    try out.append_bytes(stream);
    try out.append_bytes(declare_tail);
    try out.append_bytes(entry_prefix);
    try out.append_bytes(entry);
    try out.append_bytes(entry_suffix);
    try out.append_bytes(io);
    try out.append_bytes(ptr_prefix);
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(ptr_middle);
    try out.append_bytes(global);
    try out.append_bytes(ptr_suffix);
    try out.append_bytes(base);
    try out.append_bytes(slice_prefix);
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(slice_suffix);
    try out.append_bytes(write_prefix);
    try out.append_bytes(stream);
    try out.append_bytes(write_suffix);
    try append_hosted_exit(out, exit_code);
    try append_llvm_constant_footer(out);
    return;
}

pub fn append_cli_test_blocks(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let artifact_function = "selfhost::backend::hosted::emit_test_executable_artifact";
    let lowering_function = "selfhost::backend::hosted::lower_test_hosted_executable";
    let test_ok_kind = try hosted_lowering_case_kind_tag(ir_bytes, lowering_function, 0);
    let test_failure_kind = try hosted_lowering_case_kind_tag(ir_bytes, lowering_function, 1);
    try append_line(out, "dispatch_test:");
    try append_line(out, "  %test_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %test_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %test_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %test_file_ok = extractvalue %kizu.error.slice.u8 %test_file, 0");
    try append_line(out, "  br i1 %test_file_ok, label %test_read_ok, label %check_failed");
    try append_line(out, "test_read_ok:");
    try append_line(out, "  %test_bytes = extractvalue %kizu.error.slice.u8 %test_file, 1");
    try cli_check_gate_llvm::append_static_check_gate(
        out,
        "test_check",
        "test_check",
        "test_io",
        "test_bytes",
        "test_match_source"
    );
    try append_line(out, "test_match_source:");
    try append_line(out,
        "  %test_executable = call %kizu.selfhost.executable @kizu_selfhost__cli_test_executable(%kizu.slice.u8 %test_bytes)");
    try append_line(out,
        "  %test_executable_kind = extractvalue %kizu.selfhost.executable %test_executable, 0");
    try append_executable_kind_compare(out, "test_ok_found", "test_executable_kind", test_ok_kind);
    try append_line(out, "  br i1 %test_ok_found, label %test_ok_emit, label %maybe_test_failure");
    try append_line(out, "maybe_test_failure:");
    try append_executable_kind_compare(
        out,
        "test_failure_found",
        "test_executable_kind",
        test_failure_kind
    );
    try append_line(out, "  br i1 %test_failure_found, label %test_failure_emit, label %usage");
    try append_test_ok_emit_block(out, ir_bytes, artifact_function, lowering_function);
    try append_test_failure_emit_block(out, ir_bytes, artifact_function, lowering_function);
    return;
}

fn append_test_ok_emit_block(
    out: &var std::string::String,
    ir_bytes: []u8,
    artifact_function: []u8,
    lowering_function: []u8
) -> !void {
    let dir_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-dir ",
        artifact_function
    );
    let ll_prefix_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-ll-prefix ",
        artifact_function
    );
    let ll_suffix_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-ll-suffix ",
        artifact_function
    );
    let metadata_prefix_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-metadata-prefix ",
        artifact_function
    );
    let metadata_suffix_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-metadata-suffix ",
        artifact_function
    );
    let ll_prefix_body_size = try hosted_prefix_source_size(ir_bytes, lowering_function, 0);
    let ll_suffix_body_size = try test_case_ll_suffix_size(ir_bytes, lowering_function, 0);
    let meta_prefix_size = try cli_hosted_metadata_llvm::prefix_size(
        ir_bytes,
        "selfhost::backend::hosted::write_test_metadata"
    );
    let meta_output_prefix_size = try cli_hosted_metadata_llvm::output_prefix_size(ir_bytes);
    let meta_suffix_size = try cli_hosted_metadata_llvm::suffix_size(
        ir_bytes,
        lowering_function,
        0,
        true,
        "runtime\20target/selfhost/stage2/selfhost.host.ll"
    );
    try append_line(out, "test_ok_emit:");
    try append_global_slice(out, "test_ok", "dir", "test_dir", dir_size);
    try append_line(out,
        "  %test_ok_mkdir = call %kizu.error.void @kizu_selfhost__ensure_artifact_dir(%kizu.owned %test_io, %kizu.slice.u8 %test_ok_dir_slice)");
    try append_line(out, "  %test_ok_mkdir_ok = extractvalue %kizu.error.void %test_ok_mkdir, 0");
    try append_line(out,
        "  br i1 %test_ok_mkdir_ok, label %test_ok_write_ll, label %check_failed");
    try append_line(out, "test_ok_write_ll:");
    try append_global_slice(out, "test_ok", "path_prefix", "test_path_prefix", ll_prefix_size);
    try append_global_slice(out, "test_ok", "ll_ext", "test_ll_suffix", ll_suffix_size);
    try append_line(out,
        "  %test_ok_ll_path_result = call %kizu.error.slice.u8 @kizu_selfhost__artifact_path(%kizu.slice.u8 %target, %kizu.slice.u8 %test_ok_path_prefix_slice, %kizu.slice.u8 %test_ok_ll_ext_slice)");
    try append_line(out,
        "  %test_ok_ll_path_ok = extractvalue %kizu.error.slice.u8 %test_ok_ll_path_result, 0");
    try append_line(out,
        "  br i1 %test_ok_ll_path_ok, label %test_ok_write_ll_body, label %check_failed");
    try append_line(out, "test_ok_write_ll_body:");
    try append_line(out,
        "  %test_ok_ll_path_slice = extractvalue %kizu.error.slice.u8 %test_ok_ll_path_result, 1");
    try append_global_slice(out, "test_ok", "ll_prefix", "test_ok_ll_prefix", ll_prefix_body_size);
    try append_global_slice(out, "test_ok", "ll_suffix", "test_ok_ll_suffix", ll_suffix_body_size);
    try append_line(out,
        "  %test_ok_ll_write = call %kizu.error.void @kizu_selfhost__write_concat3(%kizu.owned %test_io, %kizu.slice.u8 %test_ok_ll_path_slice, %kizu.slice.u8 %test_ok_ll_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %test_ok_ll_suffix_slice)");
    try append_line(out, "  %test_ok_ll_ok = extractvalue %kizu.error.void %test_ok_ll_write, 0");
    try append_line(out,
        "  br i1 %test_ok_ll_ok, label %test_ok_write_meta, label %check_failed");
    try append_line(out, "test_ok_write_meta:");
    try append_global_slice(
        out,
        "test_ok",
        "metadata_path_prefix",
        "test_metadata_path_prefix",
        metadata_prefix_size
    );
    try append_global_slice(
        out,
        "test_ok",
        "metadata_path_suffix",
        "test_metadata_path_suffix",
        metadata_suffix_size
    );
    try append_line(out,
        "  %test_ok_meta_path_result = call %kizu.error.slice.u8 @kizu_selfhost__artifact_path(%kizu.slice.u8 %target, %kizu.slice.u8 %test_ok_metadata_path_prefix_slice, %kizu.slice.u8 %test_ok_metadata_path_suffix_slice)");
    try append_line(out,
        "  %test_ok_meta_path_ok = extractvalue %kizu.error.slice.u8 %test_ok_meta_path_result, 0");
    try append_line(out,
        "  br i1 %test_ok_meta_path_ok, label %test_ok_write_meta_body, label %check_failed");
    try append_line(out, "test_ok_write_meta_body:");
    try append_line(out,
        "  %test_ok_meta_path_slice = extractvalue %kizu.error.slice.u8 %test_ok_meta_path_result, 1");
    try append_global_slice(out, "test_ok", "meta_prefix", "test_meta_prefix", meta_prefix_size);
    try append_global_slice(
        out,
        "test_ok",
        "meta_output_prefix",
        "artifact_output_prefix",
        meta_output_prefix_size
    );
    try append_global_slice(out, "test_ok", "meta_body_suffix", "test_ok_meta_suffix", meta_suffix_size);
    try append_line(out,
        "  %test_ok_meta_write = call %kizu.error.void @kizu_selfhost__write_concat5(%kizu.owned %test_io, %kizu.slice.u8 %test_ok_meta_path_slice, %kizu.slice.u8 %test_ok_meta_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %test_ok_meta_output_prefix_slice, %kizu.slice.u8 %test_ok_ll_path_slice, %kizu.slice.u8 %test_ok_meta_body_suffix_slice)");
    try append_line(out,
        "  %test_ok_meta_ok = extractvalue %kizu.error.void %test_ok_meta_write, 0");
    try append_line(out, "  br i1 %test_ok_meta_ok, label %exit_zero, label %check_failed");
    return;
}

fn append_test_failure_emit_block(
    out: &var std::string::String,
    ir_bytes: []u8,
    artifact_function: []u8,
    lowering_function: []u8
) -> !void {
    let dir_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-dir ",
        artifact_function
    );
    let ll_prefix_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-ll-prefix ",
        artifact_function
    );
    let ll_suffix_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-ll-suffix ",
        artifact_function
    );
    let metadata_prefix_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-metadata-prefix ",
        artifact_function
    );
    let metadata_suffix_size = try hosted_artifact_fact_len(
        ir_bytes,
        "hosted-artifact-metadata-suffix ",
        artifact_function
    );
    let ll_prefix_body_size = try hosted_prefix_source_size(ir_bytes, lowering_function, 1);
    let ll_suffix_body_size = try test_case_ll_suffix_size(ir_bytes, lowering_function, 1);
    let meta_prefix_size = try cli_hosted_metadata_llvm::prefix_size(
        ir_bytes,
        "selfhost::backend::hosted::write_test_metadata"
    );
    let meta_output_prefix_size = try cli_hosted_metadata_llvm::output_prefix_size(ir_bytes);
    let meta_suffix_size = try cli_hosted_metadata_llvm::suffix_size(
        ir_bytes,
        lowering_function,
        1,
        true,
        "runtime\20target/selfhost/stage2/selfhost.host.ll"
    );
    try append_line(out, "test_failure_emit:");
    try append_global_slice(out, "test_failure", "dir", "test_dir", dir_size);
    try append_line(out,
        "  %test_failure_mkdir = call %kizu.error.void @kizu_selfhost__ensure_artifact_dir(%kizu.owned %test_io, %kizu.slice.u8 %test_failure_dir_slice)");
    try append_line(out,
        "  %test_failure_mkdir_ok = extractvalue %kizu.error.void %test_failure_mkdir, 0");
    try append_line(out,
        "  br i1 %test_failure_mkdir_ok, label %test_failure_write_ll, label %check_failed");
    try append_line(out, "test_failure_write_ll:");
    try append_global_slice(out, "test_failure", "path_prefix", "test_path_prefix", ll_prefix_size);
    try append_global_slice(out, "test_failure", "ll_ext", "test_ll_suffix", ll_suffix_size);
    try append_line(out,
        "  %test_failure_ll_path_result = call %kizu.error.slice.u8 @kizu_selfhost__artifact_path(%kizu.slice.u8 %target, %kizu.slice.u8 %test_failure_path_prefix_slice, %kizu.slice.u8 %test_failure_ll_ext_slice)");
    try append_line(out,
        "  %test_failure_ll_path_ok = extractvalue %kizu.error.slice.u8 %test_failure_ll_path_result, 0");
    try append_line(out,
        "  br i1 %test_failure_ll_path_ok, label %test_failure_write_ll_body, label %check_failed");
    try append_line(out, "test_failure_write_ll_body:");
    try append_line(out,
        "  %test_failure_ll_path_slice = extractvalue %kizu.error.slice.u8 %test_failure_ll_path_result, 1");
    try append_global_slice(
        out,
        "test_failure",
        "ll_prefix",
        "test_failure_ll_prefix",
        ll_prefix_body_size
    );
    try append_global_slice(
        out,
        "test_failure",
        "ll_suffix",
        "test_failure_ll_suffix",
        ll_suffix_body_size
    );
    try append_line(out,
        "  %test_failure_ll_write = call %kizu.error.void @kizu_selfhost__write_concat3(%kizu.owned %test_io, %kizu.slice.u8 %test_failure_ll_path_slice, %kizu.slice.u8 %test_failure_ll_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %test_failure_ll_suffix_slice)");
    try append_line(out,
        "  %test_failure_ll_ok = extractvalue %kizu.error.void %test_failure_ll_write, 0");
    try append_line(out,
        "  br i1 %test_failure_ll_ok, label %test_failure_write_meta, label %check_failed");
    try append_line(out, "test_failure_write_meta:");
    try append_global_slice(
        out,
        "test_failure",
        "metadata_path_prefix",
        "test_metadata_path_prefix",
        metadata_prefix_size
    );
    try append_global_slice(
        out,
        "test_failure",
        "metadata_path_suffix",
        "test_metadata_path_suffix",
        metadata_suffix_size
    );
    try append_line(out,
        "  %test_failure_meta_path_result = call %kizu.error.slice.u8 @kizu_selfhost__artifact_path(%kizu.slice.u8 %target, %kizu.slice.u8 %test_failure_metadata_path_prefix_slice, %kizu.slice.u8 %test_failure_metadata_path_suffix_slice)");
    try append_line(out,
        "  %test_failure_meta_path_ok = extractvalue %kizu.error.slice.u8 %test_failure_meta_path_result, 0");
    try append_line(out,
        "  br i1 %test_failure_meta_path_ok, label %test_failure_write_meta_body, label %check_failed");
    try append_line(out, "test_failure_write_meta_body:");
    try append_line(out,
        "  %test_failure_meta_path_slice = extractvalue %kizu.error.slice.u8 %test_failure_meta_path_result, 1");
    try append_global_slice(
        out,
        "test_failure",
        "meta_prefix",
        "test_meta_prefix",
        meta_prefix_size
    );
    try append_global_slice(
        out,
        "test_failure",
        "meta_output_prefix",
        "artifact_output_prefix",
        meta_output_prefix_size
    );
    try append_global_slice(
        out,
        "test_failure",
        "meta_body_suffix",
        "test_failure_meta_suffix",
        meta_suffix_size
    );
    try append_line(out,
        "  %test_failure_meta_write = call %kizu.error.void @kizu_selfhost__write_concat5(%kizu.owned %test_io, %kizu.slice.u8 %test_failure_meta_path_slice, %kizu.slice.u8 %test_failure_meta_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %test_failure_meta_output_prefix_slice, %kizu.slice.u8 %test_failure_ll_path_slice, %kizu.slice.u8 %test_failure_meta_body_suffix_slice)");
    try append_line(out,
        "  %test_failure_meta_ok = extractvalue %kizu.error.void %test_failure_meta_write, 0");
    try append_line(out,
        "  br i1 %test_failure_meta_ok, label %exit_zero, label %check_failed");
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    local: []u8,
    field: []u8,
    global: []u8,
    size: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn hosted_artifact_fact_len(ir_bytes: []u8, prefix: []u8, fact_name: []u8) -> !i64 {
    let value = try ir_contract::named_fact_value(ir_bytes, prefix, fact_name);
    return std::mem::len(value);
}

fn executable_kind_tag(ir_bytes: []u8, name: []u8) -> !i64 {
    return try ir_contract::named_i64_fact(ir_bytes, "executable-kind ", name);
}

fn hosted_lowering_case_kind_tag(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> !i64 {
    let kind_name = try ir_contract::sequence_fact_value(
        ir_bytes,
        "hosted-lowering-case-kind ",
        function_name,
        index
    );
    return try executable_kind_tag(ir_bytes, kind_name);
}

fn hosted_lowering_case_token(
    ir_bytes: []u8,
    prefix: []u8,
    function_name: []u8,
    index: i64
) -> ![]u8 borrows ir_bytes {
    return try ir_contract::sequence_fact_value(ir_bytes, prefix, function_name, index);
}

fn hosted_prefix_source_size(ir_bytes: []u8, function_name: []u8, index: i64) -> !i64 {
    let comment = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-comment-llvm ",
        function_name,
        index
    );
    let suffix = "\0Asource_filename = \22";
    return 2 + llvm_c_decoded_len(comment) + llvm_c_decoded_len(suffix);
}

fn test_case_ll_suffix_size(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> !i64 {
    let entry = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-entry ",
        function_name,
        index
    );
    let global = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-global ",
        function_name,
        index
    );
    let stream = try hosted_lowering_case_stream_name(ir_bytes, function_name, index);
    let append_newline = try hosted_lowering_case_bool(
        ir_bytes,
        "hosted-lowering-case-newline ",
        function_name,
        index
    );
    let exit_code = try hosted_lowering_case_i64(
        ir_bytes,
        "hosted-lowering-case-exit ",
        function_name,
        index
    );
    let payload = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-payload-llvm ",
        function_name,
        index
    );
    let output_len = hosted_output_len(payload, append_newline);
    let header =
        "\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A";
    let global_prefix = "%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.";
    let global_middle = " = private unnamed_addr constant [";
    let global_suffix = " x i8] c\22";
    let declare_head = "\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0A";
    let write_decl = "declare %kizu.error.void @kizu_rt_io_write_";
    let declare_tail =
        "(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0A";
    let entry_prefix = "define i64 @";
    let entry_suffix = "() {\0Aentry:\0A";
    let io = "  %io = call %kizu.owned @kizu_rt_io_blocking()\0A";
    let ptr_prefix = "  %ptr = getelementptr inbounds [";
    let ptr_middle = " x i8], ptr @.";
    let ptr_suffix = ", i64 0, i64 0\0A";
    let base = "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0\0A";
    let slice_prefix = "  %slice = insertvalue %kizu.slice.u8 %base, i64 ";
    let slice_suffix = ", 1\0A";
    let write_prefix = "  %write = call %kizu.error.void @kizu_rt_io_write_";
    let write_suffix = "(%kizu.owned %io, %kizu.slice.u8 %slice)\0A";
    var size = llvm_c_decoded_len(header) + llvm_c_decoded_len(global_prefix) +
        std::mem::len(global) + std::mem::len(global_middle) +
        decimal_len_i64(output_len) + llvm_c_decoded_len(global_suffix) +
        llvm_c_decoded_len(payload) + llvm_c_decoded_len(declare_head) +
        std::mem::len(write_decl) + std::mem::len(stream) +
        llvm_c_decoded_len(declare_tail) + std::mem::len(entry_prefix) +
        std::mem::len(entry) + llvm_c_decoded_len(entry_suffix) +
        llvm_c_decoded_len(io) + std::mem::len(ptr_prefix) +
        decimal_len_i64(output_len) + std::mem::len(ptr_middle) +
        std::mem::len(global) + llvm_c_decoded_len(ptr_suffix) +
        llvm_c_decoded_len(base) + std::mem::len(slice_prefix) +
        decimal_len_i64(output_len) + llvm_c_decoded_len(slice_suffix) +
        std::mem::len(write_prefix) + std::mem::len(stream) +
        llvm_c_decoded_len(write_suffix) + hosted_exit_decoded_len(exit_code);
    if append_newline {
        size = size + llvm_c_decoded_len("\5C0A");
    }
    return size;
}

fn hosted_lowering_case_i64(
    ir_bytes: []u8,
    prefix: []u8,
    function_name: []u8,
    index: i64
) -> !i64 {
    let value = try hosted_lowering_case_token(ir_bytes, prefix, function_name, index);
    if std::mem::equal_bytes(value, "0") {
        return 0;
    }
    if std::mem::equal_bytes(value, "1") {
        return 1;
    }
    return error("invalid IR artifact fact");
}

fn hosted_lowering_case_bool(
    ir_bytes: []u8,
    prefix: []u8,
    function_name: []u8,
    index: i64
) -> !bool {
    let value = try hosted_lowering_case_token(ir_bytes, prefix, function_name, index);
    if std::mem::equal_bytes(value, "true") {
        return true;
    }
    if std::mem::equal_bytes(value, "false") {
        return false;
    }
    return error("invalid IR artifact fact");
}

fn hosted_lowering_case_stream_name(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> ![]u8 {
    let value = try hosted_lowering_case_token(
        ir_bytes,
        "hosted-lowering-case-stream ",
        function_name,
        index
    );
    if std::mem::equal_bytes(value, "Stdout") {
        return "stdout";
    }
    if std::mem::equal_bytes(value, "Stderr") {
        return "stderr";
    }
    return error("invalid IR artifact fact");
}

fn hosted_output_len(payload: []u8, append_newline: bool) -> i64 {
    let length = llvm_c_decoded_len(payload);
    if append_newline {
        return length + 1;
    }
    return length;
}

fn append_hosted_exit(out: &var std::string::String, exit_code: i64) -> !void {
    try out.append_bytes("  %code = call i64 @kizu_rt_process_exit_code(i64 ");
    try std::fmt::append_i64(out, exit_code);
    try out.append_bytes(")\0A  ret i64 %code\0A}\0A");
    return;
}

fn hosted_exit_decoded_len(exit_code: i64) -> i64 {
    return std::mem::len("  %code = call i64 @kizu_rt_process_exit_code(i64 ") +
        decimal_len_i64(exit_code) + llvm_c_decoded_len(")\0A  ret i64 %code\0A}\0A");
}

fn llvm_c_decoded_len(text: []u8) -> i64 {
    var len = 0;
    var index = 0;
    let byte_len = std::mem::len(text);
    while index < byte_len {
        if index + 2 < byte_len and
            text[index] == cast<u8>(92) and
            is_hex_digit(text[index + 1]) and
            is_hex_digit(text[index + 2]) {
            len = len + 1;
            index = index + 3;
        } else {
            len = len + 1;
            index = index + 1;
        }
    }
    return len;
}

fn is_hex_digit(byte: u8) -> bool {
    if byte >= cast<u8>(48) and byte <= cast<u8>(57) {
        return true;
    }
    if byte >= cast<u8>(65) and byte <= cast<u8>(70) {
        return true;
    }
    if byte >= cast<u8>(97) and byte <= cast<u8>(102) {
        return true;
    }
    return false;
}

fn decimal_len_i64(value: i64) -> i64 {
    if value == 0 {
        return 1;
    }
    var remaining = value;
    var digits = 0;
    while remaining > 0 {
        remaining = remaining / 10;
        digits = digits + 1;
    }
    return digits;
}

fn append_executable_kind_compare(
    out: &var std::string::String,
    result: []u8,
    value: []u8,
    kind: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(result);
    try out.append_bytes(" = icmp eq i64 %");
    try out.append_bytes(value);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, kind);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
