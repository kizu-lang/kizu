import selfhost::backend::ir_contract;

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try require_executable_abi(ir_bytes);
    try append_cli_parse_run_executable_ast_function(out);
    try append_cli_parse_test_executable_ast_function(out);
    try append_cli_lower_executable_ast_functions(out, ir_bytes);
    try append_cli_run_executable_function(out);
    try append_cli_test_executable_function(out);
    return;
}

fn require_executable_abi(ir_bytes: []u8) -> !void {
    try ir_contract::require_fact(
        ir_bytes,
        "hosted-executable-abi executable-result-layout-v1"
    );
    try ir_contract::require_fact(ir_bytes, "executable-ast-layout kind:i64 payload:[]u8");
    try ir_contract::require_fact(ir_bytes, "executable-layout kind:i64 stdout_payload:[]u8");
    try ir_contract::require_fact(ir_bytes, "executable-ast-kind Unsupported 0");
    try ir_contract::require_fact(ir_bytes, "executable-ast-kind RunPrintCall 1");
    try ir_contract::require_fact(ir_bytes, "executable-ast-kind RunReturnVoid 2");
    try ir_contract::require_fact(ir_bytes, "executable-ast-kind TestExpectTrue 3");
    try ir_contract::require_fact(ir_bytes, "executable-ast-kind TestExpectFalse 4");
    try ir_contract::require_fact(ir_bytes, "executable-kind Unsupported 0");
    try ir_contract::require_fact(ir_bytes, "executable-kind RunPrintString 1");
    try ir_contract::require_fact(ir_bytes, "executable-kind RunReturnVoid 2");
    try ir_contract::require_fact(ir_bytes, "executable-kind TestExpectOk 3");
    try ir_contract::require_fact(ir_bytes, "executable-kind TestExpectFailure 4");
    return;
}

fn append_cli_run_executable_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_run_executable(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %ast = call %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_run_executable_ast(%kizu.slice.u8 %source)");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_lower_run_executable_ast(%kizu.selfhost.executable.ast %ast)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_test_executable_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_test_executable(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %ast = call %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_test_executable_ast(%kizu.slice.u8 %source)");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_lower_test_executable_ast(%kizu.selfhost.executable.ast %ast)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_run_executable_ast_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_run_executable_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_empty_payload(out);
    try append_line(out,
        "  %payload_result = call %kizu.error.slice.u8 @kizu_selfhost__cli_run_print_payload(%kizu.slice.u8 %source)");
    try append_line(out, "  %payload_ok = extractvalue %kizu.error.slice.u8 %payload_result, 0");
    try append_line(out, "  br i1 %payload_ok, label %run_print, label %check_return");
    try append_line(out, "run_print:");
    try append_line(out, "  %payload = extractvalue %kizu.error.slice.u8 %payload_result, 1");
    try append_executable_ast_return(out, "1", "payload");
    try append_line(out, "check_return:");
    try append_line(out,
        "  %return_ok = call i1 @kizu_selfhost__cli_run_return_ok(%kizu.slice.u8 %source)");
    try append_line(out, "  br i1 %return_ok, label %run_return, label %unsupported");
    try append_line(out, "run_return:");
    try append_executable_ast_return(out, "2", "empty");
    try append_line(out, "unsupported:");
    try append_executable_ast_return(out, "0", "empty");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_test_executable_ast_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_test_executable_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_empty_payload(out);
    try append_line(out,
        "  %expect = call i64 @kizu_selfhost__cli_test_expect_value(%kizu.slice.u8 %source)");
    try append_line(out, "  %is_ok = icmp eq i64 %expect, 1");
    try append_line(out, "  br i1 %is_ok, label %test_ok, label %check_failure");
    try append_line(out, "test_ok:");
    try append_executable_ast_return(out, "3", "empty");
    try append_line(out, "check_failure:");
    try append_line(out, "  %is_failure = icmp eq i64 %expect, 0");
    try append_line(out, "  br i1 %is_failure, label %test_failure, label %unsupported");
    try append_line(out, "test_failure:");
    try append_executable_ast_return(out, "4", "empty");
    try append_line(out, "unsupported:");
    try append_executable_ast_return(out, "0", "empty");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_lower_executable_ast_functions(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try ir_contract::require_fact(
        ir_bytes,
        "executable-lowering-rule RunPrintCall RunPrintString"
    );
    try ir_contract::require_fact(
        ir_bytes,
        "executable-lowering-rule RunReturnVoid RunReturnVoid"
    );
    try ir_contract::require_fact(
        ir_bytes,
        "executable-lowering-rule TestExpectTrue TestExpectOk"
    );
    try ir_contract::require_fact(
        ir_bytes,
        "executable-lowering-rule TestExpectFalse TestExpectFailure"
    );
    try append_cli_lower_run_executable_ast_function(out);
    try append_cli_lower_test_executable_ast_function(out);
    return;
}

fn append_cli_lower_run_executable_ast_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable @kizu_selfhost__cli_lower_run_executable_ast(");
    try append_line(out, "  %kizu.selfhost.executable.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ast_kind = extractvalue %kizu.selfhost.executable.ast %ast, 0");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.executable.ast %ast, 1");
    try append_line(out, "  %is_print = icmp eq i64 %ast_kind, 1");
    try append_line(out, "  br i1 %is_print, label %run_print, label %check_return");
    try append_line(out, "run_print:");
    try append_executable_return(out, "1", "payload");
    try append_line(out, "check_return:");
    try append_line(out, "  %is_return = icmp eq i64 %ast_kind, 2");
    try append_line(out, "  br i1 %is_return, label %run_return, label %unsupported");
    try append_line(out, "run_return:");
    try append_executable_return(out, "2", "payload");
    try append_line(out, "unsupported:");
    try append_executable_return(out, "0", "payload");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_lower_test_executable_ast_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable @kizu_selfhost__cli_lower_test_executable_ast(");
    try append_line(out, "  %kizu.selfhost.executable.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ast_kind = extractvalue %kizu.selfhost.executable.ast %ast, 0");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.executable.ast %ast, 1");
    try append_line(out, "  %is_ok = icmp eq i64 %ast_kind, 3");
    try append_line(out, "  br i1 %is_ok, label %test_ok, label %check_failure");
    try append_line(out, "test_ok:");
    try append_executable_return(out, "3", "payload");
    try append_line(out, "check_failure:");
    try append_line(out, "  %is_failure = icmp eq i64 %ast_kind, 4");
    try append_line(out, "  br i1 %is_failure, label %test_failure, label %unsupported");
    try append_line(out, "test_failure:");
    try append_executable_return(out, "4", "payload");
    try append_line(out, "unsupported:");
    try append_executable_return(out, "0", "payload");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_empty_payload(out: &var std::string::String) -> !void {
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %empty_base = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 %empty_base, i64 0, 1");
    return;
}

fn append_executable_ast_return(
    out: &var std::string::String,
    kind: []u8,
    payload: []u8
) -> !void {
    try out.append_bytes("  %ast_kinded");
    try out.append_bytes(kind);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast zeroinitializer, i64 ");
    try out.append_bytes(kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %ast_result");
    try out.append_bytes(kind);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast %ast_kinded");
    try out.append_bytes(kind);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(payload);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable.ast %ast_result");
    try out.append_bytes(kind);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_executable_return(
    out: &var std::string::String,
    kind: []u8,
    payload: []u8
) -> !void {
    try out.append_bytes("  %kinded");
    try out.append_bytes(kind);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable zeroinitializer, i64 ");
    try out.append_bytes(kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %result");
    try out.append_bytes(kind);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable %kinded");
    try out.append_bytes(kind);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(payload);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable %result");
    try out.append_bytes(kind);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
