fn append_cli_test_expect_value_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_test_expect_value(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %body_start = call i64 @kizu_selfhost__cli_test_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_body = icmp sge i64 %body_start, 0");
    try append_line(out, "  br i1 %has_body, label %check_std, label %continue");
    try append_test_next_word_check(
        out,
        "std",
        "body_start",
        "3",
        "115",
        "116",
        "100",
        "0",
        "0",
        "0",
        "0",
        "check_colon_one",
        "continue"
    );
    try append_test_next_token_pair_check(
        out,
        "colon_one",
        "std_end",
        "58",
        "58",
        "check_testing",
        "continue"
    );
    try append_test_next_word_check(
        out,
        "testing",
        "colon_one_end",
        "7",
        "116",
        "101",
        "115",
        "116",
        "105",
        "110",
        "103",
        "check_colon_two",
        "continue"
    );
    try append_test_next_token_pair_check(
        out,
        "colon_two",
        "testing_end",
        "58",
        "58",
        "check_expect",
        "continue"
    );
    try append_test_next_word_check(
        out,
        "expect",
        "colon_two_end",
        "6",
        "101",
        "120",
        "112",
        "101",
        "99",
        "116",
        "0",
        "check_lparen",
        "continue"
    );
    try append_test_next_token_char_check(out, "lparen", "expect_end", "40", "check_bool", "continue");
    try append_line(out, "check_bool:");
    try append_line(out,
        "  %bool_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %lparen_end)");
    try append_line(out, "  %bool_in_bounds = icmp slt i64 %bool_start, %source_len");
    try append_line(out, "  br i1 %bool_in_bounds, label %load_bool, label %continue");
    try append_line(out, "load_bool:");
    try append_line(out,
        "  %bool_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %bool_start)");
    try append_line(out,
        "  %bool_true = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %bool_start, i64 %bool_end, i64 4, i8 116, i8 114, i8 117, i8 101, i8 0, i8 0, i8 0)");
    try append_line(out, "  br i1 %bool_true, label %bool_true_value, label %maybe_bool_false");
    try append_line(out, "maybe_bool_false:");
    try append_line(out,
        "  %bool_false = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %bool_start, i64 %bool_end, i64 5, i8 102, i8 97, i8 108, i8 115, i8 101, i8 0, i8 0)");
    try append_line(out, "  br i1 %bool_false, label %bool_false_value, label %continue");
    try append_line(out, "bool_true_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "bool_false_value:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "check_rparen:");
    try append_line(out, "  %expect_value = phi i64 [ 1, %bool_true_value ], [ 0, %bool_false_value ]");
    try append_line(out,
        "  %rparen_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %bool_end)");
    try append_line(out, "  %rparen_in_bounds = icmp slt i64 %rparen_start, %source_len");
    try append_line(out, "  br i1 %rparen_in_bounds, label %load_rparen, label %continue");
    try append_line(out, "load_rparen:");
    try append_line(out,
        "  %rparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %rparen_start)");
    try append_line(out,
        "  %rparen_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %rparen_start, i64 %rparen_end, i8 41)");
    try append_line(out, "  br i1 %rparen_ok, label %check_expect_semicolon, label %continue");
    try append_test_next_token_char_check(
        out,
        "expect_semicolon",
        "rparen_end",
        "59",
        "check_return",
        "continue"
    );
    try append_test_next_word_check(
        out,
        "return",
        "expect_semicolon_end",
        "6",
        "114",
        "101",
        "116",
        "117",
        "114",
        "110",
        "0",
        "check_return_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "return_semicolon",
        "return_end",
        "59",
        "check_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "rbrace",
        "return_semicolon_end",
        "125",
        "check_eof",
        "continue"
    );
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %return_expect, label %continue");
    try append_line(out, "return_expect:");
    try append_line(out, "  ret i64 %expect_value");
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_test_next_token_pair_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    b0: []u8,
    b1: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_pair_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i8 ");
    try out.append_bytes(b0);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b1);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_test_next_token_char_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    want: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i8 ");
    try out.append_bytes(want);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_test_next_word_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    len: []u8,
    b0: []u8,
    b1: []u8,
    b2: []u8,
    b3: []u8,
    b4: []u8,
    b5: []u8,
    b6: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try append_check_label(out, name);
    try append_next_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i64 ");
    try out.append_bytes(len);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b0);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b1);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b2);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b3);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b4);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b5);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b6);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_named_branch(out, name, ok_label, fail_label);
    return;
}

fn append_check_label(out: &var std::string::String, name: []u8) -> !void {
    try out.append_bytes("check_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_next_token_load(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(previous_end);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds = icmp slt i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, %source_len");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds, label %load_");
    try out.append_bytes(name);
    try out.append_bytes(", label %continue");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("load_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_named_branch(
    out: &var std::string::String,
    name: []u8,
    ok_label: []u8,
    fail_label: []u8
) -> !void {
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_ok, label %");
    try out.append_bytes(ok_label);
    try out.append_bytes(", label %");
    try out.append_bytes(fail_label);
    try out.append_byte(cast<u8>(10));
    return;
}


fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
