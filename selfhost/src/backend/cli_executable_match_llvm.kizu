import selfhost::backend::cli_executable_main_llvm;

pub fn append_functions(out: &var std::string::String) -> !void {
    try cli_executable_main_llvm::append_functions(out);
    try append_cli_run_payload_is_simple_function(out);
    try append_cli_run_print_payload_function(out);
    try append_cli_run_return_ok_function(out);
    try append_cli_test_expect_value_function(out);
    try append_cli_parse_run_executable_ast_function(out);
    try append_cli_parse_test_executable_ast_function(out);
    try append_cli_lower_run_executable_ast_function(out);
    try append_cli_lower_test_executable_ast_function(out);
    try append_cli_run_executable_function(out);
    try append_cli_test_executable_function(out);
    return;
}

fn append_cli_run_executable_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_run_executable(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %ast = call %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_run_executable_ast(%kizu.slice.u8 %source)");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_lower_run_executable_ast(%kizu.selfhost.executable.ast %ast)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_test_executable_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.executable @kizu_selfhost__cli_test_executable(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %ast = call %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_test_executable_ast(%kizu.slice.u8 %source)");
    try append_line(out,
        "  %result = call %kizu.selfhost.executable @kizu_selfhost__cli_lower_test_executable_ast(%kizu.selfhost.executable.ast %ast)");
    try append_line(out, "  ret %kizu.selfhost.executable %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_run_executable_ast_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_run_executable_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_empty_payload(out);
    try append_line(out,
        "  %payload_result = call %kizu.error.slice.u8 @kizu_selfhost__cli_run_print_payload(%kizu.slice.u8 %source)");
    try append_line(out, "  %payload_ok = extractvalue %kizu.error.slice.u8 %payload_result, 0");
    try append_line(out, "  br i1 %payload_ok, label %run_print, label %check_return");
    try append_line(out, "run_print:");
    try append_line(out, "  %payload = extractvalue %kizu.error.slice.u8 %payload_result, 1");
    try append_executable_ast_return(out, "1", "payload");
    try append_line(out, "check_return:");
    try append_line(out,
        "  %return_ok = call i1 @kizu_selfhost__cli_run_return_ok(%kizu.slice.u8 %source)");
    try append_line(out, "  br i1 %return_ok, label %run_return, label %unsupported");
    try append_line(out, "run_return:");
    try append_executable_ast_return(out, "2", "empty");
    try append_line(out, "unsupported:");
    try append_executable_ast_return(out, "0", "empty");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_parse_test_executable_ast_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable.ast @kizu_selfhost__cli_parse_test_executable_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_empty_payload(out);
    try append_line(out,
        "  %expect = call i64 @kizu_selfhost__cli_test_expect_value(%kizu.slice.u8 %source)");
    try append_line(out, "  %is_ok = icmp eq i64 %expect, 1");
    try append_line(out, "  br i1 %is_ok, label %test_ok, label %check_failure");
    try append_line(out, "test_ok:");
    try append_executable_ast_return(out, "3", "empty");
    try append_line(out, "check_failure:");
    try append_line(out, "  %is_failure = icmp eq i64 %expect, 0");
    try append_line(out, "  br i1 %is_failure, label %test_failure, label %unsupported");
    try append_line(out, "test_failure:");
    try append_executable_ast_return(out, "4", "empty");
    try append_line(out, "unsupported:");
    try append_executable_ast_return(out, "0", "empty");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_lower_run_executable_ast_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable @kizu_selfhost__cli_lower_run_executable_ast(");
    try append_line(out, "  %kizu.selfhost.executable.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ast_kind = extractvalue %kizu.selfhost.executable.ast %ast, 0");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.executable.ast %ast, 1");
    try append_line(out, "  %is_print = icmp eq i64 %ast_kind, 1");
    try append_line(out, "  br i1 %is_print, label %run_print, label %check_return");
    try append_line(out, "run_print:");
    try append_executable_return(out, "1", "payload");
    try append_line(out, "check_return:");
    try append_line(out, "  %is_return = icmp eq i64 %ast_kind, 2");
    try append_line(out, "  br i1 %is_return, label %run_return, label %unsupported");
    try append_line(out, "run_return:");
    try append_executable_return(out, "2", "payload");
    try append_line(out, "unsupported:");
    try append_executable_return(out, "0", "payload");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_lower_test_executable_ast_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.selfhost.executable @kizu_selfhost__cli_lower_test_executable_ast(");
    try append_line(out, "  %kizu.selfhost.executable.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ast_kind = extractvalue %kizu.selfhost.executable.ast %ast, 0");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.executable.ast %ast, 1");
    try append_line(out, "  %is_ok = icmp eq i64 %ast_kind, 3");
    try append_line(out, "  br i1 %is_ok, label %test_ok, label %check_failure");
    try append_line(out, "test_ok:");
    try append_executable_return(out, "3", "payload");
    try append_line(out, "check_failure:");
    try append_line(out, "  %is_failure = icmp eq i64 %ast_kind, 4");
    try append_line(out, "  br i1 %is_failure, label %test_failure, label %unsupported");
    try append_line(out, "test_failure:");
    try append_executable_return(out, "4", "payload");
    try append_line(out, "unsupported:");
    try append_executable_return(out, "0", "payload");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_empty_payload(out: &var std::string::String) -> !void {
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %empty_base = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out, "  %empty = insertvalue %kizu.slice.u8 %empty_base, i64 0, 1");
    return;
}

fn append_executable_ast_return(
    out: &var std::string::String,
    kind: []u8,
    payload: []u8
) -> !void {
    try out.append_bytes("  %ast_kinded");
    try out.append_bytes(kind);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast zeroinitializer, i64 ");
    try out.append_bytes(kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %ast_result");
    try out.append_bytes(kind);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable.ast %ast_kinded");
    try out.append_bytes(kind);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(payload);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable.ast %ast_result");
    try out.append_bytes(kind);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_executable_return(
    out: &var std::string::String,
    kind: []u8,
    payload: []u8
) -> !void {
    try out.append_bytes("  %kinded");
    try out.append_bytes(kind);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable zeroinitializer, i64 ");
    try out.append_bytes(kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %result");
    try out.append_bytes(kind);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable %kinded");
    try out.append_bytes(kind);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(payload);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable %result");
    try out.append_bytes(kind);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_cli_run_payload_is_simple_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_run_payload_is_simple(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %len");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %offset = phi i64 [ 0, %entry ], [ %next, %advance ]");
    try append_line(out, "  %done = icmp eq i64 %offset, %len");
    try append_line(out, "  br i1 %done, label %true, label %load");
    try append_line(out, "load:");
    try append_line(out, "  %index = add i64 %start, %offset");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %min_ok = icmp uge i8 %byte, 32");
    try append_line(out, "  %max_ok = icmp ule i8 %byte, 126");
    try append_line(out, "  %range_ok = and i1 %min_ok, %max_ok");
    try append_line(out, "  %is_quote = icmp eq i8 %byte, 34");
    try append_line(out, "  %not_special = xor i1 %is_quote, true");
    try append_line(out, "  %safe = and i1 %range_ok, %not_special");
    try append_line(out, "  br i1 %safe, label %advance, label %false");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %offset, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_run_print_payload_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__cli_run_print_payload(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %body_start = call i64 @kizu_selfhost__cli_run_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_body = icmp sge i64 %body_start, 0");
    try append_line(out, "  br i1 %has_body, label %check_print, label %continue");
    try append_test_next_word_check(
        out,
        "print",
        "body_start",
        "5",
        "112",
        "114",
        "105",
        "110",
        "116",
        "0",
        "0",
        "check_print_lparen",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "print_lparen",
        "print_end",
        "40",
        "check_arg",
        "continue"
    );
    try append_line(out, "check_arg:");
    try append_line(out,
        "  %arg_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %print_lparen_end)");
    try append_line(out, "  %arg_in_bounds = icmp slt i64 %arg_start, %source_len");
    try append_line(out, "  br i1 %arg_in_bounds, label %load_arg, label %continue");
    try append_line(out, "load_arg:");
    try append_line(out,
        "  %arg_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %arg_start)");
    try append_line(out,
        "  %arg_len = sub i64 %arg_end, %arg_start");
    try append_line(out, "  %arg_has_quotes = icmp sge i64 %arg_len, 2");
    try append_line(out, "  br i1 %arg_has_quotes, label %load_quote, label %continue");
    try append_line(out, "load_quote:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %quote_start_ptr = getelementptr i8, ptr %source_ptr, i64 %arg_start");
    try append_line(out, "  %quote_start = load i8, ptr %quote_start_ptr");
    try append_line(out, "  %quote_start_ok = icmp eq i8 %quote_start, 34");
    try append_line(out, "  %quote_end_index = sub i64 %arg_end, 1");
    try append_line(out, "  %quote_end_ptr = getelementptr i8, ptr %source_ptr, i64 %quote_end_index");
    try append_line(out, "  %quote_end = load i8, ptr %quote_end_ptr");
    try append_line(out, "  %quote_end_ok = icmp eq i8 %quote_end, 34");
    try append_line(out, "  %quotes_ok = and i1 %quote_start_ok, %quote_end_ok");
    try append_line(out, "  br i1 %quotes_ok, label %validate_payload, label %continue");
    try append_line(out, "validate_payload:");
    try append_line(out, "  %payload_start = add i64 %arg_start, 1");
    try append_line(out, "  %payload_len = sub i64 %arg_len, 2");
    try append_line(out,
        "  %payload_ok = call i1 @kizu_selfhost__cli_run_payload_is_simple(%kizu.slice.u8 %source, i64 %payload_start, i64 %payload_len)");
    try append_line(out, "  br i1 %payload_ok, label %check_print_rparen, label %continue");
    try append_test_next_token_char_check(
        out,
        "print_rparen",
        "arg_end",
        "41",
        "check_print_semicolon",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "print_semicolon",
        "print_rparen_end",
        "59",
        "check_rbrace",
        "continue"
    );
    try append_test_next_token_char_check(
        out,
        "rbrace",
        "print_semicolon_end",
        "125",
        "check_eof",
        "continue"
    );
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %found, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  br label %not_found");
    try append_line(out, "found:");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %source_ptr, i64 %payload_start");
    try append_line(out, "  %payload_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload = insertvalue %kizu.slice.u8 %payload_base, i64 %payload_len, 1");
    try append_line(out,
        "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %payload, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "not_found:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

