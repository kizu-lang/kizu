// Hand an emitted LLVM module to LLVM and report whether LLVM will have it.
//
// `stage: ok` meant "the emitter returned" for as long as anyone had looked, and a
// module carrying three duplicate local names passed under it: nothing between the
// emitter and the linker ever read the whole thing. Both readers are used when both
// are present because they answer different halves -- clang's IR reader rejects the
// parse-level class (a name defined twice) and accepts a dominance violation at -O0,
// while opt runs the verifier, which rejects one.
//
// Neither reader being on PATH is an error rather than a skip. A silent skip is
// exactly how the unread module survived, and staging already spawns clang to link
// what it emits, so a toolchain that cannot read a module cannot link one either.

pub fn module_reader_missing_code() -> i64 {
    return 127;
}

pub fn opt_reader_tool() -> []u8 {
    return "opt";
}

pub fn opt_reader_verify_flag() -> []u8 {
    return "-passes=verify";
}

pub fn opt_reader_quiet_flag() -> []u8 {
    return "-disable-output";
}

pub fn clang_reader_tool() -> []u8 {
    return "clang";
}

pub fn clang_reader_language_flag() -> []u8 {
    return "-x";
}

pub fn clang_reader_language() -> []u8 {
    return "ir";
}

pub fn clang_reader_compile_flag() -> []u8 {
    return "-c";
}

// The module names its own target triple and clang warns when that differs from the
// host default. Reading a module is not compiling it for this host, so the warning
// carries no information here and would otherwise be the first line `stage` prints.
pub fn clang_reader_quiet_flag() -> []u8 {
    return "-Wno-override-module";
}

pub fn clang_reader_output_flag() -> []u8 {
    return "-o";
}

pub fn clang_reader_output_path() -> []u8 {
    return "/dev/null";
}

// read_with_opt runs the LLVM verifier over the module.
pub fn read_with_opt(ll_path: &[]u8) -> !i64 {
    return try std::process::spawn_wait8(
        4,
        opt_reader_tool(),
        opt_reader_verify_flag(),
        opt_reader_quiet_flag(),
        ll_path,
        "",
        "",
        "",
        ""
    );
}

// read_with_clang parses the module through clang's IR reader.
pub fn read_with_clang(ll_path: &[]u8) -> !i64 {
    return try std::process::spawn_wait8(
        8,
        clang_reader_tool(),
        clang_reader_quiet_flag(),
        clang_reader_language_flag(),
        clang_reader_language(),
        ll_path,
        clang_reader_compile_flag(),
        clang_reader_output_flag(),
        clang_reader_output_path()
    );
}

// read_module fails unless at least one LLVM reader accepted the module.
pub fn read_module(ll_path: &[]u8) -> !i64 {
    var readers = 0;
    let opt_code = try read_with_opt(ll_path);
    if opt_code != module_reader_missing_code() {
        readers = readers + 1;
        if opt_code != 0 {
            return error("stage: the LLVM verifier rejected the staged module");
        }
    }
    let clang_code = try read_with_clang(ll_path);
    if clang_code != module_reader_missing_code() {
        readers = readers + 1;
        if clang_code != 0 {
            return error("stage: clang rejected the staged module");
        }
    }
    if readers == 0 {
        return error("stage: neither opt nor clang is on PATH, so the module went unread");
    }
    return readers;
}
