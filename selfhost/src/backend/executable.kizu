import selfhost::backend::data;

pub fn lower_run_executable(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::Executable {
    let executable_ast = try parse_run_executable_ast(text, ast, root);
    return lower_run_executable_ast(executable_ast);
}

pub fn parse_run_executable_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::ExecutableAst {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try parse_run_program_ast(text, ast, program.declarations),
        _ => unsupported_executable_ast(text),
    };
}

pub fn lower_run_executable_ast(executable_ast: data::ExecutableAst) -> data::Executable {
    if executable_ast.kind == data::ExecutableAstKind::RunPrintCall {
        return data::Executable {
            kind: run_print_executable_kind(),
            stdout_payload: executable_ast.payload
        };
    }
    if executable_ast.kind == data::ExecutableAstKind::RunReturnVoid {
        return data::Executable {
            kind: run_return_executable_kind(),
            stdout_payload: executable_ast.payload
        };
    }
    return unsupported_executable(executable_ast.payload);
}

pub fn lower_test_executable(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::Executable {
    let executable_ast = try parse_test_executable_ast(text, ast, root);
    return lower_test_executable_ast(executable_ast);
}

pub fn parse_test_executable_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    root: std::kizu::ast::NodeId
) -> !data::ExecutableAst {
    let node = ast.get(root);
    return match node.data {
        Program(program) => try parse_test_program_ast(text, ast, program.declarations),
        _ => unsupported_executable_ast(text),
    };
}

pub fn lower_test_executable_ast(executable_ast: data::ExecutableAst) -> data::Executable {
    if executable_ast.kind == data::ExecutableAstKind::TestExpectTrue {
        return data::Executable {
            kind: test_ok_executable_kind(),
            stdout_payload: executable_ast.payload
        };
    }
    if executable_ast.kind == data::ExecutableAstKind::TestExpectFalse {
        return data::Executable {
            kind: test_failure_executable_kind(),
            stdout_payload: executable_ast.payload
        };
    }
    return unsupported_executable(executable_ast.payload);
}

pub fn unsupported_executable_ast_kind_tag() -> !i64 {
    return try data::executable_ast_kind_tag_by_name("Unsupported");
}

pub fn run_print_executable_ast_kind_tag() -> !i64 {
    return try data::executable_ast_kind_tag_by_name("RunPrintCall");
}

pub fn run_return_executable_ast_kind_tag() -> !i64 {
    return try data::executable_ast_kind_tag_by_name("RunReturnVoid");
}

pub fn test_ok_executable_ast_kind_tag() -> !i64 {
    return try data::executable_ast_kind_tag_by_name("TestExpectTrue");
}

pub fn test_failure_executable_ast_kind_tag() -> !i64 {
    return try data::executable_ast_kind_tag_by_name("TestExpectFalse");
}

