    return data::ExecutableKind::Unsupported;
}

pub fn run_print_executable_kind() -> data::ExecutableKind {
    return data::ExecutableKind::RunPrintString;
}

pub fn run_return_executable_kind() -> data::ExecutableKind {
    return data::ExecutableKind::RunReturnVoid;
}

pub fn test_ok_executable_kind() -> data::ExecutableKind {
    return data::ExecutableKind::TestExpectOk;
}

pub fn test_failure_executable_kind() -> data::ExecutableKind {
    return data::ExecutableKind::TestExpectFailure;
}

pub fn unsupported_executable_kind_tag() -> !i64 {
    return try data::executable_kind_tag_by_name("Unsupported");
}

pub fn run_print_executable_kind_tag() -> !i64 {
    return try data::executable_kind_tag_by_name("RunPrintString");
}

pub fn run_return_executable_kind_tag() -> !i64 {
    return try data::executable_kind_tag_by_name("RunReturnVoid");
}

pub fn test_ok_executable_kind_tag() -> !i64 {
    return try data::executable_kind_tag_by_name("TestExpectOk");
}

pub fn test_failure_executable_kind_tag() -> !i64 {
    return try data::executable_kind_tag_by_name("TestExpectFailure");
}

pub fn run_executable_lowering_case_count() -> i64 {
    return 2;
}

pub fn run_executable_lowering_case_ast_kind_tag(index: i64) -> !i64 {
    if index == 0 {
        return try run_print_executable_ast_kind_tag();
    }
    if index == 1 {
        return try run_return_executable_ast_kind_tag();
    }
    return error("invalid run executable lowering case");
}

pub fn run_executable_lowering_case_result_kind_tag(index: i64) -> !i64 {
    if index == 0 {
        return try run_print_executable_kind_tag();
    }
    if index == 1 {
        return try run_return_executable_kind_tag();
    }
    return error("invalid run executable lowering case");
}

pub fn test_executable_lowering_case_count() -> i64 {
    return 2;
}

pub fn test_executable_lowering_case_ast_kind_tag(index: i64) -> !i64 {
    if index == 0 {
        return try test_ok_executable_ast_kind_tag();
    }
    if index == 1 {
        return try test_failure_executable_ast_kind_tag();
    }
    return error("invalid test executable lowering case");
}

pub fn test_executable_lowering_case_result_kind_tag(index: i64) -> !i64 {
    if index == 0 {
        return try test_ok_executable_kind_tag();
    }
    if index == 1 {
        return try test_failure_executable_kind_tag();
    }
    return error("invalid test executable lowering case");
}

pub fn run_literal_quote_byte() -> i64 {
    return 34;
}

pub fn run_literal_min_length() -> i64 {
    return run_literal_payload_delimiter_width();
}

pub fn run_literal_start_quote_offset() -> i64 {
    return 0;
}

pub fn run_literal_end_quote_offset_from_end() -> i64 {
    return 1;
}

pub fn run_literal_payload_start_offset() -> i64 {
    return 1;
}

pub fn run_literal_payload_end_margin() -> i64 {
    return 1;
}

pub fn run_literal_payload_delimiter_width() -> i64 {
    return run_literal_payload_start_offset() + run_literal_payload_end_margin();
}

pub fn run_payload_min_byte() -> i64 {
    return 32;
}

pub fn run_payload_max_byte() -> i64 {
    return 126;
}

pub fn run_payload_forbidden_byte() -> i64 {
    return run_literal_quote_byte();
}

pub fn test_expect_true_value() -> i64 {
    return 1;
}

pub fn test_expect_false_value() -> i64 {
    return 0;
}

pub fn test_expect_unsupported_value() -> i64 {
    return -1;
}

pub fn parser_source_token(token_key: []u8) -> ![]u8 {
    if std::mem::equal_bytes(token_key, "syntax-fn") {
        return "fn";
    }
    if std::mem::equal_bytes(token_key, "syntax-test") {
        return "test";
    }
    if std::mem::equal_bytes(token_key, "syntax-lparen") {
        return "(";
    }
    if std::mem::equal_bytes(token_key, "syntax-rparen") {
        return ")";
    }
    if std::mem::equal_bytes(token_key, "syntax-lbrace") {
        return "{";
    }
    if std::mem::equal_bytes(token_key, "syntax-rbrace") {
        return "}";
    }
    if std::mem::equal_bytes(token_key, "syntax-semicolon") {
        return ";";
    }
    if std::mem::equal_bytes(token_key, "syntax-colon-pair") {
        return "::";
    }
    if std::mem::equal_bytes(token_key, "syntax-return-arrow") {
        return "->";
    }
    if std::mem::equal_bytes(token_key, "syntax-bang") {
        return "!";
    }
    if std::mem::equal_bytes(token_key, "syntax-return") {
        return "return";
    }
    if std::mem::equal_bytes(token_key, "syntax-void") {
        return "void";
    }
    if std::mem::equal_bytes(token_key, "value-main") {
        return "main";
    }
    if std::mem::equal_bytes(token_key, "run-print-callee") {
        return "print";
    }
    if std::mem::equal_bytes(token_key, "expect-callee-root") {
        return "std";
    }
    if std::mem::equal_bytes(token_key, "expect-callee-module") {
        return "testing";
    }
    if std::mem::equal_bytes(token_key, "expect-callee-function") {
        return "expect";
    }
    if std::mem::equal_bytes(token_key, "literal-true") {
        return "true";
    }
    if std::mem::equal_bytes(token_key, "literal-false") {
        return "false";
    }
    return error("invalid executable parser token");
}

fn parse_run_program_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !data::ExecutableAst {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let executable_ast = match node.data {
            FnDecl(fn_decl) => try parse_run_fn_ast(text, ast, fn_decl.name, fn_decl.body),
            _ => unsupported_executable_ast(text),
        };
        if executable_ast.kind != data::ExecutableAstKind::Unsupported {
            return executable_ast;
        }
        index = index + 1;
    }
    return unsupported_executable_ast(text);
}

fn parse_run_fn_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !data::ExecutableAst {
    if !std::mem::equal_bytes(ast_node_text(text, ast, name), "main") {
        return unsupported_executable_ast(text);
    }
    let node = ast.get(body);
    return match node.data {
        Block(block) => try parse_run_block_ast(text, ast, block.statements),
        _ => unsupported_executable_ast(text),
    };
}

fn parse_run_block_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    statements: std::kizu::ast::ChildRange
) -> !data::ExecutableAst {
    if statements.len != 1 {
        return unsupported_executable_ast(text);
    }
    let statement = try ast.child_at(statements, 0);
    let node = ast.get(statement);
    return match node.data {
        ExprStmt(expr_stmt) => try parse_run_print_stmt_ast(text, ast, expr_stmt.expr),
        Return(return_node) => parse_run_return_stmt_ast(text, ast, return_node.value),
        _ => unsupported_executable_ast(text),
    };
}

fn parse_run_return_stmt_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    value: std::kizu::ast::NodeId
) -> data::ExecutableAst {
    if !is_empty_node(ast, value) {
        return unsupported_executable_ast(text);
    }
    return data::ExecutableAst {
        kind: data::ExecutableAstKind::RunReturnVoid,
        payload: text[0..0]
    };
}

fn parse_run_print_stmt_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> !data::ExecutableAst {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try parse_run_print_call_ast(text, ast, call_node.callee, call_node.args),
        _ => unsupported_executable_ast(text),
    };
}

fn parse_run_print_call_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !data::ExecutableAst {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "print") or args.len != 1 {
        return unsupported_executable_ast(text);
    }
    let arg = try ast.child_at(args, 0);
    let payload = run_string_literal_payload(text, ast, arg);
    if payload.kind == data::ExecutableAstKind::RunPrintCall {
        return data::ExecutableAst {
            kind: data::ExecutableAstKind::RunPrintCall,
            payload: payload.payload
        };
    }
    return unsupported_executable_ast(text);
}

fn run_string_literal_payload(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> data::ExecutableAst {
    let node = ast.get(node_id);
    return match node.data {
        String(string_node) => run_payload_from_literal(text, ast_node_text(text, ast, node_id)),
        _ => unsupported_executable_ast(text),
    };
}

fn run_payload_from_literal(text: []u8, literal: []u8) -> data::ExecutableAst {
    let length = std::mem::len(literal);
    if length < run_literal_min_length() {
        return unsupported_executable_ast(text);
    }
    let quote = cast<u8>(run_literal_quote_byte());
    if literal[run_literal_start_quote_offset()] != quote or
        literal[length - run_literal_end_quote_offset_from_end()] != quote {
        return unsupported_executable_ast(text);
    }
    let payload = literal[
        run_literal_payload_start_offset()..length - run_literal_payload_end_margin()
    ];
    if !is_supported_run_print_payload(payload) {
        return unsupported_executable_ast(text);
    }
    return data::ExecutableAst {
        kind: data::ExecutableAstKind::RunPrintCall,
        payload: payload
    };
}

fn is_supported_run_print_payload(payload: []u8) -> bool {
    var index = 0;
    let length = std::mem::len(payload);
    let min = cast<u8>(run_payload_min_byte());
    let max = cast<u8>(run_payload_max_byte());
    let forbidden = cast<u8>(run_payload_forbidden_byte());
    while index < length {
        let byte = payload[index];
        if byte < min or byte > max {
            return false;
        }
        if byte == forbidden {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn parse_test_program_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !data::ExecutableAst {
    var index = 0;
    while index < declarations.len {
        let child = try ast.child_at(declarations, index);
        let node = ast.get(child);
        let executable_ast = match node.data {
            FnDecl(fn_decl) => try parse_test_fn_ast(
                text,
                ast,
                fn_decl.name,
                fn_decl.return_type,
                fn_decl.body
            ),
            _ => unsupported_executable_ast(text),
        };
        if executable_ast.kind != data::ExecutableAstKind::Unsupported {
            return executable_ast;
        }
        index = index + 1;
    }
    return unsupported_executable_ast(text);
}

fn parse_test_fn_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    return_type: std::kizu::ast::NodeId,
    body: std::kizu::ast::NodeId
) -> !data::ExecutableAst {
    if !is_test_decl_name(ast, name) {
        return unsupported_executable_ast(text);
    }
    let node = ast.get(body);
    return match node.data {
        Block(block) => try parse_test_block_ast(text, ast, return_type, block.statements),
        _ => unsupported_executable_ast(text),
    };
}

fn is_test_decl_name(ast: std::kizu::ast::Ast, name: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(name);
    return match node.data {
        String(string_node) => true,
        _ => false,
    };
}

fn parse_test_block_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    return_type: std::kizu::ast::NodeId,
    statements: std::kizu::ast::ChildRange
) -> !data::ExecutableAst {
    if statements.len == 1 and is_void_return_type(text, ast, return_type) {
        let expect_statement = try ast.child_at(statements, 0);
        return parse_test_expect_statement_ast(text, ast, expect_statement);
    }
    if statements.len != 2 {
        return unsupported_executable_ast(text);
    }
    let expect_statement = try ast.child_at(statements, 0);
    let return_statement = try ast.child_at(statements, 1);
    if !is_empty_return(ast, return_statement) {
        return unsupported_executable_ast(text);
    }
    return parse_test_expect_statement_ast(text, ast, expect_statement);
}

fn parse_test_expect_statement_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expect_statement: std::kizu::ast::NodeId
) -> !data::ExecutableAst {
    let node = ast.get(expect_statement);
    return match node.data {
        ExprStmt(expr_stmt) => try parse_expect_stmt_ast(text, ast, expr_stmt.expr),
        _ => unsupported_executable_ast(text),
    };
}

fn is_void_return_type(
    text: []u8,
    ast: std::kizu::ast::Ast,
    return_type: std::kizu::ast::NodeId
) -> bool {
    let node = ast.get(return_type);
    return match node.data {
        Empty => true,
        TypeName(type_name) => std::mem::equal_bytes(
            ast_node_text(text, ast, return_type),
            "void"
        ),
        _ => false,
    };
}

fn parse_expect_stmt_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    expr: std::kizu::ast::NodeId
) -> !data::ExecutableAst {
    let node = ast.get(expr);
    return match node.data {
        Call(call_node) => try parse_expect_call_ast(text, ast, call_node.callee, call_node.args),
        _ => unsupported_executable_ast(text),
    };
}

fn parse_expect_call_ast(
    text: []u8,
    ast: std::kizu::ast::Ast,
    callee: std::kizu::ast::NodeId,
    args: std::kizu::ast::ChildRange
) -> !data::ExecutableAst {
    if !std::mem::equal_bytes(ast_node_text(text, ast, callee), "std::testing::expect") or
        args.len != 1 {
        return unsupported_executable_ast(text);
    }
    let arg = try ast.child_at(args, 0);
    let expect = expect_bool_value(ast, arg);
    if expect == test_expect_true_value() {
        return data::ExecutableAst {
            kind: data::ExecutableAstKind::TestExpectTrue,
            payload: text[0..0]
        };
    }
    if expect == test_expect_false_value() {
        return data::ExecutableAst {
            kind: data::ExecutableAstKind::TestExpectFalse,
            payload: text[0..0]
        };
    }
    return unsupported_executable_ast(text);
}

fn is_empty_return(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Return(return_node) => is_empty_node(ast, return_node.value),
        _ => false,
    };
}

fn is_empty_node(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> bool {
    let node = ast.get(node_id);
    return match node.data {
        Empty => true,
        _ => false,
    };
}

fn expect_bool_value(ast: std::kizu::ast::Ast, node_id: std::kizu::ast::NodeId) -> i64 {
    let node = ast.get(node_id);
    return match node.data {
        Bool(bool_node) => bool_value_as_i64(bool_node.value),
        _ => test_expect_unsupported_value(),
    };
}

fn bool_value_as_i64(value: bool) -> i64 {
    if value {
        return test_expect_true_value();
    }
    return test_expect_false_value();
}

fn unsupported_executable_ast(text: []u8) -> data::ExecutableAst {
    return data::ExecutableAst {
        kind: data::ExecutableAstKind::Unsupported,
        payload: text[0..0]
    };
}

fn unsupported_executable(payload: []u8) -> data::Executable {
    return data::Executable {
        kind: unsupported_executable_kind(),
        stdout_payload: payload
    };
}

fn ast_node_text(
    text: []u8,
    ast: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast.get(node_id);
    let span = &node.span;
    return std::mem::trim_ascii(text[span.start..span.end]);
}
