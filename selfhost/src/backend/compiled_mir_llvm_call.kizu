import selfhost::backend::compiled_mir;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_util;

pub fn append_call_return(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    inst: &compiled_mir::MirCallInst
) -> !void {
    try append_call_string_globals(out, function.name, &function.call_args);
    try out.append_bytes("define ");
    try out.append_bytes(function.return_type.llvm_name);
    try out.append_bytes(" @");
    try out.append_bytes(function.name);
    try out.append_bytes("(");
    try compiled_signature::append_params_signature(out, function.params_spec);
    try out.append_bytes(") {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    try append_call_arg_setup(out, function.name, &function.call_args);
    try out.append_bytes("  %");
    try out.append_bytes(inst.result.payload);
    try out.append_bytes(" = call ");
    try out.append_bytes(function.return_type.llvm_name);
    try out.append_bytes(" @");
    try append_callee_symbol(
        out,
        inst.module_prefix,
        inst.callee_name
    );
    try out.append_bytes("(");
    try append_call_args(out, &function.call_args);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret ");
    try out.append_bytes(function.return_type.llvm_name);
    try out.append_bytes(" %");
    try out.append_bytes(function.entry.terminator.value.payload);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}

pub fn append_call_string_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    args: &std::array::Array<compiled_mir::MirCallArg>
) -> !void {
    var index = 0;
    while index < args.len() {
        let arg = try args.at(index);
        if arg.kind == compiled_mir::MirCallArgKind::String {
            let quote = cast<u8>(34);
            let payload_len = try compiled_util::string_token_decoded_len(
                arg.value,
                "compiled mir llvm: invalid call string token"
            );
            try out.append_bytes("@.kizu.compiled.");
            try out.append_bytes(llvm_symbol);
            try out.append_bytes(".s");
            try std::fmt::append_i64(out, arg.string_index);
            try out.append_bytes(" = private unnamed_addr constant [");
            try std::fmt::append_i64(out, payload_len);
            try out.append_bytes(" x i8] c");
            try out.append_byte(quote);
            try compiled_util::append_string_token_payload(
                out,
                arg.value,
                "compiled mir llvm: invalid call string token"
            );
            try out.append_byte(quote);
            try out.append_byte(cast<u8>(10));
        } else {
            if arg.kind == compiled_mir::MirCallArgKind::Call {
                try append_call_string_globals(out, llvm_symbol, &arg.call_args);
            }
        }
        index = index + 1;
    }
    return;
}

pub fn append_call_arg_setup(
    out: &var std::string::String,
    llvm_symbol: []u8,
    args: &std::array::Array<compiled_mir::MirCallArg>
) -> !void {
    try append_call_arg_setup_with_prefix(out, llvm_symbol, args, 0);
    return;
}

pub fn append_call_arg_setup_with_prefix(
    out: &var std::string::String,
    llvm_symbol: []u8,
    args: &std::array::Array<compiled_mir::MirCallArg>,
    call_prefix: i64
) -> !void {
    var index = 0;
    while index < args.len() {
        let arg = try args.at(index);
        if arg.kind == compiled_mir::MirCallArgKind::String {
            let payload_len = try compiled_util::string_token_decoded_len(
                arg.value,
                "compiled mir llvm: invalid call string token"
            );
            try out.append_bytes("  ");
            try append_arg_local_name(out, call_prefix, index);
            try out.append_bytes("_ptr = getelementptr [");
            try std::fmt::append_i64(out, payload_len);
            try out.append_bytes(" x i8], ptr @.kizu.compiled.");
            try out.append_bytes(llvm_symbol);
            try out.append_bytes(".s");
            try std::fmt::append_i64(out, arg.string_index);
            try out.append_bytes(", i64 0, i64 0");
            try out.append_byte(cast<u8>(10));
            try out.append_bytes("  ");
            try append_arg_local_name(out, call_prefix, index);
            try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr ");
            try append_arg_local_name(out, call_prefix, index);
            try out.append_bytes("_ptr, 0");
            try out.append_byte(cast<u8>(10));
            try out.append_bytes("  ");
            try append_arg_local_name(out, call_prefix, index);
            try out.append_bytes("_slice = insertvalue %kizu.slice.u8 ");
            try append_arg_local_name(out, call_prefix, index);
            try out.append_bytes("_base, i64 ");
            try std::fmt::append_i64(out, payload_len);
            try out.append_bytes(", 1");
            try out.append_byte(cast<u8>(10));
        } else {
            if arg.kind == compiled_mir::MirCallArgKind::FieldAccess {
                try out.append_bytes("  ");
                try append_arg_local_name(out, call_prefix, index);
                try out.append_bytes("_ex = extractvalue ");
                try out.append_bytes(arg.source_type);
                try out.append_bytes(" %");
                try out.append_bytes(arg.value);
                try out.append_bytes(", ");
                try std::fmt::append_i64(out, arg.source_field_index);
                try out.append_byte(cast<u8>(10));
                // Nested field access (root.a.b): chain a second extractvalue off
                // the intermediate _ex value, mirroring append_struct_field_access
                // (tracker 961). nested_field_index == -1 leaves it single-level.
                if arg.nested_field_index >= 0 {
                    try out.append_bytes("  ");
                    try append_arg_local_name(out, call_prefix, index);
                    try out.append_bytes("_exn = extractvalue ");
                    try out.append_bytes(arg.nested_source_type);
                    try out.append_bytes(" %");
                    try append_arg_label_base(out, call_prefix, index);
                    try out.append_bytes("_ex, ");
                    try std::fmt::append_i64(out, arg.nested_field_index);
                    try out.append_byte(cast<u8>(10));
                }
            } else {
                if arg.kind == compiled_mir::MirCallArgKind::Slice {
                    try append_slice_arg_setup(out, &arg, call_prefix, index);
                } else {
                    if arg.kind == compiled_mir::MirCallArgKind::Arith {
                        try append_arith_arg_setup(out, &arg, call_prefix, index);
                    } else {
                        if arg.kind == compiled_mir::MirCallArgKind::Call {
                            let nested_prefix = nested_call_arg_prefix(call_prefix, index);
                            try append_call_arg_setup_with_prefix(
                                out, llvm_symbol, &arg.call_args, nested_prefix
                            );
                            try out.append_bytes("  ");
                            try append_arg_local_name(out, call_prefix, index);
                            try out.append_bytes("_call = call ");
                            try out.append_bytes(arg.ty);
                            try out.append_bytes(" @");
                            try append_callee_symbol(
                                out, arg.call_module_prefix, arg.call_callee_name
                            );
                            try out.append_bytes("(");
                            try append_call_args_with_prefix(out, &arg.call_args, nested_prefix);
                            try out.append_bytes(")");
                            try out.append_byte(cast<u8>(10));
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    return;
}

// append_arith_arg_setup emits the pre-call instructions for an Arith call arg
// (tracker 961, scope 4 prerequisite). A field base extracts source_field_index off
// the Var receiver into %argN_ex first; both bases then add (or sub when bool_value)
// the literal into %argN_arith, which append_call_args references as the operand.
fn append_arith_arg_setup(
    out: &var std::string::String,
    arg: &compiled_mir::MirCallArg,
    call_prefix: i64,
    index: i64
) -> !void {
    if arg.source_field_index >= 0 {
        try out.append_bytes("  ");
        try append_arg_local_name(out, call_prefix, index);
        try out.append_bytes("_ex = extractvalue ");
        try out.append_bytes(arg.source_type);
        try out.append_bytes(" %");
        try out.append_bytes(arg.value);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, arg.source_field_index);
        try out.append_byte(cast<u8>(10));
    }
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    if arg.bool_value {
        try out.append_bytes("_arith = sub ");
    } else {
        try out.append_bytes("_arith = add ");
    }
    try out.append_bytes(arg.ty);
    try out.append_bytes(" ");
    if arg.source_field_index >= 0 {
        try append_arg_local_name(out, call_prefix, index);
        try out.append_bytes("_ex");
    } else {
        try out.append_bytes("%");
        try out.append_bytes(arg.value);
    }
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, arg.int_value);
    try out.append_byte(cast<u8>(10));
    return;
}

// append_slice_arg_bound emits the i64 bound register for a slice start/end. The
// static form adds a constant offset onto the base register (or onto 0 when base
// is empty for an Int bound). When field_index >= 0 the bound is a single-level
// field read off the base struct register (e.g. current.start): extractvalue the
// field off source_type %base into %argN<suffix>_ex first, then add the offset.
fn append_slice_arg_bound(
    out: &var std::string::String,
    call_prefix: i64,
    index: i64,
    suffix: []u8,
    base: []u8,
    offset: i64,
    source_type: []u8,
    field_index: i64
) -> !void {
    if field_index >= 0 {
        try out.append_bytes("  ");
        try append_arg_local_name(out, call_prefix, index);
        try out.append_bytes(suffix);
        try out.append_bytes("_ex = extractvalue ");
        try out.append_bytes(source_type);
        try out.append_bytes(" %");
        try out.append_bytes(base);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field_index);
        try out.append_byte(cast<u8>(10));
        try out.append_bytes("  ");
        try append_arg_local_name(out, call_prefix, index);
        try out.append_bytes(suffix);
        try out.append_bytes(" = add i64 ");
        try append_arg_local_name(out, call_prefix, index);
        try out.append_bytes(suffix);
        try out.append_bytes("_ex, ");
        try std::fmt::append_i64(out, offset);
        try out.append_byte(cast<u8>(10));
        return;
    }
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes(suffix);
    if std::mem::len(base) == 0 {
        try out.append_bytes(" = add i64 0, ");
    } else {
        try out.append_bytes(" = add i64 %");
        try out.append_bytes(base);
        try out.append_bytes(", ");
    }
    try std::fmt::append_i64(out, offset);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_slice_arg_setup(
    out: &var std::string::String,
    arg: &compiled_mir::MirCallArg,
    call_prefix: i64,
    index: i64
) -> !void {
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_sbase = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(arg.value);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_slice_arg_bound(
        out, call_prefix, index, "_sstart", arg.slice_start_base, arg.slice_start_offset,
        arg.slice_start_source_type, arg.slice_start_field_index
    );
    try append_slice_arg_bound(
        out, call_prefix, index, "_send", arg.slice_end_base, arg.slice_end_offset,
        arg.slice_end_source_type, arg.slice_end_field_index
    );
    try append_slice_arg_bounds_check(out, &arg, call_prefix, index);
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_sgep = getelementptr i8, ptr ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_sbase, i64 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_sstart");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_slen = sub i64 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_send, ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_sstart");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_s0 = insertvalue %kizu.slice.u8 poison, ptr ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_sgep, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_s0, i64 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_slen, 1");
    try out.append_byte(cast<u8>(10));
    return;
}

// append_slice_arg_bounds_check rejects an out-of-bounds byte slice before the
// getelementptr that would compute an invalid base pointer. Per ADR-0053 safe
// Kizu slicing must trap rather than read or point past the source buffer, so
// it reads the source length and traps when start is negative, end is before
// start, or end is past the source length. The branch shape mirrors the Go
// reference compiler writeSliceSlice. Labels derive from the call-arg name,
// which is already unique per call site within the function.
fn append_slice_arg_bounds_check(
    out: &var std::string::String,
    arg: &compiled_mir::MirCallArg,
    call_prefix: i64,
    index: i64
) -> !void {
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_srclen = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(arg.value);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_startneg = icmp slt i64 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_sstart, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_endbefore = icmp slt i64 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_send, ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_sstart");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_endhigh = icmp sgt i64 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_send, ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_srclen");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_badlower = or i1 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_startneg, ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_endbefore");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_bad = or i1 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_badlower, ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_endhigh");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 ");
    try append_arg_local_name(out, call_prefix, index);
    try out.append_bytes("_bad, label %");
    try append_arg_label_base(out, call_prefix, index);
    try out.append_bytes("_slice_oob, label %");
    try append_arg_label_base(out, call_prefix, index);
    try out.append_bytes("_slice_ok");
    try out.append_byte(cast<u8>(10));
    try append_arg_label_base(out, call_prefix, index);
    try out.append_bytes("_slice_oob:");
    try out.append_byte(cast<u8>(10));
    try compiled_util::append_trap_body(out);
    try append_arg_label_base(out, call_prefix, index);
    try out.append_bytes("_slice_ok:");
    try out.append_byte(cast<u8>(10));
    return;
}

fn nested_call_arg_prefix(call_prefix: i64, index: i64) -> i64 {
    // This base-1000 nesting scheme assumes each call has fewer than 1000 args.
    return 1000000 + (call_prefix * 1000) + index;
}

fn append_arg_local_name(
    out: &var std::string::String,
    call_prefix: i64,
    index: i64
) -> !void {
    try out.append_bytes("%arg");
    try std::fmt::append_i64(out, call_prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, index);
    return;
}

// append_arg_label_base renders the call-arg name without the leading percent
// so it can start a basic block label line. The percent-prefixed form from
// append_arg_local_name is used wherever the same name appears as an operand.
fn append_arg_label_base(
    out: &var std::string::String,
    call_prefix: i64,
    index: i64
) -> !void {
    try out.append_bytes("arg");
    try std::fmt::append_i64(out, call_prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, index);
    return;
}

pub fn append_call_args(
    out: &var std::string::String,
    args: &std::array::Array<compiled_mir::MirCallArg>
) -> !void {
    try append_call_args_with_prefix(out, args, 0);
    return;
}

pub fn append_call_args_with_prefix(
    out: &var std::string::String,
    args: &std::array::Array<compiled_mir::MirCallArg>,
    call_prefix: i64
) -> !void {
    var index = 0;
    while index < args.len() {
        if index > 0 {
            try out.append_bytes(", ");
        }
        let arg = try args.at(index);
        try out.append_bytes(arg.ty);
        try out.append_bytes(" ");
        try append_call_arg_value_with_prefix(out, &arg, call_prefix, index);
        index = index + 1;
    }
    return;
}

// append_call_arg_value_with_prefix renders one argument's value operand (without its
// type) so callers that marshal a single value through memory (the Array<T>.append
// element slot) share the exact operand spelling the call renderer uses.
pub fn append_call_arg_value_with_prefix(
    out: &var std::string::String,
    arg: &compiled_mir::MirCallArg,
    call_prefix: i64,
    index: i64
) -> !void {
    if arg.kind == compiled_mir::MirCallArgKind::Var {
            try out.append_bytes("%");
            try out.append_bytes(arg.value);
        } else {
            if arg.kind == compiled_mir::MirCallArgKind::String {
                try append_arg_local_name(out, call_prefix, index);
                try out.append_bytes("_slice");
            } else {
                if arg.kind == compiled_mir::MirCallArgKind::Bool {
                    if arg.bool_value {
                        try out.append_bytes("true");
                    } else {
                        try out.append_bytes("false");
                    }
                } else {
                    if arg.kind == compiled_mir::MirCallArgKind::FieldAccess {
                        try append_arg_local_name(out, call_prefix, index);
                        if arg.nested_field_index >= 0 {
                            try out.append_bytes("_exn");
                        } else {
                            try out.append_bytes("_ex");
                        }
                    } else {
                        if arg.kind == compiled_mir::MirCallArgKind::EmptySlice {
                            try out.append_bytes("zeroinitializer");
                        } else {
                            if arg.kind == compiled_mir::MirCallArgKind::Slice {
                                try append_arg_local_name(out, call_prefix, index);
                                try out.append_bytes("_slice");
                            } else {
                                if arg.kind == compiled_mir::MirCallArgKind::IntLiteral {
                                    try std::fmt::append_i64(out, arg.int_value);
                                } else {
                                    if arg.kind == compiled_mir::MirCallArgKind::Arith {
                                        try append_arg_local_name(out, call_prefix, index);
                                        try out.append_bytes("_arith");
                                    } else {
                                        if arg.kind == compiled_mir::MirCallArgKind::Temp {
                                            // A nested-call argument references an already-computed
                                            // expression temp %t<int_value>; no per-call setup runs.
                                            try out.append_bytes("%t");
                                            try std::fmt::append_i64(out, arg.int_value);
                                        } else {
                                            if arg.kind == compiled_mir::MirCallArgKind::Call {
                                                try append_arg_local_name(out, call_prefix, index);
                                                try out.append_bytes("_call");
                                            } else {
                                                return error("compiled mir llvm: unsupported call arg");
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    return;
}

pub fn append_callee_symbol(
    out: &var std::string::String,
    module_prefix: []u8,
    callee_name: []u8
) -> !void {
    if std::mem::len(module_prefix) == 0 {
        try out.append_bytes(callee_name);
        return;
    }
    try compiled_signature::derive_callee_llvm_symbol(out, module_prefix, callee_name);
    return;
}
