import selfhost::backend::data;
import selfhost::ir::codegen;

pub fn run_artifact_dir() -> []u8 {
    return "target/selfhost/cache/run";
}

pub fn run_artifact_path_prefix() -> []u8 {
    return "target/selfhost/cache/run/";
}

pub fn run_artifact_cache_dir() -> []u8 {
    return "target/selfhost/cache";
}

pub fn run_linker_tool() -> []u8 {
    return "clang";
}

pub fn run_linker_llvm_module_flag() -> []u8 {
    return "-Wno-override-module";
}

pub fn run_host_runtime_source() -> []u8 {
    return "selfhost/runtime/selfhost.hosted.c";
}

pub fn run_linker_output_flag() -> []u8 {
    return "-o";
}

pub fn test_artifact_dir() -> []u8 {
    return "target/selfhost/test";
}

pub fn test_artifact_path_prefix() -> []u8 {
    return "target/selfhost/test/";
}

pub fn artifact_ll_suffix() -> []u8 {
    return ".ll";
}

pub fn artifact_metadata_suffix() -> []u8 {
    return ".ll.meta";
}

pub fn run_metadata_title() -> []u8 {
    return "kizu-run-artifact-v0";
}

pub fn run_metadata_issue() -> []u8 {
    return "issue #569";
}

pub fn test_metadata_title() -> []u8 {
    return "kizu-test-artifact-v0";
}

pub fn test_metadata_issue() -> []u8 {
    return "issue #570";
}

pub fn metadata_source_prefix() -> []u8 {
    return "source ";
}

pub fn metadata_output_prefix() -> []u8 {
    return "output ";
}

pub fn metadata_abi_line() -> []u8 {
    return "abi selfhost-abi-v0";
}

pub fn metadata_entry_prefix() -> []u8 {
    return "entry @";
}

pub fn metadata_runtime_line() -> []u8 {
    return "runtime target/selfhost/selfhost.host.ll";
}

pub fn metadata_lowering_line() -> []u8 {
    return "executable_lowering selfhost::backend::executable checked-ast";
}

pub fn metadata_fallback_line() -> []u8 {
    return "go.cmd-kizu-fallback none";
}

pub fn metadata_mode_line() -> []u8 {
    return "artifact_mode hosted-artifact";
}

pub fn metadata_run_codegen_line() -> []u8 {
    return "run.codegen-ir enabled";
}

pub fn test_metadata_discovery_line() -> []u8 {
    return "discovery none";
}

pub fn run_print_executable() -> data::HostedExecutable {
    return data::HostedExecutable {
        comment: "kizu codegen run artifact ll v0",
        entry: "kizu_run_main",
        global: "kizu.run.stdout",
        codegen_ir: "none",
        output_stream: data::HostedOutputStream::Stdout,
        output_payload: "",
        append_newline: true,
        exit_code: 0
    };
}

pub fn test_ok_executable() -> data::HostedExecutable {
    return data::HostedExecutable {
        comment: "kizu test artifact ll v0",
        entry: "kizu_test_main",
        global: "kizu.test.ok",
        codegen_ir: "none",
        output_stream: data::HostedOutputStream::Stdout,
        output_payload: "test: ok",
        append_newline: true,
        exit_code: 0
    };
}

pub fn test_failure_executable() -> data::HostedExecutable {
    return data::HostedExecutable {
        comment: "kizu test artifact ll v0",
        entry: "kizu_test_main",
        global: "kizu.test.failure",
        codegen_ir: "none",
        output_stream: data::HostedOutputStream::Stderr,
        output_payload: "error: runtime error: expected condition to be true",
        append_newline: true,
        exit_code: 1
    };
}

pub fn emit_run_codegen_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    program: codegen::Program
) -> !data::RunArtifact {
    try codegen::require_lowered_main_print(&program);
    try ensure_hosted_artifact_dir(io, run_artifact_dir());

    var ll_path = try artifact_path(
        allocator,
        run_artifact_path_prefix(),
        source_path,
        artifact_ll_suffix()
    );
    var metadata_path = try artifact_path(
        allocator,
        run_artifact_path_prefix(),
        source_path,
        artifact_metadata_suffix()
    );
    let hosted = try hosted_executable_from_codegen(run_print_executable(), program);
    let ll_path_view = ll_path.as_bytes();
    let metadata_path_view = metadata_path.as_bytes();
    let module_len = try write_hosted_module(
        allocator,
        io,
        source_path,
        ll_path_view,
        &hosted
    );
    let metadata_len = try write_run_metadata(
        allocator,
        io,
        source_path,
        ll_path_view,
        metadata_path_view,
        &hosted
    );
    ll_path.deinit();
    metadata_path.deinit();
    return data::RunArtifact {
        bytes: module_len,
        metadata_bytes: metadata_len
    };
}

pub fn run_artifact_ll_path(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    return try artifact_path(
        allocator,
        run_artifact_path_prefix(),
        source_path,
        artifact_ll_suffix()
    );
}

pub fn run_artifact_executable_path(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    return try artifact_path(
        allocator,
        run_artifact_path_prefix(),
        source_path,
        ""
    );
}

pub fn link_run_artifact(
    ll_path: &[]u8,
    executable_path: &[]u8
) -> !i64 {
    return try std::process::spawn_wait8(
        7,
        run_linker_tool(),
        run_linker_llvm_module_flag(),
        ll_path,
        "target/selfhost/stage2/selfhost.host.ll",
        run_host_runtime_source(),
        run_linker_output_flag(),
        executable_path,
        ""
    );
}

pub fn execute_run_artifact(executable_path: &[]u8) -> !i64 {
    return try std::process::spawn_wait8(
        1,
        executable_path,
        "",
        "",
        "",
        "",
        "",
        "",
        ""
    );
}

pub fn emit_test_executable_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    executable: data::Executable
) -> !data::TestArtifact {
    try ensure_hosted_artifact_dir(io, test_artifact_dir());

    var ll_path = try artifact_path(
        allocator,
        test_artifact_path_prefix(),
        source_path,
        artifact_ll_suffix()
    );
    var metadata_path = try artifact_path(
        allocator,
        test_artifact_path_prefix(),
        source_path,
        artifact_metadata_suffix()
    );
    let artifact = try write_test_artifact(
        allocator,
        io,
        source_path,
        ll_path,
        metadata_path,
        executable
    );
    ll_path.deinit();
    metadata_path.deinit();
    return artifact;
}

fn hosted_executable_from_codegen(
    template: data::HostedExecutable,
    program: codegen::Program
) -> !data::HostedExecutable {
    let payload = try codegen::stdout_payload(&program);
    let codegen_ir = codegen::metadata_for_program(&program);
    return data::HostedExecutable {
        comment: template.comment,
        entry: template.entry,
        global: template.global,
        codegen_ir: codegen_ir,
        output_stream: template.output_stream,
        output_payload: payload,
        append_newline: template.append_newline,
        exit_code: template.exit_code
    };
}

fn ensure_hosted_artifact_dir(io: Io, leaf: []u8) -> !void {
    if !(try std::fs::exists(io, "target")) {
        try std::fs::create_dir(io, "target");
    }
    if !(try std::fs::exists(io, "target/selfhost")) {
        try std::fs::create_dir(io, "target/selfhost");
    }
    if std::mem::equal_bytes(leaf, run_artifact_dir()) and
        !(try std::fs::exists(io, run_artifact_cache_dir())) {
        try std::fs::create_dir(io, run_artifact_cache_dir());
    }
    if !(try std::fs::exists(io, leaf)) {
        try std::fs::create_dir(io, leaf);
    }
    return;
}

fn write_run_metadata(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &[]u8,
    metadata_path: &[]u8,
    hosted: &data::HostedExecutable
) -> !i64 {
    var metadata = std::string::String(allocator);
    try append_line(metadata, run_metadata_title());
    try append_line(metadata, run_metadata_issue());
    try append_common_metadata(metadata, source_path, ll_path, hosted);
    let metadata_len = try write_metadata(io, metadata_path, metadata);
    metadata.deinit();
    return metadata_len;
}

fn write_test_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &std::string::String,
    metadata_path: &std::string::String,
    executable: data::Executable
) -> !data::TestArtifact {
    let hosted = try lower_test_hosted_executable(source_path, executable);
    let ll_path_view = ll_path.as_bytes();
    let metadata_path_view = metadata_path.as_bytes();
    let module_len = try write_hosted_module(
        allocator,
        io,
        source_path,
        ll_path_view,
        &hosted
    );
    let metadata_len = try write_test_metadata(
        allocator,
        io,
        source_path,
        ll_path_view,
        metadata_path_view,
        &hosted
    );
    return data::TestArtifact {
        bytes: module_len,
        metadata_bytes: metadata_len
    };
}

fn lower_test_hosted_executable(
    source_path: []u8,
    executable: data::Executable
) -> !data::HostedExecutable {
    if executable.kind == data::ExecutableKind::Call and
        std::mem::equal_bytes(executable.callee, "std::testing::expect") and
        std::mem::equal_bytes(executable.payload, "true") {
        return test_ok_executable();
    }
    if executable.kind == data::ExecutableKind::Call and
        std::mem::equal_bytes(executable.callee, "std::testing::expect") and
        std::mem::equal_bytes(executable.payload, "false") {
        return test_failure_executable();
    }
    return error("unsupported test executable");
}

fn hosted_executable_with_payload(
    template: data::HostedExecutable,
    payload: []u8
) -> data::HostedExecutable {
    return data::HostedExecutable {
        comment: template.comment,
        entry: template.entry,
        global: template.global,
        codegen_ir: template.codegen_ir,
        output_stream: template.output_stream,
        output_payload: payload,
        append_newline: template.append_newline,
        exit_code: template.exit_code
    };
}

fn write_hosted_module(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &[]u8,
    hosted: &data::HostedExecutable
) -> !i64 {
    var module = try render_hosted_llvm(allocator, source_path, hosted);
    let module_view = module.as_bytes();
    let module_len = try write_backend_bytes(
        io,
        ll_path,
        module_view,
        module.len()
    );
    module.deinit();
    return module_len;
}

fn write_test_metadata(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &[]u8,
    metadata_path: &[]u8,
    hosted: &data::HostedExecutable
) -> !i64 {
    var metadata = std::string::String(allocator);
    try append_line(metadata, test_metadata_title());
    try append_line(metadata, test_metadata_issue());
    try append_common_metadata(metadata, source_path, ll_path, hosted);
    try append_line(metadata, test_metadata_discovery_line());
    let metadata_len = try write_metadata(io, metadata_path, metadata);
    metadata.deinit();
    return metadata_len;
}

fn append_common_metadata(
    metadata: &var std::string::String,
    source_path: []u8,
    ll_path: &[]u8,
    hosted: &data::HostedExecutable
) -> !void {
    try append_key_value(metadata, metadata_source_prefix(), source_path);
    try metadata.append_bytes(metadata_output_prefix());
    try metadata.append_bytes(ll_path);
    try metadata.append_byte(cast<u8>(10));
    try append_line(metadata, metadata_abi_line());
    try append_key_value(metadata, metadata_entry_prefix(), hosted.entry);
    try append_key_value(metadata, "codegen_ir ", hosted.codegen_ir);
    if !std::mem::equal_bytes(hosted.codegen_ir, "none") {
        try append_line(metadata, metadata_run_codegen_line());
    }
    try append_line(metadata, metadata_runtime_line());
    try append_line(metadata, metadata_lowering_line());
    try append_line(metadata, metadata_fallback_line());
    try append_line(metadata, metadata_mode_line());
    return;
}

fn write_metadata(
    io: Io,
    metadata_path: &[]u8,
    metadata: &std::string::String
) -> !i64 {
    let metadata_view = metadata.as_bytes();
    return try write_backend_bytes(
        io,
        metadata_path,
        metadata_view,
        metadata.len()
    );
}

fn artifact_path(
    allocator: Allocator,
    directory: []u8,
    source_path: []u8,
    suffix: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try out.append_bytes(directory);
    try out.append_bytes(artifact_stem(source_path));
    try out.append_bytes(suffix);
    return out;
}

fn artifact_stem(path: []u8) -> []u8 borrows path {
    let base = std::path::basename(path);
    let extension = std::path::extension(base);
    let base_len = std::mem::len(base);
    let extension_len = std::mem::len(extension);
    if extension_len < 1 {
        return base;
    }
    return base[0..base_len - extension_len];
}

fn write_backend_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_hosted_llvm(
    allocator: Allocator,
    source_path: []u8,
    hosted: &data::HostedExecutable
) -> !std::string::String {
    let comment = hosted.comment;
    let entry = hosted.entry;
    let global = hosted.global;
    let output_stream = hosted.output_stream;
    let output_payload = hosted.output_payload;
    let append_newline = hosted.append_newline;
    let exit_code = hosted.exit_code;
    var out = std::string::String(allocator);
    try append_hosted_header(out, source_path, comment, output_stream);
    if output_stream == data::HostedOutputStream::None {
        try append_hosted_return_body(out, entry, exit_code);
    } else {
        let output_len = hosted_output_len(output_payload, append_newline);
        try append_hosted_global(out, global, output_payload, append_newline, output_len);
        try append_hosted_output_body(out, entry, global, output_stream, output_len, exit_code);
    }
    try append_host_main(out, entry);
    return out;
}

fn append_hosted_header(
    out: &var std::string::String,
    source_path: []u8,
    comment: []u8,
    output_stream: data::HostedOutputStream
) -> !void {
    try out.append_bytes("; ");
    try out.append_bytes(comment);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    if output_stream != data::HostedOutputStream::None {
        try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
        try append_line(out, "%kizu.owned = type { ptr }");
        try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
        try append_line(out, "");
    }
    return;
}

fn hosted_output_len(output_payload: []u8, append_newline: bool) -> i64 {
    let length = std::mem::len(output_payload);
    if append_newline {
        return length + 1;
    }
    return length;
}

fn append_hosted_global(
    out: &var std::string::String,
    global: []u8,
    output_payload: []u8,
    append_newline: bool,
    output_len: i64
) -> !void {
    try out.append_bytes("@.");
    try out.append_bytes(global);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try append_llvm_c_string_payload(out, output_payload);
    if append_newline {
        try out.append_bytes("\0A");
    }
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_hosted_output_body(
    out: &var std::string::String,
    entry: []u8,
    global: []u8,
    output_stream: data::HostedOutputStream,
    output_len: i64,
    exit_code: i64
) -> !void {
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("declare %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(hosted_stream_name(output_stream));
    try out.append_bytes("(%kizu.owned, %kizu.slice.u8)");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("define i64 @");
    try out.append_bytes(entry);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("  %ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(" x i8], ptr @.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try out.append_bytes("  %slice = insertvalue %kizu.slice.u8 %base, i64 ");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %write = call %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(hosted_stream_name(output_stream));
    try out.append_bytes("(%kizu.owned %io, %kizu.slice.u8 %slice)");
    try out.append_byte(cast<u8>(10));
    try append_exit(out, exit_code);
    return;
}

fn append_hosted_return_body(
    out: &var std::string::String,
    entry: []u8,
    exit_code: i64
) -> !void {
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("define i64 @");
    try out.append_bytes(entry);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "entry:");
    try append_exit(out, exit_code);
    return;
}

fn append_exit(out: &var std::string::String, exit_code: i64) -> !void {
    try out.append_bytes("  %code = call i64 @kizu_rt_process_exit_code(i64 ");
    try std::fmt::append_i64(out, exit_code);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return;
}

fn append_host_main(out: &var std::string::String, entry: []u8) -> !void {
    try append_line(out, "");
    try append_line(out, "declare void @kizu_host_init(i32, ptr)");
    try append_line(out, "");
    try append_line(out, "define i32 @main(i32 %argc, ptr %argv) {");
    try append_line(out, "entry:");
    try append_line(out, "  call void @kizu_host_init(i32 %argc, ptr %argv)");
    try out.append_bytes("  %code = call i64 @");
    try out.append_bytes(entry);
    try out.append_bytes("()");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %exit = trunc i64 %code to i32");
    try append_line(out, "  ret i32 %exit");
    try append_line(out, "}");
    return;
}

fn hosted_stream_name(stream: data::HostedOutputStream) -> []u8 {
    if stream == data::HostedOutputStream::Stdout {
        return "stdout";
    }
    return "stderr";
}

fn append_llvm_c_string_payload(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte == cast<u8>(34) {
            try out.append_bytes("\22");
        } else {
            if byte == cast<u8>(92) {
                try out.append_bytes("\5C");
            } else {
                if byte == cast<u8>(10) {
                    try out.append_bytes("\0A");
                } else {
                    try out.append_byte(byte);
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn append_key_value(
    out: &var std::string::String,
    key: []u8,
    value: []u8
) -> !void {
    try out.append_bytes(key);
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
