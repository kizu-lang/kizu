import selfhost::backend::data;

pub fn emit_run_hello_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8
) -> !data::RunArtifact {
    try std::fs::create_dir(io, "target/selfhost/run");

    var module = try render_run_hello_llvm(allocator, source_path);
    let module_view = module.as_bytes();
    let module_len = try write_backend_bytes(
        io,
        "target/selfhost/run/run_hello.ll",
        module_view,
        module.len()
    );
    module.deinit();

    var metadata = try render_run_hello_metadata(allocator, source_path);
    let metadata_view = metadata.as_bytes();
    let metadata_len = try write_backend_bytes(
        io,
        "target/selfhost/run/run_hello.ll.meta",
        metadata_view,
        metadata.len()
    );
    metadata.deinit();

    return data::RunArtifact {
        ll_path: "target/selfhost/run/run_hello.ll",
        metadata_path: "target/selfhost/run/run_hello.ll.meta",
        bytes: module_len,
        metadata_bytes: metadata_len
    };
}

pub fn emit_test_expect_ok_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8
) -> !data::TestArtifact {
    try std::fs::create_dir(io, "target/selfhost/test");

