import selfhost::backend::data;

pub fn emit_run_executable_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    executable: data::RunExecutable
) -> !data::RunArtifact {
    try std::fs::create_dir(io, "target/selfhost/run");

    var ll_path = try artifact_path(
        allocator,
        "target/selfhost/run/",
        source_path,
        ".ll"
    );
    var metadata_path = try artifact_path(
        allocator,
        "target/selfhost/run/",
        source_path,
        ".ll.meta"
    );
    let artifact = try write_run_artifact(
        allocator,
        io,
        source_path,
        ll_path,
        metadata_path,
        executable
    );
    ll_path.deinit();
    metadata_path.deinit();
    return artifact;
}

pub fn emit_test_executable_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    executable: data::TestExecutable
) -> !data::TestArtifact {
    try std::fs::create_dir(io, "target/selfhost/test");

    var ll_path = try artifact_path(
        allocator,
        "target/selfhost/test/",
        source_path,
        ".ll"
    );
    var metadata_path = try artifact_path(
        allocator,
        "target/selfhost/test/",
        source_path,
        ".ll.meta"
    );
    let artifact = try write_test_artifact(
        allocator,
        io,
        source_path,
        ll_path,
        metadata_path,
        executable.expect_ok
    );
    ll_path.deinit();
    metadata_path.deinit();
    return artifact;
}

fn write_run_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &std::string::String,
    metadata_path: &std::string::String,
    executable: data::RunExecutable
) -> !data::RunArtifact {
    let ll_path_view = ll_path.as_bytes();
    let metadata_path_view = metadata_path.as_bytes();
    var module = std::string::String(allocator);
    if executable.writes_stdout {
        module = try render_run_print_llvm(allocator, source_path, executable.stdout_payload);
    } else {
        module = try render_run_return_llvm(allocator, source_path);
    }
    let module_view = module.as_bytes();
    let module_len = try write_backend_bytes(
        io,
        ll_path_view,
        module_view,
        module.len()
    );
    module.deinit();

    var metadata = std::string::String(allocator);
    try append_line(metadata, "kizu-run-artifact-v0");
    try append_line(metadata, "issue #569");
    try append_key_value(metadata, "source ", source_path);
    try metadata.append_bytes("output ");
    try metadata.append_bytes(ll_path_view);
    try metadata.append_byte(cast<u8>(10));
    try append_line(metadata, "abi selfhost-abi-v0");
    try append_line(metadata, "entry @kizu_run_main");
    try append_line(metadata, "runtime target/selfhost/stage2/selfhost.host.ll");
    try append_line(metadata, "go.cmd-kizu-fallback none");
    try append_line(metadata, "artifact_mode hosted-artifact");
    let metadata_view = metadata.as_bytes();
    let metadata_len = try write_backend_bytes(
        io,
        metadata_path_view,
        metadata_view,
        metadata.len()
    );
    metadata.deinit();
    return data::RunArtifact {
        bytes: module_len,
        metadata_bytes: metadata_len
    };
}

fn write_test_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &std::string::String,
    metadata_path: &std::string::String,
    expect_ok: bool
) -> !data::TestArtifact {
    let ll_path_view = ll_path.as_bytes();
    let metadata_path_view = metadata_path.as_bytes();
    var module = std::string::String(allocator);
    if expect_ok {
        module = try render_test_expect_ok_llvm(allocator, source_path);
    } else {
        module = try render_test_expect_failure_llvm(allocator, source_path);
    }
    let module_view = module.as_bytes();
    let module_len = try write_backend_bytes(
        io,
        ll_path_view,
        module_view,
        module.len()
    );
    module.deinit();

    var metadata = std::string::String(allocator);
    try append_line(metadata, "kizu-test-artifact-v0");
    try append_line(metadata, "issue #570");
    try append_key_value(metadata, "source ", source_path);
    try metadata.append_bytes("output ");
    try metadata.append_bytes(ll_path_view);
    try metadata.append_byte(cast<u8>(10));
    try append_line(metadata, "abi selfhost-abi-v0");
    try append_line(metadata, "entry @kizu_test_main");
    try append_line(metadata, "runtime target/selfhost/stage2/selfhost.host.ll");
    try append_line(metadata, "go.cmd-kizu-fallback none");
    try append_line(metadata, "artifact_mode hosted-artifact");
    try append_line(metadata, "discovery none");
    let metadata_view = metadata.as_bytes();
    let metadata_len = try write_backend_bytes(
        io,
        metadata_path_view,
        metadata_view,
        metadata.len()
    );
    metadata.deinit();
    return data::TestArtifact {
        bytes: module_len,
        metadata_bytes: metadata_len
    };
}

fn artifact_path(
    allocator: Allocator,
    directory: []u8,
    source_path: []u8,
    suffix: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try out.append_bytes(directory);
    try out.append_bytes(artifact_stem(source_path));
    try out.append_bytes(suffix);
    return out;
}

fn artifact_stem(path: []u8) -> []u8 borrows path {
    let base = std::path::basename(path);
    let extension = std::path::extension(base);
    let base_len = std::mem::len(base);
    let extension_len = std::mem::len(extension);
    if extension_len < 1 {
        return base;
    }
    return base[0..base_len - extension_len];
}

fn write_backend_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}
fn render_run_print_llvm(
    allocator: Allocator,
    source_path: []u8,
    stdout_payload: []u8
) -> !std::string::String {
    let stdout_len = std::mem::len(stdout_payload) + 1;
    var out = std::string::String(allocator);
    try append_line(out, "; kizu run artifact ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "");
    try out.append_bytes("@.kizu.run.stdout = private unnamed_addr constant [");
    try std::fmt::append_i64(out, stdout_len);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try append_llvm_c_string_payload(out, stdout_payload);
    try out.append_bytes("\0A");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_run_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.stdout, 0");
    try out.append_bytes("  %slice = insertvalue %kizu.slice.u8 %base, i64 ");
    try std::fmt::append_i64(out, stdout_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try append_line(out,
        "  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %slice)");
    try append_line(out, "  %code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return out;
}

fn render_run_return_llvm(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_line(out, "; kizu run artifact ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_run_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return out;
}

fn append_llvm_c_string_payload(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte == cast<u8>(34) {
            try out.append_bytes("\22");
        } else {
            if byte == cast<u8>(92) {
                try out.append_bytes("\5C");
            } else {
                if byte == cast<u8>(10) {
                    try out.append_bytes("\0A");
                } else {
                    try out.append_byte(byte);
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn render_test_expect_ok_llvm(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_test_artifact_header(out, source_path);
    try out.append_bytes("@.kizu.test.ok = private unnamed_addr constant [9 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("test: ok\0A");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_test_artifact_body(out, "ok", "9", "stdout", "0");
    return out;
}

fn render_test_expect_failure_llvm(
    allocator: Allocator,
    source_path: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_test_artifact_header(out, source_path);
    try out.append_bytes("@.kizu.test.failure = private unnamed_addr constant [52 x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("error: runtime error: expected condition to be true\0A");
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_test_artifact_body(out, "failure", "52", "stderr", "1");
    return out;
}

fn append_test_artifact_header(
    out: &var std::string::String,
    source: []u8
) -> !void {
    try append_line(out, "; kizu test artifact ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "");
    return;
}

fn append_test_artifact_body(
    out: &var std::string::String,
    global: []u8,
    size: []u8,
    stream: []u8,
    code: []u8
) -> !void {
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("declare %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(stream);
    try out.append_bytes("(%kizu.owned, %kizu.slice.u8)");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_test_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("  %ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.test.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try out.append_bytes("  %slice = insertvalue %kizu.slice.u8 %base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %write = call %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(stream);
    try out.append_bytes("(%kizu.owned %io, %kizu.slice.u8 %slice)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %code = call i64 @kizu_rt_process_exit_code(i64 ");
    try out.append_bytes(code);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return;
}

fn append_key_value(
    out: &var std::string::String,
    key: []u8,
    value: []u8
) -> !void {
    try out.append_bytes(key);
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
