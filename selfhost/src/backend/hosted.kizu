fn render_fs_read_llvm(
    allocator: Allocator,
    source_path: []u8,
    program: &codegen::Program
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_fs_read_header(out, source_path, program.first_result_payload);
    try append_fs_read_run_main(out, std::mem::len(program.first_result_payload));
    try append_host_main(out, "kizu_run_main");
    return out;
}

fn render_try_void_llvm(
    allocator: Allocator,
    source_path: []u8,
    program: &codegen::Program
) -> !std::string::String {
    let template = run_print_executable();
    let payload = try codegen::stdout_payload(program);
    let output_len = hosted_output_len(payload, true);
    var out = std::string::String(allocator);
    try append_hosted_header(out, source_path, template.comment, template.output_stream);
    try append_hosted_global(out, template.global, payload, true, output_len);
    try append_try_void_body(out, template.global, output_len, program.i64_call_arg0);
    try append_host_main(out, "kizu_run_main");
    return out;
}

fn render_i64_call_llvm(
    allocator: Allocator,
    source_path: []u8,
    program: &codegen::Program
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_i64_call_header(out, source_path);
    try append_i64_function(out, program.i64_return_op);
    try append_i64_decimal_function(out);
    try append_i64_run_main(out, program.i64_call_arg0, program.i64_call_arg1);
    try append_host_main(out, "kizu_run_main");
    return out;
}

fn render_loop_i64_llvm(
    allocator: Allocator,
    source_path: []u8,
    program: &codegen::Program
) -> !std::string::String {
    var out = std::string::String(allocator);
    try append_i64_call_header(out, source_path);
    try append_i64_decimal_function(out);
    try append_loop_i64_run_main(
        out,
        program.loop_start_value,
        program.loop_bound,
        program.loop_continue_value,
        program.loop_break_value
    );
    try append_host_main(out, "kizu_run_main");
    return out;
}

fn append_i64_call_header(out: &var std::string::String, source_path: []u8) -> !void {
    try append_line(out, "; kizu codegen run artifact ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "");
    try append_line(out, "@.kizu.run.newline = private unnamed_addr constant [1 x i8] [i8 10]");
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "declare ptr @kizu_rt_alloc(ptr, i64)");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out, "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "");
    return;
}

fn append_fs_read_header(out: &var std::string::String, source_path: []u8, path: []u8) -> !void {
    try append_line(out, "; kizu codegen run artifact ll v0");
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
    try append_line(out, "%kizu.owned = type { ptr }");
    try append_line(out, "%kizu.error.slice.u8 = type { i1, %kizu.slice.u8, %kizu.slice.u8 }");
    try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
    try append_line(out, "");
    try append_hosted_global(out, "kizu.run.path", path, false, std::mem::len(path));
    try append_line(out, "@.kizu.run.newline = private unnamed_addr constant [1 x i8] [i8 10]");
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out, "declare %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "");
    return;
}

fn append_fs_read_run_main(out: &var std::string::String, path_len: i64) -> !void {
    try append_line(out, "define i64 @kizu_run_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("  %path_ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, path_len);
    try out.append_bytes(" x i8], ptr @.kizu.run.path, i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %path_base = insertvalue %kizu.slice.u8 poison, ptr %path_ptr, 0");
    try out.append_bytes("  %path = insertvalue %kizu.slice.u8 %path_base, i64 ");
    try std::fmt::append_i64(out, path_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %read = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %io, %kizu.slice.u8 %path)");
    try append_line(out, "  %read_ok = extractvalue %kizu.error.slice.u8 %read, 0");
    try append_line(out, "  br i1 %read_ok, label %read_ok_block, label %read_err");
    try append_line(out, "read_err:");
    try append_line(out, "  %err_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %err_code");
    try append_line(out, "read_ok_block:");
    try append_line(out, "  %bytes = extractvalue %kizu.error.slice.u8 %read, 1");
    try append_line(out, "  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %bytes)");
    try append_line(out, "  %newline_ptr = getelementptr inbounds [1 x i8], ptr @.kizu.run.newline, i64 0, i64 0");
    try append_line(out, "  %newline_base = insertvalue %kizu.slice.u8 poison, ptr %newline_ptr, 0");
    try append_line(out, "  %newline = insertvalue %kizu.slice.u8 %newline_base, i64 1, 1");
    try append_line(out, "  %write_newline = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %newline)");
    try append_line(out, "  %code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return;
}

fn append_try_void_body(
    out: &var std::string::String,
    global: []u8,
    output_len: i64,
    helper_exit_code: i64
) -> !void {
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out, "declare %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned, %kizu.slice.u8)");
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try append_line(out, "");
    try append_line(out, "define %kizu.error.void @kizu_run_try_void() {");
    try append_line(out, "entry:");
    try out.append_bytes("  %result = insertvalue %kizu.error.void zeroinitializer, i1 ");
    try append_try_void_ok_literal(out, helper_exit_code);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret %kizu.error.void %result");
    try append_line(out, "}");
    try append_line(out, "");
    try append_line(out, "define i64 @kizu_run_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out, "  %try_result = call %kizu.error.void @kizu_run_try_void()");
    try append_line(out, "  %try_ok = extractvalue %kizu.error.void %try_result, 0");
    try append_line(out, "  br i1 %try_ok, label %try_ok_block, label %try_err");
    try append_line(out, "try_err:");
    try append_line(out, "  %err_code = call i64 @kizu_rt_process_exit_code(i64 1)");
    try append_line(out, "  ret i64 %err_code");
    try append_line(out, "try_ok_block:");
    try out.append_bytes("  %ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(" x i8], ptr @.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try out.append_bytes("  %slice = insertvalue %kizu.slice.u8 %base, i64 ");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %slice)");
    try append_exit(out, 0);
    return;
}

fn append_try_void_ok_literal(out: &var std::string::String, helper_exit_code: i64) -> !void {
    if helper_exit_code == 0 {
        try out.append_bytes("true");
        return;
    }
    try out.append_bytes("false");
    return;
}

fn append_i64_function(out: &var std::string::String, op: codegen::RunBinaryOp) -> !void {
    try append_line(out, "define i64 @kizu_run_fn0(i64 %arg0, i64 %arg1) {");
    try append_line(out, "entry:");
    try out.append_bytes("  %result = ");
    try append_i64_llvm_op(out, op);
    try append_line(out, " i64 %arg0, %arg1");
    try append_line(out, "  ret i64 %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_i64_llvm_op(out: &var std::string::String, op: codegen::RunBinaryOp) -> !void {
    if op == codegen::RunBinaryOp::Add {
        try out.append_bytes("add");
        return;
    }
    if op == codegen::RunBinaryOp::Sub {
        try out.append_bytes("sub");
        return;
    }
    if op == codegen::RunBinaryOp::Mul {
        try out.append_bytes("mul");
        return;
    }
    if op == codegen::RunBinaryOp::Div {
        try out.append_bytes("sdiv");
        return;
    }
    return error("unsupported i64 run operator");
}

fn append_i64_decimal_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %value) {");
    try append_line(out, "entry:");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 20)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %check_zero, label %alloc_failed");
    try append_line(out, "check_zero:");
    try append_line(out, "  %is_zero = icmp eq i64 %value, 0");
    try append_line(out, "  br i1 %is_zero, label %zero, label %loop");
    try append_line(out, "zero:");
    try append_line(out, "  %zero_ptr = getelementptr i8, ptr %buffer, i64 19");
    try append_line(out, "  store i8 48, ptr %zero_ptr");
    try append_line(out, "  br label %finish_zero");
    try append_line(out, "loop:");
    try append_line(out, "  %current = phi i64 [ %value, %check_zero ], [ %quotient, %loop ]");
    try append_line(out, "  %write_index = phi i64 [ 19, %check_zero ], [ %next_index, %loop ]");
    try append_line(out, "  %digit = srem i64 %current, 10");
    try append_line(out, "  %digit_byte_i64 = add i64 %digit, 48");
    try append_line(out, "  %digit_byte = trunc i64 %digit_byte_i64 to i8");
    try append_line(out, "  %digit_ptr = getelementptr i8, ptr %buffer, i64 %write_index");
    try append_line(out, "  store i8 %digit_byte, ptr %digit_ptr");
    try append_line(out, "  %quotient = sdiv i64 %current, 10");
    try append_line(out, "  %next_index = sub i64 %write_index, 1");
    try append_line(out, "  %done = icmp eq i64 %quotient, 0");
    try append_line(out, "  br i1 %done, label %finish_loop, label %loop");
    try append_line(out, "finish_zero:");
    try append_line(out, "  br label %success");
    try append_line(out, "finish_loop:");
    try append_line(out, "  br label %success");
    try append_line(out, "success:");
    try append_line(out, "  %start = phi i64 [ 19, %finish_zero ], [ %write_index, %finish_loop ]");
    try append_line(out, "  %len = sub i64 20, %start");
    try append_line(out, "  %start_ptr = getelementptr i8, ptr %buffer, i64 %start");
    try append_line(out, "  %slice_base = insertvalue %kizu.slice.u8 poison, ptr %start_ptr, 0");
    try append_line(out, "  %slice = insertvalue %kizu.slice.u8 %slice_base, i64 %len, 1");
    try append_line(out, "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %slice, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_i64_run_main(out: &var std::string::String, arg0: i64, arg1: i64) -> !void {
    try append_line(out, "define i64 @kizu_run_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("  %value = call i64 @kizu_run_fn0(i64 ");
    try std::fmt::append_i64(out, arg0);
    try out.append_bytes(", i64 ");
    try std::fmt::append_i64(out, arg1);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %decimal_result = call %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %value)");
    try append_line(out, "  %decimal = extractvalue %kizu.error.slice.u8 %decimal_result, 1");
    try append_line(out, "  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %decimal)");
    try append_line(out, "  %newline_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.newline, 0");
    try append_line(out, "  %newline = insertvalue %kizu.slice.u8 %newline_base, i64 1, 1");
    try append_line(out, "  %write_newline = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %newline)");
    try append_line(out, "  %code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return;
}

fn append_loop_i64_run_main(
    out: &var std::string::String,
    start_value: i64,
    bound: i64,
    continue_value: i64,
    break_value: i64
) -> !void {
    try append_line(out, "define i64 @kizu_run_main() {");
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out, "  br label %loop_head");
    try append_line(out, "loop_head:");
    try out.append_bytes("  %i = phi i64 [ ");
    try std::fmt::append_i64(out, start_value);
    try out.append_bytes(", %entry ], [ %i_next, %loop_latch ]");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %loop_cond = icmp slt i64 %i, ");
    try std::fmt::append_i64(out, bound);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %loop_cond, label %loop_body, label %loop_exit");
    try append_line(out, "loop_body:");
    try append_line(out, "  %i_next = add i64 %i, 1");
    try out.append_bytes("  %is_continue = icmp eq i64 %i, ");
    try std::fmt::append_i64(out, continue_value);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_continue, label %loop_latch, label %check_break");
    try append_line(out, "check_break:");
    try out.append_bytes("  %is_break = icmp eq i64 %i, ");
    try std::fmt::append_i64(out, break_value);
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  br i1 %is_break, label %loop_exit, label %print_value");
    try append_line(out, "print_value:");
    try append_line(out, "  %decimal_result = call %kizu.error.slice.u8 @kizu_run_i64_decimal(i64 %i)");
    try append_line(out, "  %decimal = extractvalue %kizu.error.slice.u8 %decimal_result, 1");
    try append_line(out, "  %write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %decimal)");
    try append_line(out, "  %newline_base = insertvalue %kizu.slice.u8 poison, ptr @.kizu.run.newline, 0");
    try append_line(out, "  %newline = insertvalue %kizu.slice.u8 %newline_base, i64 1, 1");
    try append_line(out, "  %write_newline = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %newline)");
    try append_line(out, "  br label %loop_latch");
    try append_line(out, "loop_latch:");
    try append_line(out, "  br label %loop_head");
    try append_line(out, "loop_exit:");
    try append_line(out, "  %code = call i64 @kizu_rt_process_exit_code(i64 0)");
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return;
}

fn write_test_metadata(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &[]u8,
    metadata_path: &[]u8,
    hosted: &data::HostedExecutable
) -> !i64 {
    var metadata = std::string::String(allocator);
    try append_line(metadata, test_metadata_title());
    try append_line(metadata, test_metadata_issue());
    try append_common_metadata(metadata, source_path, ll_path, hosted);
    try append_line(metadata, test_metadata_discovery_line());
    let metadata_len = try write_metadata(io, metadata_path, metadata);
    metadata.deinit();
    return metadata_len;
}

fn append_common_metadata(
    metadata: &var std::string::String,
    source_path: []u8,
    ll_path: &[]u8,
    hosted: &data::HostedExecutable
) -> !void {
    try append_key_value(metadata, metadata_source_prefix(), source_path);
    try metadata.append_bytes(metadata_output_prefix());
    try metadata.append_bytes(ll_path);
    try metadata.append_byte(cast<u8>(10));
    try append_line(metadata, metadata_abi_line());
    try append_key_value(metadata, metadata_entry_prefix(), hosted.entry);
    try append_key_value(metadata, "codegen_ir ", hosted.codegen_ir);
    if !std::mem::equal_bytes(hosted.codegen_ir, "none") {
        try append_line(metadata, metadata_run_codegen_line());
    }
    try append_line(metadata, metadata_runtime_line());
    try append_line(metadata, metadata_lowering_line());
    try append_line(metadata, metadata_fallback_line());
    try append_line(metadata, metadata_mode_line());
    return;
}

fn write_metadata(
    io: Io,
    metadata_path: &[]u8,
    metadata: &std::string::String
) -> !i64 {
    let metadata_view = metadata.as_bytes();
    return try write_backend_bytes(
        io,
        metadata_path,
        metadata_view,
        metadata.len()
    );
}

fn artifact_path(
    allocator: Allocator,
    directory: []u8,
    source_path: []u8,
    suffix: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try out.append_bytes(directory);
    try out.append_bytes(artifact_stem(source_path));
    try out.append_bytes(suffix);
    return out;
}

fn artifact_stem(path: []u8) -> []u8 borrows path {
    let base = std::path::basename(path);
    let extension = std::path::extension(base);
    let base_len = std::mem::len(base);
    let extension_len = std::mem::len(extension);
    if extension_len < 1 {
        return base;
    }
    return base[0..base_len - extension_len];
}

fn write_backend_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_hosted_llvm(
    allocator: Allocator,
    source_path: []u8,
    hosted: &data::HostedExecutable
) -> !std::string::String {
    let comment = hosted.comment;
    let entry = hosted.entry;
    let global = hosted.global;
    let output_stream = hosted.output_stream;
    let output_payload = hosted.output_payload;
    let append_newline = hosted.append_newline;
    let exit_code = hosted.exit_code;
    var out = std::string::String(allocator);
    try append_hosted_header(out, source_path, comment, output_stream);
    if output_stream == data::HostedOutputStream::None {
        try append_hosted_return_body(out, entry, exit_code);
    } else {
        let output_len = hosted_output_len(output_payload, append_newline);
        try append_hosted_global(out, global, output_payload, append_newline, output_len);
        try append_hosted_output_body(out, entry, global, output_stream, output_len, exit_code);
    }
    if hosted_executable_needs_main(entry) {
        try append_host_main(out, entry);
    }
    return out;
}

fn hosted_executable_needs_main(entry: []u8) -> bool {
    return std::mem::equal_bytes(entry, "kizu_run_main");
}

fn append_hosted_header(
    out: &var std::string::String,
    source_path: []u8,
    comment: []u8,
    output_stream: data::HostedOutputStream
) -> !void {
    try out.append_bytes("; ");
    try out.append_bytes(comment);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    if output_stream != data::HostedOutputStream::None {
        try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
        try append_line(out, "%kizu.owned = type { ptr }");
        try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
        try append_line(out, "");
    }
    return;
}

fn hosted_output_len(output_payload: []u8, append_newline: bool) -> i64 {
    let length = std::mem::len(output_payload);
    if append_newline {
        return length + 1;
    }
    return length;
}

fn append_hosted_global(
    out: &var std::string::String,
    global: []u8,
    output_payload: []u8,
    append_newline: bool,
    output_len: i64
) -> !void {
    try out.append_bytes("@.");
    try out.append_bytes(global);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try append_llvm_c_string_payload(out, output_payload);
    if append_newline {
        try out.append_bytes("\0A");
    }
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_hosted_output_body(
    out: &var std::string::String,
    entry: []u8,
    global: []u8,
    output_stream: data::HostedOutputStream,
    output_len: i64,
    exit_code: i64
) -> !void {
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("declare %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(hosted_stream_name(output_stream));
    try out.append_bytes("(%kizu.owned, %kizu.slice.u8)");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("define i64 @");
    try out.append_bytes(entry);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("  %ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(" x i8], ptr @.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try out.append_bytes("  %slice = insertvalue %kizu.slice.u8 %base, i64 ");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %write = call %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(hosted_stream_name(output_stream));
    try out.append_bytes("(%kizu.owned %io, %kizu.slice.u8 %slice)");
    try out.append_byte(cast<u8>(10));
    try append_exit(out, exit_code);
    return;
}

fn append_hosted_return_body(
    out: &var std::string::String,
    entry: []u8,
    exit_code: i64
) -> !void {
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("define i64 @");
    try out.append_bytes(entry);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "entry:");
    try append_exit(out, exit_code);
    return;
}

fn append_exit(out: &var std::string::String, exit_code: i64) -> !void {
    try out.append_bytes("  %code = call i64 @kizu_rt_process_exit_code(i64 ");
    try std::fmt::append_i64(out, exit_code);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return;
}

fn append_host_main(out: &var std::string::String, entry: []u8) -> !void {
    try append_line(out, "");
    try append_line(out, "declare void @kizu_host_init(i32, ptr)");
    try append_line(out, "");
    try append_line(out, "define i32 @main(i32 %argc, ptr %argv) {");
    try append_line(out, "entry:");
    try append_line(out, "  call void @kizu_host_init(i32 %argc, ptr %argv)");
    try out.append_bytes("  %code = call i64 @");
    try out.append_bytes(entry);
    try out.append_bytes("()");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %exit = trunc i64 %code to i32");
    try append_line(out, "  ret i32 %exit");
    try append_line(out, "}");
    return;
}

fn hosted_stream_name(stream: data::HostedOutputStream) -> []u8 {
    if stream == data::HostedOutputStream::Stdout {
        return "stdout";
    }
    return "stderr";
}

fn append_llvm_c_string_payload(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte == cast<u8>(34) {
            try out.append_bytes("\22");
        } else {
            if byte == cast<u8>(92) {
                try out.append_bytes("\5C");
            } else {
                if byte == cast<u8>(10) {
                    try out.append_bytes("\0A");
                } else {
                    try out.append_byte(byte);
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn append_key_value(
    out: &var std::string::String,
    key: []u8,
    value: []u8
) -> !void {
    try out.append_bytes(key);
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
