import selfhost::backend::data;

pub fn emit_run_executable_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    executable: data::Executable
) -> !data::RunArtifact {
    try std::fs::create_dir(io, "target/selfhost/run");

    var ll_path = try artifact_path(
        allocator,
        "target/selfhost/run/",
        source_path,
        ".ll"
    );
    var metadata_path = try artifact_path(
        allocator,
        "target/selfhost/run/",
        source_path,
        ".ll.meta"
    );
    let artifact = try write_run_artifact(
        allocator,
        io,
        source_path,
        ll_path,
        metadata_path,
        executable
    );
    ll_path.deinit();
    metadata_path.deinit();
    return artifact;
}

pub fn emit_test_executable_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    executable: data::Executable
) -> !data::TestArtifact {
    try std::fs::create_dir(io, "target/selfhost/test");

    var ll_path = try artifact_path(
        allocator,
        "target/selfhost/test/",
        source_path,
        ".ll"
    );
    var metadata_path = try artifact_path(
        allocator,
        "target/selfhost/test/",
        source_path,
        ".ll.meta"
    );
    let artifact = try write_test_artifact(
        allocator,
        io,
        source_path,
        ll_path,
        metadata_path,
        executable
    );
    ll_path.deinit();
    metadata_path.deinit();
    return artifact;
}

fn write_run_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &std::string::String,
    metadata_path: &std::string::String,
    executable: data::Executable
) -> !data::RunArtifact {
    let hosted = try lower_run_hosted_executable(source_path, executable);
    let entry = hosted.entry;
    let ll_path_view = ll_path.as_bytes();
    let metadata_path_view = metadata_path.as_bytes();
    let module_len = try write_hosted_module(
        allocator,
        io,
        source_path,
        ll_path_view,
        hosted
    );
    let metadata_len = try write_run_metadata(
        allocator,
        io,
        source_path,
        ll_path_view,
        metadata_path_view,
        entry
    );
    return data::RunArtifact {
        bytes: module_len,
        metadata_bytes: metadata_len
    };
}

fn write_test_artifact(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &std::string::String,
    metadata_path: &std::string::String,
    executable: data::Executable
) -> !data::TestArtifact {
    let hosted = try lower_test_hosted_executable(source_path, executable);
    let entry = hosted.entry;
    let ll_path_view = ll_path.as_bytes();
    let metadata_path_view = metadata_path.as_bytes();
    let module_len = try write_hosted_module(
        allocator,
        io,
        source_path,
        ll_path_view,
        hosted
    );
    let metadata_len = try write_test_metadata(
        allocator,
        io,
        source_path,
        ll_path_view,
        metadata_path_view,
        entry
    );
    return data::TestArtifact {
        bytes: module_len,
        metadata_bytes: metadata_len
    };
}

fn lower_run_hosted_executable(
    source_path: []u8,
    executable: data::Executable
) -> !data::HostedExecutable {
    if executable.kind == data::ExecutableKind::RunPrintString {
        return data::HostedExecutable {
            comment: "kizu run artifact ll v0",
            entry: "kizu_run_main",
            global: "kizu.run.stdout",
            output_stream: data::HostedOutputStream::Stdout,
            output_payload: executable.stdout_payload,
            append_newline: true,
            exit_code: 0
        };
    }
    if executable.kind == data::ExecutableKind::RunReturnVoid {
        return data::HostedExecutable {
            comment: "kizu run artifact ll v0",
            entry: "kizu_run_main",
            global: "",
            output_stream: data::HostedOutputStream::None,
            output_payload: source_path[0..0],
            append_newline: false,
            exit_code: 0
        };
    }
    return error("unsupported run executable");
}

fn lower_test_hosted_executable(
    source_path: []u8,
    executable: data::Executable
) -> !data::HostedExecutable {
    if executable.kind == data::ExecutableKind::TestExpectOk {
        return data::HostedExecutable {
            comment: "kizu test artifact ll v0",
            entry: "kizu_test_main",
            global: "kizu.test.ok",
            output_stream: data::HostedOutputStream::Stdout,
            output_payload: "test: ok",
            append_newline: true,
            exit_code: 0
        };
    }
    if executable.kind == data::ExecutableKind::TestExpectFailure {
        return data::HostedExecutable {
            comment: "kizu test artifact ll v0",
            entry: "kizu_test_main",
            global: "kizu.test.failure",
            output_stream: data::HostedOutputStream::Stderr,
            output_payload: "error: runtime error: expected condition to be true",
            append_newline: true,
            exit_code: 1
        };
    }
    return error("unsupported test executable");
}

fn write_hosted_module(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &[]u8,
    hosted: data::HostedExecutable
) -> !i64 {
    var module = try render_hosted_llvm(allocator, source_path, hosted);
    let module_view = module.as_bytes();
    let module_len = try write_backend_bytes(
        io,
        ll_path,
        module_view,
        module.len()
    );
    module.deinit();
    return module_len;
}

fn write_run_metadata(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &[]u8,
    metadata_path: &[]u8,
    entry: []u8
) -> !i64 {
    var metadata = std::string::String(allocator);
    try append_line(metadata, "kizu-run-artifact-v0");
    try append_line(metadata, "issue #569");
    try append_common_metadata(metadata, source_path, ll_path, entry);
    let metadata_len = try write_metadata(io, metadata_path, metadata);
    metadata.deinit();
    return metadata_len;
}

fn write_test_metadata(
    allocator: Allocator,
    io: Io,
    source_path: []u8,
    ll_path: &[]u8,
    metadata_path: &[]u8,
    entry: []u8
) -> !i64 {
    var metadata = std::string::String(allocator);
    try append_line(metadata, "kizu-test-artifact-v0");
    try append_line(metadata, "issue #570");
    try append_common_metadata(metadata, source_path, ll_path, entry);
    try append_line(metadata, "discovery none");
    let metadata_len = try write_metadata(io, metadata_path, metadata);
    metadata.deinit();
    return metadata_len;
}

fn append_common_metadata(
    metadata: &var std::string::String,
    source_path: []u8,
    ll_path: &[]u8,
    entry: []u8
) -> !void {
    try append_key_value(metadata, "source ", source_path);
    try metadata.append_bytes("output ");
    try metadata.append_bytes(ll_path);
    try metadata.append_byte(cast<u8>(10));
    try append_line(metadata, "abi selfhost-abi-v0");
    try append_key_value(metadata, "entry @", entry);
    try append_line(metadata, "runtime target/selfhost/stage2/selfhost.host.ll");
    try append_line(metadata, "go.cmd-kizu-fallback none");
    try append_line(metadata, "artifact_mode hosted-artifact");
    return;
}

fn write_metadata(
    io: Io,
    metadata_path: &[]u8,
    metadata: &std::string::String
) -> !i64 {
    let metadata_view = metadata.as_bytes();
    return try write_backend_bytes(
        io,
        metadata_path,
        metadata_view,
        metadata.len()
    );
}

fn artifact_path(
    allocator: Allocator,
    directory: []u8,
    source_path: []u8,
    suffix: []u8
) -> !std::string::String {
    var out = std::string::String(allocator);
    try out.append_bytes(directory);
    try out.append_bytes(artifact_stem(source_path));
    try out.append_bytes(suffix);
    return out;
}

fn artifact_stem(path: []u8) -> []u8 borrows path {
    let base = std::path::basename(path);
    let extension = std::path::extension(base);
    let base_len = std::mem::len(base);
    let extension_len = std::mem::len(extension);
    if extension_len < 1 {
        return base;
    }
    return base[0..base_len - extension_len];
}

fn write_backend_bytes(
    io: Io,
    path: &[]u8,
    bytes: &[]u8,
    byte_len: i64
) -> !i64 {
    try std::fs::write_file(io, path, bytes);
    return byte_len;
}

fn render_hosted_llvm(
    allocator: Allocator,
    source_path: []u8,
    hosted: data::HostedExecutable
) -> !std::string::String {
    let comment = hosted.comment;
    let entry = hosted.entry;
    let global = hosted.global;
    let output_stream = hosted.output_stream;
    let output_payload = hosted.output_payload;
    let append_newline = hosted.append_newline;
    let exit_code = hosted.exit_code;
    var out = std::string::String(allocator);
    try append_hosted_header(out, source_path, comment, output_stream);
    if output_stream == data::HostedOutputStream::None {
        try append_hosted_return_body(out, entry, exit_code);
    } else {
        let output_len = hosted_output_len(output_payload, append_newline);
        try append_hosted_global(out, global, output_payload, append_newline, output_len);
        try append_hosted_output_body(out, entry, global, output_stream, output_len, exit_code);
    }
    return out;
}

fn append_hosted_header(
    out: &var std::string::String,
    source_path: []u8,
    comment: []u8,
    output_stream: data::HostedOutputStream
) -> !void {
    try out.append_bytes("; ");
    try out.append_bytes(comment);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("source_filename = ");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(source_path);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    try append_line(out, "");
    if output_stream != data::HostedOutputStream::None {
        try append_line(out, "%kizu.slice.u8 = type { ptr, i64 }");
        try append_line(out, "%kizu.owned = type { ptr }");
        try append_line(out, "%kizu.error.void = type { i1, %kizu.slice.u8 }");
        try append_line(out, "");
    }
    return;
}

fn hosted_output_len(output_payload: []u8, append_newline: bool) -> i64 {
    let length = std::mem::len(output_payload);
    if append_newline {
        return length + 1;
    }
    return length;
}

fn append_hosted_global(
    out: &var std::string::String,
    global: []u8,
    output_payload: []u8,
    append_newline: bool,
    output_len: i64
) -> !void {
    try out.append_bytes("@.");
    try out.append_bytes(global);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try append_llvm_c_string_payload(out, output_payload);
    if append_newline {
        try out.append_bytes("\0A");
    }
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_hosted_output_body(
    out: &var std::string::String,
    entry: []u8,
    global: []u8,
    output_stream: data::HostedOutputStream,
    output_len: i64,
    exit_code: i64
) -> !void {
    try append_line(out, "");
    try append_line(out, "declare %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("declare %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(hosted_stream_name(output_stream));
    try out.append_bytes("(%kizu.owned, %kizu.slice.u8)");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("define i64 @");
    try out.append_bytes(entry);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "entry:");
    try append_line(out, "  %io = call %kizu.owned @kizu_rt_io_blocking()");
    try out.append_bytes("  %ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(" x i8], ptr @.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %ptr, 0");
    try out.append_bytes("  %slice = insertvalue %kizu.slice.u8 %base, i64 ");
    try std::fmt::append_i64(out, output_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %write = call %kizu.error.void @kizu_rt_io_write_");
    try out.append_bytes(hosted_stream_name(output_stream));
    try out.append_bytes("(%kizu.owned %io, %kizu.slice.u8 %slice)");
    try out.append_byte(cast<u8>(10));
    try append_exit(out, exit_code);
    return;
}

fn append_hosted_return_body(
    out: &var std::string::String,
    entry: []u8,
    exit_code: i64
) -> !void {
    try append_line(out, "declare i64 @kizu_rt_process_exit_code(i64)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("define i64 @");
    try out.append_bytes(entry);
    try out.append_bytes("() {");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "entry:");
    try append_exit(out, exit_code);
    return;
}

fn append_exit(out: &var std::string::String, exit_code: i64) -> !void {
    try out.append_bytes("  %code = call i64 @kizu_rt_process_exit_code(i64 ");
    try std::fmt::append_i64(out, exit_code);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  ret i64 %code");
    try append_line(out, "}");
    return;
}

fn hosted_stream_name(stream: data::HostedOutputStream) -> []u8 {
    if stream == data::HostedOutputStream::Stdout {
        return "stdout";
    }
    return "stderr";
}

fn append_llvm_c_string_payload(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte == cast<u8>(34) {
            try out.append_bytes("\22");
        } else {
            if byte == cast<u8>(92) {
                try out.append_bytes("\5C");
            } else {
                if byte == cast<u8>(10) {
                    try out.append_bytes("\0A");
                } else {
                    try out.append_byte(byte);
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn append_key_value(
    out: &var std::string::String,
    key: []u8,
    value: []u8
) -> !void {
    try out.append_bytes(key);
    try out.append_bytes(value);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
