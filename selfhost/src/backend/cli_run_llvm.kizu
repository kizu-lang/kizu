import selfhost::backend::cli_check_gate_llvm;
import selfhost::backend::cli_hosted_metadata_llvm;
import selfhost::backend::data;
import selfhost::backend::hosted;

pub fn append_globals(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_llvm_constant_bytes(out, "run_dir", hosted::run_artifact_dir());
    try append_llvm_constant_bytes(out, "run_path_prefix", hosted::run_artifact_path_prefix());
    try append_llvm_constant_bytes(out, "run_ll_suffix", hosted::artifact_ll_suffix());
    try append_llvm_constant_bytes(
        out,
        "run_metadata_path_prefix",
        hosted::run_artifact_path_prefix()
    );
    try append_llvm_constant_bytes(
        out,
        "run_metadata_path_suffix",
        hosted::artifact_metadata_suffix()
    );
    let run_print_comment_case = hosted::run_print_executable();
    try append_hosted_prefix_source_constant(
        out,
        "run_print_ll_prefix_source",
        run_print_comment_case.comment
    );
    let run_return_comment_case = hosted::run_return_executable();
    try append_hosted_prefix_source_constant(
        out,
        "run_return_ll_prefix_source",
        run_return_comment_case.comment
    );
    let run_print_global_case = hosted::run_print_executable();
    try append_run_dynamic_global_prefix_constant(
        out,
        "run_print_ll_prefix_len",
        run_print_global_case.global
    );
    try append_llvm_constant(out, "run_print_ll_prefix_payload", 9, " x i8] c\22");
    let run_print_body_entry_case = hosted::run_print_executable();
    let run_print_body_entry = run_print_body_entry_case.entry;
    let run_print_body_global_case = hosted::run_print_executable();
    let run_print_body_global = run_print_body_global_case.global;
    let run_print_body_stream_case = hosted::run_print_executable();
    let run_print_body_stream = run_print_body_stream_case.output_stream;
    let run_print_body_newline_case = hosted::run_print_executable();
    let run_print_body_append_newline = run_print_body_newline_case.append_newline;
    try append_run_dynamic_body_prefix_constant(
        out,
        "run_print_ll_prefix_len2",
        run_print_body_entry,
        run_print_body_global,
        run_print_body_stream,
        run_print_body_append_newline
    );
    let run_print_suffix_stream_case = hosted::run_print_executable();
    let run_print_suffix_stream = run_print_suffix_stream_case.output_stream;
    let run_print_suffix_exit_case = hosted::run_print_executable();
    let run_print_suffix_exit_code = run_print_suffix_exit_case.exit_code;
    try append_run_dynamic_body_suffix_constant(
        out,
        "run_print_ll_suffix",
        run_print_suffix_stream,
        run_print_suffix_exit_code
    );
    let run_return_suffix_entry_case = hosted::run_return_executable();
    let run_return_suffix_entry = run_return_suffix_entry_case.entry;
    let run_return_suffix_exit_case = hosted::run_return_executable();
    let run_return_suffix_exit_code = run_return_suffix_exit_case.exit_code;
    try append_hosted_return_body_suffix_constant(
        out,
        "run_return_ll_suffix",
        run_return_suffix_entry,
        run_return_suffix_exit_code
    );
    try cli_hosted_metadata_llvm::append_prefix_constant(
        out,
        "run_meta_prefix",
        hosted::run_metadata_title(),
        hosted::run_metadata_issue()
    );
    let run_print_entry_case = hosted::run_print_executable();
    try cli_hosted_metadata_llvm::append_before_runtime_constant(
        out,
        "run_meta_before_runtime",
        run_print_entry_case.entry
    );
    let run_return_entry_case = hosted::run_return_executable();
    try cli_hosted_metadata_llvm::append_before_runtime_constant(
        out,
        "run_return_meta_before_runtime",
        run_return_entry_case.entry
    );
    try cli_hosted_metadata_llvm::append_after_runtime_constant(
        out,
        "run_meta_after_runtime",
        cli_hosted_metadata_llvm::run_print_codegen_ir(),
        false
    );
    try cli_hosted_metadata_llvm::append_after_runtime_constant(
        out,
        "run_return_meta_after_runtime",
        cli_hosted_metadata_llvm::no_codegen_ir(),
        false
    );
    return;
}

fn append_llvm_constant_bytes(
    out: &var std::string::String,
    name: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, std::mem::len(text));
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_constant_header(
    out: &var std::string::String,
    name: []u8,
    size: i64
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    return;
}

fn append_llvm_constant_footer(out: &var std::string::String) -> !void {
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_hosted_prefix_source_constant(
    out: &var std::string::String,
    name: []u8,
    comment: []u8
) -> !void {
    let size = hosted_prefix_source_size(comment);
    let suffix = "\0Asource_filename = \22";
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes("; ");
    try append_llvm_c_string_payload(out, comment);
    try out.append_bytes(suffix);
    try append_llvm_constant_footer(out);
    return;
}

fn append_run_dynamic_global_prefix_constant(
    out: &var std::string::String,
    name: []u8,
    global: []u8
) -> !void {
    let size = run_dynamic_global_prefix_size(global);
    let prefix =
        "\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A";
    let middle = "%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.";
    let suffix = " = private unnamed_addr constant [";
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes(prefix);
    try out.append_bytes(middle);
    try out.append_bytes(global);
    try out.append_bytes(suffix);
    try append_llvm_constant_footer(out);
    return;
}

fn append_run_dynamic_body_prefix_constant(
    out: &var std::string::String,
    name: []u8,
    entry: []u8,
    global: []u8,
    stream: data::HostedOutputStream,
    append_newline: bool
) -> !void {
    let size = try run_dynamic_body_prefix_size(entry, global, stream, append_newline);
    let stream_name = try hosted_output_stream_llvm_name(stream);
    let header = "\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0A";
    let write_prefix = "declare %kizu.error.void @kizu_rt_io_write_";
    let write_suffix =
        "(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0A";
    let entry_prefix = "define i64 @";
    let entry_suffix = "() {\0Aentry:\0A";
    let io = "  %io = call %kizu.owned @kizu_rt_io_blocking()\0A";
    let base = "  %base = insertvalue %kizu.slice.u8 poison, ptr @.";
    let tail = ", 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 ";
    try append_llvm_constant_header(out, name, size);
    if append_newline {
        try out.append_bytes("\5C0A");
    }
    try out.append_bytes(header);
    try out.append_bytes(write_prefix);
    try out.append_bytes(stream_name);
    try out.append_bytes(write_suffix);
    try out.append_bytes(entry_prefix);
    try out.append_bytes(entry);
    try out.append_bytes(entry_suffix);
    try out.append_bytes(io);
    try out.append_bytes(base);
    try out.append_bytes(global);
    try out.append_bytes(tail);
    try append_llvm_constant_footer(out);
    return;
}

fn append_run_dynamic_body_suffix_constant(
    out: &var std::string::String,
    name: []u8,
    stream: data::HostedOutputStream,
    exit_code: i64
) -> !void {
    let size = try run_dynamic_body_suffix_size(stream, exit_code);
    let stream_name = try hosted_output_stream_llvm_name(stream);
    let prefix = ", 1\0A";
    let write_prefix = "  %write = call %kizu.error.void @kizu_rt_io_write_";
    let write_suffix = "(%kizu.owned %io, %kizu.slice.u8 %slice)\0A";
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes(prefix);
    try out.append_bytes(write_prefix);
    try out.append_bytes(stream_name);
    try out.append_bytes(write_suffix);
    try append_hosted_exit(out, exit_code);
    try append_llvm_constant_footer(out);
    return;
}

fn append_hosted_return_body_suffix_constant(
    out: &var std::string::String,
    name: []u8,
    entry: []u8,
    exit_code: i64
) -> !void {
    let size = try hosted_return_body_suffix_size(entry, exit_code);
    let header = "\22\0A\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0A";
    let entry_prefix = "define i64 @";
    let entry_suffix = "() {\0Aentry:\0A";
    try append_llvm_constant_header(out, name, size);
    try out.append_bytes(header);
    try out.append_bytes(entry_prefix);
    try out.append_bytes(entry);
    try out.append_bytes(entry_suffix);
    try append_hosted_exit(out, exit_code);
    try append_llvm_constant_footer(out);
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_cli_run_payload_llvm_c_string_function(out);
    return;
}

pub fn append_cli_run_blocks(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let run_print_kind = try executable_kind_tag(ir_bytes, "Call");
    let run_return_kind = try executable_kind_tag(ir_bytes, "RunReturnVoid");
    try append_line(out, "dispatch_run:");
    try append_line(out, "  %run_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %run_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %run_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %run_file_ok = extractvalue %kizu.error.slice.u8 %run_file, 0");
    try append_line(out, "  br i1 %run_file_ok, label %run_read_ok, label %check_failed");
    try append_line(out, "run_read_ok:");
    try append_line(out, "  %run_bytes = extractvalue %kizu.error.slice.u8 %run_file, 1");
    try cli_check_gate_llvm::append_static_check_gate(
        out,
        "run_check",
        "run_check",
        "run_io",
        "run_bytes",
        "run_match_source"
    );
    try append_line(out, "run_match_source:");
    try append_line(out,
        "  %run_executable = call %kizu.selfhost.executable @kizu_selfhost__cli_run_executable(%kizu.slice.u8 %run_bytes)");
    try append_line(out, "  %run_executable_kind = extractvalue %kizu.selfhost.executable %run_executable, 0");
    try append_executable_kind_compare(out, "run_print_found", "run_executable_kind", run_print_kind);
    try append_line(out, "  br i1 %run_print_found, label %run_print_emit, label %run_match_return");
    try append_line(out, "run_match_return:");
    try append_executable_kind_compare(out, "run_return_found", "run_executable_kind", run_return_kind);
    try append_line(out, "  br i1 %run_return_found, label %run_return_emit, label %usage");
    try append_run_print_emit_block(out);
    try append_run_return_emit_block(out);
    return;
}

fn append_run_print_emit_block(out: &var std::string::String) -> !void {
    let dir_size = std::mem::len(hosted::run_artifact_dir());
    let ll_prefix_size = std::mem::len(hosted::run_artifact_path_prefix());
    let ll_suffix_size = std::mem::len(hosted::artifact_ll_suffix());
    let metadata_prefix_size = std::mem::len(hosted::run_artifact_path_prefix());
    let metadata_suffix_size = std::mem::len(hosted::artifact_metadata_suffix());
    let run_print_comment_case = hosted::run_print_executable();
    let ll_prefix_source_size = hosted_prefix_source_size(run_print_comment_case.comment);
    let run_print_global_case = hosted::run_print_executable();
    let dynamic_global_prefix_size = run_dynamic_global_prefix_size(run_print_global_case.global);
    let run_print_body_entry_case = hosted::run_print_executable();
    let run_print_body_entry = run_print_body_entry_case.entry;
    let run_print_body_global_case = hosted::run_print_executable();
    let run_print_body_global = run_print_body_global_case.global;
    let run_print_body_stream_case = hosted::run_print_executable();
    let run_print_body_stream = run_print_body_stream_case.output_stream;
    let run_print_body_newline_case = hosted::run_print_executable();
    let run_print_body_append_newline = run_print_body_newline_case.append_newline;
    let dynamic_body_prefix_size = try run_dynamic_body_prefix_size(
        run_print_body_entry,
        run_print_body_global,
        run_print_body_stream,
        run_print_body_append_newline
    );
    let run_print_suffix_stream_case = hosted::run_print_executable();
    let run_print_suffix_stream = run_print_suffix_stream_case.output_stream;
    let run_print_suffix_exit_case = hosted::run_print_executable();
    let run_print_suffix_exit_code = run_print_suffix_exit_case.exit_code;
    let dynamic_body_suffix_size = try run_dynamic_body_suffix_size(
        run_print_suffix_stream,
        run_print_suffix_exit_code
    );
    let meta_prefix_size = try cli_hosted_metadata_llvm::prefix_size(
        hosted::run_metadata_title(),
        hosted::run_metadata_issue()
    );
    let meta_output_prefix_size = try cli_hosted_metadata_llvm::output_prefix_size();
    let run_print_entry_case = hosted::run_print_executable();
    let meta_before_runtime_size = try cli_hosted_metadata_llvm::before_runtime_size(
        run_print_entry_case.entry
    );
    let meta_after_runtime_size = try cli_hosted_metadata_llvm::after_runtime_size(
        cli_hosted_metadata_llvm::run_print_codegen_ir(),
        false
    );
    try append_line(out, "run_print_emit:");
    try append_global_slice(out, "run", "dir", "run_dir", dir_size);
    try append_line(out,
        "  %run_print_mkdir = call %kizu.error.void @kizu_selfhost__ensure_artifact_dir(%kizu.owned %run_io, %kizu.slice.u8 %run_dir_slice)");
    try append_line(out, "  %run_print_mkdir_ok = extractvalue %kizu.error.void %run_print_mkdir, 0");
    try append_line(out, "  br i1 %run_print_mkdir_ok, label %run_print_prepare, label %check_failed");
    try append_line(out, "run_print_prepare:");
    try append_line(out,
        "  %run_print_payload_slice = extractvalue %kizu.selfhost.executable %run_executable, 1");
    try append_line(out,
        "  %run_print_payload_llvm_result = call %kizu.error.slice.u8 @kizu_selfhost__cli_run_payload_llvm_c_string(%kizu.slice.u8 %run_print_payload_slice)");
    try append_line(out,
        "  %run_print_payload_llvm_ok = extractvalue %kizu.error.slice.u8 %run_print_payload_llvm_result, 0");
    try append_line(out,
        "  br i1 %run_print_payload_llvm_ok, label %run_print_prepare_len, label %check_failed");
    try append_line(out, "run_print_prepare_len:");
    try append_line(out,
        "  %run_print_payload_llvm_slice = extractvalue %kizu.error.slice.u8 %run_print_payload_llvm_result, 1");
    try append_line(out, "  %run_print_payload_len = extractvalue %kizu.slice.u8 %run_print_payload_slice, 1");
    try append_line(out, "  %run_print_stdout_len = add i64 %run_print_payload_len, 1");
    try append_line(out,
        "  %run_print_len_result = call %kizu.error.slice.u8 @kizu_selfhost__i64_decimal(i64 %run_print_stdout_len)");
    try append_line(out, "  %run_print_len_ok = extractvalue %kizu.error.slice.u8 %run_print_len_result, 0");
    try append_line(out, "  br i1 %run_print_len_ok, label %run_print_write_ll, label %check_failed");
    try append_line(out, "run_print_write_ll:");
    try append_global_slice(out, "run_print", "path_prefix", "run_path_prefix", ll_prefix_size);
    try append_global_slice(out, "run_print", "ll_ext", "run_ll_suffix", ll_suffix_size);
    try append_line(out,
        "  %run_print_ll_path_result = call %kizu.error.slice.u8 @kizu_selfhost__artifact_path(%kizu.slice.u8 %target, %kizu.slice.u8 %run_print_path_prefix_slice, %kizu.slice.u8 %run_print_ll_ext_slice)");
    try append_line(out,
        "  %run_print_ll_path_ok = extractvalue %kizu.error.slice.u8 %run_print_ll_path_result, 0");
    try append_line(out,
        "  br i1 %run_print_ll_path_ok, label %run_print_write_ll_body, label %check_failed");
    try append_line(out, "run_print_write_ll_body:");
    try append_line(out,
        "  %run_print_ll_path_slice = extractvalue %kizu.error.slice.u8 %run_print_ll_path_result, 1");
    try append_line(out,
        "  %run_print_len_slice = extractvalue %kizu.error.slice.u8 %run_print_len_result, 1");
    try append_global_slice(
        out,
        "run_print",
        "ll_prefix_source",
        "run_print_ll_prefix_source",
        ll_prefix_source_size
    );
    try append_global_slice(
        out,
        "run_print",
        "ll_prefix_len",
        "run_print_ll_prefix_len",
        dynamic_global_prefix_size
    );
    try append_global_slice(out, "run_print", "ll_prefix_payload", "run_print_ll_prefix_payload", 9);
    try append_global_slice(
        out,
        "run_print",
        "ll_prefix_len2",
        "run_print_ll_prefix_len2",
        dynamic_body_prefix_size
    );
    try append_global_slice(
        out,
        "run_print",
        "ll_suffix",
        "run_print_ll_suffix",
        dynamic_body_suffix_size
    );
    try append_line(out,
        "  %run_print_ll_write = call %kizu.error.void @kizu_selfhost__write_concat9(%kizu.owned %run_io, %kizu.slice.u8 %run_print_ll_path_slice, %kizu.slice.u8 %run_print_ll_prefix_source_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_print_ll_prefix_len_slice, %kizu.slice.u8 %run_print_len_slice, %kizu.slice.u8 %run_print_ll_prefix_payload_slice, %kizu.slice.u8 %run_print_payload_llvm_slice, %kizu.slice.u8 %run_print_ll_prefix_len2_slice, %kizu.slice.u8 %run_print_len_slice, %kizu.slice.u8 %run_print_ll_suffix_slice)");
    try append_line(out, "  %run_print_ll_ok = extractvalue %kizu.error.void %run_print_ll_write, 0");
    try append_line(out, "  br i1 %run_print_ll_ok, label %run_print_write_meta, label %check_failed");
    try append_line(out, "run_print_write_meta:");
    try append_global_slice(
        out,
        "run_print",
        "metadata_path_prefix",
        "run_metadata_path_prefix",
        metadata_prefix_size
    );
    try append_global_slice(
        out,
        "run_print",
        "metadata_path_suffix",
        "run_metadata_path_suffix",
        metadata_suffix_size
    );
    try append_line(out,
        "  %run_print_meta_path_result = call %kizu.error.slice.u8 @kizu_selfhost__artifact_path(%kizu.slice.u8 %target, %kizu.slice.u8 %run_print_metadata_path_prefix_slice, %kizu.slice.u8 %run_print_metadata_path_suffix_slice)");
    try append_line(out,
        "  %run_print_meta_path_ok = extractvalue %kizu.error.slice.u8 %run_print_meta_path_result, 0");
    try append_line(out,
        "  br i1 %run_print_meta_path_ok, label %run_print_write_meta_body, label %check_failed");
    try append_line(out, "run_print_write_meta_body:");
    try append_line(out,
        "  %run_print_meta_path_slice = extractvalue %kizu.error.slice.u8 %run_print_meta_path_result, 1");
    try append_global_slice(out, "run_print", "meta_prefix", "run_meta_prefix", meta_prefix_size);
    try append_global_slice(
        out,
        "run_print",
        "meta_output_prefix",
        "artifact_output_prefix",
        meta_output_prefix_size
    );
    try append_global_slice(
        out,
        "run_print",
        "meta_before_runtime",
        "run_meta_before_runtime",
        meta_before_runtime_size
    );
    try append_global_slice(out, "run_print", "meta_stage2_host", "stage2_host_path", 39);
    try append_global_slice(
        out,
        "run_print",
        "meta_after_runtime",
        "run_meta_after_runtime",
        meta_after_runtime_size
    );
    try append_empty_target_slice(out, "run_print");
    try append_line(out,
        "  %run_print_meta_write = call %kizu.error.void @kizu_selfhost__write_concat9(%kizu.owned %run_io, %kizu.slice.u8 %run_print_meta_path_slice, %kizu.slice.u8 %run_print_meta_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_print_meta_output_prefix_slice, %kizu.slice.u8 %run_print_ll_path_slice, %kizu.slice.u8 %run_print_meta_before_runtime_slice, %kizu.slice.u8 %run_print_meta_stage2_host_slice, %kizu.slice.u8 %run_print_meta_after_runtime_slice, %kizu.slice.u8 %run_print_empty_slice, %kizu.slice.u8 %run_print_empty_slice)");
    try append_line(out,
        "  %run_print_meta_ok = extractvalue %kizu.error.void %run_print_meta_write, 0");
    try append_line(out, "  br i1 %run_print_meta_ok, label %exit_zero, label %check_failed");
    return;
}

fn append_run_return_emit_block(out: &var std::string::String) -> !void {
    let dir_size = std::mem::len(hosted::run_artifact_dir());
    let ll_prefix_size = std::mem::len(hosted::run_artifact_path_prefix());
    let ll_suffix_size = std::mem::len(hosted::artifact_ll_suffix());
    let metadata_prefix_size = std::mem::len(hosted::run_artifact_path_prefix());
    let metadata_suffix_size = std::mem::len(hosted::artifact_metadata_suffix());
    let run_return_comment_case = hosted::run_return_executable();
    let ll_prefix_source_size = hosted_prefix_source_size(run_return_comment_case.comment);
    let run_return_suffix_entry_case = hosted::run_return_executable();
    let run_return_suffix_entry = run_return_suffix_entry_case.entry;
    let run_return_suffix_exit_case = hosted::run_return_executable();
    let run_return_suffix_exit_code = run_return_suffix_exit_case.exit_code;
    let ll_suffix_body_size = try hosted_return_body_suffix_size(
        run_return_suffix_entry,
        run_return_suffix_exit_code
    );
    let meta_prefix_size = try cli_hosted_metadata_llvm::prefix_size(
        hosted::run_metadata_title(),
        hosted::run_metadata_issue()
    );
    let meta_output_prefix_size = try cli_hosted_metadata_llvm::output_prefix_size();
    let run_return_entry_case = hosted::run_return_executable();
    let meta_before_runtime_size = try cli_hosted_metadata_llvm::before_runtime_size(
        run_return_entry_case.entry
    );
    let meta_after_runtime_size = try cli_hosted_metadata_llvm::after_runtime_size(
        cli_hosted_metadata_llvm::no_codegen_ir(),
        false
    );
    try append_line(out, "run_return_emit:");
    try append_global_slice(out, "run_return", "dir", "run_dir", dir_size);
    try append_line(out,
        "  %run_return_mkdir = call %kizu.error.void @kizu_selfhost__ensure_artifact_dir(%kizu.owned %run_io, %kizu.slice.u8 %run_return_dir_slice)");
    try append_line(out, "  %run_return_mkdir_ok = extractvalue %kizu.error.void %run_return_mkdir, 0");
    try append_line(out,
        "  br i1 %run_return_mkdir_ok, label %run_return_write_ll, label %check_failed");
    try append_line(out, "run_return_write_ll:");
    try append_global_slice(out, "run_return", "path_prefix", "run_path_prefix", ll_prefix_size);
    try append_global_slice(out, "run_return", "ll_ext", "run_ll_suffix", ll_suffix_size);
    try append_line(out,
        "  %run_return_ll_path_result = call %kizu.error.slice.u8 @kizu_selfhost__artifact_path(%kizu.slice.u8 %target, %kizu.slice.u8 %run_return_path_prefix_slice, %kizu.slice.u8 %run_return_ll_ext_slice)");
    try append_line(out,
        "  %run_return_ll_path_ok = extractvalue %kizu.error.slice.u8 %run_return_ll_path_result, 0");
    try append_line(out,
        "  br i1 %run_return_ll_path_ok, label %run_return_write_ll_body, label %check_failed");
    try append_line(out, "run_return_write_ll_body:");
    try append_line(out,
        "  %run_return_ll_path_slice = extractvalue %kizu.error.slice.u8 %run_return_ll_path_result, 1");
    try append_global_slice(
        out,
        "run_return",
        "ll_prefix_source",
        "run_return_ll_prefix_source",
        ll_prefix_source_size
    );
    try append_global_slice(out, "run_return", "ll_suffix", "run_return_ll_suffix", ll_suffix_body_size);
    try append_line(out,
        "  %run_return_ll_write = call %kizu.error.void @kizu_selfhost__write_concat3(%kizu.owned %run_io, %kizu.slice.u8 %run_return_ll_path_slice, %kizu.slice.u8 %run_return_ll_prefix_source_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_return_ll_suffix_slice)");
    try append_line(out, "  %run_return_ll_ok = extractvalue %kizu.error.void %run_return_ll_write, 0");
    try append_line(out,
        "  br i1 %run_return_ll_ok, label %run_return_write_meta, label %check_failed");
    try append_line(out, "run_return_write_meta:");
    try append_global_slice(
        out,
        "run_return",
        "metadata_path_prefix",
        "run_metadata_path_prefix",
        metadata_prefix_size
    );
    try append_global_slice(
        out,
        "run_return",
        "metadata_path_suffix",
        "run_metadata_path_suffix",
        metadata_suffix_size
    );
    try append_line(out,
        "  %run_return_meta_path_result = call %kizu.error.slice.u8 @kizu_selfhost__artifact_path(%kizu.slice.u8 %target, %kizu.slice.u8 %run_return_metadata_path_prefix_slice, %kizu.slice.u8 %run_return_metadata_path_suffix_slice)");
    try append_line(out,
        "  %run_return_meta_path_ok = extractvalue %kizu.error.slice.u8 %run_return_meta_path_result, 0");
    try append_line(out,
        "  br i1 %run_return_meta_path_ok, label %run_return_write_meta_body, label %check_failed");
    try append_line(out, "run_return_write_meta_body:");
    try append_line(out,
        "  %run_return_meta_path_slice = extractvalue %kizu.error.slice.u8 %run_return_meta_path_result, 1");
    try append_global_slice(out, "run_return", "meta_prefix", "run_meta_prefix", meta_prefix_size);
    try append_global_slice(
        out,
        "run_return",
        "meta_output_prefix",
        "artifact_output_prefix",
        meta_output_prefix_size
    );
    try append_global_slice(
        out,
        "run_return",
        "meta_before_runtime",
        "run_return_meta_before_runtime",
        meta_before_runtime_size
    );
    try append_global_slice(out, "run_return", "meta_stage2_host", "stage2_host_path", 39);
    try append_global_slice(
        out,
        "run_return",
        "meta_after_runtime",
        "run_return_meta_after_runtime",
        meta_after_runtime_size
    );
    try append_empty_target_slice(out, "run_return");
    try append_line(out,
        "  %run_return_meta_write = call %kizu.error.void @kizu_selfhost__write_concat9(%kizu.owned %run_io, %kizu.slice.u8 %run_return_meta_path_slice, %kizu.slice.u8 %run_return_meta_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_return_meta_output_prefix_slice, %kizu.slice.u8 %run_return_ll_path_slice, %kizu.slice.u8 %run_return_meta_before_runtime_slice, %kizu.slice.u8 %run_return_meta_stage2_host_slice, %kizu.slice.u8 %run_return_meta_after_runtime_slice, %kizu.slice.u8 %run_return_empty_slice, %kizu.slice.u8 %run_return_empty_slice)");
    try append_line(out,
        "  %run_return_meta_ok = extractvalue %kizu.error.void %run_return_meta_write, 0");
    try append_line(out, "  br i1 %run_return_meta_ok, label %exit_zero, label %check_failed");
    return;
}

fn append_cli_run_payload_llvm_c_string_function(out: &var std::string::String) -> !void {
    try append_line(out,
        "define %kizu.error.slice.u8 @kizu_selfhost__cli_run_payload_llvm_c_string(");
    try append_line(out, "  %kizu.slice.u8 %payload");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %payload_ptr = extractvalue %kizu.slice.u8 %payload, 0");
    try append_line(out, "  %payload_len = extractvalue %kizu.slice.u8 %payload, 1");
    try append_line(out, "  %triple_len = mul i64 %payload_len, 3");
    try append_line(out, "  %capacity = add i64 %triple_len, 1");
    try append_line(out, "  %capacity_ok = icmp uge i64 %capacity, %payload_len");
    try append_line(out, "  br i1 %capacity_ok, label %allocate, label %false");
    try append_line(out, "allocate:");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %capacity)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %loop, label %false");
    try append_line(out, "loop:");
    try append_line(out,
        "  %index = phi i64 [ 0, %allocate ], [ %raw_next, %copy_raw ], [ %slash_next, %copy_backslash_tail ]");
    try append_line(out, "  %written = phi i64 [ 0, %allocate ], [ %raw_written, %copy_raw ], [ %slash_written, %copy_backslash_tail ]");
    try append_line(out, "  %done = icmp eq i64 %index, %payload_len");
    try append_line(out, "  br i1 %done, label %true, label %load");
    try append_line(out, "load:");
    try append_line(out, "  %source_at = getelementptr i8, ptr %payload_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %source_at");
    try append_line(out, "  %is_backslash = icmp eq i8 %byte, 92");
    try append_line(out, "  br i1 %is_backslash, label %copy_backslash_head, label %copy_raw");
    try append_line(out, "copy_raw:");
    try append_line(out, "  %raw_dest = getelementptr i8, ptr %buffer, i64 %written");
    try append_line(out, "  store i8 %byte, ptr %raw_dest");
    try append_line(out, "  %raw_written = add i64 %written, 1");
    try append_line(out, "  %raw_next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "copy_backslash_head:");
    try append_line(out, "  %slash_dest = getelementptr i8, ptr %buffer, i64 %written");
    try append_line(out, "  store i8 92, ptr %slash_dest");
    try append_line(out, "  %hex_five_at = add i64 %written, 1");
    try append_line(out, "  %hex_five_dest = getelementptr i8, ptr %buffer, i64 %hex_five_at");
    try append_line(out, "  store i8 53, ptr %hex_five_dest");
    try append_line(out, "  br label %copy_backslash_tail");
    try append_line(out, "copy_backslash_tail:");
    try append_line(out, "  %hex_c_at = add i64 %written, 2");
    try append_line(out, "  %hex_c_dest = getelementptr i8, ptr %buffer, i64 %hex_c_at");
    try append_line(out, "  store i8 67, ptr %hex_c_dest");
    try append_line(out, "  %slash_written = add i64 %written, 3");
    try append_line(out, "  %slash_next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out, "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %written, 1");
    try append_line(out, "  %ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out, "  %result = insertvalue %kizu.error.slice.u8 %ok, %kizu.slice.u8 %body, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "false:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: i64,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_empty_target_slice(out: &var std::string::String, local: []u8) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_empty_ptr = extractvalue %kizu.slice.u8 %target, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_empty_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(local);
    try out.append_bytes("_empty_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_empty_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(local);
    try out.append_bytes("_empty_base, i64 0, 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    local: []u8,
    field: []u8,
    global: []u8,
    size: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn executable_kind_tag(ir_bytes: []u8, name: []u8) -> !i64 {
    return try data::executable_kind_tag_by_name(name);
}

fn hosted_prefix_source_size(comment: []u8) -> i64 {
    let suffix = "\0Asource_filename = \22";
    return 2 + std::mem::len(comment) + llvm_c_decoded_len(suffix);
}

fn run_dynamic_global_prefix_size(global: []u8) -> i64 {
    let prefix =
        "\22\0A\0A%kizu.slice.u8 = type { ptr, i64 }\0A%kizu.owned = type { ptr }\0A";
    let middle = "%kizu.error.void = type { i1, %kizu.slice.u8 }\0A\0A@.";
    let suffix = " = private unnamed_addr constant [";
    return llvm_c_decoded_len(prefix) + llvm_c_decoded_len(middle) +
        std::mem::len(global) + std::mem::len(suffix);
}

fn run_dynamic_body_prefix_size(
    entry: []u8,
    global: []u8,
    stream: data::HostedOutputStream,
    append_newline: bool
) -> !i64 {
    let stream_name = try hosted_output_stream_llvm_name(stream);
    var size = 0;
    if append_newline {
        size = size + llvm_c_decoded_len("\5C0A");
    }
    let header = "\22\0A\0Adeclare %kizu.owned @kizu_rt_io_blocking()\0A";
    let write_prefix = "declare %kizu.error.void @kizu_rt_io_write_";
    let write_suffix =
        "(%kizu.owned, %kizu.slice.u8)\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0A";
    let entry_prefix = "define i64 @";
    let entry_suffix = "() {\0Aentry:\0A";
    let io = "  %io = call %kizu.owned @kizu_rt_io_blocking()\0A";
    let base = "  %base = insertvalue %kizu.slice.u8 poison, ptr @.";
    let tail = ", 0\0A  %slice = insertvalue %kizu.slice.u8 %base, i64 ";
    return size + llvm_c_decoded_len(header) + std::mem::len(write_prefix) +
        std::mem::len(stream_name) + llvm_c_decoded_len(write_suffix) +
        std::mem::len(entry_prefix) + std::mem::len(entry) +
        llvm_c_decoded_len(entry_suffix) + llvm_c_decoded_len(io) +
        std::mem::len(base) + std::mem::len(global) + llvm_c_decoded_len(tail);
}

fn run_dynamic_body_suffix_size(
    stream: data::HostedOutputStream,
    exit_code: i64
) -> !i64 {
    let stream_name = try hosted_output_stream_llvm_name(stream);
    let prefix = ", 1\0A";
    let write_prefix = "  %write = call %kizu.error.void @kizu_rt_io_write_";
    let write_suffix = "(%kizu.owned %io, %kizu.slice.u8 %slice)\0A";
    return llvm_c_decoded_len(prefix) + std::mem::len(write_prefix) +
        std::mem::len(stream_name) + llvm_c_decoded_len(write_suffix) +
        hosted_exit_decoded_len(exit_code);
}

fn hosted_return_body_suffix_size(entry: []u8, exit_code: i64) -> !i64 {
    let header = "\22\0A\0Adeclare i64 @kizu_rt_process_exit_code(i64)\0A\0A";
    let entry_prefix = "define i64 @";
    let entry_suffix = "() {\0Aentry:\0A";
    return llvm_c_decoded_len(header) + std::mem::len(entry_prefix) +
        std::mem::len(entry) + llvm_c_decoded_len(entry_suffix) +
        hosted_exit_decoded_len(exit_code);
}

fn hosted_output_stream_llvm_name(stream: data::HostedOutputStream) -> ![]u8 {
    if stream == data::HostedOutputStream::Stdout {
        return "stdout";
    }
    if stream == data::HostedOutputStream::Stderr {
        return "stderr";
    }
    return error("invalid hosted output stream");
}

fn append_hosted_exit(out: &var std::string::String, exit_code: i64) -> !void {
    try out.append_bytes("  %code = call i64 @kizu_rt_process_exit_code(i64 ");
    try std::fmt::append_i64(out, exit_code);
    try out.append_bytes(")\0A  ret i64 %code\0A}\0A");
    return;
}

fn hosted_exit_decoded_len(exit_code: i64) -> i64 {
    return std::mem::len("  %code = call i64 @kizu_rt_process_exit_code(i64 ") +
        decimal_len_i64(exit_code) + llvm_c_decoded_len(")\0A  ret i64 %code\0A}\0A");
}

fn append_llvm_c_string_payload(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte == cast<u8>(34) {
            try out.append_bytes("\22");
        } else {
            if byte == cast<u8>(92) {
                try out.append_bytes("\5C");
            } else {
                if byte == cast<u8>(10) {
                    try out.append_bytes("\0A");
                } else {
                    try out.append_byte(byte);
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn llvm_c_decoded_len(text: []u8) -> i64 {
    var len = 0;
    var index = 0;
    let byte_len = std::mem::len(text);
    while index < byte_len {
        if index + 2 < byte_len and
            text[index] == cast<u8>(92) and
            is_hex_digit(text[index + 1]) and
            is_hex_digit(text[index + 2]) {
            len = len + 1;
            index = index + 3;
        } else {
            len = len + 1;
            index = index + 1;
        }
    }
    return len;
}

fn is_hex_digit(byte: u8) -> bool {
    if byte >= cast<u8>(48) and byte <= cast<u8>(57) {
        return true;
    }
    if byte >= cast<u8>(65) and byte <= cast<u8>(70) {
        return true;
    }
    if byte >= cast<u8>(97) and byte <= cast<u8>(102) {
        return true;
    }
    return false;
}

fn decimal_len_i64(value: i64) -> i64 {
    if value == 0 {
        return 1;
    }
    var remaining = value;
    var digits = 0;
    while remaining > 0 {
        remaining = remaining / 10;
        digits = digits + 1;
    }
    return digits;
}

fn append_executable_kind_compare(
    out: &var std::string::String,
    result: []u8,
    value: []u8,
    kind: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(result);
    try out.append_bytes(" = icmp eq i64 %");
    try out.append_bytes(value);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, kind);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
