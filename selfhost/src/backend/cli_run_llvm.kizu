import selfhost::backend::cli_check_gate_llvm;
import selfhost::backend::cli_codegen_llvm;
import selfhost::backend::cli_hosted_metadata_llvm;
import selfhost::backend::hosted;

pub fn append_globals(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_llvm_constant_bytes(out, "run_cache_dir", hosted::run_artifact_cache_dir());
    try append_llvm_constant_bytes(out, "run_dir", hosted::run_artifact_dir());
    try append_llvm_constant_bytes(out, "run_path_prefix", hosted::run_artifact_path_prefix());
    try append_llvm_constant_bytes(out, "run_ll_suffix", hosted::artifact_ll_suffix());
    try append_llvm_constant_bytes(out, "run_meta_suffix", hosted::artifact_metadata_suffix());
    try append_llvm_constant_bytes(out, "run_linker_tool", hosted::run_linker_tool());
    try append_llvm_constant_bytes(out, "run_linker_module_flag", hosted::run_linker_llvm_module_flag());
    try append_llvm_constant_bytes(out, "run_linker_external_assembler_flag", hosted::run_linker_external_assembler_flag());
    try append_llvm_constant_bytes(out, "run_host_runtime_source", hosted::run_host_runtime_source());
    try append_llvm_constant_bytes(out, "run_linker_output_flag", hosted::run_linker_output_flag());
    try cli_hosted_metadata_llvm::append_prefix_constant(
        out,
        "run_meta_prefix",
        hosted::run_metadata_title(),
        hosted::run_metadata_issue()
    );
    try cli_hosted_metadata_llvm::append_before_runtime_constant(
        out,
        "run_meta_before_runtime",
        "kizu_run_main"
    );
    try append_after_runtime_constant_from_body(
        out,
        "run_meta_after_runtime",
        ir_bytes,
        false
    );
    return;
}

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_emit_run_codegen_artifact_function(out, ir_bytes);
    return;
}

pub fn append_cli_run_blocks(
    out: &var std::string::String,
    ir_bytes: []u8,
    parse_result_abi: []u8
) -> !void {
    try append_line(out, "dispatch_run:");
    try append_line(out, "  %run_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %run_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %run_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %run_file_ok = extractvalue %kizu.error.slice.u8 %run_file, 0");
    try append_line(out, "  br i1 %run_file_ok, label %run_read_ok, label %check_failed");
    try append_line(out, "run_read_ok:");
    try append_line(out, "  %run_bytes = extractvalue %kizu.error.slice.u8 %run_file, 1");
    try cli_check_gate_llvm::append_parse_validation_gate(
        out,
        "run_check",
        "run_check",
        "run_io",
        "run_bytes",
        "run_match_source"
    );
    try append_line(out, "run_match_source:");
    try append_line(out,
        "  %run_allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try out.append_bytes("  %run_parsed = call ");
    try out.append_bytes(parse_result_abi);
    try out.append_bytes(" @kizu_selfhost__cli_parse_validated_ast(%kizu.owned %run_allocator, %kizu.slice.u8 %target, %kizu.slice.u8 %run_bytes)");
    try out.append_byte(cast<u8>(10));
    try cli_check_gate_llvm::append_semantic_check_gate(
        out,
        parse_result_abi,
        "run_check",
        "run_io",
        "run_allocator",
        "target",
        "run_bytes",
        "run_parsed",
        "run_semantic_ok"
    );
    try append_line(out, "run_semantic_ok:");
    // The compiled Kizu helper owns ConstructorFacts initialization/collection and
    // the seven-argument renderer call. Static CLI LLVM passes only the checked
    // source inputs across this single boundary.
    try out.append_bytes("  %run_render = call %kizu.error.owned @kizu_selfhost__cli_execute_render_checked_run_artifact(%kizu.owned %run_allocator, %kizu.slice.u8 %target, %kizu.slice.u8 %run_bytes, ");
    try out.append_bytes(parse_result_abi);
    try out.append_bytes(" %run_parsed)");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %run_render_ok = extractvalue %kizu.error.owned %run_render, 0");
    try append_line(out, "  br i1 %run_render_ok, label %run_render_ready, label %run_unsupported");
    try append_line(out, "run_render_ready:");
    try append_line(out,
        "  %run_render_string = extractvalue %kizu.error.owned %run_render, 1");
    try append_line(out,
        "  %run_render_bytes = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %run_render_string)");
    try append_line(out,
        "  %run_emitted = call i1 @kizu_selfhost__cli_emit_run_codegen_artifact(%kizu.owned %run_io, %kizu.slice.u8 %target, %kizu.slice.u8 %run_render_bytes)");
    try append_line(out, "  br i1 %run_emitted, label %run_artifact_paths, label %run_unsupported");
    try append_line(out, "run_artifact_paths:");
    try append_global_slice(out, "run", "path_prefix", "run_path_prefix", std::mem::len(hosted::run_artifact_path_prefix()));
    try append_global_slice(out, "run", "ll_suffix", "run_ll_suffix", std::mem::len(hosted::artifact_ll_suffix()));
    try append_line(out, "  %run_empty_slice = insertvalue %kizu.slice.u8 zeroinitializer, i64 0, 1");
    try append_line(out,
        "  %run_ll_path_result = call %kizu.error.owned @kizu_selfhost__backend_hosted_artifact_path(%kizu.owned %run_allocator, %kizu.slice.u8 %run_path_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_ll_suffix_slice)");
    try append_line(out, "  %run_ll_path_ok = extractvalue %kizu.error.owned %run_ll_path_result, 0");
    try append_line(out, "  br i1 %run_ll_path_ok, label %run_build_exe_path, label %usage");
    try append_line(out, "run_build_exe_path:");
    try append_line(out,
        "  %run_exe_path_result = call %kizu.error.owned @kizu_selfhost__backend_hosted_artifact_path(%kizu.owned %run_allocator, %kizu.slice.u8 %run_path_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_empty_slice)");
    try append_line(out, "  %run_exe_path_ok = extractvalue %kizu.error.owned %run_exe_path_result, 0");
    try append_line(out, "  br i1 %run_exe_path_ok, label %run_link_artifact, label %usage");
    try append_line(out, "run_link_artifact:");
    try append_line(out, "  %run_ll_path_str = extractvalue %kizu.error.owned %run_ll_path_result, 1");
    try append_line(out, "  %run_ll_path = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %run_ll_path_str)");
    try append_line(out, "  %run_exe_path_str = extractvalue %kizu.error.owned %run_exe_path_result, 1");
    try append_line(out, "  %run_exe_path = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %run_exe_path_str)");
    try append_global_slice(out, "run", "stage2_host", "stage2_host_path", 39);
    try append_global_slice(out, "run", "stage2_storage", "stage2_storage_path", 42);
    try append_global_slice(out, "run", "linker_tool", "run_linker_tool", std::mem::len(hosted::run_linker_tool()));
    try append_global_slice(out, "run", "linker_module_flag", "run_linker_module_flag", std::mem::len(hosted::run_linker_llvm_module_flag()));
    try append_global_slice(out, "run", "linker_external_assembler_flag", "run_linker_external_assembler_flag", std::mem::len(hosted::run_linker_external_assembler_flag()));
    try append_global_slice(out, "run", "host_runtime_source", "run_host_runtime_source", std::mem::len(hosted::run_host_runtime_source()));
    try append_global_slice(out, "run", "linker_output_flag", "run_linker_output_flag", std::mem::len(hosted::run_linker_output_flag()));
    try append_line(out,
        "  %run_link_result = call %kizu.error.i64 @kizu_rt_process_spawn_wait8(i64 8, %kizu.slice.u8 %run_linker_tool_slice, %kizu.slice.u8 %run_linker_module_flag_slice, %kizu.slice.u8 %run_ll_path, %kizu.slice.u8 %run_stage2_storage_slice, %kizu.slice.u8 %run_stage2_host_slice, %kizu.slice.u8 %run_host_runtime_source_slice, %kizu.slice.u8 %run_linker_output_flag_slice, %kizu.slice.u8 %run_exe_path)");
    try append_line(out, "  %run_link_ok = extractvalue %kizu.error.i64 %run_link_result, 0");
    try append_line(out, "  br i1 %run_link_ok, label %run_check_link_code, label %usage");
    try append_line(out, "run_check_link_code:");
    try append_line(out, "  %run_link_code = extractvalue %kizu.error.i64 %run_link_result, 1");
    try append_line(out, "  %run_link_succeeded = icmp eq i64 %run_link_code, 0");
    try append_line(out, "  br i1 %run_link_succeeded, label %run_execute_artifact, label %usage");
    try append_line(out, "run_execute_artifact:");
    try append_line(out,
        "  %run_artifact_result = call %kizu.error.i64 @kizu_rt_process_spawn_wait8(i64 1, %kizu.slice.u8 %run_exe_path, %kizu.slice.u8 %run_empty_slice, %kizu.slice.u8 %run_empty_slice, %kizu.slice.u8 %run_empty_slice, %kizu.slice.u8 %run_empty_slice, %kizu.slice.u8 %run_empty_slice, %kizu.slice.u8 %run_empty_slice, %kizu.slice.u8 %run_empty_slice)");
    try append_line(out, "  %run_artifact_ok = extractvalue %kizu.error.i64 %run_artifact_result, 0");
    try append_line(out, "  br i1 %run_artifact_ok, label %run_return_artifact_code, label %usage");
    try append_line(out, "run_return_artifact_code:");
    try append_line(out, "  %run_artifact_code = extractvalue %kizu.error.i64 %run_artifact_result, 1");
    try append_line(out, "  ret i64 %run_artifact_code");
    return;
}

fn append_emit_run_codegen_artifact_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__cli_emit_run_codegen_artifact(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %target,");
    try append_line(out, "  %kizu.slice.u8 %artifact");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "run_emit", "cache_dir", "run_cache_dir", std::mem::len(hosted::run_artifact_cache_dir()));
    try append_line(out,
        "  %cache_mkdir = call %kizu.error.void @kizu_selfhost__ensure_artifact_dir(%kizu.owned %io, %kizu.slice.u8 %run_emit_cache_dir_slice)");
    try append_line(out, "  %cache_mkdir_ok = extractvalue %kizu.error.void %cache_mkdir, 0");
    try append_line(out, "  br i1 %cache_mkdir_ok, label %make_run_dir, label %failed");
    try append_line(out, "make_run_dir:");
    try append_global_slice(out, "run_emit", "dir", "run_dir", std::mem::len(hosted::run_artifact_dir()));
    try append_line(out,
        "  %mkdir = call %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned %io, %kizu.slice.u8 %run_emit_dir_slice)");
    try append_line(out, "  %mkdir_ok = extractvalue %kizu.error.void %mkdir, 0");
    try append_line(out, "  br i1 %mkdir_ok, label %build_paths, label %failed");
    try append_line(out, "build_paths:");
    try append_global_slice(out, "run_emit", "path_prefix", "run_path_prefix", std::mem::len(hosted::run_artifact_path_prefix()));
    try append_global_slice(out, "run_emit", "ll_suffix", "run_ll_suffix", std::mem::len(hosted::artifact_ll_suffix()));
    try append_global_slice(out, "run_emit", "meta_suffix", "run_meta_suffix", std::mem::len(hosted::artifact_metadata_suffix()));
    try append_line(out, "  %empty_slice = insertvalue %kizu.slice.u8 zeroinitializer, i64 0, 1");
    try append_line(out, "  %emit_allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out,
        "  %ll_path_result = call %kizu.error.owned @kizu_selfhost__backend_hosted_artifact_path(%kizu.owned %emit_allocator, %kizu.slice.u8 %run_emit_path_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_emit_ll_suffix_slice)");
    try append_line(out, "  %ll_path_ok = extractvalue %kizu.error.owned %ll_path_result, 0");
    try append_line(out, "  br i1 %ll_path_ok, label %build_meta_path, label %failed");
    try append_line(out, "build_meta_path:");
    try append_line(out, "  %ll_path_str = extractvalue %kizu.error.owned %ll_path_result, 1");
    try append_line(out, "  %ll_path = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %ll_path_str)");
    try append_line(out,
        "  %meta_path_result = call %kizu.error.owned @kizu_selfhost__backend_hosted_artifact_path(%kizu.owned %emit_allocator, %kizu.slice.u8 %run_emit_path_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_emit_meta_suffix_slice)");
    try append_line(out, "  %meta_path_ok = extractvalue %kizu.error.owned %meta_path_result, 0");
    try append_line(out, "  br i1 %meta_path_ok, label %write_ll, label %failed");
    try append_line(out, "write_ll:");
    try append_line(out, "  %meta_path_str = extractvalue %kizu.error.owned %meta_path_result, 1");
    try append_line(out, "  %meta_path = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %meta_path_str)");
    // The artifact is the fully rendered run codegen LLVM module text; write it to the
    // .ll path verbatim. The generic tape renderer produced it, so there is no longer a
    // per-shape writer branch.
    try append_line(out,
        "  %ll_write = call %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned %io, %kizu.slice.u8 %ll_path, %kizu.slice.u8 %artifact)");
    try append_line(out, "  %ll_write_ok = extractvalue %kizu.error.void %ll_write, 0");
    try append_line(out, "  br i1 %ll_write_ok, label %write_meta, label %failed");
    try append_line(out, "write_meta:");
    try append_global_slice(out, "run_emit", "meta_prefix", "run_meta_prefix", try cli_hosted_metadata_llvm::prefix_size(hosted::run_metadata_title(), hosted::run_metadata_issue()));
    try append_global_slice(out, "run_emit", "meta_output_prefix", "artifact_output_prefix", try cli_hosted_metadata_llvm::output_prefix_size());
    try append_global_slice(out, "run_emit", "meta_before_runtime", "run_meta_before_runtime", try cli_hosted_metadata_llvm::before_runtime_size("kizu_run_main"));
    try append_global_slice(out, "run_emit", "stage2_host", "stage2_host_path", 39);
    try append_global_slice(out, "run_emit", "meta_after_runtime", "run_meta_after_runtime", try after_runtime_size_from_body(ir_bytes, false));
    try append_line(out,
        "  %meta_write = call %kizu.error.void @kizu_selfhost__write_concat9(%kizu.owned %io, %kizu.slice.u8 %meta_path, %kizu.slice.u8 %run_emit_meta_prefix_slice, %kizu.slice.u8 %target, %kizu.slice.u8 %run_emit_meta_output_prefix_slice, %kizu.slice.u8 %ll_path, %kizu.slice.u8 %run_emit_meta_before_runtime_slice, %kizu.slice.u8 %run_emit_stage2_host_slice, %kizu.slice.u8 %run_emit_meta_after_runtime_slice, %kizu.slice.u8 %empty_slice, %kizu.slice.u8 %empty_slice)");
    try append_line(out, "  %meta_write_ok = extractvalue %kizu.error.void %meta_write, 0");
    try append_line(out, "  br i1 %meta_write_ok, label %ok, label %failed");
    try append_line(out, "ok:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "failed:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_after_runtime_constant_from_body(
    out: &var std::string::String,
    name: []u8,
    ir_bytes: []u8,
    include_discovery: bool
) -> !void {
    let size = try after_runtime_size_from_body(ir_bytes, include_discovery);
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes("\0A");
    try out.append_bytes("codegen_ir ");
    try cli_codegen_llvm::append_metadata_line_body_payload(out, ir_bytes);
    try out.append_bytes("\0A");
    try append_line_value(out, hosted::metadata_run_codegen_line());
    try append_line_value(out, hosted::metadata_lowering_line());
    try append_line_value(out, hosted::metadata_fallback_line());
    try append_line_value(out, hosted::metadata_mode_line());
    if include_discovery {
        try append_line_value(out, hosted::test_metadata_discovery_line());
    }
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn after_runtime_size_from_body(ir_bytes: []u8, include_discovery: bool) -> !i64 {
    let metadata_len = try cli_codegen_llvm::metadata_line_body_decoded_len(ir_bytes);
    var size = 1 + std::mem::len("codegen_ir ") +
        metadata_len + 1 +
        std::mem::len(hosted::metadata_run_codegen_line()) + 1 +
        std::mem::len(hosted::metadata_lowering_line()) + 1 +
        std::mem::len(hosted::metadata_fallback_line()) + 1 +
        std::mem::len(hosted::metadata_mode_line()) + 1;
    if include_discovery {
        size = size + std::mem::len(hosted::test_metadata_discovery_line()) + 1;
    }
    return size;
}

fn append_line_value(out: &var std::string::String, value: []u8) -> !void {
    try append_llvm_c_string_payload(out, value);
    try out.append_bytes("\0A");
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    local: []u8,
    field: []u8,
    global: []u8,
    size: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(local);
    try out.append_bytes("_");
    try out.append_bytes(field);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_constant_bytes(
    out: &var std::string::String,
    name: []u8,
    text: []u8
) -> !void {
    try append_llvm_constant_decoded(out, name, std::mem::len(text), text);
    return;
}

fn append_llvm_constant_decoded(
    out: &var std::string::String,
    name: []u8,
    size: i64,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_llvm_c_string_payload(out: &var std::string::String, payload: []u8) -> !void {
    var index = 0;
    let length = std::mem::len(payload);
    while index < length {
        let byte = payload[index];
        if byte == cast<u8>(34) {
            try out.append_bytes("\22");
        } else {
            if byte == cast<u8>(92) {
                try out.append_bytes("\5C");
            } else {
                if byte == cast<u8>(10) {
                    try out.append_bytes("\0A");
                } else {
                    try out.append_byte(byte);
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn llvm_c_decoded_len(text: []u8) -> i64 {
    var len = 0;
    var index = 0;
    let byte_len = std::mem::len(text);
    while index < byte_len {
        if index + 2 < byte_len and
            text[index] == cast<u8>(92) and
            is_hex_digit(text[index + 1]) and
            is_hex_digit(text[index + 2]) {
            len = len + 1;
            index = index + 3;
        } else {
            len = len + 1;
            index = index + 1;
        }
    }
    return len;
}

fn is_hex_digit(byte: u8) -> bool {
    return (byte >= cast<u8>(48) and byte <= cast<u8>(57)) or
        (byte >= cast<u8>(65) and byte <= cast<u8>(70)) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(102));
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
