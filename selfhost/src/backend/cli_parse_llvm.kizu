import selfhost::backend::cli_parse_comment_llvm;
import selfhost::backend::cli_parse_diag_llvm;

pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(out, "parse_space", "1", " ");
    try append_llvm_constant(out, "parse_newline", "1", "\0A");
    try append_llvm_constant(out, "parse_digits", "10", "0123456789");
    try append_llvm_constant(out, "fmt_temp_suffix", "13", ".kizu-fmt.tmp");
    try cli_parse_comment_llvm::append_globals(out);
    try cli_parse_diag_llvm::append_globals(out);
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_parse_is_word_byte_function(out);
    try append_parse_next_non_ws_index_function(out);
    try append_parse_token_end_function(out);
    try append_parse_token_kind_function(out);
    try append_parse_should_space_function(out);
    try append_parse_is_decl_start_function(out);
    try append_parse_is_trailing_comma_function(out);
    try cli_parse_comment_llvm::append_functions(out);
    try cli_parse_diag_llvm::append_functions(out);
    try append_parse_buffer_append_function(out);
    try append_parse_format_alloc_function(out);
    try append_parse_temp_path_function(out);
    try append_parse_format_write_function(out);
    try append_format_source_write_function(out);
    try append_format_source_file_write_function(out);
    return;
}

pub fn append_cli_parse_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_parse:");
    try append_line(out, "  %parse_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %parse_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %parse_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %parse_file_ok = extractvalue %kizu.error.slice.u8 %parse_file, 0");
    try append_line(out, "  br i1 %parse_file_ok, label %parse_read_ok, label %check_failed");
    try append_line(out, "parse_read_ok:");
    try append_line(out, "  %parse_bytes = extractvalue %kizu.error.slice.u8 %parse_file, 1");
    try append_line(out, "  br label %parse_validate");
    try append_line(out, "parse_validate:");
    try append_line(out,
        "  %parse_missing_index = call i64 @kizu_selfhost__parse_missing_expr_index(%kizu.slice.u8 %parse_bytes)");
    try append_line(out, "  %parse_has_missing = icmp sge i64 %parse_missing_index, 0");
    try append_line(out,
        "  br i1 %parse_has_missing, label %parse_missing_expr, label %parse_check_assign");
    try append_line(out, "parse_missing_expr:");
    try append_line(out,
        "  %parse_missing_ok = call i1 @kizu_selfhost__parse_write_missing_expr(%kizu.owned %parse_io, %kizu.slice.u8 %parse_bytes, i64 %parse_missing_index)");
    try append_line(out, "  br i1 %parse_missing_ok, label %exit_one, label %check_failed");
    try append_line(out, "parse_check_assign:");
    try append_line(out,
        "  %parse_missing_assign_index = call i64 @kizu_selfhost__parse_missing_assign_index(%kizu.slice.u8 %parse_bytes)");
    try append_line(out,
        "  %parse_has_missing_assign = icmp sge i64 %parse_missing_assign_index, 0");
    try append_line(out,
        "  br i1 %parse_has_missing_assign, label %parse_missing_assign, label %parse_format");
    try append_line(out, "parse_missing_assign:");
    try append_line(out,
        "  %parse_assign_ok = call i1 @kizu_selfhost__parse_write_missing_assign(%kizu.owned %parse_io, %kizu.slice.u8 %parse_bytes, i64 %parse_missing_assign_index)");
    try append_line(out, "  br i1 %parse_assign_ok, label %exit_one, label %check_failed");
    try append_line(out, "parse_format:");
    try append_line(out,
        "  %parse_format_ok = call i1 @kizu_selfhost__parse_format_write(%kizu.owned %parse_io, %kizu.slice.u8 %parse_bytes, i1 false)");
    try append_line(out, "  br i1 %parse_format_ok, label %exit_zero, label %check_failed");
    return;
}

pub fn append_cli_fmt_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_fmt:");
    try append_line(out, "  %fmt_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %fmt_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %fmt_io, %kizu.slice.u8 %target)");
    try append_line(out, "  %fmt_file_ok = extractvalue %kizu.error.slice.u8 %fmt_file, 0");
    try append_line(out, "  br i1 %fmt_file_ok, label %fmt_read_ok, label %check_failed");
    try append_line(out, "fmt_read_ok:");
    try append_line(out, "  %fmt_bytes = extractvalue %kizu.error.slice.u8 %fmt_file, 1");
    try append_line(out,
        "  %fmt_missing_index = call i64 @kizu_selfhost__parse_missing_expr_index(%kizu.slice.u8 %fmt_bytes)");
    try append_line(out, "  %fmt_has_missing = icmp sge i64 %fmt_missing_index, 0");
    try append_line(out,
        "  br i1 %fmt_has_missing, label %fmt_missing_expr, label %fmt_check_assign");
    try append_line(out, "fmt_missing_expr:");
    try append_line(out,
        "  %fmt_missing_ok = call i1 @kizu_selfhost__parse_write_missing_expr(%kizu.owned %fmt_io, %kizu.slice.u8 %fmt_bytes, i64 %fmt_missing_index)");
    try append_line(out, "  br i1 %fmt_missing_ok, label %exit_one, label %check_failed");
    try append_line(out, "fmt_check_assign:");
    try append_line(out,
        "  %fmt_missing_assign_index = call i64 @kizu_selfhost__parse_missing_assign_index(%kizu.slice.u8 %fmt_bytes)");
    try append_line(out,
        "  %fmt_has_missing_assign = icmp sge i64 %fmt_missing_assign_index, 0");
    try append_line(out,
        "  br i1 %fmt_has_missing_assign, label %fmt_missing_assign, label %fmt_format");
    try append_line(out, "fmt_missing_assign:");
    try append_line(out,
        "  %fmt_assign_ok = call i1 @kizu_selfhost__parse_write_missing_assign(%kizu.owned %fmt_io, %kizu.slice.u8 %fmt_bytes, i64 %fmt_missing_assign_index)");
    try append_line(out, "  br i1 %fmt_assign_ok, label %exit_one, label %check_failed");
    try append_line(out, "fmt_format:");
    try append_line(out,
        "  %fmt_format_ok = call i1 @kizu_selfhost__format_source_write(%kizu.owned %fmt_io, %kizu.slice.u8 %fmt_bytes, i1 true)");
    try append_line(out, "  br i1 %fmt_format_ok, label %exit_zero, label %check_failed");
    return;
}

pub fn append_cli_fmt_write_blocks(out: &var std::string::String) -> !void {
    try append_line(out, "dispatch_fmt_write:");
    try append_line(out, "  %fmt_write_io = call %kizu.owned @kizu_rt_io_blocking()");
    try append_line(out,
        "  %fmt_write_file = call %kizu.error.slice.u8 @kizu_rt_fs_read_file(%kizu.owned %fmt_write_io, %kizu.slice.u8 %fmt_write_target)");
    try append_line(out, "  %fmt_write_file_ok = extractvalue %kizu.error.slice.u8 %fmt_write_file, 0");
    try append_line(out,
        "  br i1 %fmt_write_file_ok, label %fmt_write_read_ok, label %check_failed");
    try append_line(out, "fmt_write_read_ok:");
    try append_line(out, "  %fmt_write_bytes = extractvalue %kizu.error.slice.u8 %fmt_write_file, 1");
    try append_line(out,
        "  %fmt_write_missing_index = call i64 @kizu_selfhost__parse_missing_expr_index(%kizu.slice.u8 %fmt_write_bytes)");
    try append_line(out, "  %fmt_write_has_missing = icmp sge i64 %fmt_write_missing_index, 0");
    try append_line(out,
        "  br i1 %fmt_write_has_missing, label %fmt_write_missing_expr, label %fmt_write_check_assign");
    try append_line(out, "fmt_write_missing_expr:");
    try append_line(out,
        "  %fmt_write_missing_ok = call i1 @kizu_selfhost__parse_write_missing_expr(%kizu.owned %fmt_write_io, %kizu.slice.u8 %fmt_write_bytes, i64 %fmt_write_missing_index)");
    try append_line(out, "  br i1 %fmt_write_missing_ok, label %exit_one, label %check_failed");
    try append_line(out, "fmt_write_check_assign:");
    try append_line(out,
        "  %fmt_write_missing_assign_index = call i64 @kizu_selfhost__parse_missing_assign_index(%kizu.slice.u8 %fmt_write_bytes)");
    try append_line(out,
        "  %fmt_write_has_missing_assign = icmp sge i64 %fmt_write_missing_assign_index, 0");
    try append_line(out,
        "  br i1 %fmt_write_has_missing_assign, label %fmt_write_missing_assign, label %fmt_write_format");
    try append_line(out, "fmt_write_missing_assign:");
    try append_line(out,
        "  %fmt_write_assign_ok = call i1 @kizu_selfhost__parse_write_missing_assign(%kizu.owned %fmt_write_io, %kizu.slice.u8 %fmt_write_bytes, i64 %fmt_write_missing_assign_index)");
    try append_line(out, "  br i1 %fmt_write_assign_ok, label %exit_one, label %check_failed");
    try append_line(out, "fmt_write_format:");
    try append_line(out,
        "  %fmt_write_format_ok = call i1 @kizu_selfhost__format_source_file_write(%kizu.owned %fmt_write_io, %kizu.slice.u8 %fmt_write_target, %kizu.slice.u8 %fmt_write_bytes, i1 true)");
    try append_line(out,
        "  br i1 %fmt_write_format_ok, label %exit_zero, label %check_failed");
    return;
}

fn append_parse_is_word_byte_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_is_word_byte(i8 %byte) {");
    try append_line(out, "entry:");
    try append_line(out, "  %upper_low = icmp uge i8 %byte, 65");
    try append_line(out, "  %upper_high = icmp ule i8 %byte, 90");
    try append_line(out, "  %is_upper = and i1 %upper_low, %upper_high");
    try append_line(out, "  %lower_low = icmp uge i8 %byte, 97");
    try append_line(out, "  %lower_high = icmp ule i8 %byte, 122");
    try append_line(out, "  %is_lower = and i1 %lower_low, %lower_high");
    try append_line(out, "  %digit_low = icmp uge i8 %byte, 48");
    try append_line(out, "  %digit_high = icmp ule i8 %byte, 57");
    try append_line(out, "  %is_digit = and i1 %digit_low, %digit_high");
    try append_line(out, "  %is_underscore = icmp eq i8 %byte, 95");
    try append_line(out, "  %alpha = or i1 %is_upper, %is_lower");
    try append_line(out, "  %word = or i1 %alpha, %is_digit");
    try append_line(out, "  %result = or i1 %word, %is_underscore");
    try append_line(out, "  ret i1 %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_next_non_ws_index_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__parse_next_non_ws_index(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ %start, %entry ], [ %next, %advance ]");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load, label %done");
    try append_line(out, "load:");
    try append_line(out, "  %ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %ptr");
    try append_line(out, "  %is_space = icmp eq i8 %byte, 32");
    try append_line(out, "  %is_lf = icmp eq i8 %byte, 10");
    try append_line(out, "  %is_cr = icmp eq i8 %byte, 13");
    try append_line(out, "  %is_tab = icmp eq i8 %byte, 9");
    try append_line(out, "  %space_or_lf = or i1 %is_space, %is_lf");
    try append_line(out, "  %cr_or_tab = or i1 %is_cr, %is_tab");
    try append_line(out, "  %is_ws = or i1 %space_or_lf, %cr_or_tab");
    try append_line(out, "  br i1 %is_ws, label %advance, label %done");
    try append_line(out, "advance:");
    try append_line(out, "  %next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "done:");
    try append_line(out, "  ret i64 %index");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_token_end_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__parse_token_end(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  %start_ok = icmp slt i64 %start, %source_len");
    try append_line(out, "  br i1 %start_ok, label %load_first, label %done_start");
    try append_line(out, "load_first:");
    try append_line(out, "  %first_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %first = load i8, ptr %first_ptr");
    try append_line(out, "  %is_quote = icmp eq i8 %first, 34");
    try append_line(out, "  br i1 %is_quote, label %string_loop, label %check_word");
    try append_line(out, "check_word:");
    try append_line(out,
        "  %first_word = call i1 @kizu_selfhost__parse_is_word_byte(i8 %first)");
    try append_line(out, "  br i1 %first_word, label %word_loop, label %check_pair");
    try append_line(out, "check_pair:");
    try append_line(out, "  %after_first = add i64 %start, 1");
    try append_line(out, "  %pair_in_bounds = icmp slt i64 %after_first, %source_len");
    try append_line(out, "  br i1 %pair_in_bounds, label %load_second, label %single");
    try append_line(out, "load_second:");
    try append_line(out, "  %second_ptr = getelementptr i8, ptr %source_ptr, i64 %after_first");
    try append_line(out, "  %second = load i8, ptr %second_ptr");
    try append_line(out, "  %first_colon = icmp eq i8 %first, 58");
    try append_line(out, "  %second_colon = icmp eq i8 %second, 58");
    try append_line(out, "  %is_double_colon = and i1 %first_colon, %second_colon");
    try append_line(out, "  %first_dash = icmp eq i8 %first, 45");
    try append_line(out, "  %second_gt = icmp eq i8 %second, 62");
    try append_line(out, "  %is_arrow = and i1 %first_dash, %second_gt");
    try append_line(out, "  %is_pair = or i1 %is_double_colon, %is_arrow");
    try append_line(out, "  br i1 %is_pair, label %pair, label %single");
    try append_line(out, "word_loop:");
    try append_line(out, "  %word_index = phi i64 [ %start, %check_word ], [ %word_next, %word_advance ]");
    try append_line(out, "  %word_in_bounds = icmp slt i64 %word_index, %source_len");
    try append_line(out, "  br i1 %word_in_bounds, label %word_load, label %word_done");
    try append_line(out, "word_load:");
    try append_line(out, "  %word_ptr = getelementptr i8, ptr %source_ptr, i64 %word_index");
    try append_line(out, "  %word_byte = load i8, ptr %word_ptr");
    try append_line(out,
        "  %is_word = call i1 @kizu_selfhost__parse_is_word_byte(i8 %word_byte)");
    try append_line(out, "  br i1 %is_word, label %word_advance, label %word_done");
    try append_line(out, "word_advance:");
    try append_line(out, "  %word_next = add i64 %word_index, 1");
    try append_line(out, "  br label %word_loop");
    try append_line(out, "word_done:");
    try append_line(out, "  ret i64 %word_index");
    try append_line(out, "string_loop:");
    try append_line(out, "  %string_index = phi i64 [ %start, %load_first ], [ %string_next, %string_advance ]");
    try append_line(out, "  %string_next = add i64 %string_index, 1");
    try append_line(out, "  %string_in_bounds = icmp slt i64 %string_next, %source_len");
    try append_line(out, "  br i1 %string_in_bounds, label %string_load, label %string_done");
    try append_line(out, "string_load:");
    try append_line(out, "  %string_ptr = getelementptr i8, ptr %source_ptr, i64 %string_next");
    try append_line(out, "  %string_byte = load i8, ptr %string_ptr");
    try append_line(out, "  %string_quote = icmp eq i8 %string_byte, 34");
    try append_line(out, "  br i1 %string_quote, label %string_close, label %string_advance");
    try append_line(out, "string_advance:");
    try append_line(out, "  br label %string_loop");
    try append_line(out, "string_close:");
    try append_line(out, "  %string_end = add i64 %string_next, 1");
    try append_line(out, "  ret i64 %string_end");
    try append_line(out, "string_done:");
    try append_line(out, "  ret i64 %source_len");
    try append_line(out, "pair:");
    try append_line(out, "  %pair_end = add i64 %start, 2");
    try append_line(out, "  ret i64 %pair_end");
    try append_line(out, "single:");
    try append_line(out, "  %single_end = add i64 %start, 1");
    try append_line(out, "  ret i64 %single_end");
    try append_line(out, "done_start:");
    try append_line(out, "  ret i64 %start");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_token_kind_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__parse_token_kind(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %first_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %first = load i8, ptr %first_ptr");
    try append_line(out, "  %len_two = icmp eq i64 %len, 2");
    try append_line(out, "  br i1 %len_two, label %maybe_double_colon, label %single");
    try append_line(out, "maybe_double_colon:");
    try append_line(out, "  %is_colon_first = icmp eq i8 %first, 58");
    try append_line(out, "  br i1 %is_colon_first, label %load_second, label %single");
    try append_line(out, "load_second:");
    try append_line(out, "  %second_index = add i64 %start, 1");
    try append_line(out, "  %second_ptr = getelementptr i8, ptr %source_ptr, i64 %second_index");
    try append_line(out, "  %second = load i8, ptr %second_ptr");
    try append_line(out, "  %is_colon_second = icmp eq i8 %second, 58");
    try append_line(out, "  br i1 %is_colon_second, label %kind_double_colon, label %single");
    try append_line(out, "single:");
    try append_line(out, "  switch i8 %first, label %kind_normal [");
    try append_line(out, "    i8 40, label %kind_lparen");
    try append_line(out, "    i8 41, label %kind_rparen");
    try append_line(out, "    i8 91, label %kind_lbracket");
    try append_line(out, "    i8 93, label %kind_rbracket");
    try append_line(out, "    i8 59, label %kind_semicolon");
    try append_line(out, "    i8 44, label %kind_comma");
    try append_line(out, "    i8 46, label %kind_dot");
    try append_line(out, "    i8 62, label %kind_gt");
    try append_line(out, "    i8 58, label %kind_colon");
    try append_line(out, "    i8 33, label %kind_bang");
    try append_line(out, "    i8 38, label %kind_amp");
    try append_line(out, "    i8 60, label %kind_lt");
    try append_line(out, "    i8 123, label %kind_lbrace");
    try append_line(out, "    i8 125, label %kind_rbrace");
    try append_line(out, "  ]");
    try append_line(out, "kind_normal:");
    try append_line(out, "  ret i64 1");
    try append_line(out, "kind_lparen:");
    try append_line(out, "  ret i64 2");
    try append_line(out, "kind_rparen:");
    try append_line(out, "  ret i64 3");
    try append_line(out, "kind_lbracket:");
    try append_line(out, "  ret i64 4");
    try append_line(out, "kind_rbracket:");
    try append_line(out, "  ret i64 5");
    try append_line(out, "kind_semicolon:");
    try append_line(out, "  ret i64 6");
    try append_line(out, "kind_comma:");
    try append_line(out, "  ret i64 7");
    try append_line(out, "kind_dot:");
    try append_line(out, "  ret i64 8");
    try append_line(out, "kind_double_colon:");
    try append_line(out, "  ret i64 9");
    try append_line(out, "kind_gt:");
    try append_line(out, "  ret i64 10");
    try append_line(out, "kind_colon:");
    try append_line(out, "  ret i64 11");
    try append_line(out, "kind_bang:");
    try append_line(out, "  ret i64 12");
    try append_line(out, "kind_amp:");
    try append_line(out, "  ret i64 13");
    try append_line(out, "kind_lt:");
    try append_line(out, "  ret i64 14");
    try append_line(out, "kind_lbrace:");
    try append_line(out, "  ret i64 15");
    try append_line(out, "kind_rbrace:");
    try append_line(out, "  ret i64 16");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_should_space_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_should_space(");
    try append_line(out, "  i64 %previous,");
    try append_line(out, "  i64 %current,");
    try append_line(out, "  i8 %last");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %last_zero = icmp eq i8 %last, 0");
    try append_line(out, "  %last_newline = icmp eq i8 %last, 10");
    try append_line(out, "  %last_space = icmp eq i8 %last, 32");
    try append_line(out, "  %last_empty_or_newline = or i1 %last_zero, %last_newline");
    try append_line(out, "  %last_blocks = or i1 %last_empty_or_newline, %last_space");
    try append_line(out, "  br i1 %last_blocks, label %false, label %check_current");
    try append_line(out, "check_current:");
    try append_line(out, "  switch i64 %current, label %check_slice_marker [");
    try append_line(out, "    i64 2, label %false");
    try append_line(out, "    i64 3, label %false");
    try append_line(out, "    i64 5, label %false");
    try append_line(out, "    i64 6, label %false");
    try append_line(out, "    i64 7, label %false");
    try append_line(out, "    i64 8, label %false");
    try append_line(out, "    i64 9, label %false");
    try append_line(out, "    i64 10, label %false");
    try append_line(out, "    i64 11, label %false");
    try append_line(out, "  ]");
    try append_line(out, "check_slice_marker:");
    try append_line(out, "  %previous_rbracket = icmp eq i64 %previous, 5");
    try append_line(out, "  br i1 %previous_rbracket, label %check_slice_follow, label %check_previous");
    try append_line(out, "check_slice_follow:");
    try append_line(out, "  %follow_word = icmp eq i64 %current, 1");
    try append_line(out, "  %follow_amp = icmp eq i64 %current, 13");
    try append_line(out, "  %follow_bang = icmp eq i64 %current, 12");
    try append_line(out, "  %follow_lbracket = icmp eq i64 %current, 4");
    try append_line(out, "  %follow_word_or_amp = or i1 %follow_word, %follow_amp");
    try append_line(out, "  %follow_bang_or_bracket = or i1 %follow_bang, %follow_lbracket");
    try append_line(out, "  %slice_follow = or i1 %follow_word_or_amp, %follow_bang_or_bracket");
    try append_line(out, "  br i1 %slice_follow, label %false, label %check_previous");
    try append_line(out, "check_previous:");
    try append_line(out, "  switch i64 %previous, label %true [");
    try append_line(out, "    i64 2, label %false");
    try append_line(out, "    i64 4, label %false");
    try append_line(out, "    i64 8, label %false");
    try append_line(out, "    i64 9, label %false");
    try append_line(out, "    i64 12, label %false");
    try append_line(out, "    i64 13, label %false");
    try append_line(out, "    i64 14, label %false");
    try append_line(out, "  ]");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_is_decl_start_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_is_decl_start(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %len = sub i64 %end, %start");
    try append_line(out, "  %first_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %first = load i8, ptr %first_ptr");
    try append_line(out, "  switch i64 %len, label %false [");
    try append_line(out, "    i64 2, label %len_two");
    try append_line(out, "    i64 3, label %len_three");
    try append_line(out, "    i64 4, label %len_four");
    try append_line(out, "    i64 5, label %len_five");
    try append_line(out, "    i64 6, label %len_six");
    try append_line(out, "  ]");
    try append_line(out, "len_two:");
    try append_line(out, "  %fn_f = icmp eq i8 %first, 102");
    try append_line(out, "  br i1 %fn_f, label %len_two_second, label %false");
    try append_line(out, "len_two_second:");
    try append_line(out, "  %i1 = add i64 %start, 1");
    try append_line(out, "  %b1_ptr = getelementptr i8, ptr %source_ptr, i64 %i1");
    try append_line(out, "  %b1 = load i8, ptr %b1_ptr");
    try append_line(out, "  %fn_n = icmp eq i8 %b1, 110");
    try append_line(out, "  br i1 %fn_n, label %true, label %false");
    try append_line(out, "len_three:");
    try append_line(out, "  %pub_p = icmp eq i8 %first, 112");
    try append_line(out, "  br i1 %pub_p, label %check_pub_tail, label %false");
    try append_line(out, "check_pub_tail:");
    try append_line(out, "  %pub_i1 = add i64 %start, 1");
    try append_line(out, "  %pub_i2 = add i64 %start, 2");
    try append_line(out, "  %pub_b1_ptr = getelementptr i8, ptr %source_ptr, i64 %pub_i1");
    try append_line(out, "  %pub_b2_ptr = getelementptr i8, ptr %source_ptr, i64 %pub_i2");
    try append_line(out, "  %pub_b1 = load i8, ptr %pub_b1_ptr");
    try append_line(out, "  %pub_b2 = load i8, ptr %pub_b2_ptr");
    try append_line(out, "  %pub_u = icmp eq i8 %pub_b1, 117");
    try append_line(out, "  %pub_b = icmp eq i8 %pub_b2, 98");
    try append_line(out, "  %is_pub = and i1 %pub_u, %pub_b");
    try append_line(out, "  br i1 %is_pub, label %true, label %false");
    try append_line(out, "len_four:");
    try append_line(out, "  %enum_e = icmp eq i8 %first, 101");
    try append_line(out, "  br i1 %enum_e, label %check_enum, label %false");
    try append_line(out, "len_five:");
    try append_line(out, "  %union_u = icmp eq i8 %first, 117");
    try append_line(out, "  br i1 %union_u, label %check_union, label %false");
    try append_line(out, "check_enum:");
    try append_line(out, "  %enum_ok = call i1 @kizu_selfhost__parse_word_eq(%kizu.slice.u8 %source, i64 %start, i64 4, i8 101, i8 110, i8 117, i8 109, i8 0, i8 0)");
    try append_line(out, "  br i1 %enum_ok, label %true, label %false");
    try append_line(out, "check_union:");
    try append_line(out, "  %union_ok = call i1 @kizu_selfhost__parse_word_eq(%kizu.slice.u8 %source, i64 %start, i64 5, i8 117, i8 110, i8 105, i8 111, i8 110, i8 0)");
    try append_line(out, "  br i1 %union_ok, label %true, label %false");
    try append_line(out, "len_six:");
    try append_line(out, "  %struct_s = icmp eq i8 %first, 115");
    try append_line(out, "  %import_i = icmp eq i8 %first, 105");
    try append_line(out, "  %unsafe_u = icmp eq i8 %first, 117");
    try append_line(out, "  %extern_e = icmp eq i8 %first, 101");
    try append_line(out, "  br i1 %struct_s, label %check_struct, label %maybe_import");
    try append_line(out, "maybe_import:");
    try append_line(out, "  br i1 %import_i, label %check_import, label %maybe_unsafe");
    try append_line(out, "maybe_unsafe:");
    try append_line(out, "  br i1 %unsafe_u, label %check_unsafe, label %maybe_extern");
    try append_line(out, "maybe_extern:");
    try append_line(out, "  br i1 %extern_e, label %check_extern, label %false");
    try append_line(out, "check_struct:");
    try append_line(out, "  %struct_ok = call i1 @kizu_selfhost__parse_word_eq(%kizu.slice.u8 %source, i64 %start, i64 6, i8 115, i8 116, i8 114, i8 117, i8 99, i8 116)");
    try append_line(out, "  br i1 %struct_ok, label %true, label %false");
    try append_line(out, "check_import:");
    try append_line(out, "  %import_ok = call i1 @kizu_selfhost__parse_word_eq(%kizu.slice.u8 %source, i64 %start, i64 6, i8 105, i8 109, i8 112, i8 111, i8 114, i8 116)");
    try append_line(out, "  br i1 %import_ok, label %true, label %false");
    try append_line(out, "check_unsafe:");
    try append_line(out, "  %unsafe_ok = call i1 @kizu_selfhost__parse_word_eq(%kizu.slice.u8 %source, i64 %start, i64 6, i8 117, i8 110, i8 115, i8 97, i8 102, i8 101)");
    try append_line(out, "  br i1 %unsafe_ok, label %true, label %false");
    try append_line(out, "check_extern:");
    try append_line(out, "  %extern_ok = call i1 @kizu_selfhost__parse_word_eq(%kizu.slice.u8 %source, i64 %start, i64 6, i8 101, i8 120, i8 116, i8 101, i8 114, i8 110)");
    try append_line(out, "  br i1 %extern_ok, label %true, label %false");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    try append_parse_word_eq_function(out);
    return;
}

fn append_parse_word_eq_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_word_eq(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %len,");
    try append_line(out, "  i8 %b0,");
    try append_line(out, "  i8 %b1,");
    try append_line(out, "  i8 %b2,");
    try append_line(out, "  i8 %b3,");
    try append_line(out, "  i8 %b4,");
    try append_line(out, "  i8 %b5");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %p0 = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %i1 = add i64 %start, 1");
    try append_line(out, "  %i2 = add i64 %start, 2");
    try append_line(out, "  %i3 = add i64 %start, 3");
    try append_line(out, "  %i4 = add i64 %start, 4");
    try append_line(out, "  %i5 = add i64 %start, 5");
    try append_line(out, "  %p1 = getelementptr i8, ptr %source_ptr, i64 %i1");
    try append_line(out, "  %p2 = getelementptr i8, ptr %source_ptr, i64 %i2");
    try append_line(out, "  %p3 = getelementptr i8, ptr %source_ptr, i64 %i3");
    try append_line(out, "  %v0 = load i8, ptr %p0");
    try append_line(out, "  %v1 = load i8, ptr %p1");
    try append_line(out, "  %v2 = load i8, ptr %p2");
    try append_line(out, "  %v3 = load i8, ptr %p3");
    try append_line(out, "  %e0 = icmp eq i8 %v0, %b0");
    try append_line(out, "  %e1 = icmp eq i8 %v1, %b1");
    try append_line(out, "  %e2 = icmp eq i8 %v2, %b2");
    try append_line(out, "  %e3 = icmp eq i8 %v3, %b3");
    try append_line(out, "  %e01 = and i1 %e0, %e1");
    try append_line(out, "  %e23 = and i1 %e2, %e3");
    try append_line(out, "  %e0123 = and i1 %e01, %e23");
    try append_line(out, "  %len_four = icmp eq i64 %len, 4");
    try append_line(out, "  br i1 %len_four, label %done_four, label %load_five");
    try append_line(out, "load_five:");
    try append_line(out, "  %p4 = getelementptr i8, ptr %source_ptr, i64 %i4");
    try append_line(out, "  %v4 = load i8, ptr %p4");
    try append_line(out, "  %e4 = icmp eq i8 %v4, %b4");
    try append_line(out, "  %e01234 = and i1 %e0123, %e4");
    try append_line(out, "  %len_five = icmp eq i64 %len, 5");
    try append_line(out, "  br i1 %len_five, label %done_five, label %load_six");
    try append_line(out, "load_six:");
    try append_line(out, "  %p5 = getelementptr i8, ptr %source_ptr, i64 %i5");
    try append_line(out, "  %v5 = load i8, ptr %p5");
    try append_line(out, "  %e5 = icmp eq i8 %v5, %b5");
    try append_line(out, "  %result_six = and i1 %e01234, %e5");
    try append_line(out, "  ret i1 %result_six");
    try append_line(out, "done_four:");
    try append_line(out, "  ret i1 %e0123");
    try append_line(out, "done_five:");
    try append_line(out, "  ret i1 %e01234");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_is_trailing_comma_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_is_trailing_comma(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  %first_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %first = load i8, ptr %first_ptr");
    try append_line(out, "  %is_comma = icmp eq i8 %first, 44");
    try append_line(out, "  br i1 %is_comma, label %lookahead, label %false");
    try append_line(out, "lookahead:");
    try append_line(out,
        "  %next = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %end)");
    try append_line(out, "  %next_ok = icmp slt i64 %next, %source_len");
    try append_line(out, "  br i1 %next_ok, label %load_next, label %false");
    try append_line(out, "load_next:");
    try append_line(out, "  %next_ptr = getelementptr i8, ptr %source_ptr, i64 %next");
    try append_line(out, "  %next_byte = load i8, ptr %next_ptr");
    try append_line(out, "  %is_rbrace = icmp eq i8 %next_byte, 125");
    try append_line(out, "  br i1 %is_rbrace, label %true, label %false");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_buffer_append_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__parse_buffer_append(");
    try append_line(out, "  ptr %buffer,");
    try append_line(out, "  i64 %capacity,");
    try append_line(out, "  i64 %position,");
    try append_line(out, "  %kizu.slice.u8 %chunk");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %chunk_ptr = extractvalue %kizu.slice.u8 %chunk, 0");
    try append_line(out, "  %chunk_len = extractvalue %kizu.slice.u8 %chunk, 1");
    try append_line(out, "  %end = add i64 %position, %chunk_len");
    try append_line(out, "  %no_overflow = icmp uge i64 %end, %position");
    try append_line(out, "  %within_capacity = icmp ule i64 %end, %capacity");
    try append_line(out, "  %fits = and i1 %no_overflow, %within_capacity");
    try append_line(out, "  br i1 %fits, label %copy, label %overflow");
    try append_line(out, "copy:");
    try append_line(out, "  %dest = getelementptr i8, ptr %buffer, i64 %position");
    try append_line(out,
        "  call void @llvm.memcpy.p0.p0.i64(ptr %dest, ptr %chunk_ptr, i64 %chunk_len, i1 false)");
    try append_line(out, "  ret i64 %end");
    try append_line(out, "overflow:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_format_alloc_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.slice.u8 @kizu_selfhost__parse_format_alloc(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i1 %preserve_comments");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  %scaled_len = mul i64 %source_len, 4");
    try append_line(out, "  %capacity = add i64 %scaled_len, 64");
    try append_line(out, "  %capacity_ok = icmp uge i64 %capacity, %source_len");
    try append_line(out, "  br i1 %capacity_ok, label %allocate, label %alloc_failed");
    try append_line(out, "allocate:");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %capacity)");
    try append_line(out, "  %allocated = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %allocated, label %start, label %alloc_failed");
    try append_line(out, "start:");
    try append_line(out,
        "  %prefix_end = call i64 @kizu_selfhost__parse_leading_comment_prefix_end(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_prefix = icmp sgt i64 %prefix_end, 0");
    try append_line(out, "  br i1 %has_prefix, label %write_prefix, label %loop_entry");
    try append_line(out, "write_prefix:");
    try append_line(out, "  %prefix_base = insertvalue %kizu.slice.u8 poison, ptr %source_ptr, 0");
    try append_line(out,
        "  %prefix_slice = insertvalue %kizu.slice.u8 %prefix_base, i64 %prefix_end, 1");
    try append_line(out,
        "  %prefix_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 0, %kizu.slice.u8 %prefix_slice)");
    try append_line(out, "  %prefix_ok = icmp sge i64 %prefix_append, 0");
    try append_line(out, "  br i1 %prefix_ok, label %loop_entry, label %false");
    try append_line(out, "loop_entry:");
    try append_line(out, "  %initial_position = phi i64 [ 0, %start ], [ %prefix_append, %write_prefix ]");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ %prefix_end, %loop_entry ], [ %ws_next, %skip_ws ], [ %skip_comment_index, %skip_comment ], [ %skip_index, %skip_token ], [ %next_index, %after_token ]");
    try append_line(out, "  %depth = phi i64 [ 0, %loop_entry ], [ %depth, %skip_ws ], [ %depth, %skip_comment ], [ %depth, %skip_token ], [ %depth_next, %after_token ]");
    try append_line(out, "  %previous = phi i64 [ 0, %loop_entry ], [ %previous, %skip_ws ], [ %previous, %skip_comment ], [ %previous, %skip_token ], [ %token_kind, %after_token ]");
    try append_line(out, "  %last = phi i8 [ 0, %loop_entry ], [ %last, %skip_ws ], [ %skip_comment_last, %skip_comment ], [ %last, %skip_token ], [ %token_last_byte, %after_token ]");
    try append_line(out, "  %written = phi i64 [ 0, %loop_entry ], [ %written, %skip_ws ], [ %skip_comment_written, %skip_comment ], [ %written, %skip_token ], [ %written_next, %after_token ]");
    try append_line(out, "  %position = phi i64 [ %initial_position, %loop_entry ], [ %position, %skip_ws ], [ %skip_comment_position, %skip_comment ], [ %position, %skip_token ], [ %token_append, %after_token ]");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load, label %finish");
    try append_line(out, "load:");
    try append_line(out, "  %byte_ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %byte_ptr");
    try append_line(out, "  %is_space = icmp eq i8 %byte, 32");
    try append_line(out, "  %is_lf = icmp eq i8 %byte, 10");
    try append_line(out, "  %is_cr = icmp eq i8 %byte, 13");
    try append_line(out, "  %is_tab = icmp eq i8 %byte, 9");
    try append_line(out, "  %space_or_lf = or i1 %is_space, %is_lf");
    try append_line(out, "  %cr_or_tab = or i1 %is_cr, %is_tab");
    try append_line(out, "  %is_ws = or i1 %space_or_lf, %cr_or_tab");
    try append_line(out, "  br i1 %is_ws, label %skip_ws, label %maybe_comment");
    try append_line(out, "skip_ws:");
    try append_line(out, "  %ws_next = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "maybe_comment:");
    try append_line(out,
        "  %comment_next = call i64 @kizu_selfhost__parse_skip_comment_or_self(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out, "  %comment_skipped = icmp ne i64 %comment_next, %index");
    try append_line(out,
        "  br i1 %comment_skipped, label %maybe_preserve_comment, label %token");
    try append_line(out, "maybe_preserve_comment:");
    try append_line(out,
        "  br i1 %preserve_comments, label %write_comment_prefix_check, label %skip_comment");
    try append_line(out, "write_comment_prefix_check:");
    try append_line(out, "  %comment_has_written = icmp sgt i64 %written, 0");
    try append_line(out, "  %comment_last_not_newline = icmp ne i8 %last, 10");
    try append_line(out,
        "  %comment_needs_prefix_newline = and i1 %comment_has_written, %comment_last_not_newline");
    try append_line(out,
        "  br i1 %comment_needs_prefix_newline, label %write_comment_prefix_newline, label %write_comment_text");
    try append_line(out, "write_comment_prefix_newline:");
    try append_global_slice(out, "comment_prefix", "newline", "parse_newline", "1");
    try append_line(out,
        "  %comment_prefix_newline_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 %position, %kizu.slice.u8 %comment_prefix_newline_slice)");
    try append_line(out,
        "  %comment_prefix_newline_ok = icmp sge i64 %comment_prefix_newline_append, 0");
    try append_line(out,
        "  br i1 %comment_prefix_newline_ok, label %write_comment_text, label %false");
    try append_line(out, "write_comment_text:");
    try append_line(out,
        "  %comment_text_position = phi i64 [ %position, %write_comment_prefix_check ], [ %comment_prefix_newline_append, %write_comment_prefix_newline ]");
    try append_line(out, "  %comment_ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %comment_len = sub i64 %comment_next, %index");
    try append_line(out, "  %comment_base = insertvalue %kizu.slice.u8 poison, ptr %comment_ptr, 0");
    try append_line(out,
        "  %comment_slice = insertvalue %kizu.slice.u8 %comment_base, i64 %comment_len, 1");
    try append_line(out,
        "  %comment_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 %comment_text_position, %kizu.slice.u8 %comment_slice)");
    try append_line(out, "  %comment_ok = icmp sge i64 %comment_append, 0");
    try append_line(out, "  br i1 %comment_ok, label %write_comment_newline, label %false");
    try append_line(out, "write_comment_newline:");
    try append_global_slice(out, "comment", "newline", "parse_newline", "1");
    try append_line(out,
        "  %comment_newline_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 %comment_append, %kizu.slice.u8 %comment_newline_slice)");
    try append_line(out,
        "  %comment_newline_ok = icmp sge i64 %comment_newline_append, 0");
    try append_line(out, "  %comment_written_next = add i64 %written, 1");
    try append_line(out, "  br i1 %comment_newline_ok, label %skip_comment, label %false");
    try append_line(out, "skip_comment:");
    try append_line(out, "  %skip_comment_index = add i64 %comment_next, 0");
    try append_line(out,
        "  %skip_comment_last = phi i8 [ %last, %maybe_preserve_comment ], [ 10, %write_comment_newline ]");
    try append_line(out,
        "  %skip_comment_written = phi i64 [ %written, %maybe_preserve_comment ], [ %comment_written_next, %write_comment_newline ]");
    try append_line(out,
        "  %skip_comment_position = phi i64 [ %position, %maybe_preserve_comment ], [ %comment_newline_append, %write_comment_newline ]");
    try append_line(out, "  br label %loop");
    try append_line(out, "token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out,
        "  %token_kind = call i64 @kizu_selfhost__parse_token_kind(%kizu.slice.u8 %source, i64 %index, i64 %token_end)");
    try append_line(out,
        "  %trailing_comma = call i1 @kizu_selfhost__parse_is_trailing_comma(%kizu.slice.u8 %source, i64 %index, i64 %token_end)");
    try append_line(out, "  br i1 %trailing_comma, label %skip_token, label %maybe_decl_newline");
    try append_line(out, "skip_token:");
    try append_line(out, "  %skip_index = add i64 %token_end, 0");
    try append_line(out, "  br label %loop");
    try append_line(out, "maybe_decl_newline:");
    try append_line(out,
        "  %is_decl = call i1 @kizu_selfhost__parse_is_decl_start(%kizu.slice.u8 %source, i64 %index, i64 %token_end)");
    try append_line(out, "  %depth_zero = icmp eq i64 %depth, 0");
    try append_line(out, "  %has_written = icmp sgt i64 %written, 0");
    try append_line(out, "  %last_not_newline = icmp ne i8 %last, 10");
    try append_line(out, "  %decl_at_top = and i1 %is_decl, %depth_zero");
    try append_line(out, "  %decl_after_output = and i1 %decl_at_top, %has_written");
    try append_line(out, "  %write_decl_newline = and i1 %decl_after_output, %last_not_newline");
    try append_line(out, "  br i1 %write_decl_newline, label %write_decl_newline_block, label %after_decl_newline");
    try append_line(out, "write_decl_newline_block:");
    try append_global_slice(out, "parse_decl", "newline", "parse_newline", "1");
    try append_line(out,
        "  %decl_newline_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 %position, %kizu.slice.u8 %parse_decl_newline_slice)");
    try append_line(out, "  %decl_newline_ok = icmp sge i64 %decl_newline_append, 0");
    try append_line(out, "  br i1 %decl_newline_ok, label %after_decl_newline, label %false");
    try append_line(out, "after_decl_newline:");
    try append_line(out, "  %last_after_decl = phi i8 [ 10, %write_decl_newline_block ], [ %last, %maybe_decl_newline ]");
    try append_line(out,
        "  %position_after_decl = phi i64 [ %decl_newline_append, %write_decl_newline_block ], [ %position, %maybe_decl_newline ]");
    try append_line(out, "  %is_close_brace = icmp eq i64 %token_kind, 16");
    try append_line(out, "  %close_delta = select i1 %is_close_brace, i64 1, i64 0");
    try append_line(out, "  %depth_after_close = sub i64 %depth, %close_delta");
    try append_line(out,
        "  %needs_space = call i1 @kizu_selfhost__parse_should_space(i64 %previous, i64 %token_kind, i8 %last_after_decl)");
    try append_line(out, "  br i1 %needs_space, label %write_space, label %write_token");
    try append_line(out, "write_space:");
    try append_global_slice(out, "parse", "space", "parse_space", "1");
    try append_line(out,
        "  %space_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 %position_after_decl, %kizu.slice.u8 %parse_space_slice)");
    try append_line(out, "  %space_ok = icmp sge i64 %space_append, 0");
    try append_line(out, "  br i1 %space_ok, label %write_token, label %false");
    try append_line(out, "write_token:");
    try append_line(out,
        "  %token_position = phi i64 [ %position_after_decl, %after_decl_newline ], [ %space_append, %write_space ]");
    try append_line(out, "  %token_ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %token_len = sub i64 %token_end, %index");
    try append_line(out, "  %token_base = insertvalue %kizu.slice.u8 poison, ptr %token_ptr, 0");
    try append_line(out, "  %token_slice = insertvalue %kizu.slice.u8 %token_base, i64 %token_len, 1");
    try append_line(out,
        "  %token_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 %token_position, %kizu.slice.u8 %token_slice)");
    try append_line(out, "  %token_ok = icmp sge i64 %token_append, 0");
    try append_line(out, "  br i1 %token_ok, label %after_token, label %false");
    try append_line(out, "after_token:");
    try append_line(out, "  %last_byte_index = sub i64 %token_end, 1");
    try append_line(out, "  %last_byte_ptr = getelementptr i8, ptr %source_ptr, i64 %last_byte_index");
    try append_line(out, "  %token_last_byte = load i8, ptr %last_byte_ptr");
    try append_line(out, "  %is_open_brace = icmp eq i64 %token_kind, 15");
    try append_line(out, "  %open_delta = select i1 %is_open_brace, i64 1, i64 0");
    try append_line(out, "  %depth_next = add i64 %depth_after_close, %open_delta");
    try append_line(out, "  %written_next = add i64 %written, 1");
    try append_line(out, "  %next_index = add i64 %token_end, 0");
    try append_line(out, "  br label %loop");
    try append_line(out, "finish:");
    try append_global_slice(out, "parse_final", "newline", "parse_newline", "1");
    try append_line(out,
        "  %final_newline_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 %position, %kizu.slice.u8 %parse_final_newline_slice)");
    try append_line(out, "  %final_newline_ok = icmp sge i64 %final_newline_append, 0");
    try append_line(out, "  br i1 %final_newline_ok, label %true, label %false");
    try append_line(out, "true:");
    try append_line(out, "  %body_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out,
        "  %body = insertvalue %kizu.slice.u8 %body_base, i64 %final_newline_append, 1");
    try append_line(out, "  %result_ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %result = insertvalue %kizu.error.slice.u8 %result_ok, %kizu.slice.u8 %body, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "false:");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %buffer)");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "alloc_failed:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_format_write_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__parse_format_write(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i1 %preserve_comments");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %formatted = call %kizu.error.slice.u8 @kizu_selfhost__parse_format_alloc(%kizu.slice.u8 %source, i1 %preserve_comments)");
    try append_line(out, "  %formatted_ok = extractvalue %kizu.error.slice.u8 %formatted, 0");
    try append_line(out, "  br i1 %formatted_ok, label %write, label %false");
    try append_line(out, "write:");
    try append_line(out, "  %formatted_bytes = extractvalue %kizu.error.slice.u8 %formatted, 1");
    try append_line(out,
        "  %format_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %formatted_bytes)");
    try append_line(out, "  %format_write_ok = extractvalue %kizu.error.void %format_write, 0");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %formatted_ptr = extractvalue %kizu.slice.u8 %formatted_bytes, 0");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %formatted_ptr)");
    try append_line(out, "  br i1 %format_write_ok, label %true, label %false");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_format_source_write_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__format_source_write(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i1 %preserve_comments");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out,
        "  %formatted = call %kizu.error.owned @kizu_selfhost__parser_format_format_source(%kizu.owned %allocator, %kizu.slice.u8 %source)");
    try append_line(out, "  %formatted_ok = extractvalue %kizu.error.owned %formatted, 0");
    try append_line(out, "  br i1 %formatted_ok, label %write, label %false");
    try append_line(out, "write:");
    try append_line(out, "  %formatted_owned = extractvalue %kizu.error.owned %formatted, 1");
    try append_line(out,
        "  %formatted_bytes = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %formatted_owned)");
    try append_line(out,
        "  %format_write = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %formatted_bytes)");
    try append_line(out, "  %format_write_ok = extractvalue %kizu.error.void %format_write, 0");
    try append_line(out, "  br i1 %format_write_ok, label %write_newline, label %cleanup_false");
    try append_line(out, "write_newline:");
    try append_global_slice(out, "format_write", "newline", "parse_newline", "1");
    try append_line(out,
        "  %format_newline = call %kizu.error.void @kizu_rt_io_write_stdout(%kizu.owned %io, %kizu.slice.u8 %format_write_newline_slice)");
    try append_line(out, "  %format_newline_ok = extractvalue %kizu.error.void %format_newline, 0");
    try append_line(out, "  br label %cleanup");
    try append_line(out, "cleanup_false:");
    try append_line(out, "  br label %cleanup");
    try append_line(out, "cleanup:");
    try append_line(out,
        "  %format_result = phi i1 [ %format_newline_ok, %write_newline ], [ false, %cleanup_false ]");
    try append_line(out, "  call void @kizu_rt_owned_deinit(%kizu.owned %formatted_owned)");
    try append_line(out, "  br i1 %format_result, label %true, label %false");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_temp_path_function(out: &var std::string::String) -> !void {
    try append_line(
        out,
        "define %kizu.error.slice.u8 @kizu_selfhost__parse_temp_path(%kizu.slice.u8 %path) {"
    );
    try append_line(out, "entry:");
    try append_line(out, "  %path_len = extractvalue %kizu.slice.u8 %path, 1");
    try append_line(out, "  %capacity = add i64 %path_len, 13");
    try append_line(out, "  %no_overflow = icmp uge i64 %capacity, %path_len");
    try append_line(out, "  br i1 %no_overflow, label %alloc, label %false");
    try append_line(out, "alloc:");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %allocator_ptr = extractvalue %kizu.owned %allocator, 0");
    try append_line(out, "  %buffer = call ptr @kizu_rt_alloc(ptr %allocator_ptr, i64 %capacity)");
    try append_line(out, "  %buffer_ok = icmp ne ptr %buffer, null");
    try append_line(out, "  br i1 %buffer_ok, label %copy_path, label %false");
    try append_line(out, "copy_path:");
    try append_line(out,
        "  %path_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 0, %kizu.slice.u8 %path)");
    try append_line(out, "  %path_ok = icmp sge i64 %path_append, 0");
    try append_line(out, "  br i1 %path_ok, label %copy_suffix, label %cleanup_false");
    try append_line(out, "copy_suffix:");
    try append_global_slice(out, "fmt_temp", "suffix", "fmt_temp_suffix", "13");
    try append_line(out,
        "  %suffix_append = call i64 @kizu_selfhost__parse_buffer_append(ptr %buffer, i64 %capacity, i64 %path_append, %kizu.slice.u8 %fmt_temp_suffix_slice)");
    try append_line(out, "  %suffix_ok = icmp eq i64 %suffix_append, %capacity");
    try append_line(out, "  br i1 %suffix_ok, label %true, label %cleanup_false");
    try append_line(out, "true:");
    try append_line(out, "  %temp_base = insertvalue %kizu.slice.u8 poison, ptr %buffer, 0");
    try append_line(out,
        "  %temp_path = insertvalue %kizu.slice.u8 %temp_base, i64 %capacity, 1");
    try append_line(out, "  %result_ok = insertvalue %kizu.error.slice.u8 zeroinitializer, i1 true, 0");
    try append_line(out,
        "  %result = insertvalue %kizu.error.slice.u8 %result_ok, %kizu.slice.u8 %temp_path, 1");
    try append_line(out, "  ret %kizu.error.slice.u8 %result");
    try append_line(out, "cleanup_false:");
    try append_line(out, "  call void @kizu_rt_free(ptr %allocator_ptr, ptr %buffer)");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "false:");
    try append_line(out, "  ret %kizu.error.slice.u8 zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_format_source_file_write_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__format_source_file_write(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %path,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i1 %preserve_comments");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out,
        "  %formatted = call %kizu.error.owned @kizu_selfhost__parser_format_format_source(%kizu.owned %allocator, %kizu.slice.u8 %source)");
    try append_line(out, "  %formatted_ok = extractvalue %kizu.error.owned %formatted, 0");
    try append_line(out, "  br i1 %formatted_ok, label %write, label %false");
    try append_line(out, "write:");
    try append_line(out, "  %formatted_owned = extractvalue %kizu.error.owned %formatted, 1");
    try append_line(out,
        "  %formatted_bytes = call %kizu.slice.u8 @kizu_rt_string_as_bytes(%kizu.owned %formatted_owned)");
    try append_line(out,
        "  %temp = call %kizu.error.slice.u8 @kizu_selfhost__parse_temp_path(%kizu.slice.u8 %path)");
    try append_line(out, "  %temp_ok = extractvalue %kizu.error.slice.u8 %temp, 0");
    try append_line(out, "  br i1 %temp_ok, label %write_temp, label %cleanup_formatted_false");
    try append_line(out, "write_temp:");
    try append_line(out, "  %temp_path = extractvalue %kizu.error.slice.u8 %temp, 1");
    try append_line(out,
        "  %format_write = call %kizu.error.void @kizu_rt_fs_write_file(%kizu.owned %io, %kizu.slice.u8 %temp_path, %kizu.slice.u8 %formatted_bytes)");
    try append_line(out, "  %format_write_ok = extractvalue %kizu.error.void %format_write, 0");
    try append_line(out, "  br i1 %format_write_ok, label %rename, label %cleanup_temp_false");
    try append_line(out, "rename:");
    try append_line(out,
        "  %format_rename = call %kizu.error.void @kizu_rt_fs_rename(%kizu.owned %io, %kizu.slice.u8 %temp_path, %kizu.slice.u8 %path)");
    try append_line(out, "  %format_rename_ok = extractvalue %kizu.error.void %format_rename, 0");
    try append_line(out, "  br label %cleanup_temp");
    try append_line(out, "cleanup_temp_false:");
    try append_line(out, "  br label %cleanup_temp");
    try append_line(out, "cleanup_temp:");
    try append_line(out,
        "  %temp_result = phi i1 [ %format_rename_ok, %rename ], [ false, %cleanup_temp_false ]");
    try append_line(out, "  %temp_allocator = call %kizu.owned @kizu_rt_mem_page_allocator()");
    try append_line(out, "  %temp_allocator_ptr = extractvalue %kizu.owned %temp_allocator, 0");
    try append_line(out, "  %temp_ptr = extractvalue %kizu.slice.u8 %temp_path, 0");
    try append_line(out, "  call void @kizu_rt_owned_deinit(%kizu.owned %formatted_owned)");
    try append_line(out, "  call void @kizu_rt_free(ptr %temp_allocator_ptr, ptr %temp_ptr)");
    try append_line(out, "  br i1 %temp_result, label %true, label %false");
    try append_line(out, "cleanup_formatted_false:");
    try append_line(out, "  call void @kizu_rt_owned_deinit(%kizu.owned %formatted_owned)");
    try append_line(out, "  br label %false");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    name: []u8,
    role: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(name);
    try out.append_bytes("_");
    try out.append_bytes(role);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
