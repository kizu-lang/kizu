pub fn append_globals(out: &var std::string::String) -> !void {
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_frontend_lower_checked_run_ast_function(out);
    try append_frontend_parse_let_binding_function(out);
    try append_frontend_parse_print_statement_function(out);
    return;
}

fn append_frontend_lower_checked_run_ast_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.run_ast @kizu_selfhost__cli_frontend_lower_checked_run_ast(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %void_body_start = call i64 @kizu_selfhost__cli_run_void_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_void_body = icmp sge i64 %void_body_start, 0");
    try append_line(out, "  br i1 %has_void_body, label %body_known, label %check_regular_main");
    try append_line(out, "check_regular_main:");
    try append_line(out,
        "  %regular_body_start = call i64 @kizu_selfhost__cli_run_main_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_regular_body = icmp sge i64 %regular_body_start, 0");
    try append_line(out, "  br i1 %has_regular_body, label %body_known, label %unsupported");
    try append_line(out, "body_known:");
    try append_line(out,
        "  %body_start = phi i64 [ %void_body_start, %entry ], [ %regular_body_start, %check_regular_main ]");
    try append_line(out,
        "  %first_binding = call %kizu.selfhost.codegen.binding @kizu_selfhost__cli_frontend_parse_let_binding(%kizu.slice.u8 %source, i64 %body_start)");
    try append_line(out, "  %first_binding_ok = extractvalue %kizu.selfhost.codegen.binding %first_binding, 0");
    try append_line(out, "  br i1 %first_binding_ok, label %after_first_binding, label %direct_print");
    try append_line(out, "direct_print:");
    try append_line(out, "  %empty_slice = insertvalue %kizu.slice.u8 zeroinitializer, i64 0, 1");
    try append_line(out,
        "  %direct_payload = call %kizu.selfhost.codegen.payload @kizu_selfhost__cli_frontend_parse_print_statement(%kizu.slice.u8 %source, i64 %body_start, i1 false, %kizu.slice.u8 %empty_slice, %kizu.slice.u8 %empty_slice, i1 false, %kizu.slice.u8 %empty_slice, %kizu.slice.u8 %empty_slice)");
    try append_line(out, "  br label %finish_payload");
    try append_line(out, "after_first_binding:");
    try append_line(out, "  %first_name = extractvalue %kizu.selfhost.codegen.binding %first_binding, 1");
    try append_line(out, "  %first_payload = extractvalue %kizu.selfhost.codegen.binding %first_binding, 2");
    try append_line(out, "  %first_next = extractvalue %kizu.selfhost.codegen.binding %first_binding, 3");
    try append_line(out,
        "  %second_binding = call %kizu.selfhost.codegen.binding @kizu_selfhost__cli_frontend_parse_let_binding(%kizu.slice.u8 %source, i64 %first_next)");
    try append_line(out, "  %second_binding_ok = extractvalue %kizu.selfhost.codegen.binding %second_binding, 0");
    try append_line(out, "  br i1 %second_binding_ok, label %after_second_binding, label %first_local_print");
    try append_line(out, "first_local_print:");
    try append_line(out,
        "  %first_local_payload = call %kizu.selfhost.codegen.payload @kizu_selfhost__cli_frontend_parse_print_statement(%kizu.slice.u8 %source, i64 %first_next, i1 true, %kizu.slice.u8 %first_name, %kizu.slice.u8 %first_payload, i1 false, %kizu.slice.u8 %first_name, %kizu.slice.u8 %first_payload)");
    try append_line(out, "  br label %finish_payload");
    try append_line(out, "after_second_binding:");
    try append_line(out, "  %second_name = extractvalue %kizu.selfhost.codegen.binding %second_binding, 1");
    try append_line(out, "  %second_payload = extractvalue %kizu.selfhost.codegen.binding %second_binding, 2");
    try append_line(out, "  %second_next = extractvalue %kizu.selfhost.codegen.binding %second_binding, 3");
    try append_line(out,
        "  %duplicate_local = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %first_name, %kizu.slice.u8 %second_name)");
    try append_line(out, "  br i1 %duplicate_local, label %unsupported, label %second_local_print");
    try append_line(out, "second_local_print:");
    try append_line(out,
        "  %second_local_payload = call %kizu.selfhost.codegen.payload @kizu_selfhost__cli_frontend_parse_print_statement(%kizu.slice.u8 %source, i64 %second_next, i1 true, %kizu.slice.u8 %first_name, %kizu.slice.u8 %first_payload, i1 true, %kizu.slice.u8 %second_name, %kizu.slice.u8 %second_payload)");
    try append_line(out, "  br label %finish_payload");
    try append_line(out, "finish_payload:");
    try append_line(out,
        "  %payload_result = phi %kizu.selfhost.codegen.payload [ %direct_payload, %direct_print ], [ %first_local_payload, %first_local_print ], [ %second_local_payload, %second_local_print ]");
    try append_line(out, "  %payload_ok = extractvalue %kizu.selfhost.codegen.payload %payload_result, 0");
    try append_line(out, "  br i1 %payload_ok, label %return_ast, label %unsupported");
    try append_line(out, "return_ast:");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.codegen.payload %payload_result, 1");
    try append_global_slice(out, "main", "codegen_main", 4);
    try append_global_slice(out, "print", "codegen_print", 5);
    try append_line(out, "  %ast0 = insertvalue %kizu.selfhost.codegen.run_ast zeroinitializer, i1 true, 0");
    try append_line(out, "  %ast1 = insertvalue %kizu.selfhost.codegen.run_ast %ast0, i64 1, 1");
    try append_line(out, "  %ast2 = insertvalue %kizu.selfhost.codegen.run_ast %ast1, %kizu.slice.u8 %main_slice, 2");
    try append_line(out, "  %ast3 = insertvalue %kizu.selfhost.codegen.run_ast %ast2, i64 1, 3");
    try append_line(out, "  %ast4 = insertvalue %kizu.selfhost.codegen.run_ast %ast3, i64 1, 4");
    try append_line(out, "  %ast5 = insertvalue %kizu.selfhost.codegen.run_ast %ast4, i64 1, 5");
    try append_line(out, "  %ast6 = insertvalue %kizu.selfhost.codegen.run_ast %ast5, %kizu.slice.u8 %print_slice, 6");
    try append_line(out, "  %ast7 = insertvalue %kizu.selfhost.codegen.run_ast %ast6, i64 1, 7");
    try append_line(out, "  %ast8 = insertvalue %kizu.selfhost.codegen.run_ast %ast7, %kizu.slice.u8 %payload, 8");
    try append_line(out, "  ret %kizu.selfhost.codegen.run_ast %ast8");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret %kizu.selfhost.codegen.run_ast zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}


fn append_frontend_parse_let_binding_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.binding @kizu_selfhost__cli_frontend_parse_let_binding(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %let_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %start)");
    try append_line(out, "  %let_in_bounds = icmp slt i64 %let_start, %source_len");
    try append_line(out, "  br i1 %let_in_bounds, label %load_let, label %unsupported");
    try append_line(out, "load_let:");
    try append_line(out,
        "  %let_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %let_start)");
    try append_line(out,
        "  %is_let = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %let_start, i64 %let_end, i64 3, i8 108, i8 101, i8 116, i8 0, i8 0, i8 0, i8 0)");
    try append_line(out, "  br i1 %is_let, label %load_name, label %unsupported");
    try append_line(out, "load_name:");
    try append_line(out,
        "  %name_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %let_end)");
    try append_line(out, "  %name_in_bounds = icmp slt i64 %name_start, %source_len");
    try append_line(out, "  br i1 %name_in_bounds, label %load_name_end, label %unsupported");
    try append_line(out, "load_name_end:");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %name_start)");
    try append_line(out,
        "  %assign_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %name_end)");
    try append_line(out, "  %assign_in_bounds = icmp slt i64 %assign_start, %source_len");
    try append_line(out, "  br i1 %assign_in_bounds, label %load_assign, label %unsupported");
    try append_line(out, "load_assign:");
    try append_line(out,
        "  %assign_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %assign_start)");
    try append_line(out,
        "  %is_assign = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %assign_start, i64 %assign_end, i8 61)");
    try append_line(out, "  br i1 %is_assign, label %load_string, label %unsupported");
    try append_line(out, "load_string:");
    try append_line(out,
        "  %string_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %assign_end)");
    try append_line(out, "  %string_in_bounds = icmp slt i64 %string_start, %source_len");
    try append_line(out, "  br i1 %string_in_bounds, label %load_string_end, label %unsupported");
    try append_line(out, "load_string_end:");
    try append_line(out,
        "  %string_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %string_start)");
    try append_line(out,
        "  %string_payload_result = call %kizu.selfhost.codegen.payload @kizu_selfhost__cli_frontend_string_payload(%kizu.slice.u8 %source, i64 %string_start, i64 %string_end)");
    try append_line(out, "  %string_ok = extractvalue %kizu.selfhost.codegen.payload %string_payload_result, 0");
    try append_line(out, "  br i1 %string_ok, label %load_semicolon, label %unsupported");
    try append_line(out, "load_semicolon:");
    try append_line(out,
        "  %semicolon_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %string_end)");
    try append_line(out, "  %semicolon_in_bounds = icmp slt i64 %semicolon_start, %source_len");
    try append_line(out, "  br i1 %semicolon_in_bounds, label %load_semicolon_end, label %unsupported");
    try append_line(out, "load_semicolon_end:");
    try append_line(out,
        "  %semicolon_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %semicolon_start)");
    try append_line(out,
        "  %is_semicolon = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %semicolon_start, i64 %semicolon_end, i8 59)");
    try append_line(out, "  br i1 %is_semicolon, label %return_binding, label %unsupported");
    try append_line(out, "return_binding:");
    try append_line(out, "  %name_ptr = getelementptr i8, ptr %source_ptr, i64 %name_start");
    try append_line(out, "  %name_len = sub i64 %name_end, %name_start");
    try append_line(out, "  %name_base = insertvalue %kizu.slice.u8 poison, ptr %name_ptr, 0");
    try append_line(out, "  %name = insertvalue %kizu.slice.u8 %name_base, i64 %name_len, 1");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.codegen.payload %string_payload_result, 1");
    try append_line(out, "  %ok0 = insertvalue %kizu.selfhost.codegen.binding zeroinitializer, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.selfhost.codegen.binding %ok0, %kizu.slice.u8 %name, 1");
    try append_line(out, "  %ok2 = insertvalue %kizu.selfhost.codegen.binding %ok1, %kizu.slice.u8 %payload, 2");
    try append_line(out, "  %result = insertvalue %kizu.selfhost.codegen.binding %ok2, i64 %semicolon_end, 3");
    try append_line(out, "  ret %kizu.selfhost.codegen.binding %result");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret %kizu.selfhost.codegen.binding zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}


fn append_frontend_parse_print_statement_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.payload @kizu_selfhost__cli_frontend_parse_print_statement(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i1 %has_first,");
    try append_line(out, "  %kizu.slice.u8 %first_name,");
    try append_line(out, "  %kizu.slice.u8 %first_payload,");
    try append_line(out, "  i1 %has_second,");
    try append_line(out, "  %kizu.slice.u8 %second_name,");
    try append_line(out, "  %kizu.slice.u8 %second_payload");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %print_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %start)");
    try append_line(out, "  %print_in_bounds = icmp slt i64 %print_start, %source_len");
    try append_line(out, "  br i1 %print_in_bounds, label %load_print, label %unsupported");
    try append_line(out, "load_print:");
    try append_line(out,
        "  %print_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %print_start)");
    try append_line(out,
        "  %is_print = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %print_start, i64 %print_end, i64 5, i8 112, i8 114, i8 105, i8 110, i8 116, i8 0, i8 0)");
    try append_line(out, "  br i1 %is_print, label %load_lparen, label %unsupported");
    try append_line(out, "load_lparen:");
    try append_line(out,
        "  %lparen_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %print_end)");
    try append_line(out, "  %lparen_in_bounds = icmp slt i64 %lparen_start, %source_len");
    try append_line(out, "  br i1 %lparen_in_bounds, label %load_lparen_end, label %unsupported");
    try append_line(out, "load_lparen_end:");
    try append_line(out,
        "  %lparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %lparen_start)");
    try append_line(out,
        "  %is_lparen = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %lparen_start, i64 %lparen_end, i8 40)");
    try append_line(out, "  br i1 %is_lparen, label %load_arg, label %unsupported");
    try append_line(out, "load_arg:");
    try append_line(out,
        "  %arg_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %lparen_end)");
    try append_line(out, "  %arg_in_bounds = icmp slt i64 %arg_start, %source_len");
    try append_line(out, "  br i1 %arg_in_bounds, label %load_arg_end, label %unsupported");
    try append_line(out, "load_arg_end:");
    try append_line(out,
        "  %arg_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %arg_start)");
    try append_line(out,
        "  %string_arg = call %kizu.selfhost.codegen.payload @kizu_selfhost__cli_frontend_string_payload(%kizu.slice.u8 %source, i64 %arg_start, i64 %arg_end)");
    try append_line(out, "  %string_arg_ok = extractvalue %kizu.selfhost.codegen.payload %string_arg, 0");
    try append_line(out, "  br i1 %string_arg_ok, label %payload_known_string, label %check_first_local");
    try append_line(out, "check_first_local:");
    try append_line(out,
        "  %arg_slice = call %kizu.slice.u8 @kizu_selfhost__cli_frontend_token_slice(%kizu.slice.u8 %source, i64 %arg_start, i64 %arg_end)");
    try append_line(out,
        "  %first_name_match_raw = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %arg_slice, %kizu.slice.u8 %first_name)");
    try append_line(out, "  %first_name_match = and i1 %has_first, %first_name_match_raw");
    try append_line(out, "  br i1 %first_name_match, label %payload_known_first, label %check_second_local");
    try append_line(out, "check_second_local:");
    try append_line(out,
        "  %second_name_match_raw = call i1 @kizu_selfhost__slice_equal(%kizu.slice.u8 %arg_slice, %kizu.slice.u8 %second_name)");
    try append_line(out, "  %second_name_match = and i1 %has_second, %second_name_match_raw");
    try append_line(out, "  br i1 %second_name_match, label %payload_known_second, label %unsupported");
    try append_line(out, "payload_known_string:");
    try append_line(out, "  %string_payload = extractvalue %kizu.selfhost.codegen.payload %string_arg, 1");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "payload_known_first:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "payload_known_second:");
    try append_line(out, "  br label %check_rparen");
    try append_line(out, "check_rparen:");
    try append_line(out,
        "  %payload = phi %kizu.slice.u8 [ %string_payload, %payload_known_string ], [ %first_payload, %payload_known_first ], [ %second_payload, %payload_known_second ]");
    try append_line(out,
        "  %rparen_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %arg_end)");
    try append_line(out, "  %rparen_in_bounds = icmp slt i64 %rparen_start, %source_len");
    try append_line(out, "  br i1 %rparen_in_bounds, label %load_rparen, label %unsupported");
    try append_line(out, "load_rparen:");
    try append_line(out,
        "  %rparen_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %rparen_start)");
    try append_line(out,
        "  %is_rparen = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %rparen_start, i64 %rparen_end, i8 41)");
    try append_line(out, "  br i1 %is_rparen, label %load_semicolon, label %unsupported");
    try append_line(out, "load_semicolon:");
    try append_line(out,
        "  %semicolon_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %rparen_end)");
    try append_line(out, "  %semicolon_in_bounds = icmp slt i64 %semicolon_start, %source_len");
    try append_line(out, "  br i1 %semicolon_in_bounds, label %load_semicolon_end, label %unsupported");
    try append_line(out, "load_semicolon_end:");
    try append_line(out,
        "  %semicolon_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %semicolon_start)");
    try append_line(out,
        "  %is_semicolon = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %semicolon_start, i64 %semicolon_end, i8 59)");
    try append_line(out, "  br i1 %is_semicolon, label %load_rbrace, label %unsupported");
    try append_line(out, "load_rbrace:");
    try append_line(out,
        "  %rbrace_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %semicolon_end)");
    try append_line(out, "  %rbrace_in_bounds = icmp slt i64 %rbrace_start, %source_len");
    try append_line(out, "  br i1 %rbrace_in_bounds, label %load_rbrace_end, label %unsupported");
    try append_line(out, "load_rbrace_end:");
    try append_line(out,
        "  %rbrace_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %rbrace_start)");
    try append_line(out,
        "  %is_rbrace = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %rbrace_start, i64 %rbrace_end, i8 125)");
    try append_line(out, "  br i1 %is_rbrace, label %check_eof, label %unsupported");
    try append_line(out, "check_eof:");
    try append_line(out,
        "  %after_rbrace = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %rbrace_end)");
    try append_line(out, "  %at_eof = icmp eq i64 %after_rbrace, %source_len");
    try append_line(out, "  br i1 %at_eof, label %return_payload, label %unsupported");
    try append_line(out, "return_payload:");
    try append_line(out, "  %ok0 = insertvalue %kizu.selfhost.codegen.payload zeroinitializer, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.selfhost.codegen.payload %ok0, %kizu.slice.u8 %payload, 1");
    try append_line(out, "  %result = insertvalue %kizu.selfhost.codegen.payload %ok1, i64 %rbrace_end, 2");
    try append_line(out, "  ret %kizu.selfhost.codegen.payload %result");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret %kizu.selfhost.codegen.payload zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    try append_frontend_string_payload_function(out);
    try append_frontend_token_slice_function(out);
    return;
}


fn append_frontend_string_payload_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.selfhost.codegen.payload @kizu_selfhost__cli_frontend_string_payload(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %length = sub i64 %end, %start");
    try append_line(out, "  %long_enough = icmp sge i64 %length, 2");
    try append_line(out, "  br i1 %long_enough, label %check_quotes, label %unsupported");
    try append_line(out, "check_quotes:");
    try append_line(out, "  %first_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %first = load i8, ptr %first_ptr");
    try append_line(out, "  %last_index = sub i64 %end, 1");
    try append_line(out, "  %last_ptr = getelementptr i8, ptr %source_ptr, i64 %last_index");
    try append_line(out, "  %last = load i8, ptr %last_ptr");
    try append_line(out, "  %first_quote = icmp eq i8 %first, 34");
    try append_line(out, "  %last_quote = icmp eq i8 %last, 34");
    try append_line(out, "  %quoted = and i1 %first_quote, %last_quote");
    try append_line(out, "  br i1 %quoted, label %return_payload, label %unsupported");
    try append_line(out, "return_payload:");
    try append_line(out, "  %payload_start = add i64 %start, 1");
    try append_line(out, "  %payload_len = sub i64 %length, 2");
    try append_line(out, "  %payload_ptr = getelementptr i8, ptr %source_ptr, i64 %payload_start");
    try append_line(out, "  %payload_base = insertvalue %kizu.slice.u8 poison, ptr %payload_ptr, 0");
    try append_line(out, "  %payload = insertvalue %kizu.slice.u8 %payload_base, i64 %payload_len, 1");
    try append_line(out, "  %ok0 = insertvalue %kizu.selfhost.codegen.payload zeroinitializer, i1 true, 0");
    try append_line(out, "  %ok1 = insertvalue %kizu.selfhost.codegen.payload %ok0, %kizu.slice.u8 %payload, 1");
    try append_line(out, "  %result = insertvalue %kizu.selfhost.codegen.payload %ok1, i64 %end, 2");
    try append_line(out, "  ret %kizu.selfhost.codegen.payload %result");
    try append_line(out, "unsupported:");
    try append_line(out, "  ret %kizu.selfhost.codegen.payload zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}


fn append_frontend_token_slice_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.slice.u8 @kizu_selfhost__cli_frontend_token_slice(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i64 %end");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %token_ptr = getelementptr i8, ptr %source_ptr, i64 %start");
    try append_line(out, "  %token_len = sub i64 %end, %start");
    try append_line(out, "  %base = insertvalue %kizu.slice.u8 poison, ptr %token_ptr, 0");
    try append_line(out, "  %result = insertvalue %kizu.slice.u8 %base, i64 %token_len, 1");
    try append_line(out, "  ret %kizu.slice.u8 %result");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    local: []u8,
    global: []u8,
    size: i64
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(local);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(local);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(local);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}
