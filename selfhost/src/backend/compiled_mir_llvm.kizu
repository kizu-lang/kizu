// append_multi_lower_run_parse_result renders lower_run_parse_result(text, parsed): it extracts
// ParseResult.ast/root from the parser boundary value and forwards directly to lower_run_ast.
fn append_multi_lower_run_parse_result(
    out: &var std::string::String,
    stmt: &compiled_mir::MirLowerRunParseResultStmt
) -> !void {
    try out.append_bytes("  %lrpr_ast = extractvalue ");
    try out.append_bytes(stmt.parsed_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.parsed_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, stmt.ast_field_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %lrpr_root = extractvalue ");
    try out.append_bytes(stmt.parsed_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.parsed_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, stmt.root_field_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %lrpr_result = call %kizu.error.run_ast @kizu_selfhost__ir_codegen_lower_run_ast(%kizu.slice.u8 %");
    try out.append_bytes(stmt.text_name);
    try append_ll_line(out, ", %kizu.kizu.ast.ast %lrpr_ast, %kizu.kizu.ast.node_id %lrpr_root)");
    try append_ll_line(out, "  ret %kizu.error.run_ast %lrpr_result");
    return;
}

