import selfhost::backend::compiled_mir;
import selfhost::backend::compiled_mir_llvm_call;
import selfhost::backend::compiled_mir_llvm_const;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_util;
pub fn append_function(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    if function.block_count != 1 {
        return error("compiled mir llvm: function must have one block");
    }
    if function.entry.instruction_count != 1 {
        return error("compiled mir llvm: block must have one instruction");
    }
    if function.entry.terminator.kind != compiled_mir::MirTerminatorKind::Return {
        return error("compiled mir llvm: unsupported terminator");
    }
    match function.entry.first_instruction {
        ConstString => try append_const_string_block(out, function);,
        ConstInt => try append_const_int_block(out, function);,
        StructLiteral => try append_struct_literal_block(out, function);,
        Expr => try append_expr_block(out, function);,
        MultiStatement => try append_multi_statement_block(out, function);,
        Call(payload) => try append_call_block(out, function, payload);,
        ArrayGet(payload) => try append_array_get_block(out, function, payload);,
        ArenaGet(payload) => try append_arena_get_block(out, function, payload);,
        MatchUnion(payload) => try append_match_union_block(out, function, payload);,
    }
    return;
}
fn append_call_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    inst: &compiled_mir::MirCallInst
) -> !void {
    if function.entry.terminator.value.kind != compiled_mir::MirValKind::CallResult {
        return error("compiled mir llvm: call return value must be call result");
    }
    try compiled_mir_llvm_call::append_call_return(out, function, inst);
    return;
}
fn append_ll_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}

// append_array_get_body renders the shared checked Array<T>.get body
// (Array<T>.get -> !T, tracker 961): it extracts the Array<T> %kizu.owned handle off
// the struct value receiver, calls the checked @kizu_rt_array_at runtime helper (the
// same one std arrays use, returning a borrowed %kizu.error.slice.u8 view), and
// branches on the ok flag. The success path loads the element value out of the
// borrowed view and wraps it as the error-union success value (field 1); the failure
// path forwards the runtime message as the error-union failure value (field 2), never
// 'unreachable'. The index operand is the i64 index parameter (%<index_param_name>)
// when index_is_param, otherwise the lowered index value. A lowered Var index can
// reference the source SSA name directly, and a lowered ConstInt index can use the
// literal value directly; other indexes use %t<index_temp_id>. The body uses
// function-scoped fixed names, so a function carries at most one array get.
fn append_array_get_body(
    out: &var std::string::String,
    error_union: []u8,
    receiver_type: []u8,
    receiver_name: []u8,
    field_index: i64,
    element_type: []u8,
    index_is_param: bool,
    index_param_name: []u8,
    index_value_name: []u8,
    index_is_int_literal: bool,
    index_int_value: i64,
    index_temp_id: i64
) -> !void {
    // Read the Array<T> handle off the struct value receiver.
    try out.append_bytes("  %array = extractvalue ");
    try out.append_bytes(receiver_type);
    try out.append_bytes(" %");
    try out.append_bytes(receiver_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, field_index);
    try out.append_byte(cast<u8>(10));
    // Call the checked array element accessor; it returns a borrowed view as a
    // %kizu.error.slice.u8 (ok flag, element view slice, error message).
    try out.append_bytes("  %view = call %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned %array, i64 ");
    if index_is_param {
        try out.append_bytes("%");
        try out.append_bytes(index_param_name);
    } else {
        try append_ssa_or_int_or_temp_ref(
            out, index_value_name, index_is_int_literal, index_int_value, index_temp_id
        );
    }
    try append_ll_line(out, ")");
    try append_ll_line(out, "  %view_ok = extractvalue %kizu.error.slice.u8 %view, 0");
    try append_ll_line(out,
        "  br i1 %view_ok, label %array_get_ok, label %array_get_fail");
    // Success: load the element value out of the borrowed view and wrap it.
    try append_ll_line(out, "array_get_ok:");
    try append_ll_line(out, "  %view_slice = extractvalue %kizu.error.slice.u8 %view, 1");
    try append_ll_line(out, "  %elem_ptr = extractvalue %kizu.slice.u8 %view_slice, 0");
    try out.append_bytes("  %elem = load ");
    try out.append_bytes(element_type);
    try append_ll_line(out, ", ptr %elem_ptr");
    try out.append_bytes("  %ok_flag = insertvalue ");
    try out.append_bytes(error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  %ok_value = insertvalue ");
    try out.append_bytes(error_union);
    try out.append_bytes(" %ok_flag, ");
    try out.append_bytes(element_type);
    try append_ll_line(out, " %elem, 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(error_union);
    try append_ll_line(out, " %ok_value");
    // Failure: forward the runtime message as the error-union failure value.
    try append_ll_line(out, "array_get_fail:");
    try append_ll_line(out, "  %fail_msg = extractvalue %kizu.error.slice.u8 %view, 2");
    try out.append_bytes("  %fail_flag = insertvalue ");
    try out.append_bytes(error_union);
    try append_ll_line(out, " zeroinitializer, i1 false, 0");
    try out.append_bytes("  %fail_value = insertvalue ");
    try out.append_bytes(error_union);
    try append_ll_line(out, " %fail_flag, %kizu.slice.u8 %fail_msg, 2");
    try out.append_bytes("  ret ");
    try out.append_bytes(error_union);
    try append_ll_line(out, " %fail_value");
    return;
}

// append_array_get_block renders a single-statement read-only
// 'return self.<field>.get(index);' accessor (Array<T>.get -> !T, tracker 961). The
// index is the i64 index parameter; the body is shared with the multi-statement
// 'return self.<field>.get(<expr>);' lowering.
fn append_array_get_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    inst: &compiled_mir::MirArrayGetInst
) -> !void {
    let error_union = function.return_type.llvm_name;
    try out.append_bytes("define ");
    try out.append_bytes(error_union);
    try out.append_bytes(" @");
    try out.append_bytes(function.name);
    try out.append_bytes("(");
    try compiled_signature::append_params_signature(out, function.params_spec);
    try append_ll_line(out, ") {");
    try append_ll_line(out, "entry:");
    try append_array_get_body(
        out,
        error_union,
        inst.receiver_type,
        inst.receiver_name,
        inst.field_index,
        inst.element_type,
        true,
        inst.index_name,
        "",
        false,
        0,
        0
    );
    try append_ll_line(out, "}");
    try out.append_byte(cast<u8>(10));
    return;
}

// append_arena_get_block renders a read-only 'return self.<field>.get(<param>.<field>);'
// accessor (Arena<T>.get -> T, tracker 961). It reads the Arena<T> %kizu.owned handle
// off the struct value receiver, computes the index (a field access on a value
// parameter, e.g. id.raw), calls the checked @kizu_rt_arena_get runtime helper, and
// branches on the ok flag: on success it loads the element value out of the borrowed
// view and returns it; out of bounds traps via @kizu_rt_trap (Arena.get panics rather
// than returning an error union, so the trap is the genuine failure semantics, not a
// stubbed-out branch).
fn append_arena_get_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    inst: &compiled_mir::MirArenaGetInst
) -> !void {
    let element_type = function.return_type.llvm_name;
    try out.append_bytes("define ");
    try out.append_bytes(element_type);
    try out.append_bytes(" @");
    try out.append_bytes(function.name);
    try out.append_bytes("(");
    try compiled_signature::append_params_signature(out, function.params_spec);
    try append_ll_line(out, ") {");
    try append_ll_line(out, "entry:");
    // Compute the index as a field access off the value parameter (id.raw).
    try out.append_bytes("  %index = extractvalue ");
    try out.append_bytes(inst.index_param_type);
    try out.append_bytes(" %");
    try out.append_bytes(inst.index_param_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, inst.index_field_index);
    try out.append_byte(cast<u8>(10));
    // Read the Arena<T> handle off the struct value receiver.
    try out.append_bytes("  %arena = extractvalue ");
    try out.append_bytes(inst.receiver_type);
    try out.append_bytes(" %");
    try out.append_bytes(inst.receiver_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, inst.arena_field_index);
    try out.append_byte(cast<u8>(10));
    try append_ll_line(out,
        "  %view = call %kizu.error.slice.u8 @kizu_rt_arena_get(%kizu.owned %arena, i64 %index)");
    try append_ll_line(out, "  %view_ok = extractvalue %kizu.error.slice.u8 %view, 0");
    try append_ll_line(out,
        "  br i1 %view_ok, label %arena_get_ok, label %arena_get_fail");
    // Success: load the element value out of the borrowed view and return it.
    try append_ll_line(out, "arena_get_ok:");
    try append_ll_line(out, "  %view_slice = extractvalue %kizu.error.slice.u8 %view, 1");
    try append_ll_line(out, "  %elem_ptr = extractvalue %kizu.slice.u8 %view_slice, 0");
    try out.append_bytes("  %elem = load ");
    try out.append_bytes(element_type);
    try append_ll_line(out, ", ptr %elem_ptr");
    try out.append_bytes("  ret ");
    try out.append_bytes(element_type);
    try append_ll_line(out, " %elem");
    // Failure: Arena.get panics on an out-of-bounds index; trap with the message.
    try append_ll_line(out, "arena_get_fail:");
    try append_ll_line(out, "  %fail_msg = extractvalue %kizu.error.slice.u8 %view, 2");
    try append_ll_line(out, "  call void @kizu_rt_trap(%kizu.slice.u8 %fail_msg)");
    try append_ll_line(out, "  unreachable");
    try append_ll_line(out, "}");
    try out.append_byte(cast<u8>(10));
    return;
}

// append_match_union_block renders the first 'let node = self.get(index); return match
// node.data { Variant(bind) => bind.<field>.<field>, _ => <int> };' read-only AST
// accessor (-> i64, tracker 961). It binds an AstNode by value from the Ast.get method
// call, extracts the AstData tagged-union value (AstNode field data_field_index) and its
// i64 tag (field 0), and dispatches on variant_tag: the active arm extracts the variant
// payload out of the inline union storage (the canonical alloca+store+gep field 1+load
// ABI) and returns a two-level field access off it; the default arm returns the literal
// default value, so neither arm is a stubbed-out 'unreachable'. The Ast.get callee symbol
// and the AstNode/AstData llvm types are the fixed AstData match ABI, so they are emitted
// literally here.
fn append_match_union_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    inst: &compiled_mir::MirMatchUnionInst
) -> !void {
    let return_type = function.return_type.llvm_name;
    try out.append_bytes("define ");
    try out.append_bytes(return_type);
    try out.append_bytes(" @");
    try out.append_bytes(function.name);
    try out.append_bytes("(");
    try compiled_signature::append_params_signature(out, function.params_spec);
    try append_ll_line(out, ") {");
    try append_ll_line(out, "entry:");
    // Bind the AstNode by value from the Ast.get method call (self.get(index)).
    try out.append_bytes("  %match_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(");
    try out.append_bytes(inst.receiver_type);
    try out.append_bytes(" %");
    try out.append_bytes(inst.receiver_name);
    try out.append_bytes(", ");
    try out.append_bytes(inst.index_type);
    try out.append_bytes(" %");
    try out.append_bytes(inst.index_name);
    try append_ll_line(out, ")");
    // Extract the AstData union value off the AstNode and read its i64 discriminant.
    try out.append_bytes("  %match_data = extractvalue %kizu.kizu.ast.ast_node %match_node, ");
    try std::fmt::append_i64(out, inst.data_field_index);
    try out.append_byte(cast<u8>(10));
    try append_ll_line(out, "  %match_tag = extractvalue %kizu.kizu.ast.ast_data %match_data, 0");
    try out.append_bytes("  %match_is_variant = icmp eq i64 %match_tag, ");
    try std::fmt::append_i64(out, inst.variant_tag);
    try out.append_byte(cast<u8>(10));
    try append_ll_line(out,
        "  br i1 %match_is_variant, label %match_arm_variant, label %match_arm_default");
    // Active arm: extract the variant payload out of the inline union storage.
    try append_ll_line(out, "match_arm_variant:");
    try append_ll_line(out, "  %match_payload_slot = alloca %kizu.kizu.ast.ast_data, align 8");
    try append_ll_line(out,
        "  store %kizu.kizu.ast.ast_data %match_data, ptr %match_payload_slot, align 8");
    try append_ll_line(out,
        "  %match_payload_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %match_payload_slot, i32 0, i32 1");
    try out.append_bytes("  %match_payload = load ");
    try out.append_bytes(inst.payload_type);
    try append_ll_line(out, ", ptr %match_payload_ptr, align 8");
    // Two-level field access off the bound payload (bind.<field0>.<field1>).
    try out.append_bytes("  %match_field0 = extractvalue ");
    try out.append_bytes(inst.payload_type);
    try out.append_bytes(" %match_payload, ");
    try std::fmt::append_i64(out, inst.field0_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %match_value = extractvalue ");
    try out.append_bytes(inst.field0_type);
    try out.append_bytes(" %match_field0, ");
    try std::fmt::append_i64(out, inst.field1_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret ");
    try out.append_bytes(return_type);
    try append_ll_line(out, " %match_value");
    // Default arm: return the literal default value (a real value, not 'unreachable').
    try append_ll_line(out, "match_arm_default:");
    try out.append_bytes("  ret ");
    try out.append_bytes(return_type);
    try out.append_byte(cast<u8>(32));
    try std::fmt::append_i64(out, inst.default_value);
    try out.append_byte(cast<u8>(10));
    try append_ll_line(out, "}");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_struct_literal_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    if function.entry.terminator.value.kind != compiled_mir::MirValKind::StructResult {
        return error("compiled mir llvm: struct return value must be struct result");
    }
    try append_struct_return(out, function);
    return;
}
fn append_expr_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    if function.entry.terminator.value.kind != compiled_mir::MirValKind::ExprResult {
        return error("compiled mir llvm: expr return value must be expr result");
    }
    try append_expr_return(out, function);
    return;
}
fn append_multi_statement_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    if function.entry.terminator.value.kind != compiled_mir::MirValKind::MultiResult {
        return error("compiled mir llvm: multi return value must be multi result");
    }
    try append_multi_statement_mir(out, function);
    return;
}
fn append_const_string_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    if function.return_type.kind != compiled_mir::MirTypeKind::SliceU8 {
        return error("compiled mir llvm: unsupported return type");
    }
    if function.entry.terminator.value.kind != compiled_mir::MirValKind::ConstString {
        return error("compiled mir llvm: return value must be const string");
    }
    try compiled_mir_llvm_const::append_const_string_return(
        out, function.name, function.entry.terminator.value.payload
    );
    return;
}
fn append_const_int_block(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    if function.return_type.kind != compiled_mir::MirTypeKind::I64 {
        return error("compiled mir llvm: unsupported return type");
    }
    if function.entry.terminator.value.kind != compiled_mir::MirValKind::ConstInt {
        return error("compiled mir llvm: return value must be const int");
    }
    try compiled_mir_llvm_const::append_const_int_return(
        out, function.name, function.entry.terminator.value.int_value
    );
    return;
}
fn append_multi_statement_mir(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    try append_multi_statement_globals(out, function);
    try out.append_bytes("define ");
    try out.append_bytes(function.return_type.llvm_name);
    try out.append_bytes(" @");
    try out.append_bytes(function.name);
    try out.append_bytes("(");
    try compiled_signature::append_params_signature(out, function.params_spec);
    try out.append_bytes(") {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    let stmts = &function.multi_stmts;
    var stmt_index = 0;
    while stmt_index < stmts.len() {
        let stmt = try stmts.at(stmt_index);
        try append_multi_stmt(out, function, stmt, stmt_index);
        stmt_index = stmt_index + 1;
    }
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_multi_stmt(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirStmt,
    local_prefix: i64
) -> !void {
    match stmt {
        LetCall(payload) => try append_multi_let_call(out, function, payload, local_prefix);,
        LetStruct(payload) => try append_multi_let_struct(out, function.name, payload);,
        LetArenaAdd(payload) => try append_multi_let_arena_add(out, function.name, payload);,
        LetExpr(payload) => try append_multi_let_expr(out, function, payload);,
        AliasAssign(payload) => try append_alias_assign(out, function, payload);,
        ScalarSelectAssign(payload) => try append_scalar_select_assign(out, function.name, payload);,
        LetTryCall(payload) => try append_multi_let_try_call(out, function, payload, local_prefix);,
        ReturnTryBinary(payload) => try append_multi_return_try_binary(out, function, payload, local_prefix);,
        ReturnNotTryCall(payload) => try append_multi_return_not_try_call(out, function, payload, local_prefix);,
        IfNotTryCallReturnBool(payload) => try append_multi_if_not_try_call_return_bool(out, function, payload, local_prefix);,
        StringTryAppend(payload) => try append_multi_string_try_append(out, function, payload, local_prefix);,
        ArrayTryAppend(payload) => try append_multi_array_try_append(out, function, payload, local_prefix);,
        ArrayTrySet(payload) => try append_multi_array_try_set(out, function, payload, local_prefix);,
        VoidTryCall(payload) => try append_multi_void_try_call(out, function, payload, local_prefix);,
        OwnedDeinit(payload) => try append_multi_owned_deinit(out, payload);,
        CountRange(payload) => try append_multi_count_range(out, payload);,
        TrimAscii(payload) => try append_multi_trim_ascii(out, payload);,
        AdvancePosition(payload) => try append_multi_advance_position(out, payload);,
        NumberToken(payload) => try append_multi_number_token(out, payload);,
        StringToken(payload) => try append_multi_string_token(out, payload);,
        SkipLineComment(payload) => try append_multi_skip_line_comment(out, payload);,
        IsDocCommentStart(payload) => try append_multi_is_doc_comment_start(out, payload);,
        WordToken(payload) => try append_multi_word_token(out, payload);,
        RawToken(payload) => try append_multi_raw_token(out, payload);,
        TokenAt(payload) => try append_multi_token_at(out, payload);,
        FirstToken(payload) => try append_multi_first_token(out, payload);,
        NextToken(payload) => try append_multi_next_token(out, payload);,
        ArrayNew(payload) => try append_array_new(out, payload);,
        ValueWhile(payload) => try append_value_while(out, payload);,
        GrammarLoop(payload) => try append_grammar_loop(out, function, payload);,
        ValueCursorWhile(payload) => try append_value_cursor_while(out, function, payload);,
        PrecedenceLoop(payload) => try append_precedence_loop(out, function, payload);,
        DualCursorLoop(payload) => try append_dual_cursor_loop(out, function, payload);,
        TrailingTokenLoop(payload) => try append_trailing_token_loop(out, function, payload);,
        TypeApplyLoop(payload) => try append_type_apply_loop(out, function, payload);,
        WhileMatchLoop(payload) => try append_while_match_loop(out, function, payload);,
        GuardedCursorLoop(payload) => try append_guarded_cursor_loop(out, function, payload);,
        TokenKindPredicate(payload) => try append_multi_token_kind_predicate(out, payload);,
        ParserSpanPredicate(payload) => try append_multi_parser_span_predicate(out, payload);,
        ParserPostfixStart(payload) => try append_multi_parser_postfix_start(out, payload);,
        AstNodeText(payload) => try append_multi_ast_node_text(out, payload);,
        StringLiteralSpan(payload) => try append_multi_string_literal_span(out, payload);,
        ReturnCall(payload) => try append_multi_return_call(out, function, payload, local_prefix);,
        ReturnStruct(payload) => try append_multi_return_struct(out, function, payload);,
        VoidReturnSuccess(payload) => try append_multi_if_return_void_success(out, function.return_type.llvm_name);,
        ReturnExpr(payload) => try append_multi_return_expr(out, function, payload);,
        ReturnError(payload) => try append_multi_return_error(out, function, payload);,
        ReturnArrayGet(payload) => try append_multi_return_array_get(out, function, payload);,
        LetArrayGet(payload) => try append_multi_let_array_get(out, function, payload);,
        If(payload) => try append_multi_if(out, function, payload, local_prefix);,
        While(payload) => try append_multi_while(out, function, payload);,
        MatchTraversal(payload) => try append_multi_match_traversal(out, payload);,
        EnumDispatch(payload) => try append_multi_enum_dispatch(out, function, payload, local_prefix);,
    }
    return;
}
fn append_multi_let_call(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirLetCallStmt,
    local_prefix: i64
) -> !void {
    try append_call_inst(
        out,
        function.name,
        stmt.name,
        stmt.llvm_type,
        stmt.call_module_prefix,
        stmt.call_callee_name,
        &stmt.call_args,
        local_prefix
    );
    return;
}
// append_multi_let_try_call renders a 'let <name> = try <callee>(<args>);' try-call over
// an error-union-returning free function (the node_count traversal cluster, tracker 961).
// It emits the call into %<name>_call, extracts the ok flag (field 0), and branches on a
// try_index-suffixed label pair: try<N>_fail re-wraps the callee message (field 2) into
// this function's own error-union failure value and returns it (propagation, never
// 'unreachable'); try<N>_cont extracts the success value (field 1) into %<name> and the
// following statements continue in it.
fn append_multi_let_try_call(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirLetTryCallStmt,
    local_prefix: i64
) -> !void {
    try append_try_call_body(out, function.name, stmt, "", local_prefix);
    return;
}
// append_try_call_bind_name emits the SSA base '%<name><bind_suffix>' a try-call's helper
// temps and bound value are namespaced under. The let-position try-call passes an empty
// bind_suffix (binding %<name>); the loop latch passes "_next" so the success value binds to
// %<induction_var>_next that the loop-head phi reads on the latch edge (issue 1165).
fn append_try_call_bind_name(
    out: &var std::string::String,
    name: []u8,
    bind_suffix: []u8
) -> !void {
    try out.append_bytes("%");
    try out.append_bytes(name);
    try out.append_bytes(bind_suffix);
    return;
}
// append_try_call_body renders a try-call over an error-union-returning free function. It
// emits the call into %<name><bind_suffix>_call, extracts the ok flag (field 0), and branches
// on a try_index-suffixed label pair: try<N>_fail re-wraps the callee message (field 2) into
// own_error_union and returns it (propagation, never 'unreachable'); try<N>_cont extracts the
// success value (field 1) into %<name><bind_suffix>. The bind_suffix namespaces every SSA name
// so the let-position bind (suffix "") and the loop latch bind (suffix "_next") never collide.
fn append_try_call_body(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirLetTryCallStmt,
    bind_suffix: []u8,
    local_prefix: i64
) -> !void {
    try append_expr_insts(out, llvm_symbol, &stmt.arg_insts);
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, llvm_symbol, &stmt.call_args, local_prefix
    );
    try out.append_bytes("  ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_call = call ");
    try out.append_bytes(stmt.called_error_union);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, stmt.call_module_prefix, stmt.call_callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, &stmt.call_args, local_prefix);
    try append_ll_line(out, ")");
    try out.append_bytes("  ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_ok = extractvalue ");
    try out.append_bytes(stmt.called_error_union);
    try out.append_bytes(" ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try append_ll_line(out, "_call, 0");
    try out.append_bytes("  br i1 ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_ok, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_cont, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail");
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail:");
    try out.append_bytes("  ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_msg = extractvalue ");
    try out.append_bytes(stmt.called_error_union);
    try out.append_bytes(" ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_call, ");
    try append_ll_line(out, error_union_msg_index_text(stmt.called_error_union));
    try out.append_bytes("  ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_fail_flag = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 false, 0");
    try out.append_bytes("  ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_fail_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_fail_flag, %kizu.slice.u8 ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes("_msg, ");
    try append_ll_line(out, error_union_msg_index_text(stmt.own_error_union));
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try append_ll_line(out, "_fail_val");
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_cont:");
    try out.append_bytes("  ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(stmt.called_error_union);
    try out.append_bytes(" ");
    try append_try_call_bind_name(out, stmt.name, bind_suffix);
    try append_ll_line(out, "_call, 1");
    return;
}
// append_multi_string_try_append renders a mutating 'try <receiver>.append_bytes(<arg>);' or
// 'try <receiver>.append_byte(<arg>);' on a std::string::String value (issue 1165 slice 1). It
// sets up the single appended argument, calls the @kizu_rt_string_append_* runtime helper
// (which returns %kizu.error.void), extracts the ok flag (field 0), and branches on a
// try_index-suffixed label pair: try<N>_fail re-wraps the runtime message (error.void field 1)
// into this function's own error union and returns it (propagation, never 'unreachable');
// try<N>_cont continues with no bound value because the statement is a void method call.
fn append_multi_string_try_append(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirStringTryAppendStmt,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, function.name, &stmt.call_args, local_prefix
    );
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_call = call %kizu.error.void @");
    try out.append_bytes(stmt.runtime_symbol);
    try out.append_bytes("(%kizu.owned %");
    try out.append_bytes(stmt.receiver_name);
    try out.append_bytes(", ");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, &stmt.call_args, local_prefix);
    try append_ll_line(out, ")");
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_ok = extractvalue %kizu.error.void %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_call, 0");
    try out.append_bytes("  br i1 %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_ok, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_cont, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail");
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail:");
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_msg = extractvalue %kizu.error.void %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_call, 1");
    try append_string_try_fail_return(out, stmt);
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_cont:");
    return;
}

// append_multi_array_try_append renders a mutating 'try <receiver>.append(<value>);' statement
// on a std::array::Array<T> value. The single element argument is rendered through the shared
// call-arg setup, stored into a statement-local slot, wrapped into the (pointer, element size)
// %kizu.slice.u8 the element-size-generic @kizu_rt_array_append ABI takes, and the failure tail
// propagates the runtime message as this function's own error union exactly like StringTryAppend.
fn append_multi_array_try_append(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirArrayTryAppendStmt,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, function.name, &stmt.call_args, local_prefix
    );
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_slot = alloca ");
    try append_ll_line(out, stmt.element_llvm);
    try out.append_bytes("  store ");
    try out.append_bytes(stmt.element_llvm);
    try out.append_bytes(" ");
    let element_args = &stmt.call_args;
    let element_arg = try element_args.at(0);
    try compiled_mir_llvm_call::append_call_arg_value_with_prefix(out, &element_arg, local_prefix, 0);
    try out.append_bytes(", ptr %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_slot");
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_es0 = insertvalue %kizu.slice.u8 poison, ptr %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_slot, 0");
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_eslice = insertvalue %kizu.slice.u8 %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_es0, i64 ptrtoint (ptr getelementptr (");
    try out.append_bytes(stmt.element_llvm);
    try append_ll_line(out, ", ptr null, i32 1) to i64), 1");
    if stmt.receiver_field_index >= 0 {
        try out.append_bytes("  %append");
        try std::fmt::append_i64(out, stmt.try_index);
        try out.append_bytes("_receiver = extractvalue ");
        try out.append_bytes(stmt.receiver_source_type);
        try out.append_bytes(" %");
        try out.append_bytes(stmt.receiver_name);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, stmt.receiver_field_index);
        try out.append_byte(cast<u8>(10));
    }
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_call = call %kizu.error.void @kizu_rt_array_append(%kizu.owned %");
    if stmt.receiver_field_index >= 0 {
        try out.append_bytes("append");
        try std::fmt::append_i64(out, stmt.try_index);
        try out.append_bytes("_receiver");
    } else {
        try out.append_bytes(stmt.receiver_name);
    }
    try out.append_bytes(", %kizu.slice.u8 %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_eslice)");
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_ok = extractvalue %kizu.error.void %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_call, 0");
    try out.append_bytes("  br i1 %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_ok, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_cont, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail");
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail:");
    try out.append_bytes("  %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_msg = extractvalue %kizu.error.void %append");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_call, 1");
    try append_error_void_try_fail_return(out, "%append", stmt.try_index, stmt.own_error_union);
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_cont:");
    return;
}

// append_multi_array_try_set renders a mutating 'try <receiver>.set(<index>, <value>);'
// statement on a std::array::Array<T> value. call_args holds [index, value]: the index renders
// as a plain i64 operand, the element is stored into a statement-local slot and wrapped into the
// (pointer, element size) %kizu.slice.u8 the element-size-generic @kizu_rt_array_set ABI takes,
// and the failure tail propagates the runtime message exactly like ArrayTryAppend.
fn append_multi_array_try_set(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirArrayTrySetStmt,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, function.name, &stmt.call_args, local_prefix
    );
    try out.append_bytes("  %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_slot = alloca ");
    try append_ll_line(out, stmt.element_llvm);
    try out.append_bytes("  store ");
    try out.append_bytes(stmt.element_llvm);
    try out.append_bytes(" ");
    let set_args = &stmt.call_args;
    let element_arg = try set_args.at(1);
    try compiled_mir_llvm_call::append_call_arg_value_with_prefix(out, &element_arg, local_prefix, 1);
    try out.append_bytes(", ptr %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_slot");
    try out.append_bytes("  %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_es0 = insertvalue %kizu.slice.u8 poison, ptr %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_slot, 0");
    try out.append_bytes("  %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_eslice = insertvalue %kizu.slice.u8 %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_es0, i64 ptrtoint (ptr getelementptr (");
    try out.append_bytes(stmt.element_llvm);
    try append_ll_line(out, ", ptr null, i32 1) to i64), 1");
    try out.append_bytes("  %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_call = call %kizu.error.void @kizu_rt_array_set(%kizu.owned %");
    try out.append_bytes(stmt.receiver_name);
    try out.append_bytes(", i64 ");
    let index_arg = try set_args.at(0);
    try compiled_mir_llvm_call::append_call_arg_value_with_prefix(out, &index_arg, local_prefix, 0);
    try out.append_bytes(", %kizu.slice.u8 %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_eslice)");
    try out.append_bytes("  %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_ok = extractvalue %kizu.error.void %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_call, 0");
    try out.append_bytes("  br i1 %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_ok, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_cont, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail");
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail:");
    try out.append_bytes("  %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_msg = extractvalue %kizu.error.void %aset");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_call, 1");
    try append_error_void_try_fail_return(out, "%aset", stmt.try_index, stmt.own_error_union);
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_cont:");
    return;
}

// append_string_try_fail_return emits the failure-propagation tail of a StringTryAppend: it
// wraps the extracted runtime message into this function's own error union and returns it,
// sharing append_error_void_try_fail_return with the VoidTryCall path (both call a
// %kizu.error.void-returning helper whose message temp is %append<N>_msg, issue 1165 slice 1).
fn append_string_try_fail_return(
    out: &var std::string::String,
    stmt: &compiled_mir::MirStringTryAppendStmt
) -> !void {
    try append_error_void_try_fail_return(out, "%append", stmt.try_index, stmt.own_error_union);
    return;
}

// append_error_void_try_fail_return emits the shared failure-propagation tail of a try-call over
// a %kizu.error.void-returning callee (StringTryAppend / VoidTryCall, issue 1165 / 1201). The
// already-extracted message temp %<ssa_prefix><try_index>_msg is wrapped into own_error_union and
// returned. The message field index depends on the own error-union shape -- %kizu.error.void
// carries it at field 1, while the 3-field unions (%kizu.error.owned / %kizu.error.slice.u8) carry
// it at field 2 with the success value left zero-initialized.
// error_union_msg_index_text returns the runtime-message field index of an error
// union: %kizu.error.void is { i1, %kizu.slice.u8 } (message at 1), every
// value-carrying union is { i1, <value>, %kizu.slice.u8 } (message at 2).
fn error_union_msg_index_text(error_union: []u8) -> []u8 {
    if std::mem::equal_bytes(error_union, "%kizu.error.void") {
        return "1";
    }
    return "2";
}

fn append_error_void_try_fail_return(
    out: &var std::string::String,
    ssa_prefix: []u8,
    try_index: i64,
    own_error_union: []u8
) -> !void {
    try out.append_bytes("  ");
    try out.append_bytes(ssa_prefix);
    try std::fmt::append_i64(out, try_index);
    try out.append_bytes("_fail_flag = insertvalue ");
    try out.append_bytes(own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 false, 0");
    try out.append_bytes("  ");
    try out.append_bytes(ssa_prefix);
    try std::fmt::append_i64(out, try_index);
    try out.append_bytes("_fail_val = insertvalue ");
    try out.append_bytes(own_error_union);
    try out.append_bytes(" ");
    try out.append_bytes(ssa_prefix);
    try std::fmt::append_i64(out, try_index);
    try out.append_bytes("_fail_flag, %kizu.slice.u8 ");
    try out.append_bytes(ssa_prefix);
    try std::fmt::append_i64(out, try_index);
    try out.append_bytes("_msg, ");
    if std::mem::equal_bytes(own_error_union, "%kizu.error.void") {
        try append_ll_line(out, "1");
    } else {
        try append_ll_line(out, "2");
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(own_error_union);
    try out.append_bytes(" ");
    try out.append_bytes(ssa_prefix);
    try std::fmt::append_i64(out, try_index);
    try append_ll_line(out, "_fail_val");
    return;
}

// append_multi_void_try_call renders a bare 'try <callee>(<args>);' statement whose callee is a
// free function returning a %kizu.error.void success (issue 1201). It composes the LetTryCall
// free-function call shape with StringTryAppend's value-less continuation: it sets up the call
// args, calls the module-prefixed callee into %voidtry<N>_call, extracts the ok flag (field 0),
// and branches on a try_index-suffixed label pair -- try<N>_fail extracts the message (field 1)
// and propagates it as this function's own error union; try<N>_cont continues with no bound value
// because the success type is void.
fn append_multi_void_try_call(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirVoidTryCallStmt,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, function.name, &stmt.call_args, local_prefix
    );
    try out.append_bytes("  %voidtry");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_call = call %kizu.error.void @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, stmt.call_module_prefix, stmt.call_callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, &stmt.call_args, local_prefix);
    try append_ll_line(out, ")");
    try out.append_bytes("  %voidtry");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_ok = extractvalue %kizu.error.void %voidtry");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_call, 0");
    try out.append_bytes("  br i1 %voidtry");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_ok, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_cont, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail");
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail:");
    try out.append_bytes("  %voidtry");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_msg = extractvalue %kizu.error.void %voidtry");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_call, 1");
    try append_error_void_try_fail_return(out, "%voidtry", stmt.try_index, stmt.own_error_union);
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_cont:");
    return;
}

// append_multi_owned_deinit renders a validated non-try '<receiver>.deinit();' statement on a
// runtime-owned value. The cleanup call is side-effecting and returns void, so control continues in
// the current block with no bound value and no failure propagation.
fn append_multi_owned_deinit(
    out: &var std::string::String,
    stmt: &compiled_mir::MirOwnedDeinitStmt
) -> !void {
    try out.append_bytes("  call void @kizu_rt_owned_deinit(%kizu.owned %");
    try out.append_bytes(stmt.receiver_name);
    try append_ll_line(out, ")");
    return;
}

// append_multi_return_try_binary renders 'return <literal> + try <callee>(<args>);'
// (count_one / count_with_range, tracker 961): it emits the call, branches on its ok flag,
// propagates the failure as this function's own error union, and on success adds the literal
// to the unwrapped value and returns it wrapped as the error-union success.
fn append_multi_return_try_binary(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnTryBinaryStmt,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, function.name, &stmt.call_args, local_prefix
    );
    try out.append_bytes("  %rettry_call = call ");
    try out.append_bytes(stmt.called_error_union);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, stmt.call_module_prefix, stmt.call_callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, &stmt.call_args, local_prefix);
    try append_ll_line(out, ")");
    try out.append_bytes("  %rettry_ok = extractvalue ");
    try out.append_bytes(stmt.called_error_union);
    try append_ll_line(out, " %rettry_call, 0");
    try append_ll_line(out,
        "  br i1 %rettry_ok, label %rettry_cont, label %rettry_fail");
    try append_ll_line(out, "rettry_fail:");
    try out.append_bytes("  %rettry_msg = extractvalue ");
    try out.append_bytes(stmt.called_error_union);
    try append_ll_line(out, " %rettry_call, 2");
    try out.append_bytes("  %rettry_fail_flag = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 false, 0");
    try out.append_bytes("  %rettry_fail_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %rettry_fail_flag, %kizu.slice.u8 %rettry_msg, 2");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %rettry_fail_val");
    try append_ll_line(out, "rettry_cont:");
    try out.append_bytes("  %rettry_success = extractvalue ");
    try out.append_bytes(stmt.called_error_union);
    try append_ll_line(out, " %rettry_call, 1");
    try out.append_bytes("  %rettry_sum = add i64 ");
    try std::fmt::append_i64(out, stmt.literal);
    try append_ll_line(out, ", %rettry_success");
    try out.append_bytes("  %rettry_wrap_flag = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  %rettry_wrap_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %rettry_wrap_flag, i64 %rettry_sum, 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %rettry_wrap_val");
    return;
}

// append_nottry_ref / append_nottry_label namespace a sub-expression try-call's helper SSA temps
// and block labels under 'nottry<local_prefix>' so several '!(try <call>)' hoists in one function
// never collide (issue 1165 / 1162). local_prefix is the render-time statement index, unique per
// rendered statement, so it disambiguates without a separate try counter and stays clear of the
// let-position try-call's 'try<N>' namespace.
fn append_nottry_ref(out: &var std::string::String, local_prefix: i64, suffix: []u8) -> !void {
    try out.append_bytes("%nottry");
    try std::fmt::append_i64(out, local_prefix);
    try out.append_bytes(suffix);
    return;
}
fn append_nottry_label(out: &var std::string::String, local_prefix: i64, suffix: []u8) -> !void {
    try out.append_bytes("nottry");
    try std::fmt::append_i64(out, local_prefix);
    try out.append_bytes(suffix);
    return;
}

fn append_tryif_ref(out: &var std::string::String, local_prefix: i64, suffix: []u8) -> !void {
    try out.append_bytes("%tryif");
    try std::fmt::append_i64(out, local_prefix);
    try out.append_bytes(suffix);
    return;
}
fn append_tryif_label(out: &var std::string::String, local_prefix: i64, suffix: []u8) -> !void {
    try out.append_bytes("tryif");
    try std::fmt::append_i64(out, local_prefix);
    try out.append_bytes(suffix);
    return;
}

// append_try_bool_call_eval renders a positive 'try <callee>(<args>)' bool condition. It shares
// the not-try hoist's call / ok-branch shape, but branches on the unwrapped success directly
// instead of negating it. Failure propagates as this function's own error union.
fn append_try_bool_call_eval(
    out: &var std::string::String,
    function_name: []u8,
    called_error_union: []u8,
    own_error_union: []u8,
    call_module_prefix: []u8,
    call_callee_name: []u8,
    call_args: &std::array::Array<compiled_mir::MirCallArg>,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, function_name, call_args, local_prefix
    );
    try out.append_bytes("  ");
    try append_tryif_ref(out, local_prefix, "_call");
    try out.append_bytes(" = call ");
    try out.append_bytes(called_error_union);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(out, call_module_prefix, call_callee_name);
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, call_args, local_prefix);
    try append_ll_line(out, ")");
    try out.append_bytes("  ");
    try append_tryif_ref(out, local_prefix, "_ok");
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(called_error_union);
    try out.append_bytes(" ");
    try append_tryif_ref(out, local_prefix, "_call");
    try append_ll_line(out, ", 0");
    try out.append_bytes("  br i1 ");
    try append_tryif_ref(out, local_prefix, "_ok");
    try out.append_bytes(", label %");
    try append_tryif_label(out, local_prefix, "_cont");
    try out.append_bytes(", label %");
    try append_tryif_label(out, local_prefix, "_fail");
    try out.append_byte(cast<u8>(10));
    try append_tryif_label(out, local_prefix, "_fail");
    try append_ll_line(out, ":");
    try out.append_bytes("  ");
    try append_tryif_ref(out, local_prefix, "_msg");
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(called_error_union);
    try out.append_bytes(" ");
    try append_tryif_ref(out, local_prefix, "_call");
    try append_ll_line(out, ", 2");
    try append_error_void_try_fail_return(out, "%tryif", local_prefix, own_error_union);
    try append_tryif_label(out, local_prefix, "_cont");
    try append_ll_line(out, ":");
    try out.append_bytes("  ");
    try append_tryif_ref(out, local_prefix, "_success");
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(called_error_union);
    try out.append_bytes(" ");
    try append_tryif_ref(out, local_prefix, "_call");
    try append_ll_line(out, ", 1");
    return;
}

// append_not_try_call_eval renders the shared head of a '!(try <callee>(<args>))' hoist: the call,
// the ok-flag branch, the failure propagation as own_error_union (never 'unreachable'), the success
// unwrap, and the boolean negation. It leaves the negated i1 in '%nottry<P>_neg' and control in the
// 'nottry<P>_cont' block for the caller to terminate (a return wrap or a guard branch). The callee
// returns an error-union bool, so the success field (field 1) is an i1 (issue 1165 / 1162).
fn append_not_try_call_eval(
    out: &var std::string::String,
    function_name: []u8,
    called_error_union: []u8,
    own_error_union: []u8,
    call_module_prefix: []u8,
    call_callee_name: []u8,
    call_args: &std::array::Array<compiled_mir::MirCallArg>,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, function_name, call_args, local_prefix
    );
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_call");
    try out.append_bytes(" = call ");
    try out.append_bytes(called_error_union);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(out, call_module_prefix, call_callee_name);
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, call_args, local_prefix);
    try append_ll_line(out, ")");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_ok");
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(called_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_call");
    try append_ll_line(out, ", 0");
    try out.append_bytes("  br i1 ");
    try append_nottry_ref(out, local_prefix, "_ok");
    try out.append_bytes(", label %");
    try append_nottry_label(out, local_prefix, "_cont");
    try out.append_bytes(", label %");
    try append_nottry_label(out, local_prefix, "_fail");
    try out.append_byte(cast<u8>(10));
    try append_nottry_label(out, local_prefix, "_fail");
    try append_ll_line(out, ":");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_msg");
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(called_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_call");
    try append_ll_line(out, ", 2");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_fail_flag");
    try out.append_bytes(" = insertvalue ");
    try out.append_bytes(own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 false, 0");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_fail_val");
    try out.append_bytes(" = insertvalue ");
    try out.append_bytes(own_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_fail_flag");
    try out.append_bytes(", %kizu.slice.u8 ");
    try append_nottry_ref(out, local_prefix, "_msg");
    try append_ll_line(out, ", 2");
    try out.append_bytes("  ret ");
    try out.append_bytes(own_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_fail_val");
    try out.append_byte(cast<u8>(10));
    try append_nottry_label(out, local_prefix, "_cont");
    try append_ll_line(out, ":");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_success");
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(called_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_call");
    try append_ll_line(out, ", 1");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_neg");
    try out.append_bytes(" = xor i1 ");
    try append_nottry_ref(out, local_prefix, "_success");
    try append_ll_line(out, ", true");
    return;
}

// append_multi_return_not_try_call renders 'return !(try <callee>(<args>));' (is_trailing_comma,
// issue 1165 / 1162): it evaluates the hoisted try-call, then on success wraps the negated bool as
// the error-union success and returns it.
fn append_multi_return_not_try_call(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnNotTryCallStmt,
    local_prefix: i64
) -> !void {
    try append_not_try_call_eval(
        out, function.name, stmt.called_error_union, stmt.own_error_union,
        stmt.call_module_prefix, stmt.call_callee_name, &stmt.call_args, local_prefix
    );
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_wrap_flag");
    try out.append_bytes(" = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_wrap_val");
    try out.append_bytes(" = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_wrap_flag");
    try out.append_bytes(", i1 ");
    try append_nottry_ref(out, local_prefix, "_neg");
    try append_ll_line(out, ", 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_wrap_val");
    try out.append_byte(cast<u8>(10));
    return;
}

// append_multi_if_not_try_call_return_bool renders 'if !(try <callee>(<args>)) { return <bool>; }'
// (is_trailing_comma, issue 1165 / 1162): it evaluates the hoisted try-call, then branches on the
// negated bool into a 'return <bool_value>' then-block or a fall-through join block the following
// statements render into.
fn append_multi_if_not_try_call_return_bool(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirIfNotTryCallReturnBoolStmt,
    local_prefix: i64
) -> !void {
    try append_not_try_call_eval(
        out, function.name, stmt.called_error_union, stmt.own_error_union,
        stmt.call_module_prefix, stmt.call_callee_name, &stmt.call_args, local_prefix
    );
    try out.append_bytes("  br i1 ");
    try append_nottry_ref(out, local_prefix, "_neg");
    try out.append_bytes(", label %");
    try append_nottry_label(out, local_prefix, "_then");
    try out.append_bytes(", label %");
    try append_nottry_label(out, local_prefix, "_join");
    try out.append_byte(cast<u8>(10));
    try append_nottry_label(out, local_prefix, "_then");
    try append_ll_line(out, ":");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_ret_flag");
    try out.append_bytes(" = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  ");
    try append_nottry_ref(out, local_prefix, "_ret_val");
    try out.append_bytes(" = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_ret_flag");
    try out.append_bytes(", i1 ");
    try append_bool_literal(out, stmt.bool_value);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" ");
    try append_nottry_ref(out, local_prefix, "_ret_val");
    try out.append_byte(cast<u8>(10));
    try append_nottry_label(out, local_prefix, "_join");
    try append_ll_line(out, ":");
    return;
}

// append_trim_ascii_globals / append_ast_node_text_globals: these accessors forward only value
// arguments, so they emit no string-constant globals (tracker 961).
fn append_trim_ascii_globals(stmt: &compiled_mir::MirTrimAsciiStmt) -> !void {
    return;
}
fn append_ast_node_text_globals(stmt: &compiled_mir::MirAstNodeTextStmt) -> !void {
    return;
}

// append_multi_trim_ascii renders std::mem::trim_ascii as two break-on-condition search loops:
// the front loop advances %start past leading ASCII spaces, the back loop retreats %end past
// trailing ones, and the exit returns the trimmed two-bound slice (tracker 961).
fn append_multi_trim_ascii(
    out: &var std::string::String,
    stmt: &compiled_mir::MirTrimAsciiStmt
) -> !void {
    try out.append_bytes("  %trim_bytes_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.bytes_name);
    try append_ll_line(out, ", 0");
    try out.append_bytes("  %trim_bytes_len = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.bytes_name);
    try append_ll_line(out, ", 1");
    try append_ll_line(out, "  br label %trim_front_head");
    // Front loop: advance start past leading spaces.
    try append_ll_line(out, "trim_front_head:");
    try append_ll_line(out,
        "  %trim_start = phi i64 [ 0, %entry ], [ %trim_start_next, %trim_front_inc ]");
    try append_ll_line(out, "  %trim_front_cond = icmp slt i64 %trim_start, %trim_bytes_len");
    try append_ll_line(out,
        "  br i1 %trim_front_cond, label %trim_front_body, label %trim_back_head");
    try append_ll_line(out, "trim_front_body:");
    try append_ll_line(out,
        "  %trim_front_ptr = getelementptr i8, ptr %trim_bytes_ptr, i64 %trim_start");
    try append_ll_line(out, "  %trim_front_byte = load i8, ptr %trim_front_ptr");
    try out.append_bytes("  %trim_front_space = call i1 @");
    try compiled_mir_llvm_call::append_callee_symbol(out, stmt.is_ascii_module, stmt.is_ascii_name);
    try append_ll_line(out, "(i8 %trim_front_byte)");
    try append_ll_line(out,
        "  br i1 %trim_front_space, label %trim_front_inc, label %trim_back_head");
    try append_ll_line(out, "trim_front_inc:");
    try append_ll_line(out, "  %trim_start_next = add i64 %trim_start, 1");
    try append_ll_line(out, "  br label %trim_front_head");
    // Back loop: retreat end past trailing spaces.
    try append_ll_line(out, "trim_back_head:");
    try out.append_bytes("  %trim_end = phi i64 [ %trim_bytes_len, %trim_front_head ], ");
    try append_ll_line(out,
        "[ %trim_bytes_len, %trim_front_body ], [ %trim_end_next, %trim_back_inc ]");
    try append_ll_line(out, "  %trim_back_cond = icmp sgt i64 %trim_end, %trim_start");
    try append_ll_line(out,
        "  br i1 %trim_back_cond, label %trim_back_body, label %trim_exit");
    try append_ll_line(out, "trim_back_body:");
    try append_ll_line(out, "  %trim_prev = sub i64 %trim_end, 1");
    try append_ll_line(out,
        "  %trim_back_ptr = getelementptr i8, ptr %trim_bytes_ptr, i64 %trim_prev");
    try append_ll_line(out, "  %trim_back_byte = load i8, ptr %trim_back_ptr");
    try out.append_bytes("  %trim_back_space = call i1 @");
    try compiled_mir_llvm_call::append_callee_symbol(out, stmt.is_ascii_module, stmt.is_ascii_name);
    try append_ll_line(out, "(i8 %trim_back_byte)");
    try append_ll_line(out,
        "  br i1 %trim_back_space, label %trim_back_inc, label %trim_exit");
    try append_ll_line(out, "trim_back_inc:");
    try append_ll_line(out, "  %trim_end_next = sub i64 %trim_end, 1");
    try append_ll_line(out, "  br label %trim_back_head");
    // Exit: return bytes[start..end].
    try append_ll_line(out, "trim_exit:");
    try append_ll_line(out,
        "  %trim_slice_ptr = getelementptr i8, ptr %trim_bytes_ptr, i64 %trim_start");
    try append_ll_line(out, "  %trim_slice_len = sub i64 %trim_end, %trim_start");
    try append_ll_line(out,
        "  %trim_s0 = insertvalue %kizu.slice.u8 poison, ptr %trim_slice_ptr, 0");
    try append_ll_line(out,
        "  %trim_s1 = insertvalue %kizu.slice.u8 %trim_s0, i64 %trim_slice_len, 1");
    try append_ll_line(out, "  ret %kizu.slice.u8 %trim_s1");
    return;
}

// append_multi_ast_node_text renders ast_node_text(text, ast, node_id): it binds the AstNode by
// value off the Ast.get call, extracts the Span (AstNode field 0) and its start/end, slices the
// text two-bound, and forwards the slice to trim_ascii (tracker 961).
// append_advance_position_globals: advance_position forwards only value arguments, so it emits
// no string-constant globals (tracker 961).
fn append_advance_position_globals(stmt: &compiled_mir::MirAdvancePositionStmt) -> !void {
    return;
}

// append_number_token_globals: number_token forwards only value arguments, so it emits no
// string-constant globals (tracker 961).
fn append_number_token_globals(stmt: &compiled_mir::MirNumberTokenStmt) -> !void {
    return;
}

// append_multi_number_token renders number_token(source, start, current): an i64 end phi seeded
// from start that scans forward while end is in bounds and source[end] is a digit (via the
// already-compiled is_digit), then builds the Number Token off token(...) (tracker 961, scope 4
// prerequisite). len(source) is the slice length field read inline as extractvalue field 1.
fn append_multi_number_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirNumberTokenStmt
) -> !void {
    try out.append_bytes("  %nt_length = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %nt_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out, "  br label %nt_head");
    try append_ll_line(out, "nt_head:");
    try out.append_bytes("  %nt_end = phi i64 [ %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", %entry ], [ %nt_next, %nt_body ]");
    try append_ll_line(out, "  %nt_inb = icmp slt i64 %nt_end, %nt_length");
    try append_ll_line(out, "  br i1 %nt_inb, label %nt_check, label %nt_exit");
    try append_ll_line(out, "nt_check:");
    try append_ll_line(out, "  %nt_bptr = getelementptr i8, ptr %nt_source_ptr, i64 %nt_end");
    try append_ll_line(out, "  %nt_byte = load i8, ptr %nt_bptr");
    try out.append_bytes("  %nt_isd = call i1 @");
    try out.append_bytes(stmt.is_digit_symbol);
    try append_ll_line(out, "(i8 %nt_byte)");
    try append_ll_line(out, "  br i1 %nt_isd, label %nt_body, label %nt_exit");
    try append_ll_line(out, "nt_body:");
    try append_ll_line(out, "  %nt_next = add i64 %nt_end, 1");
    try append_ll_line(out, "  br label %nt_head");
    try append_ll_line(out, "nt_exit:");
    try out.append_bytes("  %nt_tok = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_symbol);
    try out.append_bytes("(i64 ");
    try std::fmt::append_i64(out, stmt.number_tag);
    try out.append_bytes(", i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_bytes(", i64 %nt_end, ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.current_name);
    try append_ll_line(out, ")");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %nt_tok");
    return;
}

// append_string_token_globals: string_token forwards only value arguments, so it emits no
// string-constant globals (tracker 961).
fn append_string_token_globals(stmt: &compiled_mir::MirStringTokenStmt) -> !void {
    return;
}

// append_multi_string_token renders string_token(source, start, current): quoted strings scan to
// the closing quote, and double-slash multiline strings scan line-by-line through indented
// continuations.
// Both paths build the String Token directly, matching std/src/kizu/lexer.kizu while keeping the
// selected stage2 helper set unchanged (tracker 961, scope 4 prerequisite). len(source) is the
// slice length field read inline as extractvalue field 1.
fn append_multi_string_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirStringTokenStmt
) -> !void {
    try out.append_bytes("  %st_length = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %st_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try out.append_bytes("  %st_start_next = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 1");
    try append_ll_line(out, "  %st_has_next = icmp slt i64 %st_start_next, %st_length");
    try append_ll_line(out,
        "  br i1 %st_has_next, label %st_check_multiline_pair, label %st_head");
    try append_ll_line(out, "st_check_multiline_pair:");
    try out.append_bytes("  %st_first_ptr = getelementptr i8, ptr %st_source_ptr, i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, "");
    try append_ll_line(out, "  %st_first_byte = load i8, ptr %st_first_ptr");
    try append_ll_line(out, "  %st_first_bs = icmp eq i8 %st_first_byte, 92");
    try append_ll_line(out,
        "  %st_second_ptr = getelementptr i8, ptr %st_source_ptr, i64 %st_start_next");
    try append_ll_line(out, "  %st_second_byte = load i8, ptr %st_second_ptr");
    try append_ll_line(out, "  %st_second_bs = icmp eq i8 %st_second_byte, 92");
    try append_ll_line(out, "  %st_multiline_pair = and i1 %st_first_bs, %st_second_bs");
    try append_ll_line(out,
        "  br i1 %st_multiline_pair, label %st_ml_head, label %st_head");
    try append_quoted_string_token(out, stmt);
    try append_multiline_string_token(out, stmt);
    return;
}

fn append_quoted_string_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirStringTokenStmt
) -> !void {
    try append_ll_line(out, "st_head:");
    try append_ll_line(out, "  %st_end = phi i64 [ %st_start_next, %entry ], [ %st_start_next, %st_check_multiline_pair ], [ %st_next, %st_body ]");
    try append_ll_line(out, "  %st_inb = icmp slt i64 %st_end, %st_length");
    try append_ll_line(out, "  br i1 %st_inb, label %st_check, label %st_exit");
    try append_ll_line(out, "st_check:");
    try append_ll_line(out, "  %st_bptr = getelementptr i8, ptr %st_source_ptr, i64 %st_end");
    try append_ll_line(out, "  %st_byte = load i8, ptr %st_bptr");
    try append_ll_line(out, "  %st_notq = icmp ne i8 %st_byte, 34");
    try append_ll_line(out, "  br i1 %st_notq, label %st_body, label %st_exit");
    try append_ll_line(out, "st_body:");
    try append_ll_line(out, "  %st_next = add i64 %st_end, 1");
    try append_ll_line(out, "  br label %st_head");
    try append_ll_line(out, "st_exit:");
    try append_ll_line(out, "  %st_closed = icmp slt i64 %st_end, %st_length");
    try append_ll_line(out,
        "  br i1 %st_closed, label %st_with_quote, label %st_unterminated");
    try append_ll_line(out, "st_with_quote:");
    try append_ll_line(out, "  %st_endp1 = add i64 %st_end, 1");
    try append_string_token_return(out, stmt, "st_tok_c", "%st_endp1");
    try append_ll_line(out, "st_unterminated:");
    try append_string_token_return(out, stmt, "st_tok_u", "%st_end");
    return;
}

fn append_multiline_string_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirStringTokenStmt
) -> !void {
    try append_ll_line(out, "st_ml_head:");
    try out.append_bytes("  %st_ml_base = phi i64 [ %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", %st_check_multiline_pair ], [ %st_probe, %st_probe_check_second ]");
    try append_ll_line(out, "  %st_ml_after_slashes = add i64 %st_ml_base, 2");
    try append_ll_line(out, "  br label %st_ml_line_head");
    try append_ll_line(out, "st_ml_line_head:");
    try append_ll_line(out, "  %st_ml_end = phi i64 [ %st_ml_after_slashes, %st_ml_head ], [ %st_ml_line_next, %st_ml_line_body ]");
    try append_ll_line(out, "  %st_ml_inb = icmp slt i64 %st_ml_end, %st_length");
    try append_ll_line(out, "  br i1 %st_ml_inb, label %st_ml_line_check, label %st_ml_ret");
    try append_ll_line(out, "st_ml_line_check:");
    try append_ll_line(out, "  %st_ml_ptr = getelementptr i8, ptr %st_source_ptr, i64 %st_ml_end");
    try append_ll_line(out, "  %st_ml_byte = load i8, ptr %st_ml_ptr");
    try append_ll_line(out, "  %st_ml_notnl = icmp ne i8 %st_ml_byte, 10");
    try append_ll_line(out, "  br i1 %st_ml_notnl, label %st_ml_line_body, label %st_probe_init");
    try append_ll_line(out, "st_ml_line_body:");
    try append_ll_line(out, "  %st_ml_line_next = add i64 %st_ml_end, 1");
    try append_ll_line(out, "  br label %st_ml_line_head");
    try append_ll_line(out, "st_probe_init:");
    try append_ll_line(out, "  %st_probe_first = add i64 %st_ml_end, 1");
    try append_ll_line(out, "  br label %st_probe_head");
    try append_ll_line(out, "st_probe_head:");
    try append_ll_line(out, "  %st_probe = phi i64 [ %st_probe_first, %st_probe_init ], [ %st_probe_next, %st_probe_skip ]");
    try append_ll_line(out, "  %st_probe_inb = icmp slt i64 %st_probe, %st_length");
    try append_ll_line(out, "  br i1 %st_probe_inb, label %st_probe_check, label %st_ml_ret");
    try append_ll_line(out, "st_probe_check:");
    try append_ll_line(out, "  %st_probe_ptr = getelementptr i8, ptr %st_source_ptr, i64 %st_probe");
    try append_ll_line(out, "  %st_probe_byte = load i8, ptr %st_probe_ptr");
    try append_ll_line(out, "  %st_probe_space = icmp eq i8 %st_probe_byte, 32");
    try append_ll_line(out, "  %st_probe_tab = icmp eq i8 %st_probe_byte, 9");
    try append_ll_line(out, "  %st_probe_cr = icmp eq i8 %st_probe_byte, 13");
    try append_ll_line(out, "  %st_probe_ws0 = or i1 %st_probe_space, %st_probe_tab");
    try append_ll_line(out, "  %st_probe_ws = or i1 %st_probe_ws0, %st_probe_cr");
    try append_ll_line(out, "  br i1 %st_probe_ws, label %st_probe_skip, label %st_probe_nonspace");
    try append_ll_line(out, "st_probe_skip:");
    try append_ll_line(out, "  %st_probe_next = add i64 %st_probe, 1");
    try append_ll_line(out, "  br label %st_probe_head");
    try append_ll_line(out, "st_probe_nonspace:");
    try append_ll_line(out, "  %st_probe_bs = icmp eq i8 %st_probe_byte, 92");
    try append_ll_line(out, "  br i1 %st_probe_bs, label %st_probe_bound, label %st_ml_ret");
    try append_ll_line(out, "st_probe_bound:");
    try append_ll_line(out, "  %st_probe_second_index = add i64 %st_probe, 1");
    try append_ll_line(out, "  %st_probe_has_second = icmp slt i64 %st_probe_second_index, %st_length");
    try append_ll_line(out,
        "  br i1 %st_probe_has_second, label %st_probe_check_second, label %st_ml_ret");
    try append_ll_line(out, "st_probe_check_second:");
    try append_ll_line(out, "  %st_probe_second_ptr = getelementptr i8, ptr %st_source_ptr, i64 %st_probe_second_index");
    try append_ll_line(out, "  %st_probe_second_byte = load i8, ptr %st_probe_second_ptr");
    try append_ll_line(out, "  %st_probe_second_bs = icmp eq i8 %st_probe_second_byte, 92");
    try append_ll_line(out,
        "  br i1 %st_probe_second_bs, label %st_ml_head, label %st_ml_ret");
    try append_ll_line(out, "st_ml_ret:");
    try append_string_token_return(out, stmt, "st_tok_ml", "%st_ml_end");
    return;
}

// append_string_token_return emits the token(String, start, <end_value>, current) call + ret
// shared by string_token's terminated and unterminated arms (tracker 961, scope 4 prerequisite).
fn append_string_token_return(
    out: &var std::string::String,
    stmt: &compiled_mir::MirStringTokenStmt,
    result_name: []u8,
    end_value: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes(" = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_symbol);
    try out.append_bytes("(i64 ");
    try std::fmt::append_i64(out, stmt.string_tag);
    try out.append_bytes(", i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_bytes(", i64 ");
    try out.append_bytes(end_value);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.current_name);
    try append_ll_line(out, ")");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" %");
    try append_ll_line(out, result_name);
    return;
}

// append_skip_line_comment_globals: skip_line_comment forwards only value arguments, so it emits
// no string-constant globals (tracker 961).
fn append_skip_line_comment_globals(stmt: &compiled_mir::MirSkipLineCommentStmt) -> !void {
    return;
}

// append_multi_skip_line_comment renders skip_line_comment(source, start, initial): a two-phi loop
// threading the i64 end and the Position struct current past a comment line, folding advance_byte
// over each byte while end is in bounds and source[end] is not a newline (byte 10), then building
// the Eof Token at end (tracker 961, scope 4 prerequisite). len(source) is the slice length field
// read inline as extractvalue field 1.
fn append_multi_skip_line_comment(
    out: &var std::string::String,
    stmt: &compiled_mir::MirSkipLineCommentStmt
) -> !void {
    try out.append_bytes("  %slc_length = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %slc_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out, "  br label %slc_head");
    try append_ll_line(out, "slc_head:");
    try out.append_bytes("  %slc_end = phi i64 [ %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", %entry ], [ %slc_next, %slc_body ]");
    try out.append_bytes("  %slc_current = phi ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(stmt.initial_name);
    try append_ll_line(out, ", %entry ], [ %slc_advanced, %slc_body ]");
    try append_ll_line(out, "  %slc_inb = icmp slt i64 %slc_end, %slc_length");
    try append_ll_line(out, "  br i1 %slc_inb, label %slc_check, label %slc_exit");
    try append_ll_line(out, "slc_check:");
    try append_ll_line(out, "  %slc_bptr = getelementptr i8, ptr %slc_source_ptr, i64 %slc_end");
    try append_ll_line(out, "  %slc_byte = load i8, ptr %slc_bptr");
    try append_ll_line(out, "  %slc_notnl = icmp ne i8 %slc_byte, 10");
    try append_ll_line(out, "  br i1 %slc_notnl, label %slc_body, label %slc_exit");
    try append_ll_line(out, "slc_body:");
    try out.append_bytes("  %slc_advanced = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.advance_byte_symbol);
    try out.append_bytes("(i8 %slc_byte, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %slc_current)");
    try append_ll_line(out, "  %slc_next = add i64 %slc_end, 1");
    try append_ll_line(out, "  br label %slc_head");
    try append_ll_line(out, "slc_exit:");
    try out.append_bytes("  %slc_tok = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_symbol);
    try out.append_bytes("(i64 ");
    try std::fmt::append_i64(out, stmt.eof_tag);
    try out.append_bytes(", i64 %slc_end, i64 %slc_end, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %slc_current)");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %slc_tok");
    return;
}

// append_is_doc_comment_start_globals: is_doc_comment_start forwards only value arguments, so it
// emits no string-constant globals (tracker 961).
fn append_is_doc_comment_start_globals(stmt: &compiled_mir::MirIsDocCommentStartStmt) -> !void {
    return;
}

// append_multi_is_doc_comment_start renders is_doc_comment_start(source, start): a bounded branch
// chain returning i1. It bails to false when start + 2 is out of bounds, requires source[start],
// source[start + 1] and source[start + 2] to each be a slash (byte 47), and returns true unless a
// fourth in-bounds slash (start + 3) demotes the run to a non-doc comment (tracker 961, scope 4
// prerequisite). All byte offsets and the slash sentinel are fixed; len(source) is the slice
// length field read inline as extractvalue field 1.
fn append_multi_is_doc_comment_start(
    out: &var std::string::String,
    stmt: &compiled_mir::MirIsDocCommentStartStmt
) -> !void {
    try out.append_bytes("  %dc_length = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %dc_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try out.append_bytes("  %dc_start2 = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 2");
    try append_ll_line(out, "  %dc_oob = icmp sge i64 %dc_start2, %dc_length");
    try append_ll_line(out, "  br i1 %dc_oob, label %dc_false, label %dc_s0");
    try append_ll_line(out, "dc_s0:");
    try out.append_bytes("  %dc_p0 = getelementptr i8, ptr %dc_source_ptr, i64 %");
    try append_ll_line(out, stmt.start_name);
    try append_ll_line(out, "  %dc_b0 = load i8, ptr %dc_p0");
    try append_ll_line(out, "  %dc_is0 = icmp eq i8 %dc_b0, 47");
    try append_ll_line(out, "  br i1 %dc_is0, label %dc_s1, label %dc_false");
    try append_ll_line(out, "dc_s1:");
    try out.append_bytes("  %dc_start1 = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 1");
    try append_ll_line(out, "  %dc_p1 = getelementptr i8, ptr %dc_source_ptr, i64 %dc_start1");
    try append_ll_line(out, "  %dc_b1 = load i8, ptr %dc_p1");
    try append_ll_line(out, "  %dc_is1 = icmp eq i8 %dc_b1, 47");
    try append_ll_line(out, "  br i1 %dc_is1, label %dc_s2, label %dc_false");
    try append_ll_line(out, "dc_s2:");
    try append_ll_line(out, "  %dc_p2 = getelementptr i8, ptr %dc_source_ptr, i64 %dc_start2");
    try append_ll_line(out, "  %dc_b2 = load i8, ptr %dc_p2");
    try append_ll_line(out, "  %dc_is2 = icmp eq i8 %dc_b2, 47");
    try append_ll_line(out, "  br i1 %dc_is2, label %dc_fourth, label %dc_false");
    try append_ll_line(out, "dc_fourth:");
    try out.append_bytes("  %dc_start3 = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 3");
    try append_ll_line(out, "  %dc_oob3 = icmp sge i64 %dc_start3, %dc_length");
    try append_ll_line(out, "  br i1 %dc_oob3, label %dc_true, label %dc_b3");
    try append_ll_line(out, "dc_b3:");
    try append_ll_line(out, "  %dc_p3 = getelementptr i8, ptr %dc_source_ptr, i64 %dc_start3");
    try append_ll_line(out, "  %dc_b3v = load i8, ptr %dc_p3");
    try append_ll_line(out, "  %dc_ne = icmp ne i8 %dc_b3v, 47");
    try append_ll_line(out, "  br i1 %dc_ne, label %dc_true, label %dc_false");
    try append_ll_line(out, "dc_true:");
    try append_ll_line(out, "  ret i1 true");
    try append_ll_line(out, "dc_false:");
    try append_ll_line(out, "  ret i1 false");
    return;
}

// append_word_token_globals emits one private string constant per keyword spelling (plain ASCII,
// no escaping needed), named @.kizu.compiled.<symbol>.kw<i> (tracker 961, scope 4 prerequisite).
fn append_word_token_globals(
    out: &var std::string::String,
    stmt: &compiled_mir::MirWordTokenStmt
) -> !void {
    let kws = &stmt.keywords;
    var index = 0;
    while index < kws.len() {
        let kw = try kws.at(index);
        try out.append_bytes("@.kizu.compiled.");
        try out.append_bytes(stmt.symbol);
        try out.append_bytes(".kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes(" = private unnamed_addr constant [");
        try std::fmt::append_i64(out, std::mem::len(kw.text));
        try out.append_bytes(" x i8] c");
        try out.append_byte(cast<u8>(34));
        try out.append_bytes(kw.text);
        try out.append_byte(cast<u8>(34));
        try out.append_byte(cast<u8>(10));
        index = index + 1;
    }
    return;
}

// append_multi_word_token renders word_token(source, start, current): it scans an identifier run
// (is_word) into an i64 end phi, returns a single-byte Ident when the run is empty, otherwise
// builds the run slice and compares it against each keyword constant via equal_bytes, returning the
// matching keyword Token or a multi-byte Ident fallback (tracker 961, scope 4 prerequisite). The
// keyword globals are emitted by append_word_token_globals; len(source) is the slice length field.
fn append_multi_word_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirWordTokenStmt
) -> !void {
    try out.append_bytes("  %wt_length = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %wt_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out, "  br label %wt_head");
    try append_ll_line(out, "wt_head:");
    try out.append_bytes("  %wt_end = phi i64 [ %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", %entry ], [ %wt_next, %wt_body ]");
    try append_ll_line(out, "  %wt_inb = icmp slt i64 %wt_end, %wt_length");
    try append_ll_line(out, "  br i1 %wt_inb, label %wt_check, label %wt_scan_done");
    try append_ll_line(out, "wt_check:");
    try append_ll_line(out, "  %wt_bptr = getelementptr i8, ptr %wt_source_ptr, i64 %wt_end");
    try append_ll_line(out, "  %wt_byte = load i8, ptr %wt_bptr");
    try out.append_bytes("  %wt_isw = call i1 @");
    try out.append_bytes(stmt.is_word_symbol);
    try append_ll_line(out, "(i8 %wt_byte)");
    try append_ll_line(out, "  br i1 %wt_isw, label %wt_body, label %wt_scan_done");
    try append_ll_line(out, "wt_body:");
    try append_ll_line(out, "  %wt_next = add i64 %wt_end, 1");
    try append_ll_line(out, "  br label %wt_head");
    try append_ll_line(out, "wt_scan_done:");
    try out.append_bytes("  %wt_empty = icmp eq i64 %wt_end, %");
    try append_ll_line(out, stmt.start_name);
    try append_ll_line(out,
        "  br i1 %wt_empty, label %wt_ident_single, label %wt_text_build");
    // Empty run: single-byte Ident at start.
    try append_ll_line(out, "wt_ident_single:");
    try out.append_bytes("  %wt_single_end = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %wt_single_tok = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_symbol);
    try out.append_bytes("(i64 ");
    try std::fmt::append_i64(out, stmt.ident_tag);
    try out.append_bytes(", i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_bytes(", i64 %wt_single_end, ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.current_name);
    try append_ll_line(out, ")");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %wt_single_tok");
    // Build the run slice source[start..end] for the keyword comparisons.
    try append_ll_line(out, "wt_text_build:");
    try out.append_bytes("  %wt_text_ptr = getelementptr i8, ptr %wt_source_ptr, i64 %");
    try append_ll_line(out, stmt.start_name);
    try out.append_bytes("  %wt_text_len = sub i64 %wt_end, %");
    try append_ll_line(out, stmt.start_name);
    try append_ll_line(out,
        "  %wt_text_base = insertvalue %kizu.slice.u8 poison, ptr %wt_text_ptr, 0");
    try append_ll_line(out,
        "  %wt_text = insertvalue %kizu.slice.u8 %wt_text_base, i64 %wt_text_len, 1");
    try append_ll_line(out, "  br label %wt_kw0_check");
    // One comparison block per keyword; the last one's miss target is the multi-byte Ident.
    let kws = &stmt.keywords;
    var index = 0;
    while index < kws.len() {
        let kw = try kws.at(index);
        try out.append_bytes("wt_kw");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, "_check:");
        try out.append_bytes("  %wt_kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_ptr = getelementptr [");
        try std::fmt::append_i64(out, std::mem::len(kw.text));
        try out.append_bytes(" x i8], ptr @.kizu.compiled.");
        try out.append_bytes(stmt.symbol);
        try out.append_bytes(".kw");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, ", i64 0, i64 0");
        try out.append_bytes("  %wt_kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %wt_kw");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, "_ptr, 0");
        try out.append_bytes("  %wt_kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %wt_kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_base, i64 ");
        try std::fmt::append_i64(out, std::mem::len(kw.text));
        try append_ll_line(out, ", 1");
        try out.append_bytes("  %wt_kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_eq = call i1 @");
        try out.append_bytes(stmt.equal_bytes_symbol);
        try out.append_bytes("(%kizu.slice.u8 %wt_text, %kizu.slice.u8 %wt_kw");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, "_slice)");
        try out.append_bytes("  br i1 %wt_kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_eq, label %wt_kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_ret, label %");
        if index + 1 < kws.len() {
            try out.append_bytes("wt_kw");
            try std::fmt::append_i64(out, index + 1);
            try append_ll_line(out, "_check");
        } else {
            try append_ll_line(out, "wt_ident_multi");
        }
        // Per-keyword return block: token(<tag>, start, end, current).
        try out.append_bytes("wt_kw");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, "_ret:");
        try out.append_bytes("  %wt_kw");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_tok = call ");
        try out.append_bytes(stmt.token_type);
        try out.append_bytes(" @");
        try out.append_bytes(stmt.token_symbol);
        try out.append_bytes("(i64 ");
        try std::fmt::append_i64(out, kw.tag);
        try out.append_bytes(", i64 %");
        try out.append_bytes(stmt.start_name);
        try out.append_bytes(", i64 %wt_end, ");
        try out.append_bytes(stmt.position_type);
        try out.append_bytes(" %");
        try out.append_bytes(stmt.current_name);
        try append_ll_line(out, ")");
        try out.append_bytes("  ret ");
        try out.append_bytes(stmt.token_type);
        try out.append_bytes(" %wt_kw");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, "_tok");
        index = index + 1;
    }
    // Multi-byte Ident fallback.
    try append_ll_line(out, "wt_ident_multi:");
    try out.append_bytes("  %wt_ident_tok = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_symbol);
    try out.append_bytes("(i64 ");
    try std::fmt::append_i64(out, stmt.ident_tag);
    try out.append_bytes(", i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_bytes(", i64 %wt_end, ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.current_name);
    try append_ll_line(out, ")");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %wt_ident_tok");
    return;
}

// append_raw_token_globals: raw_token_at forwards only value arguments and inline byte constants,
// so it emits no string-constant globals (tracker 961).
fn append_raw_token_globals(stmt: &compiled_mir::MirRawTokenStmt) -> !void {
    return;
}

// append_raw_op_token emits one operator arm's token(<tag>, start, %op<index>_<end_suffix>,
// current) call + ret, naming the result %op<index>_tok<result_suffix> (tracker 961, scope 4
// prerequisite).
fn append_raw_op_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirRawTokenStmt,
    index: i64,
    result_suffix: []u8,
    tag: i64,
    end_suffix: []u8
) -> !void {
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_tok");
    try out.append_bytes(result_suffix);
    try out.append_bytes(" = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_symbol);
    try out.append_bytes("(i64 ");
    try std::fmt::append_i64(out, tag);
    try out.append_bytes(", i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_bytes(", i64 %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_");
    try out.append_bytes(end_suffix);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.current_name);
    try append_ll_line(out, ")");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_tok");
    try append_ll_line(out, result_suffix);
    return;
}

// append_raw_operator emits one operator dispatch arm: an icmp on the leading byte, then either a
// single-char Token return or a look-ahead chain (two-char / optional third / single fallback).
// The match-miss edge targets the next operator, or rt_dispatch_string for the last one (tracker
// 961, scope 4 prerequisite).
fn append_raw_operator(
    out: &var std::string::String,
    stmt: &compiled_mir::MirRawTokenStmt,
    index: i64,
    op: &compiled_mir::MirOperator,
    is_last: bool
) -> !void {
    try out.append_bytes("op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, ":");
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_is = icmp eq i8 %rt_byte, ");
    try std::fmt::append_i64(out, op.byte);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_is, label %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_m, label %");
    if is_last {
        try append_ll_line(out, "rt_dispatch_string");
    } else {
        try out.append_bytes("op");
        try std::fmt::append_i64(out, index + 1);
        try out.append_byte(cast<u8>(10));
    }
    try out.append_bytes("op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, "_m:");
    if op.second_byte < 0 {
        try out.append_bytes("  %op");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_e1 = add i64 %");
        try out.append_bytes(stmt.start_name);
        try append_ll_line(out, ", 1");
        try append_raw_op_token(out, stmt, index, "s", op.single_tag, "e1");
        return;
    }
    // Two-char-or-single: bounds-check start + 1 before the look-ahead load.
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_n = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_inb = icmp slt i64 %op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, "_n, %rt_length");
    try out.append_bytes("  br i1 %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_inb, label %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_look, label %op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, "_single");
    try out.append_bytes("op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, "_look:");
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_p2 = getelementptr i8, ptr %rt_source_ptr, i64 %op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, "_n");
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_b2 = load i8, ptr %op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, "_p2");
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_is2 = icmp eq i8 %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_b2, ");
    try std::fmt::append_i64(out, op.second_byte);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_is2, label %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_two, label %op");
    try std::fmt::append_i64(out, index);
    if op.third_byte >= 0 {
        try append_ll_line(out, "_third");
    } else {
        try append_ll_line(out, "_single");
    }
    try out.append_bytes("op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, "_two:");
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_e2 = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 2");
    try append_raw_op_token(out, stmt, index, "2", op.two_tag, "e2");
    if op.third_byte >= 0 {
        try out.append_bytes("op");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, "_third:");
        try out.append_bytes("  %op");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_is3 = icmp eq i8 %op");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_b2, ");
        try std::fmt::append_i64(out, op.third_byte);
        try out.append_byte(cast<u8>(10));
        try out.append_bytes("  br i1 %op");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_is3, label %op");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_three, label %op");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, "_single");
        try out.append_bytes("op");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, "_three:");
        try out.append_bytes("  %op");
        try std::fmt::append_i64(out, index);
        try out.append_bytes("_e3 = add i64 %");
        try out.append_bytes(stmt.start_name);
        try append_ll_line(out, ", 2");
        try append_raw_op_token(out, stmt, index, "3", op.third_tag, "e3");
    }
    try out.append_bytes("op");
    try std::fmt::append_i64(out, index);
    try append_ll_line(out, "_single:");
    try out.append_bytes("  %op");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_e1 = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 1");
    try append_raw_op_token(out, stmt, index, "s", op.single_tag, "e1");
    return;
}

// append_raw_dispatch_call emits a 'return <callee>(source, start, current);' tail call + ret for
// the string / number / word fallbacks (tracker 961, scope 4 prerequisite).
fn append_raw_dispatch_call(
    out: &var std::string::String,
    stmt: &compiled_mir::MirRawTokenStmt,
    result: []u8,
    symbol: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(result);
    try out.append_bytes(" = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try out.append_bytes(", i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.current_name);
    try append_ll_line(out, ")");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" %");
    try append_ll_line(out, result);
    return;
}

// append_multi_raw_token renders raw_token_at(source, start, current): an Eof guard, the operator
// dispatch table over the byte at start, then the quote / digit / word fallbacks dispatching to
// string_token / number_token / word_token (tracker 961, scope 4 prerequisite). len(source) is the
// slice length field read inline as extractvalue field 1.
fn append_multi_raw_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirRawTokenStmt
) -> !void {
    try out.append_bytes("  %rt_length = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %rt_eof = icmp sge i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", %rt_length");
    try append_ll_line(out, "  br i1 %rt_eof, label %rt_eof_ret, label %rt_load");
    try append_ll_line(out, "rt_eof_ret:");
    try out.append_bytes("  %rt_eof_tok = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_symbol);
    try out.append_bytes("(i64 ");
    try std::fmt::append_i64(out, stmt.eof_tag);
    try out.append_bytes(", i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_bytes(", i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.current_name);
    try append_ll_line(out, ")");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %rt_eof_tok");
    try append_ll_line(out, "rt_load:");
    try out.append_bytes("  %rt_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try out.append_bytes("  %rt_bptr = getelementptr i8, ptr %rt_source_ptr, i64 %");
    try out.append_bytes(stmt.start_name);
    try out.append_byte(cast<u8>(10));
    try append_ll_line(out, "  %rt_byte = load i8, ptr %rt_bptr");
    try append_ll_line(out, "  br label %op0");
    let ops = &stmt.operators;
    var index = 0;
    while index < ops.len() {
        let op = try ops.at(index);
        var is_last = false;
        if index + 1 == ops.len() {
            is_last = true;
        }
        try append_raw_operator(out, stmt, index, &op, is_last);
        index = index + 1;
    }
    // Fallback dispatch: a double-quote byte (34) or a double-slash multiline prefix goes to
    // string_token, a digit to number_token, and anything else to word_token.
    try append_ll_line(out, "rt_dispatch_string:");
    try append_ll_line(out, "  %rt_isq = icmp eq i8 %rt_byte, 34");
    try append_ll_line(out,
        "  br i1 %rt_isq, label %rt_string, label %rt_dispatch_multiline");
    try append_ll_line(out, "rt_dispatch_multiline:");
    try append_ll_line(out, "  %rt_isbs = icmp eq i8 %rt_byte, 92");
    try append_ll_line(out,
        "  br i1 %rt_isbs, label %rt_check_multiline_bound, label %rt_dispatch_number");
    try append_ll_line(out, "rt_check_multiline_bound:");
    try out.append_bytes("  %rt_next_index = add i64 %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", 1");
    try append_ll_line(out, "  %rt_has_next = icmp slt i64 %rt_next_index, %rt_length");
    try append_ll_line(out,
        "  br i1 %rt_has_next, label %rt_load_multiline_second, label %rt_dispatch_number");
    try append_ll_line(out, "rt_load_multiline_second:");
    try append_ll_line(out,
        "  %rt_next_ptr = getelementptr i8, ptr %rt_source_ptr, i64 %rt_next_index");
    try append_ll_line(out, "  %rt_next_byte = load i8, ptr %rt_next_ptr");
    try append_ll_line(out, "  %rt_is_multiline = icmp eq i8 %rt_next_byte, 92");
    try append_ll_line(out,
        "  br i1 %rt_is_multiline, label %rt_string, label %rt_dispatch_number");
    try append_ll_line(out, "rt_string:");
    try append_raw_dispatch_call(out, stmt, "rt_st", stmt.string_token_symbol);
    try append_ll_line(out, "rt_dispatch_number:");
    try out.append_bytes("  %rt_isd = call i1 @");
    try out.append_bytes(stmt.is_digit_symbol);
    try append_ll_line(out, "(i8 %rt_byte)");
    try append_ll_line(out, "  br i1 %rt_isd, label %rt_number, label %rt_word");
    try append_ll_line(out, "rt_number:");
    try append_raw_dispatch_call(out, stmt, "rt_nt", stmt.number_token_symbol);
    try append_ll_line(out, "rt_word:");
    try append_raw_dispatch_call(out, stmt, "rt_wt", stmt.word_token_symbol);
    return;
}

// append_token_at_globals: token_at forwards only value arguments, so it emits no string-constant
// globals (tracker 961).
fn append_token_at_globals(stmt: &compiled_mir::MirTokenAtStmt) -> !void {
    return;
}

// append_multi_token_at renders token_at(source, offset, initial): an outer loop (start / current /
// has_doc / doc_start / doc_end phis) that skips leading whitespace (inner start / current /
// newlines loop), resets the doc span on a blank line, and consumes line comments while tracking
// the pending doc span; on a non-comment byte it breaks and returns attach_doc(raw_token_at(...),
// doc_start, doc_end). Conditional doc-span updates use select to keep the merge structure flat
// (tracker 961, scope 4 prerequisite). len(source) is the slice length field.
fn append_multi_token_at(
    out: &var std::string::String,
    stmt: &compiled_mir::MirTokenAtStmt
) -> !void {
    try out.append_bytes("  %ta_length = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %ta_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out, "  br label %ta_outer");
    // Outer loop carries start / current / has_doc / doc_start / doc_end; the only back-edge is
    // ta_comment (a consumed line comment), the only entry edge is the function entry.
    try append_ll_line(out, "ta_outer:");
    try out.append_bytes("  %ta_start = phi i64 [ %");
    try out.append_bytes(stmt.offset_name);
    try append_ll_line(out, ", %entry ], [ %ta_skipped_start, %ta_comment ]");
    try out.append_bytes("  %ta_current = phi ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(stmt.initial_name);
    try append_ll_line(out, ", %entry ], [ %ta_cmt_current, %ta_comment ]");
    try out.append_bytes("  %ta_has_doc = phi i1 [ false, %entry ], [ %ta_doc_comment, %ta_comment ]");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %ta_doc_start = phi i64 [ %");
    try out.append_bytes(stmt.offset_name);
    try append_ll_line(out, ", %entry ], [ %ta_cmt_doc_start, %ta_comment ]");
    try out.append_bytes("  %ta_doc_end = phi i64 [ %");
    try out.append_bytes(stmt.offset_name);
    try append_ll_line(out, ", %entry ], [ %ta_skipped_start, %ta_comment ]");
    try append_ll_line(out, "  br label %ta_ws_head");
    // Inner whitespace loop: advance start / current while source[start] is space, counting blank
    // lines (newlines).
    try append_ll_line(out, "ta_ws_head:");
    try append_ll_line(out,
        "  %ta_ws_start = phi i64 [ %ta_start, %ta_outer ], [ %ta_ws_next, %ta_ws_body ]");
    try out.append_bytes("  %ta_ws_current = phi ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " [ %ta_current, %ta_outer ], [ %ta_ws_advanced, %ta_ws_body ]");
    try append_ll_line(out,
        "  %ta_ws_newlines = phi i64 [ 0, %ta_outer ], [ %ta_ws_nl_next, %ta_ws_body ]");
    try append_ll_line(out, "  %ta_ws_inb = icmp slt i64 %ta_ws_start, %ta_length");
    try append_ll_line(out, "  br i1 %ta_ws_inb, label %ta_ws_check, label %ta_ws_done");
    try append_ll_line(out, "ta_ws_check:");
    try append_ll_line(out, "  %ta_ws_bptr = getelementptr i8, ptr %ta_source_ptr, i64 %ta_ws_start");
    try append_ll_line(out, "  %ta_ws_byte = load i8, ptr %ta_ws_bptr");
    try out.append_bytes("  %ta_ws_isspace = call i1 @");
    try out.append_bytes(stmt.is_space_symbol);
    try append_ll_line(out, "(i8 %ta_ws_byte)");
    try append_ll_line(out, "  br i1 %ta_ws_isspace, label %ta_ws_body, label %ta_ws_done");
    try append_ll_line(out, "ta_ws_body:");
    try append_ll_line(out, "  %ta_ws_is_nl = icmp eq i8 %ta_ws_byte, 10");
    try append_ll_line(out, "  %ta_ws_nl_inc = zext i1 %ta_ws_is_nl to i64");
    try append_ll_line(out, "  %ta_ws_nl_next = add i64 %ta_ws_newlines, %ta_ws_nl_inc");
    try out.append_bytes("  %ta_ws_advanced = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.advance_byte_symbol);
    try out.append_bytes("(i8 %ta_ws_byte, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %ta_ws_current)");
    try append_ll_line(out, "  %ta_ws_next = add i64 %ta_ws_start, 1");
    try append_ll_line(out, "  br label %ta_ws_head");
    // After whitespace: reset the doc span on a blank line (newlines > 1) via select, then test
    // for a line comment '//'.
    try append_ll_line(out, "ta_ws_done:");
    try append_ll_line(out, "  %ta_nl_gt1 = icmp sgt i64 %ta_ws_newlines, 1");
    try append_ll_line(out,
        "  %ta_has_doc1 = select i1 %ta_nl_gt1, i1 false, i1 %ta_has_doc");
    try append_ll_line(out,
        "  %ta_doc_start1 = select i1 %ta_nl_gt1, i64 %ta_ws_start, i64 %ta_doc_start");
    try append_ll_line(out,
        "  %ta_doc_end1 = select i1 %ta_nl_gt1, i64 %ta_ws_start, i64 %ta_doc_end");
    try append_ll_line(out, "  %ta_s1 = add i64 %ta_ws_start, 1");
    try append_ll_line(out, "  %ta_s1_inb = icmp slt i64 %ta_s1, %ta_length");
    try append_ll_line(out, "  br i1 %ta_s1_inb, label %ta_check_slashes, label %ta_break");
    try append_ll_line(out, "ta_check_slashes:");
    try append_ll_line(out, "  %ta_b0_ptr = getelementptr i8, ptr %ta_source_ptr, i64 %ta_ws_start");
    try append_ll_line(out, "  %ta_b0 = load i8, ptr %ta_b0_ptr");
    try append_ll_line(out, "  %ta_b0_is = icmp eq i8 %ta_b0, 47");
    try append_ll_line(out, "  br i1 %ta_b0_is, label %ta_check_slash2, label %ta_break");
    try append_ll_line(out, "ta_check_slash2:");
    try append_ll_line(out, "  %ta_b1_ptr = getelementptr i8, ptr %ta_source_ptr, i64 %ta_s1");
    try append_ll_line(out, "  %ta_b1 = load i8, ptr %ta_b1_ptr");
    try append_ll_line(out, "  %ta_b1_is = icmp eq i8 %ta_b1, 47");
    try append_ll_line(out, "  br i1 %ta_b1_is, label %ta_comment, label %ta_break");
    // Consume the comment: detect a doc comment, advance past '//', skip to line end, update the
    // doc span (doc_end is always skipped.start; doc_start/has_doc depend on doc_comment), then
    // loop back to the outer head.
    try append_ll_line(out, "ta_comment:");
    try out.append_bytes("  %ta_doc_comment = call i1 @");
    try out.append_bytes(stmt.is_doc_comment_start_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", i64 %ta_ws_start)");
    try append_ll_line(out, "  %ta_not_has = xor i1 %ta_has_doc1, true");
    try append_ll_line(out, "  %ta_set_doc_start = and i1 %ta_doc_comment, %ta_not_has");
    try append_ll_line(out,
        "  %ta_doc_start2 = select i1 %ta_set_doc_start, i64 %ta_ws_start, i64 %ta_doc_start1");
    try out.append_bytes("  %ta_adv1 = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.advance_byte_symbol);
    try out.append_bytes("(i8 %ta_b0, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %ta_ws_current)");
    try out.append_bytes("  %ta_adv2 = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.advance_byte_symbol);
    try out.append_bytes("(i8 %ta_b1, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %ta_adv1)");
    try append_ll_line(out, "  %ta_skip_start_arg = add i64 %ta_ws_start, 2");
    try out.append_bytes("  %ta_skipped = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.skip_line_comment_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try out.append_bytes(", i64 %ta_skip_start_arg, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %ta_adv2)");
    try out.append_bytes("  %ta_skipped_start = extractvalue ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %ta_skipped, 1");
    try out.append_bytes("  %ta_skipped_line = extractvalue ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %ta_skipped, 3");
    try out.append_bytes("  %ta_skipped_col = extractvalue ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %ta_skipped, 4");
    try append_ll_line(out,
        "  %ta_cmt_doc_start = select i1 %ta_doc_comment, i64 %ta_doc_start2, i64 %ta_skipped_start");
    try out.append_bytes("  %ta_cmt_current = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.position_symbol);
    try append_ll_line(out, "(i64 %ta_skipped_line, i64 %ta_skipped_col)");
    try append_ll_line(out, "  br label %ta_outer");
    // Non-comment byte: finalize the doc span (empty when has_doc is false) and return the token.
    try append_ll_line(out, "ta_break:");
    try append_ll_line(out,
        "  %ta_fin_doc_start = select i1 %ta_has_doc1, i64 %ta_doc_start1, i64 %ta_ws_start");
    try append_ll_line(out,
        "  %ta_fin_doc_end = select i1 %ta_has_doc1, i64 %ta_doc_end1, i64 %ta_ws_start");
    try out.append_bytes("  %ta_raw = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.raw_token_at_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try out.append_bytes(", i64 %ta_ws_start, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %ta_ws_current)");
    try out.append_bytes("  %ta_tok = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.attach_doc_symbol);
    try out.append_bytes("(");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %ta_raw, i64 %ta_fin_doc_start, i64 %ta_fin_doc_end)");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %ta_tok");
    return;
}

// append_first_token_globals: first_token forwards only value arguments, so it emits no
// string-constant globals (tracker 961).
fn append_first_token_globals(stmt: &compiled_mir::MirFirstTokenStmt) -> !void {
    return;
}

// append_multi_first_token renders first_token(source): build the (1, 1) start Position then return
// token_at(source, 0, position) (tracker 961, scope 4 prerequisite).
fn append_multi_first_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirFirstTokenStmt
) -> !void {
    try out.append_bytes("  %ft_pos = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.position_symbol);
    try append_ll_line(out, "(i64 1, i64 1)");
    try out.append_bytes("  %ft_tok = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_at_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try out.append_bytes(", i64 0, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %ft_pos)");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %ft_tok");
    return;
}

// append_next_token_globals: next_token forwards only value arguments, so it emits no
// string-constant globals (tracker 961).
fn append_next_token_globals(stmt: &compiled_mir::MirNextTokenStmt) -> !void {
    return;
}

// append_multi_next_token renders next_token(source, previous): read previous.start / end / line /
// column, advance the Position across the previous token span via advance_position, then return
// token_at(source, previous.end, next) (tracker 961, scope 4 prerequisite). Token fields: start=1,
// end=2, line=3, column=4.
fn append_multi_next_token(
    out: &var std::string::String,
    stmt: &compiled_mir::MirNextTokenStmt
) -> !void {
    try out.append_bytes("  %nt_pstart = extractvalue ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.previous_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %nt_pend = extractvalue ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.previous_name);
    try append_ll_line(out, ", 2");
    try out.append_bytes("  %nt_pline = extractvalue ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.previous_name);
    try append_ll_line(out, ", 3");
    try out.append_bytes("  %nt_pcol = extractvalue ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.previous_name);
    try append_ll_line(out, ", 4");
    try out.append_bytes("  %nt_pos = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.position_symbol);
    try append_ll_line(out, "(i64 %nt_pline, i64 %nt_pcol)");
    try out.append_bytes("  %nt_next = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.advance_position_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try out.append_bytes(", i64 %nt_pstart, i64 %nt_pend, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %nt_pos)");
    try out.append_bytes("  %nt_tok = call ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.token_at_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try out.append_bytes(", i64 %nt_pend, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %nt_next)");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.token_type);
    try append_ll_line(out, " %nt_tok");
    return;
}

// append_array_element_size emits the element byte width as a constant expression derived from the
// element type -- 'ptrtoint (ptr getelementptr (T, ptr null, i32 1) to i64)' -- so Array<T> lowering
// never hardcodes a per-type size (issue 1165: generic Array constructor / append lowering).
fn append_array_element_size(out: &var std::string::String, element_type: []u8) -> !void {
    try out.append_bytes("ptrtoint (ptr getelementptr (");
    try out.append_bytes(element_type);
    try out.append_bytes(", ptr null, i32 1) to i64)");
    return;
}

// append_array_new_globals / append_value_while_globals: these statements forward only runtime calls
// and SSA values, so they emit no string-constant globals (issue 1165).
fn append_array_new_globals(stmt: &compiled_mir::MirArrayNewStmt) -> !void {
    return;
}

fn append_value_while_globals(stmt: &compiled_mir::MirValueWhileStmt) -> !void {
    return;
}

// append_array_new renders 'var <result> = std::array::Array<T>(<allocator>)' as a kizu_rt_array_new
// call whose element width comes from the element type rather than a hardcoded constant (issue 1165).
fn append_array_new(out: &var std::string::String, stmt: &compiled_mir::MirArrayNewStmt) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(stmt.result_name);
    try out.append_bytes(" = call ");
    try out.append_bytes(stmt.owned_type);
    try out.append_bytes(" @kizu_rt_array_new(");
    try out.append_bytes(stmt.owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.allocator_name);
    try out.append_bytes(", i64 ");
    try append_array_element_size(out, stmt.element_type);
    try append_ll_line(out, ")");
    return;
}

// append_value_while_append stores the carried value into the loop var's stack slot, wraps it as a
// {ptr, element_size} slice, and try-appends it into the array. On success it branches to
// <label_base><ok_suffix>; on failure it returns this function's %kizu.error.owned failure early.
// slot_suffix / value_suffix / ok_suffix are appended to label_base / loop_var inline, so no string
// allocation is needed; the prefixes are generalized over the loop var and array names.
fn append_value_while_append(
    out: &var std::string::String,
    stmt: &compiled_mir::MirValueWhileStmt,
    slot_suffix: []u8,
    value_suffix: []u8,
    ok_suffix: []u8
) -> !void {
    try out.append_bytes("  store ");
    try out.append_bytes(stmt.element_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes(value_suffix);
    try out.append_bytes(", ptr %");
    try out.append_bytes(stmt.loop_var);
    try append_ll_line(out, "_slot");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_es0 = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(stmt.loop_var);
    try append_ll_line(out, "_slot, 0");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_eslice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_es0, i64 ");
    try append_array_element_size(out, stmt.element_type);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_app = call ");
    try out.append_bytes(stmt.error_void_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.array_append_symbol);
    try out.append_bytes("(");
    try out.append_bytes(stmt.owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.array_name);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try append_ll_line(out, "_eslice)");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_ok = extractvalue ");
    try out.append_bytes(stmt.error_void_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try append_ll_line(out, "_app, 0");
    try out.append_bytes("  br i1 %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_ok, label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(ok_suffix);
    try out.append_bytes(", label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try append_ll_line(out, "_fail");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try append_ll_line(out, "_fail:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_err = extractvalue ");
    try out.append_bytes(stmt.error_void_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try append_ll_line(out, "_app, 1");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_f0 = insertvalue ");
    try out.append_bytes(stmt.error_owned_type);
    try append_ll_line(out, " poison, i1 false, 0");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_f1 = insertvalue ");
    try out.append_bytes(stmt.error_owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_f0, ");
    try out.append_bytes(stmt.owned_type);
    try append_ll_line(out, " zeroinitializer, 1");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_f2 = insertvalue ");
    try out.append_bytes(stmt.error_owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try out.append_bytes("_f1, %kizu.slice.u8 %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try append_ll_line(out, "_err, 2");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.error_owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes(slot_suffix);
    try append_ll_line(out, "_f2");
    return;
}

// append_value_while renders the value-carried bounded loop: seed the array with init_symbol(source),
// then carry the struct value through a phi, exit when field_index of the value equals eof_tag,
// otherwise recompute it via update_symbol(source, value), try-append, and loop. The done block
// returns the array as the !Array success, subsuming the source's trailing 'return <array>' (issue
// 1165: generic value-carried array loop lowering).
fn append_value_while(out: &var std::string::String, stmt: &compiled_mir::MirValueWhileStmt) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_slot = alloca ");
    try append_ll_line(out, stmt.element_type);
    try out.append_bytes("  %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_init = call ");
    try out.append_bytes(stmt.element_type);
    try out.append_bytes(" @");
    try compiled_signature::append_function_llvm_symbol(out, stmt.init_callee_qualified);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ")");
    // Seed the array with the initial value, then enter the loop head.
    try append_value_while_append(out, stmt, "_seed", "_init", "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.element_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_init, %entry ], [ %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_next, %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_after ]");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_field = extractvalue ");
    try out.append_bytes(stmt.element_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, stmt.field_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_is_eof = icmp eq i64 %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_field, ");
    try std::fmt::append_i64(out, stmt.eof_tag);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_is_eof, label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_done, label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.loop_var);
    try out.append_bytes("_next = call ");
    try out.append_bytes(stmt.element_type);
    try out.append_bytes(" @");
    try compiled_signature::append_function_llvm_symbol(out, stmt.update_callee_qualified);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.element_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.loop_var);
    try append_ll_line(out, ")");
    try append_value_while_append(out, stmt, "_iter", "_next", "_after");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_after:");
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_done:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_ok0 = insertvalue ");
    try out.append_bytes(stmt.error_owned_type);
    try append_ll_line(out, " poison, i1 true, 0");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_ok1 = insertvalue ");
    try out.append_bytes(stmt.error_owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_ok0, ");
    try out.append_bytes(stmt.owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.array_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_ok2 = insertvalue ");
    try out.append_bytes(stmt.error_owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_ok1, %kizu.slice.u8 zeroinitializer, 2");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.error_owned_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_ok2");
    return;
}

// append_grammar_loop renders a 'while true' value-accumulation grammar loop (issue 1157) into a
// preheader/head/branch CFG. The head holds one loop-carried phi for the carried struct value,
// named %<carried_var> so plain Var reads in the conditions and branch calls resolve to it. The
// phi seeds from %<init_name> on the entry edge and from each branch's try-call success on its
// back-edge. Each branch evaluates its boolean predicate (cond_insts) in the head (branch 0) or in
// a guarded <base>_c<i> block, branching to <base>_b<i> when true or to the next predicate /
// <base>_exit when false. A <base>_b<i> body reassigns the carried value through the branch's
// free error-union try-call (reused append_try_call_body, bound to %<carried_var>_b<i> so the phi
// reads it on the try<N>_cont back-edge) then branches back to the head; a failure propagates as
// the function's own error union. The terminal <base>_exit wraps the carried value into
// own_error_union and returns it.
fn append_grammar_loop(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirGrammarLoopStmt
) -> !void {
    let branches = &stmt.branches;
    let branch_count = branches.len();
    if branch_count == 0 {
        return error("compiled mir llvm: grammar loop requires at least one branch");
    }
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    // One loop-carried phi for the carried value: %<init> on the entry edge, %<carried>_b<i> on
    // each branch's try<N>_cont back-edge.
    try out.append_bytes("  %");
    try out.append_bytes(stmt.carried_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.carried_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(stmt.init_name);
    try out.append_bytes(", %entry ]");
    var phi_index = 0;
    while phi_index < branch_count {
        let phi_branch = try branches.at(phi_index);
        let phi_reassign = &phi_branch.reassign;
        try out.append_bytes(", [ %");
        try out.append_bytes(phi_reassign.name);
        try out.append_bytes(", %try");
        try std::fmt::append_i64(out, phi_reassign.try_index);
        try out.append_bytes("_cont ]");
        phi_index = phi_index + 1;
    }
    try out.append_byte(cast<u8>(10));
    // Each branch: evaluate the predicate in the currently-open block, branch to the body or to the
    // next predicate / exit, then render the body try-call and back-edge.
    var index = 0;
    while index < branch_count {
        let branch = try branches.at(index);
        try append_expr_insts(out, function.name, &branch.cond_insts);
        try out.append_bytes("  br i1 ");
        try append_expr_value_ref(out, &branch.cond_insts, branch.cond_result_id);
        try out.append_bytes(", label %");
        try out.append_bytes(stmt.label_base);
        try out.append_bytes("_b");
        try std::fmt::append_i64(out, index);
        try out.append_bytes(", label %");
        try out.append_bytes(stmt.label_base);
        if index + 1 < branch_count {
            try out.append_bytes("_c");
            try std::fmt::append_i64(out, index + 1);
        } else {
            try out.append_bytes("_exit");
        }
        try out.append_byte(cast<u8>(10));
        try out.append_bytes(stmt.label_base);
        try out.append_bytes("_b");
        try std::fmt::append_i64(out, index);
        try append_ll_line(out, ":");
        // The reassignment binds the carried value into %<reassign.name> (baked per branch in the
        // lowering as <carried>_b<i>), which the loop-head phi reads on this branch's try<N>_cont
        // back-edge. An empty bind suffix keeps the bound name exactly reassign.name.
        let reassign = &branch.reassign;
        try append_try_call_body(out, function.name, reassign, "", index + 1);
        try out.append_bytes("  br label %");
        try out.append_bytes(stmt.label_base);
        try append_ll_line(out, "_head");
        if index + 1 < branch_count {
            try out.append_bytes(stmt.label_base);
            try out.append_bytes("_c");
            try std::fmt::append_i64(out, index + 1);
            try append_ll_line(out, ":");
        }
        index = index + 1;
    }
    // Terminal else: return the carried value wrapped into the function's own error union.
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit:");
    try out.append_bytes("  %retwrap_ok = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  %retwrap_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" %retwrap_ok, ");
    try out.append_bytes(stmt.carried_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.carried_var);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %retwrap_val");
    return;
}

fn append_value_cursor_latch_try_pred(
    out: &var std::string::String,
    payload: &compiled_mir::MirLetTryCallStmt
) -> !void {
    try out.append_bytes("%try");
    try std::fmt::append_i64(out, payload.try_index);
    try out.append_bytes("_cont");
    return;
}

fn append_value_cursor_latch_block_pred(
    out: &var std::string::String,
    stmt: &compiled_mir::MirValueCursorWhileStmt
) -> !void {
    try out.append_bytes("%");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_latch");
    return;
}

fn append_value_cursor_latch_pred(
    out: &var std::string::String,
    stmt: &compiled_mir::MirValueCursorWhileStmt
) -> !void {
    let latch = &stmt.latch;
    match latch {
        TryCall(payload) => try append_value_cursor_latch_try_pred(out, payload);,
        FieldRead(payload) => try append_value_cursor_latch_block_pred(out, stmt);,
        PlainCall(payload) => try append_value_cursor_latch_block_pred(out, stmt);,
        _ => return error("compiled mir llvm: value-cursor latch must be try-call or field expr");,
    }
    return;
}

fn append_value_cursor_latch(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirValueCursorWhileStmt,
    local_prefix: i64
) -> !void {
    let latch = &stmt.latch;
    match latch {
        TryCall(payload) => try append_try_call_body(out, function.name, payload, "_next", local_prefix);,
        FieldRead(payload) => try append_while_latch_field_access_let(out, payload);,
        PlainCall(payload) => try append_while_latch_call_body(out, function.name, payload, local_prefix);,
        _ => return error("compiled mir llvm: value-cursor latch must be try-call or field expr");,
    }
    return;
}

// append_value_cursor_while renders a value-carried append-while loop (issue 1157 NEW-A) into a
// head/body/latch/exit CFG. The head holds one loop-carried phi for the value cursor, named
// %<cursor_var> so plain Var reads in the condition, body and latch resolve to it. The phi seeds
// from %<init_name> on the entry edge and from %<cursor>_next on the latch back-edge. The
// condition (the prefix-not bool-predicate call, cond_insts) is evaluated in the head and branches
// to the body when true (loop continues) or to the exit when false. The body statements lower
// through the same per-statement renderer the top level uses, so a borrowed '&var Array' append
// renders as a void try-call; control falls through to the latch block, which reassigns the cursor
// through either a free error-union try-call or a field read from a prior body local, then branches
// back to the head. A try-call failure propagates as the function's own error union. The terminal
// exit wraps the cursor into own_error_union and returns it, subsuming the source's trailing
// 'return <cursor>'.
fn append_value_cursor_while(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirValueCursorWhileStmt
) -> !void {
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    // One loop-carried phi for the value cursor: %<init_name> on the entry edge, %<cursor>_next on
    // the latch edge. A try-call latch uses its tryK_cont block; a field latch falls through from
    // the value-cursor latch block.
    try out.append_bytes("  %");
    try out.append_bytes(stmt.cursor_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.cursor_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(stmt.init_name);
    try out.append_bytes(", %entry ], [ %");
    try out.append_bytes(stmt.cursor_var);
    try out.append_bytes("_next, ");
    try append_value_cursor_latch_pred(out, stmt);
    try append_ll_line(out, " ]");
    try append_expr_insts(out, function.name, &stmt.cond_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
    try out.append_bytes(", label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_body, label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body:");
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_multi_stmt(out, function, body_stmt, body_index + 1);
        body_index = body_index + 1;
    }
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch:");
    // The latch binds the cursor's next value to %<cursor>_next (consumed by the loop-head phi).
    // Try-call latches end in tryK_cont; field-read latches remain in the latch block.
    try append_value_cursor_latch(out, function, stmt, body_stmts.len() + 1);
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    // Terminal exit: return the cursor wrapped into the function's own error union.
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit:");
    if !stmt.terminal_return {
        return;
    }
    try out.append_bytes("  %retwrap_ok = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  %retwrap_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" %retwrap_ok, ");
    try out.append_bytes(stmt.cursor_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.cursor_var);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %retwrap_val");
    return;
}

// append_precedence_loop renders a two-carried-value precedence loop. The preheader runs
// the initial value try-call as %<value>_init, computes %<scalar>_init from that value,
// and branches to the head. The head phis are named as the source locals so condition,
// body, and latch arguments read the carried values naturally. The latch first unwraps the
// next value through a try-call as %<value>_next, then refreshes the scalar through a plain
// call as %<scalar>_next in the actual back-edge predecessor block.
fn append_precedence_loop(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirPrecedenceLoopStmt
) -> !void {
    let value_init = &stmt.value_init;
    let scalar_init = &stmt.scalar_init;
    let value_latch = &stmt.value_latch;
    let scalar_latch = &stmt.scalar_latch;
    try append_try_call_body(out, function.name, value_init, "_init", 0);
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_preheader");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_preheader:");
    try append_call_inst(
        out,
        function.name,
        scalar_init.name,
        scalar_init.llvm_type,
        scalar_init.call_module_prefix,
        scalar_init.call_callee_name,
        &scalar_init.call_args,
        1
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.value_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.value_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(value_init.name);
    try out.append_bytes("_init, %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_preheader ], [ %");
    try out.append_bytes(stmt.value_var);
    try out.append_bytes("_next, %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_scalar ]");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.scalar_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.scalar_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(scalar_init.name);
    try out.append_bytes(", %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_preheader ], [ %");
    try out.append_bytes(scalar_latch.name);
    try out.append_bytes(", %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_scalar ]");
    try append_expr_insts(out, function.name, &stmt.cond_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
    try out.append_bytes(", label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_body, label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body:");
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_multi_stmt(out, function, body_stmt, body_index + 2);
        body_index = body_index + 1;
    }
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_value");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_value:");
    try append_try_call_body(out, function.name, value_latch, "_next", body_stmts.len() + 2);
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_scalar");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_scalar:");
    try append_call_inst(
        out,
        function.name,
        scalar_latch.name,
        scalar_latch.llvm_type,
        scalar_latch.call_module_prefix,
        scalar_latch.call_callee_name,
        &scalar_latch.call_args,
        body_stmts.len() + 3
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit:");
    try out.append_bytes("  %retwrap_ok = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  %retwrap_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" %retwrap_ok, ");
    try out.append_bytes(stmt.value_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.value_var);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %retwrap_val");
    return;
}

// append_dual_cursor_loop renders a two-carried-value cursor loop whose value phi is seeded by a
// copied source SSA value (no value-init call). The entry block seeds the scalar cursor through a
// plain call, the head phis read the copied value source and the scalar init on the preheader edge,
// the body runs its prefix lets, the value latch unwraps the next value through a try-call as
// %<value>_next, and the scalar latch refreshes the scalar through a plain call in the back-edge
// predecessor. The exit block ok-wraps and returns the carried value.
fn append_dual_cursor_loop(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirDualCursorLoopStmt
) -> !void {
    let scalar_init = &stmt.scalar_init;
    let value_latch = &stmt.value_latch;
    let scalar_latch = &stmt.scalar_latch;
    try append_call_inst(
        out,
        function.name,
        scalar_init.name,
        scalar_init.llvm_type,
        scalar_init.call_module_prefix,
        scalar_init.call_callee_name,
        &scalar_init.call_args,
        0
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.value_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.value_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(stmt.value_source_var);
    try out.append_bytes(", %entry ], [ %");
    try out.append_bytes(stmt.value_var);
    try out.append_bytes("_next, %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_scalar ]");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.scalar_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.scalar_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(scalar_init.name);
    try out.append_bytes(", %entry ], [ %");
    try out.append_bytes(scalar_latch.name);
    try out.append_bytes(", %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_scalar ]");
    try append_expr_insts(out, function.name, &stmt.cond_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
    try out.append_bytes(", label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_body, label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body:");
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_multi_stmt(out, function, body_stmt, body_index + 2);
        body_index = body_index + 1;
    }
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_value");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_value:");
    try append_try_call_body(out, function.name, value_latch, "_next", body_stmts.len() + 2);
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_scalar");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch_scalar:");
    try append_call_inst(
        out,
        function.name,
        scalar_latch.name,
        scalar_latch.llvm_type,
        scalar_latch.call_module_prefix,
        scalar_latch.call_callee_name,
        &scalar_latch.call_args,
        body_stmts.len() + 3
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit:");
    try out.append_bytes("  %retwrap_ok = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  %retwrap_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" %retwrap_ok, ");
    try out.append_bytes(stmt.value_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.value_var);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %retwrap_val");
    return;
}

// append_trailing_token_loop renders the dual Token-cursor advance loop (NEW-3 second half). The
// entry block seeds %current through the plain init call; the head holds two same-type Token phis --
// %current (init on the entry edge, %current_next on the body edge) and %previous (init on the entry
// edge, matching 'var previous = current', and %current on the body edge, which IS the copy latch
// 'previous = current'). The compound-AND header is evaluated eagerly and branches to the body or the
// exit. The body advances %current through the plain latch call as %current_next and back-edges to
// the head. The exit block is opened with no terminator: the owning function's post-loop statements
// (lowered as ordinary trailing MirStmts that read the loop-carried %previous/%current phis) render
// straight into it.
fn append_trailing_token_loop(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirTrailingTokenLoopStmt
) -> !void {
    let init = &stmt.init;
    let latch = &stmt.latch;
    try append_call_inst(
        out,
        function.name,
        init.name,
        init.llvm_type,
        init.call_module_prefix,
        init.call_callee_name,
        &init.call_args,
        0
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.current_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(init.name);
    try out.append_bytes(", %entry ], [ %");
    try out.append_bytes(stmt.current_var);
    try out.append_bytes("_next, %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body ]");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.previous_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(init.name);
    try out.append_bytes(", %entry ], [ %");
    try out.append_bytes(stmt.current_var);
    try out.append_bytes(", %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body ]");
    try append_expr_insts(out, function.name, &stmt.cond_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
    try out.append_bytes(", label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_body, label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body:");
    try append_call_inst(
        out,
        function.name,
        latch.name,
        latch.llvm_type,
        latch.call_module_prefix,
        latch.call_callee_name,
        &latch.call_args,
        1
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit:");
    return;
}

// append_type_apply_loop renders parse_type_apply_expr_with_args' bool-literal cursor loop. The
// preheader seeds %current from a plain call, the head holds the Token phi, the body parses one
// type arg through a try-call and appends it, the terminal block renders the child assembly and
// returns, and the guard/latch path either returns the comma error or advances the cursor.
fn append_type_apply_loop(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirTypeApplyLoopStmt
) -> !void {
    let init = &stmt.init;
    let parse_arg = &stmt.parse_arg;
    let latch = &stmt.latch;
    try append_call_inst(
        out,
        function.name,
        init.name,
        init.llvm_type,
        init.call_module_prefix,
        init.call_callee_name,
        &init.call_args,
        0
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.cursor_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.cursor_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(init.name);
    try out.append_bytes(", %entry ], [ %");
    try out.append_bytes(latch.name);
    try out.append_bytes(", %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch ]");
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body:");
    try append_try_call_body(out, function.name, parse_arg, "", 1);
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_multi_stmt(out, function, body_stmt, body_index + 2);
        body_index = body_index + 1;
    }
    try append_expr_insts(out, function.name, &stmt.terminal_cond_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(
        out, &stmt.terminal_cond_insts, stmt.terminal_cond_result_id
    );
    try out.append_bytes(", label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_terminal, label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_guard");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_terminal:");
    let terminal_stmts = &stmt.terminal_stmts;
    var terminal_index = 0;
    while terminal_index < terminal_stmts.len() {
        let terminal_stmt = try terminal_stmts.at(terminal_index);
        try append_multi_stmt(out, function, terminal_stmt, 100 + terminal_index);
        terminal_index = terminal_index + 1;
    }
    if !try while_body_terminates(terminal_stmts) {
        return error("compiled mir llvm: type-apply terminal arm must return");
    }
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_guard:");
    let guard_stmts = &stmt.guard_stmts;
    var guard_index = 0;
    while guard_index < guard_stmts.len() {
        let guard_stmt = try guard_stmts.at(guard_index);
        try append_multi_stmt(out, function, guard_stmt, 200 + guard_index);
        guard_index = guard_index + 1;
    }
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch:");
    try append_call_inst(
        out,
        function.name,
        latch.name,
        latch.llvm_type,
        latch.call_module_prefix,
        latch.call_callee_name,
        &latch.call_args,
        300
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    return;
}

// append_while_match_loop renders a 'while true' + match-dispatch loop (parse_generic_type_end,
// worker-3 NEW-4) into a head/body CFG. The preheader runs the plain-call cursor seed as
// %<init.name>; the head holds one loop-carried phi for the cursor (named %<cursor> so plain Var
// reads in the prefix lets and the dispatch arms resolve to it) seeded from %<init.name> on the
// entry edge and from %<cursor>_next on the latch try-call's tryK_cont block. The body lowers the
// prefix lets through the same per-statement renderer the top level uses (so the leading try-call
// propagates a failure as the function's own error union), evaluates the scrutinee discriminant,
// and runs an exhaustive icmp/br dispatch chain whose last arm is the unconditional fallthrough.
// Each return arm rets through the dispatch-scoped return renderer (arm_scope-suffixed SSA so the
// arm blocks never collide); the single latch arm reassigns the cursor through the shared try-call
// (binding %<cursor>_next in its tryK_cont block) and branches back to the head. The source's
// trailing 'return error(..)' after the loop is unreachable and not emitted, exactly like the
// type-apply loop's.
fn append_while_match_loop(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirWhileMatchLoopStmt
) -> !void {
    let init = &stmt.init;
    let latch = &stmt.latch;
    try append_call_inst(
        out,
        function.name,
        init.name,
        init.llvm_type,
        init.call_module_prefix,
        init.call_callee_name,
        &init.call_args,
        0
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.cursor_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.cursor_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(init.name);
    try out.append_bytes(", %entry ], [ %");
    try out.append_bytes(stmt.cursor_var);
    try out.append_bytes("_next, %try");
    try std::fmt::append_i64(out, latch.try_index);
    try append_ll_line(out, "_cont ]");
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body:");
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_multi_stmt(out, function, body_stmt, body_index + 1);
        body_index = body_index + 1;
    }
    try append_expr_insts(out, function.name, &stmt.scrutinee_insts);
    let arms = &stmt.arms;
    let arm_count = arms.len();
    let dispatch_prefix = 4242;
    var index = 0;
    while index < arm_count {
        if index > 0 {
            try append_dispatch_label(out, dispatch_prefix, "check_", index);
            try append_ll_line(out, ":");
        }
        if index == arm_count - 1 {
            try out.append_bytes("  br label %");
            try append_dispatch_label(out, dispatch_prefix, "arm_", index);
            try out.append_byte(cast<u8>(10));
        } else {
            let arm = try arms.at(index);
            try out.append_bytes("  %");
            try append_dispatch_label(out, dispatch_prefix, "is_", index);
            try out.append_bytes(" = icmp eq i64 ");
            try append_expr_value_ref(out, &stmt.scrutinee_insts, stmt.scrutinee_result_id);
            try out.append_bytes(", ");
            try std::fmt::append_i64(out, arm.tag);
            try out.append_byte(cast<u8>(10));
            try out.append_bytes("  br i1 %");
            try append_dispatch_label(out, dispatch_prefix, "is_", index);
            try out.append_bytes(", label %");
            try append_dispatch_label(out, dispatch_prefix, "arm_", index);
            try out.append_bytes(", label %");
            try append_dispatch_label(out, dispatch_prefix, "check_", index + 1);
            try out.append_byte(cast<u8>(10));
        }
        index = index + 1;
    }
    var arm_index = 0;
    while arm_index < arm_count {
        let arm = try arms.at(arm_index);
        try append_dispatch_label(out, dispatch_prefix, "arm_", arm_index);
        try append_ll_line(out, ":");
        if arm.is_latch {
            try append_try_call_body(
                out, function.name, latch, "_next", dispatch_prefix * 1000 + arm_index
            );
            try out.append_bytes("  br label %");
            try out.append_bytes(stmt.label_base);
            try append_ll_line(out, "_head");
        } else {
            let arm_stmts = &arm.arm_stmts;
            var stmt_index = 0;
            while stmt_index < arm_stmts.len() {
                let arm_stmt = try arm_stmts.at(stmt_index);
                try append_dispatch_arm_return(
                    out, function, arm_stmt, dispatch_prefix * 1000 + arm_index
                );
                stmt_index = stmt_index + 1;
            }
        }
        arm_index = arm_index + 1;
    }
    return;
}

// append_while_match_loop_globals emits the string-literal globals the loop references: the
// plain-call seed args, each prefix-let statement, the scrutinee insts, each return arm's lowered
// return, and the latch try-call (worker-3 NEW-4).
fn append_while_match_loop_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirWhileMatchLoopStmt
) -> !void {
    let init = &stmt.init;
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &init.call_args
    );
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_stmt_globals(out, llvm_symbol, body_stmt);
        body_index = body_index + 1;
    }
    try append_expr_globals(out, llvm_symbol, &stmt.scrutinee_insts);
    let arms = &stmt.arms;
    var arm_index = 0;
    while arm_index < arms.len() {
        let arm = try arms.at(arm_index);
        let arm_stmts = &arm.arm_stmts;
        var stmt_index = 0;
        while stmt_index < arm_stmts.len() {
            let arm_stmt = try arm_stmts.at(stmt_index);
            try append_stmt_globals(out, llvm_symbol, arm_stmt);
            stmt_index = stmt_index + 1;
        }
        arm_index = arm_index + 1;
    }
    try append_let_try_call_globals(out, llvm_symbol, &stmt.latch);
    return;
}

// append_guarded_cursor_loop renders a value-carried cursor loop whose latch is reached only through
// a terminal if/else (parse_type_params' '<T, U>' walk) into a head/body/latch/else/exit CFG. The
// pre-cursor lets were already emitted as top-level statements in entry, so this renderer seeds the
// cursor through the plain init call (%<cursor>_init) and branches to the head. The head holds one
// loop-carried phi for the cursor (named %<cursor> so plain Var reads in the condition, body,
// terminal condition and exit resolve to it) seeded from %<cursor>_init on the entry edge and from
// %<cursor>_next on the latch back-edge. The header predicate (the prefix-not call, cond_insts)
// branches into the body when true (loop continues) or to the normal exit when false. The body
// statements lower through the same per-statement renderer the top level uses; the terminal
// condition then branches to the plain-call latch arm or the else arm. The latch reassigns the
// cursor through the plain call (%<cursor>_next) and back-edges to the head; the else and exit arms
// each run their lowered statements, which end in a return (a struct value reading the cursor phi).
fn append_guarded_cursor_loop(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirGuardedCursorLoopStmt
) -> !void {
    let init = &stmt.init;
    let latch = &stmt.latch;
    // The init shares the entry block with the pre-cursor lets (top-level statements rendered ahead
    // of this one with local_prefix = their statement index), so it takes a high call prefix to keep
    // its arg locals disjoint from theirs; the body/latch/else/exit arms likewise take disjoint
    // prefix bands so no %arg<prefix>_<idx> SSA name repeats across the function.
    try append_call_inst(
        out, function.name, init.name, init.llvm_type, init.call_module_prefix,
        init.call_callee_name, &init.call_args, 700
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.cursor_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(stmt.cursor_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(init.name);
    try out.append_bytes(", %entry ], [ %");
    try out.append_bytes(latch.name);
    try out.append_bytes(", %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch ]");
    try append_expr_insts(out, function.name, &stmt.cond_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
    try out.append_bytes(", label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_body, label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_body:");
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_multi_stmt(out, function, body_stmt, body_index + 100);
        body_index = body_index + 1;
    }
    try append_expr_insts(out, function.name, &stmt.terminal_cond_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.terminal_cond_insts, stmt.terminal_cond_result_id);
    try out.append_bytes(", label %");
    try out.append_bytes(stmt.label_base);
    try out.append_bytes("_latch, label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_else");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_latch:");
    try append_call_inst(
        out, function.name, latch.name, latch.llvm_type, latch.call_module_prefix,
        latch.call_callee_name, &latch.call_args, 300
    );
    try out.append_bytes("  br label %");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_head");
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_else:");
    let else_stmts = &stmt.else_stmts;
    var else_index = 0;
    while else_index < else_stmts.len() {
        let else_stmt = try else_stmts.at(else_index);
        try append_multi_stmt(out, function, else_stmt, 400 + else_index);
        else_index = else_index + 1;
    }
    if !try while_body_terminates(else_stmts) {
        return error("compiled mir llvm: guarded-cursor else arm must return");
    }
    try out.append_bytes(stmt.label_base);
    try append_ll_line(out, "_exit:");
    let exit_stmts = &stmt.exit_stmts;
    var exit_index = 0;
    while exit_index < exit_stmts.len() {
        let exit_stmt = try exit_stmts.at(exit_index);
        try append_multi_stmt(out, function, exit_stmt, 500 + exit_index);
        exit_index = exit_index + 1;
    }
    if !try while_body_terminates(exit_stmts) {
        return error("compiled mir llvm: guarded-cursor exit arm must return");
    }
    return;
}

// append_guarded_cursor_loop_globals emits the string-literal globals the loop references: the
// plain-call seed args, the header condition insts, each body statement, the terminal condition
// insts, the plain-call latch args, and the else/exit return statements.
fn append_guarded_cursor_loop_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirGuardedCursorLoopStmt
) -> !void {
    let init = &stmt.init;
    let latch = &stmt.latch;
    try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &init.call_args);
    try append_expr_globals(out, llvm_symbol, &stmt.cond_insts);
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_stmt_globals(out, llvm_symbol, body_stmt);
        body_index = body_index + 1;
    }
    try append_expr_globals(out, llvm_symbol, &stmt.terminal_cond_insts);
    try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &latch.call_args);
    let else_stmts = &stmt.else_stmts;
    var else_index = 0;
    while else_index < else_stmts.len() {
        let else_stmt = try else_stmts.at(else_index);
        try append_stmt_globals(out, llvm_symbol, else_stmt);
        else_index = else_index + 1;
    }
    let exit_stmts = &stmt.exit_stmts;
    var exit_index = 0;
    while exit_index < exit_stmts.len() {
        let exit_stmt = try exit_stmts.at(exit_index);
        try append_stmt_globals(out, llvm_symbol, exit_stmt);
        exit_index = exit_index + 1;
    }
    return;
}

// append_token_kind_predicate_globals: the predicate forwards only its Token value, so it emits no
// string-constant globals (tracker 961).
fn append_token_kind_predicate_globals(stmt: &compiled_mir::MirTokenKindPredicateStmt) -> !void {
    return;
}

// append_multi_token_kind_predicate renders parser TokenKind predicates by extracting the
// Token.kind field and comparing it to every variant whose match arm returns true. Single-variant
// predicates keep the historical %tkp_is name; multi-variant predicates emit an OR-chain.
fn append_multi_token_kind_predicate(
    out: &var std::string::String,
    stmt: &compiled_mir::MirTokenKindPredicateStmt
) -> !void {
    try out.append_bytes("  %tkp_kind = extractvalue ");
    try out.append_bytes(stmt.token_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.token_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, stmt.kind_field_index);
    try out.append_byte(cast<u8>(10));
    let tags = &stmt.variant_tags;
    if tags.len() == 1 {
        let tag = try tags.get(0);
        try out.append_bytes("  %tkp_is = icmp eq i64 %tkp_kind, ");
        try std::fmt::append_i64(out, tag);
        try out.append_byte(cast<u8>(10));
        try append_ll_line(out, "  ret i1 %tkp_is");
        return;
    }
    let first_tag = try tags.get(0);
    try out.append_bytes("  %tkp_is_0 = icmp eq i64 %tkp_kind, ");
    try std::fmt::append_i64(out, first_tag);
    try out.append_byte(cast<u8>(10));
    var index = 1;
    while index < tags.len() {
        let tag = try tags.get(index);
        try out.append_bytes("  %tkp_cmp_");
        try std::fmt::append_i64(out, index);
        try out.append_bytes(" = icmp eq i64 %tkp_kind, ");
        try std::fmt::append_i64(out, tag);
        try out.append_byte(cast<u8>(10));
        try out.append_bytes("  %tkp_is_");
        try std::fmt::append_i64(out, index);
        try out.append_bytes(" = or i1 %tkp_is_");
        try std::fmt::append_i64(out, index - 1);
        try out.append_bytes(", %tkp_cmp_");
        try std::fmt::append_i64(out, index);
        try out.append_byte(cast<u8>(10));
        index = index + 1;
    }
    try out.append_bytes("  ret i1 %tkp_is_");
    try std::fmt::append_i64(out, tags.len() - 1);
    try out.append_byte(cast<u8>(10));
    return;
}

// append_parser_span_predicate_globals: parser span predicates forward only source/span values.
fn append_parser_span_predicate_globals(stmt: &compiled_mir::MirParserSpanPredicateStmt) -> !void {
    return;
}

fn append_parser_postfix_start_globals(stmt: &compiled_mir::MirParserPostfixStartStmt) -> !void {
    return;
}

fn append_multi_parser_span_predicate(
    out: &var std::string::String,
    stmt: &compiled_mir::MirParserSpanPredicateStmt
) -> !void {
    if stmt.mode == 0 {
        try append_namespace_path_span(out, stmt);
        return;
    }
    try append_struct_literal_type_span(out, stmt);
    return;
}

// append_namespace_path_span renders is_namespace_path_span(source, span): it scans the span,
// accepts name bytes separated by a double-colon, rejects empty segments, and returns true only when at
// least one namespace separator was seen.
fn append_namespace_path_span(
    out: &var std::string::String,
    stmt: &compiled_mir::MirParserSpanPredicateStmt
) -> !void {
    try out.append_bytes("  %nps_start = extractvalue ");
    try out.append_bytes(stmt.span_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.span_name);
    try append_ll_line(out, ", 0");
    try out.append_bytes("  %nps_end = extractvalue ");
    try out.append_bytes(stmt.span_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.span_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %nps_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out, "  br label %nps_loop");
    try append_ll_line(out, "nps_loop:");
    try append_ll_line(out,
        "  %nps_index = phi i64 [ %nps_start, %entry ], [ %nps_name_next, %nps_name ], [ %nps_dc_next, %nps_dc_advance ]");
    try append_ll_line(out,
        "  %nps_need = phi i1 [ true, %entry ], [ false, %nps_name ], [ true, %nps_dc_advance ]");
    try append_ll_line(out,
        "  %nps_saw = phi i1 [ false, %entry ], [ %nps_saw, %nps_name ], [ true, %nps_dc_advance ]");
    try append_ll_line(out, "  %nps_in_span = icmp slt i64 %nps_index, %nps_end");
    try append_ll_line(out, "  br i1 %nps_in_span, label %nps_body, label %nps_exit");
    try append_ll_line(out, "nps_body:");
    try append_ll_line(out, "  %nps_bptr = getelementptr i8, ptr %nps_source_ptr, i64 %nps_index");
    try append_ll_line(out, "  %nps_byte = load i8, ptr %nps_bptr");
    try out.append_bytes("  %nps_name_byte = call i1 @");
    try out.append_bytes(stmt.is_name_symbol);
    try append_ll_line(out, "(i8 %nps_byte)");
    try append_ll_line(out, "  br i1 %nps_name_byte, label %nps_name, label %nps_other");
    try append_ll_line(out, "nps_name:");
    try append_ll_line(out, "  %nps_name_next = add i64 %nps_index, 1");
    try append_ll_line(out, "  br label %nps_loop");
    try append_ll_line(out, "nps_other:");
    try out.append_bytes("  %nps_double_colon = call i1 @");
    try out.append_bytes(stmt.is_double_colon_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", i64 %nps_end, i64 %nps_index)");
    try append_ll_line(out, "  br i1 %nps_double_colon, label %nps_colon, label %nps_false");
    try append_ll_line(out, "nps_colon:");
    try append_ll_line(out, "  br i1 %nps_need, label %nps_false, label %nps_dc_advance");
    try append_ll_line(out, "nps_dc_advance:");
    try append_ll_line(out, "  %nps_dc_next = add i64 %nps_index, 2");
    try append_ll_line(out, "  br label %nps_loop");
    try append_ll_line(out, "nps_exit:");
    try append_ll_line(out, "  br i1 %nps_need, label %nps_false, label %nps_return");
    try append_ll_line(out, "nps_return:");
    try append_ll_line(out, "  ret i1 %nps_saw");
    try append_ll_line(out, "nps_false:");
    try append_ll_line(out, "  ret i1 false");
    return;
}

// append_struct_literal_type_span renders is_struct_literal_type_span(source, span): it scans a
// namespace-style path and applies the parser's capitalization rule for struct literal types.
fn append_struct_literal_type_span(
    out: &var std::string::String,
    stmt: &compiled_mir::MirParserSpanPredicateStmt
) -> !void {
    try out.append_bytes("  %slt_start = extractvalue ");
    try out.append_bytes(stmt.span_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.span_name);
    try append_ll_line(out, ", 0");
    try out.append_bytes("  %slt_end = extractvalue ");
    try out.append_bytes(stmt.span_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.span_name);
    try append_ll_line(out, ", 1");
    try out.append_bytes("  %slt_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out, "  br label %slt_loop");
    try append_ll_line(out, "slt_loop:");
    try append_ll_line(out,
        "  %slt_index = phi i64 [ %slt_start, %entry ], [ %slt_name_next_new, %slt_name_new ], [ %slt_name_next_keep, %slt_name_keep ], [ %slt_dc_next, %slt_dc_advance ]");
    try append_ll_line(out,
        "  %slt_segment = phi i64 [ %slt_start, %entry ], [ %slt_index, %slt_name_new ], [ %slt_segment, %slt_name_keep ], [ %slt_segment, %slt_dc_advance ]");
    try append_ll_line(out,
        "  %slt_previous = phi i64 [ %slt_start, %entry ], [ %slt_segment, %slt_name_new ], [ %slt_previous, %slt_name_keep ], [ %slt_previous, %slt_dc_advance ]");
    try append_ll_line(out,
        "  %slt_count = phi i64 [ 0, %entry ], [ %slt_count_next, %slt_name_new ], [ %slt_count, %slt_name_keep ], [ %slt_count, %slt_dc_advance ]");
    try append_ll_line(out,
        "  %slt_need = phi i1 [ true, %entry ], [ false, %slt_name_new ], [ false, %slt_name_keep ], [ true, %slt_dc_advance ]");
    try append_ll_line(out, "  %slt_in_span = icmp slt i64 %slt_index, %slt_end");
    try append_ll_line(out, "  br i1 %slt_in_span, label %slt_body, label %slt_exit");
    try append_ll_line(out, "slt_body:");
    try append_ll_line(out, "  %slt_bptr = getelementptr i8, ptr %slt_source_ptr, i64 %slt_index");
    try append_ll_line(out, "  %slt_byte = load i8, ptr %slt_bptr");
    try out.append_bytes("  %slt_name_byte = call i1 @");
    try out.append_bytes(stmt.is_name_symbol);
    try append_ll_line(out, "(i8 %slt_byte)");
    try append_ll_line(out, "  br i1 %slt_name_byte, label %slt_name, label %slt_other");
    try append_ll_line(out, "slt_name:");
    try append_ll_line(out, "  br i1 %slt_need, label %slt_name_new, label %slt_name_keep");
    try append_ll_line(out, "slt_name_new:");
    try append_ll_line(out, "  %slt_count_next = add i64 %slt_count, 1");
    try append_ll_line(out, "  %slt_name_next_new = add i64 %slt_index, 1");
    try append_ll_line(out, "  br label %slt_loop");
    try append_ll_line(out, "slt_name_keep:");
    try append_ll_line(out, "  %slt_name_next_keep = add i64 %slt_index, 1");
    try append_ll_line(out, "  br label %slt_loop");
    try append_ll_line(out, "slt_other:");
    try out.append_bytes("  %slt_double_colon = call i1 @");
    try out.append_bytes(stmt.is_double_colon_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", i64 %slt_end, i64 %slt_index)");
    try append_ll_line(out, "  br i1 %slt_double_colon, label %slt_colon, label %slt_false");
    try append_ll_line(out, "slt_colon:");
    try append_ll_line(out, "  br i1 %slt_need, label %slt_false, label %slt_dc_advance");
    try append_ll_line(out, "slt_dc_advance:");
    try append_ll_line(out, "  %slt_dc_next = add i64 %slt_index, 2");
    try append_ll_line(out, "  br label %slt_loop");
    try append_ll_line(out, "slt_exit:");
    try append_ll_line(out, "  br i1 %slt_need, label %slt_false, label %slt_check_last");
    try append_ll_line(out, "slt_check_last:");
    try append_ll_line(out, "  %slt_last_ptr = getelementptr i8, ptr %slt_source_ptr, i64 %slt_segment");
    try append_ll_line(out, "  %slt_last_byte = load i8, ptr %slt_last_ptr");
    try out.append_bytes("  %slt_last_upper = call i1 @");
    try out.append_bytes(stmt.is_upper_symbol);
    try append_ll_line(out, "(i8 %slt_last_byte)");
    try append_ll_line(out, "  br i1 %slt_last_upper, label %slt_check_previous, label %slt_false");
    try append_ll_line(out, "slt_check_previous:");
    try append_ll_line(out, "  %slt_multiple = icmp sgt i64 %slt_count, 1");
    try append_ll_line(out, "  br i1 %slt_multiple, label %slt_prev, label %slt_true");
    try append_ll_line(out, "slt_prev:");
    try append_ll_line(out, "  %slt_prev_ptr = getelementptr i8, ptr %slt_source_ptr, i64 %slt_previous");
    try append_ll_line(out, "  %slt_prev_byte = load i8, ptr %slt_prev_ptr");
    try out.append_bytes("  %slt_prev_upper = call i1 @");
    try out.append_bytes(stmt.is_upper_symbol);
    try append_ll_line(out, "(i8 %slt_prev_byte)");
    try append_ll_line(out, "  br i1 %slt_prev_upper, label %slt_false, label %slt_true");
    try append_ll_line(out, "slt_true:");
    try append_ll_line(out, "  ret i1 true");
    try append_ll_line(out, "slt_false:");
    try append_ll_line(out, "  ret i1 false");
    return;
}

// append_multi_parser_postfix_start renders is_type_apply_start / is_struct_literal_start by
// guarding on left.next, then asking Ast.get(left.node) for the source span to classify.
fn append_multi_parser_postfix_start(
    out: &var std::string::String,
    stmt: &compiled_mir::MirParserPostfixStartStmt
) -> !void {
    try out.append_bytes("  %pps_next = extractvalue ");
    try out.append_bytes(stmt.left_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.left_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, stmt.next_field_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %pps_guard = call i1 @");
    try out.append_bytes(stmt.guard_symbol);
    if stmt.mode == 0 {
        try out.append_bytes("(");
        try out.append_bytes(stmt.token_type);
        try append_ll_line(out, " %pps_next)");
    } else {
        try out.append_bytes("(%kizu.slice.u8 %");
        try out.append_bytes(stmt.text_name);
        try out.append_bytes(", ");
        try out.append_bytes(stmt.token_type);
        try append_ll_line(out, " %pps_next, i8 123)");
    }
    try append_ll_line(out, "  br i1 %pps_guard, label %pps_node, label %pps_false");
    try append_ll_line(out, "pps_node:");
    try out.append_bytes("  %pps_node_id = extractvalue ");
    try out.append_bytes(stmt.left_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.left_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, stmt.node_field_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %pps_ast_node = call ");
    try out.append_bytes(stmt.ast_node_type);
    try out.append_bytes(" @kizu_kizu__ast_ast_get(");
    try out.append_bytes(stmt.ast_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.ast_name);
    try append_ll_line(out, ", %kizu.kizu.ast.node_id %pps_node_id)");
    try out.append_bytes("  %pps_span = extractvalue ");
    try out.append_bytes(stmt.ast_node_type);
    try out.append_bytes(" %pps_ast_node, ");
    try std::fmt::append_i64(out, stmt.ast_node_span_field_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %pps_result = call i1 @");
    try out.append_bytes(stmt.span_symbol);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(stmt.text_name);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.span_type);
    try append_ll_line(out, " %pps_span)");
    try append_ll_line(out, "  ret i1 %pps_result");
    try append_ll_line(out, "pps_false:");
    try append_ll_line(out, "  ret i1 false");
    return;
}

// append_multi_advance_position renders advance_position(source, start, end, initial): a two-phi
// loop threading the i64 index (seeded from start) and the Position struct current (seeded from
// initial). Each iteration loads source[index] as an i8 and feeds it with current into the
// already-compiled advance_byte, whose Position result becomes the next current; the loop exits
// when index reaches end and returns the final current (tracker 961, scope 4 prerequisite).
fn append_multi_advance_position(
    out: &var std::string::String,
    stmt: &compiled_mir::MirAdvancePositionStmt
) -> !void {
    try out.append_bytes("  %ap_source_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.source_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out, "  br label %ap_loop_head");
    try append_ll_line(out, "ap_loop_head:");
    try out.append_bytes("  %ap_index = phi i64 [ %");
    try out.append_bytes(stmt.start_name);
    try append_ll_line(out, ", %entry ], [ %ap_index_next, %ap_loop_body ]");
    try out.append_bytes("  %ap_current = phi ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(stmt.initial_name);
    try append_ll_line(out, ", %entry ], [ %ap_next, %ap_loop_body ]");
    try out.append_bytes("  %ap_cond = icmp slt i64 %ap_index, %");
    try append_ll_line(out, stmt.end_name);
    try append_ll_line(out,
        "  br i1 %ap_cond, label %ap_loop_body, label %ap_loop_exit");
    try append_ll_line(out, "ap_loop_body:");
    try append_ll_line(out,
        "  %ap_byte_ptr = getelementptr i8, ptr %ap_source_ptr, i64 %ap_index");
    try append_ll_line(out, "  %ap_byte = load i8, ptr %ap_byte_ptr");
    try out.append_bytes("  %ap_next = call ");
    try out.append_bytes(stmt.position_type);
    try out.append_bytes(" @");
    try out.append_bytes(stmt.advance_byte_symbol);
    try out.append_bytes("(i8 %ap_byte, ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %ap_current)");
    try append_ll_line(out, "  %ap_index_next = add i64 %ap_index, 1");
    try append_ll_line(out, "  br label %ap_loop_head");
    try append_ll_line(out, "ap_loop_exit:");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.position_type);
    try append_ll_line(out, " %ap_current");
    return;
}

fn append_multi_ast_node_text(
    out: &var std::string::String,
    stmt: &compiled_mir::MirAstNodeTextStmt
) -> !void {
    try out.append_bytes("  %ant_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(");
    try out.append_bytes(stmt.ast_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.ast_name);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.node_id_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.node_id_name);
    try append_ll_line(out, ")");
    try append_ll_line(out, "  %ant_span = extractvalue %kizu.kizu.ast.ast_node %ant_node, 0");
    try append_ll_line(out, "  %ant_start = extractvalue %kizu.kizu.ast.span %ant_span, 0");
    try append_ll_line(out, "  %ant_end = extractvalue %kizu.kizu.ast.span %ant_span, 1");
    try out.append_bytes("  %ant_text_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.text_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out,
        "  %ant_slice_ptr = getelementptr i8, ptr %ant_text_ptr, i64 %ant_start");
    try append_ll_line(out, "  %ant_slice_len = sub i64 %ant_end, %ant_start");
    try append_ll_line(out,
        "  %ant_s0 = insertvalue %kizu.slice.u8 poison, ptr %ant_slice_ptr, 0");
    try append_ll_line(out, "  %ant_s1 = insertvalue %kizu.slice.u8 %ant_s0, i64 %ant_slice_len, 1");
    try out.append_bytes("  %ant_trimmed = call %kizu.slice.u8 @");
    try compiled_mir_llvm_call::append_callee_symbol(out, stmt.trim_module, stmt.trim_name);
    try append_ll_line(out, "(%kizu.slice.u8 %ant_s1)");
    try append_ll_line(out, "  ret %kizu.slice.u8 %ant_trimmed");
    return;
}

// append_string_literal_span_globals: string_literal_span forwards only value arguments, so it
// emits no string-constant globals (tracker 961).
fn append_string_literal_span_globals(stmt: &compiled_mir::MirStringLiteralSpanStmt) -> !void {
    return;
}

// append_multi_string_literal_span renders string_literal_span(text, ast, node_id): it binds the
// AstNode off Ast.get, extracts the Span (AstNode field 0) start/end, rejects spans shorter than
// the two surrounding quotes, checks the leading/trailing double-quote bytes (34), forwards the
// inner payload slice to is_payload_supported, and returns the PayloadSpan { start, end } on
// success or the shared empty_payload_span() sentinel otherwise (tracker 961, scope 4
// prerequisite). The leading/trailing byte indexes are in bounds whenever length >= 2, so they
// use direct loads matching the trim_ascii / ast_node_text dedicated-renderer convention.
fn append_multi_string_literal_span(
    out: &var std::string::String,
    stmt: &compiled_mir::MirStringLiteralSpanStmt
) -> !void {
    try out.append_bytes("  %sls_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(");
    try out.append_bytes(stmt.ast_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.ast_name);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.node_id_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.node_id_name);
    try append_ll_line(out, ")");
    try append_ll_line(out, "  %sls_span = extractvalue %kizu.kizu.ast.ast_node %sls_node, 0");
    try append_ll_line(out, "  %sls_start = extractvalue %kizu.kizu.ast.span %sls_span, 0");
    try append_ll_line(out, "  %sls_end = extractvalue %kizu.kizu.ast.span %sls_span, 1");
    try append_ll_line(out, "  %sls_length = sub i64 %sls_end, %sls_start");
    try append_ll_line(out, "  %sls_too_short = icmp slt i64 %sls_length, 2");
    try append_ll_line(out,
        "  br i1 %sls_too_short, label %sls_empty, label %sls_check_quotes");
    // Check the surrounding double-quote bytes: literal[0] and literal[length-1].
    try append_ll_line(out, "sls_check_quotes:");
    try out.append_bytes("  %sls_text_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.text_name);
    try append_ll_line(out, ", 0");
    try append_ll_line(out,
        "  %sls_first_ptr = getelementptr i8, ptr %sls_text_ptr, i64 %sls_start");
    try append_ll_line(out, "  %sls_first = load i8, ptr %sls_first_ptr");
    try append_ll_line(out, "  %sls_last_idx = sub i64 %sls_end, 1");
    try append_ll_line(out,
        "  %sls_last_ptr = getelementptr i8, ptr %sls_text_ptr, i64 %sls_last_idx");
    try append_ll_line(out, "  %sls_last = load i8, ptr %sls_last_ptr");
    try append_ll_line(out, "  %sls_first_q = icmp eq i8 %sls_first, 34");
    try append_ll_line(out, "  %sls_last_q = icmp eq i8 %sls_last, 34");
    try append_ll_line(out, "  %sls_both_q = and i1 %sls_first_q, %sls_last_q");
    try append_ll_line(out, "  br i1 %sls_both_q, label %sls_payload, label %sls_empty");
    // Inner payload slice text[start+1..end-1] forwarded to is_payload_supported.
    try append_ll_line(out, "sls_payload:");
    try append_ll_line(out, "  %sls_payload_start = add i64 %sls_start, 1");
    try append_ll_line(out, "  %sls_payload_end = sub i64 %sls_end, 1");
    try append_ll_line(out,
        "  %sls_payload_ptr = getelementptr i8, ptr %sls_text_ptr, i64 %sls_payload_start");
    try append_ll_line(out, "  %sls_payload_len = sub i64 %sls_payload_end, %sls_payload_start");
    try append_ll_line(out,
        "  %sls_p0 = insertvalue %kizu.slice.u8 poison, ptr %sls_payload_ptr, 0");
    try append_ll_line(out, "  %sls_p1 = insertvalue %kizu.slice.u8 %sls_p0, i64 %sls_payload_len, 1");
    try out.append_bytes("  %sls_supported = call i1 @");
    try compiled_mir_llvm_call::append_callee_symbol(out, stmt.callee_module, stmt.is_payload_name);
    try append_ll_line(out, "(%kizu.slice.u8 %sls_p1)");
    try append_ll_line(out, "  br i1 %sls_supported, label %sls_ok, label %sls_empty");
    // Success: return the trimmed PayloadSpan { payload_start, payload_end }.
    try append_ll_line(out, "sls_ok:");
    try append_ll_line(out,
        "  %sls_r0 = insertvalue %kizu.selfhost.codegen.payload_span poison, i64 %sls_payload_start, 0");
    try append_ll_line(out,
        "  %sls_r1 = insertvalue %kizu.selfhost.codegen.payload_span %sls_r0, i64 %sls_payload_end, 1");
    try append_ll_line(out, "  ret %kizu.selfhost.codegen.payload_span %sls_r1");
    // Failure: forward the shared empty_payload_span() sentinel.
    try append_ll_line(out, "sls_empty:");
    try out.append_bytes("  %sls_empty_call = call %kizu.selfhost.codegen.payload_span @");
    try compiled_mir_llvm_call::append_callee_symbol(out, stmt.callee_module, stmt.empty_name);
    try append_ll_line(out, "()");
    try append_ll_line(out, "  ret %kizu.selfhost.codegen.payload_span %sls_empty_call");
    return;
}

// append_count_range_globals: count_range forwards only value arguments, so no string globals.
fn append_count_range_globals(stmt: &compiled_mir::MirCountRangeStmt) -> !void {
    return;
}

// append_multi_count_range renders count_range as a two-phi accumulator loop (count + index):
// it reads range.len, and each iteration calls the checked Ast.child_at and the recursive
// node_count, propagating either error union as this function's own !i64 failure, and on the
// exhausted loop returns the accumulated count wrapped as the success (tracker 961).
fn append_multi_count_range(
    out: &var std::string::String,
    stmt: &compiled_mir::MirCountRangeStmt
) -> !void {
    try out.append_bytes("  %range_len = extractvalue %kizu.kizu.ast.child_range %");
    try out.append_bytes(stmt.range_name);
    try append_ll_line(out, ", 1");
    try append_ll_line(out, "  br label %count_head");
    try append_ll_line(out, "count_head:");
    try append_ll_line(out,
        "  %count = phi i64 [ 0, %entry ], [ %count_next, %count_nc_cont ]");
    try append_ll_line(out,
        "  %index = phi i64 [ 0, %entry ], [ %index_next, %count_nc_cont ]");
    try append_ll_line(out, "  %count_cond = icmp slt i64 %index, %range_len");
    try append_ll_line(out,
        "  br i1 %count_cond, label %count_body, label %count_exit");
    // Body: child = try tree.child_at(range, index).
    try append_ll_line(out, "count_body:");
    try out.append_bytes("  %child_call = call %kizu.error.node_id @kizu_kizu__ast_ast_child_at(");
    try out.append_bytes(stmt.receiver_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.receiver_name);
    try out.append_bytes(", %kizu.kizu.ast.child_range %");
    try out.append_bytes(stmt.range_name);
    try append_ll_line(out, ", i64 %index)");
    try append_ll_line(out, "  %child_ok = extractvalue %kizu.error.node_id %child_call, 0");
    try append_ll_line(out,
        "  br i1 %child_ok, label %count_child_cont, label %count_child_fail");
    try append_ll_line(out, "count_child_fail:");
    try append_ll_line(out, "  %child_msg = extractvalue %kizu.error.node_id %child_call, 2");
    try out.append_bytes("  %child_fail_flag = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 false, 0");
    try out.append_bytes("  %child_fail_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %child_fail_flag, %kizu.slice.u8 %child_msg, 2");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %child_fail_val");
    // child success: nc = try node_count(tree, child).
    try append_ll_line(out, "count_child_cont:");
    try append_ll_line(out, "  %child = extractvalue %kizu.error.node_id %child_call, 1");
    try out.append_bytes("  %nc_call = call ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, stmt.node_count_module, stmt.node_count_name
    );
    try out.append_bytes("(");
    try out.append_bytes(stmt.receiver_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.receiver_name);
    try append_ll_line(out, ", %kizu.kizu.ast.node_id %child)");
    try out.append_bytes("  %nc_ok = extractvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %nc_call, 0");
    try append_ll_line(out,
        "  br i1 %nc_ok, label %count_nc_cont, label %count_nc_fail");
    try append_ll_line(out, "count_nc_fail:");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %nc_call");
    // nc success: count_next = count + nc; index_next = index + 1; loop back.
    try append_ll_line(out, "count_nc_cont:");
    try out.append_bytes("  %nc = extractvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %nc_call, 1");
    try append_ll_line(out, "  %count_next = add i64 %count, %nc");
    try append_ll_line(out, "  %index_next = add i64 %index, 1");
    try append_ll_line(out, "  br label %count_head");
    // Exit: return the accumulated count wrapped as the error-union success.
    try append_ll_line(out, "count_exit:");
    try out.append_bytes("  %count_ret_flag = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 true, 0");
    try out.append_bytes("  %count_ret_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %count_ret_flag, i64 %count, 1");
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " %count_ret_val");
    return;
}

// append_match_traversal_globals: a node_count traversal arm forwards only the receiver and
// payload-field arguments (no string literals), so there are no string-constant globals.
fn append_match_traversal_globals(stmt: &compiled_mir::MirMatchTraversalStmt) -> !void {
    return;
}

// append_multi_match_traversal renders the node_count recursive AST-traversal accessor: it
// binds the AstNode by value off the Ast.get call, extracts the AstData union + i64 tag, and
// emits an exhaustive icmp/br chain over the arms. Each arm returns a real value: a try-call
// arm extracts the variant payload, forwards the receiver + payload fields to count_*, and
// returns its (identically-typed) error union directly; a leaf arm returns the literal wrapped
// as the error-union success. No arm is 'unreachable' (tracker 961).
fn append_multi_match_traversal(
    out: &var std::string::String,
    stmt: &compiled_mir::MirMatchTraversalStmt
) -> !void {
    try out.append_bytes("  %match_node = call %kizu.kizu.ast.ast_node @kizu_kizu__ast_ast_get(");
    try out.append_bytes(stmt.receiver_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.receiver_name);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.index_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.index_name);
    try append_ll_line(out, ")");
    try out.append_bytes("  %match_data = extractvalue %kizu.kizu.ast.ast_node %match_node, ");
    try std::fmt::append_i64(out, stmt.data_field_index);
    try out.append_byte(cast<u8>(10));
    try append_ll_line(out, "  %match_tag = extractvalue %kizu.kizu.ast.ast_data %match_data, 0");
    let arms = &stmt.arms;
    let arm_count = arms.len();
    // Phase 1: the icmp/br dispatch chain. The last arm is the exhaustive fallthrough.
    var index = 0;
    while index < arm_count {
        let arm = try arms.at(index);
        if index > 0 {
            try out.append_bytes("match_check_");
            try std::fmt::append_i64(out, index);
            try append_ll_line(out, ":");
        }
        if index == arm_count - 1 {
            try out.append_bytes("  br label %match_arm_");
            try std::fmt::append_i64(out, index);
            try out.append_byte(cast<u8>(10));
        } else {
            try out.append_bytes("  %match_is_");
            try std::fmt::append_i64(out, index);
            try out.append_bytes(" = icmp eq i64 %match_tag, ");
            try std::fmt::append_i64(out, arm.tag);
            try out.append_byte(cast<u8>(10));
            try out.append_bytes("  br i1 %match_is_");
            try std::fmt::append_i64(out, index);
            try out.append_bytes(", label %match_arm_");
            try std::fmt::append_i64(out, index);
            try out.append_bytes(", label %match_check_");
            try std::fmt::append_i64(out, index + 1);
            try out.append_byte(cast<u8>(10));
        }
        index = index + 1;
    }
    // Phase 2: the arm blocks, each returning a real value.
    var arm_index = 0;
    while arm_index < arm_count {
        let arm = try arms.at(arm_index);
        try append_traversal_arm_block(out, stmt, arm, arm_index);
        arm_index = arm_index + 1;
    }
    return;
}

fn append_traversal_arm_block(
    out: &var std::string::String,
    stmt: &compiled_mir::MirMatchTraversalStmt,
    arm: &compiled_mir::MirTraversalArm,
    arm_index: i64
) -> !void {
    try out.append_bytes("match_arm_");
    try std::fmt::append_i64(out, arm_index);
    try append_ll_line(out, ":");
    if arm.is_literal {
        // A plain (non-error-union) return type returns the literal directly; an
        // error-union return wraps it as the success value.
        if !is_error_union_type(stmt.own_error_union) {
            try out.append_bytes("  ret ");
            try out.append_bytes(stmt.own_error_union);
            try out.append_bytes(" ");
            try append_traversal_literal_text(out, arm);
            try out.append_byte(cast<u8>(10));
            return;
        }
        try out.append_bytes("  %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try out.append_bytes("_flag = insertvalue ");
        try out.append_bytes(stmt.own_error_union);
        try append_ll_line(out, " zeroinitializer, i1 true, 0");
        try out.append_bytes("  %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try out.append_bytes("_val = insertvalue ");
        try out.append_bytes(stmt.own_error_union);
        try out.append_bytes(" %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try out.append_bytes("_flag, ");
        try out.append_bytes(arm.literal_llvm);
        try out.append_bytes(" ");
        try append_traversal_literal_text(out, arm);
        try append_ll_line(out, ", 1");
        try out.append_bytes("  ret ");
        try out.append_bytes(stmt.own_error_union);
        try out.append_bytes(" %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try append_ll_line(out, "_val");
        return;
    }
    // Extract the variant payload out of the inline union storage only when an arg
    // actually reads a payload field (a default '_' arm or a params-only arm skips it).
    let args = &arm.args;
    let arg_count = args.len();
    var field_arg_count = 0;
    var probe_index = 0;
    while probe_index < arg_count {
        let probe_arg = try args.at(probe_index);
        if !probe_arg.is_param and !probe_arg.is_literal {
            field_arg_count = field_arg_count + 1;
        }
        probe_index = probe_index + 1;
    }
    if field_arg_count > 0 {
        try out.append_bytes("  %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try append_ll_line(out, "_slot = alloca %kizu.kizu.ast.ast_data, align 8");
        try out.append_bytes("  store %kizu.kizu.ast.ast_data %match_data, ptr %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try append_ll_line(out, "_slot, align 8");
        try out.append_bytes("  %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try out.append_bytes("_ptr = getelementptr %kizu.kizu.ast.ast_data, ptr %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try append_ll_line(out, "_slot, i32 0, i32 1");
        try out.append_bytes("  %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try out.append_bytes("_payload = load ");
        try out.append_bytes(arm.payload_type);
        try out.append_bytes(", ptr %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try append_ll_line(out, "_ptr, align 8");
        // Extract each forwarded payload field.
        var arg_index = 0;
        while arg_index < arg_count {
            let arg = try args.at(arg_index);
            if !arg.is_param and !arg.is_literal {
                try out.append_bytes("  %match_arm_");
                try std::fmt::append_i64(out, arm_index);
                try out.append_bytes("_a");
                try std::fmt::append_i64(out, arg_index);
                try out.append_bytes(" = extractvalue ");
                try out.append_bytes(arm.payload_type);
                try out.append_bytes(" %match_arm_");
                try std::fmt::append_i64(out, arm_index);
                try out.append_bytes("_payload, ");
                try std::fmt::append_i64(out, arg.field_index);
                try out.append_byte(cast<u8>(10));
            }
            arg_index = arg_index + 1;
        }
    }
    // Call the arm callee with every argument rendered explicitly: a parameter arg
    // forwards the caller's value by name, a payload arg reads its extracted field.
    let call_result_type = traversal_arm_call_type(stmt, arm);
    try out.append_bytes("  %match_arm_");
    try std::fmt::append_i64(out, arm_index);
    try out.append_bytes("_call = call ");
    try out.append_bytes(call_result_type);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(out, arm.callee_module, arm.callee_name);
    try out.append_bytes("(");
    var call_arg_index = 0;
    while call_arg_index < arg_count {
        let arg = try args.at(call_arg_index);
        if call_arg_index > 0 {
            try out.append_bytes(", ");
        }
        try out.append_bytes(arg.arg_llvm_type);
        try out.append_bytes(" ");
        if arg.is_literal {
            try std::fmt::append_i64(out, arg.literal_value);
        } else {
            try out.append_bytes("%");
            if arg.is_param {
                try out.append_bytes(arg.param_name);
            } else {
                try out.append_bytes("match_arm_");
                try std::fmt::append_i64(out, arm_index);
                try out.append_bytes("_a");
                try std::fmt::append_i64(out, call_arg_index);
            }
        }
        call_arg_index = call_arg_index + 1;
    }
    try append_ll_line(out, ")");
    if arm.is_plain_call {
        // Wrap the plain call's success value into the own error union and return it.
        try out.append_bytes("  %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try out.append_bytes("_flag = insertvalue ");
        try out.append_bytes(stmt.own_error_union);
        try append_ll_line(out, " zeroinitializer, i1 true, 0");
        try out.append_bytes("  %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try out.append_bytes("_val = insertvalue ");
        try out.append_bytes(stmt.own_error_union);
        try out.append_bytes(" %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try out.append_bytes("_flag, ");
        try out.append_bytes(arm.success_llvm);
        try out.append_bytes(" %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try append_ll_line(out, "_call, 1");
        try out.append_bytes("  ret ");
        try out.append_bytes(stmt.own_error_union);
        try out.append_bytes(" %match_arm_");
        try std::fmt::append_i64(out, arm_index);
        try append_ll_line(out, "_val");
        return;
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" %match_arm_");
    try std::fmt::append_i64(out, arm_index);
    try append_ll_line(out, "_call");
    return;
}

// append_multi_enum_dispatch renders a non-bool enum-dispatch match statement (issue 1157
// PR-PH / B3): it emits the scrutinee discriminant instructions, then an exhaustive icmp/br
// dispatch chain over the arms, and one block per arm whose lowered 'return <expr>' statements
// emit a real value (no 'unreachable'). The last arm is the unconditional fallthrough. The
// block labels are namespaced by the render-time statement index (local_prefix) so several
// dispatch matches in one function never collide.
fn append_multi_enum_dispatch(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirEnumDispatchStmt,
    local_prefix: i64
) -> !void {
    try append_expr_insts(out, function.name, &stmt.scrutinee_insts);
    let arms = &stmt.arms;
    let arm_count = arms.len();
    // Phase 1: the icmp/br dispatch chain. The last arm is the exhaustive fallthrough.
    var index = 0;
    while index < arm_count {
        if index > 0 {
            try append_dispatch_label(out, local_prefix, "check_", index);
            try append_ll_line(out, ":");
        }
        if index == arm_count - 1 {
            try out.append_bytes("  br label %");
            try append_dispatch_label(out, local_prefix, "arm_", index);
            try out.append_byte(cast<u8>(10));
        } else {
            let arm = try arms.at(index);
            try out.append_bytes("  %");
            try append_dispatch_label(out, local_prefix, "is_", index);
            try out.append_bytes(" = icmp eq i64 ");
            try append_expr_value_ref(out, &stmt.scrutinee_insts, stmt.scrutinee_result_id);
            try out.append_bytes(", ");
            try std::fmt::append_i64(out, arm.tag);
            try out.append_byte(cast<u8>(10));
            try out.append_bytes("  br i1 %");
            try append_dispatch_label(out, local_prefix, "is_", index);
            try out.append_bytes(", label %");
            try append_dispatch_label(out, local_prefix, "arm_", index);
            try out.append_bytes(", label %");
            try append_dispatch_label(out, local_prefix, "check_", index + 1);
            try out.append_byte(cast<u8>(10));
        }
        index = index + 1;
    }
    // Phase 2: the arm blocks, each rendering its lowered return through the dispatch-scoped
    // return renderer so the per-arm value-wrap SSA names never collide across arm blocks.
    var arm_index = 0;
    while arm_index < arm_count {
        let arm = try arms.at(arm_index);
        try append_dispatch_label(out, local_prefix, "arm_", arm_index);
        try append_ll_line(out, ":");
        let arm_stmts = &arm.arm_stmts;
        var stmt_index = 0;
        while stmt_index < arm_stmts.len() {
            let arm_stmt = try arm_stmts.at(stmt_index);
            try append_dispatch_arm_return(
                out,
                function,
                arm_stmt,
                local_prefix * 1000 + arm_index
            );
            stmt_index = stmt_index + 1;
        }
        arm_index = arm_index + 1;
    }
    return;
}

// append_dispatch_arm_return renders one enum-dispatch arm's lowered 'return <expr>'. A value
// return wraps through the dispatch-scoped wrap (arm_scope-suffixed SSA names so the arm blocks
// never collide); a call return renders with a dispatch-scoped call result and success wrap; an
// error return reuses append_multi_return_error, whose %errfail<id> temps are already keyed off
// the unique per-arm message temp id. Other return shapes still surface an explicit blocker rather
// than emitting colliding SSA names (issue 1157 B3).
fn append_dispatch_arm_return(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirStmt,
    arm_scope: i64
) -> !void {
    match stmt {
        ReturnCall(payload) => try append_dispatch_return_call(out, function, payload, arm_scope);,
        ReturnExpr(payload) => try append_dispatch_return_expr(out, function, payload, arm_scope);,
        ReturnError(payload) => try append_multi_return_error(out, function, payload);,
        _ => return error("compiled mir llvm: enum-dispatch arm return shape not yet supported");,
    }
    return;
}

fn append_dispatch_return_call(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnCallStmt,
    arm_scope: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, function.name, &stmt.call_args, arm_scope
    );
    try out.append_bytes("  %dispatchcall");
    try std::fmt::append_i64(out, arm_scope);
    try out.append_bytes(" = call ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, stmt.call_module_prefix, stmt.call_callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, &stmt.call_args, arm_scope);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    let own_return = function.return_type.llvm_name;
    if std::mem::starts_with(own_return, "%kizu.error.") and
        !std::mem::equal_bytes(stmt.llvm_type, own_return) {
        try out.append_bytes("  %dispatchcall");
        try std::fmt::append_i64(out, arm_scope);
        try out.append_bytes("_wrap0 = insertvalue ");
        try out.append_bytes(own_return);
        try out.append_bytes(" zeroinitializer, i1 true, 0");
        try out.append_byte(cast<u8>(10));
        try out.append_bytes("  %dispatchcall");
        try std::fmt::append_i64(out, arm_scope);
        try out.append_bytes("_wrap1 = insertvalue ");
        try out.append_bytes(own_return);
        try out.append_bytes(" %dispatchcall");
        try std::fmt::append_i64(out, arm_scope);
        try out.append_bytes("_wrap0, ");
        try out.append_bytes(stmt.llvm_type);
        try out.append_bytes(" %dispatchcall");
        try std::fmt::append_i64(out, arm_scope);
        try out.append_bytes(", 1");
        try out.append_byte(cast<u8>(10));
        try out.append_bytes("  ret ");
        try out.append_bytes(own_return);
        try out.append_bytes(" %dispatchcall");
        try std::fmt::append_i64(out, arm_scope);
        try out.append_bytes("_wrap1");
        try out.append_byte(cast<u8>(10));
        return;
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" %dispatchcall");
    try std::fmt::append_i64(out, arm_scope);
    try out.append_byte(cast<u8>(10));
    return;
}

// append_dispatch_return_expr mirrors append_multi_if_return_expr's value-return wrap but scopes
// the wrap SSA names by arm_scope ('dispatchret<arm_scope>_ok/_val') so several enum-dispatch arm
// blocks in one function never collide with each other or with the trailing %retwrap return
// (issue 1157 PR-PH / B3).
fn append_dispatch_return_expr(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnExprStmt,
    arm_scope: i64
) -> !void {
    try append_expr_insts(out, function.name, &stmt.expr_insts);
    let return_type = function.return_type.llvm_name;
    let value_type = try expr_inst_type_by_id(&stmt.expr_insts, stmt.expr_result_id);
    let needs_wrap = is_error_union_type(return_type) and
        std::mem::len(value_type) > 0 and
        !std::mem::equal_bytes(value_type, return_type);
    if !needs_wrap {
        try out.append_bytes("  ret ");
        try out.append_bytes(return_type);
        try out.append_bytes(" ");
        try append_expr_value_ref(out, &stmt.expr_insts, stmt.expr_result_id);
        try out.append_byte(cast<u8>(10));
        return;
    }
    try out.append_bytes("  %dispatchret");
    try std::fmt::append_i64(out, arm_scope);
    try out.append_bytes("_ok = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" zeroinitializer, i1 true, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %dispatchret");
    try std::fmt::append_i64(out, arm_scope);
    try out.append_bytes("_val = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %dispatchret");
    try std::fmt::append_i64(out, arm_scope);
    try out.append_bytes("_ok, ");
    try out.append_bytes(value_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, &stmt.expr_insts, stmt.expr_result_id);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %dispatchret");
    try std::fmt::append_i64(out, arm_scope);
    try out.append_bytes("_val");
    try out.append_byte(cast<u8>(10));
    return;
}

// append_dispatch_label emits a 'dispatch<local_prefix>_<suffix><n>' block-label spelling
// shared by the dispatch chain and the per-arm blocks (issue 1157 PR-PH / B3).
fn append_dispatch_label(
    out: &var std::string::String,
    local_prefix: i64,
    suffix: []u8,
    n: i64
) -> !void {
    try out.append_bytes("dispatch");
    try std::fmt::append_i64(out, local_prefix);
    try out.append_bytes("_");
    try out.append_bytes(suffix);
    try std::fmt::append_i64(out, n);
    return;
}

// append_enum_dispatch_globals emits the string-literal globals referenced by the scrutinee
// instructions and each arm's lowered return statements (issue 1157 PR-PH / B3).
fn append_enum_dispatch_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirEnumDispatchStmt
) -> !void {
    try append_expr_globals(out, llvm_symbol, &stmt.scrutinee_insts);
    let arms = &stmt.arms;
    var arm_index = 0;
    while arm_index < arms.len() {
        let arm = try arms.at(arm_index);
        let arm_stmts = &arm.arm_stmts;
        var stmt_index = 0;
        while stmt_index < arm_stmts.len() {
            let arm_stmt = try arm_stmts.at(stmt_index);
            try append_stmt_globals(out, llvm_symbol, arm_stmt);
            stmt_index = stmt_index + 1;
        }
        arm_index = arm_index + 1;
    }
    return;
}

// append_grammar_loop_globals emits the string-constant globals each grammar-loop branch needs:
// the predicate condition's expression-instruction globals and the reassignment try-call globals
// (issue 1157).
fn append_grammar_loop_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirGrammarLoopStmt
) -> !void {
    let branches = &stmt.branches;
    var index = 0;
    while index < branches.len() {
        let branch = try branches.at(index);
        let reassign = &branch.reassign;
        try append_expr_globals(out, llvm_symbol, &branch.cond_insts);
        try append_let_try_call_globals(out, llvm_symbol, reassign);
        index = index + 1;
    }
    return;
}

// append_value_cursor_while_globals emits the string-constant globals an append-while loop needs:
// the condition's expression-instruction globals, each body statement's globals, and the latch
// globals (issue 1157 NEW-A).
fn append_value_cursor_latch_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    latch: &compiled_mir::MirValueCursorLatch
) -> !void {
    match latch {
        TryCall(payload) => try append_let_try_call_globals(out, llvm_symbol, payload);,
        FieldRead(payload) => try append_expr_globals(out, llvm_symbol, &payload.expr_insts);,
        PlainCall(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        _ => return error("compiled mir llvm: value-cursor latch must be try-call or field expr");,
    }
    return;
}

fn append_value_cursor_while_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirValueCursorWhileStmt
) -> !void {
    try append_expr_globals(out, llvm_symbol, &stmt.cond_insts);
    let body_stmts = &stmt.body_stmts;
    var index = 0;
    while index < body_stmts.len() {
        let body_stmt = try body_stmts.at(index);
        try append_stmt_globals(out, llvm_symbol, body_stmt);
        index = index + 1;
    }
    try append_value_cursor_latch_globals(out, llvm_symbol, &stmt.latch);
    return;
}

fn append_precedence_loop_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirPrecedenceLoopStmt
) -> !void {
    let value_init = &stmt.value_init;
    let scalar_init = &stmt.scalar_init;
    let value_latch = &stmt.value_latch;
    let scalar_latch = &stmt.scalar_latch;
    try append_let_try_call_globals(out, llvm_symbol, value_init);
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &scalar_init.call_args
    );
    try append_expr_globals(out, llvm_symbol, &stmt.cond_insts);
    let body_stmts = &stmt.body_stmts;
    var index = 0;
    while index < body_stmts.len() {
        let body_stmt = try body_stmts.at(index);
        try append_stmt_globals(out, llvm_symbol, body_stmt);
        index = index + 1;
    }
    try append_let_try_call_globals(out, llvm_symbol, value_latch);
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &scalar_latch.call_args
    );
    return;
}

fn append_dual_cursor_loop_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirDualCursorLoopStmt
) -> !void {
    let scalar_init = &stmt.scalar_init;
    let value_latch = &stmt.value_latch;
    let scalar_latch = &stmt.scalar_latch;
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &scalar_init.call_args
    );
    try append_expr_globals(out, llvm_symbol, &stmt.cond_insts);
    let body_stmts = &stmt.body_stmts;
    var index = 0;
    while index < body_stmts.len() {
        let body_stmt = try body_stmts.at(index);
        try append_stmt_globals(out, llvm_symbol, body_stmt);
        index = index + 1;
    }
    try append_let_try_call_globals(out, llvm_symbol, value_latch);
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &scalar_latch.call_args
    );
    return;
}

fn append_trailing_token_loop_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirTrailingTokenLoopStmt
) -> !void {
    let init = &stmt.init;
    let latch = &stmt.latch;
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &init.call_args
    );
    try append_expr_globals(out, llvm_symbol, &stmt.cond_insts);
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &latch.call_args
    );
    return;
}

fn append_type_apply_loop_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirTypeApplyLoopStmt
) -> !void {
    let init = &stmt.init;
    let parse_arg = &stmt.parse_arg;
    let latch = &stmt.latch;
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &init.call_args
    );
    try append_let_try_call_globals(out, llvm_symbol, parse_arg);
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_stmt_globals(out, llvm_symbol, body_stmt);
        body_index = body_index + 1;
    }
    try append_expr_globals(out, llvm_symbol, &stmt.terminal_cond_insts);
    let terminal_stmts = &stmt.terminal_stmts;
    var terminal_index = 0;
    while terminal_index < terminal_stmts.len() {
        let terminal_stmt = try terminal_stmts.at(terminal_index);
        try append_stmt_globals(out, llvm_symbol, terminal_stmt);
        terminal_index = terminal_index + 1;
    }
    let guard_stmts = &stmt.guard_stmts;
    var guard_index = 0;
    while guard_index < guard_stmts.len() {
        let guard_stmt = try guard_stmts.at(guard_index);
        try append_stmt_globals(out, llvm_symbol, guard_stmt);
        guard_index = guard_index + 1;
    }
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &latch.call_args
    );
    return;
}

// append_traversal_literal_text renders a literal arm's value: bool literals print
// true/false, integer literals their decimal value.
fn append_traversal_literal_text(
    out: &var std::string::String,
    arm: &compiled_mir::MirTraversalArm
) -> !void {
    if std::mem::equal_bytes(arm.literal_llvm, "i1") {
        if arm.literal_value != 0 {
            try out.append_bytes("true");
            return;
        }
        try out.append_bytes("false");
        return;
    }
    try std::fmt::append_i64(out, arm.literal_value);
    return;
}

// traversal_arm_call_type returns the LLVM type the arm's call instruction produces: a
// try-call arm shares the function's own error union (identity tail return); a plain-call
// arm produces its callee's success type before the error-union wrap.
fn traversal_arm_call_type(
    stmt: &compiled_mir::MirMatchTraversalStmt,
    arm: &compiled_mir::MirTraversalArm
) -> []u8 {
    if arm.is_plain_call {
        return arm.success_llvm;
    }
    return stmt.own_error_union;
}
fn append_multi_return_call(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnCallStmt,
    local_prefix: i64
) -> !void {
    try append_call_inst(
        out,
        function.name,
        stmt.name,
        stmt.llvm_type,
        stmt.call_module_prefix,
        stmt.call_callee_name,
        &stmt.call_args,
        local_prefix
    );
    // 'return code_eval_unsupported(...);' inside an '!CodeEval' function calls a
    // success-typed callee: wrap the plain result into the function's error union.
    // A callee sharing the function's return type returns its value directly.
    let own_return = function.return_type.llvm_name;
    if std::mem::starts_with(own_return, "%kizu.error.") and
        !std::mem::equal_bytes(stmt.llvm_type, own_return) {
        try out.append_bytes("  %");
        try out.append_bytes(stmt.name);
        try out.append_bytes("_wrap0 = insertvalue ");
        try out.append_bytes(own_return);
        try append_ll_line(out, " zeroinitializer, i1 true, 0");
        try out.append_bytes("  %");
        try out.append_bytes(stmt.name);
        try out.append_bytes("_wrap1 = insertvalue ");
        try out.append_bytes(own_return);
        try out.append_bytes(" %");
        try out.append_bytes(stmt.name);
        try out.append_bytes("_wrap0, ");
        try out.append_bytes(stmt.llvm_type);
        try out.append_bytes(" %");
        try out.append_bytes(stmt.name);
        try append_ll_line(out, ", 1");
        try out.append_bytes("  ret ");
        try out.append_bytes(own_return);
        try out.append_bytes(" %");
        try out.append_bytes(stmt.name);
        try append_ll_line(out, "_wrap1");
        return;
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.name);
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_multi_return_struct(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnStructStmt
) -> !void {
    var struct_llvm = function.return_type.llvm_name;
    if std::mem::len(stmt.wrap_error_union) > 0 {
        struct_llvm = stmt.success_llvm;
    }
    try append_struct_body_at(
        out,
        function.name,
        struct_llvm,
        &stmt.struct_fields,
        stmt.string_index
    );
    let return_fields = &stmt.struct_fields;
    if std::mem::len(stmt.wrap_error_union) > 0 {
        // Wrap the built struct into the function's error union success.
        try out.append_bytes("  %v");
        try std::fmt::append_i64(out, stmt.string_index);
        try out.append_bytes("_wrap0 = insertvalue ");
        try out.append_bytes(stmt.wrap_error_union);
        try append_ll_line(out, " zeroinitializer, i1 true, 0");
        try out.append_bytes("  %v");
        try std::fmt::append_i64(out, stmt.string_index);
        try out.append_bytes("_wrap1 = insertvalue ");
        try out.append_bytes(stmt.wrap_error_union);
        try out.append_bytes(" %v");
        try std::fmt::append_i64(out, stmt.string_index);
        try out.append_bytes("_wrap0, ");
        try out.append_bytes(stmt.success_llvm);
        if return_fields.len() == 0 {
            try out.append_bytes(" poison");
        } else {
            let wrap_last_field = try return_fields.at(return_fields.len() - 1);
            try out.append_bytes(" %v");
            try std::fmt::append_i64(out, stmt.string_index);
            try out.append_bytes("_");
            try std::fmt::append_i64(out, wrap_last_field.index);
        }
        try append_ll_line(out, ", 1");
        try out.append_bytes("  ret ");
        try out.append_bytes(stmt.wrap_error_union);
        try out.append_bytes(" %v");
        try std::fmt::append_i64(out, stmt.string_index);
        try append_ll_line(out, "_wrap1");
        return;
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(function.return_type.llvm_name);
    if return_fields.len() == 0 {
        try out.append_bytes(" poison");
    } else {
        let last_field = try return_fields.at(return_fields.len() - 1);
        try out.append_bytes(" %v");
        try std::fmt::append_i64(out, stmt.string_index);
        try out.append_bytes("_");
        try std::fmt::append_i64(out, last_field.index);
    }
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_multi_return_expr(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnExprStmt
) -> !void {
    try append_expr_insts(out, function.name, &stmt.expr_insts);
    try append_expr_return_value(
        out, function.return_type.llvm_name, &stmt.expr_insts, stmt.expr_result_id
    );
    return;
}
fn append_multi_return_error(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnErrorStmt
) -> !void {
    try append_expr_insts(out, function.name, &stmt.expr_insts);
    try append_error_union_failure_value(
        out, function.return_type.llvm_name, &stmt.expr_insts, stmt.message_result_id
    );
    return;
}
// append_multi_return_array_get renders a multi-statement
// 'return self.<field>.get(<expr>);' (Array<T>.get -> !T, tracker 961). It first
// lowers the index expression (e.g. range.start + index), then emits the shared
// checked array-get body keyed off that index value. Var indexes reference the
// original local SSA name directly. The error branch is a real error-union failure
// return, never 'unreachable'.
fn append_multi_return_array_get(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirReturnArrayGetStmt
) -> !void {
    try append_expr_insts(out, function.name, &stmt.expr_insts);
    let index_value_name = try expr_inst_var_name_by_id(&stmt.expr_insts, stmt.index_result_id);
    let index_is_int_literal = try expr_inst_is_int_literal_by_id(
        &stmt.expr_insts, stmt.index_result_id
    );
    let index_int_value = try expr_inst_int_value_by_id(&stmt.expr_insts, stmt.index_result_id);
    try append_array_get_body(
        out,
        function.return_type.llvm_name,
        stmt.receiver_type,
        stmt.receiver_name,
        stmt.field_index,
        stmt.element_type,
        false,
        "",
        index_value_name,
        index_is_int_literal,
        index_int_value,
        stmt.index_result_id
    );
    return;
}
// append_multi_let_array_get renders a 'let <name> = try <receiver>.get(<expr>);' where
// the receiver is a std::array::Array<T> (or &Array<T>) param/local (issue 1165). The
// receiver lowers to %kizu.owned, so the handle is read straight off the named value
// (no struct extractvalue). It lowers the index expression, calls the checked
// @kizu_rt_array_at runtime helper, extracts the ok flag, and branches on a
// try_index-suffixed label pair: try<N>_fail re-wraps the runtime message into this
// function's own error-union failure value and returns it (propagation, never
// 'unreachable'); try<N>_cont loads the element value out of the borrowed view and binds
// it to %<name>, mirroring append_multi_let_try_call's bind-and-continue shape.
fn append_multi_let_array_get(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirLetArrayGetStmt
) -> !void {
    try append_expr_insts(out, function.name, &stmt.expr_insts);
    let index_value_name = try expr_inst_var_name_by_id(&stmt.expr_insts, stmt.index_result_id);
    let index_is_int_literal = try expr_inst_is_int_literal_by_id(
        &stmt.expr_insts, stmt.index_result_id
    );
    let index_int_value = try expr_inst_int_value_by_id(&stmt.expr_insts, stmt.index_result_id);
    // Call the checked array element accessor on the %kizu.owned receiver handle.
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_view = call %kizu.error.slice.u8 @kizu_rt_array_at(%kizu.owned %");
    try out.append_bytes(stmt.receiver_name);
    try out.append_bytes(", i64 ");
    try append_ssa_or_int_or_temp_ref(
        out, index_value_name, index_is_int_literal, index_int_value, stmt.index_result_id
    );
    try append_ll_line(out, ")");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_ok = extractvalue %kizu.error.slice.u8 %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_view, 0");
    try out.append_bytes("  br i1 %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_ok, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try out.append_bytes("_cont, label %try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail");
    // Failure: forward the runtime message as this function's error-union failure value.
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_fail:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_msg = extractvalue %kizu.error.slice.u8 %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_view, 2");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_fail_flag = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 false, 0");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_fail_val = insertvalue ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_fail_flag, %kizu.slice.u8 %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_msg, ");
    // %kizu.error.void carries its message at field 1 (the 2-field union); the
    // 3-field unions carry it at field 2 with a zero success value.
    if std::mem::equal_bytes(stmt.own_error_union, "%kizu.error.void") {
        try append_ll_line(out, "1");
    } else {
        try append_ll_line(out, "2");
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.own_error_union);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_fail_val");
    // Success: load the element value out of the borrowed view and bind it to %<name>.
    try out.append_bytes("try");
    try std::fmt::append_i64(out, stmt.try_index);
    try append_ll_line(out, "_cont:");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_slice = extractvalue %kizu.error.slice.u8 %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_view, 1");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_slice, 0");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes(" = load ");
    try out.append_bytes(stmt.element_type);
    try out.append_bytes(", ptr %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_ptr");
    return;
}
// append_error_union_failure_value renders a return error("...") failure value
// for the %kizu.error.<success> ABI: field 0 is the i1 false ok flag, field 1 the
// success value (left as zeroinitializer), and the error message %kizu.slice.u8 at
// the failure index 2. The message must already be materialized by the caller
// and can reference either a source SSA value or a %t<message_id> temp (tracker
// 961). The %errfail<id> temps are keyed off the unique message temp id so
// multiple return errors never collide.
fn append_error_union_failure_value(
    out: &var std::string::String,
    return_type: []u8,
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    message_result_id: i64
) -> !void {
    try out.append_bytes("  %errfail");
    try std::fmt::append_i64(out, message_result_id);
    try out.append_bytes("_flag = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" zeroinitializer, i1 false, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %errfail");
    try std::fmt::append_i64(out, message_result_id);
    try out.append_bytes(" = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %errfail");
    try std::fmt::append_i64(out, message_result_id);
    try out.append_bytes("_flag, %kizu.slice.u8 ");
    try append_expr_value_ref(out, insts, message_result_id);
    try out.append_bytes(", 2");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %errfail");
    try std::fmt::append_i64(out, message_result_id);
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_multi_let_expr(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirLetExprStmt
) -> !void {
    try append_expr_insts(out, function.name, &stmt.expr_insts);
    let result_type = try expr_inst_type_by_id(&stmt.expr_insts, stmt.expr_result_id);
    if std::mem::len(result_type) == 0 {
        return error("compiled mir llvm: let expr result type not found");
    }
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes(" = select i1 true, ");
    try out.append_bytes(result_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, &stmt.expr_insts, stmt.expr_result_id);
    try out.append_bytes(", ");
    try out.append_bytes(result_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, &stmt.expr_insts, stmt.expr_result_id);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_alias_assign(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirAliasAssignStmt
) -> !void {
    try append_expr_insts(out, function.name, &stmt.expr_insts);
    let result_type = try expr_inst_type_by_id(&stmt.expr_insts, stmt.expr_result_id);
    if std::mem::len(result_type) == 0 {
        return error("compiled mir llvm: alias assign result type not found");
    }
    if !std::mem::equal_bytes(result_type, stmt.llvm_type) {
        return error("compiled mir llvm: alias assign result type mismatch");
    }
    try out.append_bytes("  %");
    try out.append_bytes(stmt.output_name);
    try out.append_bytes(" = select i1 true, ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, &stmt.expr_insts, stmt.expr_result_id);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, &stmt.expr_insts, stmt.expr_result_id);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_scalar_select_assign(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirScalarSelectAssignStmt
) -> !void {
    try append_expr_insts(out, llvm_symbol, &stmt.cond_insts);
    try append_expr_insts(out, llvm_symbol, &stmt.value_insts);
    try out.append_bytes("  %");
    try out.append_bytes(stmt.output_name);
    try out.append_bytes(" = select i1 ");
    try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, &stmt.value_insts, stmt.value_result_id);
    try out.append_bytes(", ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.input_name);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_scalar_select_assign_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirScalarSelectAssignStmt
) -> !void {
    try append_expr_globals(out, llvm_symbol, &stmt.cond_insts);
    try append_expr_globals(out, llvm_symbol, &stmt.value_insts);
    return;
}

fn append_multi_statement_globals(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    let stmts = &function.multi_stmts;
    var stmt_index = 0;
    while stmt_index < stmts.len() {
        let stmt = try stmts.at(stmt_index);
        try append_stmt_globals(out, function.name, stmt);
        stmt_index = stmt_index + 1;
    }
    return;
}
fn append_stmt_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirStmt
) -> !void {
    match stmt {
        LetCall(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        LetStruct(payload) => try append_struct_globals_at(out, llvm_symbol, &payload.struct_fields, payload.string_index);,
        LetArenaAdd(payload) => try append_struct_globals_at(out, llvm_symbol, &payload.struct_fields, payload.string_index);,
        LetExpr(payload) => try append_expr_globals(out, llvm_symbol, &payload.expr_insts);,
        AliasAssign(payload) => try append_expr_globals(out, llvm_symbol, &payload.expr_insts);,
        ScalarSelectAssign(payload) => try append_scalar_select_assign_globals(out, llvm_symbol, payload);,
        LetTryCall(payload) => try append_let_try_call_globals(out, llvm_symbol, payload);,
        ReturnTryBinary(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        ReturnNotTryCall(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        IfNotTryCallReturnBool(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        StringTryAppend(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        ArrayTryAppend(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        ArrayTrySet(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        VoidTryCall(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        OwnedDeinit(_) => return;,
        CountRange(payload) => try append_count_range_globals(payload);,
        TrimAscii(payload) => try append_trim_ascii_globals(payload);,
        AdvancePosition(payload) => try append_advance_position_globals(payload);,
        NumberToken(payload) => try append_number_token_globals(payload);,
        StringToken(payload) => try append_string_token_globals(payload);,
        SkipLineComment(payload) => try append_skip_line_comment_globals(payload);,
        IsDocCommentStart(payload) => try append_is_doc_comment_start_globals(payload);,
        WordToken(payload) => try append_word_token_globals(out, payload);,
        RawToken(payload) => try append_raw_token_globals(payload);,
        TokenAt(payload) => try append_token_at_globals(payload);,
        FirstToken(payload) => try append_first_token_globals(payload);,
        NextToken(payload) => try append_next_token_globals(payload);,
        ArrayNew(payload) => try append_array_new_globals(payload);,
        ValueWhile(payload) => try append_value_while_globals(payload);,
        GrammarLoop(payload) => try append_grammar_loop_globals(out, llvm_symbol, payload);,
        ValueCursorWhile(payload) => try append_value_cursor_while_globals(out, llvm_symbol, payload);,
        PrecedenceLoop(payload) => try append_precedence_loop_globals(out, llvm_symbol, payload);,
        DualCursorLoop(payload) => try append_dual_cursor_loop_globals(out, llvm_symbol, payload);,
        TrailingTokenLoop(payload) => try append_trailing_token_loop_globals(out, llvm_symbol, payload);,
        TypeApplyLoop(payload) => try append_type_apply_loop_globals(out, llvm_symbol, payload);,
        WhileMatchLoop(payload) => try append_while_match_loop_globals(out, llvm_symbol, payload);,
        GuardedCursorLoop(payload) => try append_guarded_cursor_loop_globals(out, llvm_symbol, payload);,
        TokenKindPredicate(payload) => try append_token_kind_predicate_globals(payload);,
        ParserSpanPredicate(payload) => try append_parser_span_predicate_globals(payload);,
        ParserPostfixStart(payload) => try append_parser_postfix_start_globals(payload);,
        AstNodeText(payload) => try append_ast_node_text_globals(payload);,
        StringLiteralSpan(payload) => try append_string_literal_span_globals(payload);,
        ReturnCall(payload) => try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &payload.call_args);,
        ReturnStruct(payload) => try append_struct_globals_at(out, llvm_symbol, &payload.struct_fields, payload.string_index);,
        VoidReturnSuccess(payload) => try append_no_globals();,
        ReturnExpr(payload) => try append_expr_globals(out, llvm_symbol, &payload.expr_insts);,
        ReturnError(payload) => try append_expr_globals(out, llvm_symbol, &payload.expr_insts);,
        ReturnArrayGet(payload) => try append_expr_globals(out, llvm_symbol, &payload.expr_insts);,
        LetArrayGet(payload) => try append_expr_globals(out, llvm_symbol, &payload.expr_insts);,
        If(payload) => try append_if_globals(out, llvm_symbol, payload);,
        While(payload) => try append_while_globals(out, llvm_symbol, payload);,
        MatchTraversal(payload) => try append_match_traversal_globals(payload);,
        EnumDispatch(payload) => try append_enum_dispatch_globals(out, llvm_symbol, payload);,
    }
    return;
}
fn append_while_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirWhileStmt
) -> !void {
    // A call-seeded primary init's call instructions may carry string-literal arguments whose
    // globals must be emitted; init_insts is empty for every other seed shape (issue 1165 / 1162).
    try append_expr_globals(out, llvm_symbol, &stmt.init_insts);
    try append_expr_globals(out, llvm_symbol, &stmt.cond_insts);
    // A genuine short-circuit 'and' header lowers its later operands into cond_rhs_insts and
    // cond_extra_operands; any string literal among them needs its global emitted too. Both
    // are empty for a single comparison or an eager-folded 'and' (issue 1165 / 1162).
    try append_expr_globals(out, llvm_symbol, &stmt.cond_rhs_insts);
    let extra_operands = &stmt.cond_extra_operands;
    var extra_index = 0;
    while extra_index < extra_operands.len() {
        let operand = try extra_operands.at(extra_index);
        try append_expr_globals(out, llvm_symbol, &operand.insts);
        extra_index = extra_index + 1;
    }
    let body_stmts = &stmt.body_stmts;
    var index = 0;
    while index < body_stmts.len() {
        let body_stmt = try body_stmts.at(index);
        try append_stmt_globals(out, llvm_symbol, body_stmt);
        index = index + 1;
    }
    try append_expr_globals(out, llvm_symbol, &stmt.branch_latch_cond_insts);
    let advance_stmts = &stmt.branch_latch_advance_stmts;
    var advance_index = 0;
    while advance_index < advance_stmts.len() {
        let advance_stmt = try advance_stmts.at(advance_index);
        try append_stmt_globals(out, llvm_symbol, advance_stmt);
        advance_index = advance_index + 1;
    }
    return;
}
fn append_if_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &stmt.cond_call_args
    );
    try append_expr_globals(out, llvm_symbol, &stmt.cond_insts);
    try append_expr_globals(out, llvm_symbol, &stmt.cond_rhs_insts);
    let extra_operands = &stmt.cond_extra_operands;
    var extra_index = 0;
    while extra_index < extra_operands.len() {
        let operand = try extra_operands.at(extra_index);
        try append_expr_globals(out, llvm_symbol, &operand.insts);
        extra_index = extra_index + 1;
    }
    try compiled_mir_llvm_call::append_call_string_globals(
        out, llvm_symbol, &stmt.then_call_args
    );
    try append_expr_globals(out, llvm_symbol, &stmt.then_expr_insts);
    try append_struct_globals_at(
        out, llvm_symbol, &stmt.then_struct_fields, stmt.then_struct_string_index
    );
    let then_body = &stmt.then_body_stmts;
    var body_index = 0;
    while body_index < then_body.len() {
        let body_stmt = try then_body.at(body_index);
        try append_stmt_globals(out, llvm_symbol, body_stmt);
        body_index = body_index + 1;
    }
    let else_body = &stmt.else_body_stmts;
    var else_index = 0;
    while else_index < else_body.len() {
        let else_stmt = try else_body.at(else_index);
        try append_stmt_globals(out, llvm_symbol, else_stmt);
        else_index = else_index + 1;
    }
    return;
}
fn append_expr_return_value(
    out: &var std::string::String,
    return_type: []u8,
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> !void {
    let value_type = try expr_inst_type_by_id(insts, result_id);
    let needs_wrap = is_error_union_type(return_type) and
        std::mem::len(value_type) > 0 and
        !std::mem::equal_bytes(value_type, return_type);
    if !needs_wrap {
        try out.append_bytes("  ret ");
        try out.append_bytes(return_type);
        try out.append_bytes(" ");
        try append_expr_value_ref(out, insts, result_id);
        try out.append_byte(cast<u8>(10));
        return;
    }
    try out.append_bytes("  %retwrap_ok = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" zeroinitializer, i1 true, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %retwrap_val = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %retwrap_ok, ");
    try out.append_bytes(value_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, insts, result_id);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %retwrap_val");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_expr_value_ref(
    out: &var std::string::String,
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> !void {
    let var_name = try expr_inst_var_name_by_id(insts, result_id);
    if std::mem::len(var_name) > 0 {
        try append_named_ref(out, var_name);
        return;
    }
    let is_bool_literal = try expr_inst_is_bool_literal_by_id(insts, result_id);
    if is_bool_literal {
        let bool_value = try expr_inst_bool_value_by_id(insts, result_id);
        try append_bool_literal(out, bool_value);
        return;
    }
    let is_int_literal = try expr_inst_is_int_literal_by_id(insts, result_id);
    if is_int_literal {
        let int_value = try expr_inst_int_value_by_id(insts, result_id);
        try std::fmt::append_i64(out, int_value);
        return;
    }
    if try append_struct_literal_expr_ref_by_id(out, insts, result_id) {
        return;
    }
    try append_temp_ref(out, result_id);
    return;
}

fn append_struct_literal_expr_ref_by_id(
    out: &var std::string::String,
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> !bool {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            match inst {
                StructLiteral(payload) => return try append_struct_literal_expr_ref(out, payload);,
                _ => return false;,
            }
        }
        index = index + 1;
    }
    return false;
}

fn append_struct_literal_expr_ref(
    out: &var std::string::String,
    inst: &compiled_mir::MirStructLiteralExpr
) -> !bool {
    let fields = &inst.struct_fields;
    if fields.len() == 0 {
        try out.append_bytes("poison");
        return true;
    }
    let last = try fields.at(fields.len() - 1);
    try out.append_bytes("%v");
    try std::fmt::append_i64(out, expr_struct_prefix(inst.id));
    try out.append_bytes("_");
    try std::fmt::append_i64(out, last.index);
    return true;
}

fn append_named_ref(out: &var std::string::String, name: []u8) -> !void {
    try out.append_bytes("%");
    try out.append_bytes(name);
    return;
}

fn append_bool_literal(out: &var std::string::String, value: bool) -> !void {
    if value {
        try out.append_bytes("true");
    } else {
        try out.append_bytes("false");
    }
    return;
}

fn append_ssa_or_int_or_temp_ref(
    out: &var std::string::String,
    value_name: []u8,
    is_int_literal: bool,
    int_value: i64,
    temp_id: i64
) -> !void {
    if std::mem::len(value_name) > 0 {
        try append_named_ref(out, value_name);
        return;
    }
    if is_int_literal {
        try std::fmt::append_i64(out, int_value);
        return;
    }
    try append_temp_ref(out, temp_id);
    return;
}

fn append_temp_ref(
    out: &var std::string::String,
    temp_id: i64
) -> !void {
    try out.append_bytes("%t");
    try std::fmt::append_i64(out, temp_id);
    return;
}

fn expr_inst_var_name_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> ![]u8 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return match inst {
                Var(payload) => payload.value,
                _ => "",
            };
        }
        index = index + 1;
    }
    return "";
}

// expr_inst_llvm_type_by_id resolves the LLVM type of the expr inst that produced
// result_id, so a struct-literal build can spell its field value's type in the insertvalue
// it emits (issue 1157 PR-P3).
fn expr_inst_llvm_type_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> ![]u8 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return compiled_mir::expr_inst_llvm_type(inst);
        }
        index = index + 1;
    }
    return error("compiled mir llvm: struct-literal field value not found");
}

fn expr_inst_is_int_literal_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> !bool {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return match inst {
                ConstInt(payload) => true,
                ConstEnumTag(payload) => true,
                _ => false,
            };
        }
        index = index + 1;
    }
    return false;
}

fn expr_inst_is_bool_literal_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> !bool {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return match inst {
                ConstBool(payload) => true,
                _ => false,
            };
        }
        index = index + 1;
    }
    return false;
}

fn expr_inst_int_value_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> !i64 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return match inst {
                ConstInt(payload) => payload.int_value,
                ConstEnumTag(payload) => payload.int_value,
                _ => 0,
            };
        }
        index = index + 1;
    }
    return 0;
}

fn expr_inst_bool_value_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> !bool {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return match inst {
                ConstBool(payload) => payload.bool_value,
                _ => false,
            };
        }
        index = index + 1;
    }
    return false;
}

fn expr_inst_type_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> ![]u8 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return compiled_mir::expr_inst_llvm_type(inst);
        }
        index = index + 1;
    }
    return "";
}

fn is_error_union_type(llvm_type: []u8) -> bool {
    let prefix = "%kizu.error.";
    let prefix_len = std::mem::len(prefix);
    if std::mem::len(llvm_type) < prefix_len {
        return false;
    }
    return std::mem::equal_bytes(llvm_type[0..prefix_len], prefix);
}

fn append_call_inst(
    out: &var std::string::String,
    llvm_symbol: []u8,
    name: []u8,
    llvm_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
    call_args: &std::array::Array<compiled_mir::MirCallArg>,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, llvm_symbol, call_args, local_prefix
    );
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes(" = call ");
    try out.append_bytes(llvm_type);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, module_prefix, callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, call_args, local_prefix);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}
// append_multi_let_arena_add renders a 'let <name> = self.<field>.add(<struct
// literal>);' (Arena<T>.add, tracker 961). It builds the element struct from the
// literal fields (shared struct-body insertvalue chain), marshals it through stack
// storage as a %kizu.slice.u8 (ptr + sizeof(T) via the getelementptr-null idiom),
// reads the Arena<T> handle off the struct value receiver, calls the heap-backed
// @kizu_rt_arena_add, and binds <name> to the appended slot index. Ast.add_node is
// its first consumer.
fn append_multi_let_arena_add(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirLetArenaAddStmt
) -> !void {
    // Build the element struct value as %v<string_index>_<last_field_index>.
    try append_struct_body_at(
        out,
        llvm_symbol,
        stmt.element_type,
        &stmt.struct_fields,
        stmt.string_index
    );
    // Marshal the element through stack storage into a %kizu.slice.u8.
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_slot = alloca ");
    try out.append_bytes(stmt.element_type);
    try append_ll_line(out, ", align 8");
    try out.append_bytes("  store ");
    try out.append_bytes(stmt.element_type);
    try out.append_bytes(" %v");
    try std::fmt::append_i64(out, stmt.string_index);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, stmt.last_field_index);
    try out.append_bytes(", ptr %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_slot, align 8");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_slice_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_slot, 0");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_slice_base, i64 ptrtoint (ptr getelementptr (");
    try out.append_bytes(stmt.element_type);
    try append_ll_line(out, ", ptr null, i32 1) to i64), 1");
    // Read the Arena<T> handle off the struct value receiver.
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_arena = extractvalue ");
    try out.append_bytes(stmt.receiver_type);
    try out.append_bytes(" %");
    try out.append_bytes(stmt.receiver_name);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, stmt.arena_field_index);
    try out.append_byte(cast<u8>(10));
    // Append the element and bind the result name to the appended slot index.
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_handle = call %kizu.handle @kizu_rt_arena_add(%kizu.owned %");
    try out.append_bytes(stmt.name);
    try out.append_bytes("_arena, %kizu.slice.u8 %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_slice)");
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    try out.append_bytes(" = extractvalue %kizu.handle %");
    try out.append_bytes(stmt.name);
    try append_ll_line(out, "_handle, 1");
    return;
}

fn append_multi_let_struct(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirLetStructStmt
) -> !void {
    try append_struct_body_at(
        out,
        llvm_symbol,
        stmt.llvm_type,
        &stmt.struct_fields,
        stmt.string_index
    );
    try out.append_bytes("  %");
    try out.append_bytes(stmt.name);
    let fields = &stmt.struct_fields;
    if fields.len() == 0 {
        try out.append_bytes(" = add i64 0, 0");
        try out.append_byte(cast<u8>(10));
        return;
    }
    let last_field = try fields.at(fields.len() - 1);
    try out.append_bytes(" = freeze ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" %v");
    try std::fmt::append_i64(out, stmt.string_index);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, last_field.index);
    try out.append_byte(cast<u8>(10));
    return;
}
// then_temp_base returns the first temp id available to the then-block, i.e.
// one past the last condition temp. For a short-circuit if the rhs temps follow
// the lhs temps, so the base is past the rhs result; for an 'and' chain carrying
// extra operands the base is past the last extra operand's result, matching the
// lowering's then_base (last_cond_result + 1) so a ReturnCall then-block never
// reuses an operand temp id.
fn then_temp_base(stmt: &compiled_mir::MirIfStmt) -> !i64 {
    if stmt.cond_short_circuit != 0 {
        let extra_operands = &stmt.cond_extra_operands;
        let extra_len = extra_operands.len();
        if extra_len > 0 {
            let last = try extra_operands.at(extra_len - 1);
            return last.result_id + 1;
        }
        return stmt.cond_rhs_result_id + 1;
    }
    return stmt.cond_result_id + 1;
}
fn append_if_merge_slot_ref(
    out: &var std::string::String,
    if_index: i64,
    merge_index: i64
) -> !void {
    try out.append_bytes("%if");
    try std::fmt::append_i64(out, if_index);
    try out.append_bytes("_merge");
    try std::fmt::append_i64(out, merge_index);
    return;
}

fn append_if_merge_allocas(
    out: &var std::string::String,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    let merge_vars = &stmt.merge_vars;
    var merge_index = 0;
    while merge_index < merge_vars.len() {
        let merge = try merge_vars.at(merge_index);
        try out.append_bytes("  ");
        try append_if_merge_slot_ref(out, stmt.if_index, merge_index);
        try out.append_bytes(" = alloca ");
        try out.append_bytes(merge.llvm_type);
        try out.append_byte(cast<u8>(10));
        try out.append_bytes("  store ");
        try out.append_bytes(merge.llvm_type);
        try out.append_bytes(" %");
        try out.append_bytes(merge.input_name);
        try out.append_bytes(", ptr ");
        try append_if_merge_slot_ref(out, stmt.if_index, merge_index);
        try out.append_byte(cast<u8>(10));
        merge_index = merge_index + 1;
    }
    return;
}

fn append_if_merge_then_stores(
    out: &var std::string::String,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    let merge_vars = &stmt.merge_vars;
    var merge_index = 0;
    while merge_index < merge_vars.len() {
        let merge = try merge_vars.at(merge_index);
        try out.append_bytes("  store ");
        try out.append_bytes(merge.llvm_type);
        try out.append_bytes(" %");
        try out.append_bytes(merge.then_name);
        try out.append_bytes(", ptr ");
        try append_if_merge_slot_ref(out, stmt.if_index, merge_index);
        try out.append_byte(cast<u8>(10));
        merge_index = merge_index + 1;
    }
    return;
}

fn append_if_merge_else_stores(
    out: &var std::string::String,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    let merge_vars = &stmt.merge_vars;
    var merge_index = 0;
    while merge_index < merge_vars.len() {
        let merge = try merge_vars.at(merge_index);
        try out.append_bytes("  store ");
        try out.append_bytes(merge.llvm_type);
        try out.append_bytes(" %");
        try out.append_bytes(merge.else_name);
        try out.append_bytes(", ptr ");
        try append_if_merge_slot_ref(out, stmt.if_index, merge_index);
        try out.append_byte(cast<u8>(10));
        merge_index = merge_index + 1;
    }
    return;
}

fn append_if_merge_loads(
    out: &var std::string::String,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    let merge_vars = &stmt.merge_vars;
    var merge_index = 0;
    while merge_index < merge_vars.len() {
        let merge = try merge_vars.at(merge_index);
        try out.append_bytes("  %");
        try out.append_bytes(merge.output_name);
        try out.append_bytes(" = load ");
        try out.append_bytes(merge.llvm_type);
        try out.append_bytes(", ptr ");
        try append_if_merge_slot_ref(out, stmt.if_index, merge_index);
        try out.append_byte(cast<u8>(10));
        merge_index = merge_index + 1;
    }
    return;
}

fn if_has_else_body(stmt: &compiled_mir::MirIfStmt) -> bool {
    return stmt.else_body_stmts.len() > 0;
}

fn body_ends_with_return(
    body_stmts: &std::array::Array<compiled_mir::MirStmt>
) -> !bool {
    if body_stmts.len() < 1 {
        return false;
    }
    let last = try body_stmts.at(body_stmts.len() - 1);
    match last {
        ReturnCall(_) => return true;,
        ReturnStruct(_) => return true;,
        ReturnExpr(_) => return true;,
        ReturnError(_) => return true;,
        ReturnArrayGet(_) => return true;,
        ReturnTryBinary(_) => return true;,
        ReturnNotTryCall(_) => return true;,
        VoidReturnSuccess(_) => return true;,
        _ => return false;,
    }
}

fn append_void_then_body(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    let body = &stmt.then_body_stmts;
    var body_index = 0;
    while body_index < body.len() {
        let body_stmt = try body.at(body_index);
        try append_multi_stmt(
            out,
            function,
            body_stmt,
            stmt.if_index * 1000 + body_index + 1
        );
        body_index = body_index + 1;
    }
    if try body_ends_with_return(body) {
        return;
    }
    try append_if_merge_then_stores(out, stmt);
    try out.append_bytes("  br label %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_cont");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_void_else_body(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    let body = &stmt.else_body_stmts;
    var body_index = 0;
    while body_index < body.len() {
        let body_stmt = try body.at(body_index);
        try append_multi_stmt(
            out,
            function,
            body_stmt,
            stmt.if_index * 1000 + 500 + body_index + 1
        );
        body_index = body_index + 1;
    }
    if try body_ends_with_return(body) {
        return;
    }
    try append_if_merge_else_stores(out, stmt);
    try out.append_bytes("  br label %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_cont");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_multi_if(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirIfStmt,
    local_prefix: i64
) -> !void {
    if stmt.cond_try_call {
        if stmt.if_then_kind != compiled_mir::MirIfThenKind::VoidBody {
            return error("compiled mir llvm: try-call if condition requires a void then-body");
        }
        try append_try_bool_call_eval(
            out,
            function.name,
            stmt.cond_called_error_union,
            stmt.cond_own_error_union,
            stmt.cond_call_module_prefix,
            stmt.cond_call_callee_name,
            &stmt.cond_call_args,
            local_prefix
        );
        try append_if_merge_allocas(out, stmt);
        try out.append_bytes("  br i1 ");
        try append_tryif_ref(out, local_prefix, "_success");
        if stmt.cond_try_then_on_success {
            try out.append_bytes(", label %if");
            try std::fmt::append_i64(out, stmt.if_index);
            try out.append_bytes("_then, label %if");
            try std::fmt::append_i64(out, stmt.if_index);
            if if_has_else_body(stmt) {
                try out.append_bytes("_else");
            } else {
                try out.append_bytes("_cont");
            }
        } else {
            try out.append_bytes(", label %if");
            try std::fmt::append_i64(out, stmt.if_index);
            if if_has_else_body(stmt) {
                try out.append_bytes("_else");
            } else {
                try out.append_bytes("_cont");
            }
            try out.append_bytes(", label %if");
            try std::fmt::append_i64(out, stmt.if_index);
            try out.append_bytes("_then");
        }
        try out.append_byte(cast<u8>(10));
    } else {
        try append_expr_insts(out, function.name, &stmt.cond_insts);
        if stmt.if_then_kind == compiled_mir::MirIfThenKind::VoidBody {
            try append_if_merge_allocas(out, stmt);
        }
        if stmt.cond_short_circuit == 0 {
            try out.append_bytes("  br i1 ");
            try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
            try out.append_bytes(", label %if");
            try std::fmt::append_i64(out, stmt.if_index);
            try out.append_bytes("_then, label %if");
            try std::fmt::append_i64(out, stmt.if_index);
            if if_has_else_body(stmt) {
                try out.append_bytes("_else");
            } else {
                try out.append_bytes("_cont");
            }
            try out.append_byte(cast<u8>(10));
        } else {
            if if_has_else_body(stmt) {
                return error("compiled mir llvm: void if/else short-circuit condition not yet supported");
            }
            try append_short_circuit_branches(out, function.name, stmt);
        }
    }
    try out.append_bytes("if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_then:");
    try out.append_byte(cast<u8>(10));
    if stmt.if_then_kind == compiled_mir::MirIfThenKind::VoidBody {
        try append_void_then_body(out, function, stmt);
    } else {
    if stmt.if_then_kind == compiled_mir::MirIfThenKind::ContinueLatch {
        // A continue-latch then-block branches straight back to the loop latch; the increment folds
        // into the shared constant-step latch add and the if-continuation block falls through to the
        // loop's non-continue tail (issue 1165 / 1162). The owning loop index is recovered from the
        // body-if index encoding (loop_index * 1000 + body_index + 1), so the branch targets the
        // same loopN_latch the loop-head phi reads on its latch edge.
        try out.append_bytes("  br label %loop");
        try std::fmt::append_i64(out, stmt.if_index / 1000);
        try out.append_bytes("_latch");
        try out.append_byte(cast<u8>(10));
    } else {
        if stmt.if_then_kind == compiled_mir::MirIfThenKind::VoidReturnSuccess {
            try append_multi_if_return_void_success(out, function.return_type.llvm_name);
        } else {
        if stmt.if_then_kind == compiled_mir::MirIfThenKind::ReturnBool {
            try append_multi_if_return_bool(out, function.return_type.llvm_name, stmt);
        } else {
            if stmt.if_then_kind == compiled_mir::MirIfThenKind::ReturnCall {
                try append_multi_then_call(out, function.name, stmt, local_prefix);
                try append_multi_then_call_return(out, function, stmt);
            } else {
                if stmt.if_then_kind == compiled_mir::MirIfThenKind::ReturnExpr {
                    try append_multi_if_return_expr(out, function, stmt);
                } else {
                    if stmt.if_then_kind == compiled_mir::MirIfThenKind::ReturnStruct {
                        try append_multi_then_struct(out, function, stmt);
                    } else {
                        if stmt.if_then_kind == compiled_mir::MirIfThenKind::ReturnError {
                            try append_expr_insts(out, function.name, &stmt.then_expr_insts);
                            try append_error_union_failure_value(
                                out,
                                function.return_type.llvm_name,
                                &stmt.then_expr_insts,
                                stmt.then_expr_result_id
                            );
                        } else {
                            return error("compiled mir llvm: unsupported if then kind");
                        }
                    }
                }
            }
        }
    }
    }
    }
    if stmt.if_then_kind == compiled_mir::MirIfThenKind::VoidBody and if_has_else_body(stmt) {
        try out.append_bytes("if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_else:");
        try out.append_byte(cast<u8>(10));
        try append_void_else_body(out, function, stmt);
    }
    try out.append_bytes("if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_cont:");
    try out.append_byte(cast<u8>(10));
    if stmt.if_then_kind == compiled_mir::MirIfThenKind::VoidBody {
        try append_if_merge_loads(out, stmt);
    }
    return;
}
// append_multi_then_call_return returns a then-block call result: a callee sharing the
// function's return type returns directly, while a success-typed callee inside an
// error-union function (the tape descent's 'return code_eval_unsupported(...);' guard in
// '!CodeEval') wraps the plain result into the function's error union. The wrap SSA names
// are suffixed by the if index so multiple early-return ifs never collide.
fn append_multi_then_call_return(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    let temp_base = try then_temp_base(stmt);
    let own_return = function.return_type.llvm_name;
    if is_error_union_type(own_return) and
        !std::mem::equal_bytes(stmt.llvm_type, own_return) {
        try out.append_bytes("  %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_retcall_ok = insertvalue ");
        try out.append_bytes(own_return);
        try append_ll_line(out, " zeroinitializer, i1 true, 0");
        try out.append_bytes("  %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_retcall_val = insertvalue ");
        try out.append_bytes(own_return);
        try out.append_bytes(" %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_retcall_ok, ");
        try out.append_bytes(stmt.llvm_type);
        try out.append_bytes(" %t");
        try std::fmt::append_i64(out, temp_base);
        try append_ll_line(out, ", 1");
        try out.append_bytes("  ret ");
        try out.append_bytes(own_return);
        try out.append_bytes(" %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try append_ll_line(out, "_retcall_val");
        return;
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" %t");
    try std::fmt::append_i64(out, temp_base);
    try out.append_byte(cast<u8>(10));
    return;
}

// append_no_globals is the no-op globals hook for statements that emit none.
fn append_no_globals() -> !void {
    return;
}

// append_multi_if_return_void_success returns a bare 'return;' then-block: a plain
// void function rets void, and an error-union void function returns the wrapped
// success value.
fn append_multi_if_return_void_success(
    out: &var std::string::String,
    return_type: []u8
) -> !void {
    if std::mem::equal_bytes(return_type, "void") {
        try append_ll_line(out, "  ret void");
        return;
    }
    try out.append_bytes("  ret ");
    try out.append_bytes(return_type);
    try append_ll_line(out, " { i1 true, %kizu.slice.u8 zeroinitializer }");
    return;
}

// append_multi_if_return_bool renders the then-block of a 'return <bool>;' early exit. A
// plain bool function returns the i1 directly; an error-union function (next_token_text_equals
// returns !bool, issue 1165) wraps the bool into the %kizu.error.<bool> success value (ok flag
// true at field 0, the bool at field 1). The wrap SSA names are suffixed by the if index so
// multiple early-return ifs in one function never collide.
fn append_multi_if_return_bool(
    out: &var std::string::String,
    return_type: []u8,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    if !is_error_union_type(return_type) {
        try out.append_bytes("  ret ");
        try out.append_bytes(return_type);
        try out.append_bytes(" ");
        try append_bool_literal(out, stmt.bool_value);
        try out.append_byte(cast<u8>(10));
        return;
    }
    try out.append_bytes("  %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_retbool_ok = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" zeroinitializer, i1 true, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_retbool_val = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_retbool_ok, i1 ");
    try append_bool_literal(out, stmt.bool_value);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_retbool_val");
    try out.append_byte(cast<u8>(10));
    return;
}
// append_multi_if_return_expr renders the then-block of a 'return <expr>;' early exit. A
// non-error-union function returns the value directly; an error-union function
// (index_after_import returns !i64 and early-returns 'index + 1' / 'index', issue 1165)
// wraps the value into the %kizu.error.<T> success value (ok flag true at field 0, the
// value at field 1), mirroring append_expr_return_value's trailing-return wrap. The wrap
// SSA names are suffixed by the if index so multiple early-return ifs in one function never
// collide with each other or with the trailing %retwrap return.
fn append_multi_if_return_expr(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    try append_expr_insts(out, function.name, &stmt.then_expr_insts);
    let return_type = function.return_type.llvm_name;
    let value_type = try expr_inst_type_by_id(&stmt.then_expr_insts, stmt.then_expr_result_id);
    let needs_wrap = is_error_union_type(return_type) and
        std::mem::len(value_type) > 0 and
        !std::mem::equal_bytes(value_type, return_type);
    if !needs_wrap {
        try out.append_bytes("  ret ");
        try out.append_bytes(return_type);
        try out.append_bytes(" ");
        try append_expr_value_ref(out, &stmt.then_expr_insts, stmt.then_expr_result_id);
        try out.append_byte(cast<u8>(10));
        return;
    }
    try out.append_bytes("  %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_retexpr_ok = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" zeroinitializer, i1 true, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_retexpr_val = insertvalue ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_retexpr_ok, ");
    try out.append_bytes(value_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, &stmt.then_expr_insts, stmt.then_expr_result_id);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret ");
    try out.append_bytes(return_type);
    try out.append_bytes(" %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_retexpr_val");
    try out.append_byte(cast<u8>(10));
    return;
}
// append_multi_while renders a restricted bounded counter loop (tracker 961):
//   <current block>            ; min/max/etc. lets already emitted here
//     br label %loopL_preheader
//   loopL_preheader:           ; single, deterministic phi entry predecessor
//     br label %loopL_head
//   loopL_head:
//     %v = phi i64 [ init, %loopL_preheader ], [ %v_next, %loopL_latch ]
//        ; init is the induction_init literal, or %<param> when the loop counter is
//        ; seeded from a parameter/local (var index = import_index)
//     <condition insts>        ; re-evaluated every iteration
//     br i1 %tCOND, label %loopL_body, label %loopL_exit
//   loopL_body:
//     <body stmts: checked index loads, early-return ifs, ...>
//     br label %loopL_latch
//   loopL_latch:
//     %v_next = add i64 %v, step
//     br label %loopL_head
//   loopL_exit:                ; left open; the next statement (the post-loop
//                              ; return) terminates it
// Plain Var reads of the induction variable resolve to %v because the phi is named
// after the variable, so the loop-carried value flows without extra plumbing. The
// single loop-carried phi is the only phi this lowering emits.
// while_body_terminates reports whether a while body's last statement is a return, i.e. the body
// block already ends in a terminator. A continue-latch loop's non-continue tail is such a return,
// so append_multi_while must not emit a trailing fall-through 'br' into the latch (it would follow a
// terminator); every other loop shape falls through from the body into the latch (issue 1165 /
// 1162).
fn while_body_terminates(
    body_stmts: &std::array::Array<compiled_mir::MirStmt>
) -> !bool {
    return try body_ends_with_return(body_stmts);
}

fn while_has_branch_merge_latch(stmt: &compiled_mir::MirWhileStmt) -> bool {
    return stmt.branch_latch_cond_result_id >= 0;
}

fn append_while_branch_merge_latch(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirWhileStmt
) -> !void {
    try append_expr_insts(out, function.name, &stmt.branch_latch_cond_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(
        out, &stmt.branch_latch_cond_insts, stmt.branch_latch_cond_result_id
    );
    try out.append_bytes(", label %loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    if stmt.branch_latch_exit_on_true {
        try out.append_bytes("_exit, label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_branch_advance");
    } else {
        try out.append_bytes("_branch_advance, label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_exit");
    }
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_branch_advance:");
    try out.append_byte(cast<u8>(10));
    let advance_stmts = &stmt.branch_latch_advance_stmts;
    var advance_index = 0;
    while advance_index < advance_stmts.len() {
        let advance_stmt = try advance_stmts.at(advance_index);
        try append_multi_stmt(
            out,
            function,
            advance_stmt,
            stmt.loop_index * 1000 + stmt.body_stmts.len() + advance_index + 1
        );
        advance_index = advance_index + 1;
    }
    if !try while_body_terminates(advance_stmts) {
        try out.append_bytes("  br label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_latch");
        try out.append_byte(cast<u8>(10));
    }
    return;
}

fn append_multi_while(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirWhileStmt
) -> !void {
    try out.append_bytes("  br label %loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_preheader");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_preheader:");
    try out.append_byte(cast<u8>(10));
    // A call-seeded primary init ('var cursor = line_end_including_break(source, comment_end)')
    // runs its call instructions in the preheader; the loop-head phi reads the result on the
    // preheader edge through init_result_id (issue 1165 / 1162). init_insts is empty for a
    // literal, plain-copy, or base-plus-offset seed.
    if stmt.init_insts.len() > 0 {
        try append_expr_insts(out, function.name, &stmt.init_insts);
    }
    // A base-plus-offset counter ('var left_index = left + 1') computes its preheader seed
    // here so the loop-head phi can reference %<var>_init on the preheader edge (issue 1165
    // / 1162). A literal or plain-copy seed needs no preheader instruction.
    try append_while_counter_preheader_init(
        out, stmt.induction_var, stmt.induction_init_var, stmt.induction_init_offset
    );
    let secondary = &stmt.secondary_inductions;
    var secondary_index = 0;
    while secondary_index < secondary.len() {
        let entry = try secondary.at(secondary_index);
        try append_while_counter_preheader_init(
            out, entry.var_name, entry.init_var, entry.init_offset
        );
        secondary_index = secondary_index + 1;
    }
    let carried = &stmt.carried_scalars;
    var carried_init_index = 0;
    while carried_init_index < carried.len() {
        let entry = try carried.at(carried_init_index);
        if std::mem::len(entry.init_name) == 0 {
            try append_while_counter_preheader_init(
                out, entry.var_name, entry.init_var, entry.init_offset
            );
        }
        carried_init_index = carried_init_index + 1;
    }
    try out.append_bytes("  br label %loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_head");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_head:");
    try out.append_byte(cast<u8>(10));
    // The primary loop-head phi, then one phi per secondary lockstep counter. Each phi is
    // named after its variable so plain Var reads in the condition and body resolve to it.
    try append_while_counter_phi(
        out, stmt, stmt.induction_var, stmt.induction_init_var,
        stmt.induction_init_offset, stmt.induction_init, stmt.latch_copy_var,
        stmt.init_result_id, try while_induction_phi_type(stmt)
    );
    var phi_index = 0;
    while phi_index < secondary.len() {
        let entry = try secondary.at(phi_index);
        try append_while_counter_phi(
            out, stmt, entry.var_name, entry.init_var, entry.init_offset, entry.init_literal, "", -1,
            "i64"
        );
        phi_index = phi_index + 1;
    }
    var carried_phi_index = 0;
    while carried_phi_index < carried.len() {
        let entry = try carried.at(carried_phi_index);
        if std::mem::len(entry.init_name) > 0 or
            !std::mem::equal_bytes(entry.llvm_type, "i64") {
            try append_while_carried_scalar_phi(
                out, stmt, entry.var_name, entry.llvm_type, entry.init_name, entry.latch_var
            );
        } else {
            try append_while_counter_phi(
                out, stmt, entry.var_name, entry.init_var, entry.init_offset, entry.init_literal,
                entry.latch_var, -1, "i64"
            );
        }
        carried_phi_index = carried_phi_index + 1;
    }
    try append_expr_insts(out, function.name, &stmt.cond_insts);
    if stmt.cond_short_circuit == 0 {
        try out.append_bytes("  br i1 ");
        try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
        try out.append_bytes(", label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_body, label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_exit");
        try out.append_byte(cast<u8>(10));
    } else {
        try append_while_short_circuit_branches(out, function.name, stmt);
    }
    try out.append_bytes("loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_body:");
    try out.append_byte(cast<u8>(10));
    let body_stmts = &stmt.body_stmts;
    var body_index = 0;
    while body_index < body_stmts.len() {
        let body_stmt = try body_stmts.at(body_index);
        try append_multi_stmt(
            out, function, body_stmt, stmt.loop_index * 1000 + body_index + 1
        );
        body_index = body_index + 1;
    }
    // A branch-merge latch evaluates the terminal if/else condition after the body statements. One
    // edge exits, and the advance edge runs its arm body before the shared induction latch add. A
    // continue-latch loop's body already terminates -- its non-continue path falls through to a return
    // -- so it still emits no body fall-through branch (issue 1165 / 1162).
    if while_has_branch_merge_latch(stmt) {
        if try while_body_terminates(&stmt.body_stmts) {
            return error("compiled mir llvm: branch-merge while body must fall through");
        }
        try append_while_branch_merge_latch(out, function, stmt);
    } else {
    if !try while_body_terminates(&stmt.body_stmts) {
        try out.append_bytes("  br label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_latch");
        try out.append_byte(cast<u8>(10));
    }
    }
    try out.append_bytes("loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_latch:");
    try out.append_byte(cast<u8>(10));
    let latch_stmts = &stmt.latch_stmts;
    if latch_stmts.len() > 0 {
        // A loop-carried latch update binds the induction variable's next value to
        // %<induction_var>_next (consumed by the loop-head phi). A try-call latch
        // ('index = try f(.., index)') propagates a failure as this function's own error
        // union; a token-carried plain-call latch ('token = synth_next_token(token)')
        // returns i64 directly with no fail/cont block (issue 1157 PR-P4). The call-arg setup
        // prefix is past the body statement prefixes so its SSA names never collide.
        let latch_stmt = try latch_stmts.at(0);
        if try while_latch_statement_is_try_call(latch_stmt) {
            try append_while_latch_try_call(
                out,
                function,
                latch_stmt,
                stmt.loop_index * 1000 + body_stmts.len() + 1
            );
        } else {
            if try while_latch_statement_is_let_call(latch_stmt) {
                try append_while_latch_call(
                    out,
                    function,
                    latch_stmt,
                    stmt.loop_index * 1000 + body_stmts.len() + 1
                );
            } else {
                // A field-access latch ('token = declaration.next;') is a LetExpr holding the
                // struct field read; it binds %<var>_next with no control flow (issue 1157 PR-PF).
                try append_while_latch_field_access(out, latch_stmt);
            }
        }
    } else {
        // A copy-decrement latch ('index = previous') needs no primary add: the loop-head phi
        // already reads the body-local %<latch_copy_var> on the latch edge (issue 1165 / 1162).
        if std::mem::len(stmt.latch_copy_var) == 0 {
            try out.append_bytes("  %");
            try out.append_bytes(stmt.induction_var);
            try out.append_bytes("_next = add i64 %");
            try out.append_bytes(stmt.induction_var);
            try out.append_bytes(", ");
            try std::fmt::append_i64(out, stmt.induction_step);
            try out.append_byte(cast<u8>(10));
        }
    }
    // Each secondary lockstep counter advances by its own constant step in the same latch
    // block; a try-call latch never carries secondaries, so these always follow the primary
    // constant-step add (issue 1165 / 1162).
    var latch_index = 0;
    while latch_index < secondary.len() {
        let entry = try secondary.at(latch_index);
        try out.append_bytes("  %");
        try out.append_bytes(entry.var_name);
        try out.append_bytes("_next = add i64 %");
        try out.append_bytes(entry.var_name);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, entry.step);
        try out.append_byte(cast<u8>(10));
        latch_index = latch_index + 1;
    }
    try out.append_bytes("  br label %loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_head");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_exit:");
    try out.append_byte(cast<u8>(10));
    return;
}
// append_while_short_circuit_branches renders the guarded operand blocks of a genuine
// short-circuit 'and' while header (issue 1165 / 1162). The first operand is already in the
// loop head (cond_insts), so this emits its branch and one guarded block per remaining
// operand:
//   loopN_head:
//     <op0 insts>
//     br i1 %op0, label %loopN_head_rhs, label %loopN_exit
//   loopN_head_rhs:
//     <op1 insts>                          ; e.g. the guarded source[index] load then
//     br i1 %op1, ...                       ; !is_line_break, only reached when op0 held
//   loopN_head_rhs2: ...                   ; one block per extra operand, in chain order
// Each operand's true edge flows to the next operand's block, or to loopN_body for the
// last operand; every false edge short-circuits to loopN_exit, so a later operand's guarded
// load never runs unless every earlier operand held. The loop-head phi stays in loopN_head
// (these blocks add no phi predecessors), and an 'or' header never reaches here. This is the
// while twin of append_short_circuit_branches, sharing its block-chain layout.
fn append_while_short_circuit_branches(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirWhileStmt
) -> !void {
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
    try out.append_bytes(", label %loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_head_rhs, label %loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_exit");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_head_rhs:");
    try out.append_byte(cast<u8>(10));
    try append_expr_insts(out, llvm_symbol, &stmt.cond_rhs_insts);
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_rhs_insts, stmt.cond_rhs_result_id);
    // The first guarded block flows to the first extra operand block when the 'and' chain
    // carries more than two operands, otherwise straight to the loop body.
    let extra_operands = &stmt.cond_extra_operands;
    if extra_operands.len() > 0 {
        try out.append_bytes(", label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_head_rhs2, label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_exit");
    } else {
        try out.append_bytes(", label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_body, label %loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_exit");
    }
    try out.append_byte(cast<u8>(10));
    // Each extra operand j (0-based) lives in loopN_head_rhs{j+2}; its true edge flows to the
    // next operand's block loopN_head_rhs{j+3}, or to loopN_body for the last operand. A
    // false edge always short-circuits to loopN_exit.
    var extra_index = 0;
    while extra_index < extra_operands.len() {
        let operand = try extra_operands.at(extra_index);
        try out.append_bytes("loop");
        try std::fmt::append_i64(out, stmt.loop_index);
        try out.append_bytes("_head_rhs");
        try std::fmt::append_i64(out, extra_index + 2);
        try out.append_bytes(":");
        try out.append_byte(cast<u8>(10));
        try append_expr_insts(out, llvm_symbol, &operand.insts);
        try out.append_bytes("  br i1 ");
        try append_expr_value_ref(out, &operand.insts, operand.result_id);
        if extra_index + 1 < extra_operands.len() {
            try out.append_bytes(", label %loop");
            try std::fmt::append_i64(out, stmt.loop_index);
            try out.append_bytes("_head_rhs");
            try std::fmt::append_i64(out, extra_index + 3);
            try out.append_bytes(", label %loop");
            try std::fmt::append_i64(out, stmt.loop_index);
            try out.append_bytes("_exit");
        } else {
            try out.append_bytes(", label %loop");
            try std::fmt::append_i64(out, stmt.loop_index);
            try out.append_bytes("_body, label %loop");
            try std::fmt::append_i64(out, stmt.loop_index);
            try out.append_bytes("_exit");
        }
        try out.append_byte(cast<u8>(10));
        extra_index = extra_index + 1;
    }
    return;
}
// append_while_counter_preheader_init emits the preheader 'add' that materializes a
// base-plus-offset counter seed (%<var>_init = add i64 %<init_var>, offset). A literal seed
// or a plain parameter/local copy (offset 0) needs no instruction (issue 1165 / 1162).
fn append_while_counter_preheader_init(
    out: &var std::string::String,
    counter_var: []u8,
    init_var: []u8,
    init_offset: i64
) -> !void {
    if std::mem::len(init_var) == 0 {
        return;
    }
    if init_offset == 0 {
        return;
    }
    try out.append_bytes("  %");
    try out.append_bytes(counter_var);
    try out.append_bytes("_init = add i64 %");
    try out.append_bytes(init_var);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, init_offset);
    try out.append_byte(cast<u8>(10));
    return;
}
// append_while_counter_phi emits one loop-head phi for a counter: '%<var> = phi <phi_llvm_type>
// [ <seed>, %loopN_preheader ], [ %<var>_next, <latch-pred> ]'. phi_llvm_type is "i64" for every
// scalar counter (the secondary lockstep and carried-scalar phis always pass "i64"); the primary
// induction phi passes the cursor's declared type, which is a struct value type (e.g.
// %kizu.kizu.lexer.token) for a token-carried struct-call latch (issue 1157 PR-P4). The seed is
// %<var>_init for a base-plus-offset init, %<init_var> for a plain copy, or the integer literal
// otherwise. The latch-edge predecessor is shared with the primary counter (issue 1165 / 1162).
// latch_copy_var overrides the phi's latch-edge incoming value: when it is non-empty (a
// copy-decrement latch's body-local, e.g. %previous for 'index = previous') the phi reads
// %<latch_copy_var> on the latch edge instead of %<counter_var>_next, since the body already holds
// the decremented value and the latch computes no separate _next. It is "" for the constant-step
// and try-call latches and for every secondary counter (issue 1165 / 1162).
// init_result_id overrides the preheader-edge seed: when it is non-negative the primary counter is
// call-seeded ('var cursor = line_end_including_break(source, comment_end)'), so the phi reads the
// preheader call's result temp instead of %<init_var> / the literal. It is -1 for a literal,
// plain-copy, or base-plus-offset seed and for every secondary counter (issue 1165 / 1162).
fn append_while_counter_phi(
    out: &var std::string::String,
    stmt: &compiled_mir::MirWhileStmt,
    counter_var: []u8,
    init_var: []u8,
    init_offset: i64,
    init_literal: i64,
    latch_copy_var: []u8,
    init_result_id: i64,
    phi_llvm_type: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(counter_var);
    try out.append_bytes(" = phi ");
    try out.append_bytes(phi_llvm_type);
    try out.append_bytes(" [ ");
    if init_result_id >= 0 {
        try append_expr_value_ref(out, &stmt.init_insts, init_result_id);
    } else {
        if std::mem::len(init_var) > 0 {
            try out.append_bytes("%");
            if init_offset == 0 {
                try out.append_bytes(init_var);
            } else {
                try out.append_bytes(counter_var);
                try out.append_bytes("_init");
            }
        } else {
            try std::fmt::append_i64(out, init_literal);
        }
    }
    try out.append_bytes(", %loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_preheader ], [ %");
    if std::mem::len(latch_copy_var) > 0 {
        try out.append_bytes(latch_copy_var);
    } else {
        try out.append_bytes(counter_var);
        try out.append_bytes("_next");
    }
    try out.append_bytes(", ");
    try append_while_latch_pred_label(out, stmt);
    try out.append_bytes(" ]");
    try out.append_byte(cast<u8>(10));
    return;
}

// while_induction_phi_type returns the LLVM type of the primary loop-head induction phi. A
// token-carried plain-call latch ('token = next_token(text, token)') reseats the cursor with the
// call's return type, which may be a struct value (e.g. %kizu.kizu.lexer.token for
// skip_balanced_block) rather than i64; the phi must carry that exact type so its preheader seed
// (the init call result through init_result_id) and its latch operand (%<var>_next) agree. Every
// other latch shape -- constant-step add, try-call, field-access, copy-decrement -- advances an i64
// counter, so the phi stays i64 (issue 1157 PR-P4). It mirrors expr_inst_var_name_by_id's
// payload-field read off the bound LetCall variant.
fn while_induction_phi_type(stmt: &compiled_mir::MirWhileStmt) -> ![]u8 {
    let latch_stmts = &stmt.latch_stmts;
    if latch_stmts.len() == 0 {
        return "i64";
    }
    let latch_stmt = try latch_stmts.at(0);
    return match latch_stmt {
        LetCall(payload) => payload.llvm_type,
        _ => "i64",
    };
}

fn append_while_carried_scalar_phi(
    out: &var std::string::String,
    stmt: &compiled_mir::MirWhileStmt,
    var_name: []u8,
    llvm_type: []u8,
    init_name: []u8,
    latch_var: []u8
) -> !void {
    if std::mem::len(init_name) == 0 {
        return error("compiled mir llvm: typed carried scalar requires an init name");
    }
    try out.append_bytes("  %");
    try out.append_bytes(var_name);
    try out.append_bytes(" = phi ");
    try out.append_bytes(llvm_type);
    try out.append_bytes(" [ %");
    try out.append_bytes(init_name);
    try out.append_bytes(", %loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_preheader ], [ %");
    try out.append_bytes(latch_var);
    try out.append_bytes(", ");
    try append_while_latch_pred_label(out, stmt);
    try out.append_bytes(" ]");
    try out.append_byte(cast<u8>(10));
    return;
}
// append_while_latch_pred_label emits the basic-block label that branches back to the loop
// head, i.e. the loop-head phi's latch-edge predecessor. A constant-step latch falls through
// from loopN_latch, so loopN_latch is the predecessor; a try-call latch ends in the try-call's
// continuation block tryK_cont (after the fail block has returned), so that is the predecessor
// (issue 1165). Using loopN_latch for a try-call latch would name a non-predecessor block.
fn append_while_latch_pred_label(
    out: &var std::string::String,
    stmt: &compiled_mir::MirWhileStmt
) -> !void {
    let latch_stmts = &stmt.latch_stmts;
    if latch_stmts.len() > 0 {
        let latch_stmt = try latch_stmts.at(0);
        // A try-call latch ends in its continuation block tryK_cont; a token-carried
        // plain-call latch falls through from loopN_latch like a constant-step add (issue
        // 1157 PR-P4).
        if try while_latch_statement_is_try_call(latch_stmt) {
            let try_index = try while_latch_try_index(latch_stmt);
            try out.append_bytes("%try");
            try std::fmt::append_i64(out, try_index);
            try out.append_bytes("_cont");
            return;
        }
    }
    try out.append_bytes("%loop");
    try std::fmt::append_i64(out, stmt.loop_index);
    try out.append_bytes("_latch");
    return;
}
// while_latch_statement_is_try_call reports whether a while latch statement is a try-call
// (LetTryCall) rather than a token-carried plain call (LetCall), so the latch renderer and
// the phi latch-edge predecessor pick the right shape (issue 1157 PR-P4).
fn while_latch_statement_is_try_call(latch_stmt: &compiled_mir::MirStmt) -> !bool {
    return match latch_stmt {
        LetTryCall(payload) => true,
        _ => false,
    };
}
// while_latch_statement_is_let_call reports whether a while latch statement is a token-carried
// plain call (LetCall) rather than a field-access latch (LetExpr), so the renderer picks the
// call body vs the field-access extractvalue (issue 1157 PR-PF).
fn while_latch_statement_is_let_call(latch_stmt: &compiled_mir::MirStmt) -> !bool {
    return match latch_stmt {
        LetCall(payload) => true,
        _ => false,
    };
}
// append_while_latch_field_access renders a field-access 'token = declaration.next;' latch: the
// LetExpr holds a single FieldAccess over a local struct, and the loaded i64 field binds to
// %<induction_var>_next that the loop-head phi reads on the latch edge (issue 1157 PR-PF). It
// carries no error union and no control flow, so it falls through to the loop head.
fn append_while_latch_field_access(
    out: &var std::string::String,
    latch_stmt: &compiled_mir::MirStmt
) -> !void {
    match latch_stmt {
        LetExpr(payload) => try append_while_latch_field_access_let(out, payload);,
        _ => return error("compiled mir: while latch statement must be a field-access let-expr");,
    }
    return;
}
fn append_while_latch_field_access_let(
    out: &var std::string::String,
    payload: &compiled_mir::MirLetExprStmt
) -> !void {
    let exprs = &payload.expr_insts;
    let inst = try exprs.at(0);
    match inst {
        FieldAccess(field) => try append_while_latch_field_access_body(out, payload.name, field);,
        _ => return error("compiled mir: field-access latch must hold a field access");,
    }
    return;
}
fn append_while_latch_field_access_body(
    out: &var std::string::String,
    induction_var: []u8,
    field: &compiled_mir::MirFieldAccessExpr
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(induction_var);
    try out.append_bytes("_next = extractvalue ");
    try out.append_bytes(field.source_type);
    try out.append_bytes(" %");
    try out.append_bytes(field.value);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, field.source_field_index);
    try out.append_byte(cast<u8>(10));
    return;
}
// append_while_latch_call renders a token-carried 'token = synth_next_token(token);' latch
// update: the LetCall is emitted with the bind name suffixed "_next" so the i64 result binds
// to %<induction_var>_next that the loop-head phi reads on the latch edge (issue 1157 PR-P4).
// It carries no error union, so it emits no fail/cont block and the latch falls through to
// the loop head. A non-LetCall latch statement is a lowering bug.
fn append_while_latch_call(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    latch_stmt: &compiled_mir::MirStmt,
    local_prefix: i64
) -> !void {
    match latch_stmt {
        LetCall(payload) => try append_while_latch_call_body(out, function.name, payload, local_prefix);,
        _ => return error("compiled mir: while latch statement must be a let-call");,
    }
    return;
}
fn append_while_latch_call_body(
    out: &var std::string::String,
    llvm_symbol: []u8,
    payload: &compiled_mir::MirLetCallStmt,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, llvm_symbol, &payload.call_args, local_prefix
    );
    try out.append_bytes("  %");
    try out.append_bytes(payload.name);
    try out.append_bytes("_next = call ");
    try out.append_bytes(payload.llvm_type);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, payload.call_module_prefix, payload.call_callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(
        out, &payload.call_args, local_prefix
    );
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}
// while_latch_try_index returns the try index of a try-call latch statement, used both for
// the continuation block label and the loop-head phi's latch-edge predecessor (issue 1165).
// A non-LetTryCall latch statement is a lowering bug.
fn while_latch_try_index(latch_stmt: &compiled_mir::MirStmt) -> !i64 {
    match latch_stmt {
        LetTryCall(payload) => return payload.try_index;,
        _ => return error("compiled mir: while latch statement must be a try-call");,
    }
}
fn append_let_try_call_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirLetTryCallStmt
) -> !void {
    try append_expr_globals(out, llvm_symbol, &stmt.arg_insts);
    try compiled_mir_llvm_call::append_call_string_globals(out, llvm_symbol, &stmt.call_args);
    return;
}
// append_while_latch_try_call renders a loop-carried 'index = try <callee>(.., index);' latch
// update. The latch statement is a LetTryCall bound to the induction variable; the shared
// try-call body is emitted with the "_next" bind suffix so the success value binds to
// %<induction_var>_next (the loop-head phi's latch operand) and a failure propagates as this
// function's own error union (issue 1165). A non-LetTryCall latch statement is a lowering bug.
fn append_while_latch_try_call(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    latch_stmt: &compiled_mir::MirStmt,
    local_prefix: i64
) -> !void {
    match latch_stmt {
        LetTryCall(payload) => try append_try_call_body(out, function.name, payload, "_next", local_prefix);,
        _ => return error("compiled mir: while latch statement must be a try-call");,
    }
    return;
}
// append_short_circuit_branches renders the guard branches for a short-circuit
// condition so each operand is only evaluated when every earlier operand has not
// already decided the result. The caller has already emitted the first operand
// (cond_insts). A two-operand 'and' / 'or' keeps the original ifN_rhs -> ifN_then /
// ifN_cont layout; an 'and' or 'or' chain with further operands threads each through its own
// ifN_rhs{k} guarded block, with the 'and' chain advancing on a true edge (false short-circuits
// to ifN_cont) and the 'or' chain advancing on a false edge (true short-circuits to ifN_then)
// (issue 1165 / 1162).
fn append_short_circuit_branches(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_insts, stmt.cond_result_id);
    if stmt.cond_short_circuit == 1 {
        try out.append_bytes(", label %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_rhs, label %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_cont");
    } else {
        try out.append_bytes(", label %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_then, label %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_rhs");
    }
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_rhs:");
    try out.append_byte(cast<u8>(10));
    try append_expr_insts(out, llvm_symbol, &stmt.cond_rhs_insts);
    let extra_count = stmt.cond_extra_operands.len();
    // The second operand (cond_rhs_insts) routes to the next operand block ifN_rhs2 when the
    // chain carries more operands, otherwise to its decisive block. An 'and' chain advances on a
    // true edge (a false short-circuits to ifN_cont); an 'or' chain advances on a false edge (a
    // true short-circuits to ifN_then), so the two chains share the block layout and only swap
    // which edge advances (issue 1165 / 1162).
    try out.append_bytes("  br i1 ");
    try append_expr_value_ref(out, &stmt.cond_rhs_insts, stmt.cond_rhs_result_id);
    if extra_count > 0 {
        try append_short_circuit_operand_edges(out, stmt, 0);
    } else {
        try append_short_circuit_decisive_edges(out, stmt);
    }
    try out.append_byte(cast<u8>(10));
    // Each extra operand j (0-based) lives in ifN_rhs{j+2}; for an 'and' chain a true edge flows
    // to the next operand's block ifN_rhs{j+3} (or ifN_then for the last) and a false edge
    // short-circuits to ifN_cont, while an 'or' chain swaps the two so a false edge advances and a
    // true edge short-circuits to ifN_then (issue 1165 / 1162).
    let extra_operands = &stmt.cond_extra_operands;
    var extra_index = 0;
    while extra_index < extra_operands.len() {
        let operand = try extra_operands.at(extra_index);
        try out.append_bytes("if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_rhs");
        try std::fmt::append_i64(out, extra_index + 2);
        try out.append_bytes(":");
        try out.append_byte(cast<u8>(10));
        try append_expr_insts(out, llvm_symbol, &operand.insts);
        try out.append_bytes("  br i1 ");
        try append_expr_value_ref(out, &operand.insts, operand.result_id);
        if extra_index + 1 < extra_operands.len() {
            try append_short_circuit_operand_edges(out, stmt, extra_index + 1);
        } else {
            try append_short_circuit_decisive_edges(out, stmt);
        }
        try out.append_byte(cast<u8>(10));
        extra_index = extra_index + 1;
    }
    return;
}
// append_short_circuit_operand_edges emits the branch targets for a guarded operand that still
// has a later operand to evaluate. next_extra_index is the 0-based index of the following extra
// operand, so its block is ifN_rhs{next_extra_index + 2}. An 'and' chain advances on the true edge
// (false short-circuits to ifN_cont); an 'or' chain advances on the false edge (true
// short-circuits to ifN_then) (issue 1165 / 1162).
fn append_short_circuit_operand_edges(
    out: &var std::string::String,
    stmt: &compiled_mir::MirIfStmt,
    next_extra_index: i64
) -> !void {
    if stmt.cond_short_circuit == 1 {
        try out.append_bytes(", label %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_rhs");
        try std::fmt::append_i64(out, next_extra_index + 2);
        try out.append_bytes(", label %if");
        try std::fmt::append_i64(out, stmt.if_index);
        try out.append_bytes("_cont");
        return;
    }
    try out.append_bytes(", label %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_then, label %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_rhs");
    try std::fmt::append_i64(out, next_extra_index + 2);
    return;
}
// append_short_circuit_decisive_edges emits the branch targets for the last operand of a chain,
// which decides the condition: an 'and' chain takes ifN_then on a true edge (false to ifN_cont),
// an 'or' chain takes ifN_then on a true edge (false to ifN_cont) -- both end with the same
// then/cont split because the last operand alone determines the outcome (issue 1165 / 1162).
fn append_short_circuit_decisive_edges(
    out: &var std::string::String,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    try out.append_bytes(", label %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_then, label %if");
    try std::fmt::append_i64(out, stmt.if_index);
    try out.append_bytes("_cont");
    return;
}
fn append_multi_then_call(
    out: &var std::string::String,
    llvm_symbol: []u8,
    stmt: &compiled_mir::MirIfStmt,
    local_prefix: i64
) -> !void {
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, llvm_symbol, &stmt.then_call_args, local_prefix
    );
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, try then_temp_base(stmt));
    try out.append_bytes(" = call ");
    try out.append_bytes(stmt.llvm_type);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, stmt.then_call_module_prefix, stmt.then_call_callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, &stmt.then_call_args, local_prefix);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}
// append_multi_then_struct renders a ReturnStruct then-block: it builds the struct
// value with the generic struct-body helper (seeded from then_struct_string_index)
// and returns it. This mirrors append_multi_return_struct for the top-level case.
fn append_multi_then_struct(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction,
    stmt: &compiled_mir::MirIfStmt
) -> !void {
    try append_struct_body_at(
        out,
        function.name,
        function.return_type.llvm_name,
        &stmt.then_struct_fields,
        stmt.then_struct_string_index
    );
    try out.append_bytes("  ret ");
    try out.append_bytes(function.return_type.llvm_name);
    let return_fields = &stmt.then_struct_fields;
    if return_fields.len() == 0 {
        try out.append_bytes(" poison");
    } else {
        let last_field = try return_fields.at(return_fields.len() - 1);
        try out.append_bytes(" %v");
        try std::fmt::append_i64(out, stmt.then_struct_string_index);
        try out.append_bytes("_");
        try std::fmt::append_i64(out, last_field.index);
    }
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_expr_return(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    try append_expr_globals(out, function.name, &function.expr_insts);
    try out.append_bytes("define ");
    try out.append_bytes(function.return_type.llvm_name);
    try out.append_bytes(" @");
    try out.append_bytes(function.name);
    try out.append_bytes("(");
    try compiled_signature::append_params_signature(out, function.params_spec);
    try out.append_bytes(") {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    try append_expr_insts(out, function.name, &function.expr_insts);
    try out.append_bytes("  ret ");
    try out.append_bytes(function.return_type.llvm_name);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, &function.expr_insts, function.entry.terminator.value.id);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_expr_insts(
    out: &var std::string::String,
    llvm_symbol: []u8,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        try append_expr_inst(out, llvm_symbol, inst, insts);
        index = index + 1;
    }
    return;
}
fn append_expr_inst(
    out: &var std::string::String,
    llvm_symbol: []u8,
    inst: &compiled_mir::MirExprInst,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    match inst {
        Var(payload) => try append_var_expr(out, payload);,
        ConstString(payload) => try append_const_string_expr(out, llvm_symbol, payload);,
        ConstBool(payload) => try append_const_bool_expr(out, payload);,
        ConstInt(payload) => try append_const_int_expr(out, payload.id, payload.llvm_type, payload.int_value);,
        ConstEnumTag(payload) => try append_const_int_expr(out, payload.id, payload.llvm_type, payload.int_value);,
        PrefixNot(payload) => try append_prefix_not_expr(out, payload, insts);,
        Binary(payload) => try append_binary_expr_inst(out, payload, insts);,
        FieldAccess(payload) => try append_field_access_expr(out, payload, insts);,
        IndexLoad(payload) => try append_index_load_expr(out, payload, insts);,
        Slice(payload) => try append_slice_expr(out, payload, insts);,
        Call(payload) => try append_call_expr(out, llvm_symbol, payload);,
        ArrayLen(payload) => try append_array_len_expr(out, payload);,
        StringLen(payload) => try append_string_len_expr(out, payload);,
        IntCast(payload) => try append_int_cast_expr(out, payload, insts);,
        UnionConstruct(payload) => try append_union_construct_expr(out, payload, insts);,
        StructLiteral(payload) => try append_struct_literal_expr(out, llvm_symbol, payload, insts);,
        TryUnwrap(payload) => try append_try_unwrap_expr(out, payload, insts);,
    }
    return;
}

// append_try_unwrap_expr renders a 'try <expr>' in value/sub-expression position (issue 1157
// big-bang). operand already holds the inner error-union aggregate (called_error_union); this
// extracts its ok flag (field 0) and branches on an id-suffixed label pair: t<id>_try_fail
// re-wraps the callee message into own_error_union and returns it (propagation, never
// 'unreachable'); t<id>_try_cont extracts the success value (field 1) into %t<id>. It mirrors
// append_try_call_body for the statement-free expression path. The trailing 'br'/'ret' leave
// the cont block active for the following insts, the same way append_slice_expr's bounds-check
// trap leaves the slice_ok block active.
fn append_try_unwrap_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirTryUnwrapExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_ok = extractvalue ");
    try out.append_bytes(inst.called_error_union);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, insts, inst.operand);
    try append_ll_line(out, ", 0");
    try out.append_bytes("  br i1 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_ok, label %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_try_cont, label %t");
    try std::fmt::append_i64(out, inst.id);
    try append_ll_line(out, "_try_fail");
    try out.append_bytes("t");
    try std::fmt::append_i64(out, inst.id);
    try append_ll_line(out, "_try_fail:");
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_msg = extractvalue ");
    try out.append_bytes(inst.called_error_union);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, insts, inst.operand);
    try out.append_bytes(", ");
    try append_ll_line(out, error_union_msg_index_text(inst.called_error_union));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_fail_flag = insertvalue ");
    try out.append_bytes(inst.own_error_union);
    try append_ll_line(out, " zeroinitializer, i1 false, 0");
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_fail_val = insertvalue ");
    try out.append_bytes(inst.own_error_union);
    try out.append_bytes(" %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_fail_flag, %kizu.slice.u8 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_msg, ");
    try append_ll_line(out, error_union_msg_index_text(inst.own_error_union));
    try out.append_bytes("  ret ");
    try out.append_bytes(inst.own_error_union);
    try out.append_bytes(" %t");
    try std::fmt::append_i64(out, inst.id);
    try append_ll_line(out, "_fail_val");
    try out.append_bytes("t");
    try std::fmt::append_i64(out, inst.id);
    try append_ll_line(out, "_try_cont:");
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(inst.called_error_union);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, insts, inst.operand);
    try append_ll_line(out, ", 1");
    return;
}

// llvm_int_width parses the bit width of an LLVM integer type spelling ("iN");
// any non-integer spelling yields 0 so the caller can reject it.
fn llvm_int_width(ty: []u8) -> i64 {
    let n = std::mem::len(ty);
    if n < 2 or ty[0] != cast<u8>(105) {
        return 0;
    }
    var value = 0;
    var index = 1;
    while index < n {
        let digit = ty[index];
        if digit < cast<u8>(48) or digit > cast<u8>(57) {
            return 0;
        }
        value = value * 10 + cast<i64>(digit) - 48;
        index = index + 1;
    }
    return value;
}

// append_int_cast_expr renders an integer 'cast<iN>(<expr>)': it truncates a
// wider source, sign-extends a narrower one, and copies (add 0) when the widths
// already match, producing the target integer type.
fn append_int_cast_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirIntCastExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    let src_width = llvm_int_width(inst.source_llvm);
    let dst_width = llvm_int_width(inst.llvm_type);
    if src_width == 0 or dst_width == 0 {
        return error("compiled mir llvm: int cast requires integer operands");
    }
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    if dst_width < src_width {
        try out.append_bytes(" = trunc ");
        try out.append_bytes(inst.source_llvm);
        try out.append_bytes(" ");
        try append_expr_value_ref(out, insts, inst.operand);
        try out.append_bytes(" to ");
        try out.append_bytes(inst.llvm_type);
        try out.append_byte(cast<u8>(10));
        return;
    }
    if dst_width > src_width {
        try out.append_bytes(" = sext ");
        try out.append_bytes(inst.source_llvm);
        try out.append_bytes(" ");
        try append_expr_value_ref(out, insts, inst.operand);
        try out.append_bytes(" to ");
        try out.append_bytes(inst.llvm_type);
        try out.append_byte(cast<u8>(10));
        return;
    }
    try out.append_bytes(" = add ");
    try out.append_bytes(inst.llvm_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, insts, inst.operand);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    return;
}
// append_array_len_expr renders a local/param 'tokens.len()' read: the receiver is a
// std::array::Array<T> (or &Array<T>) param/local that lowers to %kizu.owned, so the
// handle is read straight off the named value and fed to the @kizu_rt_array_len
// runtime helper (the same one struct-field Array.len uses) returning i64 (issue 1165).
fn append_array_len_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirArrayLenExpr
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = call i64 @kizu_rt_array_len(%kizu.owned %");
    try out.append_bytes(inst.receiver_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

// append_string_len_expr renders a local/param std::string::String.len() read through the
// runtime-owned String handle.
fn append_string_len_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirStringLenExpr
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = call i64 @kizu_rt_string_len(%kizu.owned %");
    try out.append_bytes(inst.receiver_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}
// append_index_load_expr lowers expr-context path[i] as a checked i8 load.
// Per ADR-0053 safe Kizu index access must trap before an out-of-bounds read,
// so it reads the slice length, rejects index less than 0 or index >= len, and
// only performs the getelementptr i8 + load i8 on the in-bounds path. The
// branch shape mirrors the Go reference compiler writeSliceIndex. The labels
// are derived from the unique expr id so they cannot collide with ifN_ labels
// or argN_M temps.
fn append_index_load_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirIndexLoadExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_len = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(inst.target);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_neg = icmp slt i64 ");
    try append_expr_value_ref(out, insts, inst.index);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_high = icmp sge i64 ");
    try append_expr_value_ref(out, insts, inst.index);
    try out.append_bytes(", %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_len");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_bad = or i1 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_neg, %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_high");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_bad, label %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_idx_oob, label %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_idx_ok");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_idx_oob:");
    try out.append_byte(cast<u8>(10));
    try compiled_util::append_trap_body(out);
    try out.append_bytes("t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_idx_ok:");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_ptr = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(inst.target);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_gep = getelementptr i8, ptr %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_ptr, i64 ");
    try append_expr_value_ref(out, insts, inst.index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = load i8, ptr %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_gep");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_slice_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirSliceExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_srclen = extractvalue %kizu.slice.u8 ");
    try append_expr_value_ref(out, insts, inst.target);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_startneg = icmp slt i64 ");
    try append_expr_value_ref(out, insts, inst.start);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_endbefore = icmp slt i64 ");
    try append_expr_value_ref(out, insts, inst.end);
    try out.append_bytes(", ");
    try append_expr_value_ref(out, insts, inst.start);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_endhigh = icmp sgt i64 ");
    try append_expr_value_ref(out, insts, inst.end);
    try out.append_bytes(", %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_srclen");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_badlower = or i1 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_startneg, %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_endbefore");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_bad = or i1 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_badlower, %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_endhigh");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_bad, label %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_slice_oob, label %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_slice_ok");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_slice_oob:");
    try out.append_byte(cast<u8>(10));
    try compiled_util::append_trap_body(out);
    try out.append_bytes("t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_slice_ok:");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_baseptr = extractvalue %kizu.slice.u8 ");
    try append_expr_value_ref(out, insts, inst.target);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_gep = getelementptr i8, ptr %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_baseptr, i64 ");
    try append_expr_value_ref(out, insts, inst.start);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_len = sub i64 ");
    try append_expr_value_ref(out, insts, inst.end);
    try out.append_bytes(", ");
    try append_expr_value_ref(out, insts, inst.start);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_gep, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = insertvalue %kizu.slice.u8 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_base, i64 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_len, 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_var_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirVarExpr
) -> !void {
    // Var is a copy-propagated alias; consumers print %<value> directly.
    return;
}
fn append_const_string_expr(
    out: &var std::string::String,
    llvm_symbol: []u8,
    inst: &compiled_mir::MirConstStringExpr
) -> !void {
    let payload_len = try compiled_util::string_token_decoded_len(
        inst.value,
        "compiled mir llvm: invalid expression string token"
    );
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_ptr = getelementptr [");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(" x i8], ptr @.kizu.compiled.");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes(".s");
    try std::fmt::append_i64(out, inst.string_index);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = insertvalue %kizu.slice.u8 %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_const_bool_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirConstBoolExpr
) -> !void {
    // ConstBool is literal-propagated; consumers print true/false directly.
    return;
}
fn append_const_int_expr(
    out: &var std::string::String,
    id: i64,
    llvm_type: []u8,
    int_value: i64
) -> !void {
    // ConstInt/ConstEnumTag are literal-propagated; consumers print the integer directly.
    return;
}
fn append_union_construct_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirUnionConstructExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    if inst.payload_value < 0 {
        // A payload-less tagged-union variant value is the aggregate { i64 tag, [N x i8] }.
        // Build it by inserting the discriminant into a zeroinitialized union of
        // inst.llvm_type; the payload slot stays zero for a tag-only variant (issue 1157
        // PR-P1). The read side (append_match_union_block) reads the discriminant from
        // field 0, matching this layout.
        try out.append_bytes("  %t");
        try std::fmt::append_i64(out, inst.id);
        try out.append_bytes(" = insertvalue ");
        try out.append_bytes(inst.llvm_type);
        try out.append_bytes(" zeroinitializer, i64 ");
        try std::fmt::append_i64(out, inst.tag);
        try out.append_bytes(", 0");
        try out.append_byte(cast<u8>(10));
        return;
    }
    // A single-payload variant value stores the discriminant into field 0 and the payload
    // value into the field-1 byte buffer of a zero-initialized stack slot, then loads the
    // whole union back (issue 1157 PR-P2). The payload type is narrower than the [N x i8]
    // field, so it is written through the buffer pointer exactly as the read side
    // (append_match_union_block) reads it back: gep field 1 + load payload_type.
    try append_union_construct_alloca(out, inst.id, inst.llvm_type);
    try append_union_construct_store_tag(out, inst.id, inst.llvm_type, inst.tag);
    try append_union_construct_store_payload(out, inst, insts);
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = load ");
    try out.append_bytes(inst.llvm_type);
    try out.append_bytes(", ptr %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_slot, align 8");
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_union_construct_alloca(
    out: &var std::string::String,
    id: i64,
    llvm_type: []u8
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, id);
    try out.append_bytes("_slot = alloca ");
    try out.append_bytes(llvm_type);
    try out.append_bytes(", align 8");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  store ");
    try out.append_bytes(llvm_type);
    try out.append_bytes(" zeroinitializer, ptr %t");
    try std::fmt::append_i64(out, id);
    try out.append_bytes("_slot, align 8");
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_union_construct_store_tag(
    out: &var std::string::String,
    id: i64,
    llvm_type: []u8,
    tag: i64
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, id);
    try out.append_bytes("_tagptr = getelementptr ");
    try out.append_bytes(llvm_type);
    try out.append_bytes(", ptr %t");
    try std::fmt::append_i64(out, id);
    try out.append_bytes("_slot, i32 0, i32 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  store i64 ");
    try std::fmt::append_i64(out, tag);
    try out.append_bytes(", ptr %t");
    try std::fmt::append_i64(out, id);
    try out.append_bytes("_tagptr, align 8");
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_union_construct_store_payload(
    out: &var std::string::String,
    inst: &compiled_mir::MirUnionConstructExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_payloadptr = getelementptr ");
    try out.append_bytes(inst.llvm_type);
    try out.append_bytes(", ptr %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_slot, i32 0, i32 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  store ");
    try out.append_bytes(inst.payload_type);
    try out.append_byte(cast<u8>(32));
    try append_expr_value_ref(out, insts, inst.payload_value);
    try out.append_bytes(", ptr %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes("_payloadptr, align 8");
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_struct_literal_expr(
    out: &var std::string::String,
    llvm_symbol: []u8,
    inst: &compiled_mir::MirStructLiteralExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    // Reuse the statement-level struct renderer for expression payloads. The
    // expression value reference points at the final %v<expr-prefix>_<field> aggregate.
    try append_struct_body_at(
        out, llvm_symbol, inst.llvm_type, &inst.struct_fields, expr_struct_prefix(inst.id)
    );
    return;
}

fn expr_struct_prefix(id: i64) -> i64 {
    return 1000000 + id;
}
fn append_prefix_not_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirPrefixNotExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = xor i1 ");
    try append_expr_value_ref(out, insts, inst.operand);
    try out.append_bytes(", true");
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_field_access_expr(
    out: &var std::string::String,
    inst: &compiled_mir::MirFieldAccessExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(inst.source_type);
    if inst.left >= 0 {
        try out.append_bytes(" ");
        try append_expr_value_ref(out, insts, inst.left);
    } else {
        try out.append_bytes(" %");
        try out.append_bytes(inst.value);
    }
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, inst.source_field_index);
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_call_expr(
    out: &var std::string::String,
    llvm_symbol: []u8,
    inst: &compiled_mir::MirCallExpr
) -> !void {
    let call_prefix = 1000000 + inst.id;
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, llvm_symbol, &inst.call_args, call_prefix
    );
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    try out.append_bytes(" = call ");
    try out.append_bytes(inst.llvm_type);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, inst.call_module_prefix, inst.call_callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(out, &inst.call_args, call_prefix);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}
fn append_expr_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        try append_expr_inst_globals(out, llvm_symbol, inst);
        index = index + 1;
    }
    return;
}
fn append_expr_inst_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    inst: &compiled_mir::MirExprInst
) -> !void {
    match inst {
        ConstString(payload) => try append_const_string_global(out, llvm_symbol, payload);,
        Call(payload) => try compiled_mir_llvm_call::append_call_string_globals(
            out, llvm_symbol, &payload.call_args
        );,
        StructLiteral(payload) => try append_struct_globals_at(
            out, llvm_symbol, &payload.struct_fields, expr_struct_prefix(payload.id)
        );,
        _ => return;,
    }
    return;
}
fn append_const_string_global(
    out: &var std::string::String,
    llvm_symbol: []u8,
    inst: &compiled_mir::MirConstStringExpr
) -> !void {
    let quote = cast<u8>(34);
    let payload_len = try compiled_util::string_token_decoded_len(
        inst.value,
        "compiled mir llvm: invalid expression string token"
    );
    try out.append_bytes("@.kizu.compiled.");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes(".s");
    try std::fmt::append_i64(out, inst.string_index);
    try out.append_bytes(" = private unnamed_addr constant [");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(" x i8] c");
    try out.append_byte(quote);
    try compiled_util::append_string_token_payload(
        out,
        inst.value,
        "compiled mir llvm: invalid expression string token"
    );
    try out.append_byte(quote);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_binary_expr_inst(
    out: &var std::string::String,
    inst: &compiled_mir::MirBinaryExpr,
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !void {
    try out.append_bytes("  %t");
    try std::fmt::append_i64(out, inst.id);
    if std::mem::equal_bytes(inst.op, "and") or std::mem::equal_bytes(inst.op, "or") {
        try out.append_bytes(" = ");
        try out.append_bytes(inst.op);
        try out.append_bytes(" i1 ");
        try append_expr_value_ref(out, insts, inst.left);
        try out.append_bytes(", ");
        try append_expr_value_ref(out, insts, inst.right);
        try out.append_byte(cast<u8>(10));
        return;
    }
    if std::mem::equal_bytes(inst.op, "add") or std::mem::equal_bytes(inst.op, "sub") or
        std::mem::equal_bytes(inst.op, "mul") or std::mem::equal_bytes(inst.op, "div") {
        let arith_type = try binary_operand_type(insts, inst.left);
        try out.append_bytes(" = ");
        if std::mem::equal_bytes(inst.op, "div") {
            try out.append_bytes("sdiv");
        } else {
            try out.append_bytes(inst.op);
        }
        try out.append_byte(cast<u8>(32));
        try out.append_bytes(arith_type);
        try out.append_bytes(" ");
        try append_expr_value_ref(out, insts, inst.left);
        try out.append_bytes(", ");
        try append_expr_value_ref(out, insts, inst.right);
        try out.append_byte(cast<u8>(10));
        return;
    }
    try out.append_bytes(" = icmp ");
    if std::mem::equal_bytes(inst.op, "eq") {
        try out.append_bytes("eq");
    } else {
        if std::mem::equal_bytes(inst.op, "not-eq") {
            try out.append_bytes("ne");
        } else {
            if std::mem::equal_bytes(inst.op, "lt") {
                try out.append_bytes("slt");
            } else {
                if std::mem::equal_bytes(inst.op, "lte") {
                    try out.append_bytes("sle");
                } else {
                    if std::mem::equal_bytes(inst.op, "gt") {
                        try out.append_bytes("sgt");
                    } else {
                        if std::mem::equal_bytes(inst.op, "gte") {
                            try out.append_bytes("sge");
                        } else {
                            return error("compiled mir llvm: unsupported binary op");
                        }
                    }
                }
            }
        }
    }
    let operand_type = try binary_operand_type(insts, inst.left);
    try out.append_byte(cast<u8>(32));
    try out.append_bytes(operand_type);
    try out.append_bytes(" ");
    try append_expr_value_ref(out, insts, inst.left);
    try out.append_bytes(", ");
    try append_expr_value_ref(out, insts, inst.right);
    try out.append_byte(cast<u8>(10));
    return;
}

// binary_operand_type returns the LLVM type of a comparison operand, defaulting
// to i64 when the operand instruction has no recorded type.
fn binary_operand_type(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    operand_id: i64
) -> ![]u8 {
    let operand_type = try expr_inst_type_by_id(insts, operand_id);
    if std::mem::len(operand_type) == 0 {
        return "i64";
    }
    return operand_type;
}

fn append_struct_return(
    out: &var std::string::String,
    function: &compiled_mir::MirFunction
) -> !void {
    try append_struct_globals(out, function.name, &function.struct_fields);
    try out.append_bytes("define ");
    try out.append_bytes(function.return_type.llvm_name);
    try out.append_bytes(" @");
    try out.append_bytes(function.name);
    try out.append_bytes("(");
    try compiled_signature::append_params_signature(out, function.params_spec);
    try out.append_bytes(") {");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("entry:");
    try out.append_byte(cast<u8>(10));
    try append_struct_body(out, function.name, function.return_type.llvm_name, &function.struct_fields);
    try out.append_bytes("  ret ");
    try out.append_bytes(function.return_type.llvm_name);
    if function.struct_fields.len() == 0 {
        try out.append_bytes(" poison");
    } else {
        try out.append_bytes(" %v0_");
        try std::fmt::append_i64(out, function.struct_fields.len() - 1);
    }
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("}");
    try out.append_byte(cast<u8>(10));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_struct_globals(
    out: &var std::string::String,
    llvm_symbol: []u8,
    fields: &std::array::Array<compiled_mir::MirStructField>
) -> !void {
    try append_struct_globals_at(out, llvm_symbol, fields, 0);
    return;
}

fn append_struct_globals_at(
    out: &var std::string::String,
    llvm_symbol: []u8,
    fields: &std::array::Array<compiled_mir::MirStructField>,
    string_index: i64
) -> !void {
    var index = 0;
    while index < fields.len() {
        let field = try fields.at(index);
        if field.kind == compiled_mir::MirStructFieldKind::Call {
            try compiled_mir_llvm_call::append_call_string_globals(
                out, llvm_symbol, &field.call_args
            );
        }
        if field.kind == compiled_mir::MirStructFieldKind::StructLiteral {
            try append_struct_globals_at(
                out, llvm_symbol, &field.nested_fields, nested_struct_prefix(string_index, field.index)
            );
        }
        if field.kind == compiled_mir::MirStructFieldKind::ConstString {
            let quote = cast<u8>(34);
            let payload_len = try compiled_util::string_token_decoded_len(
                field.value,
                "compiled mir llvm: invalid struct string token"
            );
            try out.append_bytes("@.kizu.compiled.");
            try out.append_bytes(llvm_symbol);
            try out.append_bytes(".f");
            try std::fmt::append_i64(out, string_index + field.index);
            try out.append_bytes(" = private unnamed_addr constant [");
            try std::fmt::append_i64(out, payload_len);
            try out.append_bytes(" x i8] c");
            try out.append_byte(quote);
            try compiled_util::append_string_token_payload(
                out,
                field.value,
                "compiled mir llvm: invalid struct string token"
            );
            try out.append_byte(quote);
            try out.append_byte(cast<u8>(10));
        }
        index = index + 1;
    }
    return;
}

fn append_struct_body(
    out: &var std::string::String,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    fields: &std::array::Array<compiled_mir::MirStructField>
) -> !void {
    try append_struct_body_at(out, llvm_symbol, llvm_return_type, fields, 0);
    return;
}

fn append_struct_body_at(
    out: &var std::string::String,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    fields: &std::array::Array<compiled_mir::MirStructField>,
    string_index: i64
) -> !void {
    var index = 0;
    var extract_counter = 0;
    while index < fields.len() {
        let field = try fields.at(index);
        if field.kind == compiled_mir::MirStructFieldKind::ConstString {
            try append_struct_string_field_at(
                out, llvm_symbol, llvm_return_type, field, string_index + field.index, string_index
            );
        } else {
            if field.kind == compiled_mir::MirStructFieldKind::FieldAccess {
                extract_counter = try append_struct_field_access(
                    out,
                    llvm_return_type,
                    field,
                    extract_counter,
                    string_index
                );
            } else {
                if field.kind == compiled_mir::MirStructFieldKind::ComputedBinary {
                    try append_struct_computed_binary_field(
                        out, llvm_return_type, field, string_index
                    );
                } else {
                    if field.kind == compiled_mir::MirStructFieldKind::Call {
                        try append_struct_call_field(
                            out, llvm_symbol, llvm_return_type, field, string_index
                        );
                    } else {
                        if field.kind == compiled_mir::MirStructFieldKind::StructLiteral {
                            try append_struct_nested_field(
                                out, llvm_symbol, llvm_return_type, field, string_index
                            );
                        } else {
                            try append_struct_simple_field(out, llvm_return_type, field, string_index);
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn append_struct_simple_field(
    out: &var std::string::String,
    llvm_return_type: []u8,
    field: &compiled_mir::MirStructField,
    prefix: i64
) -> !void {
    try compiled_util::append_insertvalue_line_with_prefix(
        out,
        llvm_return_type,
        field.index,
        field.llvm_type,
        field.index,
        prefix
    );
    if field.kind == compiled_mir::MirStructFieldKind::Var {
        try out.append_bytes("%");
        try out.append_bytes(field.value);
    } else {
        if field.kind == compiled_mir::MirStructFieldKind::ConstInt or
            field.kind == compiled_mir::MirStructFieldKind::ConstEnumTag {
            try std::fmt::append_i64(out, field.int_value);
        } else {
            if field.kind == compiled_mir::MirStructFieldKind::ConstBool {
                if field.bool_value {
                    try out.append_bytes("true");
                } else {
                    try out.append_bytes("false");
                }
            } else {
                if field.kind == compiled_mir::MirStructFieldKind::EmptySlice {
                    try out.append_bytes("zeroinitializer");
                } else {
                    return error("compiled mir llvm: unsupported struct field");
                }
            }
        }
    }
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, field.index);
    try out.append_byte(cast<u8>(10));
    return;
}

// append_struct_call_field renders a call-valued struct field: the call arg
// setup and the call instruction first, then an insertvalue that feeds the call
// result into the struct chain. The call result name uses the %vc namespace so
// it never collides with the %v struct-chain temporaries. The arg-setup prefix
// is offset past the let/return (small) and expr-context (1000000+) prefixes so
// %arg names stay unique within the function (tracker 961).
fn append_struct_call_field(
    out: &var std::string::String,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    field: &compiled_mir::MirStructField,
    prefix: i64
) -> !void {
    let call_prefix = 3000000 + prefix + field.index;
    try compiled_mir_llvm_call::append_call_arg_setup_with_prefix(
        out, llvm_symbol, &field.call_args, call_prefix
    );
    try out.append_bytes("  %vc");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, field.index);
    try out.append_bytes(" = call ");
    try out.append_bytes(field.llvm_type);
    try out.append_bytes(" @");
    try compiled_mir_llvm_call::append_callee_symbol(
        out, field.call_module_prefix, field.call_callee_name
    );
    try out.append_bytes("(");
    try compiled_mir_llvm_call::append_call_args_with_prefix(
        out, &field.call_args, call_prefix
    );
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try compiled_util::append_insertvalue_line_with_prefix(
        out,
        llvm_return_type,
        field.index,
        field.llvm_type,
        field.index,
        prefix
    );
    try out.append_bytes("%vc");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, field.index);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, field.index);
    try out.append_byte(cast<u8>(10));
    return;
}

// nested_struct_prefix derives the SSA/global prefix for a nested struct literal
// field. prefix + field.index is unique per struct field across a function (the
// string_index ranges reserved per struct are disjoint and field.index stays
// within a struct's range), and the 5000000 offset keeps it clear of the
// let/return (small), expr-context (1000000+) and call-field (3000000+) prefixes
// (tracker 961).
fn nested_struct_prefix(prefix: i64, field_index: i64) -> i64 {
    return 5000000 + prefix + field_index;
}

// append_struct_nested_field renders a nested struct literal field: it builds the
// nested struct in its own %v<nested_prefix>_* insertvalue chain, then feeds the
// nested result into the parent struct's chain at field.index.
fn append_struct_nested_field(
    out: &var std::string::String,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    field: &compiled_mir::MirStructField,
    prefix: i64
) -> !void {
    let nested_prefix = nested_struct_prefix(prefix, field.index);
    let nested = &field.nested_fields;
    try append_struct_body_at(out, llvm_symbol, field.llvm_type, nested, nested_prefix);
    try compiled_util::append_insertvalue_line_with_prefix(
        out,
        llvm_return_type,
        field.index,
        field.llvm_type,
        field.index,
        prefix
    );
    if nested.len() == 0 {
        try out.append_bytes("poison");
    } else {
        let last = try nested.at(nested.len() - 1);
        try out.append_bytes("%v");
        try std::fmt::append_i64(out, nested_prefix);
        try out.append_bytes("_");
        try std::fmt::append_i64(out, last.index);
    }
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, field.index);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_struct_string_field(
    out: &var std::string::String,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    field: &compiled_mir::MirStructField
) -> !void {
    try append_struct_string_field_at(out, llvm_symbol, llvm_return_type, field, field.index, 0);
    return;
}

fn append_struct_string_field_at(
    out: &var std::string::String,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    field: &compiled_mir::MirStructField,
    global_index: i64,
    prefix: i64
) -> !void {
    let payload_len = try compiled_util::string_token_decoded_len(
        field.value,
        "compiled mir llvm: invalid struct string token"
    );
    try out.append_bytes("  %f");
    try std::fmt::append_i64(out, global_index);
    try out.append_bytes("_ptr = getelementptr [");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(" x i8], ptr @.kizu.compiled.");
    try out.append_bytes(llvm_symbol);
    try out.append_bytes(".f");
    try std::fmt::append_i64(out, global_index);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %f");
    try std::fmt::append_i64(out, global_index);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %f");
    try std::fmt::append_i64(out, global_index);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %f");
    try std::fmt::append_i64(out, global_index);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %f");
    try std::fmt::append_i64(out, global_index);
    try out.append_bytes("_base, i64 ");
    try std::fmt::append_i64(out, payload_len);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try compiled_util::append_insertvalue_line_with_prefix(
        out,
        llvm_return_type,
        field.index,
        "%kizu.slice.u8",
        field.index,
        prefix
    );
    try out.append_bytes("%f");
    try std::fmt::append_i64(out, global_index);
    try out.append_bytes("_slice, ");
    try std::fmt::append_i64(out, field.index);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_struct_field_access(
    out: &var std::string::String,
    llvm_return_type: []u8,
    field: &compiled_mir::MirStructField,
    extract_counter: i64,
    prefix: i64
) -> !i64 {
    try out.append_bytes("  %ex");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, extract_counter);
    try out.append_bytes(" = extractvalue ");
    try out.append_bytes(field.source_type);
    try out.append_bytes(" %");
    try out.append_bytes(field.value);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, field.source_field_index);
    try out.append_byte(cast<u8>(10));
    var result_counter = extract_counter;
    if field.int_value >= 0 {
        let next_counter = extract_counter + 1;
        try out.append_bytes("  %ex");
        try std::fmt::append_i64(out, prefix);
        try out.append_bytes("_");
        try std::fmt::append_i64(out, next_counter);
        try out.append_bytes(" = extractvalue ");
        try out.append_bytes(field.nested_source_type);
        try out.append_bytes(" %ex");
        try std::fmt::append_i64(out, prefix);
        try out.append_bytes("_");
        try std::fmt::append_i64(out, extract_counter);
        try out.append_bytes(", ");
        try std::fmt::append_i64(out, field.int_value);
        try out.append_byte(cast<u8>(10));
        result_counter = next_counter;
    }
    try compiled_util::append_insertvalue_line_with_prefix(
        out,
        llvm_return_type,
        field.index,
        field.llvm_type,
        field.index,
        prefix
    );
    try out.append_bytes("%ex");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, result_counter);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, field.index);
    try out.append_byte(cast<u8>(10));
    return result_counter + 1;
}

fn append_struct_computed_binary_field(
    out: &var std::string::String,
    llvm_return_type: []u8,
    field: &compiled_mir::MirStructField,
    prefix: i64
) -> !void {
    try out.append_bytes("  %fc");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, field.index);
    try out.append_bytes("_receiver = extractvalue ");
    try out.append_bytes(field.source_type);
    try out.append_bytes(" %");
    try out.append_bytes(field.value);
    try out.append_bytes(", ");
    try std::fmt::append_i64(out, field.source_field_index);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %fc");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, field.index);
    try out.append_bytes("_left = call i64 @kizu_rt_array_len(%kizu.owned %fc");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, field.index);
    try out.append_bytes("_receiver)");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %fc");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, field.index);
    try out.append_bytes("_value = sub i64 %fc");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, field.index);
    try out.append_bytes("_left, %");
    try out.append_bytes(field.computed_rhs_name);
    try out.append_byte(cast<u8>(10));
    try compiled_util::append_insertvalue_line_with_prefix(
        out,
        llvm_return_type,
        field.index,
        field.llvm_type,
        field.index,
        prefix
    );
    try out.append_bytes("%fc");
    try std::fmt::append_i64(out, prefix);
    try out.append_bytes("_");
    try std::fmt::append_i64(out, field.index);
    try out.append_bytes("_value, ");
    try std::fmt::append_i64(out, field.index);
    try out.append_byte(cast<u8>(10));
    return;
}
