        "  %lpc_us = call %kizu.selfhost.codegen.run_ast @kizu_selfhost__ir_codegen_unsupported_run_ast(%kizu.slice.u8 %lpc_empty)");
    try append_ll_line(out, "  %lpc_uw0 = insertvalue %kizu.error.run_ast poison, i1 true, 0");
    try append_ll_line(out,
        "  %lpc_uw1 = insertvalue %kizu.error.run_ast %lpc_uw0, %kizu.selfhost.codegen.run_ast %lpc_us, 1");
    try append_ll_line(out,
        "  %lpc_uw2 = insertvalue %kizu.error.run_ast %lpc_uw1, %kizu.slice.u8 zeroinitializer, 2");
    try append_ll_line(out, "  ret %kizu.error.run_ast %lpc_uw2");
