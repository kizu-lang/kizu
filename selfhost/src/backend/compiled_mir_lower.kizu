// append_word_keyword resolves a keyword's TokenKind discriminant from the enum-variant facts and
// appends it to word_token's keyword table (tracker 961, scope 4 prerequisite).
fn append_word_keyword(
    ir_bytes: []u8,
    keywords: &var std::array::Array<compiled_mir::MirKeyword>,
    text: []u8,
    variant: []u8
) -> !void {
    let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix(
        ir_bytes, "std::kizu::lexer::", "TokenKind", variant
    );
    try keywords.append(compiled_mir::keyword(text, tag));
    return;
}

// lower_word_token_function lowers std::kizu::lexer::word_token into a single WordToken statement:
// an is_word scan loop, an empty-run single-byte Ident, a keyword table compared via equal_bytes,
// and a multi-byte Ident fallback (tracker 961, scope 4 prerequisite). Its scan loop plus the
// keyword-comparison chain over string constants the generic path does not model, so it is
// dispatched by name. The keyword and Ident discriminants come from the enum-variant facts.
pub fn lower_word_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let ident_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix(
        ir_bytes, "std::kizu::lexer::", "TokenKind", "Ident"
    );
    var keywords = std::array::Array<compiled_mir::MirKeyword>(std::mem::page_allocator());
    try append_word_keyword(ir_bytes, &var keywords, "fn", "Fn");
    try append_word_keyword(ir_bytes, &var keywords, "import", "Import");
    try append_word_keyword(ir_bytes, &var keywords, "pub", "Pub");
    try append_word_keyword(ir_bytes, &var keywords, "struct", "Struct");
    try append_word_keyword(ir_bytes, &var keywords, "enum", "Enum");
    try append_word_keyword(ir_bytes, &var keywords, "union", "Union");
    try append_word_keyword(ir_bytes, &var keywords, "extern", "Extern");
    try append_word_keyword(ir_bytes, &var keywords, "dyn", "Dyn");
    try append_word_keyword(ir_bytes, &var keywords, "let", "Let");
    try append_word_keyword(ir_bytes, &var keywords, "var", "Var");
    try append_word_keyword(ir_bytes, &var keywords, "return", "Return");
    try append_word_keyword(ir_bytes, &var keywords, "defer", "Defer");
    try append_word_keyword(ir_bytes, &var keywords, "if", "If");
    try append_word_keyword(ir_bytes, &var keywords, "else", "Else");
    try append_word_keyword(ir_bytes, &var keywords, "while", "While");
    try append_word_keyword(ir_bytes, &var keywords, "for", "For");
    try append_word_keyword(ir_bytes, &var keywords, "break", "Break");
    try append_word_keyword(ir_bytes, &var keywords, "continue", "Continue");
    try append_word_keyword(ir_bytes, &var keywords, "match", "Match");
    try append_word_keyword(ir_bytes, &var keywords, "unsafe", "Unsafe");
    try append_word_keyword(ir_bytes, &var keywords, "comptime", "Comptime");
    try append_word_keyword(ir_bytes, &var keywords, "try", "Try");
    try append_word_keyword(ir_bytes, &var keywords, "true", "True");
    try append_word_keyword(ir_bytes, &var keywords, "false", "False");
    try append_word_keyword(ir_bytes, &var keywords, "and", "And");
    try append_word_keyword(ir_bytes, &var keywords, "or", "Or");
    try append_word_keyword(ir_bytes, &var keywords, "mut", "Mut");
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::word_token_stmt(
        llvm_symbol, source_name, start_name, current_name, position_type,
        llvm_return_type, "kizu_kizu__lexer_is_word", "kizu_kizu__lexer_token",
        "kizu_selfhost__slice_equal", ident_tag, keywords
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

