    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirCallArg {
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
