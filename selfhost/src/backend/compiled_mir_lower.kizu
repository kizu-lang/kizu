        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_print_payload_function lowers selfhost::ir::codegen::print_payload into a single
// PrintPayload statement: it binds the AstNode off Ast.get and dispatches on the AstData tag -
// String returns string_literal_span, Var returns local_payload_span(locals, ast_node_text(...)),
// and every other variant returns empty_payload_span() (tracker 961, scope 4 prerequisite). The
// String / Var discriminant tags come from the union-variant facts; all four helper callees live
// in this function's own selfhost::ir::codegen module.
pub fn lower_print_payload_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let text_name = try nth_param_field(params_spec, 0, true);
    let ast_type = try nth_param_field(params_spec, 1, false);
    let ast_name = try nth_param_field(params_spec, 1, true);
    let locals_type = try nth_param_field(params_spec, 2, false);
    let locals_name = try nth_param_field(params_spec, 2, true);
    let arg_type = try nth_param_field(params_spec, 3, false);
    let arg_name = try nth_param_field(params_spec, 3, true);
    let string_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "String"
    );
    if !string_variant.found {
        return error("compiled mir: print_payload String variant not found");
    }
    let var_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "Var"
    );
    if !var_variant.found {
        return error("compiled mir: print_payload Var variant not found");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::print_payload_stmt(
        text_name, ast_name, ast_type, locals_name, locals_type, arg_name, arg_type,
        module_prefix, string_variant.tag, var_variant.tag,
        "string_literal_span", "ast_node_text", "local_payload_span", "empty_payload_span"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_print_call_function lowers selfhost::ir::codegen::lower_print_call into a single
