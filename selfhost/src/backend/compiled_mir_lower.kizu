import selfhost::backend::compiled_mir;
import selfhost::backend::compiled_mir_function;
import selfhost::backend::compiled_mir_lower_call;
import selfhost::backend::compiled_mir_lower_struct;
import selfhost::backend::compiled_mir_types;
import selfhost::backend::compiled_util;
import selfhost::backend::compiled_fact_lookup;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_type_lower;
import selfhost::backend::ir_contract;
import selfhost::backend::ir_index;
pub fn lower_string_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    if !std::mem::equal_bytes(llvm_return_type, "%kizu.slice.u8") {
        return error("compiled mir: string return requires []u8");
    }
    let token = try ir_contract::body_token_or_empty_from(
        ir_bytes,
        function_name,
        value_node,
        bs
    );
    let _payload_len = try compiled_util::string_token_decoded_len(
        token,
        "compiled mir: invalid string token"
    );
    return compiled_mir_function::single_const_string_return_function(llvm_symbol, token);
}
pub fn lower_int_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    if !std::mem::equal_bytes(llvm_return_type, "i64") {
        return error("compiled mir: int return requires i64");
    }
    let value = try ir_contract::body_int_value_from(
        ir_bytes,
        function_name,
        value_node,
        bs
    );
    return compiled_mir_function::single_const_int_return_function(llvm_symbol, value);
}
pub fn lower_enum_field_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    if !std::mem::equal_bytes(llvm_return_type, "i64") {
        return error("compiled mir: enum field return requires i64");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes,
        function_name,
        value_node,
        "namespace",
        bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes,
        function_name,
        value_node,
        "receiver",
        0,
        bs
    );
    let receiver_token = try ir_contract::body_token_or_empty_from(
        ir_bytes,
        function_name,
        receiver,
        bs
    );
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index,
        ir_bytes,
        module_prefix,
        receiver_token,
        field_name
    );
    return compiled_mir_function::single_const_int_return_function(llvm_symbol, tag);
}
pub fn lower_call_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes,
        function_name,
        module_prefix,
        call_node,
        bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let call_result_type = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let args = try compiled_mir_lower_call::lower_call_args(
        ir_bytes, function_name, module_prefix, params_spec, call_node, 0, bs
    );
    return compiled_mir_function::single_call_return_function(
        llvm_symbol,
        call_result_type,
        params_spec,
        callee_module_prefix,
        callee_name,
        args
    );
}
// callee_is_field_expr reports whether the value node is a Call whose callee is a
// field-mode FieldExpr, i.e. a struct-field method call (receiver.method()) rather
// than a free function or namespaced call. It distinguishes the read-only AST/array
// accessor lowering (self.children.len() / self.children.get(...)) from the direct
// codegen-helper call lowering and from namespaced calls (Foo::bar(), Variant::X())
// whose callee is a namespace-mode FieldExpr, which must keep using the free-function
// call path (tracker 961).
pub fn callee_is_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, bs
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return false;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, bs
    );
    return std::mem::equal_bytes(callee_mode, "field");
}

pub fn callee_is_field_expr_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return false;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, callee_sf
    );
    return std::mem::equal_bytes(callee_mode, "field");
}

fn call_callee_field_expr_mode_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return 0;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, callee_sf
    );
    if std::mem::equal_bytes(callee_mode, "field") {
        return 1;
    }
    if std::mem::equal_bytes(callee_mode, "namespace") {
        return 2;
    }
    return 0;
}

// is_array_field_type reports whether a recorded struct-field type token is a
// std::array::Array<T>. The read-only Ast.len accessor only lowers Array.len(),
// so this gates the array_len builtin call; any other receiver field type is
// rejected rather than silently mis-lowered (tracker 961).
fn is_array_field_type(field_type: []u8) -> bool {
    return std::mem::starts_with(field_type, "std::array::Array<");
}

fn is_string_value_type(kizu_type: []u8) -> bool {
    return std::mem::equal_bytes(kizu_type, "std::string::String");
}

// array_element_kizu_type strips the std::array::Array<...> wrapper off a recorded
// field type token and returns the element type token (tracker 961). It backs the
// Array<T>.get accessor, which needs the element type to lower the by-value load.
fn array_element_kizu_type(field_type: []u8) -> ![]u8 {
    let prefix = "std::array::Array<";
    let prefix_len = std::mem::len(prefix);
    let field_len = std::mem::len(field_type);
    if field_len <= prefix_len or field_type[field_len - 1] != cast<u8>(62) {
        return error("compiled mir: malformed std::array::Array element type");
    }
    return field_type[prefix_len..field_len - 1];
}

// last_struct_field_index returns the struct-field index of the last lowered field,
// used to name the struct insertvalue chain result (tracker 961). Reading it in a
// helper keeps the borrow of the fields array from outliving the array move.
fn last_struct_field_index(
    fields: &std::array::Array<compiled_mir::MirStructField>
) -> !i64 {
    let last_field = try fields.at(fields.len() - 1);
    return last_field.index;
}

// ast_get_receiver_is_ast reports whether a field-mode .get call's receiver is a
// value std::kizu::ast::Ast (rather than an Array or Arena receiver).
fn ast_get_receiver_is_ast(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return false;
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type(
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs
    );
    let lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    return std::mem::equal_bytes(lookup, "std::kizu::ast::Ast");
}

// lower_multi_let_ast_get lowers 'let <node> = <ast>.get(<node_id>);' into a LetCall
// against the compiled std::kizu::ast::ast_get accessor, binding the AstNode by value.
fn lower_multi_let_ast_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // cf tightens this call's own structural facts (callee/receiver edges, receiver token, arg
    // edge/kind) to the call node's body-node line via the index; the subtree sorts at-or-after
    // it, so a scan from cf is byte-identical to one from bs. The hoisted/single arg lowering
    // recurses into expr lowering, so it keeps bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, cf
    );
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: Ast.get takes one node id argument");
    }
    let arg_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::var_call_arg("%kizu.kizu.ast.ast", receiver_alias));
    var cur_locals = locals_spec;
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, cf);
    var id_arg = compiled_mir::var_call_arg("%kizu.kizu.ast.node_id", "");
    if std::mem::equal_bytes(arg_kind, "TryExpr") {
        let hoist_name = try hoisted_try_arg_name(cur_try);
        let hoist_result = try lower_hoisted_try_arg(
            ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
            arg_node, hoist_name, cur_string, cur_temp, cur_try, aliases, stmts, bs,
            ir_lookup_index, call_arg_type_cache
        );
        cur_locals = hoist_result.locals_spec;
        cur_string = hoist_result.string_counter;
        cur_temp = hoist_result.temp_counter;
        cur_try = hoist_result.try_counter;
        id_arg = compiled_mir::var_call_arg("%kizu.kizu.ast.node_id", hoist_name);
    } else {
        id_arg = try compiled_mir_lower_call::lower_single_call_arg(
            ir_bytes, function_name, module_prefix, cur_locals,
            "%kizu.kizu.ast.node_id", arg_node, cur_string, bs
        );
        if id_arg.kind == compiled_mir::MirCallArgKind::String {
            cur_string = cur_string + 1;
        }
    }
    try args.append(id_arg);
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, cur_locals, let_name, "std::kizu::ast::AstNode"
    );
    try stmts.append(compiled_mir::let_call_stmt(
        let_name, "%kizu.kizu.ast.ast_node", cur_string,
        "std::kizu::ast::", "ast_get", args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: cur_string,
        temp_counter: cur_temp,
        try_counter: cur_try
    };
}

// call_method_name_is reports whether a field-mode call's method name matches name.
pub fn call_method_name_is(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    return std::mem::equal_bytes(method_name, name);
}

pub fn call_method_name_is_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    name: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", callee_sf
    );
    return std::mem::equal_bytes(method_name, name);
}

fn call_method_receiver_is_var(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    return std::mem::equal_bytes(receiver_kind, "Var");
}

struct MethodCallInfo {
    receiver_name: []u8,
    receiver_llvm_type: []u8,
    return_llvm_type: []u8,
    module_prefix: []u8,
    callee_name: []u8,
}

fn append_lower_snake_type_name(out: &var std::string::String, name: []u8) -> !void {
    var index = 0;
    while index < std::mem::len(name) {
        let byte = name[index];
        if byte >= cast<u8>(65) and byte <= cast<u8>(90) {
            if index > 0 {
                try out.append_byte(cast<u8>(95));
            }
            try out.append_byte(byte + cast<u8>(32));
        } else {
            try out.append_byte(byte);
        }
        index = index + 1;
    }
    return;
}

fn method_call_info(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MethodCallInfo {
    // cf tightens this call's own structural reads (callee/receiver edges, field-expr mode/name,
    // receiver kind/token) to the call node's body-node line via the index; the whole-IR
    // type/signature resolutions below route through their _indexed twins. bs is kept for the
    // receiver value resolution, which reads let/param facts that can precede this node.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(mode, "field") {
        return error("compiled mir: method call callee must be field-mode");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, receiver_node, bs);
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: method call receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        receiver_name, bs, call_arg_type_cache
    );
    let receiver_llvm = try compiled_mir_types::kizu_type_to_llvm_indexed_cached(
        ir_lookup_index, ir_bytes, module_prefix, receiver_kizu, call_arg_type_cache
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    let type_prefix = compiled_util::module_prefix_of(lookup_type);
    var impl_prefix = type_prefix;
    if std::mem::len(impl_prefix) == 0 {
        impl_prefix = module_prefix;
    }
    let type_name = lookup_type[std::mem::len(type_prefix)..std::mem::len(lookup_type)];
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", callee_sf
    );
    var qualified = std::string::String(std::mem::page_allocator());
    try qualified.append_bytes(impl_prefix);
    try append_lower_snake_type_name(&var qualified, type_name);
    try qualified.append_byte(cast<u8>(95));
    try qualified.append_bytes(method_name);
    let qualified_name_view = qualified.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(qualified_name_view, qualified_name_view);
    let qualified_name = try copied.get(qualified_name_view);
    let return_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        ir_lookup_index, ir_bytes, "function-signature-return ", ir_bytes[0..0], qualified_name
    );
    if std::mem::len(return_kizu) == 0 {
        return error("compiled mir: method call signature not found");
    }
    let return_llvm = try compiled_mir_types::kizu_type_to_llvm_indexed_cached(
        ir_lookup_index, ir_bytes, impl_prefix, return_kizu, call_arg_type_cache
    );
    let callee_prefix = compiled_util::module_prefix_of(qualified_name);
    return MethodCallInfo {
        receiver_name: receiver_name,
        receiver_llvm_type: receiver_llvm,
        return_llvm_type: return_llvm,
        module_prefix: callee_prefix,
        callee_name: qualified_name[std::mem::len(callee_prefix)..std::mem::len(qualified_name)]
    };
}

// arena_element_kizu_type strips the std::arena::Arena<...> wrapper off a recorded
// field type token and returns the element type token (tracker 961). It backs the
// Arena<T>.add lowering, which needs the element type to construct and marshal it.
fn arena_element_kizu_type(field_type: []u8) -> ![]u8 {
    let prefix = "std::arena::Arena<";
    let prefix_len = std::mem::len(prefix);
    let field_len = std::mem::len(field_type);
    if field_len <= prefix_len or field_type[field_len - 1] != cast<u8>(62) {
        return error("compiled mir: malformed std::arena::Arena element type");
    }
    return field_type[prefix_len..field_len - 1];
}

// lower_multi_let_arena_add lowers a 'let <name> = self.<field>.add(<struct literal>);'
// where <field> is a std::arena::Arena<T> field of a struct value parameter and the
// argument is a struct literal of element type T (tracker 961). It resolves the Arena
// field + element type, lowers the element struct literal fields, and builds a
// LetArenaAdd statement. Ast.add_node is its first consumer.
fn lower_multi_let_arena_add(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // cf tightens this call's own structural facts (callee/receiver/field edges, kinds, tokens,
    // arg edge/kind) to the call node's body-node line via the index; the subtree sorts
    // at-or-after it, so a scan from cf is byte-identical to one from bs. Param type resolution
    // (find_param_*) and the struct-field lowering recursion keep bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", cf
    );
    if !std::mem::equal_bytes(method_name, "add") {
        return error("compiled mir: only Arena.add method let is supported");
    }
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: Arena.add accessor takes one element argument");
    }
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, cf
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Arena.add receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", cf
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, cf
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, cf
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Arena.add field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, cf
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(locals_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, locals_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: Arena.add receiver field not found");
    }
    if !std::mem::starts_with(field.field_type, "std::arena::Arena<") {
        return error("compiled mir: Arena.add receiver field is not a std::arena::Arena");
    }
    let element_kizu_type = try arena_element_kizu_type(field.field_type);
    let element_llvm_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "", element_kizu_type
    );
    let element_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    let element_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, element_node, cf
    );
    if !std::mem::equal_bytes(element_kind, "StructLiteralExpr") {
        return error("compiled mir: Arena.add argument must be a struct literal");
    }
    let fields = try compiled_mir_lower_struct::lower_struct_fields(
        ir_bytes, function_name, module_prefix, locals_spec, element_node, bs
    );
    if fields.len() == 0 {
        return error("compiled mir: Arena.add element struct has no fields");
    }
    let field_count = fields.len();
    let last_field_index = try last_struct_field_index(&fields);
    try stmts.append(compiled_mir::let_arena_add_stmt(
        let_name,
        receiver_llvm_type,
        var_name,
        field.index,
        element_llvm_type,
        last_field_index,
        string_counter,
        fields
    ));
    return MultiLowerResult {
        locals_spec: locals_spec,
        string_counter: string_counter + field_count,
        temp_counter: temp_counter,
        try_counter: try_counter
    };
}

// lower_array_method_return dispatches a 'return self.<field>.<method>(...);' call
// whose callee is a struct-field method to the matching Array accessor lowering:
// len() -> array_len builtin call (Ast.len), get(index) -> the checked element
// accessor (Array<T>.get -> !T). Unsupported methods fail explicitly (tracker 961).
pub fn lower_array_method_return(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if std::mem::equal_bytes(method_name, "len") {
        return try lower_array_len_method_return(
            ir_lookup_index, ir_bytes, function_name, llvm_symbol, params_spec, call_node, bs
        );
    }
    if std::mem::equal_bytes(method_name, "get") {
        // get(index) lowers to the checked Array<T>.get accessor (-> !T) or, when the
        // receiver field is an Arena<T>, the checked Arena<T>.get accessor (-> T, which
        // traps on an out-of-bounds index). Ast.get is the first Arena.get consumer.
        let module_prefix = compiled_util::module_prefix_of(function_name);
        let field_type = try method_receiver_field_type(
            ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec, call_node, bs
        );
        if std::mem::starts_with(field_type, "std::arena::Arena<") {
            return try lower_arena_get_method_return(
                ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, call_node, bs
            );
        }
        return try lower_array_get_method_return(
            ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, call_node, bs
        );
    }
    return error("compiled mir: unsupported array accessor method");
}

// method_receiver_field_type resolves the struct-field type token of a
// self.<field>.<method>(...) method receiver (tracker 961). It lets the get dispatch
// route an Array<T> receiver to the array accessor and an Arena<T> receiver to the
// arena accessor without duplicating the full lowering.
fn method_receiver_field_type(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, params_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: method receiver field not found");
    }
    return field.field_type;
}

// lower_arena_get_method_return lowers a single 'return self.<field>.get(<param>.<field>);'
// where <field> is a std::arena::Arena<T> field of a struct value parameter and the
// index is a field access on a value parameter (NodeId.raw). It is the first Arena<T>.get
// accessor compiled into stage2 (std::kizu::ast::Ast.get -> AstNode): it reads the Arena
// field off the struct value parameter, calls the checked @kizu_rt_arena_get runtime
// helper, and on success loads the AstNode element by value and returns it; an
// out-of-bounds index traps (Arena.get panics rather than returning an error union).
pub fn lower_arena_get_method_return(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: Arena.get accessor takes one index argument");
    }
    // The method receiver is the arena field expression self.<field>.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(params_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, params_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: Arena.get receiver field not found");
    }
    if !std::mem::starts_with(field.field_type, "std::arena::Arena<") {
        return error("compiled mir: Arena.get receiver field is not a std::arena::Arena");
    }
    // The single argument is a field access on a value parameter (id.raw).
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    let index_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, index_node, bs
    );
    if !std::mem::equal_bytes(index_kind, "FieldExpr") {
        return error("compiled mir: Arena.get index must be a parameter field access");
    }
    let index_field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, index_node, "field", bs
    );
    let index_var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, index_node, "receiver", 0, bs
    );
    let index_var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, index_var_node, bs
    );
    if !std::mem::equal_bytes(index_var_kind, "Var") {
        return error("compiled mir: Arena.get index receiver must be a parameter");
    }
    let index_param_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_var_node, bs
    );
    let index_param_type = try compiled_signature::find_param_type(params_spec, index_param_name);
    let index_struct_kizu = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, index_param_name, params_spec
    );
    let index_lookup_type = compiled_mir_types::struct_lookup_kizu_type(index_struct_kizu);
    let index_field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, index_lookup_type, index_field_name
    );
    if !index_field.found {
        return error("compiled mir: Arena.get index field not found");
    }
    return compiled_mir_function::single_arena_get_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        receiver_llvm_type,
        var_name,
        field.index,
        index_param_type,
        index_param_name,
        index_field.index
    );
}

// is_match_union_function reports whether a function body is the 'let node =
// self.get(index); return match node.data { ... };' read-only AST accessor shape that
// lower_match_union_return_function compiles (tracker 961): two statements, a let bound
// to a field-mode method call, followed by a return whose value is a match.
pub fn is_match_union_function(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 2 {
        return false;
    }
    let let_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let let_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, let_stmt, bs);
    if !std::mem::equal_bytes(let_kind, "Let") {
        return false;
    }
    let let_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_stmt, "value", 0, bs
    );
    let let_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, let_value, bs
    );
    if !std::mem::equal_bytes(let_value_kind, "Call") {
        return false;
    }
    if !try callee_is_field_expr(ir_bytes, function_name, let_value, bs) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let return_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, return_stmt, bs
    );
    if !std::mem::equal_bytes(return_kind, "Return") {
        return false;
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    let return_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, return_value, bs
    );
    return std::mem::equal_bytes(return_value_kind, "Match");
}

// lower_match_union_return_function lowers the first 'let node = self.get(index);
// return match node.data { Variant(bind) => bind.<field>.<field>, _ => <int> };'
// read-only AST accessor compiled into stage2 (selfhost::ast::declaration_count -> i64,
// tracker 961). It binds an AstNode by value off an Ast.get method call, then matches on
// the AstNode/AstData tagged-union value: it resolves the AstNode data field index, the
// matched variant's discriminant tag + inline payload type (from the union-variant fact),
// and the two-level field access off the bound payload; the default arm returns a literal.
// It deliberately models only the single matched variant payload struct, not the 44 union
// variants, and never lowers an arm to 'unreachable'.
pub fn lower_match_union_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let ast_module_prefix = "std::kizu::ast::";
    let union_qualified = "std::kizu::ast::AstData";
    // Statement 0: let <node> = <receiver>.get(<index>);
    let let_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let let_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_stmt, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, let_name_node, bs
    );
    let call_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_stmt, "value", 0, bs
    );
    let call_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, call_node, bs);
    if !std::mem::equal_bytes(call_kind, "Call") {
        return error("compiled mir: match-union let must bind a method call");
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return error("compiled mir: match-union accessor binds an Ast.get call");
    }
    let recv_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let recv_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, recv_node, bs);
    if !std::mem::equal_bytes(recv_kind, "Var") {
        return error("compiled mir: match-union get receiver must be a parameter");
    }
    let recv_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, recv_node, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: match-union get takes one index argument");
    }
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    let index_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, index_node, bs);
    if !std::mem::equal_bytes(index_kind, "Var") {
        return error("compiled mir: match-union get index must be a parameter");
    }
    let index_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_node, bs
    );
    let receiver_type = try compiled_signature::find_param_type(params_spec, recv_name);
    let index_type = try compiled_signature::find_param_type(params_spec, index_name);
    // Statement 1: return match <node>.data { ... };
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let return_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, return_stmt, bs);
    if !std::mem::equal_bytes(return_kind, "Return") {
        return error("compiled mir: match-union second statement must be a return");
    }
    let match_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    let match_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, match_node, bs);
    if !std::mem::equal_bytes(match_kind, "Match") {
        return error("compiled mir: match-union return value must be a match");
    }
    // Scrutinee: <node>.data resolves the AstNode union field index.
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, scrutinee, bs
    );
    if !std::mem::equal_bytes(scrutinee_kind, "FieldExpr") {
        return error("compiled mir: match-union scrutinee must be a field access");
    }
    let scrutinee_field = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, scrutinee, "field", bs
    );
    let scrutinee_var = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scrutinee, "receiver", 0, bs
    );
    let scrutinee_var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scrutinee_var, bs
    );
    if !std::mem::equal_bytes(scrutinee_var_name, let_name) {
        return error("compiled mir: match-union scrutinee must read the bound node");
    }
    let data_field_index = try compiled_fact_lookup::lookup_struct_field_index_by_prefix_indexed(
        ir_lookup_index, ir_bytes, ast_module_prefix, "AstNode", scrutinee_field
    );
    // Two arms: index 0 is the variant arm, index 1 is the default '_' arm.
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_node, "arm", bs
    );
    if arm_count != 2 {
        return error("compiled mir: match-union accessor expects two arms");
    }
    let variant_arm = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "arm", 0, bs
    );
    let variant_pattern = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, variant_arm, "pattern", 0, bs
    );
    let variant_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, variant_pattern, bs
    );
    let binding_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, variant_arm, "binding", 0, bs
    );
    let binding_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, binding_node, bs
    );
    // The variant arm body is 'bind.<field0>.<field1>' (an ExprStmt-wrapped field chain).
    let variant_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, variant_arm, "body", 0, bs
    );
    let outer_field_expr = try match_union_arm_expr(ir_bytes, function_name, variant_body, bs);
    let outer_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, outer_field_expr, bs
    );
    if !std::mem::equal_bytes(outer_kind, "FieldExpr") {
        return error("compiled mir: match-union arm body must be a field access chain");
    }
    let field1_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, outer_field_expr, "field", bs
    );
    let inner_field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, outer_field_expr, "receiver", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, inner_field_expr, bs
    );
    if !std::mem::equal_bytes(inner_kind, "FieldExpr") {
        return error("compiled mir: match-union arm body must chain two field accesses");
    }
    let field0_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, inner_field_expr, "field", bs
    );
    let inner_recv = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner_field_expr, "receiver", 0, bs
    );
    let inner_recv_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, inner_recv, bs
    );
    if !std::mem::equal_bytes(inner_recv_name, binding_name) {
        return error("compiled mir: match-union arm body must read the bound payload");
    }
    // Default arm: '_ => <int>'.
    let default_arm = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "arm", 1, bs
    );
    let default_pattern = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, default_arm, "pattern", 0, bs
    );
    let default_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, default_pattern, bs
    );
    if !std::mem::equal_bytes(default_name, "_") {
        return error("compiled mir: match-union accessor default arm must be '_'");
    }
    let default_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, default_arm, "body", 0, bs
    );
    let default_int_node = try match_union_arm_expr(ir_bytes, function_name, default_body, bs);
    let default_int_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, default_int_node, bs
    );
    if !std::mem::equal_bytes(default_int_kind, "Int") {
        return error("compiled mir: match-union default arm must return an integer literal");
    }
    let default_value = try ir_contract::body_int_value_from(
        ir_bytes, function_name, default_int_node, bs
    );
    // Resolve the matched variant's tag + inline payload struct, then the field chain.
    let variant = try compiled_fact_lookup::lookup_union_variant_by_prefix_indexed(
        ir_lookup_index, ir_bytes, ir_bytes[0..0], union_qualified, variant_name
    );
    if !variant.found {
        return error("compiled mir: match-union variant not found");
    }
    let payload_kizu = variant.payload_kizu;
    let payload_module = compiled_util::module_prefix_of(payload_kizu);
    let payload_short = payload_kizu[std::mem::len(payload_module)..std::mem::len(payload_kizu)];
    let payload_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, ir_bytes[0..0], payload_kizu
    );
    let field0 = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, payload_module, payload_short, field0_name
    );
    if !field0.found {
        return error("compiled mir: match-union arm payload field not found");
    }
    let field0_type_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, payload_module, field0.field_type
    );
    let field1 = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, payload_module, field0.field_type, field1_name
    );
    if !field1.found {
        return error("compiled mir: match-union arm payload subfield not found");
    }
    return compiled_mir_function::single_match_union_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        receiver_type,
        recv_name,
        index_type,
        index_name,
        data_field_index,
        variant.tag,
        payload_llvm,
        field0.index,
        field0_type_llvm,
        field1.index,
        default_value
    );
}

// match_union_is_field_chain_accessor reports whether a default-arm match-union accessor
// is the narrow declaration_count shape: exactly two arms whose variant arm body is a
// payload field-access chain. Any other default-arm match (e.g. arms that call helpers)
// routes through the generalized traversal lowering instead.
pub fn match_union_is_field_chain_accessor(
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !bool {
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let match_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_node, "arm", bs
    );
    if arm_count != 2 {
        return false;
    }
    let variant_arm = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "arm", 0, bs
    );
    let variant_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, variant_arm, "body", 0, bs
    );
    let arm_expr = try match_union_arm_expr(ir_bytes, function_name, variant_body, bs);
    let arm_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arm_expr, bs);
    return std::mem::equal_bytes(arm_kind, "FieldExpr");
}

// match_union_has_default_arm reports whether the match in a 'let node = self.get(index);
// return match node.data { ... };' body has a trailing '_' default arm. The single matched
// variant + default arm shape (declaration_count) has one; the exhaustive node_count
// traversal (one arm per variant) has none (tracker 961).
pub fn match_union_has_default_arm(
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !bool {
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let match_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_node, "arm", bs
    );
    var index = 0;
    while index < arm_count {
        let arm = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_node, "arm", index, bs
        );
        let pattern = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm, "pattern", 0, bs
        );
        let name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, pattern, bs
        );
        if std::mem::equal_bytes(name, "_") {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// lower_traversal_match_function lowers the node_count recursive AST-traversal accessor:
// 'let node = tree.get(node_id); return match node.data { <44 arms> };' where each arm is
// either 'Variant(bind) => try count_X(tree, bind.f, ...)' or a leaf 'Variant(_) => 1' /
// 'Empty => 1' (tracker 961). It binds the AstNode by value off the Ast.get call, then walks
// every variant arm: a try-call arm resolves the discriminant tag + inline payload struct,
// the count_* callee, and the forwarded payload-field args; a leaf arm carries the literal.
// All arms return a real value through the exhaustive icmp/br chain the renderer emits.
pub fn lower_traversal_match_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let ast_module_prefix = "std::kizu::ast::";
    let union_qualified = "std::kizu::ast::AstData";
    var node_cache = compiled_mir_types::call_arg_type_cache();
    defer node_cache.deinit();
    try compiled_mir_types::build_fn_node_index(
        &var node_cache, ir_lookup_index, ir_bytes, function_name
    );
    let root_sf = compiled_mir_types::fn_node_line_start(&node_cache, 0, bs);
    // Statement 0: let <node> = <tree>.get(<node_id>);
    let let_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, root_sf
    );
    let let_sf = compiled_mir_types::fn_node_line_start(&node_cache, let_stmt, bs);
    let let_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_stmt, "name", 0, let_sf
    );
    let let_name_sf = compiled_mir_types::fn_node_line_start(&node_cache, let_name_node, bs);
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, let_name_node, let_name_sf
    );
    let call_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_stmt, "value", 0, let_sf
    );
    let call_sf = compiled_mir_types::fn_node_line_start(&node_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, call_sf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(&node_cache, callee_node, bs);
    let recv_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let recv_sf = compiled_mir_types::fn_node_line_start(&node_cache, recv_node, bs);
    let recv_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, recv_node, recv_sf
    );
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, call_sf
    );
    let index_sf = compiled_mir_types::fn_node_line_start(&node_cache, index_node, bs);
    let index_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_node, index_sf
    );
    let receiver_type = try compiled_signature::find_param_type(params_spec, recv_name);
    let index_type = try compiled_signature::find_param_type(params_spec, index_name);
    // Statement 1: return match <node>.data { ... };
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, root_sf
    );
    let return_sf = compiled_mir_types::fn_node_line_start(&node_cache, return_stmt, bs);
    let match_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, return_sf
    );
    let match_sf = compiled_mir_types::fn_node_line_start(&node_cache, match_node, bs);
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "value", 0, match_sf
    );
    let scrutinee_sf = compiled_mir_types::fn_node_line_start(&node_cache, scrutinee, bs);
    let scrutinee_field = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, scrutinee, "field", scrutinee_sf
    );
    let data_field_index = try compiled_fact_lookup::lookup_struct_field_index_by_prefix_indexed(
        ir_lookup_index, ir_bytes, ast_module_prefix, "AstNode", scrutinee_field
    );
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_node, "arm", match_sf
    );
    var arms = std::array::Array<compiled_mir::MirTraversalArm>(std::mem::page_allocator());
    var index = 0;
    while index < arm_count {
        let arm_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_node, "arm", index, match_sf
        );
        let arm = try build_traversal_arm(
            ir_lookup_index, &node_cache, ir_bytes, function_name, module_prefix,
            union_qualified, params_spec, llvm_return_type, arm_node, bs
        );
        try arms.append(arm);
        index = index + 1;
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::match_traversal_stmt(
        receiver_type,
        recv_name,
        index_type,
        index_name,
        data_field_index,
        llvm_return_type,
        arms
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// build_traversal_arm lowers one node_count match arm into a MirTraversalArm: a leaf 'Int'
// body becomes a literal arm; a 'try count_X(tree, bind.f, ...)' body becomes a try-call arm
// carrying the discriminant tag, inline payload struct, count_* callee, and the forwarded
// payload-field args resolved against the payload struct-field facts (tracker 961).
fn build_traversal_arm(
    ir_lookup_index: &ir_index::IrIndex,
    node_cache: &compiled_mir_types::CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    union_qualified: []u8,
    params_spec: []u8,
    llvm_return_type: []u8,
    arm_node: i64,
    bs: i64
) -> !compiled_mir::MirTraversalArm {
    let arm_sf = compiled_mir_types::fn_node_line_start(node_cache, arm_node, bs);
    let pattern = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arm_node, "pattern", 0, arm_sf
    );
    let pattern_sf = compiled_mir_types::fn_node_line_start(node_cache, pattern, bs);
    let variant_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, pattern, pattern_sf
    );
    // A '_' default arm matches no variant: it carries no payload and must stay the
    // exhaustive fallthrough (the renderer treats the last arm as unconditional).
    var tag = 0 - 1;
    var payload_kizu = ir_bytes[0..0];
    var payload_module = ir_bytes[0..0];
    var payload_short = ir_bytes[0..0];
    let is_default = std::mem::equal_bytes(variant_name, "_");
    if !is_default {
        let variant = try compiled_fact_lookup::lookup_union_variant_by_prefix_indexed(
            ir_lookup_index, ir_bytes, ir_bytes[0..0], union_qualified, variant_name
        );
        if !variant.found {
            return error("compiled mir: traversal arm variant not found");
        }
        tag = variant.tag;
        payload_kizu = variant.payload_kizu;
        payload_module = compiled_util::module_prefix_of(payload_kizu);
        payload_short = payload_kizu[std::mem::len(payload_module)..std::mem::len(payload_kizu)];
    }
    let arm_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arm_node, "body", 0, arm_sf
    );
    let arm_body_sf = compiled_mir_types::fn_node_line_start(node_cache, arm_body, bs);
    let arm_expr = try match_union_arm_expr(ir_bytes, function_name, arm_body, arm_body_sf);
    let arm_expr_sf = compiled_mir_types::fn_node_line_start(node_cache, arm_expr, bs);
    let arm_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arm_expr, arm_expr_sf);
    if std::mem::equal_bytes(arm_kind, "Int") {
        let value = try ir_contract::body_int_value_from(ir_bytes, function_name, arm_expr, arm_expr_sf);
        return compiled_mir::traversal_literal_arm(tag, value);
    }
    if std::mem::equal_bytes(arm_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arm_expr, arm_expr_sf
        );
        return compiled_mir::traversal_bool_literal_arm(
            tag, std::mem::equal_bytes(token, "true")
        );
    }
    if std::mem::equal_bytes(arm_kind, "Call") {
        // A plain-call arm returns the function's success value directly; the renderer
        // wraps the callee result into the own error union. The callee's success LLVM
        // type resolves from its signature fact.
        let plain_callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, arm_expr, arm_expr_sf
        );
        let plain_ret = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
            ir_lookup_index, ir_bytes, "function-signature-return ", module_prefix, plain_callee
        );
        if std::mem::len(plain_ret) == 0 {
            return error("compiled mir: traversal arm call return type not found");
        }
        let success_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, module_prefix, plain_ret
        );
        let plain_args = try build_traversal_arm_args(
            ir_lookup_index, node_cache, ir_bytes, function_name, params_spec, payload_module,
            payload_short, arm_expr, bs
        );
        let plain_payload_llvm = try traversal_arm_payload_llvm(
            ir_lookup_index, ir_bytes, payload_kizu, &plain_args
        );
        return compiled_mir::traversal_plain_call_arm(
            tag, plain_payload_llvm, module_prefix, plain_callee, success_llvm, plain_args
        );
    }
    if !std::mem::equal_bytes(arm_kind, "TryExpr") {
        return error("compiled mir: traversal arm must be a call, 'try <call>', or an int literal");
    }
    let inner_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arm_expr, "value", 0, arm_expr_sf
    );
    let inner_sf = compiled_mir_types::fn_node_line_start(node_cache, inner_call, bs);
    let inner_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, inner_call, inner_sf
    );
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: traversal arm try must wrap a call");
    }
    // The try-call arm's callee must share this function's error-union return so its
    // result returns as an identity tail; validated by the renderer's call type.
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, inner_call, inner_sf
    );
    let args = try build_traversal_arm_args(
        ir_lookup_index, node_cache, ir_bytes, function_name, params_spec, payload_module,
        payload_short, inner_call, bs
    );
    let payload_llvm = try traversal_arm_payload_llvm(
        ir_lookup_index, ir_bytes, payload_kizu, &args
    );
    return compiled_mir::traversal_try_arm(
        tag, payload_llvm, module_prefix, callee_name, args
    );
}

// traversal_arm_payload_llvm resolves the matched variant payload's LLVM type only when an
// arm argument actually extracts a payload field. Arms that only forward parameters (e.g.
// the tape descent's 'Int(int_node) => try lower_code_int(text, ast, node_id, code, ...)'
// where the binding is unused) skip the lookup, so leaf variants whose payload structs are
// deliberately unmodelled stay compilable.
fn traversal_arm_payload_llvm(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    payload_kizu: []u8,
    args: &std::array::Array<compiled_mir::MirTraversalArg>
) -> ![]u8 {
    var index = 0;
    while index < args.len() {
        let arg = try args.at(index);
        if !arg.is_param and !arg.is_literal {
            return try compiled_type_lower::kizu_type_to_llvm_indexed(
                ir_lookup_index, ir_bytes, ir_bytes[0..0], payload_kizu
            );
        }
        index = index + 1;
    }
    return ir_bytes[0..0];
}

// build_traversal_arm_args lowers every call argument of a traversal arm explicitly: a
// Var argument forwards a caller parameter by name (typed from the params_spec), and a
// FieldExpr argument extracts the named field off the matched variant payload. Nothing
// is implicit, so arms can mix forwarded parameters with payload fields in any order.
fn build_traversal_arm_args(
    ir_lookup_index: &ir_index::IrIndex,
    node_cache: &compiled_mir_types::CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    params_spec: []u8,
    payload_module: []u8,
    payload_short: []u8,
    call_node: i64,
    bs: i64
) -> !std::array::Array<compiled_mir::MirTraversalArg> {
    let call_sf = compiled_mir_types::fn_node_line_start(node_cache, call_node, bs);
    let call_arg_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, call_node, "arg", call_sf
    );
    var args = std::array::Array<compiled_mir::MirTraversalArg>(std::mem::page_allocator());
    var arg_index = 0;
    while arg_index < call_arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, call_sf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(node_cache, arg_node, bs);
        let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, arg_sf);
        if std::mem::equal_bytes(arg_kind, "Int") {
            let literal = try ir_contract::body_int_value_from(
                ir_bytes, function_name, arg_node, arg_sf
            );
            try args.append(compiled_mir::traversal_literal_arg(literal));
        } else {
        if std::mem::equal_bytes(arg_kind, "Var") {
            let arg_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, arg_node, arg_sf
            );
            let arg_type = try compiled_signature::find_param_type(params_spec, arg_name);
            try args.append(compiled_mir::traversal_param_arg(arg_name, arg_type));
        } else {
            if !std::mem::equal_bytes(arg_kind, "FieldExpr") {
                return error("compiled mir: traversal arm arg must be a parameter, literal, or payload field");
            }
            if std::mem::len(payload_short) == 0 {
                return error("compiled mir: traversal default arm cannot read a payload field");
            }
            let field_name = try ir_contract::body_field_expr_name_from(
                ir_bytes, function_name, arg_node, "field", arg_sf
            );
            let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
                ir_lookup_index, ir_bytes, payload_module, payload_short, field_name
            );
            if !field.found {
                return error("compiled mir: traversal arm payload field not found");
            }
            let field_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
                ir_lookup_index,
                ir_bytes, payload_module, field.field_type
            );
            try args.append(compiled_mir::traversal_arg(field.index, field_llvm));
        }
        }
        arg_index = arg_index + 1;
    }
    return args;
}

// is_count_range_function reports whether a function is count_range's accumulator shape:
// 'var count = 0; var index = 0; while ... { ... } return count;' (4 statements, two leading
// Let inits, a While, then a Return, tracker 961).
pub fn is_count_range_function(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 4 {
        return false;
    }
    let s0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 0, bs);
    let k0 = try ir_contract::body_node_kind_from(ir_bytes, function_name, s0, bs);
    if !std::mem::equal_bytes(k0, "Let") {
        return false;
    }
    let s1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 1, bs);
    let k1 = try ir_contract::body_node_kind_from(ir_bytes, function_name, s1, bs);
    if !std::mem::equal_bytes(k1, "Let") {
        return false;
    }
    let s2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 2, bs);
    let k2 = try ir_contract::body_node_kind_from(ir_bytes, function_name, s2, bs);
    if !std::mem::equal_bytes(k2, "While") {
        return false;
    }
    let s3 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 3, bs);
    let k3 = try ir_contract::body_node_kind_from(ir_bytes, function_name, s3, bs);
    if !std::mem::equal_bytes(k3, "Return") {
        return false;
    }
    // The count_range accumulator seeds both counters from integer literals ('var count = 0;
    // var index = 0;') and returns the accumulator local ('return count;'). A multi-counter
    // import-sort loop like import_path_less has base-plus-offset inits ('var left_index =
    // left + 1;') and a bool return ('return false;'), so it must fall through to the generic
    // multi-statement path instead of being mis-detected as the child_at / node_count
    // traversal template (issue 1165 / 1162).
    let s0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0, "value", 0, bs);
    let s0_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, s0_value, bs);
    if !std::mem::equal_bytes(s0_value_kind, "Int") {
        return false;
    }
    let s1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "value", 0, bs);
    let s1_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, s1_value, bs);
    if !std::mem::equal_bytes(s1_value_kind, "Int") {
        return false;
    }
    let s3_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s3, "value", 0, bs);
    let s3_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, s3_value, bs);
    return std::mem::equal_bytes(s3_value_kind, "Var");
}

// nth_param_field returns the name (want_name true) or LLVM type (false) of the index-th
// param in a 'type name;type name;...' params_spec.
fn nth_param_field(params_spec: []u8, index: i64, want_name: bool) -> ![]u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    var current = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            if current == index {
                if want_name {
                    return params_spec[space_pos + 1..entry_end];
                }
                return params_spec[pos..space_pos];
            }
            current = current + 1;
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return error("compiled mir: count_range param index out of range");
}

// lower_count_range_function lowers count_range into a single CountRange statement: a two-phi
// accumulator loop over the range that calls Ast.child_at and the recursive node_count with
// try-propagation (tracker 961). The receiver (tree) and range are the first two params; the
// recursive callee is this module's node_count.
pub fn lower_count_range_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let receiver_type = try nth_param_field(params_spec, 0, false);
    let receiver_name = try nth_param_field(params_spec, 0, true);
    let range_name = try nth_param_field(params_spec, 1, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::count_range_stmt(
        receiver_name, receiver_type, range_name,
        module_prefix, "node_count", llvm_return_type
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_trim_ascii_function lowers std::mem::trim_ascii into a single TrimAscii statement: two
// break-on-condition search loops that advance %start past leading ASCII spaces and retreat
// %end past trailing ones, returning the trimmed two-bound slice (tracker 961). The byte
// classifier callee is std::mem::is_ascii_space; std symbols are not derivable through the
// selfhost-prefixed callee mangler, so the fully-mangled symbol is passed with an empty module.
pub fn lower_trim_ascii_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let bytes_name = try nth_param_field(params_spec, 0, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::trim_ascii_stmt(
        bytes_name, "", "kizu_std__mem_is_ascii_space"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_ast_node_text_function lowers selfhost::ir::codegen::ast_node_text into a single
// AstNodeText statement: it binds the AstNode by value off Ast.get, extracts the Span (AstNode
// field 0) and its start/end, slices the text two-bound, and forwards the slice to trim_ascii
// (tracker 961). The trim callee is std::mem::trim_ascii, passed as a fully-mangled std symbol
// with an empty module prefix.
// lower_advance_position_function lowers std::kizu::lexer::advance_position into a single
// AdvancePosition statement: a two-phi loop threading the i64 index and the Position struct
// current, feeding source[index] + current into the already-compiled advance_byte each iteration
// (tracker 961, scope 4 prerequisite). Its struct loop-carried variable and struct-returning
// call-in-loop the generic while machinery does not model, so it is dispatched by name.
pub fn lower_advance_position_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let source_type = try nth_param_field(params_spec, 0, false);
    let start_name = try nth_param_field(params_spec, 1, true);
    let end_name = try nth_param_field(params_spec, 2, true);
    let initial_name = try nth_param_field(params_spec, 3, true);
    let position_type = try nth_param_field(params_spec, 3, false);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::advance_position_stmt(
        source_name, source_type, start_name, end_name, initial_name,
        position_type, "kizu_kizu__lexer_advance_byte"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_number_token_function lowers std::kizu::lexer::number_token into a single NumberToken
// statement: an i64 end phi that scans forward while source[end] is a digit, then builds the
// Number Token (tracker 961, scope 4 prerequisite). Its compound 'end < len and is_digit(...)'
// loop condition with a per-byte index load the generic while machinery does not model, so it is
// dispatched by name. The TokenKind::Number tag is resolved from the enum-variant facts.
pub fn lower_number_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let source_type = try nth_param_field(params_spec, 0, false);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let number_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Number"
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::number_token_stmt(
        source_name, source_type, start_name, current_name, position_type,
        llvm_return_type, "kizu_kizu__lexer_is_digit", "kizu_kizu__lexer_token", number_tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_string_token_function lowers std::kizu::lexer::string_token into a single StringToken
// statement: quoted strings scan to the closing quote, while double-slash multiline strings scan
// through indented continuations. The generic while machinery does not model these byte-scanning
// loops, so it is dispatched by name. The TokenKind::String tag is resolved from the enum-variant
// facts.
pub fn lower_string_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let string_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "String"
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::string_token_stmt(
        source_name, start_name, current_name, position_type,
        llvm_return_type, "kizu_kizu__lexer_token", string_tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// append_single_op resolves a single-char operator's TokenKind tag and appends a no-look-ahead
// entry to raw_token_at's dispatch table (tracker 961, scope 4 prerequisite).
fn append_single_op(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    ops: &var std::array::Array<compiled_mir::MirOperator>,
    byte: i64,
    variant: []u8
) -> !void {
    let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", variant
    );
    try ops.append(compiled_mir::operator(byte, tag, 0 - 1, 0 - 1, 0 - 1, 0 - 1));
    return;
}

// append_two_op resolves a two-char-or-single operator's tags and appends a single look-ahead
// entry (tracker 961, scope 4 prerequisite).
fn append_two_op(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    ops: &var std::array::Array<compiled_mir::MirOperator>,
    byte: i64,
    single_variant: []u8,
    second_byte: i64,
    two_variant: []u8
) -> !void {
    let single_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", single_variant
    );
    let two_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", two_variant
    );
    try ops.append(compiled_mir::operator(byte, single_tag, second_byte, two_tag, 0 - 1, 0 - 1));
    return;
}

// lower_raw_token_function lowers std::kizu::lexer::raw_token_at into a single RawToken statement:
// an Eof guard, an operator dispatch table over the byte at start, then quote / multiline-string /
// digit / word fallbacks to string_token / number_token / word_token (tracker 961, scope 4
// prerequisite). Its many-arm byte dispatch with two- and three-char look-aheads the generic path
// does not model, so it is dispatched by name. All TokenKind tags come from the enum-variant facts.
pub fn lower_raw_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let eof_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Eof"
    );
    var ops = std::array::Array<compiled_mir::MirOperator>(std::mem::page_allocator());
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 123, "LBrace");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 125, "RBrace");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 40, "LParen");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 41, "RParen");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 59, "Semicolon");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 44, "Comma");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 33, "Bang", 61, "NotEq");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 38, "Amp");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 60, "LT", 61, "LTE");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 62, "GT", 61, "GTE");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 63, "Question");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 91, "LBracket");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 93, "RBracket");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 58, "Colon", 58, "DoubleColon");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 45, "Minus", 62, "Arrow");
    // '=' is the only three-way operator: '==' -> Eq, '=>' -> FatArrow, else Assign.
    let assign_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Assign"
    );
    let eq_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Eq"
    );
    let fat_arrow_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "FatArrow"
    );
    try ops.append(compiled_mir::operator(61, assign_tag, 61, eq_tag, 62, fat_arrow_tag));
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 43, "Plus");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 42, "Asterisk");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 47, "Slash");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 37, "Percent");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 46, "Dot", 46, "Range");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 124, "Pipe");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 64, "At");
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::raw_token_stmt(
        source_name, start_name, current_name, position_type, llvm_return_type,
        "kizu_kizu__lexer_token", "kizu_kizu__lexer_is_digit", "kizu_kizu__lexer_string_token",
        "kizu_kizu__lexer_number_token", "kizu_kizu__lexer_word_token", eof_tag, ops
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// token_kind_predicate_match_node unwraps the two parser predicate spellings: compact
// 'return match token.kind { ... };' and exhaustive statement 'match token.kind { X => return ...; }'
// (tracker 961, scope 4 prerequisite).
fn token_kind_predicate_match_node(
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !i64 {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let statement_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, statement, bs
    );
    if std::mem::equal_bytes(statement_kind, "Return") {
        let value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, statement, "value", 0, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value, bs
        );
        if !std::mem::equal_bytes(value_kind, "Match") {
            return error("compiled mir: token-kind predicate return value must be a match");
        }
        return value;
    }
    if std::mem::equal_bytes(statement_kind, "Match") {
        return statement;
    }
    if std::mem::equal_bytes(statement_kind, "ExprStmt") {
        let expr = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, statement, "expr", 0, bs
        );
        let expr_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, expr, bs
        );
        if std::mem::equal_bytes(expr_kind, "Match") {
            return expr;
        }
    }
    return error("compiled mir: token-kind predicate body must be a match");
}

fn token_kind_predicate_arm_value(
    ir_bytes: []u8,
    function_name: []u8,
    arm_body: i64,
    bs: i64
) -> !i64 {
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arm_body, bs);
    if std::mem::equal_bytes(body_kind, "Return") {
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_body, "value", 0, bs
        );
    }
    if std::mem::equal_bytes(body_kind, "ExprStmt") {
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_body, "expr", 0, bs
        );
    }
    return arm_body;
}

fn token_kind_predicate_arm_bool(
    ir_bytes: []u8,
    function_name: []u8,
    arm_body: i64,
    bs: i64
) -> !bool {
    let value = try token_kind_predicate_arm_value(ir_bytes, function_name, arm_body, bs);
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Bool") {
        return error("compiled mir: token-kind predicate arms must return bool");
    }
    let token = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, value, bs);
    return std::mem::equal_bytes(token, "true");
}

// function_is_bool_token_kind_predicate reports whether a single-statement function is a
// genuine bool TokenKind predicate: a 'match <scrutinee>.kind { ... }' (compact return-match
// or exhaustive statement match) whose scrutinee is a field access and whose every arm body
// returns a bool literal. It is non-erroring, so a non-bool dispatch match (whose arms return
// a ParseNode / an error union / any non-bool value) is reported false and falls through to
// the general lowering instead of being mis-specialized as a bool predicate (issue 1157
// PR-PD / B2). The narrow only removes false-positive specialization; every real bool
// predicate (bool and !bool return) still matches and keeps the fast path.
pub fn function_is_bool_token_kind_predicate(
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let statement_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, statement, bs
    );
    var match_node = 0 - 1;
    if std::mem::equal_bytes(statement_kind, "Match") {
        match_node = statement;
    } else {
        if std::mem::equal_bytes(statement_kind, "ExprStmt") {
            let expr = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "expr", 0, bs
            );
            let expr_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr, bs);
            if std::mem::equal_bytes(expr_kind, "Match") {
                match_node = expr;
            }
        } else {
            if std::mem::equal_bytes(statement_kind, "Return") {
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
                let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
                if std::mem::equal_bytes(value_kind, "Match") {
                    match_node = value;
                }
            }
        }
    }
    if match_node < 0 {
        return false;
    }
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, scrutinee, bs);
    if !std::mem::equal_bytes(scrutinee_kind, "FieldExpr") {
        return false;
    }
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_node, "arm", bs
    );
    if arm_count == 0 {
        return false;
    }
    var arm_index = 0;
    while arm_index < arm_count {
        let arm = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_node, "arm", arm_index, bs
        );
        let arm_body = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm, "body", 0, bs
        );
        let value = try token_kind_predicate_arm_value(ir_bytes, function_name, arm_body, bs);
        let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
        if !std::mem::equal_bytes(value_kind, "Bool") {
            return false;
        }
        arm_index = arm_index + 1;
    }
    return true;
}

// lower_token_kind_predicate_function lowers parser TokenKind predicates into a single
// TokenKindPredicate statement (tracker 961, scope 4 prerequisite). It reads the Token.kind
// scrutinee and records every arm whose body returns true; the renderer emits an i1 compare/OR
// chain. The field index comes from the Token facts and variant tags from TokenKind facts.
pub fn lower_token_kind_predicate_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let match_node = try token_kind_predicate_match_node(ir_bytes, function_name, bs);
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, scrutinee, bs);
    if !std::mem::equal_bytes(scrutinee_kind, "FieldExpr") {
        return error("compiled mir: token-kind predicate scrutinee must be a field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, scrutinee, "field", bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scrutinee, "receiver", 0, bs
    );
    let token_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs);
    let kind_field_index = try compiled_fact_lookup::lookup_struct_field_index_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "Token", field_name
    );
    var variant_tags = std::array::Array<i64>(std::mem::page_allocator());
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_node, "arm", bs
    );
    var arm_index = 0;
    while arm_index < arm_count {
        let arm = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_node, "arm", arm_index, bs
        );
        let arm_body = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm, "body", 0, bs
        );
        if try token_kind_predicate_arm_bool(ir_bytes, function_name, arm_body, bs) {
            let pattern = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arm, "pattern", 0, bs
            );
            let variant_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, pattern, bs
            );
            if std::mem::equal_bytes(variant_name, "_") {
                return error("compiled mir: token-kind predicate wildcard true arm unsupported");
            }
            let variant_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
                ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", variant_name
            );
            try variant_tags.append(variant_tag);
        }
        arm_index = arm_index + 1;
    }
    if variant_tags.len() == 0 {
        return error("compiled mir: token-kind predicate must have a true arm");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::token_kind_predicate_stmt(
        token_name, "%kizu.kizu.lexer.token", kind_field_index, variant_tags
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_parser_span_predicate_function lowers the parser's source-span classifiers that drive
// namespace/type disambiguation. Their loop-carried booleans and segment cursors are deliberately
// outside the generic restricted while lowering, so they lower as a dedicated statement while still
// resolving helper calls through stdlib-symbol facts (tracker 961).
pub fn lower_parser_span_predicate_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    var mode = 0;
    if std::mem::equal_bytes(function_name, "std::kizu::parser::is_struct_literal_type_span") {
        mode = 1;
    }
    let source_name = try nth_param_field(params_spec, 0, true);
    let span_type = try nth_param_field(params_spec, 1, false);
    let span_name = try nth_param_field(params_spec, 1, true);
    let is_name_symbol = try compiled_fact_lookup::lookup_stdlib_symbol_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::parser::is_name_byte"
    );
    let is_double_colon_symbol = try compiled_fact_lookup::lookup_stdlib_symbol_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::parser::is_double_colon_at"
    );
    let is_upper_symbol = try compiled_fact_lookup::lookup_stdlib_symbol_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::parser::is_upper_byte"
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::parser_span_predicate_stmt(
        mode,
        source_name,
        span_name,
        span_type,
        is_name_symbol,
        is_double_colon_symbol,
        is_upper_symbol
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_parser_postfix_start_function lowers the parser's AST-aware postfix guards. The body
// shapes are intentionally narrow: guard on left.next, bind ast.get(left.node), then classify the
// bound node span through one of the compiled span predicates (tracker 961).
pub fn lower_parser_postfix_start_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    var mode = 0;
    var guard_lookup = "std::kizu::parser::is_lt_token";
    var span_lookup = "std::kizu::parser::is_namespace_path_span";
    if std::mem::equal_bytes(function_name, "std::kizu::parser::is_struct_literal_start") {
        mode = 1;
        guard_lookup = "std::kizu::parser::is_single_token_byte";
        span_lookup = "std::kizu::parser::is_struct_literal_type_span";
    } else {
        if !std::mem::equal_bytes(function_name, "std::kizu::parser::is_type_apply_start") {
            return error("compiled mir: unknown parser postfix start predicate");
        }
    }
    let ast_type = try nth_param_field(params_spec, 0, false);
    let ast_name = try nth_param_field(params_spec, 0, true);
    let text_name = try nth_param_field(params_spec, 1, true);
    let left_type = try nth_param_field(params_spec, 2, false);
    let left_name = try nth_param_field(params_spec, 2, true);
    let node_field_index = try compiled_fact_lookup::lookup_struct_field_index_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::parser::", "ParseNode", "node"
    );
    let next_field_index = try compiled_fact_lookup::lookup_struct_field_index_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::parser::", "ParseNode", "next"
    );
    let ast_node_span_field_index = try compiled_fact_lookup::lookup_struct_field_index_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::ast::", "AstNode", "span"
    );
    let token_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "Token"
    );
    let ast_node_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::ast::", "AstNode"
    );
    let span_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::ast::", "Span"
    );
    let guard_symbol = try compiled_fact_lookup::lookup_stdlib_symbol_indexed(
        ir_lookup_index, ir_bytes, guard_lookup
    );
    let span_symbol = try compiled_fact_lookup::lookup_stdlib_symbol_indexed(
        ir_lookup_index, ir_bytes, span_lookup
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::parser_postfix_start_stmt(
        mode,
        ast_name,
        ast_type,
        text_name,
        left_name,
        left_type,
        token_type,
        ast_node_type,
        span_type,
        node_field_index,
        next_field_index,
        ast_node_span_field_index,
        guard_symbol,
        span_symbol
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_first_token_function lowers std::kizu::lexer::first_token into a single FirstToken
// statement: 'return token_at(source, 0, position(1, 1));' (tracker 961, scope 4 prerequisite).
// Its nested call argument the generic path does not model, so it is dispatched by name.
pub fn lower_first_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::first_token_stmt(
        source_name, "%kizu.kizu.lexer.position", llvm_return_type,
        "kizu_kizu__lexer_position", "kizu_kizu__lexer_token_at"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_next_token_function lowers std::kizu::lexer::next_token into a single NextToken statement:
// it reads previous.start / end / line / column, advances the Position via advance_position, then
// returns token_at(source, previous.end, next) (tracker 961, scope 4 prerequisite). Its nested call
// arguments the generic path does not model, so it is dispatched by name.
pub fn lower_next_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let previous_name = try nth_param_field(params_spec, 1, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::next_token_stmt(
        source_name, previous_name, "%kizu.kizu.lexer.position", llvm_return_type,
        "kizu_kizu__lexer_position", "kizu_kizu__lexer_advance_position",
        "kizu_kizu__lexer_token_at"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_token_at_function lowers std::kizu::lexer::token_at into a single TokenAt statement: the
// top-level tokenizer step that skips whitespace and line comments while tracking the pending doc
// span, then returns attach_doc(raw_token_at(...), doc_start, doc_end) (tracker 961, scope 4
// prerequisite). Its nested loops with five outer loop-carried variables and conditional doc-span
// updates the generic path does not model, so it is dispatched by name. All callees are the
// already-compiled lexer helpers.
pub fn lower_token_at_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let offset_name = try nth_param_field(params_spec, 1, true);
    let initial_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::token_at_stmt(
        source_name, offset_name, initial_name, position_type, llvm_return_type,
        "kizu_kizu__lexer_is_space", "kizu_kizu__lexer_advance_byte",
        "kizu_kizu__lexer_is_doc_comment_start", "kizu_kizu__lexer_skip_line_comment",
        "kizu_kizu__lexer_position", "kizu_kizu__lexer_raw_token_at",
        "kizu_kizu__lexer_attach_doc"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_skip_line_comment_function lowers std::kizu::lexer::skip_line_comment into a single
// SkipLineComment statement: a two-phi loop threading the i64 end and the Position struct current
// past a comment line, folding advance_byte until newline, then building the Eof Token (tracker
// 961, scope 4 prerequisite). Its struct loop-carried variable, compound 'end < len and
// source[end] != 10' condition, and call-in-loop the generic while machinery does not model, so it
// is dispatched by name. The TokenKind::Eof tag is resolved from the enum-variant facts.
pub fn lower_skip_line_comment_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let initial_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let eof_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Eof"
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::skip_line_comment_stmt(
        source_name, start_name, initial_name, position_type, llvm_return_type,
        "kizu_kizu__lexer_advance_byte", "kizu_kizu__lexer_token", eof_tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_is_doc_comment_start_function lowers std::kizu::lexer::is_doc_comment_start into a single
// IsDocCommentStart statement: a bounded branch chain returning i1 over three slash bytes plus a
// fourth-slash demotion check (tracker 961, scope 4 prerequisite). Its index loads inside compound
// boolean conditions the generic path does not model, so it is dispatched by name.
pub fn lower_is_doc_comment_start_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::is_doc_comment_start_stmt(source_name, start_name));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// append_word_keyword resolves a keyword's TokenKind discriminant from the enum-variant facts and
// appends it to word_token's keyword table (tracker 961, scope 4 prerequisite).
fn append_word_keyword(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    keywords: &var std::array::Array<compiled_mir::MirKeyword>,
    text: []u8,
    variant: []u8
) -> !void {
    let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", variant
    );
    try keywords.append(compiled_mir::keyword(text, tag));
    return;
}

// lower_word_token_function lowers std::kizu::lexer::word_token into a single WordToken statement:
// an is_word scan loop, an empty-run single-byte Ident, a keyword table compared via equal_bytes,
// and a multi-byte Ident fallback (tracker 961, scope 4 prerequisite). Its scan loop plus the
// keyword-comparison chain over string constants the generic path does not model, so it is
// dispatched by name. The keyword and Ident discriminants come from the enum-variant facts.
pub fn lower_word_token_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let ident_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Ident"
    );
    var keywords = std::array::Array<compiled_mir::MirKeyword>(std::mem::page_allocator());
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "fn", "Fn");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "import", "Import");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "pub", "Pub");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "struct", "Struct");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "enum", "Enum");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "union", "Union");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "extern", "Extern");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "dyn", "Dyn");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "let", "Let");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "var", "Var");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "return", "Return");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "defer", "Defer");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "if", "If");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "else", "Else");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "while", "While");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "for", "For");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "break", "Break");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "continue", "Continue");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "match", "Match");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "unsafe", "Unsafe");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "comptime", "Comptime");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "try", "Try");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "true", "True");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "false", "False");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "and", "And");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "or", "Or");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "mut", "Mut");
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::word_token_stmt(
        llvm_symbol, source_name, start_name, current_name, position_type,
        llvm_return_type, "kizu_kizu__lexer_is_word", "kizu_kizu__lexer_token",
        "kizu_selfhost__slice_equal", ident_tag, keywords
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

pub fn lower_ast_node_text_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let text_name = try nth_param_field(params_spec, 0, true);
    let ast_type = try nth_param_field(params_spec, 1, false);
    let ast_name = try nth_param_field(params_spec, 1, true);
    let node_id_type = try nth_param_field(params_spec, 2, false);
    let node_id_name = try nth_param_field(params_spec, 2, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::ast_node_text_stmt(
        text_name, ast_name, ast_type, node_id_name, node_id_type,
        "", "kizu_std__mem_trim_ascii"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_string_literal_span_function lowers selfhost::ir::codegen::string_literal_span into a
// single StringLiteralSpan statement: it binds the AstNode off Ast.get, reads the Span, checks
// the surrounding quotes, and forwards the inner payload slice to is_payload_supported, returning
// the trimmed PayloadSpan or empty_payload_span() (tracker 961, scope 4 prerequisite). Both
// helper callees live in this function's own selfhost::ir::codegen module.
pub fn lower_string_literal_span_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let text_name = try nth_param_field(params_spec, 0, true);
    let ast_type = try nth_param_field(params_spec, 1, false);
    let ast_name = try nth_param_field(params_spec, 1, true);
    let node_id_type = try nth_param_field(params_spec, 2, false);
    let node_id_name = try nth_param_field(params_spec, 2, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::string_literal_span_stmt(
        text_name, ast_name, ast_type, node_id_name, node_id_type,
        module_prefix, "is_payload_supported", "empty_payload_span"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// return_value_is_literal_plus_try reports whether a single-return value is the shape
// '<int literal> + try <call>' (count_one / count_with_range, tracker 961).
pub fn return_value_is_literal_plus_try(
    ir_bytes: []u8,
    function_name: []u8,
    value: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left, bs);
    if !std::mem::equal_bytes(left_kind, "Int") {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right, bs);
    return std::mem::equal_bytes(right_kind, "TryExpr");
}

// lower_return_try_binary_function lowers 'return <int> + try <callee>(<args>);' into a
// single ReturnTryBinary statement (count_one / count_with_range, tracker 961).
pub fn lower_return_try_binary_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, left, bs);
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let inner_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, right, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner_call, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: return-try binary must wrap a call");
    }
    let called_error_union = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, inner_call, bs
    );
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, inner_call, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, inner_call, bs
    );
    let args = try compiled_mir_lower_call::lower_call_args(
        ir_bytes, function_name, module_prefix, params_spec, inner_call, 0, bs
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::return_try_binary_stmt(
        literal, called_error_union, llvm_return_type,
        callee_module_prefix, callee_name, 0, 0, args
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// match_union_arm_expr unwraps a match arm body to its value expression: the parser wraps
// a bare expression arm body in an ExprStmt, so the field chain / integer literal lives at
// the ExprStmt 'expr' child (tracker 961).
fn match_union_arm_expr(
    ir_bytes: []u8,
    function_name: []u8,
    arm_body: i64,
    bs: i64
) -> !i64 {
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arm_body, bs);
    if std::mem::equal_bytes(body_kind, "ExprStmt") {
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_body, "expr", 0, bs
        );
    }
    return arm_body;
}

// lower_array_len_method_return lowers a single 'return self.<field>.len();' where
// <field> is a std::array::Array<T> field of a struct value parameter. It is the
// first AST read-only accessor compiled into stage2 (std::kizu::ast::Ast.len): it
// lands the Ast struct value as a parameter, lowers the self.children field access
// as an extractvalue, and lowers Array.len() to the array_len builtin runtime call
// (@kizu_array_len). It deliberately does NOT touch the AstNode/AstData union,
// Arena.get, array_get, or error-union return; those remain blocked in tracker 961.
pub fn lower_array_len_method_return(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    // The callee FieldExpr names the method (len) and carries the array field
    // expression (self.children) as its receiver.
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "len") {
        return error("compiled mir: only Array.len method accessor is supported");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 0 {
        return error("compiled mir: Array.len accessor takes no arguments");
    }
    // The method receiver is the array field expression self.children.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, bs
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.len receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    // The field expression's receiver must be a plain struct value parameter (self).
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, bs
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.len field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(params_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, params_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.len receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.len receiver field is not a std::array::Array");
    }
    // Array<T> lowers to the %kizu.owned heap handle (the same { ptr } container the
    // selfhost runtime uses), and Array.len() lowers to the array_len builtin runtime
    // call @kizu_rt_array_len(%kizu.owned) returning i64. The only argument is the
    // array field extracted out of the struct value parameter.
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::field_access_call_arg(
        "%kizu.owned", receiver_llvm_type, var_name, field.index
    ));
    return compiled_mir_function::single_call_return_function(
        llvm_symbol,
        "i64",
        params_spec,
        "",
        "kizu_rt_array_len",
        args
    );
}
// lower_array_get_method_return lowers a single 'return self.<field>.get(index);'
// where <field> is a std::array::Array<T> field of a struct value parameter and
// index is an i64 parameter. It is the first checked Array<T>.get accessor compiled
// into stage2 (std::kizu::diagnostic::Diagnostic.related_get, tracker 961): it reads
// the Array field off the struct value parameter, calls the checked
// @kizu_rt_array_at runtime helper, and on success loads the element value out of
// the borrowed view and wraps it as the error-union success value; on failure it
// forwards the runtime message as the error-union failure value. The error branch
// is a real failure return, never 'unreachable'.
pub fn lower_array_get_method_return(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    // The single argument is the i64 index parameter.
    let index_arg = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    let index_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, index_arg, bs
    );
    if !std::mem::equal_bytes(index_kind, "Var") {
        return error("compiled mir: Array.get index must be a parameter");
    }
    let index_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_arg, bs
    );
    // The method receiver is the array field expression self.<field>.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, bs
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.get receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, bs
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.get field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(params_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, params_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.get receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.get receiver field is not a std::array::Array");
    }
    // The element type backs the by-value load out of the borrowed view. It is
    // looked up by its own fully-qualified name (empty module prefix) so the lookup
    // is independent of which module the accessor lives in.
    let element_kizu_type = try array_element_kizu_type(field.field_type);
    let element_llvm_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "", element_kizu_type
    );
    return compiled_mir_function::single_array_get_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        receiver_llvm_type,
        var_name,
        field.index,
        index_name,
        element_llvm_type
    );
}
pub fn lower_struct_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let fields = try compiled_mir_lower_struct::lower_struct_fields(
        ir_bytes, function_name, module_prefix, params_spec, value_node, bs
    );
    return compiled_mir_function::single_struct_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        fields
    );
}

// lower_stdlib_struct_constructor_function synthesizes the definition of an owned-container struct
// constructor (e.g. std::kizu::ast::Ast) the frontend records as a stdlib callee: it carries
// 'stdlib-return' / 'stdlib-symbol' / 'struct-field' / 'type-llvm' facts but no body facts, so its
// definition cannot be lowered from a body. The constructor body is canonical -- each field is
// either a fresh runtime-owned container built from the allocator (Arena<T> / Array<T>) or a
// passthrough of the same-named parameter -- so the field descriptors are rebuilt from the
// struct-field facts: owned-container fields become ArrayNew fields keyed off the leading allocator
// parameter, and every other field becomes a Var passthrough resolved by its field name against the
// params_spec. The return type comes from the stdlib-return fact, so neither the field set nor the
// return type is hardcoded.
pub fn lower_stdlib_struct_constructor_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    params_spec: []u8
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let short_type = function_name[std::mem::len(module_prefix)..std::mem::len(function_name)];
    let return_kizu = try compiled_fact_lookup::lookup_stdlib_return_indexed(
        ir_lookup_index, ir_bytes, function_name
    );
    let llvm_return_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index, ir_bytes, module_prefix, return_kizu
    );
    let allocator_name = try compiled_signature::first_param_name(params_spec);
    var fields = std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator());
    var field_index = 0;
    var done = false;
    while !done {
        let field_type = try compiled_fact_lookup::lookup_struct_field_type_by_prefix_or_empty_indexed(
            ir_lookup_index, ir_bytes, module_prefix, short_type, field_index
        );
        if std::mem::len(field_type) == 0 {
            done = true;
        } else {
            if std::mem::starts_with(field_type, "std::arena::Arena<") or
                std::mem::starts_with(field_type, "std::array::Array<") {
                let field_len = std::mem::len(field_type);
                if field_type[field_len - 1] != cast<u8>(62) {
                    return error("compiled mir: malformed owned-container constructor field type");
                }
                var prefix_len = std::mem::len("std::array::Array<");
                if std::mem::starts_with(field_type, "std::arena::Arena<") {
                    prefix_len = std::mem::len("std::arena::Arena<");
                }
                let element_kizu = field_type[prefix_len..field_len - 1];
                let element_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
                    ir_lookup_index, ir_bytes, module_prefix, element_kizu
                );
                try fields.append(compiled_mir::array_new_struct_field(
                    field_index, "%kizu.owned", allocator_name, element_llvm
                ));
            } else {
                let field_name = try compiled_fact_lookup::lookup_struct_field_name_by_prefix_indexed(
                    ir_lookup_index, ir_bytes, module_prefix, short_type, field_index
                );
                if std::mem::len(field_name) == 0 {
                    return error("compiled mir: struct constructor field name not found");
                }
                let field_llvm = try compiled_signature::find_param_type(params_spec, field_name);
                try fields.append(compiled_mir::var_struct_field(field_index, field_llvm, field_name));
            }
            field_index = field_index + 1;
        }
    }
    if field_index == 0 {
        return error("compiled mir: struct constructor has no struct-field facts");
    }
    return compiled_mir_function::single_struct_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        fields
    );
}
pub fn lower_expr_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    let result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        value_node,
        0,
        0,
        &var insts,
        bs,
        ir_lookup_index,
        &var call_arg_type_cache
    );
    return compiled_mir_function::single_expr_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        result_id,
        insts
    );
}

pub fn return_value_is_short_circuit_or(
    ir_bytes: []u8,
    function_name: []u8,
    value_node: i64,
    bs: i64
) -> !bool {
    return (try short_circuit_kind(ir_bytes, function_name, value_node, bs)) == 2;
}

pub fn lower_short_circuit_or_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    let prefix_result = try lower_short_circuit_or_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        value_node,
        0,
        0,
        0,
        &var stmts,
        bs,
        ir_lookup_index,
        &var call_arg_type_cache
    );
    var final_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let final_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        prefix_result.final_node,
        prefix_result.string_counter,
        prefix_result.temp_counter,
        &var final_insts,
        bs,
        ir_lookup_index,
        &var call_arg_type_cache
    );
    try stmts.append(compiled_mir::return_expr_stmt(
        prefix_result.string_counter,
        final_result,
        final_insts
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        stmts
    );
}

pub struct ShortCircuitOrLowerResult {
    pub final_node: i64,
    pub string_counter: i64,
    pub temp_counter: i64,
    pub if_index: i64,
}

fn lower_short_circuit_or_prefix(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !ShortCircuitOrLowerResult {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) != 2 {
        return ShortCircuitOrLowerResult {
            final_node: node,
            string_counter: string_counter,
            temp_counter: temp_counter,
            if_index: if_index
        };
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    let left_result = try append_short_circuit_or_operand_ifs(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        left_node,
        string_counter,
        temp_counter,
        if_index,
        stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    return try lower_short_circuit_or_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        right_node,
        left_result.string_counter,
        left_result.temp_counter,
        left_result.if_index,
        stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
}

fn append_short_circuit_or_operand_ifs(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !ShortCircuitOrLowerResult {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) == 2 {
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        let left_result = try append_short_circuit_or_operand_ifs(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            params_spec,
            left_node,
            string_counter,
            temp_counter,
            if_index,
            stmts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        return try append_short_circuit_or_operand_ifs(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            params_spec,
            right_node,
            left_result.string_counter,
            left_result.temp_counter,
            left_result.if_index,
            stmts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        node,
        string_counter,
        temp_counter,
        &var cond_insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let cond_strings = try count_strings_in_insts(&cond_insts);
    let cond_len = cond_insts.len();
    try stmts.append(compiled_mir::if_stmt(
        if_index,
        string_counter,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        compiled_mir::MirIfThenKind::ReturnBool,
        true,
        llvm_return_type,
        "",
        "",
        std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        string_counter + cond_strings,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator())
    ));
    return ShortCircuitOrLowerResult {
        final_node: node,
        string_counter: string_counter + cond_strings,
        temp_counter: temp_counter + cond_len,
        if_index: if_index + 1
    };
}

// ValueLoopInit carries the value-carried loop seed call's (module_prefix, callee_name) so the
// renderer can emit '@<module_prefix><callee>' for the first iteration value, plus the seed call's
// return kizu type -- the loop's element type, used for the array element width and the struct
// field layout (issue 1165).
struct ValueLoopInit {
    callee_qualified: []u8,
    element_kizu: []u8,
}

// signature_return_kizu resolves a callee's declared return kizu type from the
// 'function-signature-return <name> <type>' facts. A same-module call written fully qualified
// (e.g. std::kizu::lexer::first_token from within std::kizu::lexer) records its name with the
// module prefix already included, so the direct module_prefix+callee key would double it; this
// retries with the module prefix stripped off the callee. (issue 1165)
fn signature_return_kizu(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee: []u8,
    ir_lookup_index: &ir_index::IrIndex
) -> ![]u8 {
    let direct = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        ir_lookup_index, ir_bytes, "function-signature-return ", module_prefix, callee
    );
    if std::mem::len(direct) > 0 {
        return direct;
    }
    if std::mem::starts_with(callee, module_prefix) {
        let short = callee[std::mem::len(module_prefix)..std::mem::len(callee)];
        let stripped = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
            ir_lookup_index, ir_bytes, "function-signature-return ", module_prefix, short
        );
        if std::mem::len(stripped) > 0 {
            return stripped;
        }
    }
    return error("compiled mir: value-loop seed return type not found");
}

// node_kind_is reports whether a body node's kind equals the expected string. It wraps
// body_node_kind_from so callers avoid nesting a try-expression inside a call argument, which keeps
// the value-loop helpers within the std parser subset the selfhost compiler accepts (issue 1165).
fn node_kind_is(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    expected: []u8,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    return std::mem::equal_bytes(kind, expected);
}

// find_while_statement returns the sequence id of the first top-level While statement, or -1 when
// the function has none (issue 1165). Used to detect the value-carried array-append loop shape.
fn find_while_statement(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !i64 {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "While") {
            return statement;
        }
        index = index + 1;
    }
    return -1;
}

// find_while_index returns the statement index of the first top-level While, or -1 when the function
// has none. The index lets lower_value_array_loop bracket the loop with the seed append (index - 1)
// and the array return (index + 1) (issue 1165).
fn find_while_index(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !i64 {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        if try node_kind_is(ir_bytes, function_name, statement, "While", bs) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// value_loop_call_arg_var returns the local name of a call's nth argument, requiring it to be a Var.
// The value loop's seed / update calls take only local arguments, so a non-local is rejected rather
// than mis-lowered (issue 1165).
fn value_loop_call_arg_var(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    arg_index: i64,
    bs: i64
) -> ![]u8 {
    let arg = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", arg_index, bs
    );
    if !try node_kind_is(ir_bytes, function_name, arg, "Var", bs) {
        return error("compiled mir: value-loop call argument must be a local");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, arg, bs);
}

// is_value_array_loop_shape reports whether this multi-statement function is the value-carried
// array-append loop that generic lowering targets (issue 1165): a While whose condition is a
// single '<struct-value>.<field> != <Enum>::<Variant>' comparison -- a field-mode FieldExpr on
// the left and a namespace-mode FieldExpr (an enum constant) on the right. This is structurally
// distinct from the i64-induction While (whose condition compares an i64 Var), so detecting it
// here never diverts an induction loop. The body shape (reassign + try-append) and the array /
// seed lets are validated by lower_value_array_loop; a true result commits to that path.
fn is_value_array_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    let while_statement = try find_while_statement(ir_bytes, function_name, statement_count, bs);
    if while_statement < 0 {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    let cond_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, cond_node, bs);
    if !std::mem::equal_bytes(cond_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "not-eq") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_kind, "FieldExpr") {
        return false;
    }
    let left_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, left_node, bs
    );
    if !std::mem::equal_bytes(left_mode, "field") {
        return false;
    }
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(right_kind, "FieldExpr") {
        return false;
    }
    let right_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, right_node, bs
    );
    return std::mem::equal_bytes(right_mode, "namespace");
}

// find_value_loop_init locates the 'var <loop_var> = <callee>(<source>)' seed let and returns the
// callee's (module_prefix, callee_name). The seed supplies both the loop's preheader value and the
// element type that array_new / the append slices use (issue 1165).
fn find_value_loop_init(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    loop_var: []u8,
    source_name: []u8,
    statement_count: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !ValueLoopInit {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, loop_var) {
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
                let value_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, value, bs
                );
                if !std::mem::equal_bytes(value_kind, "Call") {
                    return error("compiled mir: value-loop seed must be a call");
                }
                if (try compiled_mir_types::count_call_args(ir_bytes, function_name, value, bs)) != 1 {
                    return error("compiled mir: value-loop seed takes exactly the source argument");
                }
                let seed_arg = try value_loop_call_arg_var(ir_bytes, function_name, value, 0, bs);
                if !std::mem::equal_bytes(seed_arg, source_name) {
                    return error("compiled mir: value-loop seed argument must be the source");
                }
                let init_callee_qualified = try ir_contract::body_call_callee_or_empty_from(
                    ir_bytes, function_name, value, bs
                );
                let element_kizu = try signature_return_kizu(
                    ir_bytes, module_prefix, init_callee_qualified, ir_lookup_index
                );
                return ValueLoopInit {
                    callee_qualified: init_callee_qualified,
                    element_kizu: element_kizu
                };
            }
        }
        index = index + 1;
    }
    return error("compiled mir: value-loop seed let not found");
}

// value_loop_assert_append validates that <statement> is exactly 'try <array_name>.append(<value_name>);'
// -- an ExprStmt wrapping a try-call of the 'append' method on the array local, taking the carried
// value as its sole argument. Both the seed append (before the loop) and the body append are checked
// this way so a near-miss shape (wrong receiver, wrong/extra argument, different method) is an explicit
// error rather than a silent mis-lowering (issue 1165).
fn value_loop_assert_append(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    array_name: []u8,
    value_name: []u8,
    bs: i64
) -> !void {
    if !try node_kind_is(ir_bytes, function_name, statement, "ExprStmt", bs) {
        return error("compiled mir: value-loop append must be an expression statement");
    }
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, expr, "TryExpr", bs) {
        return error("compiled mir: value-loop append must be a try expression");
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, inner, "Call", bs) {
        return error("compiled mir: value-loop append must wrap a call");
    }
    if !try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: value-loop append must be a method call");
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "append") {
        return error("compiled mir: value-loop method must be append");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, receiver_node, "Var", bs) {
        return error("compiled mir: value-loop array receiver must be a local");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_name, array_name) {
        return error("compiled mir: value-loop append receiver must be the array");
    }
    if (try compiled_mir_types::count_call_args(ir_bytes, function_name, inner, bs)) != 1 {
        return error("compiled mir: value-loop append takes exactly one argument");
    }
    let arg_name = try value_loop_call_arg_var(ir_bytes, function_name, inner, 0, bs);
    if !std::mem::equal_bytes(arg_name, value_name) {
        return error("compiled mir: value-loop append argument must be the carried value");
    }
    return;
}

// value_loop_array_let_name finds the 'var <name> = std::array::Array<T>(<allocator>)' constructor
// let preceding the loop (statement index < before_index) and returns <name>. It validates the
// callee is exactly std::array::Array (or std::array::Array<...>) -- a near-miss like
// std::array::ArrayFoo is rejected -- and that the constructor takes exactly the function's allocator, since
// the renderer always passes params_spec[0] as the allocator -- a different argument would otherwise
// be silently mis-lowered. Absence or a mismatched argument is an explicit error (issue 1165).
fn value_loop_array_let_name(
    ir_bytes: []u8,
    function_name: []u8,
    allocator_name: []u8,
    before_index: i64,
    bs: i64
) -> ![]u8 {
    var index = 0;
    while index < before_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        if try node_kind_is(ir_bytes, function_name, statement, "Let", bs) {
            let value = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "value", 0, bs
            );
            if try node_kind_is(ir_bytes, function_name, value, "Call", bs) {
                let callee = try ir_contract::body_call_callee_or_empty_from(
                    ir_bytes, function_name, value, bs
                );
                if std::mem::equal_bytes(callee, "std::array::Array")
                    or std::mem::starts_with(callee, "std::array::Array<") {
                    let ctor_args = try compiled_mir_types::count_call_args(
                        ir_bytes, function_name, value, bs
                    );
                    if ctor_args != 1 {
                        return error("compiled mir: value-loop array constructor takes exactly the allocator argument");
                    }
                    let ctor_arg = try value_loop_call_arg_var(
                        ir_bytes, function_name, value, 0, bs
                    );
                    if !std::mem::equal_bytes(ctor_arg, allocator_name) {
                        return error("compiled mir: value-loop array constructor argument must be the allocator");
                    }
                    let name_node = try ir_contract::body_child_sequence_from(
                        ir_bytes, function_name, statement, "name", 0, bs
                    );
                    return try ir_contract::body_token_or_empty_from(
                        ir_bytes, function_name, name_node, bs
                    );
                }
            }
        }
        index = index + 1;
    }
    return error("compiled mir: value-loop array constructor let not found");
}

// lower_value_array_loop lowers the value-carried array-append loop (the std::kizu::lexer::tokenize
// shape) into a generic ArrayNew + ValueWhile pair (issue 1165). It derives every loop parameter
// from the IR rather than the function name: the loop var and array name from the condition / body,
// the element type and field index from resolving the condition's field access, the Eof sentinel
// tag from the condition's enum constant, and the seed / update callees from the seed let and the
// body reassignment. The element width and struct layout flow from the element type, so no size or
// symbol is hardcoded per function. ABI types (%kizu.owned / %kizu.error.void) and the runtime
// append symbol are fixed array-runtime constants, not tokenize specifics.
pub fn lower_value_array_loop(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let allocator_name = try nth_param_field(params_spec, 0, true);
    let source_name = try nth_param_field(params_spec, 1, true);
    let while_index = try find_while_index(ir_bytes, function_name, statement_count, bs);
    if while_index < 0 {
        return error("compiled mir: value-loop while statement not found");
    }
    // The loop must be directly preceded by the seed append and be the penultimate statement, with
    // the array return trailing it: [array-let, seed-let, seed-append, while, return] (issue 1165).
    if while_index < 1 {
        return error("compiled mir: value-loop while must follow the seed append");
    }
    if while_index + 1 != statement_count - 1 {
        return error("compiled mir: value-loop while must be the penultimate statement");
    }
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    let loop_var_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, left_node, "receiver", 0, bs
    );
    let loop_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, loop_var_receiver, bs
    );
    // The filled array must be a std::array::Array<T> constructor let preceding the loop; its name
    // anchors the seed append, the body append, and the return.
    let array_name = try value_loop_array_let_name(
        ir_bytes, function_name, allocator_name, while_index, bs
    );
    // The seed call's return type is the carried struct -- the array element type. Deriving it from
    // the seed call avoids re-resolving the loop var's type through its field access, whose namespaced
    // same-module callee the local-type resolver mis-reads as an Arena.add (issue 1165). The element
    // kizu type then yields the LLVM element type and the compared field's struct index. The seed let
    // also pins 'var <loop_var> = <init>(<source>)'.
    let init = try find_value_loop_init(
        ir_bytes, function_name, module_prefix, loop_var, source_name, statement_count, bs,
        ir_lookup_index
    );
    let element_kizu = init.element_kizu;
    let element_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, module_prefix, element_kizu
    );
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, left_node, "field", bs
    );
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix,
        compiled_mir_types::struct_lookup_kizu_type(element_kizu), field_name
    );
    if !field.found {
        return error("compiled mir: value-loop compared field not found");
    }
    let field_index = field.index;
    // The condition's right-hand enum constant supplies the loop's exit (Eof) discriminant tag.
    let enum_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, right_node, "receiver", 0, bs
    );
    let enum_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, enum_receiver, bs
    );
    let variant_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, right_node, "namespace", bs
    );
    let eof_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, enum_name, variant_name
    );
    // The statement directly before the loop must seed the array: 'try <array>.append(<loop_var>);'.
    let seed_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index - 1, bs
    );
    try value_loop_assert_append(
        ir_bytes, function_name, seed_statement, array_name, loop_var, bs
    );
    // The loop body must be exactly the reassignment then the try-append.
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 2 {
        return error("compiled mir: value-loop body must be reassignment then append");
    }
    let assign_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, assign_statement, "Assign", bs) {
        return error("compiled mir: value-loop body must begin with a reassignment");
    }
    let assign_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_statement, "target", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, assign_target, "Var", bs) {
        return error("compiled mir: value-loop reassignment target must be a local");
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, assign_target, bs), loop_var
    ) {
        return error("compiled mir: value-loop reassignment must target the carried value");
    }
    let update_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_statement, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, update_value, "Call", bs) {
        return error("compiled mir: value-loop reassignment must be a call");
    }
    if (try compiled_mir_types::count_call_args(ir_bytes, function_name, update_value, bs)) != 2 {
        return error("compiled mir: value-loop update takes the source and carried value");
    }
    let update_arg0 = try value_loop_call_arg_var(ir_bytes, function_name, update_value, 0, bs);
    if !std::mem::equal_bytes(update_arg0, source_name) {
        return error("compiled mir: value-loop update first argument must be the source");
    }
    let update_arg1 = try value_loop_call_arg_var(ir_bytes, function_name, update_value, 1, bs);
    if !std::mem::equal_bytes(update_arg1, loop_var) {
        return error("compiled mir: value-loop update second argument must be the carried value");
    }
    let update_callee_qualified = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, update_value, bs
    );
    let append_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    try value_loop_assert_append(
        ir_bytes, function_name, append_statement, array_name, loop_var, bs
    );
    // The statement directly after the loop must return the filled array: 'return <array>;'.
    let return_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index + 1, bs
    );
    if !try node_kind_is(ir_bytes, function_name, return_statement, "Return", bs) {
        return error("compiled mir: value-loop must end with the array return");
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_statement, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, return_value, "Var", bs) {
        return error("compiled mir: value-loop return value must be the array local");
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs), array_name
    ) {
        return error("compiled mir: value-loop must return the filled array");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::array_new_stmt(
        array_name, "%kizu.owned", allocator_name, element_type
    ));
    try stmts.append(compiled_mir::value_while_stmt(
        array_name, loop_var, source_name, element_type,
        "%kizu.owned", llvm_return_type, "%kizu.error.void",
        init.callee_qualified, update_callee_qualified,
        "kizu_rt_array_append", field_index, eof_tag, "vw0"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// grammar_branch_carried_name builds the owned SSA name a grammar-loop branch binds its carried
// value into ('<carried>_b<index>', issue 1157). Each branch reassigns the same carried variable in
// a distinct block, so the bound names must be distinct for valid SSA; the loop-head phi reads each
// on its back-edge. A direct String.as_bytes() view cannot escape into the MIR, so the name is
// copied through a Map insertion (the same byte-copy boundary void_then_alias_name uses).
fn grammar_branch_carried_name(carried_var: []u8, index: i64) -> ![]u8 {
    var out = std::string::String(std::mem::page_allocator());
    try out.append_bytes(carried_var);
    try out.append_bytes("_b");
    try std::fmt::append_i64(&var out, index);
    let name = out.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(name, name);
    return try copied.get(name);
}

// grammar_postfix_reassign_block_matches reports whether an if then-block is a single
// '<carried_var> = try <free-call>(...)' carried-value reassignment (issue 1157). A field-mode
// method call is rejected so only free error-union helpers carry the loop value.
fn grammar_postfix_reassign_block_matches(
    ir_bytes: []u8,
    function_name: []u8,
    then_node: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    if (try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, then_node, "statement", 1, bs
    )) >= 0 {
        return false;
    }
    let stmt = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    if stmt < 0 {
        return false;
    }
    if !(try node_kind_is(ir_bytes, function_name, stmt, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(ir_bytes, function_name, stmt, "target", 0, bs);
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), carried_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, stmt, "value", 0, bs);
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(ir_bytes, function_name, value, "value", 0, bs);
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, inner, bs));
}

// grammar_postfix_body_matches reports whether a 'while true' body is a nested if/else chain whose
// non-final arms each reassign the carried value through a free try-call and whose final else
// returns the carried value (issue 1157). The chain is the parse_postfix_expr value-loop body; a
// true result commits lower_grammar_postfix_loop to that path.
fn grammar_postfix_body_matches(
    ir_bytes: []u8,
    function_name: []u8,
    while_statement: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    if (try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    )) >= 0 {
        return false;
    }
    var node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if node < 0 {
        return false;
    }
    while true {
        if !(try node_kind_is(ir_bytes, function_name, node, "If", bs)) {
            return false;
        }
        if (try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, node, "condition", 0, bs
        )) < 0 {
            return false;
        }
        let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, node, "then", 0, bs
        );
        if then_node < 0 {
            return false;
        }
        if !(try grammar_postfix_reassign_block_matches(
            ir_bytes, function_name, then_node, carried_var, bs
        )) {
            return false;
        }
        let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, node, "else", 0, bs
        );
        if else_node < 0 {
            return false;
        }
        if (try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, else_node, "statement", 1, bs
        )) >= 0 {
            return false;
        }
        let else_stmt = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, else_node, "statement", 0, bs
        );
        if else_stmt < 0 {
            return false;
        }
        if try node_kind_is(ir_bytes, function_name, else_stmt, "If", bs) {
            node = else_stmt;
            continue;
        }
        if !(try node_kind_is(ir_bytes, function_name, else_stmt, "Return", bs)) {
            return false;
        }
        let ret_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, else_stmt, "value", 0, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, ret_value, "Var", bs)) {
            return false;
        }
        return std::mem::equal_bytes(
            try ir_contract::body_token_or_empty_from(ir_bytes, function_name, ret_value, bs),
            carried_var
        );
    }
    return false;
}

// is_grammar_postfix_loop_shape reports whether this multi-statement function is the value-carried
// 'while true' grammar loop (the parse_postfix_expr shape, issue 1157): exactly 'var <cv> =
// <param>; while true { <nested if/else reassign chain ending in 'return <cv>'> }; return <cv>;'.
// The literal 'true' condition is structurally distinct from the i64-induction While (whose
// condition compares a counter) and the value-array loop (whose condition is a struct-field
// sentinel), so detecting it here never diverts either. lower_grammar_postfix_loop re-walks and
// commits on a true result.
fn is_grammar_postfix_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return false;
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_value, "Var", bs)) {
        return false;
    }
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let carried_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Bool", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, cond_node, bs), "true"
    ) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    return try grammar_postfix_body_matches(
        ir_bytes, function_name, while_statement, carried_var, bs
    );
}

// lower_grammar_postfix_loop lowers the value-carried 'while true' grammar loop (issue 1157) into a
// single GrammarLoop statement. It derives every parameter from the IR: the carried variable and
// its preheader seed from the init let, each branch's predicate condition (lowered through the
// shared expression path, so bool-predicate calls and field-access arguments reuse the generic
// machinery) and its free error-union reassignment try-call from the nested if/else chain. The
// terminal else returns the carried value, so the loop never falls through. Per-branch SSA names
// are namespaced by a unique try index and temp/string offset so the renderer's loop-head phi and
// try-call blocks never collide.
fn lower_grammar_postfix_loop(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let carried_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, init_value, bs);
    let carried_type = try compiled_mir_types::resolve_value_llvm_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, params_spec, carried_var, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    var branches = std::array::Array<compiled_mir::MirGrammarBranch>(std::mem::page_allocator());
    var aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer aliases.deinit();
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    var string_counter = 0;
    var temp_counter = 0;
    var try_index = 0;
    var node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    while true {
        let cond_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "condition", 0, bs
        );
        var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
        let cond_result = try lower_expr_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            cond_node,
            string_counter,
            temp_counter,
            &var cond_insts,
            &aliases,
            bs,
            ir_lookup_index, &var call_arg_type_cache
        );
        let cond_strings = try count_strings_in_insts(&cond_insts);
        let cond_inst_count = cond_insts.len();
        let then_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "then", 0, bs
        );
        let then_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_node, "statement", 0, bs
        );
        let try_expr = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_stmt, "value", 0, bs
        );
        let call_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, try_expr, "value", 0, bs
        );
        let called_error_union = try compiled_mir_types::lower_call_return_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, call_node, bs
        );
        let success_type = try try_call_success_type(
            ir_bytes, function_name, module_prefix, call_node, bs, ir_lookup_index
        );
        let callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, call_node, bs
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, call_node, bs
        );
        let reassign_string_index = string_counter + cond_strings;
        let args = try compiled_mir_lower_call::lower_call_args_cached(
            ir_bytes, function_name, module_prefix, params_spec, call_node, reassign_string_index, bs,
            ir_lookup_index, &var call_arg_type_cache
        );
        let arg_strings = try compiled_mir_lower_call::count_string_args(&args);
        let bound_name = try grammar_branch_carried_name(carried_var, try_index);
        let reassign = compiled_mir::MirLetTryCallStmt {
            name: bound_name,
            called_error_union: called_error_union,
            success_type: success_type,
            own_error_union: llvm_return_type,
            call_module_prefix: callee_module_prefix,
            call_callee_name: callee_name,
            string_index: reassign_string_index,
            try_index: try_index,
            arg_insts: std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            call_args: args
        };
        try branches.append(compiled_mir::grammar_branch(cond_insts, cond_result, reassign));
        string_counter = reassign_string_index + arg_strings;
        temp_counter = temp_counter + cond_inst_count;
        try_index = try_index + 1;
        let else_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "else", 0, bs
        );
        let else_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, else_node, "statement", 0, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, else_stmt, "If", bs)) {
            break;
        }
        node = else_stmt;
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::grammar_loop_stmt(
        carried_var, carried_type, init_name, llvm_return_type, branches, "gloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// value_cursor_cond_is_prefix_not_call reports whether a while condition is '!<free bool-pred
// call>(..)' -- a Prefix 'not' whose operand is a plain Call (not a TryExpr) on a free function
// (issue 1157 NEW-A). This is the append-while header shape ('while !is_call_close_token(close)').
// It is structurally distinct from the i64-induction While (a Binary comparison), the value-array
// loop (a Binary not-eq of field accesses) and the grammar loop (a Bool literal 'true'), so a true
// result never overlaps any of those headers.
fn value_cursor_cond_is_prefix_not_call(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Prefix", bs)) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-prefix ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "not") {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, right, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, right, bs));
}

// value_cursor_cond_is_plain_call reports whether the while header is a bare bool-predicate call
// '<pred>(<cursor>)' (no 'not' prefix), the parse_import_segments 'while is_double_colon(token)'
// shape. A free-function call (callee is not a field-expr method) gates it apart from a borrowed
// '.is_empty()' method probe; lowering evaluates the whole condition node through the generic
// expression path, so the branch reads the predicate result directly with no negation to invert.
fn value_cursor_cond_is_plain_call(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, cond_node, bs));
}

// value_cursor_statement_is_array_append reports whether a body statement is a 'try
// <array>.append(<x>);' void try-call -- an ExprStmt wrapping a try-call of the 'append' method on
// a local/param Array receiver (issue 1157 NEW-A). It is the append-while's accumulation step; the
// argument is not constrained here because the body lowering re-validates it through the shared
// void-try-call path. A near-miss (wrong method, non-local receiver) returns false.
fn value_cursor_statement_is_array_append(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "ExprStmt", bs)) {
        return false;
    }
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, expr, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    if !(try callee_is_field_expr(ir_bytes, function_name, inner, bs)) {
        return false;
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "append") {
        return false;
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    return try node_kind_is(ir_bytes, function_name, receiver_node, "Var", bs);
}

// value_cursor_statement_is_local_void_call reports whether the body statement at stmt_index is a
// 'try <free-fn>(.. <body-local> ..);' void try-call that consumes a value bound by an earlier let
// in the same loop body (parse_import_segments: 'try add_name_child(ast, segment)', where 'segment'
// is the prior let). It is the embedded value-cursor loop's non-array accumulation step: the call
// is a free function (callee is not a field-expr method, distinguishing it from the '.append(x)'
// array case) and at least one Var argument resolves to a prior body-local, so this consumes the
// loop-local work rather than a free side effect. The body lowering re-validates it through the
// shared void-try-call path.
fn value_cursor_statement_is_local_void_call(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    stmt_index: i64,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", stmt_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, statement, "ExprStmt", bs)) {
        return false;
    }
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, expr, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return false;
    }
    let arg_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, inner, "arg", bs
    );
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, inner, "arg", arg_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, arg_node, "Var", bs) {
            let arg_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, arg_node, bs
            );
            if try value_cursor_body_has_prior_let(
                ir_bytes, function_name, body_node, stmt_index, arg_name, bs
            ) {
                return true;
            }
        }
        arg_index = arg_index + 1;
    }
    return false;
}

// value_cursor_latch_is_try_call reports whether a body statement is a '<cursor> = try
// <free-call>(..);' value-cursor latch -- an Assign whose target is the carried cursor Var and
// whose value is a TryExpr wrapping a free-function call (issue 1157 NEW-A). The latch reassigns
// the cursor through an error-union try-call (next_call_arg_token), so the loop-head phi reads its
// success on the back-edge. A field-mode method call is rejected so only free helpers latch.
fn value_cursor_latch_is_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, inner, bs));
}

// value_cursor_latch_is_plain_call reports whether a body statement is a '<cursor> =
// <free-call>(..);' value-cursor latch -- an Assign to the carried cursor Var whose value is a
// non-try free-function Call (parse_import_segments: 'token = next_token(text, segment)'). It mirrors
// value_cursor_latch_is_try_call but the call returns its success type directly (no error union), so
// the loop-head phi reads %<cursor>_next from the latch block rather than a try-cont block. A
// field-mode method call is rejected so only free helpers latch.
fn value_cursor_latch_is_plain_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, value, bs));
}

fn value_cursor_body_has_prior_let(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    latch_index: i64,
    local_name: []u8,
    bs: i64
) -> !bool {
    var body_index = 0;
    while body_index < latch_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, statement, "Let", bs) {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            if std::mem::equal_bytes(
                try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs),
                local_name
            ) {
                return true;
            }
        }
        body_index = body_index + 1;
    }
    return false;
}

// value_cursor_latch_is_field_read reports whether the terminal body statement is
// '<cursor> = <prior-let>.<field>;' -- an Assign to the carried cursor whose value is a
// field-mode FieldExpr over a variable bound by an earlier let in the same loop body. The field
// name is deliberately not dispatched on; lowering resolves its actual type from the receiver
// struct facts and wires that value to the loop-head phi.
fn value_cursor_latch_is_field_read(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    latch_index: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", latch_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs),
        cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "FieldExpr", bs)) {
        return false;
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, value, bs
    );
    if !std::mem::equal_bytes(mode, "field") {
        return false;
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "receiver", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, receiver, "Var", bs)) {
        return false;
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, bs
    );
    return try value_cursor_body_has_prior_let(
        ir_bytes, function_name, body_node, latch_index, receiver_name, bs
    );
}

fn value_cursor_latch_is_supported(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    latch_index: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", latch_index, bs
    );
    if try value_cursor_latch_is_try_call(ir_bytes, function_name, statement, cursor_var, bs) {
        return true;
    }
    if try value_cursor_latch_is_plain_call(ir_bytes, function_name, statement, cursor_var, bs) {
        return true;
    }
    return try value_cursor_latch_is_field_read(
        ir_bytes, function_name, body_node, latch_index, cursor_var, bs
    );
}

// is_value_cursor_append_loop_shape reports whether this multi-statement function is the
// value-carried append-while loop NEW-A targets (issue 1157): exactly 'var <cursor> = <var>; while
// !<pred>(<cursor>) { <body incl. try <arr>.append(x)>; <cursor> = try <latch>(..); }; return
// <cursor>;'. The prefix-not bool-predicate-call header, the array-append body step and the
// free-try-call value-cursor latch are jointly distinct from the i64-induction While, the
// value-array loop and the grammar loop, so detecting it here diverts none of them.
// lower_value_cursor_append_loop re-walks and commits on a true result.
fn is_value_cursor_append_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return false;
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_value, "Var", bs)) {
        return false;
    }
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try value_cursor_cond_is_prefix_not_call(ir_bytes, function_name, cond_node, bs)) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_value, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs), cursor_var
    ) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return false;
    }
    // The last body statement is the value-cursor latch; at least one earlier statement is the
    // borrowed-array append. Both must hold for the append-while CFG to be well-formed.
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    if !(try value_cursor_latch_is_try_call(ir_bytes, function_name, latch_stmt, cursor_var, bs)) {
        return false;
    }
    var body_index = 0;
    while body_index < body_count - 1 {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if try value_cursor_statement_is_array_append(ir_bytes, function_name, body_stmt, bs) {
            return true;
        }
        body_index = body_index + 1;
    }
    return false;
}

// lower_value_cursor_append_loop lowers the value-carried append-while loop (issue 1157 NEW-A) into
// a single ValueCursorWhile statement. It derives every parameter from the IR: the cursor variable
// and its preheader seed from the init copy let, the loop-continue predicate (lowered through the
// shared expression path, so the prefix-not bool-predicate call reuses the generic machinery), the
// body statements (lowered through the same per-statement let/if/expr machinery the top level and
// the induction While body use, so a borrowed '&var Array' append lowers as a void try-call) and
// the free-try-call value-cursor latch. The carried type is the latch try-call's success type, so
// no struct width or symbol is hardcoded. The body try-calls take try indices below the latch's, so
// the renderer's fail/cont blocks never collide.
fn lower_value_cursor_append_loop(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    // The init copy 'var <cursor> = <init_name>' supplies the loop-head phi's preheader seed; the
    // copied local/param is an existing SSA value, so the let itself is elided (the phi subsumes it).
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, init_value, bs);
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, params_spec, cond_node, 0, 0, &var cond_insts, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    var body_string_counter = try count_strings_in_insts(&cond_insts);
    var body_temp_counter = cond_insts.len();
    var body_try_counter = 0;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let body_boundary = body_count - 1;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_alias_counter = 0;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, params_spec, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
                &var body_stmts, bs, ir_lookup_index, &var call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, params_spec, body_stmt,
                    body_string_counter, body_temp_counter, body_try_counter, body_alias_counter,
                    body_index + 1, &var body_aliases, &var body_stmts, bs, ir_lookup_index,
                    &var call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, params_spec,
                        body_stmt, body_string_counter, body_temp_counter, body_try_counter,
                        &body_aliases,
                        &var body_stmts, bs, ir_lookup_index, &var call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported append-while body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    // The last body statement is the value-cursor latch '<cursor> = try <free-call>(..);'. It binds
    // the cursor's next value through a let-position try-call; the renderer suffixes the bound name
    // with "_next" so the loop-head phi reads it on the latch's tryK_cont back-edge. A failure
    // propagates as this function's own error union. The latch try-call's success type is the
    // carried (cursor) type -- a struct value, not the i64 the shared induction latch requires.
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let latch_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_stmt, "value", 0, bs
    );
    let latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_value, "value", 0, bs
    );
    let latch_called_error_union = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, latch_call, bs
    );
    let cursor_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, latch_call, bs, ir_lookup_index
    );
    let latch_callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, latch_call, bs
    );
    let latch_callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, latch_call, bs
    );
    let latch_args = try compiled_mir_lower_call::lower_call_args_cached(
        ir_bytes, function_name, module_prefix, params_spec, latch_call, body_string_counter, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    let latch = compiled_mir::value_cursor_try_call_latch(
        cursor_var,
        latch_called_error_union,
        cursor_type,
        llvm_return_type,
        latch_callee_module_prefix,
        latch_callee_name,
        body_string_counter,
        body_try_counter,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        latch_args
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::value_cursor_while_stmt(
        cursor_var, cursor_type, init_name, llvm_return_type, cond_insts, cond_result, body_stmts,
        latch, "vcw", true
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

fn precedence_loop_suffixed_name(name: []u8, suffix: []u8) -> ![]u8 {
    var out = std::string::String(std::mem::page_allocator());
    try out.append_bytes(name);
    try out.append_bytes(suffix);
    let generated = out.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(generated, generated);
    return try copied.get(generated);
}

fn precedence_loop_call_uses_carried_field(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, arg_node, "FieldExpr", bs) {
            let receiver = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arg_node, "receiver", 0, bs
            );
            if try node_kind_is(ir_bytes, function_name, receiver, "Var", bs) {
                if std::mem::equal_bytes(
                    try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs),
                    carried_var
                ) {
                    return true;
                }
            }
        }
        arg_index = arg_index + 1;
    }
    return false;
}

fn precedence_loop_let_is_free_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, inner, bs));
}

fn precedence_loop_scalar_init_matches(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, value, bs) {
        return false;
    }
    return try precedence_loop_call_uses_carried_field(
        ir_bytes, function_name, module_prefix, locals_spec, value, carried_var, bs
    );
}

fn precedence_loop_cond_is_scalar_gte(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    scalar_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Binary", bs)) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "gte") {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, left, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left, bs), scalar_var
    ) {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    return try while_condition_value_eager_safe(ir_bytes, function_name, right, bs);
}

fn precedence_loop_scalar_latch_matches(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    scalar_var: []u8,
    carried_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), scalar_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, value, bs) {
        return false;
    }
    return try precedence_loop_call_uses_carried_field(
        ir_bytes, function_name, module_prefix, locals_spec, value, carried_var, bs
    );
}

fn precedence_loop_body_prefix_matches(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    bs: i64
) -> !bool {
    var found_try_let = false;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, body_stmt, "Let", bs)) {
            return false;
        }
        if try precedence_loop_let_is_free_try_call(ir_bytes, function_name, body_stmt, bs) {
            found_try_let = true;
        }
        body_index = body_index + 1;
    }
    return found_try_let;
}

// dual_cursor_call_uses_carried_var reports whether a call passes the carried var directly as a
// plain Var argument (e.g. 'next_token(text, end)' carries 'end'). Unlike the precedence loop's
// '<value>.field' projection, this shape threads the carried value itself, so the back-edge phi of
// that value feeds the call.
fn dual_cursor_call_uses_carried_var(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, arg_node, "Var", bs) {
            if std::mem::equal_bytes(
                try ir_contract::body_token_or_empty_from(ir_bytes, function_name, arg_node, bs),
                carried_var
            ) {
                return true;
            }
        }
        arg_index = arg_index + 1;
    }
    return false;
}

// dual_cursor_cond_is_predicate_call reports whether the while header is a side-effect-free
// predicate call over the carried scalar cursor (e.g. 'is_double_colon(next)'). It is a plain Call
// (not a field-mode method, not a comparison, not a prefix-not), distinguishing this shape from the
// precedence loop's '>=' comparison and the value-cursor loop's prefix-not predicate.
fn dual_cursor_cond_is_predicate_call(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    scalar_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, cond_node, bs) {
        return false;
    }
    return try dual_cursor_call_uses_carried_var(
        ir_bytes, function_name, cond_node, scalar_var, bs
    );
}

// dual_cursor_scalar_latch_matches reports whether a body statement is the scalar plain-call latch
// '<scalar> = <plain>(.. <value> ..);' -- an Assign to the carried scalar cursor whose value is a
// free call threading the updated carried value (e.g. 'next = next_token(text, end)').
fn dual_cursor_scalar_latch_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    scalar_var: []u8,
    carried_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), scalar_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, value, bs) {
        return false;
    }
    return try dual_cursor_call_uses_carried_var(
        ir_bytes, function_name, value, carried_var, bs
    );
}

// dual_cursor_body_prefix_all_lets reports whether every body statement before the two trailing
// latches is a Let (the per-iteration intermediates the latches consume, e.g. 'let segment =
// next_token(text, next)'). They lower generically through lower_multi_let_statement.
fn dual_cursor_body_prefix_all_lets(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    bs: i64
) -> !bool {
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, body_stmt, "Let", bs)) {
            return false;
        }
        body_index = body_index + 1;
    }
    return true;
}

// is_dual_cursor_loop_shape reports whether this function is the copy-seeded two-carried-value
// cursor loop (parse_type_base_end's '::' segment walk): 'var <value> = <source>; var <scalar> =
// <plain>(<value>); while <predicate>(<scalar>) { <prefix lets>; <value> = try <latch>(..);
// <scalar> = <plain>(<value>); }; return <value>;'. It does not overlap the other while shapes:
// the precedence loop seeds its value with a try-call and compares a scalar with '>=', grammar and
// type-apply loops use a bool-literal header, value-cursor loops carry one value behind a
// prefix-not predicate, and counted induction loops carry an arithmetic scalar latch. The
// distinguishing marks are the Var-copy value seed, the predicate-call header, and the paired
// try-call value latch plus plain-call scalar latch.
fn is_dual_cursor_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 4 {
        return false;
    }
    let value_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value_init_stmt, "Let", bs)) {
        return false;
    }
    let value_init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value_init_value, "Var", bs)) {
        return false;
    }
    let value_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "name", 0, bs
    );
    let value_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_name_node, bs
    );
    let scalar_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, scalar_init_stmt, "Let", bs)) {
        return false;
    }
    let scalar_init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, scalar_init_value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, scalar_init_value, bs) {
        return false;
    }
    if !(try dual_cursor_call_uses_carried_var(
        ir_bytes, function_name, scalar_init_value, value_var, bs
    )) {
        return false;
    }
    let scalar_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "name", 0, bs
    );
    let scalar_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scalar_name_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try dual_cursor_cond_is_predicate_call(
        ir_bytes, function_name, cond_node, scalar_var, bs
    )) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 3, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_value, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs),
        value_var
    ) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return false;
    }
    let value_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 2, bs
    );
    if !(try value_cursor_latch_is_try_call(
        ir_bytes, function_name, value_latch_stmt, value_var, bs
    )) {
        return false;
    }
    let scalar_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    if !(try dual_cursor_scalar_latch_matches(
        ir_bytes, function_name, scalar_latch_stmt, scalar_var, value_var, bs
    )) {
        return false;
    }
    return try dual_cursor_body_prefix_all_lets(
        ir_bytes, function_name, body_node, body_count - 2, bs
    );
}

// trailing_token_field_receiver_is reports whether a node is a 'field-of-var' projection
// '<var_name>.<field>' (a FieldExpr whose receiver is the plain Var <var_name>), e.g. the
// 'current.start' operand of the compound-AND header. A nested or non-Var receiver returns false.
fn trailing_token_field_receiver_is(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    var_name: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, node, "FieldExpr", bs)) {
        return false;
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "receiver", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, receiver, "Var", bs)) {
        return false;
    }
    return std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs),
        var_name
    );
}

// trailing_token_compare_uses_current_field reports whether a node is a relational comparison
// (lt/lte/gt/gte) with at least one operand a '<current>.<field>' projection -- the
// 'current.start < open.start' arm of the dual Token-cursor header. The carried Token's field drives
// the loop's termination, distinguishing this from a constant or unrelated comparison.
fn trailing_token_compare_uses_current_field(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    current_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, node, "Binary", bs)) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, node, bs
    );
    if !(std::mem::equal_bytes(op, "lt") or std::mem::equal_bytes(op, "lte") or
        std::mem::equal_bytes(op, "gt") or std::mem::equal_bytes(op, "gte")) {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "left", 0, bs
    );
    if try trailing_token_field_receiver_is(ir_bytes, function_name, left, current_var, bs) {
        return true;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    return try trailing_token_field_receiver_is(ir_bytes, function_name, right, current_var, bs);
}

// trailing_token_predicate_uses_current reports whether a node is a side-effect-free bool predicate
// over the carried Token cursor -- a plain call carrying <current> as a Var argument, optionally
// wrapped in a prefix '!' (e.g. '!is_eof_token(current)'). It is the second AND arm of the header;
// keeping it side-effect-free is what lets the compound condition lower eagerly.
fn trailing_token_predicate_uses_current(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    current_var: []u8,
    bs: i64
) -> !bool {
    var call_node = node;
    if try node_kind_is(ir_bytes, function_name, node, "Prefix", bs) {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, node, bs
        );
        if !std::mem::equal_bytes(op, "not") {
            return false;
        }
        call_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
    }
    if !(try node_kind_is(ir_bytes, function_name, call_node, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, call_node, bs) {
        return false;
    }
    return try dual_cursor_call_uses_carried_var(
        ir_bytes, function_name, call_node, current_var, bs
    );
}

// trailing_token_cond_is_compound_advance reports whether the while header is the compound AND
// '<current>.<field> < <other>.<field> and <predicate>(<current>)' -- a field comparison advancing
// against a bound plus a side-effect-free bool predicate, both carrying the <current> cursor. The
// AND of a relational comparison with a predicate call is what distinguishes this header from the
// dual-cursor loop's single predicate call and the precedence loop's bare '>=' comparison.
fn trailing_token_cond_is_compound_advance(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    current_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Binary", bs)) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "and") {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    if !(try trailing_token_compare_uses_current_field(
        ir_bytes, function_name, left, current_var, bs
    )) {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    return try trailing_token_predicate_uses_current(
        ir_bytes, function_name, right, current_var, bs
    );
}

// trailing_token_copy_latch_matches reports whether a body statement is the copy latch
// '<previous> = <current>;' -- an Assign to <previous> whose value is the plain Var <current>. This
// is the trailing-token tracker step: it carries no instruction at lowering (the head <previous> phi
// reads the <current> phi on the back edge), so detecting it here keeps the body to its two latches.
fn trailing_token_copy_latch_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    previous_var: []u8,
    current_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), previous_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Var", bs)) {
        return false;
    }
    return std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, value, bs), current_var
    );
}

// is_trailing_token_loop_shape reports whether this function is the dual Token-cursor advance loop
// that tracks the trailing token (generic_type_allows_const_arg's '<'-walk, NEW-3 second half): 'var
// <current> = <plain init>; var <previous> = <current>; while <current>.<field> < <other>.<field>
// and <predicate>(<current>) { <previous> = <current>; <current> = <plain>(<current>); }; <post
// stmts using previous>'. Both cursors share one Token type. It does not overlap the other while
// shapes: the dual-cursor loop's statement 0 is a Var-copy (here it is the plain-call seed) and its
// header is a single predicate call (here a compound AND), the precedence loop seeds its value with a
// try-call and compares a scalar with '>=', grammar/type-apply/while-match loops use a bool-literal
// header, value-cursor loops carry one value behind a prefix-not predicate, and counted induction
// loops carry an arithmetic scalar latch. The distinguishing marks are the plain-call seed at
// statement 0, the Var-copy second seed at statement 1, the compound-AND header, the
// '<previous> = <current>' copy latch plus '<current> = <plain>(<current>)' advance latch, and the
// post-loop statements that consume <previous>.
fn is_trailing_token_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count < 4 {
        return false;
    }
    let current_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, current_init_stmt, "Let", bs)) {
        return false;
    }
    let current_init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, current_init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, current_init_value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, current_init_value, bs) {
        return false;
    }
    let current_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, current_init_stmt, "name", 0, bs
    );
    let current_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, current_name_node, bs
    );
    let previous_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, previous_init_stmt, "Let", bs)) {
        return false;
    }
    let previous_init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, previous_init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, previous_init_value, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, previous_init_value, bs),
        current_var
    ) {
        return false;
    }
    let previous_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, previous_init_stmt, "name", 0, bs
    );
    let previous_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, previous_name_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try trailing_token_cond_is_compound_advance(
        ir_bytes, function_name, cond_node, current_var, bs
    )) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 2 {
        return false;
    }
    let copy_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !(try trailing_token_copy_latch_matches(
        ir_bytes, function_name, copy_latch_stmt, previous_var, current_var, bs
    )) {
        return false;
    }
    let advance_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    if !(try dual_cursor_scalar_latch_matches(
        ir_bytes, function_name, advance_latch_stmt, current_var, current_var, bs
    )) {
        return false;
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", statement_count - 1, bs
    );
    return try node_kind_is(ir_bytes, function_name, last_stmt, "Return", bs);
}

// is_precedence_loop_shape reports whether this function is the two-carried-value
// precedence-climbing loop targeted by issue 1157: exactly value try-call init, scalar
// plain-call init from a carried-value field, a while header comparing that scalar with
// '>=' against a side-effect-free rhs, body lets ending in value try-call latch plus scalar
// plain-call latch, and a final return of the carried value. This does not overlap the
// other while shapes: grammar loops use a bool-literal header, value-cursor loops use a
// prefix-not predicate and one carried value, value-array loops compare struct-field
// sentinels, and counted induction loops carry scalar arithmetic latches.
fn is_precedence_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 4 {
        return false;
    }
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let value_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try precedence_loop_let_is_free_try_call(ir_bytes, function_name, value_init_stmt, bs)) {
        return false;
    }
    let value_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "name", 0, bs
    );
    let value_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_name_node, bs
    );
    let scalar_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try precedence_loop_scalar_init_matches(
        ir_bytes, function_name, module_prefix, params_spec, scalar_init_stmt, value_var, bs
    )) {
        return false;
    }
    let scalar_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "name", 0, bs
    );
    let scalar_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scalar_name_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try precedence_loop_cond_is_scalar_gte(
        ir_bytes, function_name, cond_node, scalar_var, bs
    )) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 3, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_value, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs),
        value_var
    ) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 3 {
        return false;
    }
    let value_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 2, bs
    );
    if !(try value_cursor_latch_is_try_call(
        ir_bytes, function_name, value_latch_stmt, value_var, bs
    )) {
        return false;
    }
    let scalar_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    if !(try precedence_loop_scalar_latch_matches(
        ir_bytes, function_name, module_prefix, params_spec, scalar_latch_stmt,
        scalar_var, value_var, bs
    )) {
        return false;
    }
    return try precedence_loop_body_prefix_matches(
        ir_bytes, function_name, body_node, body_count - 2, bs
    );
}

fn lower_precedence_loop_try_call(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirLetTryCallStmt {
    let called_error_union = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, call_node, bs, ir_lookup_index
    );
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    var arg_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    let _lowered_args = try lower_try_call_args_with_local_aliases_cached(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        call_node,
        string_counter,
        temp_counter,
        aliases,
        &var arg_insts,
        &var args,
        bs,
        ir_lookup_index,
        call_arg_type_cache
    );
    return compiled_mir::MirLetTryCallStmt {
        name: let_name,
        called_error_union: called_error_union,
        success_type: success_type,
        own_error_union: llvm_return_type,
        call_module_prefix: callee_module_prefix,
        call_callee_name: callee_name,
        string_index: string_counter,
        try_index: try_counter,
        arg_insts: arg_insts,
        call_args: args
    };
}

fn lower_precedence_loop_plain_call(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    bind_name: []u8,
    call_node: i64,
    string_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirLetCallStmt {
    let call_type = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, aliases, bs,
        ir_lookup_index, call_arg_type_cache
    );
    return compiled_mir::MirLetCallStmt {
        name: bind_name,
        llvm_type: call_type,
        string_index: string_counter,
        call_module_prefix: callee_module_prefix,
        call_callee_name: callee_name,
        call_args: args
    };
}

fn lower_precedence_loop(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    var empty_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer empty_aliases.deinit();
    let value_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let value_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "name", 0, bs
    );
    let value_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_name_node, bs
    );
    let value_init_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "value", 0, bs
    );
    let value_init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_expr, "value", 0, bs
    );
    let value_init = try lower_precedence_loop_try_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, llvm_return_type, params_spec,
        value_var, value_init_call, 0, 0, 0, &empty_aliases, bs, &var call_arg_type_cache
    );
    let value_type = value_init.success_type;
    let value_init_string_counter =
        try count_strings_in_insts(&value_init.arg_insts) +
        try compiled_mir_lower_call::count_string_args(&value_init.call_args);
    let value_init_temp_counter = value_init.arg_insts.len();
    let value_init_try_counter = 1;
    let value_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, value_var, value_type
    );
    let value_init_name = try precedence_loop_suffixed_name(value_var, "_init");
    var init_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer init_aliases.deinit();
    try init_aliases.append(LocalAliasState {
        source_name: value_var,
        current_name: value_init_name
    });
    let scalar_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let scalar_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "name", 0, bs
    );
    let scalar_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scalar_name_node, bs
    );
    let scalar_init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "value", 0, bs
    );
    let scalar_init_name = try precedence_loop_suffixed_name(scalar_var, "_init");
    let scalar_init = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, value_locals,
        scalar_init_name, scalar_init_call, value_init_string_counter, &init_aliases, bs,
        &var call_arg_type_cache
    );
    let scalar_type = scalar_init.llvm_type;
    let scalar_init_string_counter =
        value_init_string_counter +
        try compiled_mir_lower_call::count_string_args(&scalar_init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, value_locals, scalar_var, scalar_type
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, loop_locals, cond_node,
        scalar_init_string_counter, value_init_temp_counter, &var cond_insts, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    var body_string_counter = scalar_init_string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = value_init_temp_counter + cond_insts.len();
    var body_try_counter = value_init_try_counter;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let body_boundary = body_count - 2;
    var body_locals = loop_locals;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_alias_counter = 0;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
                &var body_stmts, bs, ir_lookup_index, &var call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                    body_string_counter, body_temp_counter, body_try_counter, body_alias_counter,
                    body_index + 1, &var body_aliases, &var body_stmts, bs, ir_lookup_index,
                    &var call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
                        body_stmt, body_string_counter, body_temp_counter, body_try_counter,
                        &body_aliases,
                        &var body_stmts, bs, ir_lookup_index, &var call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported precedence-loop body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    let value_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 2, bs
    );
    let value_latch_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_latch_stmt, "value", 0, bs
    );
    let value_latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_latch_expr, "value", 0, bs
    );
    let value_latch = try lower_precedence_loop_try_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
        value_var, value_latch_call, body_string_counter, body_temp_counter, body_try_counter,
        &body_aliases, bs, &var call_arg_type_cache
    );
    let value_latch_string_counter =
        body_string_counter + try count_strings_in_insts(&value_latch.arg_insts) +
        try compiled_mir_lower_call::count_string_args(&value_latch.call_args);
    let value_next_name = try precedence_loop_suffixed_name(value_var, "_next");
    var latch_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer latch_aliases.deinit();
    try latch_aliases.append(LocalAliasState {
        source_name: value_var,
        current_name: value_next_name
    });
    let scalar_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let scalar_latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_latch_stmt, "value", 0, bs
    );
    let scalar_latch_name = try precedence_loop_suffixed_name(scalar_var, "_next");
    let scalar_latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, body_locals,
        scalar_latch_name, scalar_latch_call, value_latch_string_counter, &latch_aliases, bs,
        &var call_arg_type_cache
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::precedence_loop_stmt(
        value_var, value_type, scalar_var, scalar_type, llvm_return_type,
        value_init, scalar_init, cond_insts, cond_result, body_stmts,
        value_latch, scalar_latch, "ploop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

fn lower_dual_cursor_loop(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    // The value cursor is seeded by copying a prior local/param: its preheader phi value is that
    // source SSA name, so no value-init call is lowered.
    let value_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let value_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "name", 0, bs
    );
    let value_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_name_node, bs
    );
    let value_source_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "value", 0, bs
    );
    let value_source_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_source_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    // The value type comes from the try-call latch's success type, which the copied source shares.
    let value_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 2, bs
    );
    let value_latch_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_latch_stmt, "value", 0, bs
    );
    let value_latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_latch_expr, "value", 0, bs
    );
    let value_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, value_latch_call, bs, ir_lookup_index
    );
    let value_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, value_var, value_type
    );
    // The scalar cursor is seeded by a plain call that reads the copied value source, so its init
    // call is lowered with the value aliased to that source SSA name.
    let scalar_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let scalar_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "name", 0, bs
    );
    let scalar_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scalar_name_node, bs
    );
    let scalar_init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "value", 0, bs
    );
    var init_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer init_aliases.deinit();
    try init_aliases.append(LocalAliasState {
        source_name: value_var,
        current_name: value_source_var
    });
    let scalar_init_name = try precedence_loop_suffixed_name(scalar_var, "_init");
    let scalar_init = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, value_locals,
        scalar_init_name, scalar_init_call, 0, &init_aliases, bs, &var call_arg_type_cache
    );
    let scalar_type = scalar_init.llvm_type;
    let scalar_init_string_counter =
        try compiled_mir_lower_call::count_string_args(&scalar_init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, value_locals, scalar_var, scalar_type
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, loop_locals, cond_node,
        scalar_init_string_counter, 0, &var cond_insts, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    var body_string_counter = scalar_init_string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = cond_insts.len();
    var body_try_counter = 0;
    let body_boundary = body_count - 2;
    var body_locals = loop_locals;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_alias_counter = 0;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
                &var body_stmts, bs, ir_lookup_index, &var call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            return error("compiled mir: unsupported dual-cursor-loop body statement");
        }
        body_index = body_index + 1;
    }
    let value_latch = try lower_precedence_loop_try_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
        value_var, value_latch_call, body_string_counter, body_temp_counter, body_try_counter,
        &body_aliases, bs, &var call_arg_type_cache
    );
    let value_latch_string_counter =
        body_string_counter + try count_strings_in_insts(&value_latch.arg_insts) +
        try compiled_mir_lower_call::count_string_args(&value_latch.call_args);
    let value_next_name = try precedence_loop_suffixed_name(value_var, "_next");
    var latch_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer latch_aliases.deinit();
    try latch_aliases.append(LocalAliasState {
        source_name: value_var,
        current_name: value_next_name
    });
    let scalar_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let scalar_latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_latch_stmt, "value", 0, bs
    );
    let scalar_latch_name = try precedence_loop_suffixed_name(scalar_var, "_next");
    let scalar_latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, body_locals,
        scalar_latch_name, scalar_latch_call, value_latch_string_counter, &latch_aliases, bs,
        &var call_arg_type_cache
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::dual_cursor_loop_stmt(
        value_var, value_type, value_source_var, scalar_var, scalar_type, llvm_return_type,
        scalar_init, cond_insts, cond_result, body_stmts,
        value_latch, scalar_latch, "dcloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_trailing_token_loop lowers the dual Token-cursor advance loop (NEW-3 second half). It seeds
// %<current> through the plain init call, lowers the compound-AND header eagerly, lowers the
// '<current> = <plain>(<current>)' advance latch (the '<previous> = <current>' copy latch needs no
// instruction -- it is the head <previous> phi's back edge), and emits one TrailingTokenLoop MirStmt
// whose renderer opens a fall-through exit block. The post-loop statements (statement 3 onward) lower
// through the same per-statement path the top-level function loop uses and are appended as ordinary
// trailing MirStmts so they render into that open exit block, reading the loop-carried %<previous>
// and %<current> phis. The post statements start their expr-temp window above the header insts so
// %t<n> names never collide with the loop head's condition temps.
fn lower_trailing_token_loop(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    var empty_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer empty_aliases.deinit();
    // The current cursor is seeded by a plain call; its preheader phi value is %<current>_init.
    let current_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let current_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, current_init_stmt, "name", 0, bs
    );
    let current_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, current_name_node, bs
    );
    let current_init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, current_init_stmt, "value", 0, bs
    );
    let init_name = try precedence_loop_suffixed_name(current_var, "_init");
    let init = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        init_name, current_init_call, 0, &empty_aliases, bs, &var call_arg_type_cache
    );
    let token_type = init.llvm_type;
    let init_string_counter = try compiled_mir_lower_call::count_string_args(&init.call_args);
    // The previous cursor is a Var-copy of current; both cursors share the Token type.
    let previous_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let previous_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, previous_init_stmt, "name", 0, bs
    );
    let previous_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, previous_name_node, bs
    );
    let current_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, current_var, token_type
    );
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, current_locals, previous_var, token_type
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, loop_locals, cond_node,
        init_string_counter, 0, &var cond_insts, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    let cond_inst_count = cond_insts.len();
    let cond_string_counter = init_string_counter + try count_strings_in_insts(&cond_insts);
    // The advance latch '<current> = <plain>(<current>)' refreshes the cursor as %<current>_next.
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let advance_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    let advance_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, advance_latch_stmt, "value", 0, bs
    );
    let latch_name = try precedence_loop_suffixed_name(current_var, "_next");
    let latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, loop_locals,
        latch_name, advance_call, cond_string_counter, &empty_aliases, bs, &var call_arg_type_cache
    );
    let latch_string_counter =
        cond_string_counter + try compiled_mir_lower_call::count_string_args(&latch.call_args);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::trailing_token_loop_stmt(
        current_var, previous_var, token_type, init, cond_insts, cond_result, latch, "ttloop"
    ));
    // The post-loop statements render into the loop's fall-through exit block. They read the
    // loop-carried %<previous>/%<current> phis, so lower them with both cursors in scope, and start
    // their expr-temp window past the header insts so %t<n> names never collide.
    var post_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer post_aliases.deinit();
    var post_locals = loop_locals;
    var post_string_counter = latch_string_counter;
    var post_temp_counter = cond_inst_count;
    var post_try_counter = 0;
    var post_alias_counter = 0;
    var post_index = 3;
    while post_index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", post_index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Return") {
            try stmts.append(try lower_multi_return_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, post_locals, statement,
                post_string_counter, post_temp_counter, &post_aliases, bs, ir_lookup_index,
                &var call_arg_type_cache
            ));
        } else {
            if std::mem::equal_bytes(stmt_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, post_locals, statement,
                    post_string_counter, post_temp_counter, post_try_counter, post_alias_counter,
                    post_index, &var post_aliases, &var stmts, bs, ir_lookup_index,
                    &var call_arg_type_cache
                );
                post_temp_counter = if_result.temp_counter;
                post_string_counter = if_result.string_counter;
                post_try_counter = if_result.try_counter;
                post_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(stmt_kind, "Let") {
                    let let_result = try lower_multi_let_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, post_locals,
                        statement, post_string_counter, post_temp_counter, post_try_counter,
                        &var post_aliases, &var stmts, bs, ir_lookup_index, &var call_arg_type_cache
                    );
                    post_locals = let_result.locals_spec;
                    post_string_counter = let_result.string_counter;
                    post_temp_counter = let_result.temp_counter;
                    post_try_counter = let_result.try_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                        let expr_result = try lower_multi_expr_statement(
                            ir_bytes, function_name, module_prefix, llvm_return_type, post_locals,
                            statement, post_string_counter, post_temp_counter, post_try_counter,
                            &post_aliases, &var stmts, bs, ir_lookup_index, &var call_arg_type_cache
                        );
                        post_string_counter = expr_result.string_counter;
                        post_try_counter = expr_result.try_counter;
                    } else {
                        return error("compiled mir: unsupported trailing-token-loop post statement");
                    }
                }
            }
        }
        post_index = post_index + 1;
    }
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

fn type_apply_loop_bool_true_header(
    ir_bytes: []u8,
    function_name: []u8,
    while_statement: i64,
    bs: i64
) -> !bool {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Bool", bs)) {
        return false;
    }
    return std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, cond_node, bs),
        "true"
    );
}

fn type_apply_loop_let_is_plain_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, value, bs));
}

fn type_apply_loop_assign_is_plain_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs),
        cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, value, bs));
}

fn type_apply_loop_return_is_error_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Return", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    return try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, value, bs);
}

fn type_apply_terminal_let_call_matches(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    stmt_index: i64,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, block_node, "statement", stmt_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    return try node_kind_is(ir_bytes, function_name, value, "Call", bs);
}

fn type_apply_terminal_index_init_matches(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    stmt_index: i64,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, block_node, "statement", stmt_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    return try node_kind_is(ir_bytes, function_name, value, "Int", bs);
}

fn type_apply_terminal_if_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "If", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, cond_node, bs) {
        return false;
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count != 7 {
        return false;
    }
    if !(try type_apply_terminal_let_call_matches(ir_bytes, function_name, then_node, 0, bs)) {
        return false;
    }
    if !(try type_apply_terminal_index_init_matches(ir_bytes, function_name, then_node, 1, bs)) {
        return false;
    }
    let child_loop = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, child_loop, "While", bs)) {
        return false;
    }
    if !(try type_apply_terminal_let_call_matches(ir_bytes, function_name, then_node, 3, bs)) {
        return false;
    }
    if !(try type_apply_terminal_let_call_matches(ir_bytes, function_name, then_node, 4, bs)) {
        return false;
    }
    if !(try type_apply_terminal_let_call_matches(ir_bytes, function_name, then_node, 5, bs)) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 6, bs
    );
    return try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs);
}

fn type_apply_error_guard_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "If", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    if !(try value_cursor_cond_is_prefix_not_call(ir_bytes, function_name, cond_node, bs)) {
        return false;
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count != 1 {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    return try type_apply_loop_return_is_error_call(ir_bytes, function_name, return_stmt, bs);
}

// is_type_apply_loop_shape reports whether this function is the parse_type_apply_expr_with_args
// cursor loop: a plain-call Token seed, a bool-literal 'while true' header, a try-call parse let,
// a borrowed-array append, a terminal construction return arm, a comma error guard, a plain-call
// cursor latch, and an unreachable trailing error return. This is orthogonal to the existing
// while-true grammar-postfix shape because that one starts from a Var seed and its body is a
// nested if/else reassignment chain; it also cannot overlap value-cursor/value-array loops, whose
// headers are prefix-not and struct-sentinel comparisons rather than the bool literal.
fn is_type_apply_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try type_apply_loop_let_is_plain_call(ir_bytes, function_name, init_stmt, bs)) {
        return false;
    }
    let cursor_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, cursor_name_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    if !(try type_apply_loop_bool_true_header(ir_bytes, function_name, while_statement, bs)) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 5 {
        return false;
    }
    let parse_arg_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !(try precedence_loop_let_is_free_try_call(ir_bytes, function_name, parse_arg_stmt, bs)) {
        return false;
    }
    let append_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    if !(try value_cursor_statement_is_array_append(ir_bytes, function_name, append_stmt, bs)) {
        return false;
    }
    let terminal_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 2, bs
    );
    if !(try type_apply_terminal_if_matches(ir_bytes, function_name, terminal_stmt, bs)) {
        return false;
    }
    let guard_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 3, bs
    );
    if !(try type_apply_error_guard_matches(ir_bytes, function_name, guard_stmt, bs)) {
        return false;
    }
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 4, bs
    );
    if !(try type_apply_loop_assign_is_plain_call(
        ir_bytes, function_name, latch_stmt, cursor_var, bs
    )) {
        return false;
    }
    let trailing_return = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    return try type_apply_loop_return_is_error_call(
        ir_bytes, function_name, trailing_return, bs
    );
}

fn lower_type_apply_nested_counted_while(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    while_statement: i64,
    loop_index: i64,
    induction_var: []u8,
    induction_init: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, locals_spec, cond_node,
        string_counter, temp_counter, &var cond_insts, bs, ir_lookup_index, call_arg_type_cache
    );
    var body_string_counter = string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = temp_counter + cond_insts.len();
    var body_try_counter = try_counter;
    var body_alias_counter = alias_counter;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let latch_count = try while_trailing_increment_count(
        ir_bytes, function_name, body_node, body_count, bs
    );
    let body_boundary = body_count - latch_count;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, aliases,
                &var body_stmts, bs, ir_lookup_index, call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, body_stmt,
                    body_string_counter, body_temp_counter, body_try_counter, body_alias_counter,
                    loop_index * 1000 + body_index + 1, aliases, &var body_stmts, bs,
                    ir_lookup_index, call_arg_type_cache
                );
                body_string_counter = if_result.string_counter;
                body_temp_counter = if_result.temp_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                        body_stmt, body_string_counter, body_temp_counter, body_try_counter,
                        aliases, &var body_stmts, bs, ir_lookup_index, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported type-apply child loop body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    let increment_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let step = try parse_induction_step(ir_bytes, function_name, increment_stmt, induction_var, bs);
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_var,
        induction_init,
        "",
        0,
        step,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        "",
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        -1,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator())
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: body_try_counter,
        alias_counter: body_alias_counter
    };
}

fn lower_type_apply_terminal_block(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    then_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    terminal_stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    var terminal_locals = locals_spec;
    var terminal_strings = string_counter;
    var terminal_temps = temp_counter;
    var terminal_tries = try_counter;
    var terminal_alias_counter = alias_counter;
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    var body_index = 0;
    while body_index < then_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_node, "statement", body_index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let next_statement = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, then_node, "statement", body_index + 1, bs
            );
            var is_nested_induction_seed = false;
            if next_statement >= 0 {
                let next_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, next_statement, bs
                );
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
                if std::mem::equal_bytes(next_kind, "While") and
                    (try node_kind_is(ir_bytes, function_name, value, "Int", bs)) {
                    is_nested_induction_seed = true;
                }
            }
            if is_nested_induction_seed {
                let name_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "name", 0, bs
                );
                let name = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, name_node, bs
                );
                terminal_locals = try compiled_signature::extend_locals_spec(
                    ir_bytes, terminal_locals, name, "i64"
                );
            } else {
                let let_result = try lower_multi_let_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, terminal_locals,
                    statement, terminal_strings, terminal_temps, terminal_tries, aliases,
                    terminal_stmts, bs, ir_lookup_index, call_arg_type_cache
                );
                terminal_locals = let_result.locals_spec;
                terminal_strings = let_result.string_counter;
                terminal_temps = let_result.temp_counter;
                terminal_tries = let_result.try_counter;
            }
        } else {
            if std::mem::equal_bytes(stmt_kind, "While") {
                let init_stmt = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, then_node, "statement", body_index - 1, bs
                );
                let name_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, init_stmt, "name", 0, bs
                );
                let induction_var = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, name_node, bs
                );
                let init_value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, init_stmt, "value", 0, bs
                );
                let init_literal = try ir_contract::body_int_value_from(
                    ir_bytes, function_name, init_value, bs
                );
                let while_result = try lower_type_apply_nested_counted_while(
                    ir_bytes, function_name, module_prefix, llvm_return_type, terminal_locals,
                    statement, 7000 + body_index, induction_var, init_literal, terminal_strings,
                    terminal_temps, terminal_tries, terminal_alias_counter, aliases,
                    terminal_stmts, bs, ir_lookup_index, call_arg_type_cache
                );
                terminal_strings = while_result.string_counter;
                terminal_temps = while_result.temp_counter;
                terminal_tries = while_result.try_counter;
                terminal_alias_counter = while_result.alias_counter;
            } else {
                if std::mem::equal_bytes(stmt_kind, "Return") {
                    try terminal_stmts.append(try lower_multi_return_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, terminal_locals,
                        statement, terminal_strings, terminal_temps, aliases, bs,
                        ir_lookup_index, call_arg_type_cache
                    ));
                    let ret_stmt = try terminal_stmts.at(terminal_stmts.len() - 1);
                    let advance = try continue_latch_return_advance(
                        &ret_stmt, terminal_temps, terminal_strings
                    );
                    terminal_strings = advance.string_counter;
                    terminal_temps = advance.temp_counter;
                } else {
                    return error("compiled mir: unsupported type-apply terminal statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    return MultiIfLowerResult {
        temp_counter: terminal_temps,
        string_counter: terminal_strings,
        try_counter: terminal_tries,
        alias_counter: terminal_alias_counter
    };
}

fn lower_type_apply_loop(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    var empty_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer empty_aliases.deinit();
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let cursor_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, cursor_name_node, bs
    );
    let init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_name = try precedence_loop_suffixed_name(cursor_var, "_init");
    let init = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        init_name, init_call, 0, &empty_aliases, bs, &var call_arg_type_cache
    );
    let cursor_type = init.llvm_type;
    let init_string_counter = try compiled_mir_lower_call::count_string_args(&init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, cursor_var, cursor_type
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let parse_arg_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    let arg_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, parse_arg_stmt, "name", 0, bs
    );
    let arg_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, arg_name_node, bs
    );
    let parse_arg_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, parse_arg_stmt, "value", 0, bs
    );
    let parse_arg_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, parse_arg_expr, "value", 0, bs
    );
    let parse_arg = try lower_precedence_loop_try_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, llvm_return_type, loop_locals,
        arg_var, parse_arg_call, init_string_counter, 0, 0, &empty_aliases, bs,
        &var call_arg_type_cache
    );
    let arg_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, loop_locals, arg_var, parse_arg.success_type
    );
    var body_string_counter =
        init_string_counter + try count_strings_in_insts(&parse_arg.arg_insts) +
        try compiled_mir_lower_call::count_string_args(&parse_arg.call_args);
    var body_temp_counter = parse_arg.arg_insts.len();
    var body_try_counter = 1;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    let append_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    let append_result = try lower_multi_expr_statement(
        ir_bytes, function_name, module_prefix, llvm_return_type, arg_locals, append_stmt,
        body_string_counter, body_temp_counter, body_try_counter, &body_aliases,
        &var body_stmts, bs, ir_lookup_index, &var call_arg_type_cache
    );
    body_string_counter = append_result.string_counter;
    body_try_counter = append_result.try_counter;
    let terminal_if = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 2, bs
    );
    let terminal_cond = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "condition", 0, bs
    );
    var terminal_cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let terminal_cond_result = try lower_expr_with_local_aliases(
        ir_bytes, function_name, module_prefix, arg_locals, terminal_cond,
        body_string_counter, body_temp_counter, &var terminal_cond_insts, &body_aliases, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    let terminal_string_counter =
        body_string_counter + try count_strings_in_insts(&terminal_cond_insts);
    let terminal_temp_counter = body_temp_counter + terminal_cond_insts.len();
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "then", 0, bs
    );
    var terminal_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var terminal_aliases = try copy_local_aliases(&body_aliases);
    defer terminal_aliases.deinit();
    let terminal_result = try lower_type_apply_terminal_block(
        ir_bytes, function_name, module_prefix, llvm_return_type, arg_locals, then_node,
        terminal_string_counter, terminal_temp_counter, body_try_counter, 0,
        &var terminal_aliases, &var terminal_stmts, bs, ir_lookup_index,
        &var call_arg_type_cache
    );
    var guard_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var guard_aliases = try copy_local_aliases(&body_aliases);
    defer guard_aliases.deinit();
    let guard_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 3, bs
    );
    let guard_result = try lower_multi_if_statement(
        ir_bytes, function_name, module_prefix, llvm_return_type, arg_locals, guard_stmt,
        terminal_result.string_counter, terminal_result.temp_counter,
        terminal_result.try_counter, terminal_result.alias_counter, 6000,
        &var guard_aliases, &var guard_stmts, bs, ir_lookup_index, &var call_arg_type_cache
    );
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 4, bs
    );
    let latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_stmt, "value", 0, bs
    );
    let latch_name = try precedence_loop_suffixed_name(cursor_var, "_next");
    let latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, arg_locals,
        latch_name, latch_call, guard_result.string_counter, &guard_aliases, bs,
        &var call_arg_type_cache
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::type_apply_loop_stmt(
        cursor_var, cursor_type, llvm_return_type, init, parse_arg, body_stmts,
        terminal_cond_insts, terminal_cond_result, terminal_stmts, guard_stmts,
        latch, "taloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// while_match_arm_body_or_minus_one returns the single statement node of a match arm body,
// unwrapping a one-statement Block, or -1 if the arm body holds more than one statement.
fn while_match_arm_body_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    arm_node: i64,
    bs: i64
) -> !i64 {
    let body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arm_node, "body", 0, bs
    );
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body, bs);
    if std::mem::equal_bytes(body_kind, "Block") {
        let extra = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, body, "statement", 1, bs
        );
        if extra >= 0 {
            return 0 - 1;
        }
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body, "statement", 0, bs
        );
    }
    return body;
}

// while_match_body_is_cursor_try_latch reports whether a match-arm body statement is a cursor
// latch '<cursor> = try <free-call>(..)': an Assign whose target is the loop cursor Var and whose
// value is a TryExpr wrapping a non-field (free) Call.
fn while_match_body_is_cursor_try_latch(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs),
        cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, inner, bs));
}

// while_match_arms_are_supported validates the match dispatch arms: at least two arms, exactly one
// cursor-latch arm, every other arm a single 'return', and the final (exhaustive fallthrough) arm a
// return arm rather than the latch. This keeps the latch off the unconditional fallthrough block so
// it always reaches the loop head through an explicit icmp.
fn while_match_arms_are_supported(
    ir_bytes: []u8,
    function_name: []u8,
    match_stmt: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_stmt, "arm", bs
    );
    if arm_count < 2 {
        return false;
    }
    var latch_count = 0;
    var index = 0;
    while index < arm_count {
        let arm_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_stmt, "arm", index, bs
        );
        let body = try while_match_arm_body_or_minus_one(ir_bytes, function_name, arm_node, bs);
        if body < 0 {
            return false;
        }
        if try while_match_body_is_cursor_try_latch(ir_bytes, function_name, body, cursor_var, bs) {
            if index == arm_count - 1 {
                return false;
            }
            latch_count = latch_count + 1;
        } else {
            if !(try node_kind_is(ir_bytes, function_name, body, "Return", bs)) {
                return false;
            }
        }
        index = index + 1;
    }
    return latch_count == 1;
}

// is_while_match_loop_shape reports whether this function is parse_generic_type_end's 'while true'
// + match-dispatch loop: a plain-call Token seed, a bool-literal 'while true' header, a body of
// [free try-call let, plain-call let, match <token>.kind { .. }] whose match latches the cursor in
// one arm and returns from every other, and a trailing error-call return. It reuses the type-apply
// loop's plain-call-let / bool-true-header / error-return detectors; the discriminator is the
// 3-statement body ending in a Match (the type-apply loop ends in parse/append/if/guard/latch),
// so the two never overlap, and the latch-in-a-match arm distinguishes it from the bare
// EnumDispatch shape (whose every arm returns).
fn is_while_match_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try type_apply_loop_let_is_plain_call(ir_bytes, function_name, init_stmt, bs)) {
        return false;
    }
    let cursor_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, cursor_name_node, bs
    );
    if std::mem::len(cursor_var) == 0 {
        return false;
    }
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    if !(try type_apply_loop_bool_true_header(ir_bytes, function_name, while_statement, bs)) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 3 {
        return false;
    }
    let parse_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !(try precedence_loop_let_is_free_try_call(ir_bytes, function_name, parse_stmt, bs)) {
        return false;
    }
    let next_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    if !(try type_apply_loop_let_is_plain_call(ir_bytes, function_name, next_stmt, bs)) {
        return false;
    }
    let match_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, match_stmt, "Match", bs)) {
        return false;
    }
    if !(try while_match_arms_are_supported(
        ir_bytes, function_name, match_stmt, cursor_var, bs
    )) {
        return false;
    }
    let trailing_return = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    return try type_apply_loop_return_is_error_call(
        ir_bytes, function_name, trailing_return, bs
    );
}

fn lower_while_match_loop(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    var empty_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer empty_aliases.deinit();
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let cursor_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, cursor_name_node, bs
    );
    let init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_name = try precedence_loop_suffixed_name(cursor_var, "_init");
    let init = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        init_name, init_call, 0, &empty_aliases, bs, &var call_arg_type_cache
    );
    let cursor_type = init.llvm_type;
    let init_string_counter = try compiled_mir_lower_call::count_string_args(&init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, cursor_var, cursor_type
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    // Lower the two prefix lets through the generic per-statement path, threading body_locals so
    // the match scrutinee 'next.kind' and the latch call arguments resolve their struct types.
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_locals = loop_locals;
    var body_string_counter = init_string_counter;
    var body_temp_counter = 0;
    var body_try_counter = 0;
    var prefix_index = 0;
    while prefix_index < 2 {
        let prefix_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", prefix_index, bs
        );
        let let_result = try lower_multi_let_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, prefix_stmt,
            body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
            &var body_stmts, bs, ir_lookup_index, &var call_arg_type_cache
        );
        body_locals = let_result.locals_spec;
        body_string_counter = let_result.string_counter;
        body_temp_counter = let_result.temp_counter;
        body_try_counter = let_result.try_counter;
        prefix_index = prefix_index + 1;
    }
    let match_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 2, bs
    );
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_stmt, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, scrutinee, bs
    );
    let enum_kizu = try resolve_dispatch_enum_kizu_type(
        ir_bytes, function_name, module_prefix, body_locals, scrutinee, scrutinee_kind, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    var scrutinee_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let scrutinee_result_id = try lower_expr_into(
        ir_bytes, function_name, module_prefix, body_locals, scrutinee,
        body_string_counter, body_temp_counter, &var scrutinee_insts, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    let arm_temp_base = body_temp_counter + scrutinee_insts.len();
    let arm_string_base = body_string_counter + try count_strings_in_insts(&scrutinee_insts);
    let arm_ssa_stride = 1000;
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_stmt, "arm", bs
    );
    // Locate the single cursor-latch arm and build its try-call latch (binding %<cursor>_next at
    // the next free try index after the body try-calls).
    var latch_arm_index = 0 - 1;
    var scan_index = 0;
    while scan_index < arm_count {
        let scan_arm = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_stmt, "arm", scan_index, bs
        );
        let scan_body = try while_match_arm_body_or_minus_one(
            ir_bytes, function_name, scan_arm, bs
        );
        if scan_body >= 0 and (try while_match_body_is_cursor_try_latch(
            ir_bytes, function_name, scan_body, cursor_var, bs
        )) {
            latch_arm_index = scan_index;
        }
        scan_index = scan_index + 1;
    }
    if latch_arm_index < 0 {
        return error("compiled mir: while-match loop requires a cursor latch arm");
    }
    let latch_arm_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_stmt, "arm", latch_arm_index, bs
    );
    let latch_body = try while_match_arm_body_or_minus_one(
        ir_bytes, function_name, latch_arm_node, bs
    );
    let latch_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_body, "value", 0, bs
    );
    let latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_value, "value", 0, bs
    );
    let latch = try lower_precedence_loop_try_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
        cursor_var, latch_call, arm_string_base + latch_arm_index * arm_ssa_stride,
        arm_temp_base + latch_arm_index * arm_ssa_stride, body_try_counter, &body_aliases, bs,
        &var call_arg_type_cache
    );
    // Build the arms: the latch arm carries no statements (the shared latch renders it); every
    // other arm lowers its 'return <expr>' off a private SSA window.
    var arms = std::array::Array<compiled_mir::MirWhileMatchArm>(std::mem::page_allocator());
    var arm_index = 0;
    while arm_index < arm_count {
        let arm_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_stmt, "arm", arm_index, bs
        );
        let pattern = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_node, "pattern", 0, bs
        );
        let variant_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, pattern, bs
        );
        let is_default = std::mem::equal_bytes(variant_name, "_");
        var tag = 0 - 1;
        if !is_default {
            tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
                ir_lookup_index, ir_bytes, ir_bytes[0..0], enum_kizu, variant_name
            );
        }
        var arm_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
        if arm_index == latch_arm_index {
            try arms.append(compiled_mir::while_match_arm(tag, is_default, true, arm_stmts));
        } else {
            let body = try while_match_arm_body_or_minus_one(
                ir_bytes, function_name, arm_node, bs
            );
            let arm_temp = arm_temp_base + arm_index * arm_ssa_stride;
            let arm_string = arm_string_base + arm_index * arm_ssa_stride;
            let return_stmt = try lower_multi_return_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body,
                arm_string, arm_temp, &body_aliases, bs, ir_lookup_index,
                &var call_arg_type_cache
            );
            try arm_stmts.append(return_stmt);
            try arms.append(compiled_mir::while_match_arm(tag, is_default, false, arm_stmts));
        }
        arm_index = arm_index + 1;
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::while_match_loop_stmt(
        cursor_var, cursor_type, llvm_return_type, init, body_stmts, scrutinee_insts,
        scrutinee_result_id, arms, latch, "wmloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// guarded_cursor_terminal_if_matches reports whether a body's terminal statement is the if/else
// latch the guarded-cursor loop requires: a plain bool-predicate-call condition, a then arm of
// exactly one '<cursor> = <plain call>(..)' latch Assign, and an else arm whose last statement is a
// Return. The plain-call latch (rather than the value-cursor loop's terminal try-call Assign) and
// the returning else arm (rather than the type-apply / while-match loops' bool-literal headers) keep
// this shape disjoint from those.
fn guarded_cursor_terminal_if_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "If", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, cond_node, bs) {
        return false;
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count != 1 {
        return false;
    }
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    if !(try type_apply_loop_assign_is_plain_call(
        ir_bytes, function_name, latch_stmt, cursor_var, bs
    )) {
        return false;
    }
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, statement, "else", 0, bs
    );
    if else_node < 0 {
        return false;
    }
    let else_count = try while_body_statement_count(ir_bytes, function_name, else_node, bs);
    if else_count < 1 {
        return false;
    }
    let last_else = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, else_node, "statement", else_count - 1, bs
    );
    return try node_kind_is(ir_bytes, function_name, last_else, "Return", bs);
}

// is_guarded_cursor_return_loop_shape reports whether this multi-statement function is the
// guarded-cursor loop (parse_type_params' '<T, U>' walk): zero or more plain prefix lets, a
// plain-call cursor seed, a prefix-not predicate 'while' header, and a trailing return, whose loop
// body ends in the if/else latch guarded_cursor_terminal_if_matches accepts. The prefix-not header
// (giving a normal exit) plus the terminal-if plain-call latch keep it disjoint from the value-cursor
// append loop (an unconditional terminal try-call latch and a bare cursor return), the type-apply /
// while-match loops (a bool-literal 'while true' header) and the i64-induction While (whose body ends
// in an arithmetic increment). lower_guarded_cursor_return_loop re-walks and commits on a true result.
fn is_guarded_cursor_return_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count < 3 {
        return false;
    }
    let while_index = statement_count - 2;
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try value_cursor_cond_is_prefix_not_call(ir_bytes, function_name, cond_node, bs)) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", statement_count - 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    let seed_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index - 1, bs
    );
    if !(try type_apply_loop_let_is_plain_call(ir_bytes, function_name, seed_stmt, bs)) {
        return false;
    }
    let seed_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, seed_name_node, bs
    );
    if std::mem::len(cursor_var) == 0 {
        return false;
    }
    var prefix_index = 0;
    while prefix_index < while_index - 1 {
        let prefix_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", prefix_index, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, prefix_stmt, "Let", bs)) {
            return false;
        }
        prefix_index = prefix_index + 1;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        return false;
    }
    let terminal_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    return try guarded_cursor_terminal_if_matches(
        ir_bytes, function_name, terminal_stmt, cursor_var, bs
    );
}

// lower_guarded_cursor_return_loop lowers the guarded-cursor loop into a head/body/latch/else/exit
// CFG behind a single MirGuardedCursorLoop statement. The pre-cursor lets emit as ordinary top-level
// statements ahead of the loop (so their values stay available to the return arms); the cursor seed
// becomes the plain-call init (%<cursor>_init); the header predicate, body statements, terminal
// condition, plain-call latch, else return arm and trailing exit return all lower through the same
// per-statement machinery the top level uses, with the carried cursor read from the loop-head phi.
// The two return arms take string-index windows 1000 apart so their struct-result SSA names never
// collide. Every type is derived from the IR; no callee, field, or function name is hardcoded.
fn lower_guarded_cursor_return_loop(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var top_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer top_aliases.deinit();
    var locals_spec = params_spec;
    var string_counter = 0;
    var temp_counter = 0;
    var try_counter = 0;

    let while_index = statement_count - 2;
    // Emit the pre-cursor lets (e.g. 'let start = begin_children()') ahead of the loop.
    var prefix_index = 0;
    while prefix_index < while_index - 1 {
        let prefix_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", prefix_index, bs
        );
        let prefix_result = try lower_multi_let_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, prefix_stmt,
            string_counter, temp_counter, try_counter, &var top_aliases, &var stmts, bs,
            ir_lookup_index, &var call_arg_type_cache
        );
        locals_spec = prefix_result.locals_spec;
        string_counter = prefix_result.string_counter;
        temp_counter = prefix_result.temp_counter;
        try_counter = prefix_result.try_counter;
        prefix_index = prefix_index + 1;
    }

    // Cursor seed: lowered as the preheader plain-call init bound to %<cursor>_init.
    let seed_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index - 1, bs
    );
    let seed_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, seed_name_node, bs
    );
    let seed_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "value", 0, bs
    );
    let init_name = try precedence_loop_suffixed_name(cursor_var, "_init");
    let init = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
        init_name, seed_call, string_counter, &top_aliases, bs, &var call_arg_type_cache
    );
    let cursor_type = init.llvm_type;
    string_counter = string_counter +
        try compiled_mir_lower_call::count_string_args(&init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, cursor_var, cursor_type
    );

    // Header predicate: the prefix-not call, read off the loop-head cursor phi.
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_with_local_aliases(
        ir_bytes, function_name, module_prefix, loop_locals, cond_node,
        string_counter, temp_counter, &var cond_insts, &body_aliases, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    string_counter = string_counter + try count_strings_in_insts(&cond_insts);
    temp_counter = temp_counter + cond_insts.len();

    // Body statements before the terminal if.
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_locals = loop_locals;
    var body_index = 0;
    while body_index < body_count - 1 {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                string_counter, temp_counter, try_counter, &var body_aliases, &var body_stmts, bs,
                ir_lookup_index, &var call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            string_counter = let_result.string_counter;
            temp_counter = let_result.temp_counter;
            try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "ExprStmt") {
                let expr_result = try lower_multi_expr_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                    string_counter, temp_counter, try_counter, &body_aliases, &var body_stmts, bs,
                    ir_lookup_index, &var call_arg_type_cache
                );
                string_counter = expr_result.string_counter;
                try_counter = expr_result.try_counter;
            } else {
                return error("compiled mir: unsupported guarded-cursor body statement");
            }
        }
        body_index = body_index + 1;
    }

    // Terminal if: condition, plain-call latch (then arm), and else return arm.
    let terminal_if = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let terminal_cond = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "condition", 0, bs
    );
    var terminal_cond_insts =
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let terminal_cond_result = try lower_expr_with_local_aliases(
        ir_bytes, function_name, module_prefix, body_locals, terminal_cond,
        string_counter, temp_counter, &var terminal_cond_insts, &body_aliases, bs,
        ir_lookup_index, &var call_arg_type_cache
    );
    string_counter = string_counter + try count_strings_in_insts(&terminal_cond_insts);
    temp_counter = temp_counter + terminal_cond_insts.len();

    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "then", 0, bs
    );
    let latch_assign = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_assign, "value", 0, bs
    );
    let latch_name = try precedence_loop_suffixed_name(cursor_var, "_next");
    let latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, ir_bytes, function_name, module_prefix, body_locals,
        latch_name, latch_call, string_counter, &body_aliases, bs, &var call_arg_type_cache
    );
    string_counter = string_counter +
        try compiled_mir_lower_call::count_string_args(&latch.call_args);

    // Else arm: lets followed by a terminal return, reading the body locals.
    let else_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "else", 0, bs
    );
    let else_count = try while_body_statement_count(ir_bytes, function_name, else_node, bs);
    var else_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var else_locals = body_locals;
    var else_aliases = try copy_local_aliases(&body_aliases);
    defer else_aliases.deinit();
    var else_index = 0;
    while else_index < else_count {
        let else_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, else_node, "statement", else_index, bs
        );
        let else_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, else_stmt, bs);
        if std::mem::equal_bytes(else_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, else_locals, else_stmt,
                string_counter, temp_counter, try_counter, &var else_aliases, &var else_stmts, bs,
                ir_lookup_index, &var call_arg_type_cache
            );
            else_locals = let_result.locals_spec;
            string_counter = let_result.string_counter;
            temp_counter = let_result.temp_counter;
            try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(else_kind, "Return") {
                try else_stmts.append(try lower_multi_return_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, else_locals, else_stmt,
                    string_counter, temp_counter, &else_aliases, bs, ir_lookup_index,
                    &var call_arg_type_cache
                ));
            } else {
                return error("compiled mir: unsupported guarded-cursor else statement");
            }
        }
        else_index = else_index + 1;
    }

    // Normal exit: the trailing return reads the loop-head cursor phi (and the pre-cursor lets). It
    // takes a string-index window 1000 past the else arm so the two struct-result returns never
    // collide on '%v<index>_*' names.
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", statement_count - 1, bs
    );
    var exit_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try exit_stmts.append(try lower_multi_return_statement(
        ir_bytes, function_name, module_prefix, llvm_return_type, loop_locals, return_stmt,
        string_counter + 1000, temp_counter + 1000, &top_aliases, bs, ir_lookup_index,
        &var call_arg_type_cache
    ));

    try stmts.append(compiled_mir::guarded_cursor_loop_stmt(
        cursor_var, cursor_type, llvm_return_type, init, cond_insts, cond_result, body_stmts,
        terminal_cond_insts, terminal_cond_result, latch, else_stmts, exit_stmts, "gcloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// value_cursor_previous_init_name_or_empty generalizes the value-cursor preheader-seed lookup to
// admit a plain Var-copy init in addition to a preceding call. The statement before the while binds
// the cursor either by 'let <cursor> = <Call>' (the parse_block_with_statements 'next_token' seed) or
// by 'var <cursor> = <Var>' (parse_program_with_declarations' 'var token = first', a copy of a
// parameter). Both are elided from emission by the induction-init scan when the loop's field-read
// latch carries the same name, so the cursor is carried purely by the loop-head phi; returning the
// bound name lets the embedded detector/lowerer recognize the cursor for either seed kind.
fn value_cursor_previous_init_name_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_index: i64,
    bs: i64
) -> ![]u8 {
    if stmt_index == 0 {
        return ir_bytes[0..0];
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", stmt_index - 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return ir_bytes[0..0];
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, init_value, bs
    );
    if !std::mem::equal_bytes(init_value_kind, "Call") and
        !std::mem::equal_bytes(init_value_kind, "Var") {
        return ir_bytes[0..0];
    }
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
}

// value_cursor_previous_copy_source_or_empty returns the source variable a Var-copy cursor init
// ('var <cursor> = <source>') copies from, or empty when the preceding init is a call seed. The
// embedded lowerer seeds the loop-head phi from %<source> on the entry edge (the copy itself is
// elided by the induction-init scan, so %<cursor> is never materialized before the loop), matching
// how the whole-function value-cursor lowerer threads its 'var close = first' copy seed.
fn value_cursor_previous_copy_source_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_index: i64,
    bs: i64
) -> ![]u8 {
    if stmt_index == 0 {
        return ir_bytes[0..0];
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", stmt_index - 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return ir_bytes[0..0];
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_value, "Var", bs)) {
        return ir_bytes[0..0];
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, init_value, bs);
}

// value_cursor_previous_call_node_or_minus_one returns the Call value node of a plain-call cursor
// init ('var <cursor> = next_token(text, token)') preceding the embedded value-cursor while, or -1
// when the preceding init is absent or a Var-copy seed. The embedded lowerer materializes this call
// in the loop preheader as %<cursor>_init and seeds the loop-head phi from it, replacing the
// degenerate self-referential phi seed that an elided call init would otherwise leave behind.
fn value_cursor_previous_call_node_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_index: i64,
    bs: i64
) -> !i64 {
    if stmt_index == 0 {
        return -1;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", stmt_index - 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return -1;
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_value, "Call", bs)) {
        return -1;
    }
    return init_value;
}

// value_cursor_pre_latch_is_guard_scan reports whether every body statement before the value-cursor
// latch is a guard 'if' (a sentinel early-exit such as 'if is_eof_token(current) { return error(..) }').
// A scan loop advances its cursor to a sentinel without accumulating into an array or a sink call, so
// it carries no append / void-call accumulation step; the predicate-call header, cursor seed, and
// value-cursor latch already pin it as a value-cursor loop, and the guard ifs lower through the same
// generic body-statement path the accumulation loops use (parse_skipped_top_level_block's brace scan).
fn value_cursor_pre_latch_is_guard_scan(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_count: i64,
    bs: i64
) -> !bool {
    if body_count < 2 {
        return false;
    }
    var body_index = 0;
    while body_index < body_count - 1 {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, body_stmt, "If", bs)) {
            return false;
        }
        body_index = body_index + 1;
    }
    return true;
}
fn is_embedded_value_cursor_append_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_index: i64,
    while_statement: i64,
    bs: i64
) -> !bool {
    let cursor_var = try value_cursor_previous_init_name_or_empty(
        ir_bytes, function_name, stmt_index, bs
    );
    if std::mem::len(cursor_var) == 0 {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    // The header is either the prefix-not bool-predicate call ('while !is_at_end(token)') or a bare
    // bool-predicate call ('while is_double_colon(token)', parse_import_segments); both carry the
    // cursor and lower through the generic condition path.
    if !(try value_cursor_cond_is_prefix_not_call(ir_bytes, function_name, cond_node, bs)) and
        !(try value_cursor_cond_is_plain_call(ir_bytes, function_name, cond_node, bs)) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return false;
    }
    if !(try value_cursor_latch_is_supported(
        ir_bytes, function_name, body_node, body_count - 1, cursor_var, bs
    )) {
        return false;
    }
    // The accumulation step is either a 'try <arr>.append(x)' array push or a non-array
    // 'try <free-fn>(.. <body-local> ..)' void try-call that consumes a prior body-local
    // (parse_import_segments: 'try add_name_child(ast, segment)'). Either marks this as the
    // value-cursor loop rather than a generic While; the latch already pinned the carried cursor.
    var body_index = 0;
    while body_index < body_count - 1 {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if try value_cursor_statement_is_array_append(ir_bytes, function_name, body_stmt, bs) {
            return true;
        }
        if try value_cursor_statement_is_local_void_call(
            ir_bytes, function_name, body_node, body_index, bs
        ) {
            return true;
        }
        body_index = body_index + 1;
    }
    // No append / void-call accumulation: a sentinel scan loop whose pre-latch body is only guard
    // ifs is still a value-cursor loop (parse_skipped_top_level_block scans tokens to the opening
    // brace, advancing the cursor with no accumulation), so accept it through the guard-scan path.
    return try value_cursor_pre_latch_is_guard_scan(
        ir_bytes, function_name, body_node, body_count, bs
    );
}

fn lower_embedded_value_cursor_append_loop(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    while_statement: i64,
    stmt_index: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let cursor_var = try value_cursor_previous_init_name_or_empty(
        ir_bytes, function_name, stmt_index, bs
    );
    // A Var-copy init ('var token = first') is elided by the induction-init scan, so the loop-head
    // phi seeds from the copy's source (%first) on the entry edge -- %<cursor> is never materialized
    // before the loop. A plain-call init ('var current = next_token(text, token)') is also elided,
    // but its copied value has no prior SSA name, so it is materialized in the loop preheader as
    // %<cursor>_init and the phi seeds from that concrete value, replacing the degenerate %<cursor>
    // self-reference on the entry edge (an undef cursor cycle the optimizer's GVN can crash on).
    let copy_source = try value_cursor_previous_copy_source_or_empty(
        ir_bytes, function_name, stmt_index, bs
    );
    var seed_name = cursor_var;
    var seed_string_base = string_counter;
    var init_call_module_prefix = ir_bytes[0..0];
    var init_call_callee_name = ir_bytes[0..0];
    var init_call_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    if std::mem::len(copy_source) > 0 {
        seed_name = copy_source;
    } else {
        let init_call_node = try value_cursor_previous_call_node_or_minus_one(
            ir_bytes, function_name, stmt_index, bs
        );
        if init_call_node >= 0 {
            seed_name = try precedence_loop_suffixed_name(cursor_var, "_init");
            init_call_module_prefix = try compiled_mir_types::lower_call_module_prefix(
                ir_bytes, function_name, module_prefix, init_call_node, bs
            );
            init_call_callee_name = try compiled_mir_types::lower_call_callee_name(
                ir_bytes, function_name, module_prefix, init_call_node, bs
            );
            let init_args = try compiled_mir_lower_call::lower_call_args_cached(
                ir_bytes, function_name, module_prefix, locals_spec, init_call_node,
                string_counter, bs, ir_lookup_index, call_arg_type_cache
            );
            seed_string_base = string_counter +
                try compiled_mir_lower_call::count_string_args(&init_args);
            init_call_args = init_args;
        }
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, locals_spec, cond_node,
        seed_string_base, temp_counter, &var cond_insts, bs, ir_lookup_index, call_arg_type_cache
    );
    var body_string_counter = seed_string_base + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = temp_counter + cond_insts.len();
    var body_try_counter = try_counter;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let body_boundary = body_count - 1;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_alias_counter = 0;
    // Body-local lets ('let statement = try parse_statement(...)') must be tracked so later body
    // statements and the loop latch resolve their struct types; the outer locals_spec lacks them.
    // Threading body_locals keeps 'statement.next' resolvable instead of mis-resolving the receiver
    // to NodeId (issue 1157 NEW-1 field-read latch).
    var body_locals = locals_spec;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
                &var body_stmts, bs, ir_lookup_index, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                // Embedded loops can sit after top-level if statements, whose rendered labels are
                // numbered by their own statement index. Encode the body-if index as
                // stmt_index * 1000 + body_index + 1 (mirroring the i64-induction While body-if
                // encoding) so a body 'if' never reuses a preceding top-level if's ifN_then /
                // ifN_cont labels. stmt_index >= 1 for an embedded loop (it follows its cursor
                // init), so the encoded index clears the top-level statement-index range.
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                    body_string_counter, body_temp_counter, body_try_counter, body_alias_counter,
                    stmt_index * 1000 + body_index + 1, &var body_aliases, &var body_stmts, bs,
                    ir_lookup_index, call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
                        body_stmt, body_string_counter, body_temp_counter, body_try_counter,
                        &body_aliases,
                        &var body_stmts, bs, ir_lookup_index, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported embedded append-while body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let latch_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_stmt, "value", 0, bs
    );
    let latch_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, latch_value, bs
    );
    var cursor_type = "";
    var result_string_counter = body_string_counter;
    var result_temp_counter = body_temp_counter;
    var result_try_counter = body_try_counter;
    var latch = compiled_mir::value_cursor_field_read_latch(
        cursor_var,
        body_string_counter,
        0,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator())
    );
    if std::mem::equal_bytes(latch_value_kind, "TryExpr") {
        let latch_call = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, latch_value, "value", 0, bs
        );
        let latch_called_error_union = try compiled_mir_types::lower_call_return_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, latch_call, bs
        );
        cursor_type = try try_call_success_type(
            ir_bytes, function_name, module_prefix, latch_call, bs, ir_lookup_index
        );
        let latch_callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, latch_call, bs
        );
        let latch_callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, latch_call, bs
        );
        let latch_args = try compiled_mir_lower_call::lower_call_args_cached(
            ir_bytes, function_name, module_prefix, body_locals, latch_call, body_string_counter, bs,
            ir_lookup_index, call_arg_type_cache
        );
        let latch_arg_strings = try compiled_mir_lower_call::count_string_args(&latch_args);
        latch = compiled_mir::value_cursor_try_call_latch(
            cursor_var,
            latch_called_error_union,
            cursor_type,
            llvm_return_type,
            latch_callee_module_prefix,
            latch_callee_name,
            body_string_counter,
            body_try_counter,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            latch_args
        );
        result_string_counter = body_string_counter + latch_arg_strings;
        result_try_counter = body_try_counter + 1;
    } else {
        if std::mem::equal_bytes(latch_value_kind, "FieldExpr") {
            let receiver = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, latch_value, "receiver", 0, bs
            );
            let receiver_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, receiver, bs
            );
            if !std::mem::equal_bytes(receiver_kind, "Var") {
                return error("compiled mir: value-cursor field latch receiver must be a local var");
            }
            let receiver_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, receiver, bs
            );
            // Read the receiver through its current local-alias name, not its source spelling. When
            // the body reassigns the receiver inside an if/else (parse_impl_decl: 'method' is
            // reseated in both arms), the body-if lowering merges the branch values into a
            // %void.then.alias.N load and rebinds 'method' to that alias. The latch must extract its
            // field from that merged value; using the source name would read the receiver's loop-top
            // let-init instead, so the carried cursor would never advance and the loop would spin
            // forever. An un-reassigned receiver has no alias, so this resolves back to its source
            // name and the single-binding (e.g. 'let statement = ...') latch is unchanged.
            let receiver_alias = try local_alias_current_name(&body_aliases, receiver_name);
            let info = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
                ir_lookup_index,
                ir_bytes, function_name, module_prefix, body_locals, latch_value, bs,
                call_arg_type_cache
            );
            cursor_type = info.field_llvm_type;
            var latch_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            try latch_insts.append(compiled_mir::field_access_expr_inst(
                0, cursor_type, receiver_alias, info.receiver_llvm_type, info.field_index
            ));
            latch = compiled_mir::value_cursor_field_read_latch(
                cursor_var, body_string_counter, 0, latch_insts
            );
        } else {
            if std::mem::equal_bytes(latch_value_kind, "Call") {
                // A plain-call latch ('token = next_token(text, segment)') reassigns the cursor
                // through a non-try free call: the return type is its success type directly (no
                // error union), the args lower through the same cached path as the try-call latch,
                // and the renderer binds %<cursor>_next in the latch block (no try fail/cont split).
                cursor_type = try compiled_mir_types::lower_call_return_type_indexed(
                    ir_lookup_index,
                    ir_bytes, function_name, module_prefix, latch_value, bs
                );
                let latch_callee_name = try compiled_mir_types::lower_call_callee_name(
                    ir_bytes, function_name, module_prefix, latch_value, bs
                );
                let latch_callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
                    ir_bytes, function_name, module_prefix, latch_value, bs
                );
                let latch_args = try compiled_mir_lower_call::lower_call_args_cached(
                    ir_bytes, function_name, module_prefix, body_locals, latch_value,
                    body_string_counter, bs, ir_lookup_index, call_arg_type_cache
                );
                let latch_arg_strings = try compiled_mir_lower_call::count_string_args(&latch_args);
                latch = compiled_mir::value_cursor_plain_call_latch(
                    cursor_var,
                    cursor_type,
                    body_string_counter,
                    latch_callee_module_prefix,
                    latch_callee_name,
                    latch_args
                );
                result_string_counter = body_string_counter + latch_arg_strings;
            } else {
                return error("compiled mir: unsupported embedded value-cursor latch");
            }
        }
    }
    try stmts.append(compiled_mir::value_cursor_while_stmt_with_init(
        cursor_var, cursor_type, seed_name, llvm_return_type, cond_insts, cond_result,
        body_stmts, latch, "vcw", false,
        init_call_module_prefix, init_call_callee_name, init_call_args
    ));
    return MultiLowerResult {
        locals_spec: locals_spec,
        string_counter: result_string_counter,
        temp_counter: result_temp_counter,
        try_counter: result_try_counter
    };
}

// emit_pending_defers lowers each recorded top-level 'defer <receiver>.deinit();' body and appends
// its side-effect-only MIR statement to the running statement list, in LIFO order (last defer
// registered runs first). Each body re-uses the validated owned-deinit expression path, so the
// receiver type and %kizu.owned representation are re-checked at every emission site. The defer body
// is a non-try '<receiver>.deinit()' call, which consumes no string/try counters, so the threaded
// counters are passed through unchanged. This is called immediately before each top-level Return so
// the cleanup precedes the produced return value.
fn emit_pending_defers(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    pending_defers: &std::array::Array<i64>,
    string_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !void {
    var defer_index = pending_defers.len();
    while defer_index > 0 {
        defer_index = defer_index - 1;
        let defer_body = try pending_defers.get(defer_index);
        let emitted = try lower_owned_deinit_expr_statement(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            defer_body,
            string_counter,
            try_counter,
            aliases,
            stmts,
            bs
        );
        // The owned-deinit path returns the counters unchanged; bind to acknowledge the result.
        if emitted.try_counter != try_counter {
            return error("compiled mir: defer deinit unexpectedly consumed a try slot");
        }
    }
    return;
}

pub fn lower_multi_statement_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    if statement_count < 2 {
        return error("compiled mir: multi-statement function requires multiple statements");
    }
    // The specialized loop/parser shapes below are compact structural forms. Huge dispatcher
    // functions such as code_render.tape_record_end and render_one_instruction are ordinary
    // top-level if chains; probing every shape against them turns into repeated full body-fact
    // scans before the generic path. Gate the probes by statement count so large dispatchers go
    // straight to the generic multi-statement lowerer.
    if statement_count <= 24 {
        let is_parser_component = compiled_mir_lower_is_parser_component(function_name);
        // A value-carried array-append loop (struct value threaded through a phi, appended into a
        // runtime array until a sentinel tag) lowers through the generic ArrayNew + ValueWhile path
        // rather than the i64-induction While machinery (issue 1165).
        if try is_value_array_loop_shape(ir_bytes, function_name, statement_count, bs) {
            return try lower_value_array_loop(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, statement_count, bs,
                ir_lookup_index
            );
        }
        if is_parser_component {
            // A value-carried 'while true' grammar loop (the parse_postfix_expr shape: a struct
            // value threaded through a loop-head phi, reassigned through a free try-call in each
            // guarded arm, and returned from the terminal else) lowers through the GrammarLoop CFG.
            if try is_grammar_postfix_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_grammar_postfix_loop(
                    ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
                );
            }
            // A type-apply parser loop also uses a bool-literal 'while true' header, but its carried
            // value is a Token cursor seeded and latched by plain calls.
            if try is_type_apply_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_type_apply_loop(
                    ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
                );
            }
            // A 'while true' + match-dispatch loop (parse_generic_type_end's generic-argument walk)
            // uses a plain-call Token seed and a bool-literal header.
            if try is_while_match_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_while_match_loop(
                    ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
                );
            }
            // A precedence-climbing expression loop carries both a ParseNode-like value and an i64
            // precedence through phis.
            if try is_precedence_loop_shape(ir_bytes, function_name, params_spec, statement_count, bs) {
                return try lower_precedence_loop(
                    ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
                );
            }
            // A copy-seeded two-carried-value cursor loop threads a value cursor and scalar cursor
            // through loop-head phis.
            if try is_dual_cursor_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_dual_cursor_loop(
                    ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
                );
            }
            // A dual Token-cursor advance loop threads previous/current Token cursors and consumes
            // the previous token after the loop.
            if try is_trailing_token_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_trailing_token_loop(
                    ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    statement_count, bs
                );
            }
            // A value-carried append-while loop threads a value cursor through a loop-head phi and a
            // free-try-call latch.
            if try is_value_cursor_append_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_value_cursor_append_loop(
                    ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, bs
                );
            }
            // A guarded-cursor loop threads a plain-call Token cursor through a prefix-not predicate
            // header and conditional latch.
            if try is_guarded_cursor_return_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_guarded_cursor_return_loop(
                    ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    statement_count, bs
                );
            }
        }
    }
    let is_parser_component = compiled_mir_lower_is_parser_component(function_name);
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var locals_spec = params_spec;
    var string_counter = 0;
    var temp_counter = 0;
    var try_counter = 0;
    var alias_counter = 0;
    var aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer aliases.deinit();
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    // Build the per-function body-node position index once (pillar A): every per-node structural lookup
    // below resolves its node->line offset through fn_node_line_start in O(1) instead of the global
    // index binary search. Byte-identical (same offsets); only the lookup cost changes.
    try compiled_mir_types::build_fn_node_index(
        &var call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    let has_top_level_while = try top_level_has_statement_kind(
        ir_bytes, function_name, statement_count, "While", bs, &call_arg_type_cache
    );
    // Top-level 'defer <receiver>.deinit();' statements register a cleanup that must run on every
    // exit path reached after the defer. We collect each defer body's inner expression node here and
    // re-lower it (via the owned-deinit expression path) immediately before each top-level Return,
    // in LIFO order, rather than emitting it in-place (issue 1157 parse_impl_decl Defer blocker).
    var pending_defers = std::array::Array<i64>(std::mem::page_allocator());
    defer pending_defers.deinit();
    var stmt_index = 0;
    // The root block's 'statement' edges interleave with each statement's subtree in the fact
    // stream, so rescanning from bs to find the stmt_index-th edge is O(function) per statement
    // (quadratic overall). stmt_scan_from advances to the current statement's body-node line
    // each turn: the next statement's edge sorts after this statement's whole subtree, which
    // begins at that line, so the walk stays byte-identical while the loop becomes O(function).
    var stmt_scan_from = bs;
    while stmt_index < statement_count {
        let statement = try compiled_mir_types::fn_body_child_sequence_from(
            &call_arg_type_cache,
            ir_bytes, function_name, 0, "statement", stmt_index, stmt_scan_from
        );
        // sf is this statement's body-node line via the per-function index (pillar A, O(1)); its own
        // structural facts (its kind here) sort at-or-after it, so a scan from sf is byte-identical
        // to one from bs.
        let sf = compiled_mir_types::fn_node_line_start(&call_arg_type_cache, statement, bs);
        stmt_scan_from = sf;
        let stmt_kind = try compiled_mir_types::fn_node_kind(
            &call_arg_type_cache, ir_bytes, function_name, statement, sf
        );
        if std::mem::equal_bytes(stmt_kind, "Let") {
            // A 'var counter = <int>' that a later while increments is the loop
            // induction initializer: it is not emitted as a let because the loop-head
            // phi supplies the initial value on the preheader edge, so emitting it
            // would redefine the induction SSA name (tracker 961).
            var is_induction_init = false;
            if has_top_level_while {
                is_induction_init = try statement_is_induction_init(
                    ir_bytes, function_name, statement, statement_count, bs
                );
            }
            if is_induction_init {
                if try induction_init_needs_prewhile_alias(
                    ir_bytes, function_name, statement, stmt_index, statement_count, bs
                ) {
                    let init_alias = try lower_induction_init_alias(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        statement,
                        string_counter,
                        temp_counter,
                        alias_counter,
                        &var aliases,
                        &var stmts,
                        bs,
                        ir_lookup_index,
                        &var call_arg_type_cache
                    );
                    string_counter = init_alias.string_counter;
                    temp_counter = init_alias.temp_counter;
                    alias_counter = init_alias.alias_counter;
                }
                stmt_index = stmt_index + 1;
                continue;
            }
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                statement,
                string_counter,
                temp_counter,
                try_counter,
                &var aliases,
                &var stmts,
                bs,
                ir_lookup_index,
                &var call_arg_type_cache
            );
            locals_spec = let_result.locals_spec;
            string_counter = let_result.string_counter;
            temp_counter = let_result.temp_counter;
            try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(stmt_kind, "Defer") {
                // The defer body is the single 'expr' child of the Defer node (a '<receiver>.deinit()'
                // call). Record it for emission at each subsequent top-level exit; emit nothing here.
                let defer_body = try compiled_mir_types::fn_body_child_sequence_from(
                    &call_arg_type_cache,
                    ir_bytes, function_name, statement, "expr", 0, bs
                );
                try pending_defers.append(defer_body);
            } else {
            if std::mem::equal_bytes(stmt_kind, "While") {
                if is_parser_component and try is_embedded_value_cursor_append_loop_shape(
                    ir_bytes, function_name, stmt_index, statement, bs
                ) {
                    let cursor_result = try lower_embedded_value_cursor_append_loop(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        statement,
                        stmt_index,
                        string_counter,
                        temp_counter,
                        try_counter,
                        &var stmts,
                        bs,
                        ir_lookup_index,
                        &var call_arg_type_cache
                    );
                    string_counter = cursor_result.string_counter;
                    temp_counter = cursor_result.temp_counter;
                    try_counter = cursor_result.try_counter;
                } else {
                    let while_result = try lower_multi_while_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        statement,
                        string_counter,
                        temp_counter,
                        alias_counter,
                        stmt_index,
                        &var aliases,
                        &var stmts,
                        bs,
                        ir_lookup_index,
                        &var call_arg_type_cache
                    );
                    temp_counter = while_result.temp_counter;
                    string_counter = while_result.string_counter;
                    alias_counter = while_result.alias_counter;
                }
            } else {
            if std::mem::equal_bytes(stmt_kind, "Return") {
                // Cleanups registered by earlier top-level 'defer' statements run on this exit, in
                // LIFO order, before the return value is produced.
                try emit_pending_defers(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    &pending_defers,
                    string_counter,
                    try_counter,
                    &aliases,
                    &var stmts,
                    bs
                );
                try stmts.append(try lower_multi_return_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    statement,
                    string_counter,
                    temp_counter,
                    &aliases,
                    bs,
                    ir_lookup_index,
                    &var call_arg_type_cache
                ));
            } else {
                if std::mem::equal_bytes(stmt_kind, "If") {
                    let if_result = try lower_multi_if_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        statement,
                        string_counter,
                        temp_counter,
                        try_counter,
                        alias_counter,
                        stmt_index,
                        &var aliases,
                        &var stmts,
                        bs,
                        ir_lookup_index,
                        &var call_arg_type_cache
                    );
                    temp_counter = if_result.temp_counter;
                    string_counter = if_result.string_counter;
                    try_counter = if_result.try_counter;
                    alias_counter = if_result.alias_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                        let expr_result = try lower_multi_expr_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            statement,
                            string_counter,
                            temp_counter,
                            try_counter,
                            &aliases,
                            &var stmts,
                            bs,
                            ir_lookup_index,
                            &var call_arg_type_cache
                        );
                        string_counter = expr_result.string_counter;
                        try_counter = expr_result.try_counter;
                    } else {
                    if std::mem::equal_bytes(stmt_kind, "Match") {
                        // A non-bool enum-dispatch match statement ('match <scrutinee> { Variant
                        // => return <expr>, _ => return <expr> }') lowers to a branch-control-flow
                        // EnumDispatch stmt: the scrutinee becomes an i64 discriminant and each
                        // arm body reuses the shared return lowering (issue 1157 PR-PH / B3). Every
                        // arm returns, so the dispatch is terminal -- like a Return, it threads no
                        // updated counters back into the loop.
                        try stmts.append(try lower_multi_match_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            statement,
                            string_counter,
                            temp_counter,
                            &var aliases,
                            bs,
                            ir_lookup_index,
                            &var call_arg_type_cache
                        ));
                    } else {
                    if std::mem::equal_bytes(stmt_kind, "Assign") {
                        // A top-level '<local> = try <free-call>(args);' reassignment threads the
                        // call's success value into an existing local. It reuses the LetTryCall
                        // error-union branch/propagate path bound to a fresh alias name, then
                        // redirects later reads of the target through that alias (the same
                        // local-alias indirection the void-then-body reassignment uses), since the
                        // SSA name already exists and cannot be redefined.
                        let assign_result = try lower_multi_assign_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            statement,
                            string_counter,
                            temp_counter,
                            try_counter,
                            alias_counter,
                            &var aliases,
                            &var stmts,
                            bs,
                            ir_lookup_index,
                            &var call_arg_type_cache
                        );
                        locals_spec = assign_result.locals_spec;
                        string_counter = assign_result.string_counter;
                        temp_counter = assign_result.temp_counter;
                        try_counter = assign_result.try_counter;
                        alias_counter = assign_result.alias_counter;
                    } else {
                        return error("compiled mir: unsupported statement kind");
                    }
                    }
                    }
                }
            }
            }
            }
        }
        stmt_index = stmt_index + 1;
    }
    return compiled_mir_function::multi_statement_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        stmts
    );
}

fn compiled_mir_lower_is_parser_component(function_name: []u8) -> bool {
    return std::mem::starts_with(function_name, "std::kizu::parser::");
}

pub fn lower_single_match_statement_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer aliases.deinit();
    var call_arg_type_cache = compiled_mir_types::call_arg_type_cache();
    defer call_arg_type_cache.deinit();
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(try lower_multi_match_statement(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        statement,
        0,
        0,
        &var aliases,
        bs,
        ir_lookup_index,
        &var call_arg_type_cache
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        stmts
    );
}

fn top_level_has_statement_kind(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    kind: []u8,
    bs: i64,
    call_arg_type_cache: &compiled_mir_types::CallArgTypeCache
) -> !bool {
    var stmt_index = 0;
    var stmt_scan_from = bs;
    while stmt_index < statement_count {
        let statement = try compiled_mir_types::fn_body_child_sequence_from(
            call_arg_type_cache,
            ir_bytes, function_name, 0, "statement", stmt_index, stmt_scan_from
        );
        let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
        stmt_scan_from = sf;
        let stmt_kind = try compiled_mir_types::fn_node_kind(
            call_arg_type_cache, ir_bytes, function_name, statement, sf
        );
        if std::mem::equal_bytes(stmt_kind, kind) {
            return true;
        }
        stmt_index = stmt_index + 1;
    }
    return false;
}
