// lower_run_ast_function_function lowers selfhost::ir::codegen::lower_run_ast_function into a
// single LowerRunAstFunction statement: it requires the function name to be "main", binds the body
// AstNode via Ast.get, and forwards lower_run_ast_block's !RunAst result on the Block variant
// (tracker 961, scope 4 prerequisite). The Block discriminant tag comes from the union-variant
// facts; the "main" literal global is named from the function's llvm_symbol.
pub fn lower_run_ast_function_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let text_name = try nth_param_field(params_spec, 0, true);
    let ast_type = try nth_param_field(params_spec, 1, false);
    let ast_name = try nth_param_field(params_spec, 1, true);
    let declarations_type = try nth_param_field(params_spec, 2, false);
    let declarations_name = try nth_param_field(params_spec, 2, true);
    let name_type = try nth_param_field(params_spec, 3, false);
    let name_name = try nth_param_field(params_spec, 3, true);
    let body_type = try nth_param_field(params_spec, 4, false);
    let body_name = try nth_param_field(params_spec, 4, true);
    let block_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "Block"
    );
    if !block_variant.found {
        return error("compiled mir: lower_run_ast_function Block variant not found");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::lower_run_ast_function_stmt(
        text_name, ast_name, ast_type, declarations_name, declarations_type,
        name_name, name_type, body_name, body_type, llvm_symbol, block_variant.tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_run_ast_declarations_function lowers selfhost::ir::codegen::lower_run_ast_declarations into
// a single LowerRunAstDeclarations statement: it scans the program declarations for the first
// FnDecl whose lower_run_ast_function produces a supported RunAst (tracker 961, scope 4
// prerequisite). The FnDecl discriminant tag comes from the union-variant facts.
pub fn lower_run_ast_declarations_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let text_name = try nth_param_field(params_spec, 0, true);
    let ast_type = try nth_param_field(params_spec, 1, false);
    let ast_name = try nth_param_field(params_spec, 1, true);
    let declarations_type = try nth_param_field(params_spec, 2, false);
    let declarations_name = try nth_param_field(params_spec, 2, true);
    let fn_decl_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "FnDecl"
    );
    if !fn_decl_variant.found {
        return error("compiled mir: lower_run_ast_declarations FnDecl variant not found");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::lower_run_ast_declarations_stmt(
        text_name, ast_name, ast_type, declarations_name, declarations_type, fn_decl_variant.tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_run_ast_function_root lowers selfhost::ir::codegen::lower_run_ast into a single LowerRunAst
// statement: the run-codegen AST traversal root that binds the root AstNode via Ast.get and
// forwards lower_run_ast_declarations' !RunAst result on the Program variant (tracker 961, scope 4
// prerequisite). The Program discriminant tag comes from the union-variant facts.
pub fn lower_run_ast_function_root(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let text_name = try nth_param_field(params_spec, 0, true);
    let ast_type = try nth_param_field(params_spec, 1, false);
    let ast_name = try nth_param_field(params_spec, 1, true);
    let root_type = try nth_param_field(params_spec, 2, false);
    let root_name = try nth_param_field(params_spec, 2, true);
    let program_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "Program"
    );
    if !program_variant.found {
        return error("compiled mir: lower_run_ast Program variant not found");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::lower_run_ast_stmt(
        text_name, ast_name, ast_type, root_name, root_type, program_variant.tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// return_value_is_literal_plus_try reports whether a single-return value is the shape
// '<int literal> + try <call>' (count_one / count_with_range, tracker 961).
pub fn return_value_is_literal_plus_try(
    ir_bytes: []u8,
    function_name: []u8,
    value: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left, bs);
    if !std::mem::equal_bytes(left_kind, "Int") {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right, bs);
    return std::mem::equal_bytes(right_kind, "TryExpr");
}

// lower_return_try_binary_function lowers 'return <int> + try <callee>(<args>);' into a
// single ReturnTryBinary statement (count_one / count_with_range, tracker 961).
pub fn lower_return_try_binary_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, left, bs);
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let inner_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, right, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner_call, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: return-try binary must wrap a call");
    }
    let called_error_union = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, inner_call, bs
    );
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, inner_call, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, inner_call, bs
    );
    let args = try compiled_mir_lower_call::lower_call_args(
        ir_bytes, function_name, module_prefix, params_spec, inner_call, 0, bs
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::return_try_binary_stmt(
        literal, called_error_union, llvm_return_type,
        callee_module_prefix, callee_name, 0, 0, args
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// match_union_arm_expr unwraps a match arm body to its value expression: the parser wraps
// a bare expression arm body in an ExprStmt, so the field chain / integer literal lives at
// the ExprStmt 'expr' child (tracker 961).
fn match_union_arm_expr(
    ir_bytes: []u8,
    function_name: []u8,
    arm_body: i64,
    bs: i64
) -> !i64 {
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arm_body, bs);
    if std::mem::equal_bytes(body_kind, "ExprStmt") {
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_body, "expr", 0, bs
        );
    }
    return arm_body;
}

// lower_array_len_method_return lowers a single 'return self.<field>.len();' where
// <field> is a std::array::Array<T> field of a struct value parameter. It is the
// first AST read-only accessor compiled into stage2 (std::kizu::ast::Ast.len): it
// lands the Ast struct value as a parameter, lowers the self.children field access
// as an extractvalue, and lowers Array.len() to the array_len builtin runtime call
// (@kizu_array_len). It deliberately does NOT touch the AstNode/AstData union,
// Arena.get, array_get, or error-union return; those remain blocked in tracker 961.
pub fn lower_array_len_method_return(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    // The callee FieldExpr names the method (len) and carries the array field
    // expression (self.children) as its receiver.
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "len") {
        return error("compiled mir: only Array.len method accessor is supported");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 0 {
        return error("compiled mir: Array.len accessor takes no arguments");
    }
    // The method receiver is the array field expression self.children.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, bs
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.len receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    // The field expression's receiver must be a plain struct value parameter (self).
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, bs
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.len field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(params_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type(
        ir_bytes, module_prefix, var_name, params_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix(
        ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.len receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.len receiver field is not a std::array::Array");
    }
    // Array<T> lowers to the %kizu.owned heap handle (the same { ptr } container the
    // selfhost runtime uses), and Array.len() lowers to the array_len builtin runtime
    // call @kizu_rt_array_len(%kizu.owned) returning i64. The only argument is the
    // array field extracted out of the struct value parameter.
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::field_access_call_arg(
        "%kizu.owned", receiver_llvm_type, var_name, field.index
    ));
    return compiled_mir_function::single_call_return_function(
        llvm_symbol,
        "i64",
        params_spec,
        "",
        "kizu_rt_array_len",
        args
    );
}
// lower_array_get_method_return lowers a single 'return self.<field>.get(index);'
// where <field> is a std::array::Array<T> field of a struct value parameter and
// index is an i64 parameter. It is the first checked Array<T>.get accessor compiled
// into stage2 (std::kizu::diagnostic::Diagnostic.related_get, tracker 961): it reads
// the Array field off the struct value parameter, calls the checked
// @kizu_rt_array_at runtime helper, and on success loads the element value out of
// the borrowed view and wraps it as the error-union success value; on failure it
// forwards the runtime message as the error-union failure value. The error branch
// is a real failure return, never 'unreachable'.
pub fn lower_array_get_method_return(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    // The single argument is the i64 index parameter.
    let index_arg = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    let index_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, index_arg, bs
    );
    if !std::mem::equal_bytes(index_kind, "Var") {
        return error("compiled mir: Array.get index must be a parameter");
    }
    let index_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_arg, bs
    );
    // The method receiver is the array field expression self.<field>.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, bs
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.get receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, bs
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.get field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(params_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type(
        ir_bytes, module_prefix, var_name, params_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix(
        ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.get receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.get receiver field is not a std::array::Array");
    }
    // The element type backs the by-value load out of the borrowed view. It is
    // looked up by its own fully-qualified name (empty module prefix) so the lookup
    // is independent of which module the accessor lives in.
    let element_kizu_type = try array_element_kizu_type(field.field_type);
    let element_llvm_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix(
        ir_bytes, "", element_kizu_type
    );
    return compiled_mir_function::single_array_get_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        receiver_llvm_type,
        var_name,
        field.index,
        index_name,
        element_llvm_type
    );
}
pub fn lower_struct_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let fields = try compiled_mir_lower_struct::lower_struct_fields(
        ir_bytes, function_name, module_prefix, params_spec, value_node, bs
    );
    return compiled_mir_function::single_struct_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        fields
    );
}
pub fn lower_expr_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        value_node,
        0,
        0,
        &var insts,
        bs
    );
    return compiled_mir_function::single_expr_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        result_id,
        insts
    );
}

pub fn return_value_is_short_circuit_or(
    ir_bytes: []u8,
    function_name: []u8,
    value_node: i64,
    bs: i64
) -> !bool {
    return (try short_circuit_kind(ir_bytes, function_name, value_node, bs)) == 2;
}

pub fn lower_short_circuit_or_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    let prefix_result = try lower_short_circuit_or_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        value_node,
        0,
        0,
        0,
        &var stmts,
        bs
    );
    var final_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let final_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        prefix_result.final_node,
        prefix_result.string_counter,
        prefix_result.temp_counter,
        &var final_insts,
        bs
    );
    try stmts.append(compiled_mir::return_expr_stmt(
        prefix_result.string_counter,
        final_result,
        final_insts
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        stmts
    );
}

pub struct ShortCircuitOrLowerResult {
    pub final_node: i64,
    pub string_counter: i64,
    pub temp_counter: i64,
    pub if_index: i64,
}

fn lower_short_circuit_or_prefix(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !ShortCircuitOrLowerResult {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) != 2 {
        return ShortCircuitOrLowerResult {
            final_node: node,
            string_counter: string_counter,
            temp_counter: temp_counter,
            if_index: if_index
        };
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    let left_result = try append_short_circuit_or_operand_ifs(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        left_node,
        string_counter,
        temp_counter,
        if_index,
        stmts,
        bs
    );
    return try lower_short_circuit_or_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        right_node,
        left_result.string_counter,
        left_result.temp_counter,
        left_result.if_index,
        stmts,
        bs
    );
}

fn append_short_circuit_or_operand_ifs(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !ShortCircuitOrLowerResult {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) == 2 {
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        let left_result = try append_short_circuit_or_operand_ifs(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            params_spec,
            left_node,
            string_counter,
            temp_counter,
            if_index,
            stmts,
            bs
        );
        return try append_short_circuit_or_operand_ifs(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            params_spec,
            right_node,
            left_result.string_counter,
            left_result.temp_counter,
            left_result.if_index,
            stmts,
            bs
        );
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        node,
        string_counter,
        temp_counter,
        &var cond_insts,
        bs
    );
    let cond_strings = try count_strings_in_insts(&cond_insts);
    let cond_len = cond_insts.len();
    try stmts.append(compiled_mir::if_stmt(
        if_index,
        string_counter,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        compiled_mir::MirIfThenKind::ReturnBool,
        true,
        llvm_return_type,
        "",
        "",
        std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        string_counter + cond_strings
    ));
    return ShortCircuitOrLowerResult {
        final_node: node,
        string_counter: string_counter + cond_strings,
        temp_counter: temp_counter + cond_len,
        if_index: if_index + 1
    };
}

// ValueLoopInit carries the value-carried loop seed call's (module_prefix, callee_name) so the
// renderer can emit '@<module_prefix><callee>' for the first iteration value, plus the seed call's
// return kizu type -- the loop's element type, used for the array element width and the struct
// field layout (issue 1165).
struct ValueLoopInit {
    callee_qualified: []u8,
    element_kizu: []u8,
}

// signature_return_kizu resolves a callee's declared return kizu type from the
// 'function-signature-return <name> <type>' facts. A same-module call written fully qualified
// (e.g. std::kizu::lexer::first_token from within std::kizu::lexer) records its name with the
// module prefix already included, so the direct module_prefix+callee key would double it; this
// retries with the module prefix stripped off the callee. (issue 1165)
fn signature_return_kizu(
    ir_bytes: []u8,
    module_prefix: []u8,
    callee: []u8
) -> ![]u8 {
    let direct = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
        ir_bytes, "function-signature-return ", module_prefix, callee
    );
    if std::mem::len(direct) > 0 {
        return direct;
    }
    if std::mem::starts_with(callee, module_prefix) {
        let short = callee[std::mem::len(module_prefix)..std::mem::len(callee)];
        let stripped = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
            ir_bytes, "function-signature-return ", module_prefix, short
        );
        if std::mem::len(stripped) > 0 {
            return stripped;
        }
    }
    return error("compiled mir: value-loop seed return type not found");
}

// node_kind_is reports whether a body node's kind equals the expected string. It wraps
// body_node_kind_from so callers avoid nesting a try-expression inside a call argument, which keeps
// the value-loop helpers within the std parser subset the selfhost compiler accepts (issue 1165).
fn node_kind_is(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    expected: []u8,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    return std::mem::equal_bytes(kind, expected);
}

// find_while_statement returns the sequence id of the first top-level While statement, or -1 when
// the function has none (issue 1165). Used to detect the value-carried array-append loop shape.
fn find_while_statement(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !i64 {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "While") {
            return statement;
        }
        index = index + 1;
    }
    return -1;
}

// find_while_index returns the statement index of the first top-level While, or -1 when the function
// has none. The index lets lower_value_array_loop bracket the loop with the seed append (index - 1)
// and the array return (index + 1) (issue 1165).
fn find_while_index(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !i64 {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        if try node_kind_is(ir_bytes, function_name, statement, "While", bs) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// value_loop_call_arg_var returns the local name of a call's nth argument, requiring it to be a Var.
// The value loop's seed / update calls take only local arguments, so a non-local is rejected rather
// than mis-lowered (issue 1165).
fn value_loop_call_arg_var(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    arg_index: i64,
    bs: i64
) -> ![]u8 {
    let arg = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", arg_index, bs
    );
    if !try node_kind_is(ir_bytes, function_name, arg, "Var", bs) {
        return error("compiled mir: value-loop call argument must be a local");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, arg, bs);
}

// is_value_array_loop_shape reports whether this multi-statement function is the value-carried
// array-append loop that generic lowering targets (issue 1165): a While whose condition is a
// single '<struct-value>.<field> != <Enum>::<Variant>' comparison -- a field-mode FieldExpr on
// the left and a namespace-mode FieldExpr (an enum constant) on the right. This is structurally
// distinct from the i64-induction While (whose condition compares an i64 Var), so detecting it
// here never diverts an induction loop. The body shape (reassign + try-append) and the array /
// seed lets are validated by lower_value_array_loop; a true result commits to that path.
fn is_value_array_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    let while_statement = try find_while_statement(ir_bytes, function_name, statement_count, bs);
    if while_statement < 0 {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    let cond_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, cond_node, bs);
    if !std::mem::equal_bytes(cond_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "not-eq") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_kind, "FieldExpr") {
        return false;
    }
    let left_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, left_node, bs
    );
    if !std::mem::equal_bytes(left_mode, "field") {
        return false;
    }
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(right_kind, "FieldExpr") {
        return false;
    }
    let right_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, right_node, bs
    );
    return std::mem::equal_bytes(right_mode, "namespace");
}

// find_value_loop_init locates the 'var <loop_var> = <callee>(<source>)' seed let and returns the
// callee's (module_prefix, callee_name). The seed supplies both the loop's preheader value and the
// element type that array_new / the append slices use (issue 1165).
fn find_value_loop_init(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    loop_var: []u8,
    source_name: []u8,
    statement_count: i64,
    bs: i64
) -> !ValueLoopInit {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, loop_var) {
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
                let value_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, value, bs
                );
                if !std::mem::equal_bytes(value_kind, "Call") {
                    return error("compiled mir: value-loop seed must be a call");
                }
                if (try compiled_mir_types::count_call_args(ir_bytes, function_name, value, bs)) != 1 {
                    return error("compiled mir: value-loop seed takes exactly the source argument");
                }
                let seed_arg = try value_loop_call_arg_var(ir_bytes, function_name, value, 0, bs);
                if !std::mem::equal_bytes(seed_arg, source_name) {
                    return error("compiled mir: value-loop seed argument must be the source");
                }
                let init_callee_qualified = try ir_contract::body_call_callee_or_empty_from(
                    ir_bytes, function_name, value, bs
                );
                let element_kizu = try signature_return_kizu(
                    ir_bytes, module_prefix, init_callee_qualified
                );
                return ValueLoopInit {
                    callee_qualified: init_callee_qualified,
                    element_kizu: element_kizu
                };
            }
        }
        index = index + 1;
    }
    return error("compiled mir: value-loop seed let not found");
}

// value_loop_assert_append validates that <statement> is exactly 'try <array_name>.append(<value_name>);'
// -- an ExprStmt wrapping a try-call of the 'append' method on the array local, taking the carried
// value as its sole argument. Both the seed append (before the loop) and the body append are checked
// this way so a near-miss shape (wrong receiver, wrong/extra argument, different method) is an explicit
// error rather than a silent mis-lowering (issue 1165).
fn value_loop_assert_append(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    array_name: []u8,
    value_name: []u8,
    bs: i64
) -> !void {
    if !try node_kind_is(ir_bytes, function_name, statement, "ExprStmt", bs) {
        return error("compiled mir: value-loop append must be an expression statement");
    }
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, expr, "TryExpr", bs) {
        return error("compiled mir: value-loop append must be a try expression");
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, inner, "Call", bs) {
        return error("compiled mir: value-loop append must wrap a call");
    }
    if !try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: value-loop append must be a method call");
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "append") {
        return error("compiled mir: value-loop method must be append");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, receiver_node, "Var", bs) {
        return error("compiled mir: value-loop array receiver must be a local");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_name, array_name) {
        return error("compiled mir: value-loop append receiver must be the array");
    }
    if (try compiled_mir_types::count_call_args(ir_bytes, function_name, inner, bs)) != 1 {
        return error("compiled mir: value-loop append takes exactly one argument");
    }
    let arg_name = try value_loop_call_arg_var(ir_bytes, function_name, inner, 0, bs);
    if !std::mem::equal_bytes(arg_name, value_name) {
        return error("compiled mir: value-loop append argument must be the carried value");
    }
    return;
}

// value_loop_array_let_name finds the 'var <name> = std::array::Array<T>(<allocator>)' constructor
// let preceding the loop (statement index < before_index) and returns <name>. It validates the
// callee is exactly std::array::Array (or std::array::Array<...>) -- a near-miss like
// std::array::ArrayFoo is rejected -- and that the constructor takes exactly the function's allocator, since
// the renderer always passes params_spec[0] as the allocator -- a different argument would otherwise
// be silently mis-lowered. Absence or a mismatched argument is an explicit error (issue 1165).
fn value_loop_array_let_name(
    ir_bytes: []u8,
    function_name: []u8,
    allocator_name: []u8,
    before_index: i64,
    bs: i64
) -> ![]u8 {
    var index = 0;
    while index < before_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        if try node_kind_is(ir_bytes, function_name, statement, "Let", bs) {
            let value = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "value", 0, bs
            );
            if try node_kind_is(ir_bytes, function_name, value, "Call", bs) {
                let callee = try ir_contract::body_call_callee_or_empty_from(
                    ir_bytes, function_name, value, bs
                );
                if std::mem::equal_bytes(callee, "std::array::Array")
                    or std::mem::starts_with(callee, "std::array::Array<") {
                    let ctor_args = try compiled_mir_types::count_call_args(
                        ir_bytes, function_name, value, bs
                    );
                    if ctor_args != 1 {
                        return error("compiled mir: value-loop array constructor takes exactly the allocator argument");
                    }
                    let ctor_arg = try value_loop_call_arg_var(
                        ir_bytes, function_name, value, 0, bs
                    );
                    if !std::mem::equal_bytes(ctor_arg, allocator_name) {
                        return error("compiled mir: value-loop array constructor argument must be the allocator");
                    }
                    let name_node = try ir_contract::body_child_sequence_from(
                        ir_bytes, function_name, statement, "name", 0, bs
                    );
                    return try ir_contract::body_token_or_empty_from(
                        ir_bytes, function_name, name_node, bs
                    );
                }
            }
        }
        index = index + 1;
    }
    return error("compiled mir: value-loop array constructor let not found");
}

// lower_value_array_loop lowers the value-carried array-append loop (the std::kizu::lexer::tokenize
// shape) into a generic ArrayNew + ValueWhile pair (issue 1165). It derives every loop parameter
// from the IR rather than the function name: the loop var and array name from the condition / body,
// the element type and field index from resolving the condition's field access, the Eof sentinel
// tag from the condition's enum constant, and the seed / update callees from the seed let and the
// body reassignment. The element width and struct layout flow from the element type, so no size or
// symbol is hardcoded per function. ABI types (%kizu.owned / %kizu.error.void) and the runtime
// append symbol are fixed array-runtime constants, not tokenize specifics.
pub fn lower_value_array_loop(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let allocator_name = try nth_param_field(params_spec, 0, true);
    let source_name = try nth_param_field(params_spec, 1, true);
    let while_index = try find_while_index(ir_bytes, function_name, statement_count, bs);
    if while_index < 0 {
        return error("compiled mir: value-loop while statement not found");
    }
    // The loop must be directly preceded by the seed append and be the penultimate statement, with
    // the array return trailing it: [array-let, seed-let, seed-append, while, return] (issue 1165).
    if while_index < 1 {
        return error("compiled mir: value-loop while must follow the seed append");
    }
    if while_index + 1 != statement_count - 1 {
        return error("compiled mir: value-loop while must be the penultimate statement");
    }
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    let loop_var_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, left_node, "receiver", 0, bs
    );
    let loop_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, loop_var_receiver, bs
    );
    // The filled array must be a std::array::Array<T> constructor let preceding the loop; its name
    // anchors the seed append, the body append, and the return.
    let array_name = try value_loop_array_let_name(
        ir_bytes, function_name, allocator_name, while_index, bs
    );
    // The seed call's return type is the carried struct -- the array element type. Deriving it from
    // the seed call avoids re-resolving the loop var's type through its field access, whose namespaced
    // same-module callee the local-type resolver mis-reads as an Arena.add (issue 1165). The element
    // kizu type then yields the LLVM element type and the compared field's struct index. The seed let
    // also pins 'var <loop_var> = <init>(<source>)'.
    let init = try find_value_loop_init(
        ir_bytes, function_name, module_prefix, loop_var, source_name, statement_count, bs
    );
    let element_kizu = init.element_kizu;
    let element_type = try compiled_type_lower::kizu_type_to_llvm(
        ir_bytes, module_prefix, element_kizu
    );
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, left_node, "field", bs
    );
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix(
        ir_bytes, module_prefix,
        compiled_mir_types::struct_lookup_kizu_type(element_kizu), field_name
    );
    if !field.found {
        return error("compiled mir: value-loop compared field not found");
    }
    let field_index = field.index;
    // The condition's right-hand enum constant supplies the loop's exit (Eof) discriminant tag.
    let enum_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, right_node, "receiver", 0, bs
    );
    let enum_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, enum_receiver, bs
    );
    let variant_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, right_node, "namespace", bs
    );
    let eof_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix(
        ir_bytes, module_prefix, enum_name, variant_name
    );
    // The statement directly before the loop must seed the array: 'try <array>.append(<loop_var>);'.
    let seed_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index - 1, bs
    );
    try value_loop_assert_append(
        ir_bytes, function_name, seed_statement, array_name, loop_var, bs
    );
    // The loop body must be exactly the reassignment then the try-append.
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 2 {
        return error("compiled mir: value-loop body must be reassignment then append");
    }
    let assign_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, assign_statement, "Assign", bs) {
        return error("compiled mir: value-loop body must begin with a reassignment");
    }
    let assign_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_statement, "target", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, assign_target, "Var", bs) {
        return error("compiled mir: value-loop reassignment target must be a local");
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, assign_target, bs), loop_var
    ) {
        return error("compiled mir: value-loop reassignment must target the carried value");
    }
    let update_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_statement, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, update_value, "Call", bs) {
        return error("compiled mir: value-loop reassignment must be a call");
    }
    if (try compiled_mir_types::count_call_args(ir_bytes, function_name, update_value, bs)) != 2 {
        return error("compiled mir: value-loop update takes the source and carried value");
    }
    let update_arg0 = try value_loop_call_arg_var(ir_bytes, function_name, update_value, 0, bs);
    if !std::mem::equal_bytes(update_arg0, source_name) {
        return error("compiled mir: value-loop update first argument must be the source");
    }
    let update_arg1 = try value_loop_call_arg_var(ir_bytes, function_name, update_value, 1, bs);
    if !std::mem::equal_bytes(update_arg1, loop_var) {
        return error("compiled mir: value-loop update second argument must be the carried value");
    }
    let update_callee_qualified = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, update_value, bs
    );
    let append_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    try value_loop_assert_append(
        ir_bytes, function_name, append_statement, array_name, loop_var, bs
    );
    // The statement directly after the loop must return the filled array: 'return <array>;'.
    let return_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index + 1, bs
    );
    if !try node_kind_is(ir_bytes, function_name, return_statement, "Return", bs) {
        return error("compiled mir: value-loop must end with the array return");
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_statement, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, return_value, "Var", bs) {
        return error("compiled mir: value-loop return value must be the array local");
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs), array_name
    ) {
        return error("compiled mir: value-loop must return the filled array");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::array_new_stmt(
        array_name, "%kizu.owned", allocator_name, element_type
    ));
    try stmts.append(compiled_mir::value_while_stmt(
        array_name, loop_var, source_name, element_type,
        "%kizu.owned", llvm_return_type, "%kizu.error.void",
        init.callee_qualified, update_callee_qualified,
        "kizu_rt_array_append", field_index, eof_tag, "vw0"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

pub fn lower_multi_statement_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    if statement_count < 2 {
        return error("compiled mir: multi-statement function requires multiple statements");
    }
    // A value-carried array-append loop (struct value threaded through a phi, appended into a
    // runtime array until a sentinel tag) lowers through the generic ArrayNew + ValueWhile path
    // rather than the i64-induction While machinery (issue 1165).
    if try is_value_array_loop_shape(ir_bytes, function_name, statement_count, bs) {
        return try lower_value_array_loop(
            ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, statement_count, bs
        );
    }
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var locals_spec = params_spec;
    var string_counter = 0;
    var temp_counter = 0;
    var try_counter = 0;
    var stmt_index = 0;
    while stmt_index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", stmt_index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            // A 'var counter = <int>' that a later while increments is the loop
            // induction initializer: it is not emitted as a let because the loop-head
            // phi supplies the initial value on the preheader edge, so emitting it
            // would redefine the induction SSA name (tracker 961).
            if try statement_is_induction_init(
                ir_bytes, function_name, statement, statement_count, bs
            ) {
                stmt_index = stmt_index + 1;
                continue;
            }
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                statement,
                string_counter,
                temp_counter,
                try_counter,
                &var stmts,
                bs
            );
            locals_spec = let_result.locals_spec;
            string_counter = let_result.string_counter;
            temp_counter = let_result.temp_counter;
            try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(stmt_kind, "While") {
                let while_result = try lower_multi_while_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    statement,
                    string_counter,
                    temp_counter,
                    stmt_index,
                    &var stmts,
                    bs
                );
                temp_counter = while_result.temp_counter;
                string_counter = while_result.string_counter;
            } else {
            if std::mem::equal_bytes(stmt_kind, "Return") {
                try stmts.append(try lower_multi_return_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    statement,
                    string_counter,
                    temp_counter,
                    bs
                ));
            } else {
                if std::mem::equal_bytes(stmt_kind, "If") {
                    let if_result = try lower_multi_if_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        statement,
                        string_counter,
                        temp_counter,
                        stmt_index,
                        &var stmts,
                        bs
                    );
                    temp_counter = if_result.temp_counter;
                    string_counter = if_result.string_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                        let expr_result = try lower_multi_expr_statement(
                            ir_bytes,
                            function_name,
                            llvm_return_type,
                            locals_spec,
                            statement,
                            string_counter,
                            try_counter,
                            &var stmts,
                            bs
                        );
                        string_counter = expr_result.string_counter;
                        try_counter = expr_result.try_counter;
                    } else {
                        return error("compiled mir: unsupported statement kind");
                    }
                }
            }
            }
        }
        stmt_index = stmt_index + 1;
    }
    return compiled_mir_function::multi_statement_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        stmts
    );
}
pub struct MultiLowerResult {
    pub locals_spec: []u8,
    pub string_counter: i64,
    pub temp_counter: i64,
    pub try_counter: i64,
}
pub struct MultiIfLowerResult {
    pub temp_counter: i64,
    pub string_counter: i64,
}
pub struct MultiExprLowerResult {
    pub string_counter: i64,
    pub try_counter: i64,
}

// lower_multi_expr_statement lowers a bare 'try <receiver>.<method>(<arg>);' expression
// statement that mutates a std::string::String value (issue 1165 slice 1). String lowers to
// the runtime-owned handle %kizu.owned, so out.append_bytes(bytes) / out.append_byte(byte)
// forward to the @kizu_rt_string_append_bytes / @kizu_rt_string_append_byte runtime helpers
// (each returning %kizu.error.void). The method is recognized by name -- append_bytes and
// append_byte are String-only in the selfhost source -- and lowers to a StringTryAppend
// statement that propagates a runtime failure as this function's own error union and binds no
// success value. The argument is a local ([]u8 or u8) or a string literal; a nested call
// argument is not yet supported.
fn lower_multi_expr_statement(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    try_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !MultiExprLowerResult {
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, bs
    );
    let expr_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr, bs);
    if !std::mem::equal_bytes(expr_kind, "TryExpr") {
        return error("compiled mir: unsupported expression statement");
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: try expression statement must wrap a call");
    }
    if !try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: try call statement must be a method call");
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: string method receiver must be a local");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let arg_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "arg", 0, bs
    );
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var consumed_string = 0;
    if std::mem::equal_bytes(method_name, "append_bytes") {
        consumed_string = try lower_string_method_arg(
            ir_bytes, function_name, "%kizu.slice.u8", arg_node, string_counter, &var args, bs
        );
        try stmts.append(compiled_mir::string_try_append_stmt(
            receiver_name, "kizu_rt_string_append_bytes", llvm_return_type,
            string_counter, try_counter, args
        ));
    } else {
        if std::mem::equal_bytes(method_name, "append_byte") {
            consumed_string = try lower_string_method_arg(
                ir_bytes, function_name, "i8", arg_node, string_counter, &var args, bs
            );
            try stmts.append(compiled_mir::string_try_append_stmt(
                receiver_name, "kizu_rt_string_append_byte", llvm_return_type,
                string_counter, try_counter, args
            ));
        } else {
            return error("compiled mir: unsupported string method");
        }
    }
    return MultiExprLowerResult {
        string_counter: string_counter + consumed_string,
        try_counter: try_counter + 1
    };
}

// lower_string_method_arg lowers the single argument of a String append method into the call
// argument array, returning the number of string-literal global slots it consumed (issue 1165
// slice 1). A local argument resolves to a Var call arg of the method's fixed LLVM type; a
// string literal resolves to a String call arg seeded at string_index.
fn lower_string_method_arg(
    ir_bytes: []u8,
    function_name: []u8,
    arg_type: []u8,
    arg_node: i64,
    string_index: i64,
    args: &var std::array::Array<compiled_mir::MirCallArg>,
    bs: i64
) -> !i64 {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if std::mem::equal_bytes(arg_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, bs
        );
        try args.append(compiled_mir::var_call_arg(arg_type, var_name));
        return 0;
    }
    if std::mem::equal_bytes(arg_kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, bs
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid call string token"
        );
        try args.append(compiled_mir::string_call_arg(arg_type, token, string_index));
        return 1;
    }
    return error("compiled mir: unsupported string method argument");
}
fn lower_multi_let_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !MultiLowerResult {
    let let_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, let_name_node, bs
    );
    let let_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let let_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, let_value, bs);
    // A 'let <name> = try <callee>(<args>);' try-call over an error-union-returning free
    // function (the node_count traversal cluster, tracker 961). It lowers to a LetTryCall
    // statement: call the error union, branch on its ok flag, propagate the failure as this
    // function's own error union, and bind the success value.
    if std::mem::equal_bytes(let_value_kind, "TryExpr") {
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, let_value, "value", 0, bs
        );
        let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
        if !std::mem::equal_bytes(inner_kind, "Call") {
            return error("compiled mir: try let value must wrap a call");
        }
        // 'let next = try tokens.get(<expr>);' on a value-receiver Array<T> binds the
        // element by value off the checked array_at builtin and propagates a failure as
        // this function's own error union (issue 1165). The callee is a field-mode method,
        // so it is routed ahead of the free-function try-call path.
        if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
            return try lower_multi_let_array_get(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                let_name, inner, string_counter, temp_counter, try_counter, stmts, bs
            );
        }
        return try lower_multi_let_try_call(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            let_name, inner, string_counter, temp_counter, try_counter, stmts, bs
        );
    }
    if std::mem::equal_bytes(let_value_kind, "Call") {
        // A Call whose callee is a field-mode method is the checked Arena<T>.add
        // lowering (self.<field>.add(<struct literal>)), binding the appended slot
        // index. Ast.add_node is its first consumer (tracker 961). The element struct
        // consumes string_counter prefixes for its insertvalue chain, so the counter
        // advances by the element field count to keep later struct temps distinct.
        if try callee_is_field_expr(ir_bytes, function_name, let_value, bs) {
            return try lower_multi_let_arena_add(
                ir_bytes, function_name, module_prefix, locals_spec,
                let_name, let_value, string_counter, temp_counter, try_counter, stmts, bs
            );
        }
        // 'let comparison = compare_bytes(token_text(source, left_token), token_text(source,
        // right_token));' carries nested call arguments the inline call-arg descriptors cannot
        // model, so it lowers through the generic expression path (which materializes each
        // nested call into a preceding expr temp) as a let-expr statement, mirroring the
        // return-statement nested-call handling (issue 1165 / 1162).
        if try call_has_call_arg(ir_bytes, function_name, let_value, bs) {
            var nested_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let nested_result_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                let_value,
                string_counter,
                temp_counter,
                &var nested_insts,
                bs
            );
            let nested_strings = try count_strings_in_insts(&nested_insts);
            let nested_inst_count = nested_insts.len();
            let nested_call_type = try compiled_mir_types::lower_call_return_type(
                ir_bytes, function_name, module_prefix, let_value, bs
            );
            let nested_locals = try compiled_signature::extend_locals_spec(
                ir_bytes, locals_spec, let_name, nested_call_type
            );
            try stmts.append(compiled_mir::let_expr_stmt(
                let_name, string_counter, nested_result_id, nested_insts
            ));
            return MultiLowerResult {
                locals_spec: nested_locals,
                string_counter: string_counter + nested_strings,
                temp_counter: temp_counter + nested_inst_count,
                try_counter: try_counter
            };
        }
        let call_type = try compiled_mir_types::lower_call_return_type(
            ir_bytes, function_name, module_prefix, let_value, bs
        );
        let callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, let_value, bs
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, let_value, bs
        );
        let args = try compiled_mir_lower_call::lower_call_args(
            ir_bytes, function_name, module_prefix, locals_spec, let_value, string_counter, bs
        );
        let new_locals = try compiled_signature::extend_locals_spec(
            ir_bytes, locals_spec, let_name, call_type
        );
        let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
        try stmts.append(compiled_mir::let_call_stmt(
            let_name, call_type, string_counter, callee_module_prefix, callee_name, args
        ));
        return MultiLowerResult {
            locals_spec: new_locals,
            string_counter: new_counter,
            temp_counter: temp_counter,
            try_counter: try_counter
        };
    }
    if std::mem::equal_bytes(let_value_kind, "StructLiteralExpr") {
        let struct_type = try compiled_signature::resolve_struct_literal_type(
            ir_bytes, function_name, module_prefix, let_value, bs
        );
        let fields = try compiled_mir_lower_struct::lower_struct_fields(
            ir_bytes, function_name, module_prefix, locals_spec, let_value, bs
        );
        let field_count = fields.len();
        let new_locals = try compiled_signature::extend_locals_spec(
            ir_bytes, locals_spec, let_name, struct_type
        );
        try stmts.append(compiled_mir::let_struct_stmt(
            let_name, struct_type, string_counter, fields
        ));
        return MultiLowerResult {
            locals_spec: new_locals,
            string_counter: string_counter + field_count,
            temp_counter: temp_counter,
            try_counter: try_counter
        };
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        let_value,
        string_counter,
        temp_counter,
        &var insts,
        bs
    );
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    try stmts.append(compiled_mir::let_expr_stmt(
        let_name, string_counter, result_id, insts
    ));
    return MultiLowerResult {
        locals_spec: locals_spec,
        string_counter: string_counter + expr_strings,
        temp_counter: next_temp,
        try_counter: try_counter
    };
}

// lower_multi_let_try_call lowers a 'let <name> = try <callee>(<args>);' try-call into a
// LetTryCall statement (tracker 961). It resolves the callee's error-union return type
// (called_error_union), the unwrapped success type the bind takes, the callee symbol +
// args, and threads this function's own error-union return type for the failure
// propagation. try_counter advances so each try-call gets a distinct block-label pair.
fn lower_multi_let_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !MultiLowerResult {
    let called_error_union = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let args = try compiled_mir_lower_call::lower_call_args(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, bs
    );
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, success_type
    );
    let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
    try stmts.append(compiled_mir::let_try_call_stmt(
        let_name, called_error_union, success_type, llvm_return_type,
        callee_module_prefix, callee_name, string_counter, try_counter, args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: new_counter,
        temp_counter: temp_counter,
        try_counter: try_counter + 1
    };
}

// lower_multi_let_array_get lowers 'let <name> = try <receiver>.get(<expr>);' where the
// receiver is a value std::array::Array<T> param/local (issue 1165). The receiver lowers
// to %kizu.owned, so the index expression lowers into expr_insts and the LetArrayGet
// renderer reads the handle straight off the named value, calls the checked
// @kizu_rt_array_at builtin, binds the element (element type T derived from Array<T>) to
// <name> on success, and propagates a failure as this function's own error union. An
// unsupported method/receiver/element type fails explicitly.
fn lower_multi_let_array_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !MultiLowerResult {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return error("compiled mir: only Array.get is supported in let-try position on a value receiver");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: Array.get value receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type(
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs
    );
    let lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    if !is_array_field_type(lookup) {
        return error("compiled mir: Array.get receiver is not a std::array::Array");
    }
    let element_kizu_type = try array_element_kizu_type(lookup);
    let element_llvm_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix(
        ir_bytes, "", element_kizu_type
    );
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let index_result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        index_node,
        string_counter,
        temp_counter,
        &var insts,
        bs
    );
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    try stmts.append(compiled_mir::let_array_get_stmt(
        let_name,
        receiver_name,
        element_llvm_type,
        llvm_return_type,
        index_result_id,
        string_counter,
        try_counter,
        insts
    ));
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, element_llvm_type
    );
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: string_counter + expr_strings,
        temp_counter: next_temp,
        try_counter: try_counter + 1
    };
}

// try_call_success_type resolves the unwrapped success type a 'try <callee>(...)' binds:
// it reads the callee's '!T' signature-return token, strips the leading '!', and lowers T.
fn try_call_success_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    let ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty(
        ir_bytes, "function-signature-return ", module_prefix, callee_name
    );
    if std::mem::len(ret_kizu) == 0 {
        return error("compiled mir: try-call callee return type not found");
    }
    if ret_kizu[0] != cast<u8>(33) {
        return error("compiled mir: try-call callee must return an error union");
    }
    let success_kizu = ret_kizu[1..std::mem::len(ret_kizu)];
    return try compiled_type_lower::kizu_type_to_llvm(ir_bytes, module_prefix, success_kizu);
}
fn lower_multi_return_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    bs: i64
) -> !compiled_mir::MirStmt {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if std::mem::equal_bytes(value_kind, "Call") {
        if try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, value, bs) {
            let message_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, value, "arg", 0, bs
            );
            var message_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let message_result = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                message_node,
                string_counter,
                temp_counter,
                &var message_insts,
                bs
            );
            return compiled_mir::return_error_stmt(
                string_counter, message_result, message_insts
            );
        }
        // A Call whose callee is a FieldExpr is a struct-field method call. The only
        // supported multi-statement method return is the checked Array<T>.get
        // accessor (self.<field>.get(<expr>) -> !T), backing Ast.child_at (tracker 961).
        if try callee_is_field_expr(ir_bytes, function_name, value, bs) {
            return try lower_multi_return_array_get(
                ir_bytes, function_name, module_prefix, llvm_return_type,
                locals_spec, value, string_counter, temp_counter, bs
            );
        }
        // 'return equal_bytes(token_text(...), expected);' carries a nested call argument and
        // 'return is_line_break(source[cursor]);' carries a single-element byte index load --
        // arguments the inline call-arg descriptors cannot model -- so each lowers through the
        // generic expression path (which materializes the nested call or checked byte load into a
        // preceding temp) as a return-expr statement instead of an inline return-call (issue 1165 /
        // 1162).
        if try call_has_hoisted_arg(ir_bytes, function_name, value, bs) {
            var nested_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let nested_result_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                value,
                string_counter,
                temp_counter,
                &var nested_insts,
                bs
            );
            return compiled_mir::return_expr_stmt(string_counter, nested_result_id, nested_insts);
        }
        let call_type = try compiled_mir_types::lower_call_return_type(
            ir_bytes, function_name, module_prefix, value, bs
        );
        let callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, value, bs
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, value, bs
        );
        let args = try compiled_mir_lower_call::lower_call_args(
            ir_bytes, function_name, module_prefix, locals_spec, value, string_counter, bs
        );
        return compiled_mir::return_call_stmt(
            call_type, string_counter, callee_module_prefix, callee_name, args
        );
    }
    if std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        let fields = try compiled_mir_lower_struct::lower_struct_fields(
            ir_bytes, function_name, module_prefix, locals_spec, value, bs
        );
        return compiled_mir::return_struct_stmt(string_counter, fields);
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value,
        string_counter,
        temp_counter,
        &var insts,
        bs
    );
    return compiled_mir::return_expr_stmt(string_counter, result_id, insts);
}
// lower_multi_return_array_get lowers a multi-statement
// 'return self.<field>.get(<expr>);' (Array<T>.get -> !T, tracker 961). It lowers the
// index expression (e.g. range.start + index) into expr_insts, resolves the Array<T>
// field off the struct value receiver, and builds a ReturnArrayGet statement that the
// renderer turns into the checked @kizu_rt_array_at call + ok-branch + by-value load +
// error-union wrap. Ast.child_at is its first consumer.
fn lower_multi_return_array_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    bs: i64
) -> !compiled_mir::MirStmt {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return error("compiled mir: only Array.get method return is supported");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    // The method receiver is the array field expression self.<field>.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, bs
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.get receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, bs
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.get field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(locals_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type(
        ir_bytes, module_prefix, var_name, locals_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix(
        ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.get receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.get receiver field is not a std::array::Array");
    }
    let element_kizu_type = try array_element_kizu_type(field.field_type);
    let element_llvm_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix(
        ir_bytes, "", element_kizu_type
    );
    // Lower the index expression (e.g. range.start + index) into expr_insts; the
    // result temp %t<index_result_id> feeds the checked array element accessor.
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let index_result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        index_node,
        string_counter,
        temp_counter,
        &var insts,
        bs
    );
    return compiled_mir::return_array_get_stmt(
        receiver_llvm_type,
        var_name,
        field.index,
        element_llvm_type,
        index_result_id,
        string_counter,
        insts
    );
}
// short_circuit_kind classifies a condition node: 1 for and, 2 for or, 0
// otherwise. SPEC 6.9.1 requires and/or to short-circuit, so the if lowering
// evaluates the rhs only in the guarded block instead of eagerly.
fn short_circuit_kind(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(kind, "Binary") {
        return 0;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, node, bs
    );
    if std::mem::equal_bytes(op, "and") {
        return 1;
    }
    if std::mem::equal_bytes(op, "or") {
        return 2;
    }
    return 0;
}
// while_and_condition_eager_safe reports whether every operand of a short-circuit 'and'
// while header is side-effect-free, so an eager 'and i1' over the comparison results is
// observably identical to short-circuit evaluation. The condition may nest 'and' operands,
// each of which is a bool local/literal, a field read, a comparison Binary over
// side-effect-free values, or a pure '<receiver>.len()' call. An 'or' operand or any
// operand that could trap when the left side is false is rejected (issue 1165 / 1162).
fn while_and_condition_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try short_circuit_kind(ir_bytes, function_name, node, bs);
    if kind == 2 {
        return false;
    }
    if kind == 1 {
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        if !(try while_and_condition_eager_safe(ir_bytes, function_name, left, bs)) {
            return false;
        }
        return try while_and_condition_eager_safe(ir_bytes, function_name, right, bs);
    }
    return try while_condition_operand_eager_safe(ir_bytes, function_name, node, bs);
}
// while_condition_operand_eager_safe reports whether one leaf operand of an 'and' while
// header is side-effect-free: a bool local/literal or field read used directly, or a
// comparison Binary whose own operands are each a side-effect-free value.
fn while_condition_operand_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, node, bs
        );
        if !condition_op_is_comparison(op) {
            return false;
        }
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        if !(try while_condition_value_eager_safe(ir_bytes, function_name, left, bs)) {
            return false;
        }
        return try while_condition_value_eager_safe(ir_bytes, function_name, right, bs);
    }
    return try while_condition_value_eager_safe(ir_bytes, function_name, node, bs);
}
// while_condition_value_eager_safe reports whether a comparison operand value is
// side-effect-free: a local/literal/field read, or a pure '<receiver>.len()' call. A
// guarded array index load, a try-call, or any other call could trap and is rejected.
fn while_condition_value_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if std::mem::equal_bytes(kind, "Var") or std::mem::equal_bytes(kind, "Int") or
        std::mem::equal_bytes(kind, "Bool") or std::mem::equal_bytes(kind, "FieldExpr") {
        return true;
    }
    if std::mem::equal_bytes(kind, "Call") {
        if !(try callee_is_field_expr(ir_bytes, function_name, node, bs)) {
            return false;
        }
        let callee_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "callee", 0, bs
        );
        let method_name = try ir_contract::body_field_expr_name_from(
            ir_bytes, function_name, callee_node, "field", bs
        );
        return std::mem::equal_bytes(method_name, "len");
    }
    return false;
}
fn condition_op_is_comparison(op: []u8) -> bool {
    return std::mem::equal_bytes(op, "eq") or std::mem::equal_bytes(op, "not-eq") or
        std::mem::equal_bytes(op, "lt") or std::mem::equal_bytes(op, "lte") or
        std::mem::equal_bytes(op, "gt") or std::mem::equal_bytes(op, "gte");
}
// flatten_and_operands collects the leaf operands of a short-circuit 'and' chain in
// left-to-right evaluation order. A nested 'and' is descended (so '((a and b) and c)'
// and 'a and (b and c)' both flatten to [a, b, c]); any other node, including an 'or',
// is a leaf appended as-is, so the caller can reject a nested 'or' as a near-miss
// explicit error rather than silently eager-evaluating it (issue 1165 / 1162).
fn flatten_and_operands(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    operands: &var std::array::Array<i64>,
    bs: i64
) -> !void {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) == 1 {
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        try flatten_and_operands(ir_bytes, function_name, left, operands, bs);
        try flatten_and_operands(ir_bytes, function_name, right, operands, bs);
        return;
    }
    try operands.append(node);
    return;
}
fn lower_multi_if_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, bs
    );
    let cond_short_circuit = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_rhs_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_extra_operands = std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator());
    var cond_result = -1;
    var cond_rhs_result = -1;
    var last_cond_result = -1;
    var cond_strings = 0;
    if cond_short_circuit == 0 {
        cond_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            cond_node,
            string_counter,
            temp_counter,
            &var cond_insts,
            bs
        );
        cond_strings = try count_strings_in_insts(&cond_insts);
        last_cond_result = cond_result;
    } else {
        if cond_short_circuit == 1 {
            // An 'and' header lowers as a short-circuit chain of leaf operands evaluated
            // left to right, each guarded by every earlier operand (issue 1165 / 1162).
            // The first operand fills cond_insts (the unguarded entry block), the second
            // fills cond_rhs_insts (the first guarded block), and any further operands fill
            // cond_extra_operands. A nested 'or' is left a leaf by flatten_and_operands and
            // rejected here as a near-miss explicit error rather than eager-evaluated.
            var operands = std::array::Array<i64>(std::mem::page_allocator());
            try flatten_and_operands(ir_bytes, function_name, cond_node, &var operands, bs);
            var validate_index = 0;
            while validate_index < operands.len() {
                let operand_node = try operands.get(validate_index);
                if (try short_circuit_kind(ir_bytes, function_name, operand_node, bs)) != 0 {
                    return error("compiled mir: nested short-circuit and/or unsupported");
                }
                validate_index = validate_index + 1;
            }
            let op0 = try operands.get(0);
            cond_result = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                op0,
                string_counter,
                temp_counter,
                &var cond_insts,
                bs
            );
            var acc_strings = try count_strings_in_insts(&cond_insts);
            var acc_temp = temp_counter + cond_insts.len();
            let op1 = try operands.get(1);
            cond_rhs_result = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                op1,
                string_counter + acc_strings,
                acc_temp,
                &var cond_rhs_insts,
                bs
            );
            acc_strings = acc_strings + try count_strings_in_insts(&cond_rhs_insts);
            acc_temp = acc_temp + cond_rhs_insts.len();
            last_cond_result = cond_rhs_result;
            var extra_index = 2;
            while extra_index < operands.len() {
                var operand_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                let operand_node = try operands.get(extra_index);
                let operand_result = try lower_expr_into(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    operand_node,
                    string_counter + acc_strings,
                    acc_temp,
                    &var operand_insts,
                    bs
                );
                acc_strings = acc_strings + try count_strings_in_insts(&operand_insts);
                acc_temp = acc_temp + operand_insts.len();
                last_cond_result = operand_result;
                try cond_extra_operands.append(
                    compiled_mir::cond_operand(operand_result, operand_insts)
                );
                extra_index = extra_index + 1;
            }
            cond_strings = acc_strings;
            operands.deinit();
        } else {
            let left_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, cond_node, "left", 0, bs
            );
            let right_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, cond_node, "right", 0, bs
            );
            if (try short_circuit_kind(ir_bytes, function_name, left_node, bs)) != 0 or
                (try short_circuit_kind(ir_bytes, function_name, right_node, bs)) != 0 {
                return error("compiled mir: nested short-circuit and/or unsupported");
            }
            cond_result = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                left_node,
                string_counter,
                temp_counter,
                &var cond_insts,
                bs
            );
            let lhs_strings = try count_strings_in_insts(&cond_insts);
            let rhs_temp_base = temp_counter + cond_insts.len();
            let rhs_string_base = string_counter + lhs_strings;
            cond_rhs_result = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                right_node,
                rhs_string_base,
                rhs_temp_base,
                &var cond_rhs_insts,
                bs
            );
            cond_strings = lhs_strings + try count_strings_in_insts(&cond_rhs_insts);
            last_cond_result = cond_rhs_result;
        }
    }
    let then_string_base = string_counter + cond_strings;
    let then_base = last_cond_result + 1;
    let then_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let then_stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, then_stmt, bs);
    // A continue-latch then-block ('{ <induction> = <induction> + <step>; continue; }') carries no
    // return value: it folds its increment into the loop's shared constant-step latch and branches
    // back to the loop head, so it lowers to a ContinueLatch if whose then-block the renderer turns
    // into 'br label %loop<N>_latch'. line_comment_has_blank_after is its first consumer (issue 1165
    // / 1162). It shares the single if_stmt append below: the then-block fields stay empty and the
    // temp / string counters do not advance.
    var is_continue_latch_then = false;
    let then_continue = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, then_node, "statement", 1, bs
    );
    if then_continue >= 0 {
        let then_continue_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, then_continue, bs
        );
        if std::mem::equal_bytes(then_stmt_kind, "Assign") and
            std::mem::equal_bytes(then_continue_kind, "Continue") {
            is_continue_latch_then = true;
            let then_extra = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, then_node, "statement", 2, bs
            );
            if then_extra >= 0 {
                return error("compiled mir: continue-latch then-block must be '<increment>; continue;'");
            }
            // Validate the increment is a constant-step '<var> = <var> + <int>' against its own
            // target so a near-miss assign is an explicit error rather than a silently dropped latch
            // update; the while lowering re-reads the target/step to drive the shared latch add.
            let incr_target = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, then_stmt, "target", 0, bs
            );
            let incr_target_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, incr_target, bs
            );
            if !std::mem::equal_bytes(incr_target_kind, "Var") {
                return error("compiled mir: continue-latch increment target must be a var");
            }
            let incr_target_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, incr_target, bs
            );
            let _step = try parse_induction_step(
                ir_bytes, function_name, then_stmt, incr_target_name, bs
            );
        }
    }
    var then_kind = compiled_mir::MirIfThenKind::ContinueLatch;
    var bool_value = false;
    var call_type = llvm_return_type;
    var then_module_prefix = "";
    var callee_name = "";
    var call_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var then_result = -1;
    var then_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var then_struct_fields = std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator());
    var then_struct_strings = 0;
    var next_temp = then_base;
    var new_string_counter = then_string_base;
    if !is_continue_latch_then {
        if !std::mem::equal_bytes(then_stmt_kind, "Return") {
            return error("compiled mir: unsupported then block");
        }
        let ret_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_stmt, "value", 0, bs
        );
        let ret_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, ret_value, bs);
        then_kind = compiled_mir::MirIfThenKind::ReturnExpr;
        if std::mem::equal_bytes(ret_kind, "Bool") {
            let token = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, ret_value, bs
            );
            then_kind = compiled_mir::MirIfThenKind::ReturnBool;
            bool_value = std::mem::equal_bytes(token, "true");
        } else {
            if std::mem::equal_bytes(ret_kind, "Call") {
                if try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, ret_value, bs) {
                    then_kind = compiled_mir::MirIfThenKind::ReturnError;
                    let message_node = try ir_contract::body_child_sequence_from(
                        ir_bytes, function_name, ret_value, "arg", 0, bs
                    );
                    then_result = try lower_expr_into(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        message_node,
                        then_string_base,
                        then_base,
                        &var then_insts,
                        bs
                    );
                } else {
                call_type = try compiled_mir_types::lower_call_return_type(
                    ir_bytes, function_name, module_prefix, ret_value, bs
                );
                callee_name = try compiled_mir_types::lower_call_callee_name(
                    ir_bytes, function_name, module_prefix, ret_value, bs
                );
                call_args = try compiled_mir_lower_call::lower_call_args(
                    ir_bytes, function_name, module_prefix, locals_spec, ret_value, then_string_base, bs
                );
                then_kind = compiled_mir::MirIfThenKind::ReturnCall;
                then_module_prefix = try compiled_mir_types::lower_call_module_prefix(
                    ir_bytes, function_name, module_prefix, ret_value, bs
                );
                }
            } else {
                if std::mem::equal_bytes(ret_kind, "StructLiteralExpr") {
                    // A struct-literal then-block such as a return of PayloadSpan { .. }
                    // reuses the generic struct-field lowering. The struct SSA and global
                    // names are seeded from then_string_base, and the string counter then
                    // advances by the field count so a later then-block in the same
                    // function never reuses the same per-field SSA names.
                    then_struct_fields = try compiled_mir_lower_struct::lower_struct_fields(
                        ir_bytes, function_name, module_prefix, locals_spec, ret_value, bs
                    );
                    then_kind = compiled_mir::MirIfThenKind::ReturnStruct;
                    then_struct_strings = then_struct_fields.len();
                } else {
                    then_result = try lower_expr_into(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        ret_value,
                        then_string_base,
                        then_base,
                        &var then_insts,
                        bs
                    );
                }
            }
        }
        let then_call_strings = try compiled_mir_lower_call::count_string_args(&call_args);
        let then_expr_strings = try count_strings_in_insts(&then_insts);
        new_string_counter = then_string_base + then_call_strings + then_expr_strings + then_struct_strings;
        if then_kind == compiled_mir::MirIfThenKind::ReturnCall {
            next_temp = then_base + 1;
        }
        if then_kind == compiled_mir::MirIfThenKind::ReturnExpr {
            next_temp = then_result + 1;
        }
        if then_kind == compiled_mir::MirIfThenKind::ReturnError {
            next_temp = then_result + 1;
        }
    }
    try stmts.append(compiled_mir::if_stmt(
            if_index,
            string_counter,
            cond_result,
            cond_insts,
            cond_short_circuit,
            cond_rhs_result,
            cond_rhs_insts,
            cond_extra_operands,
            then_kind,
            bool_value,
            call_type,
            then_module_prefix,
            callee_name,
            call_args,
            then_result,
            then_insts,
            then_struct_fields,
            then_string_base
    ));
    return MultiIfLowerResult {
        temp_counter: next_temp,
        string_counter: new_string_counter
    };
}
// while_body_statement_count counts the statements in a while body Block by walking
// its "statement" child sequences until none remain.
fn while_body_statement_count(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    bs: i64
) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, body_node, "statement", count, bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}
// while_induction_var returns the counter a while loop carries: the target of the
// trailing 'name = name + step' increment that must close the loop body. The body's
// last statement must be that Assign to a Var (tracker 961).
fn while_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> ![]u8 {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        return error("compiled mir: while body must end with the induction increment");
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "Assign") {
        return error("compiled mir: while body must end with the induction increment");
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: induction increment target must be a var");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
}
// statement_is_induction_init reports whether a top-level let declares an induction counter
// of some while in the same function, by matching the let name against each while's induction
// variables. Both the primary counter (the trailing increment target) and every secondary
// lockstep counter (an earlier increment in the trailing run) are matched, so a 'var
// left_index = left + 1;' seed for a secondary counter is skipped at the top level and never
// emitted as a let that would redefine the loop-head phi %left_index (issue 1165 / 1162).
fn statement_is_induction_init(
    ir_bytes: []u8,
    function_name: []u8,
    let_statement: i64,
    statement_count: i64,
    bs: i64
) -> !bool {
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, name_node, bs
    );
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "While") {
            if try while_carries_induction_var(ir_bytes, function_name, statement, let_name, bs) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}
// while_carries_induction_var reports whether a while loop advances a counter named name,
// counting both the primary trailing increment target and every secondary increment in the
// trailing run (issue 1165 / 1162).
// if_then_ends_in_continue reports whether an if statement's then-block's last statement is a
// 'continue', the continue-latch marker. It only inspects the then-block shape; the increment is
// validated in lower_multi_if_statement / lower_multi_while_continue_latch (issue 1165 / 1162).
fn if_then_ends_in_continue(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !bool {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if count < 1 {
        return false;
    }
    let last = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last, bs);
    return std::mem::equal_bytes(last_kind, "Continue");
}
// while_is_continue_latch reports whether a while loop advances its induction variable through a
// continue-latch: a body 'if <cond> { <induction> = <induction> + <step>; continue; }' whose
// then-block ends in 'continue', rather than a trailing increment assign. Such a loop has no
// trailing latch statement -- the increment lives inside the continue-if and the loop's
// non-continue path falls through to a 'return'. line_comment_has_blank_after is its first consumer
// (issue 1165 / 1162).
fn while_is_continue_latch(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var index = 0;
    while index < body_count {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "If") {
            if try if_then_ends_in_continue(ir_bytes, function_name, stmt, bs) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}
// while_continue_increment_assign returns the '<induction> = <induction> + <step>' Assign node
// inside a continue-latch loop's body continue-if -- the first statement of the if whose then-block
// ends in 'continue' (issue 1165 / 1162).
fn while_continue_increment_assign(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !i64 {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var index = 0;
    while index < body_count {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "If") {
            if try if_then_ends_in_continue(ir_bytes, function_name, stmt, bs) {
                let then_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, stmt, "then", 0, bs
                );
                return try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, then_node, "statement", 0, bs
                );
            }
        }
        index = index + 1;
    }
    return error("compiled mir: continue-latch increment not found");
}
// while_continue_induction_var returns the induction variable a continue-latch loop advances: the
// target of the '<induction> = <induction> + <step>' increment inside the body continue-if (issue
// 1165 / 1162).
fn while_continue_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> ![]u8 {
    let assign = try while_continue_increment_assign(ir_bytes, function_name, while_node, bs);
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: continue-latch increment target must be a var");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
}
fn while_carries_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    // A continue-latch loop has no trailing increment run; its induction variable is the target of
    // the increment inside the body continue-if (issue 1165 / 1162).
    if try while_is_continue_latch(ir_bytes, function_name, while_node, bs) {
        let continue_var = try while_continue_induction_var(ir_bytes, function_name, while_node, bs);
        return std::mem::equal_bytes(continue_var, name);
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let latch_count = try while_trailing_increment_count(
        ir_bytes, function_name, body_node, body_count, bs
    );
    var index = body_count - latch_count;
    while index < body_count {
        let increment_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, increment_stmt, "target", 0, bs
        );
        let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
        if std::mem::equal_bytes(target_kind, "Var") {
            let target_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, target, bs
            );
            if std::mem::equal_bytes(target_name, name) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}
// InductionInit is the resolved 'var counter = <init>' loop-head phi seed. An integer
// literal initializer ('var index = 0') sets literal and leaves var_name empty; a
// parameter/local initializer ('var index = import_index') sets var_name to the source
// name and leaves literal at 0; a base-plus-offset initializer ('var left_index = left + 1')
// sets var_name to the base name and offset to the integer addend. The renderer prints
// %<var_name> on the preheader edge when var_name is non-empty and offset is zero, computes
// '%<var>_init = add i64 %<var_name>, offset' for a non-zero offset, and otherwise prints the
// literal (issue 1165 / 1162).
pub struct InductionInit {
    pub literal: i64,
    pub var_name: []u8,
    pub offset: i64,
}
// find_induction_init finds the 'var counter = <init>' initializer for the while at
// while_stmt_index and returns its loop-head phi seed. Only top-level Let statements that
// precede the while are considered, and the nearest preceding match wins, so two whiles
// reusing the same counter name each resolve their own initializer rather than aliasing
// the first one. Only an integer literal or a plain parameter/local name init is accepted;
// any other initializer shape is an explicit error so the restricted loop support never
// silently lowers a computed seed.
fn find_induction_init(
    ir_bytes: []u8,
    function_name: []u8,
    induction_var: []u8,
    while_stmt_index: i64,
    bs: i64
) -> !InductionInit {
    var found = false;
    var init_value = -1;
    var index = 0;
    while index < while_stmt_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, induction_var) {
                found = true;
                init_value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
            }
        }
        index = index + 1;
    }
    if !found {
        return error("compiled mir: induction variable initializer not found");
    }
    let value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, init_value, bs
    );
    if std::mem::equal_bytes(value_kind, "Int") {
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, init_value, bs
        );
        return InductionInit { literal: literal, var_name: "", offset: 0 };
    }
    if std::mem::equal_bytes(value_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, init_value, bs
        );
        return InductionInit { literal: 0, var_name: var_name, offset: 0 };
    }
    // 'var left_index = left + 1;' seeds the phi from a base parameter/local plus an integer
    // offset; the preheader computes the addend so two lockstep cursors can start one past
    // their respective import keywords (issue 1165 / 1162).
    if std::mem::equal_bytes(value_kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, init_value, bs
        );
        if !std::mem::equal_bytes(op, "add") {
            return error("compiled mir: induction base-plus-offset init must be an addition");
        }
        let base_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, init_value, "left", 0, bs
        );
        let offset_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, init_value, "right", 0, bs
        );
        let base_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, base_node, bs);
        let offset_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, offset_node, bs);
        if !std::mem::equal_bytes(base_kind, "Var") or !std::mem::equal_bytes(offset_kind, "Int") {
            return error("compiled mir: induction base-plus-offset init must be name + integer");
        }
        let base_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, base_node, bs);
        let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, offset_node, bs);
        return InductionInit { literal: 0, var_name: base_name, offset: offset };
    }
    return error("compiled mir: induction variable must be initialized to an integer or a parameter");
}
// find_induction_init_value_node returns the value node of the nearest preceding 'var counter =
// <value>' initializer for the while at while_stmt_index, without classifying the value. The
// continue-latch lowering uses it to detect a call-seeded init ('var cursor =
// line_end_including_break(source, comment_end)') and lower the call into the preheader; a
// non-call seed falls back to find_induction_init's literal/copy/offset classification (issue 1165
// / 1162).
fn find_induction_init_value_node(
    ir_bytes: []u8,
    function_name: []u8,
    induction_var: []u8,
    while_stmt_index: i64,
    bs: i64
) -> !i64 {
    var found = false;
    var init_value = -1;
    var index = 0;
    while index < while_stmt_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, induction_var) {
                found = true;
                init_value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
            }
        }
        index = index + 1;
    }
    if !found {
        return error("compiled mir: induction variable initializer not found");
    }
    return init_value;
}
// parse_induction_step validates the trailing 'name = name + <int>' increment for
// the induction variable and returns the integer step. Only this simple counter
// increment shape is accepted; anything else is rejected so the restricted loop
// support never silently lowers general assignment (tracker 961).
fn parse_induction_step(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    induction_var: []u8,
    bs: i64
) -> !i64 {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return error("compiled mir: induction increment must be an addition");
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return error("compiled mir: induction increment must be an addition");
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return error("compiled mir: induction increment must be name + integer");
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_name, induction_var) {
        return error("compiled mir: induction increment must add to the induction variable");
    }
    return try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
}
// while_assign_is_constant_step reports whether a body Assign is a constant-step
// 'name = name + <int>' induction increment: a Var target, a Binary add value whose left is
// that same Var and whose right is an integer literal. It backs the trailing-increment run
// detection that recognizes a multi-counter latch suffix (issue 1165 / 1162).
fn while_assign_is_constant_step(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    bs: i64
) -> !bool {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let target_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return false;
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    return std::mem::equal_bytes(left_name, target_name);
}
// while_trailing_increment_count returns the number of trailing latch statements at the end
// of a loop body. A loop-carried 'index = try <callee>(.., index);' try-call latch is a
// single statement; otherwise the latch is the maximal trailing run of constant-step
// 'name = name + <int>' increments (one for a single counter, several for lockstep counters).
// The last body statement must be an Assign in both shapes (issue 1165 / 1162).
fn while_trailing_increment_count(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_count: i64,
    bs: i64
) -> !i64 {
    if body_count < 1 {
        return error("compiled mir: while body must end with the induction increment");
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "Assign") {
        return error("compiled mir: while body must end with the induction increment");
    }
    let last_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "value", 0, bs
    );
    let last_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_value, bs);
    if std::mem::equal_bytes(last_value_kind, "TryExpr") {
        return 1;
    }
    // A copy-decrement latch 'index = previous' (the value is a plain Var read of a body-local
    // bound to 'index - <int>' earlier in the loop) is a single-statement latch like the try-call
    // update; the referenced let stays in the body so source[previous] still loads it (issue 1165
    // / 1162). This only classifies the latch length; the caller (lower_multi_while_statement)
    // validates the copied local is a genuine induction-variable decrement through
    // validate_copy_latch_source before lowering it.
    if std::mem::equal_bytes(last_value_kind, "Var") {
        return 1;
    }
    var count = 0;
    var index = body_count - 1;
    while index >= 0 {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if !std::mem::equal_bytes(kind, "Assign") {
            index = -1;
            continue;
        }
        if !(try while_assign_is_constant_step(ir_bytes, function_name, stmt, bs)) {
            index = -1;
            continue;
        }
        count = count + 1;
        index = index - 1;
    }
    if count < 1 {
        return error("compiled mir: while body must end with the induction increment");
    }
    return count;
}
// validate_copy_latch_source checks that a copy-decrement latch's source local ('previous' in
// 'index = previous') is bound earlier in the same loop body, before the latch suffix, by a
// 'let previous = <induction_var> - <positive int>' decrement. Anything else -- a missing
// binding, a non-Binary value, a non-subtraction, a base that is not the induction variable, or
// a non-integer / non-positive offset -- is an explicit error so the copy latch never silently
// lowers a value that would not count the loop down (issue 1165 / 1162).
fn validate_copy_latch_source(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    induction_var: []u8,
    copy_source: []u8,
    bs: i64
) -> !void {
    var index = 0;
    while index < body_boundary {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, stmt, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
            if std::mem::equal_bytes(name, copy_source) {
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, stmt, "value", 0, bs
                );
                let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
                if !std::mem::equal_bytes(value_kind, "Binary") {
                    return error("compiled mir: copy latch source must be '<induction> - <int>'");
                }
                let op = try ir_contract::sequence_fact_value_from(
                    ir_bytes, "body-binary ", function_name, value, bs
                );
                if !std::mem::equal_bytes(op, "sub") {
                    return error("compiled mir: copy latch source must subtract from the induction variable");
                }
                let base_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, value, "left", 0, bs
                );
                let offset_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, value, "right", 0, bs
                );
                let base_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, base_node, bs);
                let offset_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, offset_node, bs);
                if !std::mem::equal_bytes(base_kind, "Var") or !std::mem::equal_bytes(offset_kind, "Int") {
                    return error("compiled mir: copy latch source must be '<induction> - <int>'");
                }
                let base_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, base_node, bs);
                if !std::mem::equal_bytes(base_name, induction_var) {
                    return error("compiled mir: copy latch source must subtract from the induction variable");
                }
                let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, offset_node, bs);
                if offset < 1 {
                    return error("compiled mir: copy latch source decrement must be positive");
                }
                return;
            }
        }
        index = index + 1;
    }
    return error("compiled mir: copy latch source local not found in the loop body");
}
// lower_multi_while_statement lowers a restricted bounded counter loop: a single i64
// induction variable, a non-short-circuit comparison condition that reads it, a body
// of Let/If statements, and a trailing 'name = name + step' increment. The body
// statements reuse the same let/if lowering as the top level; body if labels are
// offset by the loop index so they never collide with top-level if labels. The
// induction increment is folded into induction_step and rendered in the loop latch.
fn lower_multi_while_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    loop_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    // A while header is one of three shapes. A single comparison, or a short-circuit 'and'
    // chain whose operands are all side-effect-free (bool/int locals and literals, field
    // reads, and pure '<receiver>.len()' calls), folds into an eager 'and i1' that is
    // observably identical to short-circuit evaluation, so it lowers through the same
    // lower_expr_into path the bare comparison uses (mir_short_circuit stays 0). A genuine
    // short-circuit 'and' -- one whose later operand could trap when an earlier one is false,
    // such as line_end_excluding_break's '!is_line_break(source[index])' guarded by 'index <
    // length' -- lowers as a chain of operand blocks: the first operand fills cond_insts (the
    // loop head), the second fills cond_rhs_insts (a guarded loopN_head_rhs block), and any
    // further operands fill cond_extra_operands, so the guarded byte load only runs when its
    // guard holds. An 'or' header is rejected so the restricted loop support never silently
    // reorders a guarded read (issue 1165 / 1162).
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind == 2 {
        return error("compiled mir: while condition or is not supported");
    }
    // A continue-latch loop carries its increment inside a body 'if <cond> { <induction> =
    // <induction> + <step>; continue; }' rather than in a trailing assign, so it has no trailing
    // latch statement and the existing trailing-increment machinery does not apply. It lowers
    // through a dedicated path (line_comment_has_blank_after, issue 1165 / 1162).
    if try while_is_continue_latch(ir_bytes, function_name, statement, bs) {
        return try lower_multi_while_continue_latch(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            temp_counter,
            loop_index,
            stmts,
            bs
        );
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let induction_var = try while_induction_var(ir_bytes, function_name, statement, bs);
    // loop_index is this while's top-level statement index, so the induction initializer
    // is the nearest preceding 'var <induction_var> = <init>'.
    let induction_init = try find_induction_init(
        ir_bytes, function_name, induction_var, loop_index, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_rhs_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_extra_operands = std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator());
    var cond_result = -1;
    var cond_rhs_result = -1;
    var mir_short_circuit = 0;
    var body_string_counter = string_counter;
    var body_temp_counter = temp_counter;
    if cond_kind == 1 and
        !(try while_and_condition_eager_safe(ir_bytes, function_name, cond_node, bs)) {
        // A genuine short-circuit 'and' chain: the leaf operands are evaluated left to
        // right, each guarded by every earlier operand. The first fills cond_insts, the
        // second fills cond_rhs_insts, and any further operands fill cond_extra_operands,
        // mirroring the short-circuit if-chain so the same operand-block renderer drives
        // both. A nested 'or' is left a leaf by flatten_and_operands and rejected here as a
        // near-miss explicit error rather than eager-evaluated (issue 1165 / 1162).
        mir_short_circuit = 1;
        var operands = std::array::Array<i64>(std::mem::page_allocator());
        try flatten_and_operands(ir_bytes, function_name, cond_node, &var operands, bs);
        var validate_index = 0;
        while validate_index < operands.len() {
            let operand_node = try operands.get(validate_index);
            if (try short_circuit_kind(ir_bytes, function_name, operand_node, bs)) != 0 {
                return error("compiled mir: nested short-circuit and/or unsupported");
            }
            validate_index = validate_index + 1;
        }
        let op0 = try operands.get(0);
        cond_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            op0,
            string_counter,
            temp_counter,
            &var cond_insts,
            bs
        );
        var acc_strings = try count_strings_in_insts(&cond_insts);
        var acc_temp = temp_counter + cond_insts.len();
        let op1 = try operands.get(1);
        cond_rhs_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            op1,
            string_counter + acc_strings,
            acc_temp,
            &var cond_rhs_insts,
            bs
        );
        acc_strings = acc_strings + try count_strings_in_insts(&cond_rhs_insts);
        acc_temp = acc_temp + cond_rhs_insts.len();
        var extra_index = 2;
        while extra_index < operands.len() {
            var operand_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let operand_node = try operands.get(extra_index);
            let operand_result = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                operand_node,
                string_counter + acc_strings,
                acc_temp,
                &var operand_insts,
                bs
            );
            acc_strings = acc_strings + try count_strings_in_insts(&operand_insts);
            acc_temp = acc_temp + operand_insts.len();
            try cond_extra_operands.append(
                compiled_mir::cond_operand(operand_result, operand_insts)
            );
            extra_index = extra_index + 1;
        }
        body_string_counter = string_counter + acc_strings;
        body_temp_counter = acc_temp;
        operands.deinit();
    } else {
        cond_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            cond_node,
            string_counter,
            temp_counter,
            &var cond_insts,
            bs
        );
        body_string_counter = string_counter + try count_strings_in_insts(&cond_insts);
        body_temp_counter = temp_counter + cond_insts.len();
    }
    var body_try_counter = loop_index * 1000;
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    // The body ends with a latch suffix: one statement (a constant-step 'index = index +
    // <int>' increment or a loop-carried 'index = try <callee>(.., index);' try-call), or a
    // run of constant-step increments when the loop advances several lockstep counters
    // ('left_index = left_index + 1; right_index = right_index + 1;'). The primary induction
    // is the last increment; earlier increments in the run become secondary inductions
    // rendered alongside it (issue 1165 / 1162).
    let latch_count = try while_trailing_increment_count(
        ir_bytes, function_name, body_node, body_count, bs
    );
    let body_boundary = body_count - latch_count;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                body_stmt,
                body_string_counter,
                body_temp_counter,
                body_try_counter,
                &var body_stmts,
                bs
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let body_if_index = loop_index * 1000 + body_index + 1;
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_if_index,
                    &var body_stmts,
                    bs
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
            } else {
                return error("compiled mir: unsupported while body statement");
            }
        }
        body_index = body_index + 1;
    }
    let increment_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let increment_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, increment_stmt, bs
    );
    if !std::mem::equal_bytes(increment_kind, "Assign") {
        return error("compiled mir: while body must end with the induction increment");
    }
    // The induction latch is either a constant-step 'index = index + <int>' increment or a
    // loop-carried 'index = try <callee>(.., index);' try-call update. The increment target
    // must name the induction variable in both shapes (issue 1165).
    let increment_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, increment_stmt, "target", 0, bs
    );
    let increment_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, increment_target, bs
    );
    if !std::mem::equal_bytes(increment_target_name, induction_var) {
        return error("compiled mir: induction increment must assign to the induction variable");
    }
    let increment_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, increment_stmt, "value", 0, bs
    );
    let increment_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, increment_value, bs
    );
    var step = 0;
    var latch_copy_var = "";
    var latch_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    if std::mem::equal_bytes(increment_value_kind, "TryExpr") {
        // 'index = try index_after_import(tokens, index);' advances the counter by a try-call
        // whose i64 success value feeds the loop-head phi (%<var>_next) and whose failure
        // propagates as this function's own error union. The latch try-call is given a try
        // index past the body try-calls (body_try_counter) and a call-arg setup prefix past
        // the body statement prefixes (loop_index * 1000 + body_count) so its SSA names never
        // collide with the body (issue 1165).
        let latch_stmt = try lower_while_latch_try_call(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            induction_var,
            increment_value,
            body_string_counter,
            body_try_counter,
            bs
        );
        try latch_stmts.append(latch_stmt);
    } else {
        if std::mem::equal_bytes(increment_value_kind, "Var") {
            // 'index = previous' copies a body-local back into the induction variable. The local
            // must be bound earlier in this loop body by 'let previous = index - <int>', a
            // decrement of the induction variable, so the loop counts down and terminates against
            // its 'index > 0' header. The local is kept in the body (it also feeds source[previous]),
            // so the latch carries no add: the loop-head phi reads %previous directly on the latch
            // edge (issue 1165 / 1162).
            latch_copy_var = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, increment_value, bs
            );
            try validate_copy_latch_source(
                ir_bytes, function_name, body_node, body_boundary, induction_var, latch_copy_var, bs
            );
        } else {
            step = try parse_induction_step(
                ir_bytes, function_name, increment_stmt, induction_var, bs
            );
        }
    }
    // The increments before the primary latch (body_boundary .. body_count - 2) are the
    // secondary lockstep counters. Each is a constant-step 'name = name + <int>' increment
    // with its own preceding 'var name = <init>' initializer, so it gets its own loop-head
    // phi and latch add (issue 1165 / 1162).
    var secondary_inductions =
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator());
    var secondary_index = body_boundary;
    while secondary_index < body_count - 1 {
        let secondary_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", secondary_index, bs
        );
        let secondary_target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, secondary_stmt, "target", 0, bs
        );
        let secondary_var = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, secondary_target, bs
        );
        let secondary_step = try parse_induction_step(
            ir_bytes, function_name, secondary_stmt, secondary_var, bs
        );
        let secondary_init = try find_induction_init(
            ir_bytes, function_name, secondary_var, loop_index, bs
        );
        try secondary_inductions.append(compiled_mir::secondary_induction(
            secondary_var,
            secondary_init.literal,
            secondary_init.var_name,
            secondary_init.offset,
            secondary_step
        ));
        secondary_index = secondary_index + 1;
    }
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_var,
        induction_init.literal,
        induction_init.var_name,
        induction_init.offset,
        step,
        cond_result,
        cond_insts,
        mir_short_circuit,
        cond_rhs_result,
        cond_rhs_insts,
        cond_extra_operands,
        body_stmts,
        latch_stmts,
        latch_copy_var,
        secondary_inductions,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        -1
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter
    };
}
// lower_multi_while_continue_latch lowers a continue-latch bounded loop -- one whose induction
// variable advances inside a body 'if <cond> { <induction> = <induction> + <step>; continue; }'
// rather than through a trailing increment assign. line_comment_has_blank_after is its first
// consumer (issue 1165 / 1162):
//   var cursor = line_end_including_break(source, comment_end);
//   while cursor < end {
//       if is_horizontal_space(source[cursor]) { cursor = cursor + 1; continue; }
//       return is_line_break(source[cursor]);
//   }
//   return false;
// The increment folds into the shared constant-step latch ('%cursor_next = add i64 %cursor, step'
// in loopN_latch), the continue-if's then-block becomes 'br label %loopN_latch', and the loop's
// non-continue tail (here 'return is_line_break(source[cursor])') falls through the if-continuation
// block, so the body already terminates and append_multi_while emits no trailing 'br' into the
// latch. The init is call-seeded: the preheader runs the 'line_end_including_break' call and the
// loop-head phi reads its result on the preheader edge. Only a single-comparison header is
// supported; a short-circuit header, a non-return body tail, or a non-call/-literal/-copy seed is
// an explicit error so a near-miss never silently mis-lowers.
fn lower_multi_while_continue_latch(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    loop_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: continue-latch loop header must be a single comparison");
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return error("compiled mir: continue-latch loop body must carry the continue-if and a return");
    }
    // The loop's non-continue path must terminate: its last body statement is the 'return' the
    // continue-if falls through to. Because it already terminates, append_multi_while emits no
    // trailing 'br' into the latch -- the only edge back to the head is the continue-if's branch.
    let last_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_body, bs);
    if !std::mem::equal_bytes(last_body_kind, "Return") {
        return error("compiled mir: continue-latch loop body must end with a return");
    }
    let induction_var = try while_continue_induction_var(ir_bytes, function_name, statement, bs);
    let increment_assign = try while_continue_increment_assign(ir_bytes, function_name, statement, bs);
    let step = try parse_induction_step(
        ir_bytes, function_name, increment_assign, induction_var, bs
    );
    // Resolve the 'var <induction> = <init>' seed. A call-seeded init lowers the call into
    // init_insts (rendered in the preheader, with the loop-head phi reading its result); a literal,
    // plain-copy, or base-plus-offset seed reuses find_induction_init's classification.
    let init_node = try find_induction_init_value_node(
        ir_bytes, function_name, induction_var, loop_index, bs
    );
    let init_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, init_node, bs);
    var induction_init = 0;
    var induction_init_var = "";
    var induction_init_offset = 0;
    var init_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var init_result_id = -1;
    var body_string_counter = string_counter;
    var body_temp_counter = temp_counter;
    if std::mem::equal_bytes(init_kind, "Call") {
        init_result_id = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            init_node,
            string_counter,
            temp_counter,
            &var init_insts,
            bs
        );
        body_string_counter = string_counter + try count_strings_in_insts(&init_insts);
        body_temp_counter = temp_counter + init_insts.len();
    } else {
        let resolved_init = try find_induction_init(
            ir_bytes, function_name, induction_var, loop_index, bs
        );
        induction_init = resolved_init.literal;
        induction_init_var = resolved_init.var_name;
        induction_init_offset = resolved_init.offset;
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        body_string_counter,
        body_temp_counter,
        &var cond_insts,
        bs
    );
    body_string_counter = body_string_counter + try count_strings_in_insts(&cond_insts);
    body_temp_counter = body_temp_counter + cond_insts.len();
    // Every body statement lowers; there is no trailing latch assign to strip. The continue-if
    // lowers to a ContinueLatch if, the trailing return to a return statement.
    var body_try_counter = loop_index * 1000;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_index = 0;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                body_stmt,
                body_string_counter,
                body_temp_counter,
                body_try_counter,
                &var body_stmts,
                bs
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let body_if_index = loop_index * 1000 + body_index + 1;
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_if_index,
                    &var body_stmts,
                    bs
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "Return") {
                    try body_stmts.append(try lower_multi_return_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        body_stmt,
                        body_string_counter,
                        body_temp_counter,
                        bs
                    ));
                } else {
                    return error("compiled mir: unsupported continue-latch body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_var,
        induction_init,
        induction_init_var,
        induction_init_offset,
        step,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        "",
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        init_insts,
        init_result_id
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter
    };
}

// lower_while_latch_try_call lowers a loop-carried 'index = try <callee>(.., index);' latch
// update into a LetTryCall statement bound to <induction_var>_next (issue 1165). The bound
// name feeds the loop-head phi on the latch edge, so the success value (field 1) becomes
// %<var>_next and a failure propagates as this function's own error union, exactly like a
// let-position try-call. The callee must be a free function (a field-mode method, e.g.
// tokens.get(..), is rejected here); index_after_leading_imports calling index_after_import
// is its first consumer. try_index is seeded past the body try-calls so the fail/cont block
// labels never collide with a body try-call's.
fn lower_while_latch_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    induction_var: []u8,
    try_node: i64,
    string_counter: i64,
    try_index: i64,
    bs: i64
) -> !compiled_mir::MirStmt {
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, try_node, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: induction latch try value must wrap a call");
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: induction latch try-call must be a free function");
    }
    let called_error_union = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, inner, bs
    );
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, inner, bs
    );
    if !std::mem::equal_bytes(success_type, "i64") {
        return error("compiled mir: induction latch try-call must return an i64");
    }
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, inner, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, inner, bs
    );
    let args = try compiled_mir_lower_call::lower_call_args(
        ir_bytes, function_name, module_prefix, locals_spec, inner, string_counter, bs
    );
    // The bound name is the induction variable itself; the latch renderer suffixes every SSA
    // name with "_next", so the success value binds to %<induction_var>_next which the
    // loop-head phi consumes on the latch edge (issue 1165).
    return compiled_mir::let_try_call_stmt(
        induction_var, called_error_union, success_type, llvm_return_type,
        callee_module_prefix, callee_name, string_counter, try_index, args
    );
}

fn count_strings_in_insts(
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !i64 {
    return try count_strings_in_insts_from(insts, 0);
}
fn count_strings_in_insts_from(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    start: i64
) -> !i64 {
    var count = 0;
    var index = start;
    while index < insts.len() {
        let inst = try insts.at(index);
        count = count + try count_strings_in_inst(inst);
        index = index + 1;
    }
    return count;
}
fn count_strings_in_inst(
    inst: &compiled_mir::MirExprInst
) -> !i64 {
    match inst {
        ConstString(payload) => return 1;,
        Call(payload) => return try compiled_mir_lower_call::count_string_args(&payload.call_args);,
        _ => return 0;,
    }
}

// call_has_call_arg reports whether any argument of a Call node is itself a Call.
// Inline call-arg descriptors cannot carry a computed call result, so such calls take
// the nested-argument expression path instead (issue 1165).
fn call_has_call_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
        if std::mem::equal_bytes(arg_kind, "Call") {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// arg_is_single_element_index reports whether a call argument is a single-element byte
// index load 'source[index]' (an IndexExpr whose 'end' bound is Empty), as distinct from a
// two-bound slice 'source[start..end]'. A single-element index has no inline MirCallArg
// descriptor -- the slice descriptor lower_call_index_arg builds assumes a real end bound --
// so such an argument is hoisted into a preceding index-load expr temp and passed by Temp
// reference instead. is_line_break(source[index]) inside line_end_excluding_break's
// short-circuit while header is its first consumer (issue 1165 / 1162).
fn arg_is_single_element_index(
    ir_bytes: []u8,
    function_name: []u8,
    arg_node: i64,
    bs: i64
) -> !bool {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if !std::mem::equal_bytes(arg_kind, "IndexExpr") {
        return false;
    }
    let end_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "end", 0, bs
    );
    let end_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, end_node, bs);
    return std::mem::equal_bytes(end_kind, "Empty");
}

// call_has_hoisted_arg reports whether a call carries an argument that has no inline
// MirCallArg descriptor and must be lowered into a preceding expr temp: a nested call, or a
// single-element byte index load. Both are referenced through a Temp call arg once
// materialized (issue 1165 / 1162).
fn call_has_hoisted_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
        if std::mem::equal_bytes(arg_kind, "Call") {
            return true;
        }
        if try arg_is_single_element_index(ir_bytes, function_name, arg_node, bs) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// lower_expr_array_len lowers a value-receiver 'tokens.len()' into an ArrayLen expr
// inst (issue 1165). The receiver is a std::array::Array<T> (or &Array<T>) param/local
// that lowers to the runtime-owned %kizu.owned handle, so the element type T does not
// affect the call. Only len() is supported in expression position; get() returns !T and
// is handled in let-try position. An unsupported method/receiver fails explicitly.
fn lower_expr_array_len(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64
) -> !i64 {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "len") {
        return error("compiled mir: only Array.len is supported on a value receiver in expression position");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 0 {
        return error("compiled mir: Array.len accessor takes no arguments");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: Array.len value receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type(
        ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs
    );
    let lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    if !is_array_field_type(lookup) {
        return error("compiled mir: Array.len receiver is not a std::array::Array");
    }
    let id = id_base + insts.len();
    try insts.append(compiled_mir::array_len_expr_inst(id, receiver_name));
    return id;
}

// lower_expr_call_with_nested_args lowers a Call whose argument list contains an argument
// with no inline descriptor -- a nested call (equal_bytes(token_text(...), expected)) or a
// single-element byte index load (is_line_break(source[index])) (issue 1165 / 1162). Each
// such argument is lowered into a preceding expr temp (a call inst, or a checked index-load
// inst) and referenced through a Temp call arg; scalar and two-bound-slice arguments use the
// shared single-arg descriptor. The outer call inst is appended once every argument temp is
// materialized so the temps dominate the call.
fn lower_expr_call_with_nested_args(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64
) -> !i64 {
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, bs
    );
    let call_type = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let lowered_callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, bs
        );
        let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
        let arg_type = try compiled_mir_types::lower_call_arg_type(
            ir_bytes, module_prefix, callee_name, arg_index
        );
        let hoist_arg = std::mem::equal_bytes(arg_kind, "Call") or
            (try arg_is_single_element_index(ir_bytes, function_name, arg_node, bs));
        if hoist_arg {
            let before = insts.len();
            let temp_id = try lower_expr_into(
                ir_bytes, function_name, module_prefix, params_spec, arg_node,
                string_idx, id_base, insts, bs
            );
            string_idx = string_idx + try count_strings_in_insts_from(insts, before);
            try args.append(compiled_mir::temp_call_arg(arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg(
                ir_bytes, function_name, module_prefix, params_spec, arg_type,
                arg_node, string_idx, bs
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    let id = id_base + insts.len();
    try insts.append(compiled_mir::call_expr_inst(
        id, call_type, callee_module_prefix, lowered_callee_name, args
    ));
    return id;
}

fn lower_expr_into(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr_node, bs);
    let id = id_base + insts.len();
    if std::mem::equal_bytes(kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        let var_type = try compiled_mir_types::resolve_value_llvm_type(
            ir_bytes, function_name, module_prefix, params_spec, var_name, bs
        );
        try insts.append(compiled_mir::var_expr_inst(id, var_type, var_name));
        return id;
    }
    if std::mem::equal_bytes(kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        try insts.append(compiled_mir::bool_expr_inst(
            id,
            std::mem::equal_bytes(token, "true")
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Int") {
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        try insts.append(compiled_mir::int_expr_inst(id, int_value));
        return id;
    }
    if std::mem::equal_bytes(kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid expression string token"
        );
        try insts.append(compiled_mir::string_expr_inst(
            id,
            token,
            string_index
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Prefix") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, expr_node, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, bs
        );
        if std::mem::equal_bytes(op, "neg") {
            let right_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, right_node, bs
            );
            if !std::mem::equal_bytes(right_kind, "Int") {
                return error("compiled mir: unsupported neg operand");
            }
            let int_value = try ir_contract::body_int_value_from(
                ir_bytes, function_name, right_node, bs
            );
            try insts.append(compiled_mir::int_expr_inst(id, 0 - int_value));
            return id;
        }
        if !std::mem::equal_bytes(op, "not") {
            return error("compiled mir: unsupported prefix op");
        }
        let operand = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            right_node,
            string_index,
            id_base,
            insts,
            bs
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::prefix_not_expr_inst(result_id, operand));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, expr_node, bs
        );
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "left", 0, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, bs
        );
        let before_left = insts.len();
        let left = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, left_node,
            string_index, id_base, insts, bs
        );
        let right_string_index = string_index + try count_strings_in_insts_from(insts, before_left);
        let right = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, right_node,
            right_string_index, id_base, insts, bs
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::binary_expr_inst(result_id, op, left, right));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "type", 0, bs
        );
        let type_text = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, bs
        );
        let target_llvm = try compiled_type_lower::kizu_type_to_llvm(
            ir_bytes, module_prefix, type_text
        );
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value_node, bs
        );
        if !std::mem::equal_bytes(value_kind, "Int") {
            return error("compiled mir: unsupported cast operand");
        }
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes, function_name, value_node, bs
        );
        try insts.append(compiled_mir::typed_int_expr_inst(id, int_value, target_llvm));
        return id;
    }
    if std::mem::equal_bytes(kind, "FieldExpr") {
        return try lower_expr_field(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            expr_node,
            id_base,
            insts,
            bs
        );
    }
    if std::mem::equal_bytes(kind, "IndexExpr") {
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "end", 0, bs
        );
        let end_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, end_node, bs
        );
        let target_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "target", 0, bs
        );
        let index_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "start", 0, bs
        );
        if !std::mem::equal_bytes(end_kind, "Empty") {
            let target_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                target_node,
                string_index,
                id_base,
                insts,
                bs
            );
            let start_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                index_node,
                string_index,
                id_base,
                insts,
                bs
            );
            let end_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                end_node,
                string_index,
                id_base,
                insts,
                bs
            );
            let result_id = id_base + insts.len();
            try insts.append(compiled_mir::slice_expr_inst(
                result_id, target_id, start_id, end_id
            ));
            return result_id;
        }
        let target_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, target_node, bs
        );
        if !std::mem::equal_bytes(target_kind, "Var") {
            return error("compiled mir: index target must be a var");
        }
        let target_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, target_node, bs
        );
        let index_id = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            index_node,
            string_index,
            id_base,
            insts,
            bs
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::index_load_expr_inst(
            result_id, target_name, index_id
        ));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "Call") {
        // A field-mode method call on a value receiver (tokens.len()) reads a
        // std::array::Array<T> param/local; len() lowers to the array_len builtin
        // directly off the %kizu.owned handle (issue 1165). get() returns !T and only
        // appears in let-try position, so it is rejected here.
        if try callee_is_field_expr(ir_bytes, function_name, expr_node, bs) {
            return try lower_expr_array_len(
                ir_bytes, function_name, module_prefix, params_spec, expr_node, id_base, insts, bs
            );
        }
        // A call whose argument list contains a nested call (equal_bytes(token_text(...),
        // expected)) or a single-element byte index load (is_line_break(source[index])) lowers
        // each such argument into a preceding expr temp and references it through a Temp call
        // arg, since inline call-arg descriptors cannot carry a computed call result or a
        // checked byte load (issue 1165 / 1162).
        if try call_has_hoisted_arg(ir_bytes, function_name, expr_node, bs) {
            return try lower_expr_call_with_nested_args(
                ir_bytes, function_name, module_prefix, params_spec, expr_node,
                string_index, id_base, insts, bs
            );
        }
        let call_type = try compiled_mir_types::lower_call_return_type(
            ir_bytes, function_name, module_prefix, expr_node, bs
        );
        let lowered_callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, expr_node, bs
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, expr_node, bs
        );
        let args = try compiled_mir_lower_call::lower_call_args(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, string_index, bs
        );
        try insts.append(compiled_mir::call_expr_inst(
            id,
            call_type,
            callee_module_prefix,
            lowered_callee_name,
            args
        ));
        return id;
    }
    return error("compiled mir: unsupported expression kind");
}

fn lower_expr_field(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64
) -> !i64 {
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, bs
    );
    if std::mem::equal_bytes(mode, "namespace") {
        let id = id_base + insts.len();
        let variant_name = try ir_contract::body_field_expr_name_from(
            ir_bytes,
            function_name,
            expr_node,
            "namespace",
            bs
        );
        let receiver = try ir_contract::body_child_sequence_from(
            ir_bytes,
            function_name,
            expr_node,
            "receiver",
            0,
            bs
        );
        let receiver_token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            receiver,
            bs
        );
        let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix(
            ir_bytes,
            module_prefix,
            receiver_token,
            variant_name
        );
        try insts.append(compiled_mir::enum_tag_expr_inst(id, tag));
        return id;
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, expr_node, "field", bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, bs
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            receiver,
            bs
        );
        let field = try compiled_mir_types::resolve_field_expr(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
        );
        let id = id_base + insts.len();
        try insts.append(compiled_mir::field_access_expr_inst(
            id,
            field.field_llvm_type,
            receiver_name,
            field.receiver_llvm_type,
            field.field_index
        ));
        return id;
    }
    if !std::mem::equal_bytes(receiver_kind, "FieldExpr") and
        !std::mem::equal_bytes(receiver_kind, "Call") {
        return error("compiled mir: unsupported field expr receiver");
    }
    let receiver_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        receiver,
        0,
        id_base,
        insts,
        bs
    );
    let field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
    );
    let id = id_base + insts.len();
    try insts.append(compiled_mir::field_access_temp_expr_inst(
        id,
        field.field_llvm_type,
        receiver_id,
        field.receiver_llvm_type,
        field.field_index
    ));
    return id;
}
