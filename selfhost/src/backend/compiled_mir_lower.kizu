    );
}

fn carried_scalar_alias_name(source_name: []u8, loop_index: i64, slot: i64) -> ![]u8 {
    if slot == 0 {
        return "carried.scalar.0";
    }
    if slot == 1 {
        return "carried.scalar.1";
    }
    if slot == 2 {
        return "carried.scalar.2";
    }
    if slot == 3 {
        return "carried.scalar.3";
    }
    if slot == 4 {
        return "carried.scalar.4";
    }
    if slot == 5 {
        return "carried.scalar.5";
    }
    if slot == 6 {
        return "carried.scalar.6";
    }
    if slot == 7 {
        return "carried.scalar.7";
    }
    if slot == 8 {
        return "carried.scalar.8";
    }
    if slot == 9 {
        return "carried.scalar.9";
    }
    return error("compiled mir: too many carried scalar assignments");
}

fn carried_scalar_index(
    states: &std::array::Array<CarriedScalarState>,
    source_name: []u8
) -> !i64 {
    var index = 0;
    while index < states.len() {
        let state = try states.at(index);
        if std::mem::equal_bytes(state.source_name, source_name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn rename_carried_scalars_in_insts(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    states: &std::array::Array<CarriedScalarState>
) -> !void {
    var index = 0;
    while index < states.len() {
        let state = try states.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try rename_induction_in_insts(insts, state.source_name, state.current_name);
        }
        index = index + 1;
    }
    return;
}

fn lower_expr_with_carried_renames(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    states: &std::array::Array<CarriedScalarState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        node,
        string_counter,
        temp_counter,
        insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    try rename_carried_scalars_in_insts(insts, states);
    return result;
}

fn scalar_assign_target_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    bs: i64
) -> ![]u8 {
    let assign_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, assign_node, bs);
    if !std::mem::equal_bytes(assign_kind, "Assign") {
        return "";
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return "";
    }
    let target_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    if try assign_is_self_scalar_arith(ir_bytes, function_name, assign_node, target_name, bs) {
        return target_name;
    }
    return "";
}

fn assign_is_self_scalar_arith(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    var_name: []u8,
    bs: i64
) -> !bool {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") and !std::mem::equal_bytes(op, "sub") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return false;
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_name, var_name) {
        return false;
    }
    let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
    return offset >= 1;
}

fn if_scalar_assign_node_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !i64 {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count == 1 {
        let only_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_node, "statement", 0, bs
        );
        let target = try scalar_assign_target_or_empty(ir_bytes, function_name, only_stmt, bs);
        if std::mem::len(target) > 0 {
            return only_stmt;
        }
    }
    if then_count == 2 {
        let second_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_node, "statement", 1, bs
        );
        let target = try scalar_assign_target_or_empty(ir_bytes, function_name, second_stmt, bs);
        if std::mem::len(target) > 0 {
            return second_stmt;
        }
    }
    return -1;
}

fn while_carries_scalar_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var body_index = 0;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "If") {
            let assign_node = try if_scalar_assign_node_or_minus_one(
                ir_bytes, function_name, body_stmt, bs
            );
            if assign_node >= 0 {
                let target = try scalar_assign_target_or_empty(
                    ir_bytes, function_name, assign_node, bs
                );
                if std::mem::equal_bytes(target, name) {
                    return true;
                }
            }
        }
        body_index = body_index + 1;
    }
    return false;
}

fn lower_field_array_append_try_call_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    receiver_node: i64,
    arg_node: i64,
    string_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver_node, bs
    );
    let root = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, receiver_node, "receiver", 0, receiver_sf
    );
    let root_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, root, bs);
    let root_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, root, root_sf);
    if !std::mem::equal_bytes(root_kind, "Var") {
        return error("compiled mir: array append field receiver must start with Var");
    }
    let root_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, root, root_sf
    );
    let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec, receiver_node, bs,
        call_arg_type_cache
    );
    let element_kizu = compiled_mir_types::array_value_element_kizu_type_or_empty(
        compiled_mir_types::struct_lookup_kizu_type(field.field_kizu_type)
    );
    if std::mem::len(element_kizu) == 0 {
        return error("compiled mir: append receiver field is not a std::array::Array");
    }
    let element_llvm = try compiled_mir_types::kizu_type_to_llvm_indexed_cached(
        ir_lookup_index, ir_bytes, module_prefix, element_kizu, call_arg_type_cache
    );
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    let consumed_string = try lower_string_method_arg(
        ir_bytes, function_name, module_prefix, element_llvm,
        arg_node, string_counter, aliases, &var args, bs, ir_lookup_index, call_arg_type_cache
    );
    try stmts.append(compiled_mir::array_field_try_append_stmt(
        try local_alias_current_name(aliases, root_name),
        field.receiver_llvm_type,
        field.field_index,
        element_llvm,
        llvm_return_type,
        string_counter,
        try_counter,
        args
    ));
    return MultiExprLowerResult {
        string_counter: string_counter + consumed_string,
        try_counter: try_counter + 1
    };
}

// lower_multi_expr_statement lowers side-effecting expression statements. Try-call statements keep
// the existing error-propagating paths for String append methods and free-function '!void' calls.
// Non-try calls are accepted only for the validated owned-handle destructor shape
// '<local-or-param>.deinit();': the receiver type must resolve to a supported runtime-owned
// resource and its LLVM representation must be %kizu.owned before the cleanup call is emitted.
fn lower_multi_expr_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    // sf tightens this expression statement's own structural facts (its expr/try/call subtree:
    // kinds, callee field-expr, receiver/arg edges and tokens) to its body-node line via the
    // index; the subtree sorts at-or-after it, so a scan from sf is byte-identical to one from bs.
    // The statement-lowering recursion (owned-deinit / free-try-call / array-append / string-arg /
    // method-try-call) and receiver type resolution keep bs because they read facts that can
    // precede this node.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, sf
    );
    let expr_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr, sf);
    if std::mem::equal_bytes(expr_kind, "Call") {
        return try lower_owned_deinit_expr_statement(
            ir_bytes, function_name, module_prefix, locals_spec, expr,
            string_counter, try_counter, aliases, stmts, bs
        );
    }
    if !std::mem::equal_bytes(expr_kind, "TryExpr") {
        return error("compiled mir: unsupported expression statement");
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, sf
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, sf);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: try expression statement must wrap a call");
    }
    if !try callee_is_field_expr(ir_bytes, function_name, inner, sf) {
        return try lower_void_free_try_call_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            inner, string_counter, try_counter, aliases, stmts, bs, ir_lookup_index, call_arg_type_cache
        );
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "callee", 0, sf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", sf
    );
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, sf
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, sf
    );
    let arg_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "arg", 0, sf
    );
    if std::mem::equal_bytes(method_name, "append") and
        std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return try lower_field_array_append_try_call_statement(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            receiver_node,
            arg_node,
            string_counter,
            try_counter,
            aliases,
            stmts,
            bs,
            ir_lookup_index,
            call_arg_type_cache
        );
    }
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: string method receiver must be a local");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var consumed_string = 0;
    // 'try <receiver>.set(<index>, <value>);' on a std::array::Array<T> receiver
    // lowers through the element-size-generic @kizu_rt_array_set ABI: the index is
    // a plain i64 argument, the receiver's declared Array<T> type supplies the
    // element LLVM type, and both arguments lower through the shared method-arg path.
    if std::mem::equal_bytes(method_name, "set") {
        let set_receiver_kizu = try compiled_mir_types::resolve_receiver_value_kizu_type_indexed(
            ir_lookup_index, ir_bytes, function_name, module_prefix, receiver_name, bs
        );
        let set_element_kizu = compiled_mir_types::array_value_element_kizu_type_or_empty(
            array_receiver_lookup_kizu_type(set_receiver_kizu)
        );
        if std::mem::len(set_element_kizu) == 0 {
            return error("compiled mir: set receiver is not a std::array::Array");
        }
        let set_element_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, module_prefix, set_element_kizu
        );
        let consumed_index = try lower_string_method_arg(
            ir_bytes, function_name, module_prefix, "i64",
            arg_node, string_counter, aliases, &var args, bs, ir_lookup_index, call_arg_type_cache
        );
        let set_value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, inner, "arg", 1, bs
        );
        let set_value_string_counter = string_counter + consumed_index;
        let consumed_value = try lower_string_method_arg(
            ir_bytes, function_name, module_prefix, set_element_llvm,
            set_value_node, set_value_string_counter, aliases, &var args, bs,
            ir_lookup_index, call_arg_type_cache
        );
        consumed_string = consumed_index + consumed_value;
        try stmts.append(compiled_mir::array_try_set_stmt(
            receiver_alias, set_element_llvm, llvm_return_type,
            string_counter, try_counter, args
        ));
    } else {
    // 'try <receiver>.append(<value>);' on a std::array::Array<T> receiver lowers
    // through the element-size-generic @kizu_rt_array_append ABI: the receiver's
    // declared Array<T> type supplies the element LLVM type and the single value
    // argument lowers through the shared method-arg path.
    if std::mem::equal_bytes(method_name, "append") {
        let receiver_kizu = try compiled_mir_types::resolve_receiver_value_kizu_type_indexed(
            ir_lookup_index, ir_bytes, function_name, module_prefix, receiver_name, bs
        );
        let element_kizu = compiled_mir_types::array_value_element_kizu_type_or_empty(
            array_receiver_lookup_kizu_type(receiver_kizu)
        );
        if std::mem::len(element_kizu) == 0 {
            return error("compiled mir: append receiver is not a std::array::Array");
        }
        let element_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, module_prefix, element_kizu
        );
        consumed_string = try lower_string_method_arg(
            ir_bytes, function_name, module_prefix, element_llvm,
            arg_node, string_counter, aliases, &var args, bs, ir_lookup_index, call_arg_type_cache
        );
        try stmts.append(compiled_mir::array_try_append_stmt(
            receiver_alias, element_llvm, llvm_return_type,
            string_counter, try_counter, args
        ));
    } else {
    if std::mem::equal_bytes(method_name, "append_bytes") {
        consumed_string = try lower_string_method_arg(
            ir_bytes, function_name, module_prefix, "%kizu.slice.u8",
            arg_node, string_counter, aliases, &var args, bs, ir_lookup_index, call_arg_type_cache
        );
        try stmts.append(compiled_mir::string_try_append_stmt(
            receiver_alias, "kizu_rt_string_append_bytes", llvm_return_type,
            string_counter, try_counter, args
        ));
    } else {
        if std::mem::equal_bytes(method_name, "append_byte") {
            consumed_string = try lower_string_method_arg(
                ir_bytes, function_name, module_prefix, "i8",
                arg_node, string_counter, aliases, &var args, bs, ir_lookup_index,
                call_arg_type_cache
            );
            try stmts.append(compiled_mir::string_try_append_stmt(
                receiver_alias, "kizu_rt_string_append_byte", llvm_return_type,
                string_counter, try_counter, args
            ));
        } else {
            return try lower_void_method_try_call_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                inner,
                string_counter,
                temp_counter,
                try_counter,
                aliases,
                stmts,
                bs,
                ir_lookup_index,
                call_arg_type_cache
            );
        }
    }
    }
    }
    return MultiExprLowerResult {
        string_counter: string_counter + consumed_string,
        try_counter: try_counter + 1
    };
}

// array_receiver_lookup_kizu_type strips the borrow markers from a receiver type
// spelling ('&var std::array::Array<T>' arrives as '&var_std::array::Array<T>') so
// the Array<T> element extraction sees the bare container type.
fn array_receiver_lookup_kizu_type(kizu_type: []u8) -> []u8 {
    let stripped = compiled_mir_types::struct_lookup_kizu_type(kizu_type);
    if std::mem::starts_with(stripped, "var_") {
        return stripped[4..std::mem::len(stripped)];
    }
    return stripped;
}

fn owned_deinit_receiver_type_supported(kizu_type: []u8) -> bool {
    if std::mem::starts_with(kizu_type, "std::array::Array<") {
        return true;
    }
    return false;
}

// lower_owned_deinit_expr_statement lowers a non-try '<receiver>.deinit();' expression statement.
// This is the owned-resource cleanup twin of the try-call expression-statement paths: it validates
// the AST method shape and receiver type, then emits a side-effect-only MIR statement with no value
// binding and no error propagation.
fn lower_owned_deinit_expr_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64
) -> !MultiExprLowerResult {
    if !try callee_is_field_expr(ir_bytes, function_name, call_node, bs) {
        return error("compiled mir: non-try expression statement must be a method call");
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "deinit") {
        return error("compiled mir: unsupported non-try method statement");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 0 {
        return error("compiled mir: deinit expression statement takes no arguments");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: deinit receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type(
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs
    );
    if !owned_deinit_receiver_type_supported(receiver_kizu) {
        return error("compiled mir: deinit receiver is not a supported owned resource");
    }
    let receiver_llvm = try compiled_mir_types::resolve_value_llvm_type(
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs
    );
    if !std::mem::equal_bytes(receiver_llvm, "%kizu.owned") {
        return error("compiled mir: deinit receiver must lower to %kizu.owned");
    }
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    try stmts.append(compiled_mir::owned_deinit_stmt(receiver_alias));
    return MultiExprLowerResult {
        string_counter: string_counter,
        try_counter: try_counter
    };
}

// lower_void_free_try_call_statement lowers a bare 'try <callee>(<args>);' statement whose
// callee is a free function (not a field method) returning an error-union void success (issue
// 1201). The shape is ExprStmt(TryExpr(Call(...))) reached after lower_multi_expr_statement
// rejects the field-method form, e.g.
// 'try append_sorted_imports(out, source, &format_tokens, &leading_imports);'. It validates the
// callee returns '!void' (an error union whose success type lowers to void), resolves the callee
// symbol + args the same way lower_multi_let_try_call does, and emits a VoidTryCall statement that
// propagates a runtime failure as this function's own error union and binds no value -- mirroring
// LetTryCall's failure propagation without a bound success value (no fake local). try_counter
// advances so the try-call gets a distinct block-label pair.
fn lower_void_free_try_call_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, call_node, bs, ir_lookup_index
    );
    if !std::mem::equal_bytes(success_type, "void") {
        return error("compiled mir: void try-call statement callee must return an error-union void");
    }
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, aliases, bs,
        ir_lookup_index, call_arg_type_cache
    );
    let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
    try stmts.append(compiled_mir::void_try_call_stmt(
        llvm_return_type, callee_module_prefix, callee_name,
        string_counter, try_counter, args
    ));
    return MultiExprLowerResult {
        string_counter: new_counter,
        try_counter: try_counter + 1
    };
}

// hoisted_try_arg_name builds the durable SSA name a hoisted 'try <call>' method-call argument
// binds its unwrapped success into ('__try_arg<slot>', issue 1157 NEW-A). The 'try
// ast.add_child(try declarations.get(index));' child-drain shape -- pervasive across parse_program /
// parse_struct_decl / parse_call_with_args -- carries an inner 'try <call>' argument with no inline
// MirCallArg descriptor, so it lowers into a preceding LetArrayGet/LetTryCall binding referenced by
// a Var call arg. slot is the inner try-call's try index, unique per function, so the synthesized
// names never collide. A direct String.as_bytes() view cannot escape into the MIR, so the name is
// copied through a Map insertion (the same byte-copy boundary grammar_branch_carried_name uses).
fn hoisted_try_arg_name(slot: i64) -> ![]u8 {
    var out = std::string::String(std::mem::page_allocator());
    try out.append_bytes("__try_arg");
    try std::fmt::append_i64(&var out, slot);
    let name = out.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(name, name);
    return try copied.get(name);
}

fn lower_void_method_try_call_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, bs,
        ir_lookup_index, call_arg_type_cache
    );
    if !std::mem::equal_bytes(info.return_llvm_type, "%kizu.error.void") {
        return error("compiled mir: method try-call statement must return !void");
    }
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, info.module_prefix, info.callee_name, explicit_arg_count + 1,
        ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::var_call_arg(
        try arg_types.get(0), try local_alias_current_name(aliases, info.receiver_name)
    ));
    // A 'try <call>' method argument (e.g. 'try ast.add_child(try declarations.get(index));', the
    // child-drain loop body shared by parse_program / parse_struct_decl / parse_call_with_args) has
    // no inline call-arg descriptor: its inner try-call propagates a failure of its own. Lower each
    // such argument into a preceding LetArrayGet/LetTryCall statement that binds the unwrapped
    // success into a synthesized %__try_arg<slot> local, then pass that local by Var. The hoisted
    // let consumes the inner try index; the void call takes the next try index so their fail/cont
    // block labels never collide.
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    var cur_locals = locals_spec;
    var arg_index = 0;
    while arg_index < explicit_arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, cf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index + 1);
        let arg_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arg_node, arg_sf
        );
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            let inner = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arg_node, "value", 0, arg_sf
            );
            let inner_sf = compiled_mir_types::fn_node_line_start(
                call_arg_type_cache, inner, bs
            );
            let inner_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, inner, inner_sf
            );
            if !std::mem::equal_bytes(inner_kind, "Call") {
                return error("compiled mir: method try-call statement try arg must wrap a call");
            }
            let hoist_name = try hoisted_try_arg_name(cur_try);
            var hoist_result = MultiLowerResult {
                locals_spec: cur_locals,
                string_counter: cur_string,
                temp_counter: cur_temp,
                try_counter: cur_try
            };
            if try callee_is_field_expr(ir_bytes, function_name, inner, inner_sf) {
                hoist_result = try lower_multi_let_array_get(
                    ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                    hoist_name, inner, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                    ir_lookup_index, call_arg_type_cache
                );
            } else {
                hoist_result = try lower_multi_let_try_call(
                    ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                    hoist_name, inner, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                    ir_lookup_index, call_arg_type_cache
                );
            }
            cur_locals = hoist_result.locals_spec;
            cur_string = hoist_result.string_counter;
            cur_temp = hoist_result.temp_counter;
            cur_try = hoist_result.try_counter;
            try args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
        } else {
            if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
                // A bare Call argument returns a non-error-union value and has no inline call-arg
                // descriptor, so hoist it ahead of the statement into 'let __try_arg<slot> = <call>;'
                // and pass the bound local by Var (the non-try mirror of the TryExpr branch above).
                // The hoist consumes one synthesized slot; advancing cur_try keeps its name distinct
                // from later hoists and from the trailing void call's try index. Other must-hoist
                // kinds (struct literal, namespace field, single-element index) stay inline-required.
                if !std::mem::equal_bytes(arg_kind, "Call") {
                    return error("compiled mir: method try-call statement arg must be inline");
                }
                let hoist_name = try hoisted_try_arg_name(cur_try);
                let hoist_result = try lower_multi_let_call(
                    ir_bytes, function_name, module_prefix, cur_locals,
                    hoist_name, arg_node, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                    ir_lookup_index, call_arg_type_cache
                );
                cur_locals = hoist_result.locals_spec;
                cur_string = hoist_result.string_counter;
                cur_temp = hoist_result.temp_counter;
                cur_try = hoist_result.try_counter + 1;
                try args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
            } else {
                let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_with_aliases_cached(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_type,
                    arg_node,
                    cur_string,
                    &alias_sources,
                    &alias_currents,
                    bs,
                    ir_lookup_index,
                    call_arg_type_cache
                );
                if scalar_arg.kind == compiled_mir::MirCallArgKind::String {
                    cur_string = cur_string + 1;
                }
                try args.append(scalar_arg);
            }
        }
        arg_index = arg_index + 1;
    }
    try stmts.append(compiled_mir::void_try_call_stmt(
        llvm_return_type, info.module_prefix, info.callee_name,
        cur_string, cur_try, args
    ));
    return MultiExprLowerResult {
        string_counter: cur_string,
        try_counter: cur_try + 1
    };
}

// lower_string_method_arg lowers the single argument of a String append method into the call
// argument array, returning the number of string-literal global slots it consumed (issue 1165
// slice 1). A local argument resolves to a Var call arg of the method's fixed LLVM type, a
// string literal resolves to a String call arg seeded at string_index, and a scalar cast over an
// integer literal resolves to an IntLiteral only after the cast target lowers to the method's
// expected LLVM argument type.
fn lower_string_method_arg(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    arg_type: []u8,
    arg_node: i64,
    string_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    args: &var std::array::Array<compiled_mir::MirCallArg>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, sf);
    if std::mem::equal_bytes(arg_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, sf
        );
        try args.append(compiled_mir::var_call_arg(
            arg_type, try local_alias_current_name(aliases, var_name)
        ));
        return 0;
    }
    if std::mem::equal_bytes(arg_kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, sf
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid call string token"
        );
        try args.append(compiled_mir::string_call_arg(arg_type, token, string_index));
        return 1;
    }
    if std::mem::equal_bytes(arg_kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arg_node, "type", 0, sf
        );
        let type_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, type_node, bs
        );
        let type_text = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, type_sf
        );
        let target_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index, ir_bytes, module_prefix, type_text
        );
        if !std::mem::equal_bytes(target_llvm, arg_type) {
            return error("compiled mir: string method cast argument type mismatch");
        }
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arg_node, "value", 0, sf
        );
        let value_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, value_node, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value_node, value_sf
        );
        if !std::mem::equal_bytes(value_kind, "Int") {
            return error("compiled mir: unsupported string method cast operand");
        }
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, value_node, value_sf
        );
        try args.append(compiled_mir::int_literal_call_arg(arg_type, literal));
        return 0;
    }
    if std::mem::equal_bytes(arg_kind, "FieldExpr") {
        // A struct-field read argument (e.g. 'code.append(right_eval.next)') reuses the
        // shared call-arg field lowering; it consumes no string slot. It resolves through the
        // local aliases so a receiver reassigned by a branch merge ('methods.append(method.node)'
        // after 'method' is reseated in an if/else) reads the merged value, not the let-init.
        try args.append(try lower_single_call_arg_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, "", arg_type, arg_node,
            string_index, aliases, bs, ir_lookup_index, call_arg_type_cache
        ));
        return 0;
    }
    if std::mem::equal_bytes(arg_kind, "Call") {
        // A nested call argument (e.g. 'tags.append(name_node_with_doc(ast, tag, ...))')
        // reuses the shared call-arg lowering, which emits a nested call descriptor whose
        // own operands are non-literal here, so it consumes no string slot. Its operands resolve
        // through the local aliases for the same branch-merge reason as the field-read arg above.
        try args.append(try lower_single_call_arg_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, "", arg_type, arg_node,
            string_index, aliases, bs, ir_lookup_index, call_arg_type_cache
        ));
        return 0;
    }
    // A bare integer literal argument (e.g. 'args_scratch.append(0)' growing the
    // call-arg scratch stack, or a slot-0 stack-pointer read/write index) lowers
    // to an inline literal; it consumes no string slot.
    if std::mem::equal_bytes(arg_kind, "Int") {
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, arg_node, sf
        );
        try args.append(compiled_mir::int_literal_call_arg(arg_type, literal));
        return 0;
    }
    return error("compiled mir: unsupported string method argument");
}
// lower_multi_let_statement lowers a 'let'/'var' binding. It resolves the binding's emitted SSA
// name first: a name bound more than once in the function is shadowed, so it takes a
// per-binding-unique '<source>.shadow.<node>' name and, after the value is lowered, redirects
// later reads of the source name through the local-alias map (the same indirection
// lower_multi_assign_statement uses). The alias is set *after* lower_multi_let_statement_named
// returns so a self-referential initializer ('let x = x + 1' shadowing an outer x) still reads
// the outer binding while its own value is lowered. Type resolution is unaffected: it resolves a
// name from the IR let-binding scan, not from the emitted SSA name.
fn lower_multi_let_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // sf tightens this Let statement's own structural facts (its 'name' edge / name token) to its
    // body-node line via the index; those facts sort at-or-after it, so a scan from sf is
    // byte-identical to one from bs. let_binding_is_shadowed scans for sibling bindings that can
    // precede this node, so it keeps bs, as does the named-lowering recursion below.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let let_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "name", 0, sf
    );
    let source_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, let_name_node, sf
    );
    let shadowed = try let_binding_is_shadowed(ir_bytes, function_name, source_name, bs);
    var emit_name = source_name;
    if shadowed {
        emit_name = try shadow_binding_name(source_name, statement);
    }
    let result = try lower_multi_let_statement_named(
        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, statement,
        emit_name, string_counter, temp_counter, try_counter, aliases, stmts, bs,
        ir_lookup_index, call_arg_type_cache
    );
    if shadowed {
        try set_local_alias(aliases, source_name, emit_name);
    }
    return result;
}

fn lower_multi_let_statement_named(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    let_name: []u8,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // sf tightens this Let statement's own structural facts (its 'value' subtree: kind/edges,
    // callee detail, arg edges) to its body-node line via the index; the whole subtree sorts
    // at-or-after it, so a scan from sf is byte-identical to one from bs. Type/name resolution
    // (method_call_info, ast_get_receiver_is_ast, struct-field/return-type resolvers) and the
    // expr/call lowering recursion keep bs because they read let/param facts that can precede
    // this node (the index-keyed return/struct-type resolvers tighten their own structural read).
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let let_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, sf
    );
    let let_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, let_value, sf);
    // A 'let <name> = try <callee>(<args>);' try-call over an error-union-returning free
    // function (the node_count traversal cluster, tracker 961). It lowers to a LetTryCall
    // statement: call the error union, branch on its ok flag, propagate the failure as this
    // function's own error union, and bind the success value.
    if std::mem::equal_bytes(let_value_kind, "TryExpr") {
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, let_value, "value", 0, sf
        );
        let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, sf);
        if !std::mem::equal_bytes(inner_kind, "Call") {
            return error("compiled mir: try let value must wrap a call");
        }
        // 'let next = try tokens.get(<expr>);' on a value-receiver Array<T> binds the
        // element by value off the checked array_at builtin and propagates a failure as
        // this function's own error union (issue 1165). The callee is a field-mode method,
        // so it is routed ahead of the free-function try-call path.
        if try callee_is_field_expr(ir_bytes, function_name, inner, sf) {
            return try lower_multi_let_array_get(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                let_name, inner, string_counter, temp_counter, try_counter, aliases, stmts,
                bs, ir_lookup_index, call_arg_type_cache
            );
        }
        return try lower_multi_let_try_call(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            let_name, inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(let_value_kind, "Call") {
        // A Call whose callee is a field-mode method is the checked Arena<T>.add
        // lowering (self.<field>.add(<struct literal>)), binding the appended slot
        // index. Ast.add_node is its first consumer (tracker 961). The element struct
        // consumes string_counter prefixes for its insertvalue chain, so the counter
        // advances by the element field count to keep later struct temps distinct.
        if try callee_is_field_expr(ir_bytes, function_name, let_value, sf) {
            // 'let node = ast.get(<node_id>);' binds an AstNode by value off the
            // compiled external std::kizu::ast accessor in any statement position
            // (the match-union shapes special-case statement 0; this serves the rest).
            if try call_method_name_is(ir_bytes, function_name, let_value, "get", sf) {
                if try ast_get_receiver_is_ast(
                    ir_bytes, function_name, module_prefix, locals_spec, let_value, bs
                ) {
                    return try lower_multi_let_ast_get(
                        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                        let_name, let_value, string_counter, temp_counter,
                        try_counter, aliases, stmts, bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                }
            }
            // 'let base = local_starts.len();' binds a value-receiver length read;
            // it lowers through the generic expression path (which already models
            // .len() on owned containers) as a let-expr statement.
            if try call_method_name_is(ir_bytes, function_name, let_value, "len", sf) {
                var len_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                let len_result_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    let_value,
                    string_counter,
                    temp_counter,
                    &var len_insts,
                    aliases,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                let len_inst_count = len_insts.len();
                let len_locals = try compiled_signature::extend_locals_spec(
                    ir_bytes, locals_spec, let_name, "i64"
                );
                try stmts.append(compiled_mir::let_expr_stmt(
                    let_name, string_counter, len_result_id, len_insts
                ));
                return MultiLowerResult {
                    locals_spec: len_locals,
                    string_counter: string_counter,
                    temp_counter: temp_counter + len_inst_count,
                    try_counter: try_counter
                };
            }
            // A value-receiver method with a real signature (for example
            // ast.add_bool(...)) lowers as a normal call expression with the receiver
            // passed as arg 0. Field receivers such as self.nodes.add(...) stay on the
            // Arena.add lowering below.
            if try call_method_receiver_is_var(ir_bytes, function_name, let_value, sf) {
                if try call_has_try_arg(ir_bytes, function_name, let_value, sf) {
                    let info = try method_call_info(
                        ir_bytes, function_name, module_prefix, locals_spec, let_value, bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                    var method_arg_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                    var method_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
                    let lowered = try lower_method_call_args_hoisting_try_args_with_local_aliases(
                        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                        let_value, string_counter, temp_counter, try_counter, aliases,
                        &var method_arg_insts, &var method_args, stmts, bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                    let new_locals = try compiled_signature::extend_locals_spec(
                        ir_bytes, lowered.locals_spec, let_name, info.return_llvm_type
                    );
                    if method_arg_insts.len() > 0 {
                        let result_id = lowered.temp_counter;
                        try method_arg_insts.append(compiled_mir::call_expr_inst(
                            result_id, info.return_llvm_type, info.module_prefix,
                            info.callee_name, method_args
                        ));
                        try stmts.append(compiled_mir::let_expr_stmt(
                            let_name, string_counter, result_id, method_arg_insts
                        ));
                        return MultiLowerResult {
                            locals_spec: new_locals,
                            string_counter: lowered.string_counter,
                            temp_counter: lowered.temp_counter + 1,
                            try_counter: lowered.try_counter
                        };
                    } else {
                        try stmts.append(compiled_mir::let_call_stmt(
                            let_name, info.return_llvm_type, lowered.string_counter,
                            info.module_prefix, info.callee_name, method_args
                        ));
                        return MultiLowerResult {
                            locals_spec: new_locals,
                            string_counter: lowered.string_counter,
                            temp_counter: lowered.temp_counter,
                            try_counter: lowered.try_counter
                        };
                    }
                }
                var method_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                let method_result_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    let_value,
                    string_counter,
                    temp_counter,
                    &var method_insts,
                    aliases,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                let method_strings = try count_strings_in_insts(&method_insts);
                let method_inst_count = method_insts.len();
                try stmts.append(compiled_mir::let_expr_stmt(
                    let_name, string_counter, method_result_id, method_insts
                ));
                return MultiLowerResult {
                    locals_spec: locals_spec,
                    string_counter: string_counter + method_strings,
                    temp_counter: temp_counter + method_inst_count,
                    try_counter: try_counter
                };
            }
            return try lower_multi_let_arena_add(
                ir_bytes, function_name, module_prefix, locals_spec,
                let_name, let_value, string_counter, temp_counter, try_counter, stmts, bs,
                ir_lookup_index, call_arg_type_cache
            );
        }
        // 'var code = std::array::Array<T>(<allocator>);' is a standalone runtime-owned
        // array constructor (the run pipeline entry seeds six scratch arrays this way). It
        // lowers to the element-size-generic @kizu_rt_array_new builtin (an ArrayNew stmt),
        // binding the owned handle and registering the Array<T> local so later borrows of it
        // resolve to %kizu.owned.
        let ctor_callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, let_value, sf
        );
        if std::mem::starts_with(ctor_callee, "std::array::Array<") {
            let ctor_len = std::mem::len(ctor_callee);
            if ctor_callee[ctor_len - 1] != cast<u8>(62) {
                return error("compiled mir: malformed array constructor type");
            }
            let prefix_len = std::mem::len("std::array::Array<");
            let element_kizu = ctor_callee[prefix_len..ctor_len - 1];
            let element_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
                ir_lookup_index,
                ir_bytes, module_prefix, element_kizu
            );
            let ctor_arg_count = try compiled_mir_types::count_call_args_cached(
                ir_bytes, function_name, let_value, sf, call_arg_type_cache
            );
            if ctor_arg_count != 1 {
                return error("compiled mir: array constructor takes exactly the allocator argument");
            }
            let alloc_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, let_value, "arg", 0, sf
            );
            let alloc_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, alloc_node, sf
            );
            let alloc_alias = try local_alias_current_name(aliases, alloc_name);
            let array_locals = try compiled_signature::extend_locals_spec(
                ir_bytes, locals_spec, let_name, ctor_callee
            );
            try stmts.append(compiled_mir::array_new_stmt(
                let_name, "%kizu.owned", alloc_alias, element_llvm
            ));
            return MultiLowerResult {
                locals_spec: array_locals,
                string_counter: string_counter,
                temp_counter: temp_counter,
                try_counter: try_counter
            };
        }
        // Some call arguments have no inline MirCallArg descriptor: nested calls,
        // struct literals, namespace field values, and checked single-element index loads.
        // Lower those calls through the generic expression path so each computed argument
        // is materialized into a temp first, mirroring return-statement handling.
        if try call_has_try_arg(ir_bytes, function_name, let_value, sf) {
            let call_type = try compiled_mir_types::lower_call_return_type_indexed(
                ir_lookup_index,
                ir_bytes, function_name, module_prefix, let_value, bs
            );
            let callee_name = try compiled_mir_types::lower_call_callee_name_indexed(
                ir_lookup_index, ir_bytes, function_name, module_prefix, let_value, sf
            );
            let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix_indexed(
                ir_lookup_index, ir_bytes, function_name, module_prefix, let_value, sf
            );
            var call_arg_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            var call_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
            let lowered = try lower_call_args_hoisting_try_args_with_local_aliases_cached(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                let_value, string_counter, temp_counter, try_counter, aliases,
                &var call_arg_insts, &var call_args, stmts, bs,
                ir_lookup_index, call_arg_type_cache
            );
            let new_locals = try compiled_signature::extend_locals_spec(
                ir_bytes, lowered.locals_spec, let_name, call_type
            );
            if call_arg_insts.len() > 0 {
                let result_id = lowered.temp_counter;
                try call_arg_insts.append(compiled_mir::call_expr_inst(
                    result_id, call_type, callee_module_prefix, callee_name, call_args
                ));
                try stmts.append(compiled_mir::let_expr_stmt(
                    let_name, string_counter, result_id, call_arg_insts
                ));
                return MultiLowerResult {
                    locals_spec: new_locals,
                    string_counter: lowered.string_counter,
                    temp_counter: lowered.temp_counter + 1,
                    try_counter: lowered.try_counter
                };
            } else {
                try stmts.append(compiled_mir::let_call_stmt(
                    let_name, call_type, lowered.string_counter,
                    callee_module_prefix, callee_name, call_args
                ));
                return MultiLowerResult {
                    locals_spec: new_locals,
                    string_counter: lowered.string_counter,
                    temp_counter: lowered.temp_counter,
                    try_counter: lowered.try_counter
                };
            }
        }
        if try call_has_hoisted_arg_cached(
            ir_bytes, function_name, let_value, bs, call_arg_type_cache
        ) {
            var nested_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let nested_result_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                let_value,
                string_counter,
                temp_counter,
                &var nested_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            let nested_strings = try count_strings_in_insts(&nested_insts);
            let nested_inst_count = nested_insts.len();
            let nested_call_type = try compiled_mir_types::lower_call_return_type_indexed(
                ir_lookup_index,
                ir_bytes, function_name, module_prefix, let_value, bs
            );
            let nested_locals = try compiled_signature::extend_locals_spec(
                ir_bytes, locals_spec, let_name, nested_call_type
            );
            try stmts.append(compiled_mir::let_expr_stmt(
                let_name, string_counter, nested_result_id, nested_insts
            ));
            return MultiLowerResult {
                locals_spec: nested_locals,
                string_counter: string_counter + nested_strings,
                temp_counter: temp_counter + nested_inst_count,
                try_counter: try_counter
            };
        }
        let call_type = try compiled_mir_types::lower_call_return_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, let_value, bs
        );
        let callee_name = try compiled_mir_types::lower_call_callee_name_indexed(
            ir_lookup_index, ir_bytes, function_name, module_prefix, let_value, sf
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix_indexed(
            ir_lookup_index, ir_bytes, function_name, module_prefix, let_value, sf
        );
        let args = try lower_call_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, let_value, string_counter, aliases, bs,
            ir_lookup_index, call_arg_type_cache
        );
        let new_locals = try compiled_signature::extend_locals_spec(
            ir_bytes, locals_spec, let_name, call_type
        );
        let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
        try stmts.append(compiled_mir::let_call_stmt(
            let_name, call_type, string_counter, callee_module_prefix, callee_name, args
        ));
        return MultiLowerResult {
            locals_spec: new_locals,
            string_counter: new_counter,
            temp_counter: temp_counter,
            try_counter: try_counter
        };
    }
    if std::mem::equal_bytes(let_value_kind, "StructLiteralExpr") {
        let struct_type = try compiled_signature::resolve_struct_literal_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, let_value, bs
        );
        let fields = try compiled_mir_lower_struct::lower_struct_fields(
            ir_bytes, function_name, module_prefix, locals_spec, let_value, bs
        );
        let field_count = fields.len();
        let new_locals = try compiled_signature::extend_locals_spec(
            ir_bytes, locals_spec, let_name, struct_type
        );
        try stmts.append(compiled_mir::let_struct_stmt(
            let_name, struct_type, string_counter, fields
        ));
        return MultiLowerResult {
            locals_spec: new_locals,
            string_counter: string_counter + field_count,
            temp_counter: temp_counter,
            try_counter: try_counter
        };
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        let_value,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    let expr_type = try expr_inst_llvm_type_by_id(&insts, result_id);
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, expr_type
    );
    try stmts.append(compiled_mir::let_expr_stmt(
        let_name, string_counter, result_id, insts
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: string_counter + expr_strings,
        temp_counter: next_temp,
        try_counter: try_counter
    };
}

fn lower_try_call_args_with_local_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    arg_insts: &var std::array::Array<compiled_mir::MirExprInst>,
    args: &var std::array::Array<compiled_mir::MirCallArg>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !TryCallArgsLowerResult {
    // cf is this call node's body-node line via the per-function index (pillar A, O(1)); its callee
    // detail and arg edges sort at-or-after it, so a scan from cf is byte-identical to one from bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, module_prefix, callee_name, arg_count, ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var arg_index = 0;
    var string_idx = string_counter;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, cf
        );
        // af tightens this argument's own structural reads (its hoist-kind check and scalar
        // lowering) to its body-node line; the expr-lowering recursion keeps bs (it re-tightens
        // internally through its own per-function index lookup).
        let af = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index);
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, af) {
            let before = arg_insts.len();
            let temp_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                arg_node,
                string_idx,
                temp_counter,
                arg_insts,
                aliases,
                bs,
                ir_lookup_index,
                call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(arg_insts, before);
            try args.append(compiled_mir::temp_call_arg(arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_with_aliases_cached(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                arg_type,
                arg_node,
                string_idx,
                &alias_sources,
                &alias_currents,
                bs,
                ir_lookup_index,
                call_arg_type_cache
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    let arg_inst_count = arg_insts.len();
    return TryCallArgsLowerResult {
        string_counter: string_idx,
        temp_counter: temp_counter + arg_inst_count
    };
}

fn lower_hoisted_try_arg(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    arg_node: i64,
    hoist_name: []u8,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "value", 0, arg_sf
    );
    let inner_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, inner, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, inner, inner_sf
    );
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: try call argument must wrap a call");
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, inner_sf) {
        return try lower_multi_let_array_get(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            hoist_name, inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    return try lower_multi_let_try_call(
        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
        hoist_name, inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
        ir_lookup_index, call_arg_type_cache
    );
}

fn lower_call_args_hoisting_try_args_with_local_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    arg_insts: &var std::array::Array<compiled_mir::MirExprInst>,
    out_args: &var std::array::Array<compiled_mir::MirCallArg>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !TryArgCallArgsLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, module_prefix, callee_name, arg_count, ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var cur_locals = locals_spec;
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, cf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index);
        let arg_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arg_node, arg_sf
        );
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            let hoist_name = try hoisted_try_arg_name(cur_try);
            let hoist_result = try lower_hoisted_try_arg(
                ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                arg_node, hoist_name, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                ir_lookup_index, call_arg_type_cache
            );
            cur_locals = hoist_result.locals_spec;
            cur_string = hoist_result.string_counter;
            cur_temp = hoist_result.temp_counter;
            cur_try = hoist_result.try_counter;
            try out_args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
        } else {
            if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
                let before = arg_insts.len();
                let temp_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_node,
                    cur_string,
                    cur_temp - before,
                    arg_insts,
                    aliases,
                    bs,
                    ir_lookup_index,
                    call_arg_type_cache
                );
                cur_string = cur_string + try count_strings_in_insts_from(arg_insts, before);
                cur_temp = cur_temp + arg_insts.len() - before;
                try out_args.append(compiled_mir::temp_call_arg(arg_type, temp_id));
            } else {
                let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_with_aliases_cached(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_type,
                    arg_node,
                    cur_string,
                    &alias_sources,
                    &alias_currents,
                    bs,
                    ir_lookup_index,
                    call_arg_type_cache
                );
                if scalar_arg.kind == compiled_mir::MirCallArgKind::String {
                    cur_string = cur_string + 1;
                }
                try out_args.append(scalar_arg);
            }
        }
        arg_index = arg_index + 1;
    }
    return TryArgCallArgsLowerResult {
        locals_spec: cur_locals,
        string_counter: cur_string,
        temp_counter: cur_temp,
        try_counter: cur_try
    };
}

fn lower_method_call_args_hoisting_try_args_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    arg_insts: &var std::array::Array<compiled_mir::MirExprInst>,
    out_args: &var std::array::Array<compiled_mir::MirCallArg>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !TryArgCallArgsLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, bs,
        ir_lookup_index, call_arg_type_cache
    );
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, info.module_prefix, info.callee_name, explicit_arg_count + 1,
        ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    try out_args.append(compiled_mir::var_call_arg(
        try arg_types.get(0), try local_alias_current_name(aliases, info.receiver_name)
    ));
    var cur_locals = locals_spec;
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    var arg_index = 0;
    while arg_index < explicit_arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, cf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index + 1);
        let arg_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arg_node, arg_sf
        );
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            let hoist_name = try hoisted_try_arg_name(cur_try);
            let hoist_result = try lower_hoisted_try_arg(
                ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                arg_node, hoist_name, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                ir_lookup_index, call_arg_type_cache
            );
            cur_locals = hoist_result.locals_spec;
            cur_string = hoist_result.string_counter;
            cur_temp = hoist_result.temp_counter;
            cur_try = hoist_result.try_counter;
            try out_args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
        } else {
            if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
                let before = arg_insts.len();
                let temp_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_node,
                    cur_string,
                    cur_temp - before,
                    arg_insts,
                    aliases,
                    bs,
                    ir_lookup_index,
                    call_arg_type_cache
                );
                cur_string = cur_string + try count_strings_in_insts_from(arg_insts, before);
                cur_temp = cur_temp + arg_insts.len() - before;
                try out_args.append(compiled_mir::temp_call_arg(arg_type, temp_id));
            } else {
                let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_with_aliases_cached(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_type,
                    arg_node,
                    cur_string,
                    &alias_sources,
                    &alias_currents,
                    bs,
                    ir_lookup_index,
                    call_arg_type_cache
                );
                if scalar_arg.kind == compiled_mir::MirCallArgKind::String {
                    cur_string = cur_string + 1;
                }
                try out_args.append(scalar_arg);
            }
        }
        arg_index = arg_index + 1;
    }
    return TryArgCallArgsLowerResult {
        locals_spec: cur_locals,
        string_counter: cur_string,
        temp_counter: cur_temp,
        try_counter: cur_try
    };
}

// lower_multi_let_try_call lowers a 'let <name> = try <callee>(<args>);' try-call into a
// LetTryCall statement (tracker 961). It resolves the callee's error-union return type
// (called_error_union), the unwrapped success type the bind takes, the callee symbol +
// args, and threads this function's own error-union return type for the failure
// propagation. try_counter advances so each try-call gets a distinct block-label pair.
fn lower_multi_let_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let called_error_union = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, call_node, bs, ir_lookup_index
    );
    // cf tightens the pure structural callee read (this call's 'body-call' detail) to the call
    // node's body-node line via the per-function index; the indexed callee/module resolvers still
    // do their cross-module signature probes through the global lookup index.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_name = try compiled_mir_types::lower_call_callee_name_indexed(
        ir_lookup_index, ir_bytes, function_name, module_prefix, call_node, cf
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix_indexed(
        ir_lookup_index, ir_bytes, function_name, module_prefix, call_node, cf
    );
    var arg_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    let lowered_args = try lower_try_call_args_with_local_aliases_cached(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        call_node,
        string_counter,
        temp_counter,
        aliases,
        &var arg_insts,
        &var args,
        bs,
        ir_lookup_index,
        call_arg_type_cache
    );
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, success_type
    );
    try stmts.append(compiled_mir::let_try_call_stmt(
        let_name, called_error_union, success_type, llvm_return_type,
        callee_module_prefix, callee_name, string_counter, try_counter,
        arg_insts, args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: lowered_args.string_counter,
        temp_counter: lowered_args.temp_counter,
        try_counter: try_counter + 1
    };
}

// lower_multi_assign_statement lowers a top-level '<local> = try <free-call>(args);' reassignment.
// The target is an already-bound local, so it cannot take a fresh SSA name like a 'let'. Instead the
// call's success value is bound to a fresh alias name through the shared LetTryCall error-union
// branch/propagate path, and the target local is redirected to that alias so later statements read
// the updated value -- the same local-alias indirection lower_void_then_body_assign uses for
// non-try reassignments inside if-then bodies. Only a free-function try-call value is accepted;
// other shapes surface an explicit error rather than silently mis-lowering.
fn lower_multi_assign_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiAssignLowerResult {
    // sf tightens this Assign statement's own structural facts (target/value subtree kinds, tokens,
    // edges, callee detail) to its body-node line via the index; the subtree sorts at-or-after it,
    // so a scan from sf is byte-identical to one from bs. The target type resolution reads back
    // across the function, and the let-try-call recursion / index-keyed success-type resolver keep
    // bs.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, sf
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", sf)) {
        return error("compiled mir: top-level assignment target must be a local");
    }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target, sf
    );
    // Resolving the target's type proves it is a bound local (an unbound name surfaces 'local type
    // not found' rather than being silently accepted) and yields the type the reassigned value carries.
    let target_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, target_name, bs, call_arg_type_cache
    );
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, sf
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", sf)) {
        return error("compiled mir: top-level assignment value must be a try-call");
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "value", 0, sf
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", sf)) {
        return error("compiled mir: top-level assignment try value must wrap a call");
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, sf) {
        return error("compiled mir: top-level assignment try-call callee must be a free function");
    }
    // The reassigned local must carry the call's success type; a mismatch would silently mis-lower.
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, inner, bs, ir_lookup_index
    );
    if !std::mem::equal_bytes(success_type, target_type) {
        return error("compiled mir: top-level assignment try-call success type mismatch");
    }
    let output_name = try void_then_alias_name(alias_counter);
    let lowered = try lower_multi_let_try_call(
        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
        output_name, inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
        ir_lookup_index, call_arg_type_cache
    );
    try set_local_alias(aliases, target_name, output_name);
    return MultiAssignLowerResult {
        locals_spec: lowered.locals_spec,
        string_counter: lowered.string_counter,
        temp_counter: lowered.temp_counter,
        try_counter: lowered.try_counter,
        alias_counter: alias_counter + 1
    };
}

// lower_multi_let_call is the non-error-union mirror of lower_multi_let_try_call: it binds a
// plain (non-try) call's success value into 'let <name> = <call>;' so a method try-call statement
// argument that is itself a bare Call (e.g. 'ast.span(...)', which returns a non-error-union value
// and therefore has no inline call-arg descriptor) can be hoisted ahead of the statement and passed
// by Var. It emits a single MirLetCall with no fail/cont propagation, reusing the shared call
// callee/module/arg resolvers, then extends the locals so later statements resolve the bound type.
fn lower_multi_let_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // cf tightens the pure structural callee read (this call's 'body-call' detail) to the call
    // node's body-node line via the per-function index; the indexed callee/module resolvers still
    // do their cross-module signature probes through the global lookup index.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let call_type = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_name = try compiled_mir_types::lower_call_callee_name_indexed(
        ir_lookup_index, ir_bytes, function_name, module_prefix, call_node, cf
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix_indexed(
        ir_lookup_index, ir_bytes, function_name, module_prefix, call_node, cf
    );
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, aliases, bs,
        ir_lookup_index, call_arg_type_cache
    );
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, call_type
    );
    let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
    try stmts.append(compiled_mir::let_call_stmt(
        let_name, call_type, string_counter, callee_module_prefix, callee_name, args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: new_counter,
        temp_counter: temp_counter,
        try_counter: try_counter
    };
}

// lower_multi_let_ast_child_at lowers 'let <name> = try <ast>.child_at(<range>, <index>);'
// into a LetTryCall against the compiled std::kizu::ast::ast_child_at accessor. The
// receiver forwards by value as the self argument, the range and index arguments lower
// through the shared call-arg path typed from the accessor's signature facts, and the
// bound NodeId success extends the locals so later statements resolve its type.
fn lower_multi_let_ast_child_at(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    callee_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver_node, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: child_at receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs,
        call_arg_type_cache
    );
    let receiver_lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    if !std::mem::equal_bytes(receiver_lookup, "std::kizu::ast::Ast") {
        return error("compiled mir: child_at receiver is not a std::kizu::ast::Ast");
    }
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 2 {
        return error("compiled mir: child_at takes a range and an index argument");
    }
    let accessor_prefix = "std::kizu::ast::";
    let accessor_name = "ast_child_at";
    let called_error_union = "%kizu.error.node_id";
    let success_type = "%kizu.kizu.ast.node_id";
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, accessor_prefix, accessor_name, arg_count + 1,
        ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::var_call_arg("%kizu.kizu.ast.ast", receiver_alias));
    var consumed_strings = 0;
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, cf
        );
        let arg_type = try arg_types.get(arg_index + 1);
        let arg = try compiled_mir_lower_call::lower_single_call_arg_with_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, arg_type, arg_node,
            string_counter + consumed_strings, &alias_sources, &alias_currents, bs,
            ir_lookup_index, call_arg_type_cache
        );
        if arg.kind == compiled_mir::MirCallArgKind::String {
            consumed_strings = consumed_strings + 1;
        }
        try args.append(arg);
        arg_index = arg_index + 1;
    }
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, "std::kizu::ast::NodeId"
    );
    try stmts.append(compiled_mir::let_try_call_stmt(
        let_name, called_error_union, success_type, llvm_return_type,
        accessor_prefix, accessor_name, string_counter, try_counter,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: string_counter + consumed_strings,
        temp_counter: temp_counter,
        try_counter: try_counter + 1
    };
}

// lower_multi_let_array_get lowers 'let <name> = try <receiver>.get(<expr>);' where the
// receiver is a value std::array::Array<T> param/local (issue 1165). The receiver lowers
// to %kizu.owned, so the index expression lowers into expr_insts and the LetArrayGet
// renderer reads the handle straight off the named value, calls the checked
// @kizu_rt_array_at builtin, binds the element (element type T derived from Array<T>) to
// <name> on success, and propagates a failure as this function's own error union. An
// unsupported method/receiver/element type fails explicitly.
fn lower_multi_let_array_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // cf tightens this call's own structural facts (its callee field-expr / method name, receiver
    // edge and kind/token, arg edge) to the call node's body-node line via the index; the subtree
    // sorts at-or-after it, so a scan from cf is byte-identical to one from bs. The receiver type
    // resolution reads back across the function and the index lowering recurses, so both keep bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", cf
    );
    // 'let child = try ast.child_at(range, index);' on a value std::kizu::ast::Ast
    // receiver lowers as a LetTryCall to the compiled external accessor
    // kizu_kizu__ast_ast_child_at, whose checked !NodeId failure propagates as this
    // function's own error union (the tape's recursive list walks bind children
    // this way).
    if std::mem::equal_bytes(method_name, "child_at") {
        return try lower_multi_let_ast_child_at(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            let_name, call_node, callee_node, string_counter, temp_counter,
            try_counter, aliases, stmts, bs, ir_lookup_index, call_arg_type_cache
        );
    }
    if !std::mem::equal_bytes(method_name, "get") {
        return error("compiled mir: only Array.get is supported in let-try position on a value receiver");
    }
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver_node, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: Array.get value receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs, call_arg_type_cache
    );
    let lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    if !is_array_field_type(lookup) {
        return error("compiled mir: Array.get receiver is not a std::array::Array");
    }
    let element_kizu_type = try array_element_kizu_type(lookup);
    let element_llvm_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, module_prefix, element_kizu_type
    );
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let index_result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        index_node,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    try stmts.append(compiled_mir::let_array_get_stmt(
        let_name,
        receiver_alias,
        element_llvm_type,
        llvm_return_type,
        index_result_id,
        string_counter,
        try_counter,
        insts
    ));
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, element_llvm_type
    );
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: string_counter + expr_strings,
        temp_counter: next_temp,
        try_counter: try_counter + 1
    };
}

// try_call_success_type resolves the unwrapped success type a 'try <callee>(...)' binds:
// it reads the callee's '!T' signature-return token, strips the leading '!', and lowers T.
fn try_call_success_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> ![]u8 {
    // cf tightens the structural callee read to the call node's body-node line via the global
    // index (this resolver is not threaded with the per-function index); the signature-return
    // lookup below is index-keyed by callee name, so it is unaffected. Byte-identical to bs.
    let cf = ir_index::body_node_line_start_for_sequence(
        ir_lookup_index, ir_bytes, function_name, call_node, bs
    );
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    // A 'try lexer::tokenize(...)' crosses a module boundary through an import alias, so its
    // '!T' signature-return fact is keyed under the callee's real owning module rather than
    // the caller's module prefix. Resolve the fully-qualified name generically (the same
    // resolver lower_call_return_type uses) and read the fact with an empty prefix.
    let qualified = compiled_mir_types::cross_module_callee_qualified_name_or_empty_indexed(
        ir_lookup_index, ir_bytes, callee_name
    );
    var lookup_prefix = module_prefix;
    var lookup_name = callee_name;
    if std::mem::len(qualified) > 0 {
        lookup_prefix = ir_bytes[0..0];
        lookup_name = qualified;
    }
    var ret_kizu = compiled_fact_lookup::lookup_fact_value_by_prefix_or_empty_indexed(
        ir_lookup_index, ir_bytes, "function-signature-return ", lookup_prefix, lookup_name
    );
    if std::mem::len(ret_kizu) == 0 and
        std::mem::len(qualified) == 0 and
        compiled_fact_lookup::is_stdlib_callee(callee_name) {
        ret_kizu = try compiled_fact_lookup::lookup_stdlib_return_indexed(
            ir_lookup_index, ir_bytes, callee_name
        );
    }
    if std::mem::len(ret_kizu) == 0 {
        return error("compiled mir: try-call callee return type not found");
    }
    if ret_kizu[0] != cast<u8>(33) {
        return error("compiled mir: try-call callee must return an error union");
    }
    let success_kizu = ret_kizu[1..std::mem::len(ret_kizu)];
    return try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index, ir_bytes, lookup_prefix, success_kizu
    );
}
// prefix_not_try_call_inner_or_minus_one recognizes a '!(try <callee>(<args>))' expression: a
// prefix 'not' whose operand is a 'try <call>' over a free function returning an error-union bool
// (a try-call in sub-expression position, issue 1165 / 1162). It returns the inner Call node so the
// caller can lower it as a hoisted try-call whose unwrapped bool success is negated, or -1 when the
// shape does not match. A field-mode method call is rejected (returns -1) so only free-function
// try-calls take this path, and a callee whose unwrapped success type is not 'i1' is rejected too:
// the renderer negates the success with 'xor i1' and wraps an 'i1' field, so a non-bool callee (e.g.
// a '!i64') must fall through to the generic path rather than be silently mis-lowered.
fn prefix_not_try_call_inner_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(kind, "Prefix") {
        return -1;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-prefix ", function_name, node, bs
    );
    if !std::mem::equal_bytes(op, "not") {
        return -1;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right, bs);
    if !std::mem::equal_bytes(right_kind, "TryExpr") {
        return -1;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, right, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return -1;
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return -1;
    }
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, inner, bs, ir_lookup_index
    );
    if !std::mem::equal_bytes(success_type, "i1") {
        return -1;
    }
    return inner;
}

// positive_try_call_condition_inner_or_minus_one recognizes an if condition of the form
// 'try <free !bool callee>(<args>)'. It is a side-effecting condition, so it cannot be lowered as a
// straight-line MirExprInst: the rendered call must branch on the error-union ok flag, propagate a
// failure as this function's own error union, and branch on the unwrapped bool success. Near-miss
// TryExpr shapes are explicit errors instead of falling through to the generic expression path.
fn positive_try_call_condition_inner_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(kind, "TryExpr") {
        return -1;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: positive try-call condition must wrap a call");
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: positive try-call condition must be a free function");
    }
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, inner, bs, ir_lookup_index
    );
    if !std::mem::equal_bytes(success_type, "i1") {
        return error("compiled mir: positive try-call condition callee must return !bool");
    }
    return inner;
}

// require_if_not_try_guard_no_else rejects an 'if !(try <call>) { return <bool>; }' guard that also
// carries an else arm (issue 1165 / 1162). The if-not-try-call-return-bool statement is rendered as
// a then-only conditional branch -- the negation either returns the bool or falls through to the
// join the following statements render into -- so an else block with a real body would be silently
// dropped. It is an explicit error instead of a silent mis-lower. A missing else child reads as
// either an absent child or an 'Empty' node depending on how the body facts were emitted; both are
// accepted.
fn require_if_not_try_guard_no_else(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !void {
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    if else_node < 0 {
        return;
    }
    let else_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, else_node, bs);
    if !std::mem::equal_bytes(else_kind, "Empty") {
        return error("compiled mir: if-not-try guard must not carry an else arm");
    }
    return;
}

// require_void_then_block_no_else rejects a no-else void multi-statement if-then block that also
// carries an else arm (issue 1165 / 1162). The void then-block is rendered (once the renderer lands)
// as a then-only conditional branch into a fall-through join the following statements render into,
// so an else block with a real body would be silently dropped. It is an explicit error instead of a
// silent mis-lower. A missing else child reads as either an absent child or an 'Empty' node
// depending on how the body facts were emitted; both are accepted. Mirrors
// require_if_not_try_guard_no_else, which pins the same then-only-render invariant for the guard.
fn require_void_then_block_no_else(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !void {
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    if else_node < 0 {
        return;
    }
    let else_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, else_node, bs);
    if !std::mem::equal_bytes(else_kind, "Empty") {
        return error("compiled mir: void then block must not carry an else arm");
    }
    return;
}

// lower_try_call_void_if lowers 'if try <free !bool callee>(<args>) { <void body> }' and
// 'if !(try <free !bool callee>(<args>)) { <void body> }': the condition call is hoisted into a
// basic-block branch with failure propagation, and the then-body is lowered through the same
// no-else void-body path as ordinary bool conditions so assignments merge through the fall-through
// join. then_on_success records the condition polarity.
fn lower_try_call_void_if(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    then_node: i64,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    then_on_success: bool,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    try require_void_then_block_no_else(ir_bytes, function_name, statement, sf);

    let called_error_union = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let call_args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, aliases, bs,
        ir_lookup_index, call_arg_type_cache
    );
    let call_arg_strings = try compiled_mir_lower_call::count_string_args(&call_args);

    var then_body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var merge_vars = std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator());
    var branch_aliases = try copy_local_aliases(aliases);
    defer branch_aliases.deinit();
    let then_body = try lower_void_then_body(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        then_node,
        string_counter + call_arg_strings,
        temp_counter,
        try_counter,
        alias_counter,
        if_index,
        &var branch_aliases,
        &var then_body_stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    var branch_alias_index = 0;
    var merge_alias_counter = then_body.alias_counter;
    if !then_body.body_returns {
        while branch_alias_index < branch_aliases.len() {
            let branch_state = try branch_aliases.at(branch_alias_index);
            // A shadowed name is handled by per-binding SSA rename, not by a join phi: each
            // 'let <name>' inside a branch is an independent value that dies at the branch end, so
            // its branch alias must never merge into the enclosing scope's binding of the same name.
            if try let_binding_is_shadowed(ir_bytes, function_name, branch_state.source_name, bs) {
                branch_alias_index = branch_alias_index + 1;
                continue;
            }
            let input_name = try local_alias_current_name(aliases, branch_state.source_name);
            if !std::mem::equal_bytes(input_name, branch_state.current_name) {
                let output_name = try void_then_alias_name(merge_alias_counter);
                let merge_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
                    ir_lookup_index,
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    branch_state.source_name,
                    bs, call_arg_type_cache
                );
                try merge_vars.append(compiled_mir::if_merge_var(
                    branch_state.source_name,
                    input_name,
                    branch_state.current_name,
                    output_name,
                    merge_type
                ));
                try set_local_alias(aliases, branch_state.source_name, output_name);
                merge_alias_counter = merge_alias_counter + 1;
            }
            branch_alias_index = branch_alias_index + 1;
        }
    }
    try stmts.append(compiled_mir::if_try_call_void_body_stmt(
        if_index,
        string_counter,
        called_error_union,
        llvm_return_type,
        callee_module_prefix,
        callee_name,
        call_args,
        then_on_success,
        then_body_stmts,
        merge_vars
    ));
    return MultiIfLowerResult {
        temp_counter: then_body.temp_counter,
        string_counter: then_body.string_counter,
        try_counter: then_body.try_counter,
        alias_counter: merge_alias_counter
    };
}

// lower_return_struct_literal lowers a 'return <Struct> { ... };' statement.
// Inside an error-union function ('return CodeEval { ... };' in '!CodeEval') the
// struct builds as the success value and wraps into the function's error union;
// a plain struct return keeps building into the return type directly (empty wrap
// markers).
fn lower_return_struct_literal(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    value: i64,
    string_counter: i64,
    bs: i64
) -> !compiled_mir::MirStmt {
    var wrap_error_union = ir_bytes[0..0];
    var success_llvm = ir_bytes[0..0];
    if std::mem::starts_with(llvm_return_type, "%kizu.error.") {
        wrap_error_union = llvm_return_type;
        success_llvm = try compiled_signature::resolve_struct_literal_type(
            ir_bytes, function_name, module_prefix, value, bs
        );
    }
    let fields = try compiled_mir_lower_struct::lower_struct_fields(
        ir_bytes, function_name, module_prefix, locals_spec, value, bs
    );
    return compiled_mir::return_struct_wrapped_stmt(
        string_counter, wrap_error_union, success_llvm, fields
    );
}

fn lower_multi_return_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    // sf tightens this Return statement's own structural facts (its value subtree: kind, callee
    // detail/field-expr, arg edges) to its body-node line via the index; the subtree sorts
    // at-or-after it, so a scan from sf is byte-identical to one from bs. Shape detection that
    // reads back across the function, the expr/call lowering recursion, and the index-keyed
    // return-type resolver keep bs.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, sf
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, sf);
    // 'return !(try <callee>(<args>));' hoists the sub-expression try-call: the renderer emits the
    // call, propagates a failure as this function's own error union, and negates the unwrapped bool
    // success before wrapping it as the error-union success (issue 1165 / 1162).
    let return_not_try = try prefix_not_try_call_inner_or_minus_one(
        ir_bytes, function_name, module_prefix, value, bs, ir_lookup_index
    );
    if return_not_try >= 0 {
        let called_error_union = try compiled_mir_types::lower_call_return_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, return_not_try, bs
        );
        let callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, return_not_try, sf
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, return_not_try, sf
        );
        let args = try lower_call_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, return_not_try,
            string_counter, aliases, bs, ir_lookup_index, call_arg_type_cache
        );
        return compiled_mir::return_not_try_call_stmt(
            called_error_union, llvm_return_type, callee_module_prefix, callee_name,
            string_counter, args
        );
    }
    if std::mem::equal_bytes(value_kind, "Call") {
        if try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, value, sf) {
            let message_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, value, "arg", 0, sf
            );
            var message_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let message_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                message_node,
                string_counter,
                temp_counter,
                &var message_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            return compiled_mir::return_error_stmt(
                string_counter, message_result, message_insts
            );
        }
        // 'return <value>.len();' on an Array<T>/String value receiver reads the length
        // through its runtime helper; it lowers through the generic expression path (the
        // same value-receiver len lowering conditions use) as a return-expr statement.
        if try callee_is_field_expr(ir_bytes, function_name, value, sf) and
            (try call_method_name_is(ir_bytes, function_name, value, "len", sf)) {
            var len_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let len_result_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                value,
                string_counter,
                temp_counter,
                &var len_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            return compiled_mir::return_expr_stmt(string_counter, len_result_id, len_insts);
        }
        // A field-receiver get() return is the checked Array<T>.get accessor
        // (self.<field>.get(<expr>) -> !T), backing Ast.child_at (tracker 961).
        // Other value-receiver methods with real signatures lower through the generic
        // expression path, which passes the receiver as arg 0 and can hoist computed args.
        if try callee_is_field_expr(ir_bytes, function_name, value, sf) {
            if !(try call_method_name_is(ir_bytes, function_name, value, "get", sf)) {
                var method_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                let method_result_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    value,
                    string_counter,
                    temp_counter,
                    &var method_insts,
                    aliases,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                return compiled_mir::return_expr_stmt(string_counter, method_result_id, method_insts);
            }
                return try lower_multi_return_array_get(
                    ir_bytes, function_name, module_prefix, llvm_return_type,
                    locals_spec, value, string_counter, temp_counter, aliases, bs,
                    ir_lookup_index, call_arg_type_cache
                );
        }
        // 'return equal_bytes(token_text(...), expected);' carries a nested call argument and
        // 'return is_line_break(source[cursor]);' carries a single-element byte index load --
        // arguments the inline call-arg descriptors cannot model -- so each lowers through the
        // generic expression path (which materializes the nested call or checked byte load into a
        // preceding temp) as a return-expr statement instead of an inline return-call (issue 1165 /
        // 1162).
        if try call_has_hoisted_arg_cached(
            ir_bytes, function_name, value, bs, call_arg_type_cache
        ) {
            var nested_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let nested_result_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                value,
                string_counter,
                temp_counter,
                &var nested_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            return compiled_mir::return_expr_stmt(string_counter, nested_result_id, nested_insts);
        }
        let call_type = try compiled_mir_types::lower_call_return_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, value, bs
        );
        let callee_name = try compiled_mir_types::lower_call_callee_name_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, value, bs
        );
        let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, value, bs
        );
        let args = try lower_call_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, value, string_counter, aliases, bs,
            ir_lookup_index, call_arg_type_cache
        );
        return compiled_mir::return_call_stmt(
            call_type, string_counter, callee_module_prefix, callee_name, args
        );
    }
    // A bare 'return;' returns the void success (wrapped when the function returns
    // an error union).
    if std::mem::equal_bytes(value_kind, "Empty") {
        return compiled_mir::return_void_success_stmt();
    }
    // 'return try <callee>(<args>);' whose callee shares this function's error-union
    // return type is an identity tail: the callee's result returns directly, the
    // caller unwraps (the tape's recursive list walks end this way).
    if std::mem::equal_bytes(value_kind, "TryExpr") {
        let try_inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "value", 0, sf
        );
        let try_inner_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, try_inner, sf
        );
        if std::mem::equal_bytes(try_inner_kind, "Var") {
            var var_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let var_result_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                try_inner,
                string_counter,
                temp_counter,
                &var var_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            let var_type = try return_try_expr_inst_llvm_type_by_id(&var_insts, var_result_id);
            if !std::mem::equal_bytes(var_type, llvm_return_type) {
                return error("compiled mir: return try variable must share the function's error union");
            }
            return compiled_mir::return_expr_stmt(string_counter, var_result_id, var_insts);
        }
        if !std::mem::equal_bytes(try_inner_kind, "Call") {
            return error("compiled mir: return try must wrap a call");
        }
        let try_call_type = try compiled_mir_types::lower_call_return_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, try_inner, bs
        );
        if !std::mem::equal_bytes(try_call_type, llvm_return_type) {
            return error("compiled mir: return try call must share the function's error union");
        }
        let try_callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, try_inner, sf
        );
        let try_callee_module = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, try_inner, sf
        );
        let try_args = try lower_call_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, try_inner,
            string_counter, aliases, bs, ir_lookup_index, call_arg_type_cache
        );
        return compiled_mir::return_call_stmt(
            try_call_type, string_counter, try_callee_module, try_callee_name, try_args
        );
    }
    if std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        return try lower_return_struct_literal(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            value, string_counter, bs
        );
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    return compiled_mir::return_expr_stmt(string_counter, result_id, insts);
}
// lower_multi_match_statement lowers a non-bool enum-dispatch match statement
// ('match <scrutinee> { Variant => return <expr>, _ => return <expr> }') into an EnumDispatch
// stmt (issue 1157 PR-PH / B3 / NEW-B). The scrutinee lowers to an i64 discriminant through
// lower_expr_into (a bare enum Var, a 'token.kind' field access, or a depth-2
// 'expr.next.kind' field access); each arm's variant tag is resolved from the enum-variant facts
// and its 'return <expr>' body reuses the shared
// lower_multi_return_statement path. The renderer currently arm-scopes the value-return
// ('return <int/var>') and error-return ('return error(..)') wraps; other return shapes (call /
// struct success wraps) surface an explicit blocker at emit time until they are arm-scoped too.
// The trailing '_' default (or the final variant of an exhaustive match) carries no tag and
// renders as the unconditional fallthrough arm. Every arm returns, so the statement is terminal.
// Each arm reserves a private temp/string SSA window (arm_index * ARM_SSA_STRIDE off the
// scrutinee end) so the per-arm '%t<id>' temps and string globals never collide across the arm
// blocks of the same function -- the same fixed-stride namespacing the if-renderer applies to
// its then/else block labels (if_index * 1000).
fn lower_multi_match_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    let arm_ssa_stride = 1000;
    // The scrutinee lowers to an i64 discriminant. A bare enum Var resolves its enum type from
    // the parameter/local kizu type; field access scrutinees resolve through the shared recursive
    // field resolver so both 'token.kind' and 'expr.next.kind' reach the same enum-variant facts.
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, scrutinee, bs
    );
    let enum_kizu = try resolve_dispatch_enum_kizu_type(
        ir_bytes, function_name, module_prefix, locals_spec, scrutinee, scrutinee_kind, bs,
        ir_lookup_index, call_arg_type_cache
    );
    var scrutinee_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let scrutinee_result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        scrutinee,
        string_counter,
        temp_counter,
        &var scrutinee_insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let scrutinee_temps = scrutinee_insts.len();
    let scrutinee_strings = try count_strings_in_insts(&scrutinee_insts);
    let arm_temp_base = temp_counter + scrutinee_temps;
    let arm_string_base = string_counter + scrutinee_strings;
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, statement, "arm", bs
    );
    if arm_count < 1 {
        return error("compiled mir: enum-dispatch match requires at least one arm");
    }
    var arms = std::array::Array<compiled_mir::MirEnumDispatchArm>(std::mem::page_allocator());
    var index = 0;
    while index < arm_count {
        let arm_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, statement, "arm", index, bs
        );
        let pattern = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_node, "pattern", 0, bs
        );
        let variant_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, pattern, bs
        );
        let is_default = std::mem::equal_bytes(variant_name, "_");
        var tag = 0 - 1;
        if !is_default {
            tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
                ir_lookup_index, ir_bytes, ir_bytes[0..0], enum_kizu, variant_name
            );
        }
        // Each arm body is a single 'return <expr>'. Reuse lower_multi_return_statement off the
        // arm's private SSA window so its temps/strings stay disjoint from the other arms.
        let arm_body = try dispatch_arm_return_statement(
            ir_bytes, function_name, arm_node, bs
        );
        let arm_temp = arm_temp_base + index * arm_ssa_stride;
        let arm_string = arm_string_base + index * arm_ssa_stride;
        let return_stmt = try lower_multi_return_statement(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            arm_body,
            arm_string,
            arm_temp,
            aliases,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        var arm_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
        try arm_stmts.append(return_stmt);
        try arms.append(compiled_mir::enum_dispatch_arm(tag, is_default, arm_stmts));
        index = index + 1;
    }
    return compiled_mir::enum_dispatch_stmt(scrutinee_insts, scrutinee_result_id, arms);
}
// resolve_dispatch_enum_kizu_type resolves the fully-qualified enum kizu type of an
// enum-dispatch match scrutinee: a bare Var reads its parameter/local kizu type, and a
// FieldExpr delegates to the shared field resolver so both receiver.field and
// receiver.field.field dispatches stay structural (issue 1157 PR-PH / B3 / NEW-B).
fn resolve_dispatch_enum_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    scrutinee: i64,
    scrutinee_kind: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if std::mem::equal_bytes(scrutinee_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, scrutinee, bs
        );
        let kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, locals_spec, var_name, bs,
            call_arg_type_cache
        );
        return compiled_mir_types::struct_lookup_kizu_type(kizu);
    }
    if std::mem::equal_bytes(scrutinee_kind, "FieldExpr") {
        let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
            ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec, scrutinee, bs,
            call_arg_type_cache
        );
        return compiled_mir_types::struct_lookup_kizu_type(field.field_kizu_type);
    }
    return error("compiled mir: enum-dispatch scrutinee must be a variable or field access");
}
// dispatch_arm_return_statement returns the 'return <expr>' statement node backing one
// enum-dispatch arm body. An arm body is either the Return node directly or a single-statement
// block wrapping it; any other shape (an expression statement, multi-statement body) is not a
// dispatch return and surfaces as an explicit blocker (issue 1157 PR-PH / B3).
fn dispatch_arm_return_statement(
    ir_bytes: []u8,
    function_name: []u8,
    arm_node: i64,
    bs: i64
) -> !i64 {
    let body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arm_node, "body", 0, bs
    );
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body, bs);
    if std::mem::equal_bytes(body_kind, "Return") {
        return body;
    }
    if std::mem::equal_bytes(body_kind, "Block") {
        let extra = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, body, "statement", 1, bs
        );
        if extra >= 0 {
            return error("compiled mir: enum-dispatch arm body must be a single return");
        }
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body, "statement", 0, bs
        );
        let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
        if !std::mem::equal_bytes(inner_kind, "Return") {
            return error("compiled mir: enum-dispatch arm body must return");
        }
        return inner;
    }
    return error("compiled mir: enum-dispatch arm body must be a return statement");
}
// lower_multi_return_array_get lowers a multi-statement
// 'return self.<field>.get(<expr>);' (Array<T>.get -> !T, tracker 961). It lowers the
// index expression (e.g. range.start + index) into expr_insts, resolves the Array<T>
// field off the struct value receiver, and builds a ReturnArrayGet statement that the
// renderer turns into the checked @kizu_rt_array_at call + ok-branch + by-value load +
// error-union wrap. Ast.child_at is its first consumer.
fn lower_multi_return_array_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    // cf tightens this call's own structural facts (callee/receiver/field edges, kinds, tokens,
    // arg edge) to the call node's body-node line via the index; the subtree sorts at-or-after it,
    // so a scan from cf is byte-identical to one from bs. Param type resolution (find_param_*) and
    // the index expression lowering recursion keep bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", cf
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return error("compiled mir: only Array.get method return is supported");
    }
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    // The method receiver is the array field expression self.<field>.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, cf
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.get receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", cf
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, cf
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, cf
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.get field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, cf
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(locals_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, locals_spec
    );
    let lookup_type = compiled_mir_types::struct_lookup_kizu_type(struct_kizu_type);
    let field = try compiled_fact_lookup::lookup_struct_field_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, lookup_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.get receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.get receiver field is not a std::array::Array");
    }
    let element_kizu_type = try array_element_kizu_type(field.field_type);
    let element_llvm_type = try compiled_fact_lookup::lookup_type_llvm_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "", element_kizu_type
    );
    // Lower the index expression (e.g. range.start + index) into expr_insts; the
    // result temp %t<index_result_id> feeds the checked array element accessor.
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let index_result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        index_node,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    return compiled_mir::return_array_get_stmt(
        receiver_llvm_type,
        var_name,
        field.index,
        element_llvm_type,
        index_result_id,
        string_counter,
        insts
    );
}
// short_circuit_kind classifies a condition node: 1 for and, 2 for or, 0
// otherwise. SPEC 6.9.1 requires and/or to short-circuit, so the if lowering
// evaluates the rhs only in the guarded block instead of eagerly.
fn short_circuit_kind(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(kind, "Binary") {
        return 0;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, node, bs
    );
    if std::mem::equal_bytes(op, "and") {
        return 1;
    }
    if std::mem::equal_bytes(op, "or") {
        return 2;
    }
    return 0;
}
// while_and_condition_eager_safe reports whether every operand of a short-circuit 'and'
// while header is side-effect-free, so an eager 'and i1' over the comparison results is
// observably identical to short-circuit evaluation. The condition may nest 'and' operands,
// each of which is a bool local/literal, a field read, a comparison Binary over
// side-effect-free values, or a pure '<receiver>.len()' call. An 'or' operand or any
// operand that could trap when the left side is false is rejected (issue 1165 / 1162).
fn while_and_condition_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try short_circuit_kind(ir_bytes, function_name, node, bs);
    if kind == 2 {
        return false;
    }
    if kind == 1 {
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        if !(try while_and_condition_eager_safe(ir_bytes, function_name, left, bs)) {
            return false;
        }
        return try while_and_condition_eager_safe(ir_bytes, function_name, right, bs);
    }
    return try while_condition_operand_eager_safe(ir_bytes, function_name, node, bs);
}
// while_condition_operand_eager_safe reports whether one leaf operand of an 'and' while
// header is side-effect-free: a bool local/literal or field read used directly, or a
// comparison Binary whose own operands are each a side-effect-free value.
fn while_condition_operand_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, node, bs
        );
        if !condition_op_is_comparison(op) {
            return false;
        }
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        if !(try while_condition_value_eager_safe(ir_bytes, function_name, left, bs)) {
            return false;
        }
        return try while_condition_value_eager_safe(ir_bytes, function_name, right, bs);
    }
    return try while_condition_value_eager_safe(ir_bytes, function_name, node, bs);
}
// while_condition_value_eager_safe reports whether a comparison operand value is
// side-effect-free: a local/literal/field read, or a pure '<receiver>.len()' call. A
// guarded array index load, a try-call, or any other call could trap and is rejected.
fn while_condition_value_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if std::mem::equal_bytes(kind, "Var") or std::mem::equal_bytes(kind, "Int") or
        std::mem::equal_bytes(kind, "Bool") or std::mem::equal_bytes(kind, "String") or
        std::mem::equal_bytes(kind, "FieldExpr") {
        return true;
    }
    if std::mem::equal_bytes(kind, "Call") {
        let callee_name = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, node, bs
        );
        if std::mem::equal_bytes(callee_name, "std::mem::equal_bytes") {
            if (try compiled_mir_types::count_call_args(ir_bytes, function_name, node, bs)) != 2 {
                return false;
            }
            let left_arg = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, node, "arg", 0, bs
            );
            let right_arg = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, node, "arg", 1, bs
            );
            if !(try while_condition_value_eager_safe(ir_bytes, function_name, left_arg, bs)) {
                return false;
            }
            return try while_condition_value_eager_safe(ir_bytes, function_name, right_arg, bs);
        }
        if !(try callee_is_field_expr(ir_bytes, function_name, node, bs)) {
            return false;
        }
        let callee_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "callee", 0, bs
        );
        let method_name = try ir_contract::body_field_expr_name_from(
            ir_bytes, function_name, callee_node, "field", bs
        );
        return std::mem::equal_bytes(method_name, "len");
    }
    return false;
}
fn condition_op_is_comparison(op: []u8) -> bool {
    return std::mem::equal_bytes(op, "eq") or std::mem::equal_bytes(op, "not-eq") or
        std::mem::equal_bytes(op, "lt") or std::mem::equal_bytes(op, "lte") or
        std::mem::equal_bytes(op, "gt") or std::mem::equal_bytes(op, "gte");
}
// flatten_and_operands collects the leaf operands of a short-circuit 'and' chain in
// left-to-right evaluation order. A nested 'and' is descended (so '((a and b) and c)'
// and 'a and (b and c)' both flatten to [a, b, c]); any other node, including an 'or',
// is a leaf appended as-is, so the caller can reject a nested 'or' as a near-miss
// explicit error rather than silently eager-evaluating it (issue 1165 / 1162).
fn flatten_and_operands(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    operands: &var std::array::Array<i64>,
    bs: i64
) -> !void {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) == 1 {
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        try flatten_and_operands(ir_bytes, function_name, left, operands, bs);
        try flatten_and_operands(ir_bytes, function_name, right, operands, bs);
        return;
    }
    try operands.append(node);
    return;
}
// flatten_or_operands collects the leaf operands of a short-circuit 'or' chain left to right,
// descending through nested 'or' nodes so 'a or b or c' yields [a, b, c]. A non-'or' node (a
// comparison, call, or even an 'and') is left a leaf, mirroring flatten_and_operands for the 'or'
// case so an 'if' condition can short-circuit a multi-operand 'or' the same way it does an 'and'
// (issue 1165 / 1162).
fn flatten_or_operands(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    operands: &var std::array::Array<i64>,
    bs: i64
) -> !void {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) == 2 {
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        try flatten_or_operands(ir_bytes, function_name, left, operands, bs);
        try flatten_or_operands(ir_bytes, function_name, right, operands, bs);
        return;
    }
    try operands.append(node);
    return;
}
// lower_void_then_body_assign lowers a '<target> = <value>;' reassignment statement inside a no-else
// void then-body (issue 1207). The formatter's leading-import sort branch reassigns six scalar carry
// locals after its try-call -- 'index = next_index;', 'cursor = last_import.end;', 'previous = ";";',
// 'last_top_level_decl = "import";', 'last = cast<u8>(10);', 'at_line_start = true;'
// (selfhost/src/parser/format.kizu:33-38) -- each updating a local bound before the then-body, not a
// fresh binding. It is shape-driven, not name-driven: the target must be a Var naming a local already
// resolvable in this function (so locals_spec is left unchanged and no binding is fabricated), the
// value must be one of the scalar/slice expression kinds the generic expr lowering handles (Var /
// FieldExpr / String / CastExpr / Bool / non-short-circuit Binary / non-method Call / a 'try <call>'
// over such a free call, whose failure propagates through this function's own error union), and the
// value's lowered LLVM type must match the target's resolved type. The lowered value binds to a
// fresh MirAliasAssign name, never to the target itself, so rendering cannot redefine the original
// SSA name. The
// enclosing no-else void if later compares incoming vs then-body aliases and emits merge metadata
// for the fall-through join.
fn void_then_assign_binary_op_supported(op: []u8) -> bool {
    return std::mem::equal_bytes(op, "add") or std::mem::equal_bytes(op, "sub") or
        std::mem::equal_bytes(op, "mul") or std::mem::equal_bytes(op, "div") or
        std::mem::equal_bytes(op, "eq") or std::mem::equal_bytes(op, "not-eq") or
        std::mem::equal_bytes(op, "lt") or std::mem::equal_bytes(op, "lte") or
        std::mem::equal_bytes(op, "gt") or std::mem::equal_bytes(op, "gte");
}

fn void_then_assignment_value_supported(
    ir_bytes: []u8,
    function_name: []u8,
    value: i64,
    value_kind: []u8,
    bs: i64
) -> !bool {
    if std::mem::equal_bytes(value_kind, "Var") or
        std::mem::equal_bytes(value_kind, "FieldExpr") or
        std::mem::equal_bytes(value_kind, "String") or
        std::mem::equal_bytes(value_kind, "CastExpr") or
        std::mem::equal_bytes(value_kind, "Bool") {
        return true;
    }
    if std::mem::equal_bytes(value_kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, value, bs
        );
        return void_then_assign_binary_op_supported(op);
    }
    if std::mem::equal_bytes(value_kind, "Call") {
        return !(try callee_is_field_expr(ir_bytes, function_name, value, bs));
    }
    // A 'try <call>' value (TryExpr) reassigns the target with the success value of a
    // free try-call, propagating the failure through this function's own error union via
    // the shared value-position TryUnwrap machinery (lower_expr_into_local_aliases /
    // append_try_unwrap_expr). The inner must be a free Call (not a field-mode method
    // call), the same shape the non-try Call branch admits, so the generic expr lowering
    // and the id-suffixed t<id>_try_fail/_try_cont labels (never colliding with if/then
    // labels) carry it without a method-receiver special case (parse_impl_decl's
    // 'method = try parse_directive_decl(...)', issue 1207).
    if std::mem::equal_bytes(value_kind, "TryExpr") {
        let inner_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "value", 0, bs
        );
        let inner_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, inner_node, bs
        );
        if !std::mem::equal_bytes(inner_kind, "Call") {
            return false;
        }
        return !(try callee_is_field_expr(ir_bytes, function_name, inner_node, bs));
    }
    return false;
}

fn lower_void_then_body_assign(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !VoidAssignLowerResult {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: void then-body assignment target must be a local");
    }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target, bs
    );
    // Resolving the target's LLVM type proves it is a local bound before the then-body (an unbound
    // name surfaces 'local type not found' rather than being silently accepted) and yields the type
    // the reassigned value must carry.
    let target_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, target_name, bs, call_arg_type_cache
    );
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !(try void_then_assignment_value_supported(
        ir_bytes, function_name, value, value_kind, bs
    )) {
        if std::mem::equal_bytes(value_kind, "Binary") {
            return error("compiled mir: void then-body assignment value kind not yet supported: Binary");
        }
        if std::mem::equal_bytes(value_kind, "Call") {
            return error("compiled mir: void then-body assignment value kind not yet supported: Call");
        }
        return error("compiled mir: void then-body assignment value kind not yet supported");
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let value_type = try expr_inst_llvm_type_by_id(&insts, result_id);
    if !std::mem::equal_bytes(value_type, target_type) {
        return error("compiled mir: void then-body assignment operand type mismatch");
    }
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    let output_name = try void_then_alias_name(alias_counter);
    try stmts.append(compiled_mir::alias_assign_stmt(
        target_name, output_name, target_type, result_id, insts
    ));
    try set_local_alias(aliases, target_name, output_name);
    return VoidAssignLowerResult {
        string_counter: string_counter + expr_strings,
        temp_counter: next_temp,
        try_counter: try_counter,
        alias_counter: alias_counter + 1
    };
}

fn lower_induction_init_alias(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !VoidAssignLowerResult {
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "name", 0, bs
    );
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, name_node, bs
    );
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if std::mem::equal_bytes(value_kind, "Call") or
        std::mem::equal_bytes(value_kind, "TryExpr") {
        return VoidAssignLowerResult {
            string_counter: string_counter,
            temp_counter: temp_counter,
            try_counter: 0,
            alias_counter: alias_counter
        };
    }
    let target_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, target_name, bs, call_arg_type_cache
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let value_type = try expr_inst_llvm_type_by_id(&insts, result_id);
    if !std::mem::equal_bytes(value_type, target_type) {
        return error("compiled mir: induction alias init type mismatch");
    }
    let output_name = try void_then_alias_name(alias_counter);
    let expr_strings = try count_strings_in_insts(&insts);
    let expr_len = insts.len();
    try stmts.append(compiled_mir::alias_assign_stmt(
        target_name, output_name, target_type, result_id, insts
    ));
    try set_local_alias(aliases, target_name, output_name);
    return VoidAssignLowerResult {
        string_counter: string_counter + expr_strings,
        temp_counter: temp_counter + expr_len,
        try_counter: 0,
        alias_counter: alias_counter + 1
    };
}
fn return_body_advance(
    stmt: &compiled_mir::MirStmt,
    base_temp: i64,
    base_string: i64
) -> !MultiIfLowerResult {
    match stmt {
        ReturnCall(payload) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string + try compiled_mir_lower_call::count_string_args(
                &payload.call_args
            ),
            try_counter: 0,
            alias_counter: 0
        };,
        ReturnNotTryCall(payload) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string + try compiled_mir_lower_call::count_string_args(
                &payload.call_args
            ),
            try_counter: 0,
            alias_counter: 0
        };,
        ReturnExpr(payload) => return try return_expr_advance(
            &payload.expr_insts, base_temp, base_string
        );,
        ReturnError(payload) => return try return_expr_advance(
            &payload.expr_insts, base_temp, base_string
        );,
        ReturnArrayGet(payload) => return try return_expr_advance(
            &payload.expr_insts, base_temp, base_string
        );,
        ReturnStruct(payload) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string + payload.struct_fields.len(),
            try_counter: 0,
            alias_counter: 0
        };,
        VoidReturnSuccess(_) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string,
            try_counter: 0,
            alias_counter: 0
        };,
        ReturnTryBinary(payload) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string + try compiled_mir_lower_call::count_string_args(
                &payload.call_args
            ),
            try_counter: 0,
            alias_counter: 0
        };,
        _ => return error("compiled mir: void then-body return did not lower to a return statement");,
    }
}

// reserved_nested_base maps a control construct's index to the base its nested children use to
// namespace their LLVM block labels ('base * 1000 + body_index + 1'). A control construct that is
// the function's first top-level statement carries index 0, so its children would encode into
// bucket 0 = {1, 2, ...} -- exactly the numbers sibling top-level statements use for their own
// if<n>/loop<n> labels. clang does not reject the resulting duplicate block labels; it silently
// merges the same-named blocks, producing a malformed, non-terminating CFG (the issue 1157 hang in
// parse_ident_top_level_decl, whose leading 'if try is_token_text("test")' nests an 'if public'
// that collides with the sibling top-level 'if try is_token_text("impl")'). To reserve bucket 0,
// an index-0 parent namespaces its children under the function's top-level statement count instead:
// that bucket (statement_count * 1000) sits one bucket past every sibling's bucket and own label,
// so the labels stay disjoint. Every other statement (index >= 1) and every already-nested
// encoding (index >= 1) is returned unchanged, so only the first top-level statement's children
// move. Only an If can be a top-level statement-0 control construct -- a top-level while always
// follows its induction/seed init at an earlier statement -- so only the if-body encoders consult
// this.
fn reserved_nested_base(
    index: i64,
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !i64 {
    if index != 0 {
        return index;
    }
    return try ir_contract::body_edge_count_from(ir_bytes, function_name, 0, "statement", bs);
}

// lower_void_then_body lowers the statement list of a no-else void multi-statement if-then block
// into then_body_stmts, dispatching each statement by kind through the same per-kind lowering the
// top-level body loop uses. It is shape-driven, not name-driven: a then-block whose controlling
// statement is not a single Return is a side-effecting body (let bindings, nested ifs, call
// statements, assignments, and terminal returns), so it descends into the statement list rather
// than the Return-only then-kind machinery. A Return must be the final statement; the result marks
// that the then branch does not merge into the continuation. The Let, If, and ExprStmt dispatches
// are exercised today: the leading_imports sort branch at selfhost/src/parser/format.kizu:28 opens
// with two 'let' bindings ('next_index', 'last_import'), then a nested
// 'if !has_line_comment_between(...) { ... }' (selfhost/src/parser/format.kizu:31) whose own void
// then-body opens with a try-call statement 'try append_sorted_imports(...)'
// (selfhost/src/parser/format.kizu:32). The nested 'if' dispatches through
// lower_multi_if_statement -- the same if-lowering the top-level loop uses, which recognizes the
// void then-block shape and descends here again -- and that inner ExprStmt dispatches through
// lower_multi_expr_statement. The following Assign statements bind fresh aliases, and nested
// lower_multi_if_statement calls thread try_counter / alias_counter so the rendered void then-body
// can merge through its fall-through join without try-label or SSA-name collisions.
fn lower_void_then_body(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    then_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    then_body_stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !VoidBodyLowerResult {
    var body_locals = locals_spec;
    var body_strings = string_counter;
    var body_temps = temp_counter;
    var body_tries = try_counter;
    var body_alias_counter = alias_counter;
    // Namespace base for this block's nested-if labels. Identity for an already-nested block
    // (if_index >= 1); for the function's first top-level statement (if_index 0) it resolves to the
    // top-level statement count so the children clear bucket 0 (see reserved_nested_base, issue 1157).
    let child_namespace = try reserved_nested_base(if_index, ir_bytes, function_name, bs);
    var body_index = 0;
    var body_returns = false;
    var body_scan_from = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, then_node, bs
    );
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, then_node, "statement", body_index, body_scan_from
        );
        if statement < 0 {
            break;
        }
        let stmt_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, statement, bs
        );
        body_scan_from = stmt_sf;
        let stmt_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, statement, stmt_sf
        );
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                body_locals,
                statement,
                body_strings,
                body_temps,
                body_tries,
                aliases,
                then_body_stmts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_strings = let_result.string_counter;
            body_temps = let_result.temp_counter;
            body_tries = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(stmt_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    body_locals,
                    statement,
                    body_strings,
                    body_temps,
                    body_tries,
                    body_alias_counter,
                    child_namespace * 1000 + body_index + 1,
                    aliases,
                    then_body_stmts,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                body_strings = if_result.string_counter;
                body_temps = if_result.temp_counter;
                body_tries = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        body_locals,
                        statement,
                        body_strings,
                        body_temps,
                        body_tries,
                        aliases,
                        then_body_stmts,
                        bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                    body_strings = expr_result.string_counter;
                    body_tries = expr_result.try_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "Assign") {
                        // The nested then-body's try-call statement is followed by six scalar
                        // reassignments ('index = next_index;' ..  'at_line_start = true;',
                        // selfhost/src/parser/format.kizu:33-38), each updating a local bound
                        // before the then-body. lower_void_then_body_assign lowers the value
                        // through the generic expr lowering and binds a fresh AliasAssign so the
                        // join can merge the updated local without redefining the source SSA name
                        // (issue 1207).
                        let assign_result = try lower_void_then_body_assign(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            body_locals,
                            statement,
                            body_strings,
                            body_temps,
                            body_tries,
                            body_alias_counter,
                            aliases,
                            then_body_stmts,
                            bs,
                            ir_lookup_index, call_arg_type_cache
                        );
                        body_strings = assign_result.string_counter;
                        body_temps = assign_result.temp_counter;
                        body_tries = assign_result.try_counter;
                        body_alias_counter = assign_result.alias_counter;
                    } else {
                        if std::mem::equal_bytes(stmt_kind, "Return") {
                            let after_return = try ir_contract::body_child_sequence_or_minus_one_from(
                                ir_bytes, function_name, then_node, "statement",
                                body_index + 1, body_scan_from
                            );
                            if after_return >= 0 {
                                return error("compiled mir: void then-body return must be final");
                            }
                            let return_stmt = try lower_multi_return_statement(
                                ir_bytes,
                                function_name,
                                module_prefix,
                                llvm_return_type,
                                body_locals,
                                statement,
                                body_strings,
                                body_temps,
                                aliases,
                                bs,
                                ir_lookup_index, call_arg_type_cache
                            );
                            try then_body_stmts.append(return_stmt);
                            let appended = try then_body_stmts.at(then_body_stmts.len() - 1);
                            let advance = try return_body_advance(
                                &appended, body_temps, body_strings
                            );
                            body_strings = advance.string_counter;
                            body_temps = advance.temp_counter;
                            body_returns = true;
                        } else {
                            return error("compiled mir: unsupported then-body statement kind");
                        }
                    }
                }
            }
        }
        body_index = body_index + 1;
        if body_returns {
            break;
        }
    }
    return VoidBodyLowerResult {
        locals_spec: body_locals,
        string_counter: body_strings,
        temp_counter: body_temps,
        try_counter: body_tries,
        alias_counter: body_alias_counter,
        body_returns: body_returns
    };
}

fn copy_aliases_into(
    aliases: &var std::array::Array<LocalAliasState>,
    source_aliases: &std::array::Array<LocalAliasState>
) -> !void {
    var index = 0;
    while index < source_aliases.len() {
        let state = try source_aliases.at(index);
        try set_local_alias(aliases, state.source_name, state.current_name);
        index = index + 1;
    }
    return;
}

fn append_void_if_else_merge_for_source(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    source_name: []u8,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    then_aliases: &std::array::Array<LocalAliasState>,
    else_aliases: &std::array::Array<LocalAliasState>,
    merge_vars: &var std::array::Array<compiled_mir::MirIfMergeVar>,
    bs: i64
) -> !i64 {
    // A shadowed name is handled by per-binding SSA rename, not by a join phi: a 'let <name>'
    // inside either arm is an independent value that dies at the arm's end, so its branch alias
    // must never merge into the enclosing scope's binding of the same name.
    if try let_binding_is_shadowed(ir_bytes, function_name, source_name, bs) {
        return alias_counter;
    }
    let input_name = try local_alias_current_name(aliases, source_name);
    let then_name = try local_alias_current_name(then_aliases, source_name);
    let else_name = try local_alias_current_name(else_aliases, source_name);
    if std::mem::equal_bytes(input_name, then_name) and
        std::mem::equal_bytes(input_name, else_name) {
        return alias_counter;
    }
    let output_name = try void_then_alias_name(alias_counter);
    let merge_type = try compiled_mir_types::resolve_value_llvm_type(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        source_name,
        bs
    );
    try merge_vars.append(compiled_mir::if_else_merge_var(
        source_name,
        input_name,
        then_name,
        else_name,
        output_name,
        merge_type
    ));
    try set_local_alias(aliases, source_name, output_name);
    return alias_counter + 1;
}

fn append_void_if_else_merge_vars(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    then_aliases: &std::array::Array<LocalAliasState>,
    else_aliases: &std::array::Array<LocalAliasState>,
    merge_vars: &var std::array::Array<compiled_mir::MirIfMergeVar>,
    bs: i64
) -> !i64 {
    var merge_alias_counter = alias_counter;
    var then_index = 0;
    while then_index < then_aliases.len() {
        let state = try then_aliases.at(then_index);
        merge_alias_counter = try append_void_if_else_merge_for_source(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            state.source_name,
            merge_alias_counter,
            aliases,
            then_aliases,
            else_aliases,
            merge_vars,
            bs
        );
        then_index = then_index + 1;
    }
    var else_index = 0;
    while else_index < else_aliases.len() {
        let state = try else_aliases.at(else_index);
        if (try local_alias_index(then_aliases, state.source_name)) < 0 {
            merge_alias_counter = try append_void_if_else_merge_for_source(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                state.source_name,
                merge_alias_counter,
                aliases,
                then_aliases,
                else_aliases,
                merge_vars,
                bs
            );
        }
        else_index = else_index + 1;
    }
    return merge_alias_counter;
}

fn lower_void_if_else_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    string_counter: i64,
    cond_result: i64,
    cond_insts: &std::array::Array<compiled_mir::MirExprInst>,
    then_node: i64,
    else_node: i64,
    then_string_base: i64,
    then_base: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    var then_body_stmts =
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var merge_vars =
        std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator());
    var then_aliases = try copy_local_aliases(aliases);
    defer then_aliases.deinit();
    let then_body = try lower_void_then_body(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        then_node,
        then_string_base,
        then_base,
        try_counter,
        alias_counter,
        if_index,
        &var then_aliases,
        &var then_body_stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    var else_body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var else_aliases = try copy_local_aliases(aliases);
    defer else_aliases.deinit();
    let else_body = try lower_void_then_body(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        else_node,
        then_body.string_counter,
        then_body.temp_counter,
        then_body.try_counter,
        then_body.alias_counter,
        // Else-body nested-if namespace base: the then base * 1000 + 500 reserves the else its own
        // sub-bucket above the then body's range. reserved_nested_base keeps the statement-0 case
        // (if_index 0) out of bucket 0 here too, matching the then body (issue 1157).
        (try reserved_nested_base(if_index, ir_bytes, function_name, bs)) * 1000 + 500,
        &var else_aliases,
        &var else_body_stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    var merge_alias_counter = else_body.alias_counter;
    if then_body.body_returns and else_body.body_returns {
        return error("compiled mir: void if/else with both branches returning not yet supported");
    }
    if then_body.body_returns {
        try copy_aliases_into(aliases, &else_aliases);
    } else {
        if else_body.body_returns {
            try copy_aliases_into(aliases, &then_aliases);
        } else {
            merge_alias_counter = try append_void_if_else_merge_vars(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                else_body.alias_counter,
                aliases,
                &then_aliases,
                &else_aliases,
                &var merge_vars,
                bs
            );
        }
    }
    try stmts.append(compiled_mir::if_else_void_body_stmt(
        if_index,
        string_counter,
        cond_result,
        try compiled_mir::copy_expr_insts(cond_insts),
        then_body_stmts,
        else_body_stmts,
        merge_vars
    ));
    return MultiIfLowerResult {
        temp_counter: else_body.temp_counter,
        string_counter: else_body.string_counter,
        try_counter: else_body.try_counter,
        alias_counter: merge_alias_counter
    };
}

fn lower_void_if_no_else_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    cond_result: i64,
    cond_insts: &std::array::Array<compiled_mir::MirExprInst>,
    cond_short_circuit: i64,
    cond_rhs_result: i64,
    cond_rhs_insts: &std::array::Array<compiled_mir::MirExprInst>,
    cond_extra_operands: &std::array::Array<compiled_mir::MirCondOperand>,
    then_node: i64,
    then_string_base: i64,
    then_base: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    try require_void_then_block_no_else(ir_bytes, function_name, statement, bs);
    var then_body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var merge_vars = std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator());
    var branch_aliases = try copy_local_aliases(aliases);
    defer branch_aliases.deinit();
    let then_body = try lower_void_then_body(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        then_node,
        then_string_base,
        then_base,
        try_counter,
        alias_counter,
        if_index,
        &var branch_aliases,
        &var then_body_stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    var branch_alias_index = 0;
    var merge_alias_counter = then_body.alias_counter;
    if !then_body.body_returns {
        while branch_alias_index < branch_aliases.len() {
            let branch_state = try branch_aliases.at(branch_alias_index);
            // A shadowed name is handled by per-binding SSA rename, not by a join phi: each
            // 'let <name>' inside a branch is an independent value that dies at the branch end, so
            // its branch alias must never merge into the enclosing scope's binding of the same name.
            if try let_binding_is_shadowed(ir_bytes, function_name, branch_state.source_name, bs) {
                branch_alias_index = branch_alias_index + 1;
                continue;
            }
            let input_name = try local_alias_current_name(aliases, branch_state.source_name);
            if !std::mem::equal_bytes(input_name, branch_state.current_name) {
                let output_name = try void_then_alias_name(merge_alias_counter);
                let merge_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
                    ir_lookup_index,
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    branch_state.source_name,
                    bs, call_arg_type_cache
                );
                try merge_vars.append(compiled_mir::if_merge_var(
                    branch_state.source_name,
                    input_name,
                    branch_state.current_name,
                    output_name,
                    merge_type
                ));
                try set_local_alias(aliases, branch_state.source_name, output_name);
                merge_alias_counter = merge_alias_counter + 1;
            }
            branch_alias_index = branch_alias_index + 1;
        }
    }
    try stmts.append(compiled_mir::if_stmt(
        if_index,
        string_counter,
        cond_result,
        try compiled_mir::copy_expr_insts(cond_insts),
        cond_short_circuit,
        cond_rhs_result,
        try compiled_mir::copy_expr_insts(cond_rhs_insts),
        try compiled_mir::copy_cond_operands(cond_extra_operands),
        compiled_mir::MirIfThenKind::VoidBody,
        false,
        llvm_return_type,
        "",
        "",
        std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        then_string_base,
        then_body_stmts,
        merge_vars
    ));
    return MultiIfLowerResult {
        temp_counter: then_body.temp_counter,
        string_counter: then_body.string_counter,
        try_counter: then_body.try_counter,
        alias_counter: merge_alias_counter
    };
}

fn lower_void_if_body_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    cond_result: i64,
    cond_insts: &std::array::Array<compiled_mir::MirExprInst>,
    cond_short_circuit: i64,
    cond_rhs_result: i64,
    cond_rhs_insts: &std::array::Array<compiled_mir::MirExprInst>,
    cond_extra_operands: &std::array::Array<compiled_mir::MirCondOperand>,
    then_node: i64,
    then_string_base: i64,
    then_base: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, statement, "else", 0, sf
    );
    if else_node >= 0 {
        let else_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, else_node, bs
        );
        let else_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, else_node, else_sf
        );
        if !std::mem::equal_bytes(else_kind, "Empty") {
            if !std::mem::equal_bytes(else_kind, "Block") {
                return error("compiled mir: void if/else else arm must be a block");
            }
            if cond_short_circuit != 0 {
                return error("compiled mir: void if/else short-circuit condition not yet supported");
            }
            return try lower_void_if_else_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                string_counter,
                cond_result,
                cond_insts,
                then_node,
                else_node,
                then_string_base,
                then_base,
                try_counter,
                alias_counter,
                if_index,
                aliases,
                stmts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
        }
    }
    return try lower_void_if_no_else_statement(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        statement,
        string_counter,
        cond_result,
        cond_insts,
        cond_short_circuit,
        cond_rhs_result,
        cond_rhs_insts,
        cond_extra_operands,
        then_node,
        then_string_base,
        then_base,
        try_counter,
        alias_counter,
        if_index,
        aliases,
        stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
}

fn lower_multi_if_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    // sf tightens this If statement's own structural facts (condition/then/else edges, the
    // guard-then block's statement/return shape, the guard callee detail) to its body-node line
    // via the index; that subtree sorts at-or-after it, so a scan from sf is byte-identical to one
    // from bs. The try-call shape detectors that read back across the function, the then/else block
    // lowering recursion, and the index-keyed return-type resolver keep bs.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, sf
    );
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, sf
    );
    let cond_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, cond_node, bs);
    let then_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, then_node, bs);
    let cond_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, cond_node, cond_sf
    );
    // Prefix-not try-call conditions hoist the sub-expression try-call (issue 1165 / 1162). The
    // existing return-bool guard keeps its dedicated renderer; void then-bodies share the positive
    // try-call if lowering with inverted branch polarity, so failure propagation and alias merging
    // stay on the same path.
    var guard_not_try = -1;
    if std::mem::equal_bytes(cond_kind, "Prefix") {
        guard_not_try = try prefix_not_try_call_inner_or_minus_one(
            ir_bytes, function_name, module_prefix, cond_node, cond_sf, ir_lookup_index
        );
    }
    if guard_not_try >= 0 {
        let guard_then_extra = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, then_node, "statement", 1, sf
        );
        if guard_then_extra < 0 {
            let guard_then_stmt = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, then_node, "statement", 0, sf
            );
            let guard_then_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, guard_then_stmt, sf
            );
            if std::mem::equal_bytes(guard_then_kind, "Return") {
                let guard_ret_value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, guard_then_stmt, "value", 0, sf
                );
                let guard_ret_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, guard_ret_value, sf
                );
                if std::mem::equal_bytes(guard_ret_kind, "Bool") {
                    // The guard is rendered then-only (the negation returns the bool or falls through
                    // to the join), so an else arm with a real body would be silently dropped: reject
                    // it as an explicit error rather than mis-lower it (issue 1165 / 1162).
                    try require_if_not_try_guard_no_else(ir_bytes, function_name, statement, sf);
                    let guard_token = try ir_contract::body_token_or_empty_from(
                        ir_bytes, function_name, guard_ret_value, sf
                    );
                    let guard_bool_value = std::mem::equal_bytes(guard_token, "true");
                    let guard_error_union = try compiled_mir_types::lower_call_return_type_indexed(
                        ir_lookup_index,
                        ir_bytes, function_name, module_prefix, guard_not_try, bs
                    );
                    let guard_callee_name = try compiled_mir_types::lower_call_callee_name(
                        ir_bytes, function_name, module_prefix, guard_not_try, sf
                    );
                    let guard_module_prefix = try compiled_mir_types::lower_call_module_prefix(
                        ir_bytes, function_name, module_prefix, guard_not_try, sf
                    );
                    let guard_args = try lower_call_args_with_local_aliases_cached(
                        ir_bytes, function_name, module_prefix, locals_spec, guard_not_try,
                        string_counter, aliases, bs, ir_lookup_index, call_arg_type_cache
                    );
                    let guard_arg_strings = try compiled_mir_lower_call::count_string_args(&guard_args);
                    try stmts.append(compiled_mir::if_not_try_call_return_bool_stmt(
                        guard_error_union, llvm_return_type, guard_module_prefix, guard_callee_name,
                        guard_bool_value, string_counter, guard_args
                    ));
                    return MultiIfLowerResult {
                        temp_counter: temp_counter,
                        string_counter: string_counter + guard_arg_strings,
                        try_counter: try_counter,
                        alias_counter: alias_counter
                    };
                }
            }
        }
        return try lower_try_call_void_if(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            then_node,
            guard_not_try,
            string_counter,
            temp_counter,
            try_counter,
            alias_counter,
            if_index,
            false,
            aliases,
            stmts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    var positive_try = -1;
    if std::mem::equal_bytes(cond_kind, "TryExpr") {
        positive_try = try positive_try_call_condition_inner_or_minus_one(
            ir_bytes, function_name, module_prefix, cond_node, cond_sf, ir_lookup_index
        );
    }
    if positive_try >= 0 {
        return try lower_try_call_void_if(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            then_node,
            positive_try,
            string_counter,
            temp_counter,
            try_counter,
            alias_counter,
            if_index,
            true,
            aliases,
            stmts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    var cond_short_circuit = 0;
    if std::mem::equal_bytes(cond_kind, "Binary") {
        cond_short_circuit = try short_circuit_kind(ir_bytes, function_name, cond_node, cond_sf);
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_rhs_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_extra_operands = std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator());
    var cond_result = -1;
    var cond_rhs_result = -1;
    var last_cond_result = -1;
    var cond_strings = 0;
    if cond_short_circuit == 0 {
        cond_result = try lower_expr_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            cond_node,
            string_counter,
            temp_counter,
            &var cond_insts,
            aliases,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        cond_strings = try count_strings_in_insts(&cond_insts);
        last_cond_result = cond_result;
    } else {
        if cond_short_circuit == 1 {
            // An 'and' header lowers as a short-circuit chain of leaf operands evaluated
            // left to right, each guarded by every earlier operand (issue 1165 / 1162).
            // The first operand fills cond_insts (the unguarded entry block), the second
            // fills cond_rhs_insts (the first guarded block), and any further operands fill
            // cond_extra_operands. A nested 'or' is left a leaf by flatten_and_operands and
            // rejected here as a near-miss explicit error rather than eager-evaluated.
            var operands = std::array::Array<i64>(std::mem::page_allocator());
            try flatten_and_operands(ir_bytes, function_name, cond_node, &var operands, bs);
            var validate_index = 0;
            while validate_index < operands.len() {
                let operand_node = try operands.get(validate_index);
                if (try short_circuit_kind(ir_bytes, function_name, operand_node, bs)) != 0 {
                    return error("compiled mir: nested short-circuit and/or unsupported");
                }
                validate_index = validate_index + 1;
            }
            let op0 = try operands.get(0);
            cond_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                op0,
                string_counter,
                temp_counter,
                &var cond_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            var acc_strings = try count_strings_in_insts(&cond_insts);
            var acc_temp = temp_counter + cond_insts.len();
            let op1 = try operands.get(1);
            cond_rhs_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                op1,
                string_counter + acc_strings,
                acc_temp,
                &var cond_rhs_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            acc_strings = acc_strings + try count_strings_in_insts(&cond_rhs_insts);
            acc_temp = acc_temp + cond_rhs_insts.len();
            last_cond_result = cond_rhs_result;
            var extra_index = 2;
            while extra_index < operands.len() {
                var operand_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                let operand_node = try operands.get(extra_index);
                let operand_result = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    operand_node,
                    string_counter + acc_strings,
                    acc_temp,
                    &var operand_insts,
                    aliases,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                acc_strings = acc_strings + try count_strings_in_insts(&operand_insts);
                acc_temp = acc_temp + operand_insts.len();
                last_cond_result = operand_result;
                try cond_extra_operands.append(
                    compiled_mir::cond_operand(operand_result, operand_insts)
                );
                extra_index = extra_index + 1;
            }
            cond_strings = acc_strings;
            operands.deinit();
        } else {
            // An 'or' header lowers as a short-circuit chain of leaf operands evaluated left to
            // right, each guarded by every earlier operand having been false. The first operand
            // fills cond_insts (the unguarded entry block), the second fills cond_rhs_insts (the
            // first guarded block), and any further operands fill cond_extra_operands, mirroring the
            // 'and' chain above so the same operand-block renderer drives both -- it just routes a
            // true edge to the then block and a false edge to the next operand (issue 1165 / 1162).
            // A nested 'and' is left a leaf by flatten_or_operands and rejected here as a near-miss
            // explicit error rather than eager-evaluated.
            var operands = std::array::Array<i64>(std::mem::page_allocator());
            try flatten_or_operands(ir_bytes, function_name, cond_node, &var operands, bs);
            var validate_index = 0;
            while validate_index < operands.len() {
                let operand_node = try operands.get(validate_index);
                if (try short_circuit_kind(ir_bytes, function_name, operand_node, bs)) != 0 {
                    return error("compiled mir: nested short-circuit and/or unsupported");
                }
                validate_index = validate_index + 1;
            }
            let op0 = try operands.get(0);
            cond_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                op0,
                string_counter,
                temp_counter,
                &var cond_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            var acc_strings = try count_strings_in_insts(&cond_insts);
            var acc_temp = temp_counter + cond_insts.len();
            let op1 = try operands.get(1);
            cond_rhs_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                op1,
                string_counter + acc_strings,
                acc_temp,
                &var cond_rhs_insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            acc_strings = acc_strings + try count_strings_in_insts(&cond_rhs_insts);
            acc_temp = acc_temp + cond_rhs_insts.len();
            last_cond_result = cond_rhs_result;
            var extra_index = 2;
            while extra_index < operands.len() {
                var operand_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                let operand_node = try operands.get(extra_index);
                let operand_result = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    operand_node,
                    string_counter + acc_strings,
                    acc_temp,
                    &var operand_insts,
                    aliases,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                acc_strings = acc_strings + try count_strings_in_insts(&operand_insts);
                acc_temp = acc_temp + operand_insts.len();
                last_cond_result = operand_result;
                try cond_extra_operands.append(
                    compiled_mir::cond_operand(operand_result, operand_insts)
                );
                extra_index = extra_index + 1;
            }
            cond_strings = acc_strings;
            operands.deinit();
        }
    }
    let then_string_base = string_counter + cond_strings;
    let then_base = last_cond_result + 1;
    let then_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, then_sf
    );
    let then_stmt_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, then_stmt, bs
    );
    let then_stmt_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, then_stmt, then_stmt_sf
    );
    // A continue-latch then-block ('{ <induction> = <induction> + <step>; continue; }') carries no
    // return value: it folds its increment into the loop's shared constant-step latch and branches
    // back to the loop head, so it lowers to a ContinueLatch if whose then-block the renderer turns
    // into 'br label %loop<N>_latch'. line_comment_has_blank_after is its first consumer (issue 1165
    // / 1162). It shares the single if_stmt append below: the then-block fields stay empty and the
    // temp / string counters do not advance.
    var is_continue_latch_then = false;
    let then_continue = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, then_node, "statement", 1, then_sf
    );
    if then_continue >= 0 {
        let then_continue_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, then_continue, bs
        );
        let then_continue_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, then_continue, then_continue_sf
        );
        if std::mem::equal_bytes(then_stmt_kind, "Assign") and
            std::mem::equal_bytes(then_continue_kind, "Continue") {
            is_continue_latch_then = true;
            let then_extra = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, then_node, "statement", 2, then_continue_sf
            );
            if then_extra >= 0 {
                return error("compiled mir: continue-latch then-block must be '<increment>; continue;'");
            }
            // Validate the increment is a foldable induction advance against its own target so a
            // near-miss assign is an explicit error rather than a silently dropped latch update; the
            // while lowering re-reads the target/step (or copy source) to drive the latch. The
            // advance is either a constant-step '<var> = <var> + <int>' increment or a copy-decrement
            // '<var> = <local>' copy (its local validated as a '<var> - <int>' decrement at the while
            // level through validate_copy_latch_source).
            let incr_target = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, then_stmt, "target", 0, bs
            );
            let incr_target_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, incr_target, bs
            );
            if !std::mem::equal_bytes(incr_target_kind, "Var") {
                return error("compiled mir: continue-latch increment target must be a var");
            }
            let incr_target_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, incr_target, bs
            );
            if !(try while_assign_is_induction_copy(ir_bytes, function_name, then_stmt, bs)) {
                let _step = try parse_induction_step(
                    ir_bytes, function_name, then_stmt, incr_target_name, bs
                );
            }
        }
    }
    if !is_continue_latch_then and !std::mem::equal_bytes(then_stmt_kind, "Return") {
        return try lower_void_if_body_statement(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            cond_result,
            &cond_insts,
            cond_short_circuit,
            cond_rhs_result,
            &cond_rhs_insts,
            &cond_extra_operands,
            then_node,
            then_string_base,
            then_base,
            try_counter,
            alias_counter,
            if_index,
            aliases,
            stmts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    var then_kind = compiled_mir::MirIfThenKind::ContinueLatch;
    var bool_value = false;
    var call_type = llvm_return_type;
    var then_module_prefix = "";
    var callee_name = "";
    var call_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var then_result = -1;
    var then_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var then_struct_fields = std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator());
    var then_body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var merge_vars = std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator());
    var then_struct_strings = 0;
    var next_temp = then_base;
    var new_string_counter = then_string_base;
    var new_try_counter = try_counter;
    var new_alias_counter = alias_counter;
    if !is_continue_latch_then {
        let ret_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_stmt, "value", 0, then_stmt_sf
        );
        let ret_value_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, ret_value, bs
        );
        let ret_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, ret_value, ret_value_sf
        );
        then_kind = compiled_mir::MirIfThenKind::ReturnExpr;
        // 'if <cond> { return try <callee>(<args>); }' whose callee shares this
        // function's error-union return is an identity tail: unwrap it to the inner
        // call here (validating the error-union match) so the existing Call branch
        // below lowers it as a ReturnCall without adding nesting depth.
        let then_return_value = try unwrap_then_identity_try(
            ir_bytes, function_name, module_prefix, llvm_return_type, ret_value, ret_kind, bs
        );
        let resolved_ret_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, then_return_value, bs
        );
        if std::mem::equal_bytes(resolved_ret_kind, "Empty") {
            then_kind = compiled_mir::MirIfThenKind::VoidReturnSuccess;
        } else {
        if std::mem::equal_bytes(resolved_ret_kind, "Bool") {
            let token = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, then_return_value, bs
            );
            then_kind = compiled_mir::MirIfThenKind::ReturnBool;
            bool_value = std::mem::equal_bytes(token, "true");
        } else {
            if std::mem::equal_bytes(resolved_ret_kind, "Call") {
                if try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, then_return_value, bs) {
                    then_kind = compiled_mir::MirIfThenKind::ReturnError;
                    let message_node = try ir_contract::body_child_sequence_from(
                        ir_bytes, function_name, then_return_value, "arg", 0, bs
                    );
                    then_result = try lower_expr_with_local_aliases(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        message_node,
                        then_string_base,
                        then_base,
                        &var then_insts,
                        aliases,
                        bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                } else {
                call_type = try compiled_mir_types::lower_call_return_type_indexed(
                    ir_lookup_index,
                    ir_bytes, function_name, module_prefix, then_return_value, bs
                );
                callee_name = try compiled_mir_types::lower_call_callee_name(
                    ir_bytes, function_name, module_prefix, then_return_value, bs
                );
                call_args = try lower_call_args_with_local_aliases_cached(
                    ir_bytes, function_name, module_prefix, locals_spec, then_return_value, then_string_base,
                    aliases, bs, ir_lookup_index, call_arg_type_cache
                );
                then_kind = compiled_mir::MirIfThenKind::ReturnCall;
                then_module_prefix = try compiled_mir_types::lower_call_module_prefix(
                    ir_bytes, function_name, module_prefix, then_return_value, bs
                );
                }
            } else {
                if std::mem::equal_bytes(resolved_ret_kind, "StructLiteralExpr") {
                    // A struct-literal then-block such as a return of PayloadSpan { .. }
                    // reuses the generic struct-field lowering. The struct SSA and global
                    // names are seeded from then_string_base, and the string counter then
                    // advances by the field count so a later then-block in the same
                    // function never reuses the same per-field SSA names.
                    then_struct_fields = try compiled_mir_lower_struct::lower_struct_fields(
                        ir_bytes, function_name, module_prefix, locals_spec, then_return_value, bs
                    );
                    then_kind = compiled_mir::MirIfThenKind::ReturnStruct;
                    then_struct_strings = then_struct_fields.len();
                } else {
                    then_result = try lower_expr_with_local_aliases(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        then_return_value,
                        then_string_base,
                        then_base,
                        &var then_insts,
                        aliases,
                        bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                }
            }
        }
        }
        let then_call_strings = try compiled_mir_lower_call::count_string_args(&call_args);
        let then_expr_strings = try count_strings_in_insts(&then_insts);
        new_string_counter = then_string_base + then_call_strings + then_expr_strings + then_struct_strings;
        if then_kind == compiled_mir::MirIfThenKind::ReturnCall {
            next_temp = then_base + 1;
        }
        if then_kind == compiled_mir::MirIfThenKind::ReturnExpr {
            next_temp = then_result + 1;
        }
        if then_kind == compiled_mir::MirIfThenKind::ReturnError {
            next_temp = then_result + 1;
        }
    }
    try stmts.append(compiled_mir::if_stmt(
            if_index,
            string_counter,
            cond_result,
            cond_insts,
            cond_short_circuit,
            cond_rhs_result,
            cond_rhs_insts,
            cond_extra_operands,
            then_kind,
            bool_value,
            call_type,
            then_module_prefix,
            callee_name,
            call_args,
            then_result,
            then_insts,
            then_struct_fields,
            then_string_base,
            then_body_stmts,
            merge_vars
    ));
    return MultiIfLowerResult {
        temp_counter: next_temp,
        string_counter: new_string_counter,
        try_counter: new_try_counter,
        alias_counter: new_alias_counter
    };
}
// unwrap_then_identity_try resolves a then-block return value: a 'return try <call>;'
// whose callee shares the function's error-union return is an identity tail, so it
// unwraps to the inner call node (validated against the return type) for the existing
// ReturnCall path; any other value passes through unchanged.
fn unwrap_then_identity_try(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    ret_value: i64,
    ret_kind: []u8,
    bs: i64
) -> !i64 {
    if !std::mem::equal_bytes(ret_kind, "TryExpr") {
        return ret_value;
    }
    let try_inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, ret_value, "value", 0, bs
    );
    let try_inner_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, try_inner, bs
    );
    if !std::mem::equal_bytes(try_inner_kind, "Call") {
        return error("compiled mir: then-body return try must wrap a call");
    }
    let try_call_type = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, try_inner, bs
    );
    if !std::mem::equal_bytes(try_call_type, llvm_return_type) {
        return error("compiled mir: then-body return try must share the function's error union");
    }
    return try_inner;
}

// while_body_statement_count counts the statements in a while body Block by walking
// its "statement" child sequences until none remain.
fn while_body_statement_count(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    bs: i64
) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, body_node, "statement", count, bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}
// while_induction_var returns the counter a while loop carries: the target of the
// trailing 'name = name + step' increment that must close the loop body. The body's
// last statement must be that Assign to a Var (tracker 961).
fn while_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> ![]u8 {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        return error("compiled mir: while body must end with the induction increment");
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "Assign") {
        return error("compiled mir: while body must end with the induction increment");
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: induction increment target must be a var");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
}
// statement_is_induction_init reports whether a top-level let declares an induction counter
// of some while in the same function, by matching the let name against each while's induction
// variables. Both the primary counter (the trailing increment target) and every secondary
// lockstep counter (an earlier increment in the trailing run) are matched, so a 'var
// left_index = left + 1;' seed for a secondary counter is skipped at the top level and never
// emitted as a let that would redefine the loop-head phi %left_index (issue 1165 / 1162).
fn statement_is_induction_init(
    ir_bytes: []u8,
    function_name: []u8,
    let_statement: i64,
    statement_count: i64,
    bs: i64
) -> !bool {
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, name_node, bs
    );
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "While") {
            if try while_carries_induction_var(ir_bytes, function_name, statement, let_name, bs) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

fn assign_targets_var(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target, bs
    );
    return std::mem::equal_bytes(target_name, name);
}

fn no_else_if_then_assigns_to_var(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    if else_node >= 0 {
        let else_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, else_node, bs
        );
        if !std::mem::equal_bytes(else_kind, "Empty") {
            return false;
        }
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    return try block_assigns_to_var(ir_bytes, function_name, then_node, name, bs);
}

fn statement_assigns_to_var(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
    if std::mem::equal_bytes(kind, "Assign") {
        return try assign_targets_var(ir_bytes, function_name, statement, name, bs);
    }
    if std::mem::equal_bytes(kind, "If") {
        return try no_else_if_then_assigns_to_var(ir_bytes, function_name, statement, name, bs);
    }
    return false;
}

fn block_assigns_to_var(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    var index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", index, bs
        );
        if statement < 0 {
            return false;
        }
        if try statement_assigns_to_var(ir_bytes, function_name, statement, name, bs) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// induction_init_needs_prewhile_alias reports whether a skipped induction initializer still needs a
// concrete value before its loop phi: the variable is reassigned by a no-else then-block before the
// matching while, so the then-only branch join must merge the pre-branch value with the assigned
// value. Plain induction initializers keep the historical phi seed path and do not materialize an
// alias, preserving existing backend artifact contracts.
fn induction_init_needs_prewhile_alias(
    ir_bytes: []u8,
    function_name: []u8,
    let_statement: i64,
    let_index: i64,
    statement_count: i64,
    bs: i64
) -> !bool {
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, name_node, bs
    );
    var has_prewhile_assignment = false;
    var index = let_index + 1;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "While") {
            if try while_carries_induction_var(ir_bytes, function_name, statement, let_name, bs) {
                return has_prewhile_assignment;
            }
        }
        if std::mem::equal_bytes(kind, "If") {
            if try no_else_if_then_assigns_to_var(
                ir_bytes, function_name, statement, let_name, bs
            ) {
                has_prewhile_assignment = true;
            }
        }
        index = index + 1;
    }
    return false;
}
// while_carries_induction_var reports whether a while loop advances a counter named name,
// counting both the primary trailing increment target and every secondary increment in the
// trailing run (issue 1165 / 1162).
// while_assign_is_induction_copy reports whether a body Assign is a copy-decrement latch advance:
// a Var target and a plain Var value ('cursor = previous'). The continue-latch lowering validates
// the copied local is a genuine '<induction> - <int>' decrement of the target through
// validate_copy_latch_source before lowering it; here it only classifies the assign shape so the
// continue-latch marker recognizes a copy-decrement step alongside the constant-step one (issue
// 1165 / 1162).
fn while_assign_is_induction_copy(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    bs: i64
) -> !bool {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    return std::mem::equal_bytes(value_kind, "Var");
}
// if_carries_continue_increment reports whether an if statement is the continue-latch marker: a
// then-block of exactly two statements, an induction advance followed by a bare 'continue'. The
// advance is either a constant-step '<var> = <var> + <int>' increment (folded into the shared
// latch add) or a copy-decrement '<var> = <local>' copy whose local is a '<var> - <int>' decrement
// computed earlier in the loop body (driving the latch through latch_copy_var). Both shapes are
// foldable by lower_multi_while_continue_latch, so recognizing them here routes the loop to that
// dedicated path rather than the trailing-increment machinery (issue 1165 / 1162).
fn if_carries_continue_increment(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !bool {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if count != 2 {
        return false;
    }
    let increment = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let continue_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 1, bs
    );
    let continue_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, continue_stmt, bs
    );
    if !std::mem::equal_bytes(continue_kind, "Continue") {
        return false;
    }
    let increment_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, increment, bs
    );
    if !std::mem::equal_bytes(increment_kind, "Assign") {
        return false;
    }
    if try while_assign_is_constant_step(ir_bytes, function_name, increment, bs) {
        return true;
    }
    return try while_assign_is_induction_copy(ir_bytes, function_name, increment, bs);
}
// while_is_continue_latch reports whether a while loop advances its induction variable through a
// continue-latch: a body 'if <cond> { <induction> = <induction> + <step>; continue; }' whose
// then-block is a constant-step increment followed by 'continue', rather than a trailing increment
// assign. Such a loop has no trailing latch statement -- the increment lives inside the continue-if
// and the loop's non-continue path falls through to a 'return'. line_comment_has_blank_after is its
// first consumer (issue 1165 / 1162).
fn while_is_continue_latch(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var index = 0;
    while index < body_count {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "If") {
            if try if_carries_continue_increment(ir_bytes, function_name, stmt, bs) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}
// while_continue_increment_assign returns the '<induction> = <induction> + <step>' Assign node
// inside a continue-latch loop's body continue-if -- the first statement of the if whose then-block
// ends in 'continue' (issue 1165 / 1162).
fn while_continue_increment_assign(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !i64 {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var index = 0;
    while index < body_count {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "If") {
            if try if_carries_continue_increment(ir_bytes, function_name, stmt, bs) {
                let then_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, stmt, "then", 0, bs
                );
                return try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, then_node, "statement", 0, bs
                );
            }
        }
        index = index + 1;
    }
    return error("compiled mir: continue-latch increment not found");
}
// while_continue_induction_var returns the induction variable a continue-latch loop advances: the
// target of the '<induction> = <induction> + <step>' increment inside the body continue-if (issue
// 1165 / 1162).
fn while_continue_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> ![]u8 {
    let assign = try while_continue_increment_assign(ir_bytes, function_name, while_node, bs);
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: continue-latch increment target must be a var");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
}
// branch_arm_last_assign_or_minus_one returns the closing statement of a branch-merge arm block
// when it is an Assign, or -1 otherwise. A branch-merge induction latch advances the loop counter
// with the Assign that closes each terminal-if arm, so the arm classifiers key on this last
// statement (issue 1165 / 1162).
fn branch_arm_last_assign_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !i64 {
    let count = try while_body_statement_count(ir_bytes, function_name, block_node, bs);
    if count < 1 {
        return -1;
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, block_node, "statement", count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "Assign") {
        return -1;
    }
    return last_stmt;
}
// branch_arm_assign_target_or_empty returns the Var name a branch-merge arm assigns in its closing
// Assign, or "" when the arm does not end in an Assign to a Var (issue 1165 / 1162).
fn branch_arm_assign_target_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> ![]u8 {
    let assign = try branch_arm_last_assign_or_minus_one(ir_bytes, function_name, block_node, bs);
    if assign < 0 {
        return "";
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return "";
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
}
// branch_arm_is_constant_step reports whether a branch-merge arm closes with a constant-step
// '<var> = <var> + <int>' increment (the advance arm) rather than a loop-terminating jump such as
// 'index = format_tokens.len()' (issue 1165 / 1162).
fn branch_arm_is_constant_step(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !bool {
    let assign = try branch_arm_last_assign_or_minus_one(ir_bytes, function_name, block_node, bs);
    if assign < 0 {
        return false;
    }
    return try while_assign_is_constant_step(ir_bytes, function_name, assign, bs);
}
// while_branch_merge_terminal_if_or_minus_one returns the terminal branch-merge If node at the end
// of a while body, or -1 when the last body statement is not one. A branch-merge induction latch
// advances the loop counter inside a terminal if/else whose then- and else-blocks each END in an
// Assign to the same Var: one arm a constant-step '<var> = <var> + <int>' advance, the other a
// loop-terminating '<var> = <expr>' jump (e.g. 'index = format_tokens.len()' on format_source's eof
// arm) that drives the counter to the bound so the header comparison fails on the next test. Only
// this exact shape returns the If; every near miss -- last statement not an If, a missing/Empty
// else, an else that is an else-if (another If) rather than a block, an arm not ending in an Assign
// to a Var, the two arms targeting different vars, or neither/both arms being the constant-step
// advance -- returns -1 so callers classify without erroring. The dedicated lowering re-validates
// the shape with explicit errors before it lowers (issue 1165 / 1162).
fn while_branch_merge_terminal_if_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !i64 {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        return -1;
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "If") {
        return -1;
    }
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, last_stmt, "else", 0, bs
    );
    if else_node < 0 {
        return -1;
    }
    let else_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, else_node, bs);
    // A missing else is emitted as an Empty node; an else-if chains another If here. Neither is a
    // two-block branch merge.
    if std::mem::equal_bytes(else_kind, "Empty") or std::mem::equal_bytes(else_kind, "If") {
        return -1;
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "then", 0, bs
    );
    let then_target = try branch_arm_assign_target_or_empty(ir_bytes, function_name, then_node, bs);
    if std::mem::len(then_target) == 0 {
        return -1;
    }
    let else_target = try branch_arm_assign_target_or_empty(ir_bytes, function_name, else_node, bs);
    if std::mem::len(else_target) == 0 {
        return -1;
    }
    if !std::mem::equal_bytes(then_target, else_target) {
        return -1;
    }
    // Exactly one arm must advance by a constant step; the other is the loop-terminating jump.
    let then_step = try branch_arm_is_constant_step(ir_bytes, function_name, then_node, bs);
    let else_step = try branch_arm_is_constant_step(ir_bytes, function_name, else_node, bs);
    if then_step == else_step {
        return -1;
    }
    return last_stmt;
}
// while_is_branch_merge_latch reports whether a while loop advances its induction counter through a
// terminal branch-merge if/else (issue 1165 / 1162).
fn while_is_branch_merge_latch(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !bool {
    let if_node = try while_branch_merge_terminal_if_or_minus_one(
        ir_bytes, function_name, while_node, bs
    );
    return if_node >= 0;
}
// while_branch_merge_induction_var returns the induction variable a branch-merge latch advances:
// the common Assign target both terminal-if arms close on (issue 1165 / 1162).
fn while_branch_merge_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> ![]u8 {
    let if_node = try while_branch_merge_terminal_if_or_minus_one(
        ir_bytes, function_name, while_node, bs
    );
    if if_node < 0 {
        return error("compiled mir: while body is not a branch-merge induction latch");
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    return try branch_arm_assign_target_or_empty(ir_bytes, function_name, then_node, bs);
}

fn branch_merge_advance_block(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !i64 {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let else_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    let then_step = try branch_arm_is_constant_step(ir_bytes, function_name, then_node, bs);
    let else_step = try branch_arm_is_constant_step(ir_bytes, function_name, else_node, bs);
    if then_step == else_step {
        return error("compiled mir: branch-merge latch must have exactly one advance arm");
    }
    if then_step {
        return then_node;
    }
    return else_node;
}

fn branch_merge_exit_block(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !i64 {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let else_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    let then_step = try branch_arm_is_constant_step(ir_bytes, function_name, then_node, bs);
    let else_step = try branch_arm_is_constant_step(ir_bytes, function_name, else_node, bs);
    if then_step == else_step {
        return error("compiled mir: branch-merge latch must have exactly one exit arm");
    }
    if then_step {
        return else_node;
    }
    return then_node;
}

fn branch_merge_last_assign(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    message: []u8,
    bs: i64
) -> !i64 {
    let assign = try branch_arm_last_assign_or_minus_one(ir_bytes, function_name, block_node, bs);
    if assign < 0 {
        return error(message);
    }
    return assign;
}

fn branch_merge_values_match_bound(
    ir_bytes: []u8,
    function_name: []u8,
    left_node: i64,
    right_node: i64,
    bs: i64
) -> !bool {
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, right_kind) {
        return false;
    }
    if std::mem::equal_bytes(left_kind, "Var") {
        let left_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, left_node, bs
        );
        let right_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, right_node, bs
        );
        return std::mem::equal_bytes(left_name, right_name);
    }
    if std::mem::equal_bytes(left_kind, "Int") {
        let left_value = try ir_contract::body_int_value_from(
            ir_bytes, function_name, left_node, bs
        );
        let right_value = try ir_contract::body_int_value_from(
            ir_bytes, function_name, right_node, bs
        );
        return left_value == right_value;
    }
    if std::mem::equal_bytes(left_kind, "Call") {
        let left_callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, left_node, bs
        );
        let right_callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, right_node, bs
        );
        if !std::mem::equal_bytes(left_callee, right_callee) {
            return false;
        }
        let left_args = try compiled_mir_types::count_call_args(
            ir_bytes, function_name, left_node, bs
        );
        let right_args = try compiled_mir_types::count_call_args(
            ir_bytes, function_name, right_node, bs
        );
        return left_args == 0 and right_args == 0;
    }
    return false;
}

fn validate_branch_merge_exit_assign(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    cond_node: i64,
    exit_assign: i64,
    induction_var: []u8,
    string_counter: i64,
    temp_counter: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !void {
    let target_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, induction_var, bs, call_arg_type_cache
    );
    if !std::mem::equal_bytes(target_type, "i64") {
        return error("compiled mir: branch-merge induction target must be i64");
    }
    let cond_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, cond_node, bs);
    if !std::mem::equal_bytes(cond_kind, "Binary") {
        return error("compiled mir: branch-merge while header must compare the induction bound");
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "lt") {
        return error("compiled mir: branch-merge while header must use a less-than bound");
    }
    let header_left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, header_left, "Var", bs) {
        return error("compiled mir: branch-merge while header must read the induction variable");
    }
    let header_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, header_left, bs
    );
    if !std::mem::equal_bytes(header_var, induction_var) {
        return error("compiled mir: branch-merge while header must read the induction variable");
    }
    let header_bound = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    let exit_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, exit_assign, "target", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, exit_target, "Var", bs) {
        return error("compiled mir: branch-merge exit assignment target must be a var");
    }
    let exit_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, exit_target, bs
    );
    if !std::mem::equal_bytes(exit_target_name, induction_var) {
        return error("compiled mir: branch-merge exit assignment must target the induction variable");
    }
    let exit_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, exit_assign, "value", 0, bs
    );
    if !(try branch_merge_values_match_bound(
        ir_bytes, function_name, exit_value, header_bound, bs
    )) {
        return error("compiled mir: branch-merge exit assignment must set the induction to the loop bound");
    }
    var exit_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let exit_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        exit_value,
        string_counter,
        temp_counter,
        &var exit_insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let exit_type = try expr_inst_llvm_type_by_id(&exit_insts, exit_result);
    if !std::mem::equal_bytes(exit_type, target_type) {
        return error("compiled mir: branch-merge exit assignment type mismatch");
    }
    exit_insts.deinit();
    return;
}
fn while_carries_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    // A continue-latch loop has no trailing increment run; its induction variable is the target of
    // the increment inside the body continue-if (issue 1165 / 1162).
    if try while_is_continue_latch(ir_bytes, function_name, while_node, bs) {
        let continue_var = try while_continue_induction_var(ir_bytes, function_name, while_node, bs);
        return std::mem::equal_bytes(continue_var, name);
    }
    // A branch-merge latch loop has no trailing increment run either; its induction variable is the
    // common Assign target both arms of the terminal if/else close on (one arm a constant-step
    // advance, the other a loop-terminating jump to the bound). Recognizing it here keeps the
    // trailing-increment count below from erroring on the non-Assign (terminal If) tail (issue
    // 1165 / 1162).
    if try while_is_branch_merge_latch(ir_bytes, function_name, while_node, bs) {
        let merge_var = try while_branch_merge_induction_var(ir_bytes, function_name, while_node, bs);
        return std::mem::equal_bytes(merge_var, name);
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    // A leading-decrement loop has no trailing increment run either; its induction variable is the
    // target of the body-opening '<var> = <var> - <int>' self-decrement. Recognizing it here keeps
    // its 'var <var> = <init>' seed off the emitted-let path (the loop-head phi supplies the seed on
    // the preheader edge) and avoids the trailing-increment count erroring on its non-Assign tail
    // (issue 1165 / 1162).
    if try while_is_leading_decrement(ir_bytes, function_name, body_node, bs) {
        let first_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", 0, bs
        );
        let decrement_target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, first_stmt, "target", 0, bs
        );
        let decrement_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, decrement_target, bs
        );
        if std::mem::equal_bytes(decrement_name, name) {
            return true;
        }
        return try while_carries_scalar_var(ir_bytes, function_name, while_node, name, bs);
    }
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count > 0 {
        let latch_index = body_count - 1;
        let latch_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", latch_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, latch_stmt, "Assign", bs) {
            let target = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, latch_stmt, "target", 0, bs
            );
            if try node_kind_is(ir_bytes, function_name, target, "Var", bs) {
                let target_name = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, target, bs
                );
                if try value_cursor_latch_is_field_read(
                    ir_bytes, function_name, body_node, latch_index, target_name, bs
                ) {
                    return std::mem::equal_bytes(target_name, name);
                }
                // A value-cursor plain-call latch ('token = next_token(text, segment)',
                // parse_import_segments) reassigns the carried cursor through a non-try free call.
                // Like the field-read latch above, the cursor is carried by the value-cursor phi, not
                // an i64 trailing increment, so classify it here and return whether it is the queried
                // seed name -- otherwise the trailing-increment count below errors on the Call-valued
                // tail (the embedded value-cursor lowerer handles the loop itself).
                if try value_cursor_latch_is_plain_call(
                    ir_bytes, function_name, latch_stmt, target_name, bs
                ) {
                    return std::mem::equal_bytes(target_name, name);
                }
            }
        }
    }
    let latch_count = try while_trailing_increment_count(
        ir_bytes, function_name, body_node, body_count, bs
    );
    var index = body_count - latch_count;
    while index < body_count {
        let increment_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, increment_stmt, "target", 0, bs
        );
        let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
        if std::mem::equal_bytes(target_kind, "Var") {
            let target_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, target, bs
            );
            if std::mem::equal_bytes(target_name, name) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}
// InductionInit is the resolved 'var counter = <init>' loop-head phi seed. An integer
// literal initializer ('var index = 0') sets literal and leaves var_name empty; a
// parameter/local initializer ('var index = import_index') sets var_name to the source
// name and leaves literal at 0; a base-plus-offset initializer ('var left_index = left + 1')
// sets var_name to the base name and offset to the integer addend. The renderer prints
// %<var_name> on the preheader edge when var_name is non-empty and offset is zero, computes
// '%<var>_init = add i64 %<var_name>, offset' for a non-zero offset, and otherwise prints the
// literal (issue 1165 / 1162).
pub struct InductionInit {
    pub literal: i64,
    pub var_name: []u8,
    pub offset: i64,
}
// find_induction_init finds the 'var counter = <init>' initializer for the while at
// while_stmt_index and returns its loop-head phi seed. Only top-level Let statements that
// precede the while are considered, and the nearest preceding match wins, so two whiles
// reusing the same counter name each resolve their own initializer rather than aliasing
// the first one. Only an integer literal or a plain parameter/local name init is accepted;
// any other initializer shape is an explicit error so the restricted loop support never
// silently lowers a computed seed.
fn find_induction_init(
    ir_bytes: []u8,
    function_name: []u8,
    induction_var: []u8,
    while_stmt_index: i64,
    bs: i64
) -> !InductionInit {
    var found = false;
    var init_value = -1;
    var index = 0;
    while index < while_stmt_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, induction_var) {
                found = true;
                init_value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
            }
        }
        index = index + 1;
    }
    if !found {
        return error("compiled mir: induction variable initializer not found");
    }
    let value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, init_value, bs
    );
    if std::mem::equal_bytes(value_kind, "Int") {
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, init_value, bs
        );
        return InductionInit { literal: literal, var_name: "", offset: 0 };
    }
    if std::mem::equal_bytes(value_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, init_value, bs
        );
        return InductionInit { literal: 0, var_name: var_name, offset: 0 };
    }
    // 'var left_index = left + 1;' seeds the phi from a base parameter/local plus an integer
    // offset; the preheader computes the addend so two lockstep cursors can start one past
    // their respective import keywords (issue 1165 / 1162).
    if std::mem::equal_bytes(value_kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, init_value, bs
        );
        if !std::mem::equal_bytes(op, "add") {
            return error("compiled mir: induction base-plus-offset init must be an addition");
        }
        let base_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, init_value, "left", 0, bs
        );
        let offset_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, init_value, "right", 0, bs
        );
        let base_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, base_node, bs);
        let offset_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, offset_node, bs);
        if !std::mem::equal_bytes(base_kind, "Var") or !std::mem::equal_bytes(offset_kind, "Int") {
            return error("compiled mir: induction base-plus-offset init must be name + integer");
        }
        let base_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, base_node, bs);
        let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, offset_node, bs);
        return InductionInit { literal: 0, var_name: base_name, offset: offset };
    }
    return error("compiled mir: induction variable must be initialized to an integer or a parameter");
}
// find_induction_init_value_node returns the value node of the nearest preceding 'var counter =
// <value>' initializer for the while at while_stmt_index, without classifying the value. The
// continue-latch lowering uses it to detect a call-seeded init ('var cursor =
// line_end_including_break(source, comment_end)') and lower the call into the preheader; a
// non-call seed falls back to find_induction_init's literal/copy/offset classification (issue 1165
// / 1162).
fn find_induction_init_value_node(
    ir_bytes: []u8,
    function_name: []u8,
    induction_var: []u8,
    while_stmt_index: i64,
    bs: i64
) -> !i64 {
    var found = false;
    var init_value = -1;
    var index = 0;
    while index < while_stmt_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, induction_var) {
                found = true;
                init_value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
            }
        }
        index = index + 1;
    }
    if !found {
        return error("compiled mir: induction variable initializer not found");
    }
    return init_value;
}
// parse_induction_step validates the trailing 'name = name + <int>' increment for
// the induction variable and returns the integer step. Only this simple counter
// increment shape is accepted; anything else is rejected so the restricted loop
// support never silently lowers general assignment (tracker 961).
fn parse_induction_step(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    induction_var: []u8,
    bs: i64
) -> !i64 {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return error("compiled mir: induction increment must be an addition");
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return error("compiled mir: induction increment must be an addition");
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return error("compiled mir: induction increment must be name + integer");
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_name, induction_var) {
        return error("compiled mir: induction increment must add to the induction variable");
    }
    return try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
}
// while_assign_is_constant_step reports whether a body Assign is a constant-step
// 'name = name + <int>' induction increment: a Var target, a Binary add value whose left is
// that same Var and whose right is an integer literal. It backs the trailing-increment run
// detection that recognizes a multi-counter latch suffix (issue 1165 / 1162).
fn while_assign_is_constant_step(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    bs: i64
) -> !bool {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let target_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return false;
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    return std::mem::equal_bytes(left_name, target_name);
}
// while_trailing_increment_count returns the number of trailing latch statements at the end
// of a loop body. A loop-carried 'index = try <callee>(.., index);' try-call latch is a
// single statement; otherwise the latch is the maximal trailing run of constant-step
// 'name = name + <int>' increments (one for a single counter, several for lockstep counters).
// The last body statement must be an Assign in both shapes (issue 1165 / 1162).
fn while_trailing_increment_count(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_count: i64,
    bs: i64
) -> !i64 {
    if body_count < 1 {
        return error("compiled mir: while body must end with the induction increment");
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "Assign") {
        return error("compiled mir: while body must end with the induction increment");
    }
    let last_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "value", 0, bs
    );
    let last_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_value, bs);
    if std::mem::equal_bytes(last_value_kind, "TryExpr") {
        return 1;
    }
    // A copy-decrement latch 'index = previous' (the value is a plain Var read of a body-local
    // bound to 'index - <int>' earlier in the loop) is a single-statement latch like the try-call
    // update; the referenced let stays in the body so source[previous] still loads it (issue 1165
    // / 1162). This only classifies the latch length; the caller (lower_multi_while_statement)
    // validates the copied local is a genuine induction-variable decrement through
    // validate_copy_latch_source before lowering it.
    if std::mem::equal_bytes(last_value_kind, "Var") {
        return 1;
    }
    // A token-carried plain-call latch '<cursor> = <free call>(.., <cursor>)' reseats the loop
    // variable from a free function's result rather than a numeric add (the value is a Call, e.g.
    // 'token = next_token(text, token)'). Like the try-call and copy-decrement latches it is a
    // single trailing statement; lower_multi_while_statement dispatches the Call increment value to
    // lower_while_latch_call, which binds %<cursor>_next on the latch edge for the loop-head phi
    // (issue 1157 PR-P4 latch shape). This only classifies the latch length; the caller validates
    // the call shape (free function, i64 result) before lowering it.
    if std::mem::equal_bytes(last_value_kind, "Call") {
        return 1;
    }
    var count = 0;
    var index = body_count - 1;
    while index >= 0 {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if !std::mem::equal_bytes(kind, "Assign") {
            index = -1;
            continue;
        }
        if !(try while_assign_is_constant_step(ir_bytes, function_name, stmt, bs)) {
            index = -1;
            continue;
        }
        count = count + 1;
        index = index - 1;
    }
    if count < 1 {
        return error("compiled mir: while body must end with the induction increment");
    }
    return count;
}
// validate_copy_latch_source checks that a copy-decrement latch's source local ('previous' in
// 'index = previous') is bound earlier in the same loop body, before the latch suffix, by a
// 'let previous = <induction_var> - <positive int>' decrement. Anything else -- a missing
// binding, a non-Binary value, a non-subtraction, a base that is not the induction variable, or
// a non-integer / non-positive offset -- is an explicit error so the copy latch never silently
// lowers a value that would not count the loop down (issue 1165 / 1162).
fn validate_copy_latch_source(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    induction_var: []u8,
    copy_source: []u8,
    bs: i64
) -> !void {
    var index = 0;
    while index < body_boundary {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, stmt, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
            if std::mem::equal_bytes(name, copy_source) {
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, stmt, "value", 0, bs
                );
                let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
                if !std::mem::equal_bytes(value_kind, "Binary") {
                    return error("compiled mir: copy latch source must be '<induction> - <int>'");
                }
                let op = try ir_contract::sequence_fact_value_from(
                    ir_bytes, "body-binary ", function_name, value, bs
                );
                if !std::mem::equal_bytes(op, "sub") {
                    return error("compiled mir: copy latch source must subtract from the induction variable");
                }
                let base_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, value, "left", 0, bs
                );
                let offset_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, value, "right", 0, bs
                );
                let base_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, base_node, bs);
                let offset_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, offset_node, bs);
                if !std::mem::equal_bytes(base_kind, "Var") or !std::mem::equal_bytes(offset_kind, "Int") {
                    return error("compiled mir: copy latch source must be '<induction> - <int>'");
                }
                let base_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, base_node, bs);
                if !std::mem::equal_bytes(base_name, induction_var) {
                    return error("compiled mir: copy latch source must subtract from the induction variable");
                }
                let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, offset_node, bs);
                if offset < 1 {
                    return error("compiled mir: copy latch source decrement must be positive");
                }
                return;
            }
        }
        index = index + 1;
    }
    return error("compiled mir: copy latch source local not found in the loop body");
}

fn lower_branch_merge_block_prefix(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    block_node: i64,
    statement_limit: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    label_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !VoidBodyLowerResult {
    var body_locals = locals_spec;
    var body_strings = string_counter;
    var body_temps = temp_counter;
    var body_tries = try_counter;
    var body_alias_counter = alias_counter;
    var body_index = 0;
    while body_index < statement_limit {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, block_node, "statement", body_index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                body_locals,
                statement,
                body_strings,
                body_temps,
                body_tries,
                aliases,
                stmts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_strings = let_result.string_counter;
            body_temps = let_result.temp_counter;
            body_tries = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(stmt_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    body_locals,
                    statement,
                    body_strings,
                    body_temps,
                    body_tries,
                    body_alias_counter,
                    label_index * 1000 + body_index + 1,
                    aliases,
                    stmts,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                body_strings = if_result.string_counter;
                body_temps = if_result.temp_counter;
                body_tries = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        body_locals,
                        statement,
                        body_strings,
                        body_temps,
                        body_tries,
                        aliases,
                        stmts,
                        bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                    body_strings = expr_result.string_counter;
                    body_tries = expr_result.try_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "Assign") {
                        let assign_result = try lower_void_then_body_assign(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            body_locals,
                            statement,
                            body_strings,
                            body_temps,
                            body_tries,
                            body_alias_counter,
                            aliases,
                            stmts,
                            bs,
                            ir_lookup_index, call_arg_type_cache
                        );
                        body_strings = assign_result.string_counter;
                        body_temps = assign_result.temp_counter;
                        body_tries = assign_result.try_counter;
                        body_alias_counter = assign_result.alias_counter;
                    } else {
                        return error("compiled mir: unsupported branch-merge while body statement");
                    }
                }
            }
        }
        body_index = body_index + 1;
    }
    return VoidBodyLowerResult {
        locals_spec: body_locals,
        string_counter: body_strings,
        temp_counter: body_temps,
        try_counter: body_tries,
        alias_counter: body_alias_counter,
        body_returns: false
    };
}

fn branch_merge_carried_type_supported(llvm_type: []u8) -> bool {
    if std::mem::equal_bytes(llvm_type, "i64") {
        return true;
    }
    if std::mem::equal_bytes(llvm_type, "i8") {
        return true;
    }
    if std::mem::equal_bytes(llvm_type, "i1") {
        return true;
    }
    if std::mem::equal_bytes(llvm_type, "%kizu.slice.u8") {
        return true;
    }
    return false;
}

fn branch_merge_carried_phi_name(loop_index: i64, slot: i64) -> ![]u8 {
    if slot < 0 {
        return error("compiled mir: negative branch-merge carried scalar slot");
    }
    var out = std::string::String(std::mem::page_allocator());
    try out.append_bytes("branch.carried.scalar.");
    try std::fmt::append_i64(&var out, loop_index);
    try out.append_bytes(".");
    try std::fmt::append_i64(&var out, slot);
    let name = out.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(name, name);
    return try copied.get(name);
}

fn branch_merge_carried_alias_index(
    states: &std::array::Array<BranchMergeCarriedAlias>,
    source_name: []u8
) -> !i64 {
    var index = 0;
    while index < states.len() {
        let state = try states.at(index);
        if std::mem::equal_bytes(state.source_name, source_name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn branch_merge_param_spec_contains(params_spec: []u8, name: []u8) -> bool {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            let param_name = params_spec[space_pos + 1..entry_end];
            if std::mem::equal_bytes(param_name, name) {
                return true;
            }
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return false;
}

fn branch_merge_top_level_local_before_loop(
    ir_bytes: []u8,
    function_name: []u8,
    source_name: []u8,
    while_stmt_index: i64,
    bs: i64
) -> !bool {
    var index = 0;
    while index < while_stmt_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, source_name) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

fn branch_merge_carried_source_available_before_loop(
    ir_bytes: []u8,
    function_name: []u8,
    locals_spec: []u8,
    source_name: []u8,
    while_stmt_index: i64,
    bs: i64
) -> !bool {
    if branch_merge_param_spec_contains(locals_spec, source_name) {
        return true;
    }
    return try branch_merge_top_level_local_before_loop(
        ir_bytes, function_name, source_name, while_stmt_index, bs
    );
}

fn append_branch_merge_carried_alias(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    source_name: []u8,
    induction_var: []u8,
    loop_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    states: &var std::array::Array<BranchMergeCarriedAlias>,
    bs: i64
) -> !void {
    if std::mem::equal_bytes(source_name, induction_var) {
        return;
    }
    if (try branch_merge_carried_alias_index(states, source_name)) >= 0 {
        return;
    }
    if !(try branch_merge_carried_source_available_before_loop(
        ir_bytes, function_name, locals_spec, source_name, loop_index, bs
    )) {
        return;
    }
    let llvm_type = try compiled_mir_types::resolve_value_llvm_type(
        ir_bytes, function_name, module_prefix, locals_spec, source_name, bs
    );
    if !branch_merge_carried_type_supported(llvm_type) {
        return error("compiled mir: branch-merge carried scalar type unsupported");
    }
    let slot = states.len();
    try states.append(BranchMergeCarriedAlias {
        source_name: source_name,
        phi_name: try branch_merge_carried_phi_name(loop_index, slot),
        llvm_type: llvm_type,
        init_name: try local_alias_current_name(aliases, source_name)
    });
    return;
}

fn collect_branch_merge_block_carried_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    block_node: i64,
    statement_limit: i64,
    induction_var: []u8,
    loop_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    states: &var std::array::Array<BranchMergeCarriedAlias>,
    bs: i64
) -> !void {
    var index = 0;
    while index < statement_limit {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, block_node, "statement", index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Assign") {
            let target = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "target", 0, bs
            );
            let target_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, target, bs
            );
            if !std::mem::equal_bytes(target_kind, "Var") {
                return error("compiled mir: branch-merge carried scalar target must be a var");
            }
            let target_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, target, bs
            );
            try append_branch_merge_carried_alias(
                ir_bytes, function_name, module_prefix, locals_spec, target_name, induction_var,
                loop_index, aliases, states, bs
            );
        } else {
            if std::mem::equal_bytes(stmt_kind, "If") {
                let then_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "then", 0, bs
                );
                let then_count = try while_body_statement_count(
                    ir_bytes, function_name, then_node, bs
                );
                try collect_branch_merge_block_carried_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    then_node,
                    then_count,
                    induction_var,
                    loop_index,
                    aliases,
                    states,
                    bs
                );
                let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
                    ir_bytes, function_name, statement, "else", 0, bs
                );
                if else_node >= 0 {
                    let else_kind = try ir_contract::body_node_kind_from(
                        ir_bytes, function_name, else_node, bs
                    );
                    if !std::mem::equal_bytes(else_kind, "Empty") {
                        let else_count = try while_body_statement_count(
                            ir_bytes, function_name, else_node, bs
                        );
                        try collect_branch_merge_block_carried_aliases(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            locals_spec,
                            else_node,
                            else_count,
                            induction_var,
                            loop_index,
                            aliases,
                            states,
                            bs
                        );
                    }
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn branch_merge_loop_aliases(
    aliases: &std::array::Array<LocalAliasState>,
    carried: &std::array::Array<BranchMergeCarriedAlias>
) -> !std::array::Array<LocalAliasState> {
    var loop_aliases = try copy_local_aliases(aliases);
    var index = 0;
    while index < carried.len() {
        let state = try carried.at(index);
        try set_local_alias(&var loop_aliases, state.source_name, state.phi_name);
        index = index + 1;
    }
    return loop_aliases;
}

fn validate_branch_merge_no_unmodelled_aliases(
    before: &std::array::Array<LocalAliasState>,
    after: &std::array::Array<LocalAliasState>,
    induction_var: []u8,
    carried: &std::array::Array<BranchMergeCarriedAlias>
) -> !void {
    var index = 0;
    while index < after.len() {
        let state = try after.at(index);
        if !std::mem::equal_bytes(state.source_name, induction_var) {
            let input_name = try local_alias_current_name(before, state.source_name);
            if !std::mem::equal_bytes(input_name, state.current_name) and
                (try branch_merge_carried_alias_index(carried, state.source_name)) < 0 {
                return error("compiled mir: branch-merge carried scalar not yet supported");
            }
        }
        index = index + 1;
    }
    return;
}

fn materialize_branch_merge_carried_scalars(
    carried: &std::array::Array<BranchMergeCarriedAlias>,
    advance_aliases: &std::array::Array<LocalAliasState>
) -> !std::array::Array<compiled_mir::MirCarriedScalar> {
    var scalars = std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator());
    var index = 0;
    while index < carried.len() {
        let state = try carried.at(index);
        let latch_name = try local_alias_current_name(advance_aliases, state.source_name);
        try scalars.append(compiled_mir::carried_scalar(
            state.phi_name,
            state.llvm_type,
            0,
            "",
            0,
            state.init_name,
            latch_name
        ));
        index = index + 1;
    }
    return scalars;
}

// lower_multi_while_branch_merge_latch lowers a bounded counter loop whose induction update is carried
// by a terminal if/else instead of a trailing body Assign (issue 1165 / 1162):
//   while index < bound {
//       ...
//       if done {
//           index = bound;
//       } else {
//           ...
//           index = index + 1;
//       }
//   }
// The shape is generic: the terminal If must have two block arms that assign the same Var, exactly one
// arm must close with a constant-step '<var> = <var> + <int>' advance, the other must be a single
// '<var> = <bound>' exit assignment, and the target/value types must be i64.
fn lower_multi_while_branch_merge_latch(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: branch-merge while header must be a single comparison");
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let terminal_if = try while_branch_merge_terminal_if_or_minus_one(
        ir_bytes, function_name, statement, bs
    );
    if terminal_if < 0 {
        return error("compiled mir: branch-merge while body must end with a terminal if/else latch");
    }
    let induction_var = try while_branch_merge_induction_var(
        ir_bytes, function_name, statement, bs
    );
    let induction_init = try find_induction_init(
        ir_bytes, function_name, induction_var, loop_index, bs
    );
    var induction_init_literal = induction_init.literal;
    var induction_init_var = induction_init.var_name;
    var induction_init_offset = induction_init.offset;
    let induction_alias = try local_alias_current_name(aliases, induction_var);
    if !std::mem::equal_bytes(induction_alias, induction_var) {
        induction_init_literal = 0;
        induction_init_var = induction_alias;
        induction_init_offset = 0;
    }

    let advance_block = try branch_merge_advance_block(
        ir_bytes, function_name, terminal_if, bs
    );
    let exit_block = try branch_merge_exit_block(
        ir_bytes, function_name, terminal_if, bs
    );
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "then", 0, bs
    );
    let advance_count = try while_body_statement_count(ir_bytes, function_name, advance_block, bs);
    var carried_aliases =
        std::array::Array<BranchMergeCarriedAlias>(std::mem::page_allocator());
    defer carried_aliases.deinit();
    try collect_branch_merge_block_carried_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        body_node,
        body_count - 1,
        induction_var,
        loop_index,
        aliases,
        &var carried_aliases,
        bs
    );
    try collect_branch_merge_block_carried_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        advance_block,
        advance_count - 1,
        induction_var,
        loop_index,
        aliases,
        &var carried_aliases,
        bs
    );
    var loop_aliases = try branch_merge_loop_aliases(aliases, &carried_aliases);
    defer loop_aliases.deinit();
    // The preheader phi may seed from a current alias for the induction variable, but once the
    // branch-merge loop starts, reads of that source variable must resolve to the loop-head phi.
    try set_local_alias(&var loop_aliases, induction_var, induction_var);

    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        &loop_aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let body_string_start = string_counter + try count_strings_in_insts(&cond_insts);
    let body_temp_start = temp_counter + cond_insts.len();

    let advance_assign = try branch_merge_last_assign(
        ir_bytes,
        function_name,
        advance_block,
        "compiled mir: branch-merge advance arm must end with the induction increment",
        bs
    );
    let step = try parse_induction_step(
        ir_bytes, function_name, advance_assign, induction_var, bs
    );
    let exit_assign = try branch_merge_last_assign(
        ir_bytes,
        function_name,
        exit_block,
        "compiled mir: branch-merge exit arm must end with a bound assignment",
        bs
    );
    let exit_count = try while_body_statement_count(ir_bytes, function_name, exit_block, bs);
    if exit_count != 1 {
        return error("compiled mir: branch-merge exit arm must only set the induction bound");
    }
    var branch_latch_exit_on_true = false;
    if then_node == exit_block {
        branch_latch_exit_on_true = true;
    } else {
        if then_node != advance_block {
            return error("compiled mir: branch-merge terminal arms could not be classified");
        }
    }
    try validate_branch_merge_exit_assign(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        exit_assign,
        induction_var,
        body_string_start,
        body_temp_start,
        bs,
        ir_lookup_index, call_arg_type_cache
    );

    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = try copy_local_aliases(&loop_aliases);
    defer body_aliases.deinit();
    let body_result = try lower_branch_merge_block_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        body_node,
        body_count - 1,
        body_string_start,
        body_temp_start,
        loop_index * 1000,
        alias_counter,
        loop_index,
        &var body_aliases,
        &var body_stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    var branch_cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let branch_cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "condition", 0, bs
    );
    if (try short_circuit_kind(ir_bytes, function_name, branch_cond_node, bs)) != 0 {
        return error("compiled mir: branch-merge terminal condition short-circuit unsupported");
    }
    let branch_cond_result = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        body_result.locals_spec,
        branch_cond_node,
        body_result.string_counter,
        body_result.temp_counter,
        &var branch_cond_insts,
        &body_aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let branch_cond_type = try expr_inst_llvm_type_by_id(&branch_cond_insts, branch_cond_result);
    if !std::mem::equal_bytes(branch_cond_type, "i1") {
        return error("compiled mir: branch-merge terminal condition must be bool");
    }
    let branch_cond_strings = try count_strings_in_insts(&branch_cond_insts);
    var branch_advance_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var advance_aliases = try copy_local_aliases(&body_aliases);
    defer advance_aliases.deinit();
    let advance_result = try lower_branch_merge_block_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        body_result.locals_spec,
        advance_block,
        advance_count - 1,
        body_result.string_counter + branch_cond_strings,
        body_result.temp_counter + branch_cond_insts.len(),
        body_result.try_counter,
        body_result.alias_counter,
        loop_index * 1000 + body_count,
        &var advance_aliases,
        &var branch_advance_stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    try validate_branch_merge_no_unmodelled_aliases(
        &loop_aliases, &body_aliases, induction_var, &carried_aliases
    );
    try validate_branch_merge_no_unmodelled_aliases(
        &body_aliases, &advance_aliases, induction_var, &carried_aliases
    );
    let carried_scalars = try materialize_branch_merge_carried_scalars(
        &carried_aliases, &advance_aliases
    );
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_var,
        induction_init_literal,
        induction_init_var,
        induction_init_offset,
        step,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        "",
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        carried_scalars,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        -1,
        branch_latch_exit_on_true,
        branch_cond_result,
        branch_cond_insts,
        branch_advance_stmts
    ));
    return MultiIfLowerResult {
        temp_counter: advance_result.temp_counter,
        string_counter: advance_result.string_counter,
        try_counter: 0,
        alias_counter: advance_result.alias_counter
    };
}
// lower_multi_while_statement lowers a restricted bounded counter loop: a single i64
// induction variable, a non-short-circuit comparison condition that reads it, a body
// of Let/If statements, and a trailing 'name = name + step' increment. The body
// statements reuse the same let/if lowering as the top level; body if labels are
// offset by the loop index so they never collide with top-level if labels. The
// induction increment is folded into induction_step and rendered in the loop latch.
fn lower_multi_while_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    // A while header is one of three shapes. A single comparison, or a short-circuit 'and'
    // chain whose operands are all side-effect-free (bool/int locals and literals, field
    // reads, and pure '<receiver>.len()' calls), folds into an eager 'and i1' that is
    // observably identical to short-circuit evaluation, so it lowers through the same
    // lower_expr_into path the bare comparison uses (mir_short_circuit stays 0). A genuine
    // short-circuit 'and' -- one whose later operand could trap when an earlier one is false,
    // such as line_end_excluding_break's '!is_line_break(source[index])' guarded by 'index <
    // length' -- lowers as a chain of operand blocks: the first operand fills cond_insts (the
    // loop head), the second fills cond_rhs_insts (a guarded loopN_head_rhs block), and any
    // further operands fill cond_extra_operands, so the guarded byte load only runs when its
    // guard holds. An 'or' header is rejected so the restricted loop support never silently
    // reorders a guarded read (issue 1165 / 1162).
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind == 2 {
        return error("compiled mir: while condition or is not supported");
    }
    // A continue-latch loop carries its increment inside a body 'if <cond> { <induction> =
    // <induction> + <step>; continue; }' rather than in a trailing assign, so it has no trailing
    // latch statement and the existing trailing-increment machinery does not apply. It lowers
    // through a dedicated path (line_comment_has_blank_after, issue 1165 / 1162).
    if try while_is_continue_latch(ir_bytes, function_name, statement, bs) {
        // A top-level continue-latch loop resolves its 'var <induction> = <init>' seed from the
        // function body and keeps the induction variable's own name (no rename): "" / "" leave the
        // seed and rename to lower_multi_while_continue_latch's defaults (issue 1165 / 1162).
        return try lower_multi_while_continue_latch(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            temp_counter,
            alias_counter,
            loop_index,
            "",
            "",
            stmts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    // A leading-decrement loop advances its counter through a body-opening '<var> = <var> - <int>'
    // self-decrement rather than a trailing increment, so the trailing-latch machinery below (which
    // requires the last body statement to be the induction increment) does not apply. It lowers
    // through a dedicated path that reseats the loop-head phi and synthesizes the decrement as a body
    // let (lbrace_opens_enum_decl, issue 1165 / 1162).
    if try while_is_leading_decrement(ir_bytes, function_name, body_node, bs) {
        return try lower_multi_while_leading_decrement(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            temp_counter,
            alias_counter,
            loop_index,
            stmts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    // A branch-merge latch advances or exits through a terminal if/else, so it has no trailing
    // increment Assign for while_induction_var to read. Dispatch it before the trailing-latch path
    // so the shape is validated by the branch-merge lowering instead of failing the old suffix
    // precondition (issue 1165 / 1162).
    if try while_is_branch_merge_latch(ir_bytes, function_name, statement, bs) {
        return try lower_multi_while_branch_merge_latch(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            temp_counter,
            alias_counter,
            loop_index,
            aliases,
            stmts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    let induction_var = try while_induction_var(ir_bytes, function_name, statement, bs);
    let induction_alias = try local_alias_current_name(aliases, induction_var);
    // loop_index is this while's top-level statement index, so the induction initializer
    // is the nearest preceding 'var <induction_var> = <init>'.
    var induction_init_literal = 0;
    var induction_init_var = "";
    var induction_init_offset = 0;
    // A call-seeded primary init ('var token = next_token(text, open)') lowers its call into the
    // preheader -- init_insts run before the loop head and the loop-head phi reads the call result
    // through init_result_id -- exactly as the continue-latch seed path does (find_induction_init_value_node
    // + lower_expr_into). Only a fresh cursor with no incoming alias takes this path; an aliased
    // induction variable, or any literal / plain-copy / base-plus-offset seed, resolves through
    // find_induction_init's classification so the existing seeds stay byte-identical (issue 1165 / 1162).
    var init_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var init_result_id = -1;
    var cond_string_base = string_counter;
    var cond_temp_base = temp_counter;
    let init_node = try find_induction_init_value_node(
        ir_bytes, function_name, induction_var, loop_index, bs
    );
    let init_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, init_node, bs);
    if std::mem::equal_bytes(init_kind, "Call") and
        std::mem::equal_bytes(induction_alias, induction_var) {
        init_result_id = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            init_node,
            string_counter,
            temp_counter,
            &var init_insts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        cond_string_base = string_counter + try count_strings_in_insts(&init_insts);
        cond_temp_base = temp_counter + init_insts.len();
    } else {
        let induction_init = try find_induction_init(
            ir_bytes, function_name, induction_var, loop_index, bs
        );
        induction_init_literal = induction_init.literal;
        induction_init_var = induction_init.var_name;
        induction_init_offset = induction_init.offset;
        if !std::mem::equal_bytes(induction_alias, induction_var) {
            induction_init_literal = 0;
            induction_init_var = induction_alias;
            induction_init_offset = 0;
        }
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_rhs_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_extra_operands = std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator());
    var cond_result = -1;
    var cond_rhs_result = -1;
    var mir_short_circuit = 0;
    var body_string_counter = cond_string_base;
    var body_temp_counter = cond_temp_base;
    if cond_kind == 1 and
        !(try while_and_condition_eager_safe(ir_bytes, function_name, cond_node, bs)) {
        // A genuine short-circuit 'and' chain: the leaf operands are evaluated left to
        // right, each guarded by every earlier operand. The first fills cond_insts, the
        // second fills cond_rhs_insts, and any further operands fill cond_extra_operands,
        // mirroring the short-circuit if-chain so the same operand-block renderer drives
        // both. A nested 'or' is left a leaf by flatten_and_operands and rejected here as a
        // near-miss explicit error rather than eager-evaluated (issue 1165 / 1162).
        mir_short_circuit = 1;
        var operands = std::array::Array<i64>(std::mem::page_allocator());
        try flatten_and_operands(ir_bytes, function_name, cond_node, &var operands, bs);
        var validate_index = 0;
        while validate_index < operands.len() {
            let operand_node = try operands.get(validate_index);
            if (try short_circuit_kind(ir_bytes, function_name, operand_node, bs)) != 0 {
                return error("compiled mir: nested short-circuit and/or unsupported");
            }
            validate_index = validate_index + 1;
        }
        let op0 = try operands.get(0);
        cond_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            op0,
            cond_string_base,
            cond_temp_base,
            &var cond_insts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        var acc_strings = try count_strings_in_insts(&cond_insts);
        var acc_temp = cond_temp_base + cond_insts.len();
        let op1 = try operands.get(1);
        cond_rhs_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            op1,
            cond_string_base + acc_strings,
            acc_temp,
            &var cond_rhs_insts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        acc_strings = acc_strings + try count_strings_in_insts(&cond_rhs_insts);
        acc_temp = acc_temp + cond_rhs_insts.len();
        var extra_index = 2;
        while extra_index < operands.len() {
            var operand_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let operand_node = try operands.get(extra_index);
            let operand_result = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                operand_node,
                cond_string_base + acc_strings,
                acc_temp,
                &var operand_insts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            acc_strings = acc_strings + try count_strings_in_insts(&operand_insts);
            acc_temp = acc_temp + operand_insts.len();
            try cond_extra_operands.append(
                compiled_mir::cond_operand(operand_result, operand_insts)
            );
            extra_index = extra_index + 1;
        }
        body_string_counter = cond_string_base + acc_strings;
        body_temp_counter = acc_temp;
        operands.deinit();
    } else {
        cond_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            cond_node,
            cond_string_base,
            cond_temp_base,
            &var cond_insts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        body_string_counter = cond_string_base + try count_strings_in_insts(&cond_insts);
        body_temp_counter = cond_temp_base + cond_insts.len();
    }
    var body_try_counter = loop_index * 1000;
    var body_alias_counter = alias_counter;
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    // The body ends with a latch suffix: one statement (a constant-step 'index = index +
    // <int>' increment or a loop-carried 'index = try <callee>(.., index);' try-call), or a
    // run of constant-step increments when the loop advances several lockstep counters
    // ('left_index = left_index + 1; right_index = right_index + 1;'). The primary induction
    // is the last increment; earlier increments in the run become secondary inductions
    // rendered alongside it (issue 1165 / 1162).
    let latch_count = try while_trailing_increment_count(
        ir_bytes, function_name, body_node, body_count, bs
    );
    let body_boundary = body_count - latch_count;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                body_stmt,
                body_string_counter,
                body_temp_counter,
                body_try_counter,
                &var body_aliases,
                &var body_stmts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let body_if_index = loop_index * 1000 + body_index + 1;
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_try_counter,
                    body_alias_counter,
                    body_if_index,
                    &var body_aliases,
                    &var body_stmts,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    // A void try-call statement inside the loop body (e.g.
                    // 'try render_llvm_c_byte(out, byte);') lowers through the same
                    // expression-statement path the then-body uses.
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        body_stmt,
                        body_string_counter,
                        body_temp_counter,
                        body_try_counter,
                        &body_aliases,
                        &var body_stmts,
                        bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported while body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    let increment_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let increment_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, increment_stmt, bs
    );
    if !std::mem::equal_bytes(increment_kind, "Assign") {
        return error("compiled mir: while body must end with the induction increment");
    }
    // The induction latch is either a constant-step 'index = index + <int>' increment or a
    // loop-carried 'index = try <callee>(.., index);' try-call update. The increment target
    // must name the induction variable in both shapes (issue 1165).
    let increment_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, increment_stmt, "target", 0, bs
    );
    let increment_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, increment_target, bs
    );
    if !std::mem::equal_bytes(increment_target_name, induction_var) {
        return error("compiled mir: induction increment must assign to the induction variable");
    }
    let increment_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, increment_stmt, "value", 0, bs
    );
    let increment_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, increment_value, bs
    );
    var step = 0;
    var latch_copy_var = "";
    var latch_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    if std::mem::equal_bytes(increment_value_kind, "TryExpr") {
        // 'index = try index_after_import(tokens, index);' advances the counter by a try-call
        // whose i64 success value feeds the loop-head phi (%<var>_next) and whose failure
        // propagates as this function's own error union. The latch try-call is given a try
        // index past the body try-calls (body_try_counter) and a call-arg setup prefix past
        // the body statement prefixes (loop_index * 1000 + body_count) so its SSA names never
        // collide with the body (issue 1165).
        let latch_stmt = try lower_while_latch_try_call(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            induction_var,
            increment_value,
            body_string_counter,
            body_try_counter,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        try latch_stmts.append(latch_stmt);
    } else {
        if std::mem::equal_bytes(increment_value_kind, "Call") {
            // 'token = synth_next_token(token);' advances the induction variable through a
            // token-carried call result rather than a numeric add: the loop variable is
            // reseated from a free function returning i64, whose result feeds the loop-head
            // phi (%<var>_next). Unlike the try-call latch this call propagates no error, so
            // it ends in loopN_latch with no fail/cont block (issue 1157 PR-P4).
            let latch_stmt = try lower_while_latch_call(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                induction_var,
                increment_value,
                body_string_counter,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            try latch_stmts.append(latch_stmt);
        } else {
        if std::mem::equal_bytes(increment_value_kind, "FieldExpr") {
            // 'token = declaration.next;' advances the induction variable from a struct field
            // of a body-local (a field-access latch) rather than a numeric add or a call result.
            // The loop body binds the struct earlier ('let declaration = ...;') and this reads its
            // i64 field into the loop-head phi (%<var>_next). Like the plain-call latch it carries
            // no control flow, so it ends in loopN_latch with no fail/cont block. This is the
            // shape parse_program_with_declarations / parse_block_with_statements need (issue 1157
            // PR-PF).
            let latch_stmt = try lower_while_latch_field_access(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                induction_var,
                increment_value,
                body_string_counter,
                bs
            );
            try latch_stmts.append(latch_stmt);
        } else {
        if std::mem::equal_bytes(increment_value_kind, "Var") {
            // 'index = previous' copies a body-local back into the induction variable. The local
            // must be bound earlier in this loop body by 'let previous = index - <int>', a
            // decrement of the induction variable, so the loop counts down and terminates against
            // its 'index > 0' header. The local is kept in the body (it also feeds source[previous]),
            // so the latch carries no add: the loop-head phi reads %previous directly on the latch
            // edge (issue 1165 / 1162).
            latch_copy_var = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, increment_value, bs
            );
            try validate_copy_latch_source(
                ir_bytes, function_name, body_node, body_boundary, induction_var, latch_copy_var, bs
            );
        } else {
            step = try parse_induction_step(
                ir_bytes, function_name, increment_stmt, induction_var, bs
            );
        }
        }
        }
    }
    // The increments before the primary latch (body_boundary .. body_count - 2) are the
    // secondary lockstep counters. Each is a constant-step 'name = name + <int>' increment
    // with its own preceding 'var name = <init>' initializer, so it gets its own loop-head
    // phi and latch add (issue 1165 / 1162).
    var secondary_inductions =
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator());
    var secondary_index = body_boundary;
    while secondary_index < body_count - 1 {
        let secondary_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", secondary_index, bs
        );
        let secondary_target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, secondary_stmt, "target", 0, bs
        );
        let secondary_var = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, secondary_target, bs
        );
        let secondary_step = try parse_induction_step(
            ir_bytes, function_name, secondary_stmt, secondary_var, bs
        );
        let secondary_init = try find_induction_init(
            ir_bytes, function_name, secondary_var, loop_index, bs
        );
        try secondary_inductions.append(compiled_mir::secondary_induction(
            secondary_var,
            secondary_init.literal,
            secondary_init.var_name,
            secondary_init.offset,
            secondary_step
        ));
        secondary_index = secondary_index + 1;
    }
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_var,
        induction_init_literal,
        induction_init_var,
        induction_init_offset,
        step,
        cond_result,
        cond_insts,
        mir_short_circuit,
        cond_rhs_result,
        cond_rhs_insts,
        cond_extra_operands,
        body_stmts,
        latch_stmts,
        latch_copy_var,
        secondary_inductions,
        std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator()),
        init_insts,
        init_result_id,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator())
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: 0,
        alias_counter: body_alias_counter
    };
}
// assign_is_self_decrement reports whether a body Assign is a constant-step self-decrement
// '<var> = <var> - <int>' of the named variable: a Binary 'sub' value whose left is that same Var
// and whose right is a positive integer literal. It classifies the leading induction advance of a
// leading-decrement loop (issue 1165 / 1162).
fn assign_is_self_decrement(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    var_name: []u8,
    bs: i64
) -> !bool {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "sub") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return false;
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_name, var_name) {
        return false;
    }
    let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
    return offset >= 1;
}
// while_is_leading_decrement reports whether a bounded loop advances its induction variable through
// a leading self-decrement rather than a trailing 'name = name + step' increment or a continue-latch:
// its first body statement is '<var> = <var> - <int>' and its last body statement is not an
// induction increment assign. lbrace_opens_enum_decl's backward brace scan is its first consumer
// (issue 1165 / 1162):
//   var cursor = index;
//   while cursor > 0 {
//       cursor = cursor - 1;
//       let token = try tokens.get(cursor);
//       ...
//   }
// The continue-latch shape is dispatched before this check, so a leading decrement here is always a
// fall-through (non-continue) loop whose body reads the decremented counter.
fn while_is_leading_decrement(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    bs: i64
) -> !bool {
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return false;
    }
    let first_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    let first_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, first_stmt, bs);
    if !std::mem::equal_bytes(first_kind, "Assign") {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, first_stmt, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let target_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    if !(try assign_is_self_decrement(ir_bytes, function_name, first_stmt, target_name, bs)) {
        return false;
    }
    // The induction is advanced only by the leading decrement: a trailing Assign as the last body
    // statement is the trailing-latch (or lockstep-counter) path, so a loop that both leads with a
    // decrement and trails with an increment is left to that lowering rather than mis-detected here.
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if std::mem::equal_bytes(last_kind, "Assign") {
        return false;
    }
    return true;
}

fn append_leading_decrement_carried_scalar(
    ir_bytes: []u8,
    function_name: []u8,
    target_name: []u8,
    loop_index: i64,
    states: &var std::array::Array<CarriedScalarState>,
    bs: i64
) -> !void {
    if (try carried_scalar_index(states, target_name)) >= 0 {
        return;
    }
    if states.len() > 0 {
        return error("compiled mir: only one carried scalar per leading-decrement loop is supported");
    }
    let init = try find_induction_init(ir_bytes, function_name, target_name, loop_index, bs);
    try states.append(CarriedScalarState {
        source_name: target_name,
        current_name: target_name,
        llvm_type: "i64",
        init_literal: init.literal,
        init_var: init.var_name,
        init_offset: init.offset,
        init_name: ""
    });
    return;
}

fn collect_leading_decrement_carried_scalars(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    loop_index: i64,
    bs: i64
) -> !std::array::Array<CarriedScalarState> {
    var states = std::array::Array<CarriedScalarState>(std::mem::page_allocator());
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var body_index = 0;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "If") {
            let assign_node = try if_scalar_assign_node_or_minus_one(
                ir_bytes, function_name, body_stmt, bs
            );
            if assign_node >= 0 {
                let target = try scalar_assign_target_or_empty(
                    ir_bytes, function_name, assign_node, bs
                );
                if std::mem::len(target) > 0 {
                    try append_leading_decrement_carried_scalar(
                        ir_bytes, function_name, target, loop_index, &var states, bs
                    );
                }
            }
        }
        body_index = body_index + 1;
    }
    return states;
}

fn materialize_carried_scalars(
    states: &std::array::Array<CarriedScalarState>
) -> !std::array::Array<compiled_mir::MirCarriedScalar> {
    var carried = std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator());
    var index = 0;
    while index < states.len() {
        let state = try states.at(index);
        try carried.append(compiled_mir::carried_scalar(
            state.source_name,
            state.llvm_type,
            state.init_literal,
            state.init_var,
            state.init_offset,
            state.init_name,
            state.current_name
        ));
        index = index + 1;
    }
    return carried;
}

fn lower_scalar_select_assign_from_if(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    if_node: i64,
    assign_node: i64,
    string_counter: i64,
    temp_counter: i64,
    loop_index: i64,
    body_index: i64,
    states: &var std::array::Array<CarriedScalarState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let target_name = try scalar_assign_target_or_empty(ir_bytes, function_name, assign_node, bs);
    if std::mem::len(target_name) == 0 {
        return error("compiled mir: scalar select assignment must be a self add/sub");
    }
    let state_index = try carried_scalar_index(states, target_name);
    if state_index < 0 {
        return error("compiled mir: scalar select assignment target is not loop-carried");
    }
    let state = try states.at(state_index);
    let state_source_name = state.source_name;
    let state_current_name = state.current_name;
    let state_llvm_type = state.llvm_type;
    let state_init_literal = state.init_literal;
    let state_init_var = state.init_var;
    let state_init_offset = state.init_offset;
    let state_init_name = state.init_name;
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: scalar select assignment condition must be a single expression");
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        states,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let cond_strings = try count_strings_in_insts(&cond_insts);
    let value_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    var value_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let value_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value_node,
        string_counter + cond_strings,
        temp_counter + cond_insts.len(),
        &var value_insts,
        states,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let value_strings = try count_strings_in_insts(&value_insts);
    let cond_len = cond_insts.len();
    let value_len = value_insts.len();
    let output_name = try carried_scalar_alias_name(target_name, loop_index, body_index);
    try stmts.append(compiled_mir::scalar_select_assign_stmt(
        target_name,
        state_current_name,
        output_name,
        state_llvm_type,
        cond_result,
        cond_insts,
        value_result,
        value_insts
    ));
    try states.set(state_index, CarriedScalarState {
        source_name: state_source_name,
        current_name: output_name,
        llvm_type: state_llvm_type,
        init_literal: state_init_literal,
        init_var: state_init_var,
        init_offset: state_init_offset,
        init_name: state_init_name
    });
    return MultiIfLowerResult {
        temp_counter: temp_counter + cond_len + value_len,
        string_counter: string_counter + cond_strings + value_strings,
        try_counter: 0,
        alias_counter: 0
    };
}

fn lower_carried_return_if_from_cond(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    return_statement: i64,
    if_index: i64,
    string_counter: i64,
    cond_result: i64,
    cond_insts: std::array::Array<compiled_mir::MirExprInst>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let then_string_base = string_counter + try count_strings_in_insts(&cond_insts);
    let then_base = cond_result + 1;
    let ret_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_statement, "value", 0, bs
    );
    var ret_node = ret_value;
    var ret_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, ret_node, bs);
    if std::mem::equal_bytes(ret_kind, "TryExpr") {
        ret_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, ret_node, "value", 0, bs
        );
        ret_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, ret_node, bs);
    }
    if std::mem::equal_bytes(ret_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, ret_node, bs
        );
        let bool_value = std::mem::equal_bytes(token, "true");
        try stmts.append(compiled_mir::if_stmt(
            if_index,
            string_counter,
            cond_result,
            try compiled_mir::copy_expr_insts(&cond_insts),
            0,
            -1,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
            compiled_mir::MirIfThenKind::ReturnBool,
            bool_value,
            llvm_return_type,
            "",
            "",
            std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
            -1,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
            then_string_base,
            std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator())
        ));
        return MultiIfLowerResult {
            temp_counter: then_base,
            string_counter: then_string_base,
            try_counter: 0,
            alias_counter: 0
        };
    }

    if std::mem::equal_bytes(ret_kind, "Call") {
        let call_type = try compiled_mir_types::lower_call_return_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, ret_node, bs
        );
        if !std::mem::equal_bytes(call_type, llvm_return_type) {
            return error("compiled mir: carried return call must return this function's error union");
        }
        let callee_name = try compiled_mir_types::lower_call_callee_name(
            ir_bytes, function_name, module_prefix, ret_node, bs
        );
        let call_args = try compiled_mir_lower_call::lower_call_args_cached(
            ir_bytes, function_name, module_prefix, locals_spec, ret_node, then_string_base, bs,
            ir_lookup_index, call_arg_type_cache
        );
        let call_arg_strings = try compiled_mir_lower_call::count_string_args(&call_args);
        let then_module_prefix = try compiled_mir_types::lower_call_module_prefix(
            ir_bytes, function_name, module_prefix, ret_node, bs
        );
        try stmts.append(compiled_mir::if_stmt(
            if_index,
            string_counter,
            cond_result,
            try compiled_mir::copy_expr_insts(&cond_insts),
            0,
            -1,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
            compiled_mir::MirIfThenKind::ReturnCall,
            false,
            call_type,
            then_module_prefix,
            callee_name,
            call_args,
            -1,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
            then_string_base,
            std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator())
        ));
        return MultiIfLowerResult {
            temp_counter: then_base + 1,
            string_counter: then_string_base + call_arg_strings,
            try_counter: 0,
            alias_counter: 0
        };
    }

    var then_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let then_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        ret_node,
        then_string_base,
        then_base,
        &var then_insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let then_strings = try count_strings_in_insts(&then_insts);
    try stmts.append(compiled_mir::if_stmt(
        if_index,
        string_counter,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        compiled_mir::MirIfThenKind::ReturnExpr,
        false,
        llvm_return_type,
        "",
        "",
        std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        then_result,
        then_insts,
        std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        then_string_base,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator())
    ));
    return MultiIfLowerResult {
        temp_counter: then_result + 1,
        string_counter: then_string_base + then_strings,
        try_counter: 0,
        alias_counter: 0
    };
}

fn lower_carried_return_if_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    if_node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    states: &std::array::Array<CarriedScalarState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind == 2 {
        return error("compiled mir: carried return-if or condition is unsupported");
    }
    if cond_kind == 1 and !(try while_and_condition_eager_safe(ir_bytes, function_name, cond_node, bs)) {
        return error("compiled mir: carried return-if condition is not eager-safe");
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        states,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count != 1 {
        return error("compiled mir: carried return-if then-block must be a single return");
    }
    let return_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let return_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, return_statement, bs
    );
    if !std::mem::equal_bytes(return_kind, "Return") {
        return error("compiled mir: carried return-if then-block must return");
    }
    return try lower_carried_return_if_from_cond(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        return_statement,
        if_index,
        string_counter,
        cond_result,
        cond_insts,
        stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
}

fn lower_guarded_return_then_scalar_assign(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    if_node: i64,
    assign_node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    loop_index: i64,
    body_index: i64,
    states: &var std::array::Array<CarriedScalarState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let nested_if = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let nested_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, nested_if, bs);
    if !std::mem::equal_bytes(nested_kind, "If") {
        return error("compiled mir: guarded scalar assignment must begin with a return-if");
    }
    let outer_cond = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "condition", 0, bs
    );
    let nested_cond = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, nested_if, "condition", 0, bs
    );
    let outer_kind = try short_circuit_kind(ir_bytes, function_name, outer_cond, bs);
    let nested_cond_kind = try short_circuit_kind(ir_bytes, function_name, nested_cond, bs);
    if outer_kind != 0 or nested_cond_kind != 0 {
        return error("compiled mir: guarded scalar return condition must be simple");
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let outer_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        outer_cond,
        string_counter,
        temp_counter,
        &var cond_insts,
        states,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let outer_strings = try count_strings_in_insts(&cond_insts);
    let outer_len = cond_insts.len();
    let nested_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        nested_cond,
        string_counter + outer_strings,
        temp_counter + outer_len,
        &var cond_insts,
        states,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let and_id = nested_result + 1;
    try cond_insts.append(compiled_mir::binary_expr_inst(and_id, "and", outer_result, nested_result));
    let nested_then = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, nested_if, "then", 0, bs
    );
    let nested_then_count = try while_body_statement_count(ir_bytes, function_name, nested_then, bs);
    if nested_then_count != 1 {
        return error("compiled mir: guarded scalar nested then-block must return");
    }
    let return_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, nested_then, "statement", 0, bs
    );
    let return_result = try lower_carried_return_if_from_cond(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        return_statement,
        if_index,
        string_counter,
        and_id,
        cond_insts,
        stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let assign_result = try lower_scalar_select_assign_from_if(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        if_node,
        assign_node,
        return_result.string_counter,
        return_result.temp_counter,
        loop_index,
        body_index,
        states,
        stmts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    return assign_result;
}
// lower_multi_while_leading_decrement lowers a bounded loop whose induction variable is advanced by a
// leading self-decrement '<var> = <var> - <int>' (issue 1165 / 1162). The decrement reassigns the
// counter at the top of the body, so every later body read of <var> means the decremented value. To
// keep the loop-head phi (the pre-decrement value the 'cursor > bound' header tests) distinct from
// the body value, the phi is reseated onto a reserved name (leading.decrement.head, which no kizu
// identifier can spell) and the decrement is synthesized as the first body statement 'let <var> =
// leading.decrement.head - <int>'. The header comparison and the decrement's right-hand side rename
// their <var> read to the reserved phi name; every other body statement reads <var> unchanged and so
// resolves to the synthesized let. The loop-head phi reads %<var> on the latch edge (the
// copy-decrement latch the renderer already supports, latch_copy_var = <var>), and the body carries
// no trailing latch. Only one leading-decrement loop per function is supported (a second would reuse
// the reserved phi name); every current consumer carries exactly one.
fn lower_multi_while_leading_decrement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let head_var = "leading.decrement.head";
    // The reserved phi name is shared by every leading-decrement loop, so a second one in the same
    // function would define %leading.decrement.head twice. Leading-decrement loops only lower at the
    // top level (a nested while is an unsupported body statement below), so scanning the already
    // lowered top-level statements for an earlier leading-decrement while catches the collision as an
    // explicit error rather than emitting an invalid duplicate phi (issue 1165 / 1162).
    var existing_index = 0;
    while existing_index < stmts.len() {
        let existing = try stmts.at(existing_index);
        let existing_head = match existing {
            While(payload) => payload.induction_var,
            _ => "",
        };
        if std::mem::len(existing_head) > 0 and std::mem::equal_bytes(existing_head, head_var) {
            return error("compiled mir: only one leading-decrement loop per function is supported");
        }
        existing_index = existing_index + 1;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: leading-decrement loop header must be a single comparison");
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var carried_states = try collect_leading_decrement_carried_scalars(
        ir_bytes, function_name, body_node, loop_index, bs
    );
    let decrement_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, decrement_stmt, "target", 0, bs
    );
    let induction_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    let induction_init = try find_induction_init(
        ir_bytes, function_name, induction_var, loop_index, bs
    );
    // The loop-head comparison reads the pre-decrement counter, so its <var> read renames to the
    // reserved phi name.
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    try rename_induction_in_insts(&var cond_insts, induction_var, head_var);
    // The header must test the decremented counter: after the rename, the condition has to read the
    // reserved phi name at least once. A no-op rename means the loop-head comparison reads some other
    // variable (e.g. 'while other > 0 { cursor = cursor - 1; ... }'), so the phi would track 'cursor'
    // while the header tests 'other' -- a mis-detected shape that is an explicit error here rather
    // than a silent mis-lower (issue 1165 / 1162).
    if !(try insts_reference_var(&cond_insts, head_var)) {
        return error("compiled mir: leading-decrement loop header must test the induction variable");
    }
    var body_string_counter = string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = temp_counter + cond_insts.len();
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    // The synthesized decrement 'let <var> = leading.decrement.head - <int>' binds the body value of
    // the counter; its right-hand side reads the pre-decrement phi, so it too renames to the reserved
    // name.
    let decrement_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, decrement_stmt, "value", 0, bs
    );
    var dec_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let dec_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        decrement_value,
        body_string_counter,
        body_temp_counter,
        &var dec_insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    try rename_induction_in_insts(&var dec_insts, induction_var, head_var);
    let dec_strings = try count_strings_in_insts(&dec_insts);
    let dec_temp = body_temp_counter + dec_insts.len();
    try body_stmts.append(compiled_mir::let_expr_stmt(
        induction_var, body_string_counter, dec_result, dec_insts
    ));
    body_string_counter = body_string_counter + dec_strings;
    body_temp_counter = dec_temp;
    // The remaining body statements read the decremented counter through the synthesized let, so they
    // lower exactly like a top-level Let/If run with no rename. The body-if index reuses the same
    // 'loop_index * 1000 + statement_index + 1' encoding the trailing-latch body uses; the
    // synthesized decrement occupies body_stmts[0] at the same statement_index 0 as the source
    // decrement, so later statement indices line up with their body_stmts slots.
    var body_try_counter = loop_index * 1000;
    var body_alias_counter = alias_counter;
    var body_index = 1;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                body_stmt,
                body_string_counter,
                body_temp_counter,
                body_try_counter,
                &var body_aliases,
                &var body_stmts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let body_if_index = loop_index * 1000 + body_index + 1;
                if carried_states.len() > 0 {
                    let assign_node = try if_scalar_assign_node_or_minus_one(
                        ir_bytes, function_name, body_stmt, bs
                    );
                    var carried_result = MultiIfLowerResult {
                        temp_counter: body_temp_counter,
                        string_counter: body_string_counter,
                        try_counter: 0,
                        alias_counter: 0
                    };
                    if assign_node >= 0 {
                        let then_node = try ir_contract::body_child_sequence_from(
                            ir_bytes, function_name, body_stmt, "then", 0, bs
                        );
                        let then_count = try while_body_statement_count(
                            ir_bytes, function_name, then_node, bs
                        );
                        if then_count == 1 {
                            carried_result = try lower_scalar_select_assign_from_if(
                                ir_bytes,
                                function_name,
                                module_prefix,
                                locals_spec,
                                body_stmt,
                                assign_node,
                                body_string_counter,
                                body_temp_counter,
                                loop_index,
                                body_index,
                                &var carried_states,
                                &var body_stmts,
                                bs,
                                ir_lookup_index, call_arg_type_cache
                            );
                        } else {
                            if then_count == 2 {
                                carried_result = try lower_guarded_return_then_scalar_assign(
                                    ir_bytes,
                                    function_name,
                                    module_prefix,
                                    llvm_return_type,
                                    locals_spec,
                                    body_stmt,
                                    assign_node,
                                    body_string_counter,
                                    body_temp_counter,
                                    body_if_index,
                                    loop_index,
                                    body_index,
                                    &var carried_states,
                                    &var body_stmts,
                                    bs,
                                    ir_lookup_index, call_arg_type_cache
                                );
                            } else {
                                return error("compiled mir: unsupported carried scalar if shape");
                            }
                        }
                    } else {
                        carried_result = try lower_carried_return_if_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            body_stmt,
                            body_string_counter,
                            body_temp_counter,
                            body_if_index,
                            &carried_states,
                            &var body_stmts,
                            bs,
                            ir_lookup_index, call_arg_type_cache
                        );
                    }
                    body_temp_counter = carried_result.temp_counter;
                    body_string_counter = carried_result.string_counter;
                } else {
                    let if_result = try lower_multi_if_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        body_stmt,
                        body_string_counter,
                        body_temp_counter,
                        body_try_counter,
                        body_alias_counter,
                        body_if_index,
                        &var body_aliases,
                        &var body_stmts,
                        bs,
                        ir_lookup_index, call_arg_type_cache
                    );
                    body_temp_counter = if_result.temp_counter;
                    body_string_counter = if_result.string_counter;
                    body_try_counter = if_result.try_counter;
                    body_alias_counter = if_result.alias_counter;
                }
            } else {
                return error("compiled mir: unsupported leading-decrement while body statement");
            }
        }
        body_index = body_index + 1;
    }
    let carried_scalars = try materialize_carried_scalars(&carried_states);
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        head_var,
        induction_init.literal,
        induction_init.var_name,
        induction_init.offset,
        0,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        induction_var,
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        carried_scalars,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        -1,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator())
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: 0,
        alias_counter: body_alias_counter
    };
}
// return_expr_advance returns the counters past an expression-return statement's instructions: the
// temp counter advances by the instruction count and the string counter by the string literals
// among them. It backs continue_latch_return_advance (issue 1165 / 1162).
fn return_expr_advance(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    base_temp: i64,
    base_string: i64
) -> !MultiIfLowerResult {
    return MultiIfLowerResult {
        temp_counter: base_temp + insts.len(),
        string_counter: base_string + try count_strings_in_insts(insts),
        try_counter: 0,
        alias_counter: 0
    };
}
// continue_latch_return_advance returns the counters past a continue-latch loop's terminal return so
// statements after the while never reuse a temp or string slot the return emitted. The tail must be
// an expression return (a hoisted-call 'return is_line_break(source[cursor])', a bool, or a plain
// value); any other return shape is an explicit error rather than a silently un-counted lowering
// (issue 1165 / 1162).
fn continue_latch_return_advance(
    stmt: &compiled_mir::MirStmt,
    base_temp: i64,
    base_string: i64
) -> !MultiIfLowerResult {
    match stmt {
        ReturnExpr(payload) => return try return_expr_advance(&payload.expr_insts, base_temp, base_string);,
        _ => return error("compiled mir: continue-latch loop tail must be an expression return");,
    }
}
// rename_induction_in_insts rewrites every plain Var read of 'from' to 'to' in an expression
// instruction array. A nested continue-latch loop reuses the enclosing loop's induction variable
// name ('cursor' in line_comment_has_blank_before's inner scan), so its loop-head phi would clash
// with the enclosing loop's phi of the same name. Renaming the induction reads in the inner loop's
// header and body lets it take a distinct phi name. The induction variable is always an i64 loop
// counter, so the rewritten Var keeps the i64 type; only the Var name carries the induction, so
// operand-id references (Binary / IndexLoad index / call args) follow the renamed Var without
// further rewriting (issue 1165 / 1162).
fn rename_induction_in_insts(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    from: []u8,
    to: []u8
) -> !void {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        let name = match inst {
            Var(payload) => payload.value,
            _ => "",
        };
        var do_rename = false;
        var hold_id = 0;
        if std::mem::len(name) > 0 and std::mem::equal_bytes(name, from) {
            do_rename = true;
            hold_id = compiled_mir::expr_inst_id(inst);
        }
        if do_rename {
            try insts.set(index, compiled_mir::var_expr_inst(hold_id, "i64", to));
        }
        index = index + 1;
    }
    return;
}

fn expr_inst_var_name_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        Var(payload) => payload.value,
        _ => "",
    };
}

fn expr_inst_field_base_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        FieldAccess(payload) => payload.value,
        _ => "",
    };
}

fn expr_inst_field_left_or_zero(inst: &compiled_mir::MirExprInst) -> i64 {
    return match inst {
        FieldAccess(payload) => payload.left,
        _ => 0,
    };
}

fn expr_inst_field_source_type_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        FieldAccess(payload) => payload.source_type,
        _ => "",
    };
}

fn expr_inst_field_source_index_or_zero(inst: &compiled_mir::MirExprInst) -> i64 {
    return match inst {
        FieldAccess(payload) => payload.source_field_index,
        _ => 0,
    };
}

fn expr_inst_index_target_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        IndexLoad(payload) => payload.target,
        _ => "",
    };
}

fn expr_inst_index_operand_or_zero(inst: &compiled_mir::MirExprInst) -> i64 {
    return match inst {
        IndexLoad(payload) => payload.index,
        _ => 0,
    };
}

fn expr_inst_array_len_receiver_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        ArrayLen(payload) => payload.receiver_name,
        _ => "",
    };
}

fn expr_inst_string_len_receiver_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        StringLen(payload) => payload.receiver_name,
        _ => "",
    };
}

fn rename_var_in_insts(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    from: []u8,
    to: []u8
) -> !void {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        let inst_id = compiled_mir::expr_inst_id(inst);
        let inst_type = compiled_mir::expr_inst_llvm_type(inst);
        let var_name = expr_inst_var_name_or_empty(inst);
        let field_base = expr_inst_field_base_or_empty(inst);
        let field_left = expr_inst_field_left_or_zero(inst);
        let field_source_type = expr_inst_field_source_type_or_empty(inst);
        let field_source_index = expr_inst_field_source_index_or_zero(inst);
        let index_target = expr_inst_index_target_or_empty(inst);
        let index_operand = expr_inst_index_operand_or_zero(inst);
        let array_len_receiver = expr_inst_array_len_receiver_or_empty(inst);
        let string_len_receiver = expr_inst_string_len_receiver_or_empty(inst);
        if std::mem::len(var_name) > 0 and std::mem::equal_bytes(var_name, from) {
            try insts.set(index, compiled_mir::var_expr_inst(inst_id, inst_type, to));
        } else {
            if field_left < 0 and
                std::mem::len(field_base) > 0 and
                std::mem::equal_bytes(field_base, from) {
                try insts.set(index, compiled_mir::field_access_expr_inst(
                    inst_id,
                    inst_type,
                    to,
                    field_source_type,
                    field_source_index
                ));
            } else {
                if std::mem::len(index_target) > 0 and std::mem::equal_bytes(index_target, from) {
                    try insts.set(index, compiled_mir::index_load_expr_inst(
                        inst_id,
                        to,
                        index_operand
                    ));
                } else {
                    if std::mem::len(array_len_receiver) > 0 and
                        std::mem::equal_bytes(array_len_receiver, from) {
                        try insts.set(index, compiled_mir::array_len_expr_inst(
                            inst_id,
                            to
                        ));
                    } else {
                        if std::mem::len(string_len_receiver) > 0 and
                            std::mem::equal_bytes(string_len_receiver, from) {
                            try insts.set(index, compiled_mir::string_len_expr_inst(
                                inst_id,
                                to
                            ));
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn rename_local_aliases_in_insts(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>
) -> !void {
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try rename_var_in_insts(insts, state.source_name, state.current_name);
        }
        index = index + 1;
    }
    return;
}

fn lower_expr_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    return try lower_expr_into_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        node,
        string_counter,
        temp_counter,
        insts,
        aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
}
// insts_reference_var reports whether an expression instruction array reads a Var named 'name'.
// A renamed nested continue-latch body lowers its if / return statements through the shared
// lowering (no rename threaded in), so this guards that those statements never reference the
// induction variable in a position the inner rename did not reach -- a near-miss shape is an
// explicit error rather than a silent unrenamed phi reference (issue 1165 / 1162).
fn insts_reference_var(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    name: []u8
) -> !bool {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        let var_name = match inst {
            Var(payload) => payload.value,
            _ => "",
        };
        if std::mem::len(var_name) > 0 and std::mem::equal_bytes(var_name, name) {
            return true;
        }
        index = index + 1;
    }
    return false;
}
// if_payload_references_induction reports whether an if statement reads the induction variable in
// any of its condition operand blocks or its expression then-block. A copy-decrement continue-if's
// then-block carries no expression insts (its increment folds into the latch), so this catches an
// induction reference only where the inner rename did not reach (issue 1165 / 1162).
fn if_payload_references_induction(
    payload: &compiled_mir::MirIfStmt,
    name: []u8
) -> !bool {
    if try insts_reference_var(&payload.cond_insts, name) {
        return true;
    }
    if try insts_reference_var(&payload.cond_rhs_insts, name) {
        return true;
    }
    let extra_operands = &payload.cond_extra_operands;
    var extra_index = 0;
    while extra_index < extra_operands.len() {
        let operand = try extra_operands.at(extra_index);
        if try insts_reference_var(&operand.insts, name) {
            return true;
        }
        extra_index = extra_index + 1;
    }
    return try insts_reference_var(&payload.then_expr_insts, name);
}
// stmt_references_induction reports whether a renamed nested continue-latch body's if or return
// statement still reads the induction variable. The inner rename only rewrites the loop header and
// the body lets it lowers itself; an if condition or a return value that reads the induction is an
// unsupported shape, so it is an explicit error rather than a silently unrenamed reference (issue
// 1165 / 1162).
fn stmt_references_induction(
    stmt: &compiled_mir::MirStmt,
    name: []u8
) -> !bool {
    match stmt {
        If(payload) => return try if_payload_references_induction(payload, name);,
        ReturnExpr(payload) => return try insts_reference_var(&payload.expr_insts, name);,
        _ => return error("compiled mir: nested continue-latch body statement is not an if or return");,
    }
}
// lower_multi_while_continue_latch lowers a continue-latch bounded loop -- one whose induction
// variable advances inside a body 'if <cond> { <induction> = <step>; continue; }' rather than
// through a trailing increment assign. line_comment_has_blank_after is its first consumer, with the
// nested-loop / copy-decrement generalization added for line_comment_has_blank_before (issue 1165 /
// 1162):
//   var cursor = line_end_including_break(source, comment_end);
//   while cursor < end {
//       if is_horizontal_space(source[cursor]) { cursor = cursor + 1; continue; }
//       return is_line_break(source[cursor]);
//   }
//   return false;
// The induction advance is either a constant-step '<var> = <var> + <int>' increment (folded into a
// shared '%var_next = add i64 %var, step' in loopN_latch) or a copy-decrement '<var> = <local>'
// copy whose local is a '<var> - <int>' decrement computed earlier in the body (the loop-head phi
// reads %<local> on the latch edge through latch_copy_var, and the latch emits no add). The
// continue-if's then-block becomes 'br label %loopN_latch' either way, and the loop's non-continue
// tail (a 'return') falls through the if-continuation block, so the body already terminates and
// append_multi_while emits no trailing 'br' into the latch.
//
// The seed comes from one of two places. A top-level loop (explicit_seed_var == "") resolves its
// 'var <induction> = <init>' from the function body: a call-seeded init lowers the call into
// init_insts (run in the preheader, the phi reading its result), and a literal / plain-copy /
// base-plus-offset seed reuses find_induction_init's classification. A nested loop (explicit_seed_var
// != "") seeds its phi by a plain copy of that local -- the '<induction> = <local>' re-seed assign
// that precedes it in the enclosing body -- and renames its induction reads to rename_to so its
// loop-head phi does not clash with the enclosing loop's phi of the same induction name.
//
// The body carries the continue-if, optional early-return ifs, and -- for a nested scan -- a
// '<induction> = <local>' re-seed assign immediately followed by the nested while it seeds. A
// short-circuit header, a non-return body tail, a re-seed assign not followed by a nested while,
// nesting deeper than one level, or any other body statement is an explicit error so a near-miss
// never silently mis-lowers.
fn lower_multi_while_continue_latch(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    explicit_seed_var: []u8,
    rename_to: []u8,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: continue-latch loop header must be a single comparison");
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return error("compiled mir: continue-latch loop body must carry the continue-if and a return");
    }
    // The loop's non-continue path must terminate: its last body statement is the 'return' the
    // continue-if falls through to. Because it already terminates, append_multi_while emits no
    // trailing 'br' into the latch -- the only edge back to the head is the continue-if's branch.
    let last_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_body, bs);
    if !std::mem::equal_bytes(last_body_kind, "Return") {
        return error("compiled mir: continue-latch loop body must end with a return");
    }
    let induction_var = try while_continue_induction_var(ir_bytes, function_name, statement, bs);
    let increment_assign = try while_continue_increment_assign(ir_bytes, function_name, statement, bs);
    // The continue-if's induction advance is a constant-step increment or a copy-decrement. A
    // copy-decrement drives the latch through latch_copy_var (validated as a '<induction> - <int>'
    // decrement bound earlier in the body); a constant-step folds into the shared latch add.
    let increment_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, increment_assign, "value", 0, bs
    );
    let increment_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, increment_value, bs
    );
    var step = 0;
    var latch_copy_var = "";
    if std::mem::equal_bytes(increment_value_kind, "Var") {
        latch_copy_var = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, increment_value, bs
        );
        try validate_copy_latch_source(
            ir_bytes, function_name, body_node, body_count, induction_var, latch_copy_var, bs
        );
    } else {
        step = try parse_induction_step(
            ir_bytes, function_name, increment_assign, induction_var, bs
        );
    }
    // Resolve the seed. A nested loop seeds its phi by a plain copy of explicit_seed_var (the
    // enclosing body's '<induction> = <local>' re-seed); a top-level loop resolves the 'var
    // <induction> = <init>' initializer, lowering a call seed into init_insts.
    var induction_init = 0;
    var induction_init_var = "";
    var induction_init_offset = 0;
    var init_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var init_result_id = -1;
    var body_string_counter = string_counter;
    var body_temp_counter = temp_counter;
    if std::mem::len(explicit_seed_var) > 0 {
        induction_init_var = explicit_seed_var;
    } else {
        let init_node = try find_induction_init_value_node(
            ir_bytes, function_name, induction_var, loop_index, bs
        );
        let init_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, init_node, bs);
        if std::mem::equal_bytes(init_kind, "Call") {
            init_result_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                init_node,
                string_counter,
                temp_counter,
                &var init_insts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            body_string_counter = string_counter + try count_strings_in_insts(&init_insts);
            body_temp_counter = temp_counter + init_insts.len();
        } else {
            let resolved_init = try find_induction_init(
                ir_bytes, function_name, induction_var, loop_index, bs
            );
            induction_init = resolved_init.literal;
            induction_init_var = resolved_init.var_name;
            induction_init_offset = resolved_init.offset;
        }
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        body_string_counter,
        body_temp_counter,
        &var cond_insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    body_string_counter = body_string_counter + try count_strings_in_insts(&cond_insts);
    body_temp_counter = body_temp_counter + cond_insts.len();
    if std::mem::len(rename_to) > 0 {
        try rename_induction_in_insts(&var cond_insts, induction_var, rename_to);
    }
    // Every body statement lowers; there is no trailing latch assign to strip. The continue-if
    // lowers to a ContinueLatch if, the trailing return to a return statement, and -- for a nested
    // scan -- a '<induction> = <local>' re-seed assign is consumed (it emits no instruction) and
    // its following nested while lowers through a recursive continue-latch call.
    var body_try_counter = loop_index * 1000;
    var body_alias_counter = alias_counter;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_index = 0;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            if std::mem::len(rename_to) > 0 {
                let let_advance = try lower_renamed_continue_latch_let(
                    ir_bytes, function_name, module_prefix, locals_spec, body_stmt,
                    induction_var, rename_to, body_string_counter, body_temp_counter,
                    &var body_stmts, bs, ir_lookup_index, call_arg_type_cache
                );
                body_string_counter = let_advance.string_counter;
                body_temp_counter = let_advance.temp_counter;
            } else {
                let let_result = try lower_multi_let_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_try_counter,
                    &var body_aliases,
                    &var body_stmts,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                body_string_counter = let_result.string_counter;
                body_temp_counter = let_result.temp_counter;
                body_try_counter = let_result.try_counter;
            }
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let body_if_index = loop_index * 1000 + body_index + 1;
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_try_counter,
                    body_alias_counter,
                    body_if_index,
                    &var body_aliases,
                    &var body_stmts,
                    bs,
                    ir_lookup_index, call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
                // A renamed nested body lowers its ifs through the shared path without a rename, so
                // an induction reference in the if condition would be an unrenamed phi reference.
                if std::mem::len(rename_to) > 0 {
                    let if_stmt = try body_stmts.at(body_stmts.len() - 1);
                    if try stmt_references_induction(if_stmt, induction_var) {
                        return error("compiled mir: nested continue-latch if references the induction variable");
                    }
                }
            } else {
                if std::mem::equal_bytes(body_kind, "Return") {
                    try body_stmts.append(try lower_multi_return_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        body_stmt,
                        body_string_counter,
                        body_temp_counter,
                        &body_aliases,
                        bs,
                        ir_lookup_index, call_arg_type_cache
                    ));
                    // A renamed nested body lowers its return through the shared path without a
                    // rename, so an induction reference in the return value would be an unrenamed phi
                    // reference. The canonical tail ('return is_line_break(source[<local>])') reads
                    // only the decrement local.
                    if std::mem::len(rename_to) > 0 {
                        let checked_return = try body_stmts.at(body_stmts.len() - 1);
                        if try stmt_references_induction(checked_return, induction_var) {
                            return error("compiled mir: nested continue-latch return references the induction variable");
                        }
                    }
                    // Advance the counters past the loop's terminal return so the result counters
                    // this function returns -- consumed by statements after the while -- never reuse
                    // a temp or string slot the return emitted. The tail must lower to an expression
                    // return ('return is_line_break(source[cursor])'); any other return shape is an
                    // explicit error rather than a silently un-counted lowering (issue 1165 / 1162).
                    let return_stmt = try body_stmts.at(body_stmts.len() - 1);
                    let advance = try continue_latch_return_advance(
                        return_stmt, body_temp_counter, body_string_counter
                    );
                    body_temp_counter = advance.temp_counter;
                    body_string_counter = advance.string_counter;
                } else {
                    if std::mem::equal_bytes(body_kind, "Assign") {
                        // A '<induction> = <local>' re-seed before a nested while: it does not advance
                        // the enclosing continue-latch (whose only back-edge is its continue-if) and
                        // emits no instruction -- it names the seed the following nested loop's phi
                        // reads on its preheader edge. The next body statement must be that while.
                        try validate_continue_latch_reseed(
                            ir_bytes, function_name, body_node, body_count, body_index, induction_var, bs
                        );
                    } else {
                        if std::mem::equal_bytes(body_kind, "While") {
                            // A nested continue-latch scan. It seeds from the immediately preceding
                            // '<induction> = <local>' re-seed assign and renames its induction reads to
                            // a dot-qualified reserved name that no kizu source identifier can spell, so
                            // its loop-head phi never clashes with the enclosing loop's phi or any other
                            // SSA name. One level of nesting is supported; a deeper nest is an explicit
                            // error.
                            if std::mem::len(rename_to) > 0 {
                                return error("compiled mir: nested continue-latch nesting deeper than one level is unsupported");
                            }
                            let seed_var = try continue_latch_nested_seed_var(
                                ir_bytes, function_name, body_node, body_index, induction_var, bs
                            );
                            let inner_loop_index = loop_index * 1000 + body_index + 1;
                            let inner_result = try lower_multi_while_continue_latch(
                                ir_bytes,
                                function_name,
                                module_prefix,
                                llvm_return_type,
                                locals_spec,
                                body_stmt,
                                body_string_counter,
                                body_temp_counter,
                                body_alias_counter,
                                inner_loop_index,
                                seed_var,
                                "nested.loop.induction",
                                &var body_stmts,
                                bs,
                                ir_lookup_index, call_arg_type_cache
                            );
                            body_string_counter = inner_result.string_counter;
                            body_temp_counter = inner_result.temp_counter;
                            body_alias_counter = inner_result.alias_counter;
                        } else {
                            return error("compiled mir: unsupported continue-latch body statement");
                        }
                    }
                }
            }
        }
        body_index = body_index + 1;
    }
    var induction_field = induction_var;
    if std::mem::len(rename_to) > 0 {
        induction_field = rename_to;
    }
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_field,
        induction_init,
        induction_init_var,
        induction_init_offset,
        step,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        latch_copy_var,
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator()),
        init_insts,
        init_result_id,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator())
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: 0,
        alias_counter: body_alias_counter
    };
}
// lower_renamed_continue_latch_let lowers a nested continue-latch body's 'let <name> = <expr>' with
// the induction variable renamed to rename_to. The inner scan's lets are simple i64 expressions
// (the '<local> = <induction> - <int>' decrement that feeds both the source[<local>] byte load and
// the copy latch); a call / struct / try let would need the rename threaded through its own
// lowering, so it is an explicit error rather than a silently unrenamed reference (issue 1165 /
// 1162).
fn lower_renamed_continue_latch_let(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    induction_var: []u8,
    rename_to: []u8,
    string_counter: i64,
    temp_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let let_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, let_name_node, bs
    );
    let let_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let let_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, let_value, bs);
    if std::mem::equal_bytes(let_value_kind, "Call") or
        std::mem::equal_bytes(let_value_kind, "TryExpr") or
        std::mem::equal_bytes(let_value_kind, "StructLiteralExpr") {
        return error("compiled mir: nested continue-latch let must be a simple expression");
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        let_value,
        string_counter,
        temp_counter,
        &var insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    try rename_induction_in_insts(&var insts, induction_var, rename_to);
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    try stmts.append(compiled_mir::let_expr_stmt(
        let_name, string_counter, result_id, insts
    ));
    return MultiIfLowerResult {
        temp_counter: next_temp,
        string_counter: string_counter + expr_strings,
        try_counter: 0,
        alias_counter: 0
    };
}
// validate_continue_latch_reseed checks a '<induction> = <local>' re-seed assign: its target is the
// induction variable, its value is a plain Var copy, and the next body statement is the nested
// while it seeds. Anything else is an explicit error so a near-miss never silently mis-lowers (issue
// 1165 / 1162).
fn validate_continue_latch_reseed(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_count: i64,
    body_index: i64,
    induction_var: []u8,
    bs: i64
) -> !void {
    let assign_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_index, bs
    );
    let assign_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_stmt, "target", 0, bs
    );
    let assign_target_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, assign_target, bs
    );
    if !std::mem::equal_bytes(assign_target_kind, "Var") {
        return error("compiled mir: continue-latch body assign target must be a var");
    }
    let assign_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, assign_target, bs
    );
    if !std::mem::equal_bytes(assign_target_name, induction_var) {
        return error("compiled mir: continue-latch body assign must target the induction variable");
    }
    if !(try while_assign_is_induction_copy(ir_bytes, function_name, assign_stmt, bs)) {
        return error("compiled mir: continue-latch body assign must copy a local");
    }
    let next_index = body_index + 1;
    if next_index >= body_count {
        return error("compiled mir: continue-latch re-seed assign must precede a nested while");
    }
    let next_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", next_index, bs
    );
    let next_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, next_stmt, bs);
    if !std::mem::equal_bytes(next_kind, "While") {
        return error("compiled mir: continue-latch re-seed assign must precede a nested while");
    }
    return;
}
// continue_latch_nested_seed_var returns the local a nested continue-latch while seeds from: the
// value of the immediately preceding '<induction> = <local>' re-seed assign. The assign was already
// validated when the body loop visited it, so this re-reads its copy source (issue 1165 / 1162).
fn continue_latch_nested_seed_var(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_index: i64,
    induction_var: []u8,
    bs: i64
) -> ![]u8 {
    if body_index < 1 {
        return error("compiled mir: nested continue-latch while must follow a re-seed assign");
    }
    let seed_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_index - 1, bs
    );
    let seed_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, seed_stmt, bs);
    if !std::mem::equal_bytes(seed_kind, "Assign") {
        return error("compiled mir: nested continue-latch while must follow a re-seed assign");
    }
    let seed_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "target", 0, bs
    );
    let seed_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, seed_target, bs
    );
    if !std::mem::equal_bytes(seed_target_name, induction_var) {
        return error("compiled mir: nested continue-latch re-seed must target the induction variable");
    }
    let seed_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "value", 0, bs
    );
    let seed_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, seed_value, bs);
    if !std::mem::equal_bytes(seed_value_kind, "Var") {
        return error("compiled mir: nested continue-latch re-seed must copy a local");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, seed_value, bs);
}

// lower_while_latch_try_call lowers a loop-carried 'index = try <callee>(.., index);' latch
// update into a LetTryCall statement bound to <induction_var>_next (issue 1165). The bound
// name feeds the loop-head phi on the latch edge, so the success value (field 1) becomes
// %<var>_next and a failure propagates as this function's own error union, exactly like a
// let-position try-call. The callee must be a free function (a field-mode method, e.g.
// tokens.get(..), is rejected here); index_after_leading_imports calling index_after_import
// is its first consumer. try_index is seeded past the body try-calls so the fail/cont block
// labels never collide with a body try-call's.
fn lower_while_latch_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    induction_var: []u8,
    try_node: i64,
    string_counter: i64,
    try_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, try_node, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: induction latch try value must wrap a call");
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: induction latch try-call must be a free function");
    }
    let called_error_union = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, inner, bs
    );
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, inner, bs, ir_lookup_index
    );
    if !std::mem::equal_bytes(success_type, "i64") {
        return error("compiled mir: induction latch try-call must return an i64");
    }
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, inner, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, inner, bs
    );
    let args = try compiled_mir_lower_call::lower_call_args_cached(
        ir_bytes, function_name, module_prefix, locals_spec, inner, string_counter, bs,
        ir_lookup_index, call_arg_type_cache
    );
    // The bound name is the induction variable itself; the latch renderer suffixes every SSA
    // name with "_next", so the success value binds to %<induction_var>_next which the
    // loop-head phi consumes on the latch edge (issue 1165).
    return compiled_mir::let_try_call_stmt(
        induction_var, called_error_union, success_type, llvm_return_type,
        callee_module_prefix, callee_name, string_counter, try_index,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        args
    );
}

// latch_call_cursor_type_is_seedable reports whether a token-carried plain-call latch's result type
// can drive the loop-head induction phi. i64 is the historical scalar cursor; a named struct value
// type (e.g. %kizu.kizu.lexer.token, the seven-i64 Token) is the struct cursor, symmetric with the
// call-seeded primary init lowered through lower_expr_into. An error-union result (%kizu.error.*) is
// rejected -- only a try-call latch carries one -- as is any other non-i64, non-named type, so the
// relaxation stays bounded to the cursor types the init seed can produce (issue 1157 PR-P4 follow-up).
fn latch_call_cursor_type_is_seedable(call_type: []u8) -> bool {
    if std::mem::equal_bytes(call_type, "i64") {
        return true;
    }
    if std::mem::starts_with(call_type, "%kizu.error.") {
        return false;
    }
    return std::mem::starts_with(call_type, "%");
}

// lower_while_latch_call lowers a token-carried 'token = synth_next_token(token);' latch
// update into a LetCall statement whose bound name is the induction variable (issue 1157
// PR-P4). The latch renderer suffixes the bind name with "_next", so the call result binds
// to %<induction_var>_next which the loop-head phi consumes on the latch edge. The callee
// must be a free function; an i64 result drives a scalar cursor and a struct value result (a
// named LLVM type) drives a struct cursor, symmetric with the call-seeded init. A field-mode
// method or an unseedable result type (error union / other) is rejected.
fn lower_while_latch_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    induction_var: []u8,
    call_node: i64,
    string_counter: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    if try callee_is_field_expr(ir_bytes, function_name, call_node, bs) {
        return error("compiled mir: token-carried latch call must be a free function");
    }
    let call_type = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    // The latch reseats the cursor from the call's return value, which the loop-head phi reads on
    // the latch edge. An i64 result drives the historical scalar cursor; a struct value result -- a
    // named LLVM type such as %kizu.kizu.lexer.token (the seven-i64 Token) -- drives a struct cursor,
    // the symmetric counterpart of the call-seeded primary init that lower_multi_while_statement
    // lowers through lower_expr_into. Both the init seed and this latch update carry the cursor's
    // declared type (the source's type system guarantees they agree), so the loop-head phi renders
    // that exact type. The relaxation stays bounded to init-side-seedable cursors: an error-union
    // result (%kizu.error.*, which only a try-call latch carries) or any non-i64, non-named type is
    // still rejected (issue 1157 PR-P4 follow-up).
    if !latch_call_cursor_type_is_seedable(call_type) {
        return error("compiled mir: token-carried latch call must return an i64 or struct value");
    }
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let args = try compiled_mir_lower_call::lower_call_args_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, bs,
        ir_lookup_index, call_arg_type_cache
    );
    return compiled_mir::let_call_stmt(
        induction_var, call_type, string_counter, callee_module_prefix, callee_name, args
    );
}

// lower_while_latch_field_access lowers a field-access 'token = declaration.next;' latch into
// a LetExpr statement holding the field access bound to the induction variable (issue 1157
// PR-PF). The latch renderer suffixes the bind name with "_next", so the loaded i64 field
// binds to %<induction_var>_next which the loop-head phi consumes on the latch edge. The
// receiver must be a local var (the loop body's struct binding) and the field must be an i64;
// it carries no control flow, so the phi reads it on the loopN_latch edge like a plain call.
fn lower_while_latch_field_access(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    induction_var: []u8,
    field_expr_node: i64,
    string_counter: i64,
    bs: i64
) -> !compiled_mir::MirStmt {
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, receiver, bs);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: field-access latch receiver must be a local var");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs);
    let info = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, locals_spec, field_expr_node, bs
    );
    if !std::mem::equal_bytes(info.field_llvm_type, "i64") {
        return error("compiled mir: field-access latch field must be an i64");
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    try insts.append(compiled_mir::field_access_expr_inst(
        0, info.field_llvm_type, receiver_name, info.receiver_llvm_type, info.field_index
    ));
    return compiled_mir::let_expr_stmt(induction_var, string_counter, 0, insts);
}

fn count_strings_in_insts(
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !i64 {
    return try count_strings_in_insts_from(insts, 0);
}
fn count_strings_in_insts_from(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    start: i64
) -> !i64 {
    var count = 0;
    var index = start;
    while index < insts.len() {
        let inst = try insts.at(index);
        count = count + try count_strings_in_inst(inst);
        index = index + 1;
    }
    return count;
}
fn count_strings_in_inst(
    inst: &compiled_mir::MirExprInst
) -> !i64 {
    match inst {
        ConstString(payload) => return 1;,
        Call(payload) => return try compiled_mir_lower_call::count_string_args(&payload.call_args);,
        StructLiteral(payload) => return try count_strings_in_struct_fields(&payload.struct_fields);,
        _ => return 0;,
    }
}
fn count_strings_in_struct_fields(
    fields: &std::array::Array<compiled_mir::MirStructField>
) -> !i64 {
    var count = 0;
    var index = 0;
    while index < fields.len() {
        let field = try fields.at(index);
        if field.kind == compiled_mir::MirStructFieldKind::ConstString {
            count = count + 1;
        }
        if field.kind == compiled_mir::MirStructFieldKind::Call {
            count = count + try compiled_mir_lower_call::count_string_args(&field.call_args);
        }
        if field.kind == compiled_mir::MirStructFieldKind::StructLiteral {
            count = count + try count_strings_in_struct_fields(&field.nested_fields);
        }
        index = index + 1;
    }
    return count;
}
// expr_inst_llvm_type_by_id returns the LLVM type of the lowered expression instruction whose id is
// result_id, so an assignment lowering can compare its value's type against the reassignment
// target's resolved type (issue 1201). A missing id is an internal inconsistency rather than a
// source-level near-miss, so it surfaces as an explicit error.
fn expr_inst_llvm_type_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> ![]u8 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return compiled_mir::expr_inst_llvm_type(inst);
        }
        index = index + 1;
    }
    return error("compiled mir: assignment value expression result not found");
}

fn return_try_expr_inst_llvm_type_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> ![]u8 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return compiled_mir::expr_inst_llvm_type(inst);
        }
        index = index + 1;
    }
    return error("compiled mir: return try expression result not found");
}

// call_has_call_arg reports whether any argument of a Call node is itself a Call.
// Inline call-arg descriptors cannot carry a computed call result, so such calls take
// the nested-argument expression path instead (issue 1165).
fn call_has_call_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
        if std::mem::equal_bytes(arg_kind, "Call") {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// arg_is_single_element_index reports whether a call argument is a single-element byte
// index load 'source[index]' (an IndexExpr whose 'end' bound is Empty), as distinct from a
// two-bound slice 'source[start..end]'. A single-element index has no inline MirCallArg
// descriptor -- the slice descriptor lower_call_index_arg builds assumes a real end bound --
// so such an argument is hoisted into a preceding index-load expr temp and passed by Temp
// reference instead. is_line_break(source[index]) inside line_end_excluding_break's
// short-circuit while header is its first consumer (issue 1165 / 1162).
fn arg_is_single_element_index(
    ir_bytes: []u8,
    function_name: []u8,
    arg_node: i64,
    bs: i64
) -> !bool {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if !std::mem::equal_bytes(arg_kind, "IndexExpr") {
        return false;
    }
    let end_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "end", 0, bs
    );
    let end_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, end_node, bs);
    return std::mem::equal_bytes(end_kind, "Empty");
}

fn arg_is_namespace_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    arg_node: i64,
    bs: i64
) -> !bool {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if !std::mem::equal_bytes(arg_kind, "FieldExpr") {
        return false;
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, arg_node, bs
    );
    return std::mem::equal_bytes(mode, "namespace");
}

fn call_arg_must_hoist(
    ir_bytes: []u8,
    function_name: []u8,
    arg_node: i64,
    bs: i64
) -> !bool {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if std::mem::equal_bytes(arg_kind, "Call") {
        return true;
    }
    if std::mem::equal_bytes(arg_kind, "StructLiteralExpr") {
        return true;
    }
    if try arg_is_namespace_field_expr(ir_bytes, function_name, arg_node, bs) {
        return true;
    }
    return try arg_is_single_element_index(ir_bytes, function_name, arg_node, bs);
}

fn call_has_try_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// call_has_hoisted_arg reports whether a call carries an argument that has no inline
// MirCallArg descriptor and must be lowered into a preceding expr temp: a nested call, a
// struct literal, a namespace field value (enum tag / payload-less union variant), or a
// single-element byte index load. Each is referenced through a Temp call arg once
// materialized (issue 1165 / 1162 / 1157).
pub fn call_has_hoisted_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, bs) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

pub fn call_has_hoisted_arg_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, cf
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, cf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// lower_expr_value_len lowers value-receiver len() calls in expression context.
// Array<T>.len() and std::string::String.len() both read a local/param %kizu.owned handle and
// return i64, but they dispatch to different runtime helpers, so the receiver Kizu type chooses
// the MIR instruction. get() returns !T and remains let-try-only.
fn lower_expr_value_len(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", callee_sf
    );
    if !std::mem::equal_bytes(method_name, "len") {
        return error("compiled mir: only value-receiver len is supported in expression position");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, cf
    );
    if arg_count != 0 {
        return error("compiled mir: value-receiver len takes no arguments");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, receiver_node, bs);
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: value-receiver len receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs, call_arg_type_cache
    );
    let lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    if is_array_field_type(lookup) {
        let id = id_base + insts.len();
        try insts.append(compiled_mir::array_len_expr_inst(id, receiver_name));
        return id;
    }
    if is_string_value_type(lookup) {
        let id = id_base + insts.len();
        try insts.append(compiled_mir::string_len_expr_inst(id, receiver_name));
        return id;
    }
    return error("compiled mir: value-receiver len receiver type is unsupported");
}

// lower_expr_call_with_nested_args lowers a Call whose argument list contains an argument
// with no inline descriptor -- a nested call (equal_bytes(token_text(...), expected)), a
// namespace field value (AstData::Empty), or a single-element byte index load
// (is_line_break(source[index])) (issue 1165 / 1162 / 1157). Each such argument is lowered
// into a preceding expr temp and referenced through a Temp call arg; scalar and
// two-bound-slice arguments use the shared single-arg descriptor. The outer call inst is
// appended once every argument temp is materialized so the temps dominate the call.
fn lower_expr_call_with_nested_args(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let call_type = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let lowered_callee_name = try compiled_mir_types::lower_call_callee_name_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, cf
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, module_prefix, callee_name, arg_count, ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, cf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index);
        let hoist_arg = try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf);
        if hoist_arg {
            let before = insts.len();
            let temp_id = try lower_expr_into(
                ir_bytes, function_name, module_prefix, params_spec, arg_node,
                string_idx, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(insts, before);
            try args.append(compiled_mir::temp_call_arg(arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg(
                ir_bytes, function_name, module_prefix, params_spec, arg_type,
                arg_node, string_idx, bs
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    let id = id_base + insts.len();
    try insts.append(compiled_mir::call_expr_inst(
        id, call_type, callee_module_prefix, lowered_callee_name, args
    ));
    return id;
}

fn lower_expr_call_with_nested_args_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let call_type = try compiled_mir_types::lower_call_return_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let lowered_callee_name = try compiled_mir_types::lower_call_callee_name_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, call_node, bs
    );
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, cf
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, module_prefix, callee_name, arg_count, ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, cf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index);
        let hoist_arg = try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf);
        if hoist_arg {
            let before = insts.len();
            let temp_id = try lower_expr_with_local_aliases(
                ir_bytes, function_name, module_prefix, params_spec, arg_node,
                string_idx, id_base, insts, aliases, bs, ir_lookup_index, call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(insts, before);
            try args.append(compiled_mir::temp_call_arg(arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_with_aliases_cached(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                arg_type,
                arg_node,
                string_idx,
                &alias_sources,
                &alias_currents,
                bs,
                ir_lookup_index,
                call_arg_type_cache
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    let id = id_base + insts.len();
    try insts.append(compiled_mir::call_expr_inst(
        id, call_type, callee_module_prefix, lowered_callee_name, args
    ));
    return id;
}

fn lower_expr_method_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, params_spec, call_node, bs,
        ir_lookup_index, call_arg_type_cache
    );
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, bs, call_arg_type_cache
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, info.module_prefix, info.callee_name, explicit_arg_count + 1,
        ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::var_call_arg(
        try arg_types.get(0), info.receiver_name
    ));
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < explicit_arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, bs
        );
        let arg_type = try arg_types.get(arg_index + 1);
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, bs) {
            let before = insts.len();
            let temp_id = try lower_expr_into(
                ir_bytes, function_name, module_prefix, params_spec, arg_node,
                string_idx, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(insts, before);
            try args.append(compiled_mir::temp_call_arg(arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg(
                ir_bytes, function_name, module_prefix, params_spec, arg_type,
                arg_node, string_idx, bs
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    let id = id_base + insts.len();
    try insts.append(compiled_mir::call_expr_inst(
        id, info.return_llvm_type, info.module_prefix, info.callee_name, args
    ));
    return id;
}

fn lower_expr_method_call_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    // cf tightens this call's own structural facts (its arg edges, per-arg hoist kind checks)
    // to the call node's body-node line via the index; the args sort after it, so a scan from
    // cf reaches the byte-identical facts a scan from bs would. bs is kept for receiver/return
    // type resolution and lowering recursion, which read facts that can precede this node.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, params_spec, call_node, bs,
        ir_lookup_index, call_arg_type_cache
    );
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types_cached(
        ir_bytes, info.module_prefix, info.callee_name, explicit_arg_count + 1,
        ir_lookup_index, call_arg_type_cache
    );
    defer arg_types.deinit();
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::var_call_arg(
        try arg_types.get(0), try local_alias_current_name(aliases, info.receiver_name)
    ));
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < explicit_arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, cf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index + 1);
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
            let before = insts.len();
            let temp_id = try lower_expr_with_local_aliases(
                ir_bytes, function_name, module_prefix, params_spec, arg_node,
                string_idx, id_base, insts, aliases, bs, ir_lookup_index, call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(insts, before);
            try args.append(compiled_mir::temp_call_arg(arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_with_aliases_cached(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                arg_type,
                arg_node,
                string_idx,
                &alias_sources,
                &alias_currents,
                bs,
                ir_lookup_index,
                call_arg_type_cache
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    let id = id_base + insts.len();
    try insts.append(compiled_mir::call_expr_inst(
        id, info.return_llvm_type, info.module_prefix, info.callee_name, args
    ));
    return id;
}

fn lower_expr_call_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let id = id_base + insts.len();
    // The call-shape probes below use the per-function node-line cache for this call's own
    // structural facts; type resolution and lowering recursion keep bs because they read
    // let/param facts that can precede this node.
    let callee_mode = try call_callee_field_expr_mode_cached(
        ir_bytes, function_name, expr_node, bs, call_arg_type_cache
    );
    if callee_mode == 1 {
        if try call_method_name_is_cached(
            ir_bytes, function_name, expr_node, "len", bs, call_arg_type_cache
        ) {
            let result = try lower_expr_value_len(
                ir_bytes, function_name, module_prefix, params_spec, expr_node, id_base, insts, bs,
                ir_lookup_index, call_arg_type_cache
            );
            try rename_local_aliases_in_insts(insts, aliases);
            return result;
        }
        return try lower_expr_method_call_with_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, expr_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, call_arg_type_cache
        );
    }
    if callee_mode == 2 {
        if try callee_is_namespace_union_ctor_cached(
            ir_bytes, function_name, module_prefix, expr_node, bs,
            ir_lookup_index, call_arg_type_cache
        ) {
            return try lower_expr_union_ctor_call(
                ir_bytes, function_name, module_prefix, params_spec, expr_node,
                string_index, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
            );
        }
    }
    if try call_has_hoisted_arg_cached(
        ir_bytes, function_name, expr_node, bs, call_arg_type_cache
    ) {
        return try lower_expr_call_with_nested_args_with_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, expr_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, call_arg_type_cache
        );
    }
    let call_info = try compiled_mir_types::lower_call_info_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, expr_node, bs, call_arg_type_cache
    );
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, params_spec, expr_node, string_index, aliases, bs,
        ir_lookup_index, call_arg_type_cache
    );
    try insts.append(compiled_mir::call_expr_inst(
        id,
        call_info.return_llvm_type,
        call_info.module_prefix,
        call_info.callee_name,
        args
    ));
    return id;
}

fn lower_expr_into_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    // nf tightens the body-fact scan for this node's own structural facts (its kind, child
    // edges, detail token/int/op) to its body-node line via the index instead of rescanning
    // from the function body start. This node's children sort after it, so a scan from nf
    // reaches the byte-identical facts a scan from bs would (perf only). bs is kept for
    // type/name resolution and lowering recursion, which read facts that can precede this node.
    let nf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, expr_node, bs);
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr_node, nf);
    let id = id_base + insts.len();
    if std::mem::equal_bytes(kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            nf
        );
        let var_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, params_spec, var_name, bs, call_arg_type_cache
        );
        try insts.append(compiled_mir::var_expr_inst(
            id, var_type, try local_alias_current_name(aliases, var_name)
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            nf
        );
        try insts.append(compiled_mir::bool_expr_inst(
            id,
            std::mem::equal_bytes(token, "true")
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Int") {
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes,
            function_name,
            expr_node,
            nf
        );
        try insts.append(compiled_mir::int_expr_inst(id, int_value));
        return id;
    }
    if std::mem::equal_bytes(kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            nf
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid expression string token"
        );
        try insts.append(compiled_mir::string_expr_inst(
            id,
            token,
            string_index
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Prefix") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, expr_node, nf
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, nf
        );
        if std::mem::equal_bytes(op, "neg") {
            let right_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, right_node, nf
            );
            if !std::mem::equal_bytes(right_kind, "Int") {
                return error("compiled mir: unsupported neg operand");
            }
            let int_value = try ir_contract::body_int_value_from(
                ir_bytes, function_name, right_node, nf
            );
            try insts.append(compiled_mir::int_expr_inst(id, 0 - int_value));
            return id;
        }
        if !std::mem::equal_bytes(op, "not") {
            return error("compiled mir: unsupported prefix op");
        }
        let operand = try lower_expr_into_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            right_node,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::prefix_not_expr_inst(result_id, operand));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, expr_node, nf
        );
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "left", 0, nf
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, nf
        );
        let before_left = insts.len();
        let left = try lower_expr_into_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, left_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, call_arg_type_cache
        );
        let right_string_index = string_index + try count_strings_in_insts_from(insts, before_left);
        let right = try lower_expr_into_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, right_node,
            right_string_index, id_base, insts, aliases, bs, ir_lookup_index, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::binary_expr_inst(result_id, op, left, right));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "type", 0, nf
        );
        let type_text = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, nf
        );
        let target_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, module_prefix, type_text
        );
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, nf
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value_node, nf
        );
        if std::mem::equal_bytes(value_kind, "Int") {
            let int_value = try ir_contract::body_int_value_from(
                ir_bytes, function_name, value_node, nf
            );
            try insts.append(compiled_mir::typed_int_expr_inst(id, int_value, target_llvm));
            return id;
        }
        // A non-literal integer operand ('cast<u8>(48 + value)') lowers the operand
        // into a preceding temp, then casts that result to the target integer width
        // (trunc/sext/copy in the renderer).
        let operand_id = try lower_expr_into_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, value_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, call_arg_type_cache
        );
        let source_llvm = try expr_inst_llvm_type_by_id(insts, operand_id);
        let cast_id = id_base + insts.len();
        try insts.append(compiled_mir::int_cast_expr_inst(
            cast_id, operand_id, source_llvm, target_llvm
        ));
        return cast_id;
    }
    if std::mem::equal_bytes(kind, "FieldExpr") {
        return try lower_expr_field_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            expr_node,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(kind, "IndexExpr") {
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "end", 0, nf
        );
        let end_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, end_node, nf
        );
        let target_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "target", 0, nf
        );
        let index_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "start", 0, nf
        );
        if !std::mem::equal_bytes(end_kind, "Empty") {
            let target_id = try lower_expr_into_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                target_node,
                string_index,
                id_base,
                insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            let start_id = try lower_expr_into_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                index_node,
                string_index,
                id_base,
                insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            let end_id = try lower_expr_into_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                end_node,
                string_index,
                id_base,
                insts,
                aliases,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            let result_id = id_base + insts.len();
            try insts.append(compiled_mir::slice_expr_inst(
                result_id, target_id, start_id, end_id
            ));
            return result_id;
        }
        let target_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, target_node, nf
        );
        if !std::mem::equal_bytes(target_kind, "Var") {
            return error("compiled mir: index target must be a var");
        }
        let target_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, target_node, nf
        );
        let index_id = try lower_expr_into_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            index_node,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::index_load_expr_inst(
            result_id,
            try local_alias_current_name(aliases, target_name),
            index_id
        ));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "StructLiteralExpr") {
        let struct_type = try compiled_signature::resolve_struct_literal_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, expr_node, bs
        );
        let fields = try compiled_mir_lower_struct::lower_struct_fields(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
        );
        let struct_id = id_base + insts.len();
        try insts.append(compiled_mir::struct_literal_expr_inst(
            struct_id, struct_type, fields
        ));
        return struct_id;
    }
    if std::mem::equal_bytes(kind, "Call") {
        return try lower_expr_call_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            expr_node,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    // A 'try <expr>' in value/sub-expression position lowers its inner child generically
    // through the same expr path (no inner-kind dispatch), reads the inner's produced
    // error-union LLVM type, and emits a TryUnwrap that unwraps the success value or
    // propagates the failure through this function's own error union (issue 1157 big-bang).
    if std::mem::equal_bytes(kind, "TryExpr") {
        let inner_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, nf
        );
        let operand = try lower_expr_into_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, inner_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, call_arg_type_cache
        );
        let called_error_union = try expr_inst_llvm_type_by_id(insts, operand);
        let success_type = try try_call_success_type(
            ir_bytes, function_name, module_prefix, inner_node, bs, ir_lookup_index
        );
        let own_error_union = try compiled_signature::derive_return_type_indexed(
            ir_lookup_index, ir_bytes, function_name
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::try_unwrap_expr_inst(
            result_id, success_type, operand, called_error_union, own_error_union
        ));
        return result_id;
    }
    return error("compiled mir: unsupported expression kind");
}

fn lower_expr_into(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr_node, bs);
    let id = id_base + insts.len();
    if std::mem::equal_bytes(kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        let var_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, params_spec, var_name, bs, call_arg_type_cache
        );
        try insts.append(compiled_mir::var_expr_inst(id, var_type, var_name));
        return id;
    }
    if std::mem::equal_bytes(kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        try insts.append(compiled_mir::bool_expr_inst(
            id,
            std::mem::equal_bytes(token, "true")
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Int") {
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        try insts.append(compiled_mir::int_expr_inst(id, int_value));
        return id;
    }
    if std::mem::equal_bytes(kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid expression string token"
        );
        try insts.append(compiled_mir::string_expr_inst(
            id,
            token,
            string_index
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Prefix") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, expr_node, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, bs
        );
        if std::mem::equal_bytes(op, "neg") {
            let right_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, right_node, bs
            );
            if !std::mem::equal_bytes(right_kind, "Int") {
                return error("compiled mir: unsupported neg operand");
            }
            let int_value = try ir_contract::body_int_value_from(
                ir_bytes, function_name, right_node, bs
            );
            try insts.append(compiled_mir::int_expr_inst(id, 0 - int_value));
            return id;
        }
        if !std::mem::equal_bytes(op, "not") {
            return error("compiled mir: unsupported prefix op");
        }
        let operand = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            right_node,
            string_index,
            id_base,
            insts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::prefix_not_expr_inst(result_id, operand));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, expr_node, bs
        );
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "left", 0, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, bs
        );
        let before_left = insts.len();
        let left = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, left_node,
            string_index, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
        );
        let right_string_index = string_index + try count_strings_in_insts_from(insts, before_left);
        let right = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, right_node,
            right_string_index, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::binary_expr_inst(result_id, op, left, right));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "type", 0, bs
        );
        let type_text = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, bs
        );
        let target_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, module_prefix, type_text
        );
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value_node, bs
        );
        if !std::mem::equal_bytes(value_kind, "Int") {
            return error("compiled mir: unsupported cast operand");
        }
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes, function_name, value_node, bs
        );
        try insts.append(compiled_mir::typed_int_expr_inst(id, int_value, target_llvm));
        return id;
    }
    if std::mem::equal_bytes(kind, "FieldExpr") {
        return try lower_expr_field(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            expr_node,
            id_base,
            insts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(kind, "IndexExpr") {
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "end", 0, bs
        );
        let end_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, end_node, bs
        );
        let target_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "target", 0, bs
        );
        let index_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "start", 0, bs
        );
        if !std::mem::equal_bytes(end_kind, "Empty") {
            let target_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                target_node,
                string_index,
                id_base,
                insts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            let start_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                index_node,
                string_index,
                id_base,
                insts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            let end_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                end_node,
                string_index,
                id_base,
                insts,
                bs,
                ir_lookup_index, call_arg_type_cache
            );
            let result_id = id_base + insts.len();
            try insts.append(compiled_mir::slice_expr_inst(
                result_id, target_id, start_id, end_id
            ));
            return result_id;
        }
        let target_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, target_node, bs
        );
        if !std::mem::equal_bytes(target_kind, "Var") {
            return error("compiled mir: index target must be a var");
        }
        let target_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, target_node, bs
        );
        let index_id = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            index_node,
            string_index,
            id_base,
            insts,
            bs,
            ir_lookup_index, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::index_load_expr_inst(
            result_id, target_name, index_id
        ));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "StructLiteralExpr") {
        // A struct-literal expression uses the same field descriptor lowering as
        // statement-level struct literals, then materializes the aggregate as an
        // expression value. This covers multi-field tagged-union payload structs such
        // as VarNode { name, doc } without naming the payload type here (issue 1157 C2).
        let struct_type = try compiled_signature::resolve_struct_literal_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, expr_node, bs
        );
        let fields = try compiled_mir_lower_struct::lower_struct_fields(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, bs
        );
        let struct_id = id_base + insts.len();
        try insts.append(compiled_mir::struct_literal_expr_inst(
            struct_id, struct_type, fields
        ));
        return struct_id;
    }
    if std::mem::equal_bytes(kind, "Call") {
        // A field-mode len() call on a value receiver reads a supported %kizu.owned
        // param/local (Array<T> or std::string::String) through its matching runtime helper.
        // get() returns !T and only appears in let-try position, so it is rejected here.
        let callee_mode = try call_callee_field_expr_mode_cached(
            ir_bytes, function_name, expr_node, bs, call_arg_type_cache
        );
        if callee_mode == 1 {
            if try call_method_name_is_cached(
                ir_bytes, function_name, expr_node, "len", bs, call_arg_type_cache
            ) {
                return try lower_expr_value_len(
                    ir_bytes, function_name, module_prefix, params_spec, expr_node, id_base, insts, bs,
                    ir_lookup_index, call_arg_type_cache
                );
            }
            return try lower_expr_method_call(
                ir_bytes, function_name, module_prefix, params_spec, expr_node,
                string_index, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
            );
        }
        // A namespaced FieldExpr callee whose receiver names a tagged-union type is a
        // single-payload union constructor (Union::Variant(payload), issue 1157 PR-P2).
        // Field-mode callees (.len()) were handled above; enum and free/namespaced function
        // calls fall through to the regular call path below.
        if callee_mode == 2 {
            if try callee_is_namespace_union_ctor_cached(
                ir_bytes, function_name, module_prefix, expr_node, bs,
                ir_lookup_index, call_arg_type_cache
            ) {
                return try lower_expr_union_ctor_call(
                    ir_bytes, function_name, module_prefix, params_spec, expr_node,
                    string_index, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
                );
            }
        }
        // A call whose argument list contains a nested call (equal_bytes(token_text(...),
        // expected)) or a single-element byte index load (is_line_break(source[index])) lowers
        // each such argument into a preceding expr temp and references it through a Temp call
        // arg, since inline call-arg descriptors cannot carry a computed call result or a
        // checked byte load (issue 1165 / 1162).
        if try call_has_hoisted_arg_cached(
            ir_bytes, function_name, expr_node, bs, call_arg_type_cache
        ) {
            return try lower_expr_call_with_nested_args(
                ir_bytes, function_name, module_prefix, params_spec, expr_node,
                string_index, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
            );
        }
        let call_info = try compiled_mir_types::lower_call_info_indexed_cached(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, expr_node, bs, call_arg_type_cache
        );
        let args = try compiled_mir_lower_call::lower_call_args_cached(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, string_index, bs,
            ir_lookup_index, call_arg_type_cache
        );
        try insts.append(compiled_mir::call_expr_inst(
            id,
            call_info.return_llvm_type,
            call_info.module_prefix,
            call_info.callee_name,
            args
        ));
        return id;
    }
    // A 'try <expr>' in value/sub-expression position lowers its inner child generically
    // through the same expr path (no inner-kind dispatch), reads the inner's produced
    // error-union LLVM type, and emits a TryUnwrap that unwraps the success value or
    // propagates the failure through this function's own error union (issue 1157 big-bang).
    if std::mem::equal_bytes(kind, "TryExpr") {
        let inner_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, bs
        );
        let operand = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, inner_node,
            string_index, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
        );
        let called_error_union = try expr_inst_llvm_type_by_id(insts, operand);
        let success_type = try try_call_success_type(
            ir_bytes, function_name, module_prefix, inner_node, bs, ir_lookup_index
        );
        let own_error_union = try compiled_signature::derive_return_type_indexed(
            ir_lookup_index, ir_bytes, function_name
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::try_unwrap_expr_inst(
            result_id, success_type, operand, called_error_union, own_error_union
        ));
        return result_id;
    }
    return error("compiled mir: unsupported expression kind");
}

// callee_is_namespace_union_ctor reports whether a Call's callee is a namespace-mode
// FieldExpr (Union::Variant) whose receiver names a tagged-union type, i.e. a union
// constructor. It is non-erroring on a non-union receiver so enum/function namespaced
// calls fall through to the regular call path (issue 1157 PR-P2).
fn callee_is_namespace_union_ctor_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return false;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(callee_mode, "namespace") {
        return false;
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, receiver, bs);
    let receiver_token = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, receiver_sf
    );
    return compiled_fact_lookup::is_union_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, receiver_token
    );
}

// lower_expr_union_ctor_call lowers Union::Variant(payload) into a UnionConstruct that
// stores the discriminant + the single lowered payload value into the union byte buffer
// (issue 1157 PR-P2). The payload's LLVM type comes from the variant fact's payload_kizu,
// so it matches the read side's gep-field-1 + load layout.
fn lower_expr_union_ctor_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let variant_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "namespace", bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_token = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: union constructor takes one payload argument");
    }
    let arg_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    let payload_value = try lower_expr_into(
        ir_bytes, function_name, module_prefix, params_spec, arg_node,
        string_index, id_base, insts, bs, ir_lookup_index, call_arg_type_cache
    );
    let union_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, module_prefix, receiver_token
    );
    let variant = try compiled_fact_lookup::lookup_union_variant_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, receiver_token, variant_name
    );
    let payload_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, module_prefix, variant.payload_kizu
    );
    let id = id_base + insts.len();
    try insts.append(compiled_mir::union_construct_payload_expr_inst(
        id, union_llvm, variant.tag, payload_value, payload_type
    ));
    return id;
}

fn lower_expr_field(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let nf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, expr_node, bs);
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, nf
    );
    if std::mem::equal_bytes(mode, "namespace") {
        let id = id_base + insts.len();
        let variant_name = try ir_contract::body_field_expr_name_from(
            ir_bytes,
            function_name,
            expr_node,
            "namespace",
            nf
        );
        let receiver = try ir_contract::body_child_sequence_from(
            ir_bytes,
            function_name,
            expr_node,
            "receiver",
            0,
            nf
        );
        let receiver_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, receiver, bs
        );
        let receiver_token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            receiver,
            receiver_sf
        );
        if compiled_fact_lookup::is_enum_type_indexed(
            ir_lookup_index, ir_bytes, module_prefix, receiver_token
        ) {
            let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
                ir_lookup_index,
                ir_bytes,
                module_prefix,
                receiver_token,
                variant_name
            );
            try insts.append(compiled_mir::enum_tag_expr_inst(id, tag));
            return id;
        }
        // A payload-less tagged-union variant reference (e.g.
        // std::kizu::ast::AstData::Empty) builds the union aggregate value, not a bare
        // enum tag (issue 1157 PR-P1, tag-only first form). Resolve the union's LLVM aggregate
        // type and the variant discriminant, then materialize it through a UnionConstruct
        // temp. A variant carrying a payload arrives as a Call (handled in lower_expr_into),
        // never through this bare-FieldExpr path.
        let union_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, module_prefix, receiver_token
        );
        let variant = try compiled_fact_lookup::lookup_union_variant_by_prefix_indexed(
            ir_lookup_index, ir_bytes, module_prefix, receiver_token, variant_name
        );
        try insts.append(compiled_mir::union_construct_expr_inst(
            id, union_llvm, variant.tag
        ));
        return id;
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, nf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, receiver_sf
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            receiver,
            receiver_sf
        );
        let field = try compiled_mir_types::resolve_var_receiver_field_expr_indexed_cached(
            ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
            expr_node, nf, receiver_name, bs, call_arg_type_cache
        );
        let id = id_base + insts.len();
        try insts.append(compiled_mir::field_access_expr_inst(
            id,
            field.field_llvm_type,
            receiver_name,
            field.receiver_llvm_type,
            field.field_index
        ));
        return id;
    }
    if !std::mem::equal_bytes(receiver_kind, "FieldExpr") and
        !std::mem::equal_bytes(receiver_kind, "Call") {
        return error("compiled mir: unsupported field expr receiver");
    }
    let receiver_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        receiver,
        0,
        id_base,
        insts,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs,
        call_arg_type_cache
    );
    let id = id_base + insts.len();
    try insts.append(compiled_mir::field_access_temp_expr_inst(
        id,
        field.field_llvm_type,
        receiver_id,
        field.receiver_llvm_type,
        field.field_index
    ));
    return id;
}

fn lower_expr_field_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    // nf tightens this field expression's own structural facts (its field-expr mode, receiver
    // edge, receiver kind/token) to its body-node line via the index; the receiver sorts after
    // it, so a scan from nf reaches the byte-identical facts a scan from bs would. bs is kept
    // for the delegated namespace path, field-type resolution, and lowering recursion.
    let nf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, expr_node, bs);
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, nf
    );
    if std::mem::equal_bytes(mode, "namespace") {
        return try lower_expr_field(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, id_base, insts, bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, nf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, receiver_sf
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            receiver,
            receiver_sf
        );
        let field = try compiled_mir_types::resolve_var_receiver_field_expr_indexed_cached(
            ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
            expr_node, nf, receiver_name, bs, call_arg_type_cache
        );
        let id = id_base + insts.len();
        try insts.append(compiled_mir::field_access_expr_inst(
            id,
            field.field_llvm_type,
            try local_alias_current_name(aliases, receiver_name),
            field.receiver_llvm_type,
            field.field_index
        ));
        return id;
    }
    if !std::mem::equal_bytes(receiver_kind, "FieldExpr") and
        !std::mem::equal_bytes(receiver_kind, "Call") {
        return error("compiled mir: unsupported field expr receiver");
    }
    let receiver_id = try lower_expr_into_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        receiver,
        string_index,
        id_base,
        insts,
        aliases,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
    let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs,
        call_arg_type_cache
    );
    let id = id_base + insts.len();
    try insts.append(compiled_mir::field_access_temp_expr_inst(
        id,
        field.field_llvm_type,
        receiver_id,
        field.receiver_llvm_type,
        field.field_index
    ));
    return id;
}
