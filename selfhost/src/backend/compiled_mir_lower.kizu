    let function_name_name = try nth_param_field(params_spec, 3, true);
    let statements_type = try nth_param_field(params_spec, 4, false);
    let statements_name = try nth_param_field(params_spec, 4, true);
    let let_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "Let"
    );
    if !let_variant.found {
        return error("compiled mir: lower_run_ast_block Let variant not found");
    }
    let expr_stmt_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "ExprStmt"
    );
    if !expr_stmt_variant.found {
        return error("compiled mir: lower_run_ast_block ExprStmt variant not found");
    }
    let return_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "Return"
    );
    if !return_variant.found {
        return error("compiled mir: lower_run_ast_block Return variant not found");
    }
    let empty_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix(
        ir_bytes, ir_bytes[0..0], "std::kizu::ast::AstData", "Empty"
    );
    if !empty_variant.found {
        return error("compiled mir: lower_run_ast_block Empty variant not found");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::lower_run_ast_block_stmt(
        text_name, ast_name, ast_type, declarations_name, declarations_type,
        function_name_name, statements_name, statements_type, "%kizu.selfhost.codegen.local_table",
        let_variant.tag, expr_stmt_variant.tag, return_variant.tag, empty_variant.tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
