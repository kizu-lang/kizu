    let offset_name = try nth_param_field(params_spec, 1, true);
    let initial_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::token_at_stmt(
        source_name, offset_name, initial_name, position_type, llvm_return_type,
        "kizu_kizu__lexer_is_space", "kizu_kizu__lexer_advance_byte",
        "kizu_kizu__lexer_is_doc_comment_start", "kizu_kizu__lexer_skip_line_comment",
        "kizu_kizu__lexer_position", "kizu_kizu__lexer_raw_token_at",
        "kizu_kizu__lexer_attach_doc"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_skip_line_comment_function lowers std::kizu::lexer::skip_line_comment into a single
// SkipLineComment statement: a two-phi loop threading the i64 end and the Position struct current
// past a comment line, folding advance_byte until newline, then building the Eof Token (tracker
// 961, scope 4 prerequisite). Its struct loop-carried variable, compound 'end < len and
// source[end] != 10' condition, and call-in-loop the generic while machinery does not model, so it
// is dispatched by name. The TokenKind::Eof tag is resolved from the enum-variant facts.
pub fn lower_skip_line_comment_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let initial_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let eof_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix(
        ir_bytes, "std::kizu::lexer::", "TokenKind", "Eof"
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::skip_line_comment_stmt(
        source_name, start_name, initial_name, position_type, llvm_return_type,
        "kizu_kizu__lexer_advance_byte", "kizu_kizu__lexer_token", eof_tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_is_doc_comment_start_function lowers std::kizu::lexer::is_doc_comment_start into a single
