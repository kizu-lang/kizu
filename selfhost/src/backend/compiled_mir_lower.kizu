// lower_run_ast_block_function lowers selfhost::ir::codegen::lower_run_ast_block into a single
// LowerRunAstBlock statement: the stateful run-block traversal that threads a mutable LocalTable
// and index through a bounded loop over the block statements, lowering non-terminal Let bindings
// and terminal ExprStmt print or empty Return (tracker 961, scope 4 prerequisite). The
// needed discriminant tags come from the union-variant facts.
pub fn lower_run_ast_block_function(
    ir_bytes: []u8,
    function_name: []u8,
