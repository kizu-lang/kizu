    pub temp_counter: i64,
    pub try_counter: i64,
    pub alias_counter: i64,
}

pub struct VoidBodyLowerResult {
    pub locals_spec: []u8,
    pub string_counter: i64,
    pub temp_counter: i64,
    pub try_counter: i64,
    pub alias_counter: i64,
    pub body_returns: bool,
}

fn void_then_alias_name(slot: i64) -> ![]u8 {
    if slot < 0 {
        return error("compiled mir: negative void then alias slot");
    }
    var out = std::string::String(std::mem::page_allocator());
    try out.append_bytes("void.then.alias.");
    try std::fmt::append_i64(&var out, slot);
    let name = out.as_bytes();
    // Map insertion is the available safe byte-copy boundary for a generated []u8 name; the MIR
    // keeps the returned alias after this helper returns, so a direct String.as_bytes view cannot
    // escape.
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(name, name);
    return try copied.get(name);
}

// shadow_binding_name renders a shadowed let binding's per-binding-unique SSA name,
// '<source>.shadow.<slot>'. The slot is the binding's own IR statement node, unique within
// the function, so two same-named bindings (e.g. parse_closed_start_slice's then-block
// 'let end = ast.add_empty(...)' and the enclosing 'let end = try parse_expr(...)') receive
// distinct LLVM names and never define the same %end twice. It mirrors void_then_alias_name's
// Map insert/get byte-copy boundary so the generated name outlives the helper.
fn shadow_binding_name(source_name: []u8, slot: i64) -> ![]u8 {
    if slot < 0 {
        return error("compiled mir: negative shadow binding slot");
    }
    var out = std::string::String(std::mem::page_allocator());
    try out.append_bytes(source_name);
    try out.append_bytes(".shadow.");
    try std::fmt::append_i64(&var out, slot);
    let name = out.as_bytes();
    var copied = std::map::Map<[]u8, []u8>(std::mem::page_allocator());
    try copied.insert(name, name);
    return try copied.get(name);
}

// count_let_bindings_in_block counts the let/var bindings of 'name' in one statement block,
// descending into while bodies and if then/else blocks so a binding nested in a branch counts
// alongside one at the enclosing level. Two or more bindings of the same name in a function
// means the name is shadowed: each binding must take a distinct SSA name.
fn count_let_bindings_in_block(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8,
    block_node: i64,
    bs: i64
) -> !i64 {
    var count = 0;
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, bs
        );
        if statement < 0 {
            return count;
        }
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let bound = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(bound, name) {
                count = count + 1;
            }
        }
        if std::mem::equal_bytes(stmt_kind, "While") {
            let body_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "body", 0, bs
            );
            count = count + try count_let_bindings_in_block(
                ir_bytes, function_name, name, body_node, bs
            );
        }
        if std::mem::equal_bytes(stmt_kind, "If") {
            let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "then", 0, bs
            );
            if then_node >= 0 {
                count = count + try count_let_bindings_in_block(
                    ir_bytes, function_name, name, then_node, bs
                );
            }
            let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "else", 0, bs
            );
            if else_node >= 0 {
                count = count + try count_let_bindings_in_block(
                    ir_bytes, function_name, name, else_node, bs
                );
            }
        }
        stmt_index = stmt_index + 1;
    }
    return count;
}

// let_binding_is_shadowed reports whether 'name' is bound by two or more let/var statements in
// the function body. A shadowed name cannot keep its source spelling as its SSA name: the inner
// and outer bindings would define the same %name, which is invalid LLVM. The renamed binding is
// redirected through the local-alias map so in-scope reads still resolve to it.
fn let_binding_is_shadowed(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8,
    bs: i64
) -> !bool {
    let total = try count_let_bindings_in_block(ir_bytes, function_name, name, 0, bs);
    return total >= 2;
}

fn local_alias_index(
    aliases: &std::array::Array<LocalAliasState>,
    source_name: []u8
) -> !i64 {
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if std::mem::equal_bytes(state.source_name, source_name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn local_alias_current_name(
    aliases: &std::array::Array<LocalAliasState>,
    source_name: []u8
) -> ![]u8 {
    let index = try local_alias_index(aliases, source_name);
    if index < 0 {
        return source_name;
    }
    let state = try aliases.at(index);
    return state.current_name;
}

fn set_local_alias(
    aliases: &var std::array::Array<LocalAliasState>,
    source_name: []u8,
    current_name: []u8
) -> !void {
    let index = try local_alias_index(aliases, source_name);
    if index < 0 {
        try aliases.append(LocalAliasState {
            source_name: source_name,
            current_name: current_name
        });
        return;
    }
    try aliases.set(index, LocalAliasState {
        source_name: source_name,
        current_name: current_name
    });
    return;
}

fn copy_local_aliases(
    aliases: &std::array::Array<LocalAliasState>
) -> !std::array::Array<LocalAliasState> {
    var copied = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        try copied.append(LocalAliasState {
            source_name: state.source_name,
            current_name: state.current_name
        });
        index = index + 1;
    }
    return copied;
}

fn lower_call_args_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    first_string_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64
) -> !std::array::Array<compiled_mir::MirCallArg> {
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        index = index + 1;
    }
    return try compiled_mir_lower_call::lower_call_args_with_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        call_node,
        first_string_index,
        &alias_sources,
        &alias_currents,
        bs
    );
}

fn lower_call_args_with_local_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    first_string_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !std::array::Array<compiled_mir::MirCallArg> {
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        index = index + 1;
    }
    return try compiled_mir_lower_call::lower_call_args_with_aliases_cached(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        call_node,
        first_string_index,
        &alias_sources,
        &alias_currents,
        bs,
        ir_lookup_index, call_arg_type_cache
    );
}

// lower_single_call_arg_with_local_aliases lowers a single call argument while resolving any local
// alias on its operands -- the single-argument counterpart of lower_call_args_with_local_aliases. A
// field-read or call argument whose receiver var was reassigned through a branch merge in the same
// loop body (parse_impl_decl: 'methods.append(method.node)' after 'method' is reseated in an
// if/else) must read the merged %void.then.alias.N value, not the receiver's loop-top let-init.
// With no aliases the alias tables are empty and this is byte-identical to lower_single_call_arg.
fn lower_single_call_arg_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    string_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64
) -> !compiled_mir::MirCallArg {
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        index = index + 1;
    }
    return try compiled_mir_lower_call::lower_single_call_arg_with_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        arg_type,
        arg_node,
        string_index,
        &alias_sources,
        &alias_currents,
        bs
    );
}

fn lower_single_call_arg_with_local_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
