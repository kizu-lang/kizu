fn print_gate_payload(payload: &compiled_mir::MirPrintStmt) -> !void {
    match payload.transport {
        SliceU8 => print("slice");,
        _ => print("not-slice");,
    }
    print(payload.value_llvm_type);
    print(payload.value_result_id);
    print(payload.value_insts.len());
    return;
}

pub fn gate_print_statement_lowering() -> !void {
    let facts = "abi-repr []u8 %kizu.slice.u8
canonical-type 0 intrinsic void 1 -1 0
canonical-type 1 intrinsic u8 7 -1 0
canonical-type 2 slice - -1 -1 1 1
canonical-type 3 intrinsic i64 6 -1 0
body-node app::main 0 depth 0 kind ExprStmt span 0 21
body-edge app::main 0 expr 0 1
body-node app::main 1 depth 1 kind Call span 5 20
body-edge app::main 1 arg 0 2
body-node app::main 2 depth 2 kind String span 11 19
body-token app::main 2 hex:22686922
body-call-builtin app::main 5 20 language print -
body-call-type-ids app::main 5 20 -1 0 1 3 1 2
";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var canonical_facts = try compiled_canonical_facts::parse_and_validate(
        &index, facts
    );
    defer canonical_facts.deinit();
    var cache = compiled_mir_types::call_arg_type_cache();
    defer cache.deinit();
    try compiled_mir_types::build_fn_node_index(
        &var cache, &index, facts, "app::main"
    );
    var aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer aliases.deinit();
    var statements = std::array::Array<compiled_mir::MirStmt>(
        std::mem::page_allocator()
    );
    let lowered = try lower_multi_expr_statement(
        facts, "app::main", "app::", "void", "", 0, 0, 0, 0,
        &aliases, &var statements, 0, &index, &canonical_facts, &var cache
    );
    std::testing::expect(lowered.string_counter == 1);
    std::testing::expect(lowered.temp_counter == 1);
    std::testing::expect(lowered.try_counter == 0);
    let statement = try statements.at(0);
    match statement {
        Print(payload) => try print_gate_payload(payload);,
        _ => return error("compiled mir gate: print did not lower to MirPrintStmt");,
    }
    var function = compiled_mir_function::multi_statement_function(
        "print_statement_lowering_gate", "void", "", statements
    );
    defer function.deinit();
    return;
}

fn exact_struct_field(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    type_context: []u8,
    kizu_type: []u8,
    field_name: []u8
) -> !compiled_fact_lookup::StructFieldLookup {
    let resolved = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, type_context, kizu_type
    );
    return try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        index, ir_bytes, resolved.canonical_identity, field_name
    );
}

fn exact_type_abi(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    type_context: []u8,
    kizu_type: []u8
) -> ![]u8 {
    let resolved = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, type_context, kizu_type
    );
    return resolved.abi;
}

fn resolved_function_local_name(
    function: &compiled_type_resolver::ResolvedFunction
) -> []u8 {
    let owner_len = std::mem::len(function.owner_module);
    return function.canonical_identity[
        owner_len..std::mem::len(function.canonical_identity)
    ];
}

fn exact_non_error_call(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64
) -> !compiled_type_resolver::ResolvedFunction {
    let function = try compiled_type_resolver::resolve_call_indexed(
        index, ir_bytes, function_name, call_node
    );
    if function.returns_error {
        return error("compiled mir: lexer wrapper call cannot return an error union");
    }
    return function;
}

fn exact_struct_field_by_identity(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_identity: []u8,
    field_name: []u8
) -> !compiled_fact_lookup::StructFieldLookup {
    let field = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        index, ir_bytes, canonical_identity, field_name
    );
    if !field.found {
        return error("compiled mir: exact struct field not found");
    }
    return field;
}

fn exact_field_type_abi(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    field: &compiled_fact_lookup::StructFieldLookup
) -> ![]u8 {
    let resolved = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, field.declaring_module, field.field_type
    );
    return resolved.abi;
}

fn require_exact_call_arg_types(
    actual: &std::array::Array<[]u8>,
    expected0: []u8,
    expected1: []u8,
    expected2: []u8,
    expected3: []u8,
    expected_count: i64
) -> !void {
    if actual.len() != expected_count {
        return error("compiled mir: lexer wrapper call argument count mismatch");
    }
    if expected_count > 0 and !std::mem::equal_bytes(try actual.get(0), expected0) {
        return error("compiled mir: lexer wrapper first call argument ABI mismatch");
    }
    if expected_count > 1 and !std::mem::equal_bytes(try actual.get(1), expected1) {
        return error("compiled mir: lexer wrapper second call argument ABI mismatch");
    }
    if expected_count > 2 and !std::mem::equal_bytes(try actual.get(2), expected2) {
        return error("compiled mir: lexer wrapper third call argument ABI mismatch");
    }
    if expected_count > 3 and !std::mem::equal_bytes(try actual.get(3), expected3) {
        return error("compiled mir: lexer wrapper fourth call argument ABI mismatch");
    }
    return;
}

struct TokenKindFieldAbi {
    token_type: []u8,
    enum_module: []u8,
    enum_name: []u8,
    field_index: i64,
}

fn resolve_token_kind_field_abi(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    params_spec: []u8,
    token_name: []u8,
    field_name: []u8,
    bs: i64
) -> !TokenKindFieldAbi {
    let owner_module = try compiled_type_resolver::function_owner_module_indexed(
        index, ir_bytes, function_name
    );
    let token_spelling = try compiled_mir_types::resolve_value_kizu_type_indexed(
        index, ir_bytes, function_name, owner_module, params_spec, token_name, bs
    );
    let token_type = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, owner_module, token_spelling
    );
    let kind_field = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        index, ir_bytes, token_type.canonical_identity, field_name
    );
    if !kind_field.found {
        return error("compiled mir: token-kind predicate field not found");
    }
    let kind_type = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, kind_field.declaring_module, kind_field.field_type
    );
    let enum_module = kind_type.declaring_module;
    let enum_name = kind_type.canonical_identity[
        std::mem::len(enum_module)..std::mem::len(kind_type.canonical_identity)
    ];
    return TokenKindFieldAbi {
        token_type: token_type.abi,
        enum_module: enum_module,
        enum_name: enum_name,
        field_index: kind_field.index
    };
}

pub fn gate_custom_token_kind_field_abi() -> !void {
    let facts = "function-owner-module app::pred::is_kind app::pred::
function-signature-return app::pred::is_kind bool
function-signature-param app::pred::is_kind 0 token:runtime:lib::lexer::Lexeme
type-llvm lib::lexer::Lexeme %test.lexeme
struct-field lib::lexer::Lexeme 0 source []u8
struct-field lib::lexer::Lexeme 1 offset i64
struct-field lib::lexer::Lexeme 2 line i64
struct-field lib::lexer::Lexeme 3 column i64
struct-field lib::lexer::Lexeme 4 end_line i64
struct-field lib::lexer::Lexeme 5 end_column i64
struct-field lib::lexer::Lexeme 6 category Category
enum-type lib::lexer::Category i64
enum-variant lib::lexer::Category Word 4";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var canonical_facts = try compiled_canonical_facts::parse_and_validate(
        &index, facts
    );
    defer canonical_facts.deinit();
    let abi = try resolve_token_kind_field_abi(
        &index, facts, "app::pred::is_kind", "%test.lexeme token;",
        "token", "category", 0
    );
    let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        &index, facts, abi.enum_module, abi.enum_name, "Word"
    );
    print(abi.token_type);
    print(abi.enum_module);
    print(abi.enum_name);
    print(abi.field_index);
    print(tag);
    return;
}

struct NodeFieldFetchAbi {
    get_module: []u8,
    get_name: []u8,
    receiver_type: []u8,
    index_type: []u8,
    node_type: []u8,
    field_identity: []u8,
    field_type: []u8,
    field_index: i64,
}

fn resolve_node_field_fetch_abi(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    field_name: []u8
) -> !NodeFieldFetchAbi {
    let get_function = try compiled_type_resolver::resolve_call_indexed(
        index, ir_bytes, function_name, call_node
    );
    if get_function.returns_error {
        return error("compiled mir: node fetch cannot return an error union");
    }
    let data_field = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        index, ir_bytes, get_function.return_type.canonical_identity, field_name
    );
    if !data_field.found {
        return error("compiled mir: node fetch field not found on return type");
    }
    let resolved_field = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, data_field.declaring_module, data_field.field_type
    );
    var call_types = try compiled_mir_types::lower_call_arg_types_indexed(
        index, ir_bytes, ir_bytes[0..0], get_function.canonical_identity, 2
    );
    defer call_types.deinit();
    if call_types.len() != 2 {
        return error("compiled mir: node fetch requires receiver and index parameters");
    }
    let get_name = get_function.canonical_identity[
        std::mem::len(get_function.owner_module)..
        std::mem::len(get_function.canonical_identity)
    ];
    return NodeFieldFetchAbi {
        get_module: get_function.owner_module,
        get_name: get_name,
        receiver_type: try call_types.get(0),
        index_type: try call_types.get(1),
        node_type: get_function.return_type.abi,
        field_identity: resolved_field.canonical_identity,
        field_type: resolved_field.abi,
        field_index: data_field.index
    };
}

struct MatchUnionAbi {
    fetch: NodeFieldFetchAbi,
    union_identity: []u8,
}

// resolve_match_union_abi is the shared acceptance boundary for the dedicated
// match consumers. The call-target fact owns the returned node identity; the
// exact field fact on that identity owns the tagged-union identity and ABI.
fn resolve_match_union_abi(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    field_name: []u8
) -> !MatchUnionAbi {
    let fetch = try resolve_node_field_fetch_abi(
        index, ir_bytes, function_name, call_node, field_name
    );
    let exact_union = try compiled_type_resolver::exact_union_type_indexed(
        index, ir_bytes, fetch.field_identity
    );
    if !exact_union.found {
        return error("compiled mir: match-union scrutinee field is not a union");
    }
    if !std::mem::equal_bytes(exact_union.value, fetch.field_type) {
        return error("compiled mir: match-union exact union ABI mismatch");
    }
    let union_identity = fetch.field_identity;
    return MatchUnionAbi {
        fetch: fetch,
        union_identity: union_identity
    };
}

pub fn gate_imported_match_union_abi() -> !void {
    let facts = "function-owner-module app::use::visit app::use::
module-alias app::use::defs lib::defs::
function-owner-module lib::defs::fetch lib::defs::
function-signature-return lib::defs::fetch Node
function-signature-param lib::defs::fetch 0 self:runtime:Tree
function-signature-param lib::defs::fetch 1 index:runtime:i64
type-llvm lib::defs::Tree %test.tree
type-llvm lib::defs::Node %test.node
struct-field lib::defs::Node 0 event Event
union-type lib::defs::Event %test.event
union-variant lib::defs::Event Empty 0 void
union-variant lib::defs::Event Value 1 i64
body-node app::use::visit 7 depth 0 kind Call span 20 30
body-call-target app::use::visit 20 30 lib::defs::fetch";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let resolved = try resolve_match_union_abi(
        &index, facts, "app::use::visit", 7, "event"
    );
    print(resolved.fetch.get_module);
    print(resolved.fetch.get_name);
    print(resolved.fetch.node_type);
    print(resolved.union_identity);
    print(resolved.fetch.field_type);
    print(resolved.fetch.field_index);
    return;
}

struct NodeSpanFetchAbi {
    fetch: NodeFieldFetchAbi,
    start_index: i64,
    end_index: i64,
}

fn resolve_node_span_fetch_abi(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64
) -> !NodeSpanFetchAbi {
    let fetch = try resolve_node_field_fetch_abi(
        index, ir_bytes, function_name, call_node, "span"
    );
    let start = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        index, ir_bytes, fetch.field_identity, "start"
    );
    let end = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        index, ir_bytes, fetch.field_identity, "end"
    );
    if !start.found or !end.found {
        return error("compiled mir: node span bounds not found");
    }
    let start_type = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, start.declaring_module, start.field_type
    );
    let end_type = try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, end.declaring_module, end.field_type
    );
    if fixed_abi_contract::from_llvm(start_type.abi).kind !=
        fixed_abi_contract::FixedAbiKind::Integer64 {
        return error("compiled mir: node span start must lower to i64");
    }
    if fixed_abi_contract::from_llvm(end_type.abi).kind !=
        fixed_abi_contract::FixedAbiKind::Integer64 {
        return error("compiled mir: node span end must lower to i64");
    }
    return NodeSpanFetchAbi {
        fetch: fetch,
        start_index: start.index,
        end_index: end.index
    };
}

fn let_call_at_statement(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64,
    bs: i64
) -> !i64 {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", statement_index, bs
    );
    let statement_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, statement, bs
    );
    if !std::mem::equal_bytes(statement_kind, "Let") {
        return error("compiled mir: node fetch statement must be a let");
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, value, bs
    );
    if !std::mem::equal_bytes(value_kind, "Call") {
        return error("compiled mir: node fetch let must bind a call");
    }
    return value;
}

pub fn gate_imported_node_span_abi() -> !void {
    let facts = "function-owner-module app::use::visit app::use::
function-owner-module lib::defs::fetch lib::defs::
function-signature-return lib::defs::fetch Node
function-signature-param lib::defs::fetch 0 self:runtime:Tree
function-signature-param lib::defs::fetch 1 index:runtime:Index
type-llvm lib::defs::Tree %test.tree
type-llvm lib::defs::Index %test.index
type-llvm lib::defs::Node %test.node
struct-field lib::defs::Node 0 id i64
struct-field lib::defs::Node 1 parent Index
struct-field lib::defs::Node 2 flags i64
struct-field lib::defs::Node 3 span Range
type-llvm lib::defs::Range %test.range
struct-field lib::defs::Range 0 source_id i64
struct-field lib::defs::Range 1 line i64
struct-field lib::defs::Range 2 start i64
struct-field lib::defs::Range 3 start_column i64
struct-field lib::defs::Range 4 end_column i64
struct-field lib::defs::Range 5 end i64
body-node app::use::visit 7 depth 0 kind Call span 20 30
body-call-target app::use::visit 20 30 lib::defs::fetch";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let resolved = try resolve_node_span_fetch_abi(
        &index, facts, "app::use::visit", 7
    );
    print(resolved.fetch.get_module);
    print(resolved.fetch.get_name);
    print(resolved.fetch.receiver_type);
    print(resolved.fetch.index_type);
    print(resolved.fetch.node_type);
    print(resolved.fetch.field_type);
    print(resolved.fetch.field_index);
    print(resolved.start_index);
    print(resolved.end_index);
    return;
}

pub fn lower_string_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let return_abi = fixed_abi_contract::from_llvm(llvm_return_type);
    if return_abi.kind != fixed_abi_contract::FixedAbiKind::SliceU8 {
        return error("compiled mir: string return requires []u8");
    }
    let token = try ir_contract::body_token_or_empty_from(
        ir_bytes,
        function_name,
        value_node,
        bs
    );
    let _payload_len = try compiled_util::string_token_decoded_len(
        token,
        "compiled mir: invalid string token"
    );
    return compiled_mir_function::single_const_string_return_function(llvm_symbol, token);
}
pub fn lower_int_return_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    value_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    if !std::mem::equal_bytes(llvm_return_type, "i64") {
        return error("compiled mir: int return requires i64");
    }
    let value = try ir_contract::body_int_value_from(
        ir_bytes,
        function_name,
        value_node,
        bs
    );
    return compiled_mir_function::single_const_int_return_function(llvm_symbol, value);
}
pub fn lower_enum_field_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    value_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    if !std::mem::equal_bytes(llvm_return_type, "i64") {
        return error("compiled mir: enum field return requires i64");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes,
        function_name,
        value_node,
        "namespace",
        bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes,
        function_name,
        value_node,
        "receiver",
        0,
        bs
    );
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    let receiver_name = try namespace_expression_name(
        ir_lookup_index,
        ir_bytes,
        function_name,
        receiver,
        bs,
        call_arg_type_cache
    );
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let receiver_type = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, receiver_name
    );
    let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index,
        ir_bytes,
        ir_bytes[0..0],
        receiver_type.canonical_identity,
        field_name
    );
    return compiled_mir_function::single_const_int_return_function(llvm_symbol, tag);
}
pub fn lower_call_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    instance_context: &compiled_instance_context::InstanceContext,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    try compiled_mir_types::set_instance_context(
        call_arg_type_cache, instance_context
    );
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    let module_prefix = compiled_util::module_prefix_of(function_name);
    if try callee_is_field_expr_cached(
        ir_bytes, function_name, call_node, bs, call_arg_type_cache
    ) {
        var insts = std::array::Array<compiled_mir::MirExprInst>(
            std::mem::page_allocator()
        );
        let result_id = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, call_node,
            0, 0, &var insts, bs, ir_lookup_index, canonical_facts,
            call_arg_type_cache
        );
        return compiled_mir_function::single_expr_return_function(
            llvm_symbol, llvm_return_type, params_spec, result_id, insts
        );
    }
    // Runtime-owned container construction is answered by its runtime symbol, not by an emitted
    // instance function: 'return std::array::Array<u8>(allocator);' -- and the wrapped field of a
    // transparent wrapper such as std::string::String, which returns exactly that -- has no
    // instance to call. The let lowering resolves the same descriptor.
    let owned_constructor = try compiled_type_resolver::owned_constructor_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if owned_constructor.found {
        let constructor_runtime = builtin_contract::owned_container_constructor_runtime(
            owned_constructor.family
        );
        if !constructor_runtime.found {
            return error("compiled mir: unsupported owned constructor runtime ABI");
        }
        if !std::mem::equal_bytes(owned_constructor.result_type.abi, llvm_return_type) {
            return error("compiled mir: owned constructor return ABI mismatch");
        }
        let ctor_arg_count = try compiled_mir_types::count_call_args_cached(
            ir_bytes, function_name, call_node, bs, &call_arg_type_cache
        );
        if ctor_arg_count != 1 {
            return error("compiled mir: owned constructor takes exactly the allocator argument");
        }
        let alloc_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", 0, bs
        );
        let alloc_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, alloc_node, bs
        );
        if !std::mem::equal_bytes(alloc_kind, "Var") {
            return error("compiled mir: owned constructor return allocator must be a value name");
        }
        let alloc_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, alloc_node, bs
        );
        let allocator_spelling =
            try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
                ir_lookup_index, ir_bytes, function_name, module_prefix,
                params_spec, alloc_name, bs, call_arg_type_cache
            );
        let allocator_type = try compiled_type_resolver::resolve_type_indexed(
            ir_lookup_index, ir_bytes, module_prefix, allocator_spelling
        );
        if !std::mem::equal_bytes(allocator_type.canonical_identity, "Allocator") {
            return error("compiled mir: owned constructor argument is not an Allocator");
        }
        var constructor_args = std::array::Array<compiled_mir::MirCallArg>(
            std::mem::page_allocator()
        );
        try constructor_args.append(compiled_mir::var_call_arg(
            allocator_type.abi, alloc_name
        ));
        if constructor_runtime.type_size_argument_slot >= 0 {
            if !owned_constructor.type_arguments_concrete or
                std::mem::len(owned_constructor.storage_type.abi) == 0 {
                return error("compiled mir: owned constructor storage type is not concrete");
            }
            try constructor_args.append(try compiled_mir::type_size_call_arg(
                owned_constructor.storage_type.abi
            ));
        }
        return compiled_mir_function::single_call_return_function(
            llvm_symbol,
            owned_constructor.result_type.abi,
            params_spec,
            "",
            constructor_runtime.symbol,
            constructor_args
        );
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, &call_arg_type_cache
    );
    let instance =
        try compiled_type_resolver::call_instance_symbol_for_instance_indexed(
            ir_lookup_index,
            ir_bytes,
            instance_context.instance_id,
            function_name,
            call_node
    );
    let call_result_type = call_info.return_llvm_type;
    if instance.found and !std::mem::equal_bytes(
        call_result_type, llvm_return_type
    ) {
        return error("compiled instance call return ABI mismatch");
    }
    let args = try compiled_mir_lower_call::lower_call_args_instance(
        ir_bytes, function_name, module_prefix, params_spec, call_node, 0, bs,
        ir_lookup_index, canonical_facts, instance_context, &call_info.types,
        call_arg_type_cache
    );
    return compiled_mir_function::single_call_return_function(
        llvm_symbol,
        call_result_type,
        params_spec,
        call_info.module_prefix,
        call_info.callee_name,
        args
    );
}
// callee_is_field_expr reports whether the value node is a Call whose callee is a
// field-mode FieldExpr, i.e. a struct-field method call (receiver.method()) rather
// than a free function or namespaced call. It distinguishes the read-only AST/array
// accessor lowering (self.children.len() / self.children.get(...)) from the direct
// codegen-helper call lowering and from namespaced calls (Foo::bar(), Variant::X())
// whose callee is a namespace-mode FieldExpr, which must keep using the free-function
// call path (tracker 961).
pub fn callee_is_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, bs
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return false;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, bs
    );
    return std::mem::equal_bytes(callee_mode, "field");
}

pub fn callee_is_field_expr_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, cf
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return false;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, cf
    );
    return std::mem::equal_bytes(callee_mode, "field");
}

fn call_callee_field_expr_mode_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, cf
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return 0;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, cf
    );
    if std::mem::equal_bytes(callee_mode, "field") {
        return 1;
    }
    if std::mem::equal_bytes(callee_mode, "namespace") {
        return 2;
    }
    return 0;
}

// is_array_field_type reports whether a recorded struct-field type token is a
// std::array::Array<T>. The read-only Ast.len accessor only lowers Array.len(),
// so this gates the array_len builtin call; any other receiver field type is
// rejected rather than silently mis-lowered (tracker 961).
fn is_array_field_type(field_type: []u8) -> bool {
    return std::mem::starts_with(field_type, "std::array::Array<");
}

fn is_string_value_type(kizu_type: []u8) -> bool {
    return std::mem::equal_bytes(kizu_type, "std::string::String");
}

// array_element_kizu_type strips the std::array::Array<...> wrapper off a recorded
// field type token and returns the element type token (tracker 961). It backs the
// Array<T>.get accessor, which needs the element type to lower the by-value load.
fn array_element_kizu_type(field_type: []u8) -> ![]u8 {
    let prefix = "std::array::Array<";
    let prefix_len = std::mem::len(prefix);
    let field_len = std::mem::len(field_type);
    if field_len <= prefix_len or field_type[field_len - 1] != cast<u8>(62) {
        return error("compiled mir: malformed std::array::Array element type");
    }
    return field_type[prefix_len..field_len - 1];
}

// last_struct_field_index returns the struct-field index of the last lowered field,
// used to name the struct insertvalue chain result (tracker 961). Reading it in a
// helper keeps the borrow of the fields array from outliving the array move.
fn last_struct_field_index(
    fields: &std::array::Array<compiled_mir::MirStructField>
) -> !i64 {
    let last_field = try fields.at(fields.len() - 1);
    return last_field.index;
}

// call_returns_spanned_node distinguishes source node accessors from builtin
// container get operations by exact call target and returned struct facts.
fn call_returns_spanned_node(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64
) -> !bool {
    let target = try compiled_type_resolver::call_target_indexed(
        index, ir_bytes, function_name, call_node
    );
    if !target.found {
        return false;
    }
    let function = try compiled_type_resolver::resolve_call_indexed(
        index, ir_bytes, function_name, call_node
    );
    if function.returns_error { return false; }
    let span = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        index, ir_bytes, function.return_type.canonical_identity, "span"
    );
    return span.found;
}

// lower_multi_let_ast_get lowers 'let <node> = <ast>.get(<node_id>);' into a LetCall
// against the compiled std::kizu::ast::ast_get accessor, binding the AstNode by value.
fn lower_multi_let_ast_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // cf tightens this call's own structural facts (callee/receiver edges, receiver token, arg
    // edge/kind) to the call node's body-node line via the index; the subtree sorts at-or-after
    // it, so a scan from cf is byte-identical to one from bs. The hoisted/single arg lowering
    // recurses into expr lowering, so it keeps bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, cf
    );
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: Ast.get takes one node id argument");
    }
    let get_function = try compiled_type_resolver::resolve_call_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if get_function.returns_error {
        return error("compiled mir: node get let cannot bind an error union");
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    var runtime_arg_nodes =
        try compiled_mir_lower_call::canonical_runtime_arg_nodes(
            ir_bytes, function_name, call_node, bs, ir_lookup_index,
            &call_info.types
        );
    defer runtime_arg_nodes.deinit();
    if runtime_arg_nodes.len() != 1 {
        return error("compiled mir: Ast.get canonical runtime argument mismatch");
    }
    let arg_node = try runtime_arg_nodes.get(0);
    let receiver_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, call_info.types.receiver_id
        );
    let index_id = try compiled_canonical_facts::parsed_call_runtime_type_id(
        canonical_facts, &call_info.types, 0
    );
    let index_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, index_id
        );
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::var_call_arg(receiver_type, receiver_alias));
    var cur_locals = locals_spec;
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, cf);
    var id_arg = compiled_mir::var_call_arg(index_type, "");
    if std::mem::equal_bytes(arg_kind, "TryExpr") {
        let hoist_name = try hoisted_try_arg_name(cur_try, call_arg_type_cache);
        let hoist_result = try lower_hoisted_try_arg(
            ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
            arg_node, hoist_name, cur_string, cur_temp, cur_try, aliases, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        cur_locals = hoist_result.locals_spec;
        cur_string = hoist_result.string_counter;
        cur_temp = hoist_result.temp_counter;
        cur_try = hoist_result.try_counter;
        id_arg = compiled_mir::var_call_arg(index_type, hoist_name);
    } else {
        // The argument resolves through the local aliases, like the receiver above: a node id an
        // earlier statement rebound ('let child = try ast.child_at(..);' shadowing an outer
        // binding) must read the value that statement produced, not the shadowed name.
        id_arg = try lower_single_call_arg_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, cur_locals,
            index_type, arg_node, cur_string, aliases, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        if id_arg.kind == compiled_mir::MirCallArgKind::String {
            cur_string = cur_string + 1;
        }
    }
    try args.append(id_arg);
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, cur_locals, let_name, get_function.return_type.canonical_identity
    );
    try stmts.append(compiled_mir::let_call_stmt(
        let_name, call_info.return_llvm_type, cur_string,
        call_info.module_prefix, call_info.callee_name, args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: cur_string,
        temp_counter: cur_temp,
        try_counter: cur_try
    };
}

// call_method_name_is reports whether a field-mode call's method name matches name.
pub fn call_method_name_is(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    return std::mem::equal_bytes(method_name, name);
}

pub fn call_method_name_is_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    name: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", cf
    );
    return std::mem::equal_bytes(method_name, name);
}

fn call_value_receiver_lookup_type_cached(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if !try callee_is_field_expr_cached(ir_bytes, function_name, call_node, bs, call_arg_type_cache) {
        return ir_bytes[0..0];
    }
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver_node, cf
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return ir_bytes[0..0];
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs,
        call_arg_type_cache
    );
    return compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
}

fn call_is_value_array_get_cached(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let receiver_lookup = try call_value_receiver_lookup_type_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
        call_node, bs, call_arg_type_cache
    );
    if !is_array_field_type(receiver_lookup) {
        return false;
    }
    return try call_method_name_is_cached(
        ir_bytes, function_name, call_node, "get", bs, call_arg_type_cache
    );
}

fn call_is_source_error_accessor_cached(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let target = try compiled_type_resolver::call_target_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if !target.found { return false; }
    let function = try compiled_type_resolver::resolve_call_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if !function.returns_error { return false; }
    return try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, bs, call_arg_type_cache
    ) == 2;
}

fn call_is_supported_let_try_accessor_cached(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    if !try callee_is_field_expr_cached(
        ir_bytes, function_name, call_node, bs, call_arg_type_cache
    ) {
        return false;
    }
    if try call_is_value_array_get_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
        call_node, bs, call_arg_type_cache
    ) {
        return true;
    }
    return try call_is_source_error_accessor_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
        call_node, bs, call_arg_type_cache
    );
}

fn call_method_receiver_is_var(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    return std::mem::equal_bytes(receiver_kind, "Var");
}

struct MethodCallInfo {
    receiver_name: []u8,
    receiver_llvm_type: []u8,
    // A nonnegative field index means receiver_name names the root struct and
    // the runtime receiver is extracted from receiver_source_llvm_type first.
    receiver_source_llvm_type: []u8,
    receiver_field_index: i64,
    // return_llvm_type is the source-semantic result. The storage result is
    // the physical runtime call ABI and may be an erased borrowed view.
    return_llvm_type: []u8,
    storage_return_llvm_type: []u8,
    success_llvm_type: []u8,
    result_transport: builtin_contract::RuntimeResultTransport,
    module_prefix: []u8,
    callee_name: []u8,
    runtime_operation: i64,
}

struct MethodReceiverInfo {
    name: []u8,
    llvm_type: []u8,
    full_spelling: []u8,
    canonical_identity: []u8,
    type_context: []u8,
    source_llvm_type: []u8,
    field_index: i64,
}

fn resolve_method_receiver(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    receiver_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MethodReceiverInfo {
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver_node, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, receiver_node, receiver_sf
        );
        let receiver_type = try compiled_mir_types::resolve_value_type_indexed_cached(
            ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
            receiver_name, bs, call_arg_type_cache
        );
        return MethodReceiverInfo {
            name: receiver_name,
            llvm_type: receiver_type.abi,
            full_spelling: receiver_type.full_spelling,
            canonical_identity: receiver_type.canonical_identity,
            type_context: receiver_type.spelling_module,
            source_llvm_type: "",
            field_index: -1
        };
    }
    if !std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return error("compiled mir: method call receiver must be a local, parameter, or field");
    }
    let field_root = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, receiver_node, "receiver", 0, receiver_sf
    );
    let field_root_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, field_root, bs
    );
    let field_root_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_root, field_root_sf
    );
    if !std::mem::equal_bytes(field_root_kind, "Var") {
        return error("compiled mir: method call field receiver must be one level");
    }
    let field_root_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, field_root, field_root_sf
    );
    let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        receiver_node, bs, call_arg_type_cache
    );
    return MethodReceiverInfo {
        name: field_root_name,
        llvm_type: field.field_llvm_type,
        full_spelling: field.field_full_spelling,
        canonical_identity: field.field_canonical_identity,
        type_context: field.field_type_context,
        source_llvm_type: field.receiver_llvm_type,
        field_index: field.field_index
    };
}

fn exact_method_receiver_matches(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    receiver: &MethodReceiverInfo,
    receiver_id: i64
) -> !bool {
    if receiver_id < 0 { return false; }
    let resolved = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, receiver.type_context, receiver.full_spelling
    );
    let receiver_value_id = try compiled_canonical_facts::parsed_method_receiver_value_type_id(
        canonical_facts, receiver_id
    );
    let expected_identity = try compiled_canonical_facts::parsed_canonical_identity(
        canonical_facts, receiver_value_id
    );
    if !std::mem::equal_bytes(resolved.canonical_identity, receiver.canonical_identity) or
        !std::mem::equal_bytes(resolved.canonical_identity, expected_identity) {
        return false;
    }
    return compiled_canonical_facts::parsed_canonical_type_matches_spelling_indexed(
        ir_lookup_index, canonical_facts, ir_bytes, receiver_value_id,
        resolved.spelling_module, resolved.full_spelling
    );
}

fn require_exact_method_receiver(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    receiver: &MethodReceiverInfo,
    receiver_id: i64,
    function_name: []u8,
    call_node: i64
) -> !void {
    if !try exact_method_receiver_matches(
        ir_lookup_index, ir_bytes, canonical_facts, receiver, receiver_id
    ) {
        let receiver_value_id =
            try compiled_canonical_facts::parsed_method_receiver_value_type_id(
                canonical_facts, receiver_id
            );
        let expected_identity = try compiled_canonical_facts::parsed_canonical_identity(
            canonical_facts, receiver_value_id
        );
        var expected_spelling = try compiled_canonical_facts::parsed_canonical_spelling(
            canonical_facts, receiver_value_id
        );
        let expected_spelling_bytes = expected_spelling.as_bytes();
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled mir: runtime receiver canonical type mismatch: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" node ");
        try std::fmt::append_i64(&var message, call_node);
        try message.append_bytes(" receiver ");
        try message.append_bytes(receiver.full_spelling);
        try message.append_bytes(" canonical ");
        try message.append_bytes(receiver.canonical_identity);
        try message.append_bytes(" expected ");
        try message.append_bytes(expected_spelling_bytes);
        try message.append_bytes(" canonical ");
        try message.append_bytes(expected_identity);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    return;
}

fn method_receiver_call_arg(
    info: &MethodCallInfo,
    receiver_name: []u8
) -> compiled_mir::MirCallArg {
    if info.receiver_field_index >= 0 {
        return compiled_mir::field_access_call_arg(
            info.receiver_llvm_type, info.receiver_source_llvm_type,
            receiver_name, info.receiver_field_index
        );
    }
    return compiled_mir::var_call_arg(info.receiver_llvm_type, receiver_name);
}

// method_field_receiver_gate pins the production FieldExpr receiver boundary:
// exact struct facts select the field and the resulting call arg extracts that
// field from the root value. No receiver or element type spelling is special.
pub fn method_field_receiver_gate() -> !void {
    let facts = "canonical-type 0 intrinsic bool 2 -1 0
canonical-type 1 intrinsic std::array::Array 30 -1 1 0
canonical-type 2 intrinsic std::map::Map 33 -1 2 0 0
type-llvm app::Owner %app.owner
abi-repr std::array::Array %kizu.owned
abi-repr std::map::Map %kizu.owned
struct-field app::Owner 0 ignored bool
struct-field app::Owner 1 values std::array::Array<bool>
function-signature-param app::consume 0 self:runtime:app::Owner
body-node app::consume 0 depth 0 kind FieldExpr span 0 11
body-field-expr app::consume 0 values field
body-edge app::consume 0 receiver 0 1
body-node app::consume 1 depth 1 kind Var span 0 4
body-token app::consume 1 self
function-signature-param app::take 0 values:runtime:std::array::Array<bool>
body-node app::take 0 depth 0 kind Var span 0 6
body-token app::take 0 values";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var cache = compiled_mir_types::call_arg_type_cache();
    defer cache.deinit();
    let receiver = try resolve_method_receiver(
        &index, facts, "app::consume", "app::", "%app.owner self;",
        0, 0, &var cache
    );
    var canonical = try compiled_canonical_facts::parse_and_validate(&index, facts);
    defer canonical.deinit();
    std::testing::expect_equal<[]u8>("self", receiver.name);
    std::testing::expect_equal<[]u8>("%kizu.owned", receiver.llvm_type);
    std::testing::expect_equal<[]u8>(
        "std::array::Array<bool>", receiver.full_spelling
    );
    std::testing::expect_equal<[]u8>(
        "std::array::Array", receiver.canonical_identity
    );
    std::testing::expect_equal<[]u8>("%app.owner", receiver.source_llvm_type);
    std::testing::expect(receiver.field_index == 1);
    std::testing::expect(try exact_method_receiver_matches(
        &index, facts, &canonical, &receiver, 1
    ));
    std::testing::expect(!(try exact_method_receiver_matches(
        &index, facts, &canonical, &receiver, 2
    )));
    var var_cache = compiled_mir_types::call_arg_type_cache();
    defer var_cache.deinit();
    let var_receiver = try resolve_method_receiver(
        &index, facts, "app::take", "app::", "%kizu.owned values;",
        0, 0, &var var_cache
    );
    std::testing::expect_equal<[]u8>("values", var_receiver.name);
    std::testing::expect_equal<[]u8>(
        "std::array::Array<bool>", var_receiver.full_spelling
    );
    std::testing::expect(try exact_method_receiver_matches(
        &index, facts, &canonical, &var_receiver, 1
    ));
    std::testing::expect(!(try exact_method_receiver_matches(
        &index, facts, &canonical, &var_receiver, 2
    )));
    let info = MethodCallInfo {
        receiver_name: receiver.name,
        receiver_llvm_type: receiver.llvm_type,
        receiver_source_llvm_type: receiver.source_llvm_type,
        receiver_field_index: receiver.field_index,
        return_llvm_type: "i1",
        storage_return_llvm_type: "%kizu.slice.u8",
        success_llvm_type: "i1",
        result_transport: builtin_contract::RuntimeResultTransport::ByteView,
        module_prefix: "",
        callee_name: "kizu_rt_array_pop_or_panic",
        runtime_operation: builtin_contract::operation_array_pop_or_panic()
    };
    let arg = method_receiver_call_arg(&info, receiver.name);
    std::testing::expect(arg.kind == compiled_mir::MirCallArgKind::FieldAccess);
    std::testing::expect_equal<[]u8>("%kizu.owned", arg.ty);
    std::testing::expect_equal<[]u8>("%app.owner", arg.source_type);
    std::testing::expect_equal<[]u8>("self", arg.value);
    std::testing::expect(arg.source_field_index == 1);
    return;
}

fn method_call_info(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MethodCallInfo {
    // cf tightens this call's own structural reads (callee/receiver edges, field-expr mode/name,
    // receiver kind/token) to the call node's body-node line via the index; the whole-IR
    // type/signature resolutions below route through their _indexed twins. bs is kept for the
    // receiver value resolution, which reads let/param facts that can precede this node.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(mode, "field") {
        return error("compiled mir: method call callee must be field-mode");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver = try resolve_method_receiver(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        receiver_node, bs, call_arg_type_cache
    );
    let receiver_name = receiver.name;
    let receiver_llvm = receiver.llvm_type;
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if builtin.found {
        let call_types = try parsed_call_type_for_node(
            canonical_facts, ir_bytes, function_name, call_node,
            call_arg_type_cache
        );
        try require_exact_method_receiver(
            ir_lookup_index, ir_bytes, canonical_facts, &receiver,
            call_types.receiver_id, function_name, call_node
        );
        let operation_id = builtin_contract::operation_from_name(builtin.operation);
        let runtime = builtin_contract::runtime_method_abi(operation_id);
        if !runtime.found {
            var message = std::string::String(std::mem::page_allocator());
            try message.append_bytes("compiled mir: runtime method ABI not found: ");
            try message.append_bytes(function_name);
            try message.append_bytes(" node ");
            try std::fmt::append_i64(&var message, call_node);
            try message.append_bytes(" operation ");
            try message.append_bytes(builtin.operation);
            let message_bytes = message.as_bytes();
            return error(message_bytes);
        }
        var selected_result_id = call_types.result_id;
        var success_llvm = ir_bytes[0..0];
        var storage_return_llvm = ir_bytes[0..0];
        let return_llvm = try canonical_runtime_semantic_abi(
            ir_lookup_index, canonical_facts, ir_bytes, module_prefix,
            call_types.result_id
        );
        let byte_view = match runtime.result_transport {
            ByteView => true,
            _ => false,
        };
        let error_byte_view = match runtime.result_transport {
            ErrorByteView => true,
            _ => false,
        };
        let semantic = match runtime.result_transport {
            Semantic => true,
            _ => false,
        };
        if byte_view {
            success_llvm = try runtime_selector_semantic_abi(
                ir_lookup_index, canonical_facts, ir_bytes, module_prefix,
                function_name, &call_types,
                selected_result_id, &runtime.return_selector
            );
            if !std::mem::equal_bytes(success_llvm, return_llvm) {
                return error("compiled mir: byte-view result selector mismatch");
            }
            storage_return_llvm = "%kizu.slice.u8";
        }
        if error_byte_view {
            if runtime.return_selector.kind !=
                builtin_contract::RuntimeTypeSelectorKind::ReceiverChild {
                return error("compiled mir: erased result selector must be receiver child");
            }
            selected_result_id = try compiled_canonical_facts::parsed_call_error_success_receiver_child(
                canonical_facts, &call_types,
                runtime.return_selector.receiver_child_slot
            );
            success_llvm = try runtime_selector_semantic_abi(
                ir_lookup_index, canonical_facts, ir_bytes, module_prefix,
                function_name, &call_types,
                selected_result_id, &runtime.return_selector
            );
            storage_return_llvm = "%kizu.error.slice.u8";
        }
        if semantic {
            let selected_abi = try runtime_selector_semantic_abi(
                ir_lookup_index, canonical_facts, ir_bytes, module_prefix,
                function_name, &call_types,
                selected_result_id, &runtime.return_selector
            );
            if !std::mem::equal_bytes(selected_abi, return_llvm) {
                return error("compiled mir: runtime semantic result selector mismatch");
            }
            storage_return_llvm = return_llvm;
        }
        return MethodCallInfo {
            receiver_name: receiver_name,
            receiver_llvm_type: receiver_llvm,
            receiver_source_llvm_type: receiver.source_llvm_type,
            receiver_field_index: receiver.field_index,
            return_llvm_type: return_llvm,
            storage_return_llvm_type: storage_return_llvm,
            success_llvm_type: success_llvm,
            result_transport: runtime.result_transport,
            module_prefix: ir_bytes[0..0],
            callee_name: runtime.symbol,
            runtime_operation: operation_id
        };
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    return MethodCallInfo {
        receiver_name: receiver_name,
        receiver_llvm_type: receiver_llvm,
        receiver_source_llvm_type: receiver.source_llvm_type,
        receiver_field_index: receiver.field_index,
        return_llvm_type: call_info.return_llvm_type,
        storage_return_llvm_type: call_info.return_llvm_type,
        success_llvm_type: ir_bytes[0..0],
        result_transport: builtin_contract::RuntimeResultTransport::Semantic,
        module_prefix: call_info.module_prefix,
        callee_name: call_info.callee_name,
        runtime_operation: builtin_contract::operation_none()
    };
}

struct RuntimeArgAbi {
    semantic_llvm: []u8,
    storage_llvm: []u8,
    codec: compiled_mir::MirStorageCodec,
}

fn parsed_call_type_for_node(
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    call_arg_type_cache: &compiled_mir_types::CallArgTypeCache
) -> !compiled_canonical_facts::ParsedCallTypeFact {
    let span = try compiled_mir_types::fn_call_span(
        call_arg_type_cache, ir_bytes, call_node
    );
    if call_arg_type_cache.instance_id >= 0 {
        return compiled_canonical_facts::parsed_call_type_for_span_instance_id(
            canonical_facts,
            call_arg_type_cache.instance_id,
            span.start,
            span.end
        );
    }
    return compiled_canonical_facts::parsed_call_type_for_span(
        canonical_facts, &function_name, span.start, span.end
    );
}

fn parsed_call_runtime_type_id_cached(
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    cache: &compiled_mir_types::CallArgTypeCache,
    call: &compiled_canonical_facts::ParsedCallTypeFact,
    index: i64
) -> !i64 {
    return compiled_canonical_facts::parsed_call_runtime_type_id(
        canonical_facts, call, index
    );
}

fn parsed_call_actual_type_id_cached(
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    cache: &compiled_mir_types::CallArgTypeCache,
    call: &compiled_canonical_facts::ParsedCallTypeFact,
    index: i64
) -> !i64 {
    return compiled_canonical_facts::parsed_call_actual_type_id(
        canonical_facts, call, index
    );
}

// method_call_arg_types preserves source-method signature lowering while
// routing fixed receiver builtins through their operation descriptor. The
// receiver ABI comes from the call-site value; only ordered explicit argument
// semantics belong to the runtime contract.
fn method_call_arg_types(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    info: &MethodCallInfo,
    call_node: i64,
    explicit_arg_count: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !std::array::Array<RuntimeArgAbi> {
    let call_types = try parsed_call_type_for_node(
        canonical_facts, ir_bytes, function_name, call_node,
        call_arg_type_cache
    );
    if call_types.receiver_id < 0 {
        return error("compiled mir: method call canonical receiver missing");
    }
    let receiver_llvm =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, call_types.receiver_id
        );
    if !std::mem::equal_bytes(receiver_llvm, info.receiver_llvm_type) {
        return error("compiled mir: method call canonical receiver ABI mismatch");
    }
    if info.runtime_operation == builtin_contract::operation_none() {
        return method_source_call_arg_types(
            ir_bytes, ir_lookup_index, canonical_facts, call_arg_type_cache,
            &call_types, receiver_llvm
        );
    }
    var result = std::array::Array<RuntimeArgAbi>(std::mem::page_allocator());
    errdefer result.deinit();
    let expected = try builtin_contract::runtime_method_arg_count(
        info.runtime_operation
    );
    if expected != explicit_arg_count {
        return error("compiled mir: runtime method argument count mismatch");
    }
    try result.append(RuntimeArgAbi {
        semantic_llvm: info.receiver_llvm_type,
        storage_llvm: info.receiver_llvm_type,
        codec: compiled_mir::MirStorageCodec::None
    });
    if call_types.runtime_len != explicit_arg_count {
        return error("compiled mir: canonical runtime argument count mismatch");
    }
    var arg_index = 0;
    while arg_index < explicit_arg_count {
        let selector = try builtin_contract::runtime_method_arg_selector(
            info.runtime_operation, arg_index
        );
        let actual_id = try parsed_call_runtime_type_id_cached(
            canonical_facts, call_arg_type_cache, &call_types, arg_index
        );
        let semantic_llvm = try runtime_selector_semantic_abi(
            ir_lookup_index, canonical_facts, ir_bytes, module_prefix,
            function_name, &call_types, actual_id, &selector
        );
        var storage_llvm = semantic_llvm;
        var codec = compiled_mir::MirStorageCodec::None;
        if selector.storage_class == builtin_contract::RuntimeStorageClass::ScalarI64 {
            storage_llvm = "i64";
            let scalar = try compiled_canonical_facts::parsed_scalar_i64_codec(
                canonical_facts, actual_id
            );
            codec = try scalar_i64_storage_codec(scalar);
        } else {
            if selector.storage_class == builtin_contract::RuntimeStorageClass::ByteView {
                storage_llvm = "%kizu.slice.u8";
                codec = compiled_mir::MirStorageCodec::ByteView;
            } else {
            if selector.storage_class != builtin_contract::RuntimeStorageClass::Semantic {
                return error("compiled mir: runtime storage class unsupported");
            }
            }
        }
        try result.append(RuntimeArgAbi {
            semantic_llvm: semantic_llvm,
            storage_llvm: storage_llvm,
            codec: codec
        });
        arg_index = arg_index + 1;
    }
    return result;
}

fn scalar_i64_storage_codec(
    scalar: compiled_canonical_facts::ScalarI64Codec
) -> !compiled_mir::MirStorageCodec {
    match scalar {
        Identity => return compiled_mir::MirStorageCodec::IdentityI64;,
        Bool => return compiled_mir::MirStorageCodec::BoolI64;,
        UnsignedNarrow => return compiled_mir::MirStorageCodec::UnsignedNarrowI64;,
        SignedNarrow => return compiled_mir::MirStorageCodec::SignedNarrowI64;,
        Unsupported => return error(
            "compiled mir: runtime scalar storage type unsupported"
        );,
    }
}

fn method_source_call_arg_types(
    ir_bytes: []u8,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &compiled_mir_types::CallArgTypeCache,
    call_types: &compiled_canonical_facts::ParsedCallTypeFact,
    receiver_llvm: []u8
) -> !std::array::Array<RuntimeArgAbi> {
    var result = std::array::Array<RuntimeArgAbi>(std::mem::page_allocator());
    errdefer result.deinit();
    try result.append(RuntimeArgAbi {
        semantic_llvm: receiver_llvm,
        storage_llvm: receiver_llvm,
        codec: compiled_mir::MirStorageCodec::None
    });
    var runtime_index = 0;
    while runtime_index < call_types.runtime_len {
        let type_id = try parsed_call_runtime_type_id_cached(
            canonical_facts, call_arg_type_cache, call_types, runtime_index
        );
        let semantic_llvm =
            try compiled_canonical_facts::parsed_canonical_runtime_abi(
                ir_lookup_index, canonical_facts, ir_bytes, type_id
            );
        try result.append(RuntimeArgAbi {
            semantic_llvm: semantic_llvm,
            storage_llvm: semantic_llvm,
            codec: compiled_mir::MirStorageCodec::None
        });
        runtime_index = runtime_index + 1;
    }
    return result;
}

fn method_runtime_arg_nodes(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &compiled_mir_types::CallArgTypeCache
) -> !std::array::Array<i64> {
    let call_types = try parsed_call_type_for_node(
        canonical_facts, ir_bytes, function_name, call_node,
        call_arg_type_cache
    );
    return compiled_mir_lower_call::canonical_runtime_arg_nodes(
        ir_bytes, function_name, call_node, bs, ir_lookup_index, &call_types
    );
}

fn runtime_selector_semantic_abi(
    index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    facts: []u8,
    module_prefix: []u8,
    function_name: []u8,
    call: &compiled_canonical_facts::ParsedCallTypeFact,
    actual_id: i64,
    selector: &builtin_contract::RuntimeTypeSelector
) -> ![]u8 {
    if selector.kind == builtin_contract::RuntimeTypeSelectorKind::None {
        return error("compiled mir: runtime selector missing");
    }
    if selector.kind == builtin_contract::RuntimeTypeSelectorKind::Fixed {
        // A fixed selector names a value type. Borrows are ABI-transparent here -- the canonical
        // runtime ABI derivation recurses through them -- so a borrow of that value type carries
        // the identical LLVM ABI and satisfies the selector. Comparing the borrow's own spelling
        // would reject it on a nominal difference the ABI does not have.
        let value_id = try compiled_canonical_facts::parsed_canonical_value_type_id(
            canonical_facts, actual_id
        );
        if !try compiled_canonical_facts::parsed_canonical_spelling_matches(
            canonical_facts, value_id, selector.fixed_type
        ) {
            var actual = try compiled_canonical_facts::parsed_canonical_spelling(
                canonical_facts, value_id
            );
            defer actual.deinit();
            let actual_bytes = actual.as_bytes();
            var message = std::string::String(std::mem::page_allocator());
            try message.append_bytes(
                "compiled mir: runtime fixed selector type mismatch: "
            );
            try message.append_bytes(function_name);
            try message.append_bytes(" expected ");
            try message.append_bytes(selector.fixed_type);
            try message.append_bytes(" actual ");
            try message.append_bytes(actual_bytes);
            let message_bytes = message.as_bytes();
            return error(message_bytes);
        }
    } else {
        if selector.kind != builtin_contract::RuntimeTypeSelectorKind::ReceiverChild {
            return error("compiled mir: runtime selector kind invalid");
        }
        if call.receiver_id < 0 {
            return error("compiled mir: runtime receiver canonical type missing");
        }
        let receiver_value_id =
            try compiled_canonical_facts::parsed_method_receiver_value_type_id(
                canonical_facts, call.receiver_id
            );
        let expected_id = try compiled_canonical_facts::parsed_canonical_child(
            canonical_facts, receiver_value_id, selector.receiver_child_slot
        );
        if actual_id != expected_id {
            return error("compiled mir: runtime receiver child selector mismatch");
        }
    }
    if selector.kind == builtin_contract::RuntimeTypeSelectorKind::Fixed {
        return compiled_type_lower::kizu_type_to_llvm_indexed(
            index, facts, module_prefix, selector.fixed_type
        );
    }
    return canonical_runtime_semantic_abi(
        index, canonical_facts, facts, module_prefix, actual_id
    );
}

fn canonical_runtime_semantic_abi(
    index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    facts: []u8,
    module_prefix: []u8,
    canonical_id: i64
) -> ![]u8 {
    return compiled_canonical_facts::parsed_canonical_runtime_abi(
        index, canonical_facts, facts, canonical_id
    );
}

fn normalize_runtime_method_args(
    descriptors: &std::array::Array<RuntimeArgAbi>,
    args: std::array::Array<compiled_mir::MirCallArg>
) -> !std::array::Array<compiled_mir::MirCallArg> {
    if descriptors.len() != args.len() {
        return error("compiled mir: runtime ABI descriptor length mismatch");
    }
    var normalized = args;
    var index_value = 0;
    while index_value < normalized.len() {
        let descriptor = try descriptors.at(index_value);
        // The storage rewrite must land in the array's own element slot, so the
        // at_mut borrow is bound mutably: a 'let' binding of the same borrow drops
        // every assignment below and silently ships the semantic type as the
        // runtime transport type.
        var value = try normalized.at_mut(index_value);
        value.semantic_type = descriptor.semantic_llvm;
        value.ty = descriptor.storage_llvm;
        value.storage_codec = descriptor.codec;
        index_value = index_value + 1;
    }
    return normalized;
}

// arena_element_kizu_type strips the std::arena::Arena<...> wrapper off a recorded
// field type token and returns the element type token (tracker 961). It backs the
// Arena<T>.add lowering, which needs the element type to construct and marshal it.
fn arena_element_kizu_type(field_type: []u8) -> ![]u8 {
    let prefix = "std::arena::Arena<";
    let prefix_len = std::mem::len(prefix);
    let field_len = std::mem::len(field_type);
    if field_len <= prefix_len or field_type[field_len - 1] != cast<u8>(62) {
        return error("compiled mir: malformed std::arena::Arena element type");
    }
    return field_type[prefix_len..field_len - 1];
}

// lower_multi_let_arena_add lowers a 'let <name> = self.<field>.add(<struct literal>);'
// where <field> is a std::arena::Arena<T> field of a struct value parameter and the
// argument is a struct literal of element type T (tracker 961). It resolves the Arena
// field + element type, lowers the element struct literal fields, and builds a
// LetArenaAdd statement. Ast.add_node is its first consumer.
fn lower_multi_let_arena_add(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // cf tightens this call's own structural facts (callee/receiver/field edges, kinds, tokens,
    // arg edge/kind) to the call node's body-node line via the index; the subtree sorts
    // at-or-after it, so a scan from cf is byte-identical to one from bs. Param type resolution
    // (find_param_*) and the struct-field lowering recursion keep bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", cf
    );
    if !std::mem::equal_bytes(method_name, "add") {
        return error("compiled mir: only Arena.add method let is supported");
    }
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: Arena.add accessor takes one element argument");
    }
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, cf
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Arena.add receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", cf
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, cf
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, cf
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Arena.add field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, cf
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(locals_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, locals_spec
    );
    let field = try exact_struct_field(
        ir_lookup_index, ir_bytes, module_prefix, struct_kizu_type, field_name
    );
    if !field.found {
        return error("compiled mir: Arena.add receiver field not found");
    }
    if !std::mem::starts_with(field.field_type, "std::arena::Arena<") {
        return error("compiled mir: Arena.add receiver field is not a std::arena::Arena");
    }
    let element_kizu_type = try arena_element_kizu_type(field.field_type);
    let element_llvm_type = try exact_type_abi(
        ir_lookup_index, ir_bytes, field.declaring_module, element_kizu_type
    );
    let element_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    let element_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, element_node, cf
    );
    if !std::mem::equal_bytes(element_kind, "StructLiteralExpr") {
        return error("compiled mir: Arena.add argument must be a struct literal");
    }
    let fields = try compiled_mir_lower_struct::lower_struct_fields(
        ir_bytes, function_name, module_prefix, locals_spec, element_node, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    if fields.len() == 0 {
        return error("compiled mir: Arena.add element struct has no fields");
    }
    let field_count = fields.len();
    let last_field_index = try last_struct_field_index(&fields);
    try stmts.append(compiled_mir::let_arena_add_stmt(
        let_name,
        receiver_llvm_type,
        var_name,
        field.index,
        element_llvm_type,
        last_field_index,
        string_counter,
        fields
    ));
    return MultiLowerResult {
        locals_spec: locals_spec,
        string_counter: string_counter + field_count,
        temp_counter: temp_counter,
        try_counter: try_counter
    };
}

// lower_array_method_return dispatches a 'return self.<field>.<method>(...);' call
// whose callee is a struct-field method to the matching Array accessor lowering:
// len() -> array_len builtin call (Ast.len), get(index) -> the checked element
// accessor (Array<T>.get -> !T). Unsupported methods fail explicitly (tracker 961).
pub fn lower_array_method_return(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if std::mem::equal_bytes(method_name, "len") {
        return try lower_array_len_method_return(
            ir_lookup_index, ir_bytes, function_name, llvm_symbol, params_spec, call_node, bs
        );
    }
    if std::mem::equal_bytes(method_name, "get") {
        // get(index) lowers to the checked Array<T>.get accessor (-> !T) or, when the
        // receiver field is an Arena<T>, the checked Arena<T>.get accessor (-> T, which
        // traps on an out-of-bounds index). Ast.get is the first Arena.get consumer.
        let module_prefix = compiled_util::module_prefix_of(function_name);
        let field_type = try method_receiver_field_type(
            ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec, call_node, bs
        );
        if std::mem::starts_with(field_type, "std::arena::Arena<") {
            return try lower_arena_get_method_return(
                ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, call_node, bs
            );
        }
        return try lower_array_get_method_return(
            ir_lookup_index, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, call_node, bs
        );
    }
    return error("compiled mir: unsupported array accessor method");
}

// method_receiver_field_type resolves the struct-field type token of a
// self.<field>.<method>(...) method receiver (tracker 961). It lets the get dispatch
// route an Array<T> receiver to the array accessor and an Arena<T> receiver to the
// arena accessor without duplicating the full lowering.
fn method_receiver_field_type(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> ![]u8 {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, params_spec
    );
    let field = try exact_struct_field(
        ir_lookup_index, ir_bytes, module_prefix, struct_kizu_type, field_name
    );
    if !field.found {
        return error("compiled mir: method receiver field not found");
    }
    return field.field_type;
}

// lower_arena_get_method_return lowers a single 'return self.<field>.get(<param>.<field>);'
// where <field> is a std::arena::Arena<T> field of a struct value parameter and the
// index is a field access on a value parameter (NodeId.raw). It is the first Arena<T>.get
// accessor compiled into stage2 (std::kizu::ast::Ast.get -> AstNode): it reads the Arena
// field off the struct value parameter, calls the checked @kizu_rt_arena_get runtime
// helper, and on success loads the AstNode element by value and returns it; an
// out-of-bounds index traps (Arena.get panics rather than returning an error union).
pub fn lower_arena_get_method_return(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: Arena.get accessor takes one index argument");
    }
    // The method receiver is the arena field expression self.<field>.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(params_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, params_spec
    );
    let field = try exact_struct_field(
        ir_lookup_index, ir_bytes, module_prefix, struct_kizu_type, field_name
    );
    if !field.found {
        return error("compiled mir: Arena.get receiver field not found");
    }
    if !std::mem::starts_with(field.field_type, "std::arena::Arena<") {
        return error("compiled mir: Arena.get receiver field is not a std::arena::Arena");
    }
    // The single argument is a field access on a value parameter (id.raw).
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    let index_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, index_node, bs
    );
    if !std::mem::equal_bytes(index_kind, "FieldExpr") {
        return error("compiled mir: Arena.get index must be a parameter field access");
    }
    let index_field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, index_node, "field", bs
    );
    let index_var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, index_node, "receiver", 0, bs
    );
    let index_var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, index_var_node, bs
    );
    if !std::mem::equal_bytes(index_var_kind, "Var") {
        return error("compiled mir: Arena.get index receiver must be a parameter");
    }
    let index_param_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_var_node, bs
    );
    let index_param_type = try compiled_signature::find_param_type(params_spec, index_param_name);
    let index_struct_kizu = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, index_param_name, params_spec
    );
    let index_field = try exact_struct_field(
        ir_lookup_index, ir_bytes, module_prefix, index_struct_kizu, index_field_name
    );
    if !index_field.found {
        return error("compiled mir: Arena.get index field not found");
    }
    return compiled_mir_function::single_arena_get_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        receiver_llvm_type,
        var_name,
        field.index,
        index_param_type,
        index_param_name,
        index_field.index
    );
}

// is_count_range_function reports whether a function is count_range's accumulator shape:
// 'var count = 0; var index = 0; while ... { ... } return count;' (4 statements, two leading
// Let inits, a While, then a Return, tracker 961).
pub fn is_count_range_function(
    ir_bytes: []u8,
    function_name: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 4 {
        return false;
    }
    let s0 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 0, bs);
    let k0 = try ir_contract::body_node_kind_from(ir_bytes, function_name, s0, bs);
    if !std::mem::equal_bytes(k0, "Let") {
        return false;
    }
    let s1 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 1, bs);
    let k1 = try ir_contract::body_node_kind_from(ir_bytes, function_name, s1, bs);
    if !std::mem::equal_bytes(k1, "Let") {
        return false;
    }
    let s2 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 2, bs);
    let k2 = try ir_contract::body_node_kind_from(ir_bytes, function_name, s2, bs);
    if !std::mem::equal_bytes(k2, "While") {
        return false;
    }
    let s3 = try ir_contract::body_child_sequence_from(ir_bytes, function_name, 0, "statement", 3, bs);
    let k3 = try ir_contract::body_node_kind_from(ir_bytes, function_name, s3, bs);
    if !std::mem::equal_bytes(k3, "Return") {
        return false;
    }
    // The count_range accumulator seeds both counters from integer literals ('var count = 0;
    // var index = 0;') and returns the accumulator local ('return count;'). A multi-counter
    // import-sort loop like import_path_less has base-plus-offset inits ('var left_index =
    // left + 1;') and a bool return ('return false;'), so it must fall through to the generic
    // multi-statement path instead of being mis-detected as the child_at / node_count
    // traversal template (issue 1165 / 1162).
    let s0_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s0, "value", 0, bs);
    let s0_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, s0_value, bs);
    if !std::mem::equal_bytes(s0_value_kind, "Int") {
        return false;
    }
    let s1_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s1, "value", 0, bs);
    let s1_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, s1_value, bs);
    if !std::mem::equal_bytes(s1_value_kind, "Int") {
        return false;
    }
    let s3_value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, s3, "value", 0, bs);
    let s3_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, s3_value, bs);
    if !std::mem::equal_bytes(s3_value_kind, "Var") {
        return false;
    }
    let count_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, s0, "name", 0, bs
    );
    let count_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, count_name_node, bs
    );
    let return_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, s3_value, bs
    );
    if !std::mem::equal_bytes(count_name, return_name) {
        return false;
    }
    let index_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, s1, "name", 0, bs
    );
    let index_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_name_node, bs
    );
    let while_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, s2, "body", 0, bs
    );
    if (try while_body_statement_count(
        ir_bytes, function_name, while_body, bs
    )) != 3 {
        return false;
    }
    let child_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_body, "statement", 0, bs
    );
    let count_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_body, "statement", 1, bs
    );
    let index_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_body, "statement", 2, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, child_stmt, bs
        ),
        "Let"
    ) or !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, count_stmt, bs
        ),
        "Assign"
    ) or !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, index_stmt, bs
        ),
        "Assign"
    ) {
        return false;
    }
    let child_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, child_stmt, "value", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, child_value, bs
        ),
        "TryExpr"
    ) {
        return false;
    }
    let count_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, count_stmt, "target", 0, bs
    );
    let count_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, count_target, bs
    );
    if !std::mem::equal_bytes(count_target_name, count_name) {
        return false;
    }
    let count_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, count_stmt, "value", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, count_value, bs
        ),
        "Binary"
    ) {
        return false;
    }
    let recursive_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, count_value, "right", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, recursive_value, bs
        ),
        "TryExpr"
    ) {
        return false;
    }
    let index_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, index_stmt, "target", 0, bs
    );
    let index_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_target, bs
    );
    if !std::mem::equal_bytes(index_target_name, index_name) {
        return false;
    }
    // The CountRange statement emits one fixed call shape: the child accessor reads (range, index)
    // off the receiver and the accumulator recurses on the child alone, with both taken from
    // params 0 and 1. A four-statement accumulator loop that only shares the outer shape -- an
    // environment-threading walker whose recursive callee also carries an allocator, a source file
    // and fact tables, say -- is a different function, and lowering it through this template would
    // drop those arguments. Checking the call shape the template can actually emit keeps such a
    // loop on the generic multi-statement path.
    let matches_template = try count_range_calls_match_template(
        ir_bytes, function_name, params_spec, child_value, recursive_value, bs
    );
    if !matches_template {
        return false;
    }
    return try while_assign_is_constant_step(
        ir_bytes, function_name, index_stmt, bs
    );
}

// count_range_calls_match_template checks the two calls inside the accumulator loop against the
// shape the CountRange statement renders: '<param0>.<child_at>(<param1>, <index>)' bound by the
// child let, and '<recursive>(<child>)' on the right of the accumulator add.
fn count_range_calls_match_template(
    ir_bytes: []u8,
    function_name: []u8,
    params_spec: []u8,
    child_try: i64,
    recursive_try: i64,
    bs: i64
) -> !bool {
    let child_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, child_try, "value", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(ir_bytes, function_name, child_call, bs),
        "Call"
    ) {
        return false;
    }
    if (try compiled_mir_types::count_call_args(
        ir_bytes, function_name, child_call, bs
    )) != 2 {
        return false;
    }
    let recursive_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, recursive_try, "value", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(ir_bytes, function_name, recursive_call, bs),
        "Call"
    ) {
        return false;
    }
    if (try compiled_mir_types::count_call_args(
        ir_bytes, function_name, recursive_call, bs
    )) != 1 {
        return false;
    }
    let child_callee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, child_call, "callee", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(ir_bytes, function_name, child_callee, bs),
        "FieldExpr"
    ) {
        return false;
    }
    let child_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, child_callee, "receiver", 0, bs
    );
    let child_receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, child_receiver, bs
    );
    let child_range = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, child_call, "arg", 0, bs
    );
    let child_range_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, child_range, bs
    );
    if count_params_spec(params_spec) < 2 {
        return false;
    }
    if !std::mem::equal_bytes(
        child_receiver_name, try nth_param_field(params_spec, 0, true)
    ) {
        return false;
    }
    return std::mem::equal_bytes(
        child_range_name, try nth_param_field(params_spec, 1, true)
    );
}

// count_params_spec counts the entries of a 'type name;type name;...' params_spec, so a caller can
// check an index is in range before asking nth_param_field for it.
fn count_params_spec(params_spec: []u8) -> i64 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    var count = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            count = count + 1;
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return count;
}

// nth_param_field returns the name (want_name true) or LLVM type (false) of the index-th
// param in a 'type name;type name;...' params_spec.
fn nth_param_field(params_spec: []u8, index: i64, want_name: bool) -> ![]u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    var current = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            if current == index {
                if want_name {
                    return params_spec[space_pos + 1..entry_end];
                }
                return params_spec[pos..space_pos];
            }
            current = current + 1;
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return error("compiled mir: count_range param index out of range");
}

// lower_count_range_function lowers count_range into a single CountRange statement: a two-phi
// accumulator loop over the range that calls Ast.child_at and the recursive node_count with
// try-propagation (tracker 961). The receiver (tree) and range are the first two params; the
// recursive callee is this module's node_count.
pub fn lower_count_range_function(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    instance_context: &compiled_instance_context::InstanceContext,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    try compiled_mir_types::set_instance_context(
        call_arg_type_cache, instance_context
    );
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    let receiver_type = try nth_param_field(params_spec, 0, false);
    let receiver_name = try nth_param_field(params_spec, 0, true);
    let range_type = try nth_param_field(params_spec, 1, false);
    let range_name = try nth_param_field(params_spec, 1, true);
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let range_kizu = try compiled_mir_types::resolve_value_kizu_type(
        ir_bytes, function_name, module_prefix, params_spec, range_name, bs
    );
    let range_resolved = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, range_kizu
    );
    let range_len = try compiled_fact_lookup::lookup_struct_field_exact_indexed(
        ir_lookup_index, ir_bytes, range_resolved.canonical_identity, "len"
    );
    if !range_len.found {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled mir: count range len field not found: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" range ");
        try message.append_bytes(range_resolved.canonical_identity);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let range_len_type = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, range_len.declaring_module, range_len.field_type
    );
    if fixed_abi_contract::from_llvm(range_len_type.abi).kind !=
        fixed_abi_contract::FixedAbiKind::Integer64 {
        return error("compiled mir: count range len must lower to i64");
    }

    let while_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    let while_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_stmt, "body", 0, bs
    );
    let child_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_body, "statement", 0, bs
    );
    let child_try = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, child_stmt, "value", 0, bs
    );
    let child_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, child_try, "value", 0, bs
    );
    let child_info =
        try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, child_call, bs, &call_arg_type_cache
        );
    let child_success = try compiled_mir_types::call_info_error_success_llvm(
        ir_lookup_index, canonical_facts, ir_bytes, &child_info
    );
    if child_info.types.runtime_len != 3 {
        return error("compiled mir: count range child runtime arity mismatch");
    }
    let child_receiver_id =
        try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &child_info.types, 0
        );
    let child_range_id =
        try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &child_info.types, 1
        );
    let child_index_id =
        try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &child_info.types, 2
        );
    let child_receiver_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, child_receiver_id
        );
    let child_range_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, child_range_id
        );
    let child_index_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, child_index_id
        );
    if !std::mem::equal_bytes(child_receiver_type, receiver_type) {
        return error("compiled mir: count range child receiver ABI mismatch");
    }
    if !std::mem::equal_bytes(child_range_type, range_type) {
        return error("compiled mir: count range child range ABI mismatch");
    }
    if fixed_abi_contract::from_llvm(child_index_type).kind !=
        fixed_abi_contract::FixedAbiKind::Integer64 {
        return error("compiled mir: count range child index must lower to i64");
    }

    let count_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_body, "statement", 1, bs
    );
    let count_binary = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, count_stmt, "value", 0, bs
    );
    let count_try = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, count_binary, "right", 0, bs
    );
    let count_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, count_try, "value", 0, bs
    );
    let count_info =
        try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, count_call, bs, &call_arg_type_cache
        );
    let _count_success = try compiled_mir_types::call_info_error_success_llvm(
        ir_lookup_index, canonical_facts, ir_bytes, &count_info
    );
    if count_info.types.runtime_len != 2 {
        return error("compiled mir: count range recursive runtime arity mismatch");
    }
    let count_receiver_id =
        try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &count_info.types, 0
        );
    let count_child_id =
        try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &count_info.types, 1
        );
    let count_receiver_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, count_receiver_id
        );
    let count_child_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, count_child_id
        );
    if !std::mem::equal_bytes(count_receiver_type, receiver_type) {
        return error("compiled mir: count range recursive receiver ABI mismatch");
    }
    if !std::mem::equal_bytes(count_child_type, child_success) {
        return error("compiled mir: count range recursive child ABI mismatch");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::count_range_stmt(
        receiver_name, receiver_type, range_name, range_type, range_len.index,
        child_info.module_prefix, child_info.callee_name, child_index_type,
        child_success,
        count_info.module_prefix, count_info.callee_name,
        child_info.return_llvm_type, llvm_return_type
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_trim_ascii_function lowers std::mem::trim_ascii into a single TrimAscii statement: two
// break-on-condition search loops that advance %start past leading ASCII spaces and retreat
// %end past trailing ones, returning the trimmed two-bound slice (tracker 961). The byte
// classifier callee is std::mem::is_ascii_space; std symbols are not derivable through the
// selfhost-prefixed callee mangler, so the fully-mangled symbol is passed with an empty module.
pub fn lower_trim_ascii_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let bytes_name = try nth_param_field(params_spec, 0, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::trim_ascii_stmt(
        bytes_name, "", "kizu_std__mem_is_ascii_space"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_ast_node_text_function lowers selfhost::ir::codegen::ast_node_text into a single
// AstNodeText statement: it binds the AstNode by value off Ast.get, extracts the Span (AstNode
// field 0) and its start/end, slices the text two-bound, and forwards the slice to trim_ascii
// (tracker 961). The trim callee is std::mem::trim_ascii, passed as a fully-mangled std symbol
// with an empty module prefix.
// lower_advance_position_function lowers std::kizu::lexer::advance_position into a single
// AdvancePosition statement: a two-phi loop threading the i64 index and the Position struct
// current, feeding source[index] + current into the already-compiled advance_byte each iteration
// (tracker 961, scope 4 prerequisite). Its struct loop-carried variable and struct-returning
// call-in-loop the generic while machinery does not model, so it is dispatched by name.
pub fn lower_advance_position_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let source_type = try nth_param_field(params_spec, 0, false);
    let start_name = try nth_param_field(params_spec, 1, true);
    let end_name = try nth_param_field(params_spec, 2, true);
    let initial_name = try nth_param_field(params_spec, 3, true);
    let position_type = try nth_param_field(params_spec, 3, false);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::advance_position_stmt(
        source_name, source_type, start_name, end_name, initial_name,
        position_type, "kizu_kizu__lexer_advance_byte"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_number_token_function lowers std::kizu::lexer::number_token into a single NumberToken
// statement: an i64 end phi that scans forward while source[end] is a digit, then builds the
// Number Token (tracker 961, scope 4 prerequisite). Its compound 'end < len and is_digit(...)'
// loop condition with a per-byte index load the generic while machinery does not model, so it is
// dispatched by name. The TokenKind::Number tag is resolved from the enum-variant facts.
pub fn lower_number_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let source_type = try nth_param_field(params_spec, 0, false);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let number_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Number"
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::number_token_stmt(
        source_name, source_type, start_name, current_name, position_type,
        llvm_return_type, "kizu_kizu__lexer_is_digit", "kizu_kizu__lexer_token", number_tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_string_token_function lowers std::kizu::lexer::string_token into a single StringToken
// statement: quoted strings scan to the closing quote, while double-slash multiline strings scan
// through indented continuations. The generic while machinery does not model these byte-scanning
// loops, so it is dispatched by name. The TokenKind::String tag is resolved from the enum-variant
// facts.
pub fn lower_string_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let string_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "String"
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::string_token_stmt(
        source_name, start_name, current_name, position_type,
        llvm_return_type, "kizu_kizu__lexer_token", string_tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// append_single_op resolves a single-char operator's TokenKind tag and appends a no-look-ahead
// entry to raw_token_at's dispatch table (tracker 961, scope 4 prerequisite).
fn append_single_op(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    ops: &var std::array::Array<compiled_mir::MirOperator>,
    byte: i64,
    variant: []u8
) -> !void {
    let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", variant
    );
    try ops.append(compiled_mir::operator(byte, tag, 0 - 1, 0 - 1, 0 - 1, 0 - 1));
    return;
}

// append_two_op resolves a two-char-or-single operator's tags and appends a single look-ahead
// entry (tracker 961, scope 4 prerequisite).
fn append_two_op(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    ops: &var std::array::Array<compiled_mir::MirOperator>,
    byte: i64,
    single_variant: []u8,
    second_byte: i64,
    two_variant: []u8
) -> !void {
    let single_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", single_variant
    );
    let two_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", two_variant
    );
    try ops.append(compiled_mir::operator(byte, single_tag, second_byte, two_tag, 0 - 1, 0 - 1));
    return;
}

// lower_raw_token_function lowers std::kizu::lexer::raw_token_at into a single RawToken statement:
// an Eof guard, an operator dispatch table over the byte at start, then quote / multiline-string /
// digit / word fallbacks to string_token / number_token / word_token (tracker 961, scope 4
// prerequisite). Its many-arm byte dispatch with two- and three-char look-aheads the generic path
// does not model, so it is dispatched by name. All TokenKind tags come from the enum-variant facts.
pub fn lower_raw_token_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let eof_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Eof"
    );
    var ops = std::array::Array<compiled_mir::MirOperator>(std::mem::page_allocator());
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 123, "LBrace");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 125, "RBrace");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 40, "LParen");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 41, "RParen");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 59, "Semicolon");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 44, "Comma");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 33, "Bang", 61, "NotEq");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 38, "Amp");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 60, "LT", 61, "LTE");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 62, "GT", 61, "GTE");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 63, "Question");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 91, "LBracket");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 93, "RBracket");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 58, "Colon", 58, "DoubleColon");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 45, "Minus", 62, "Arrow");
    // '=' is the only three-way operator: '==' -> Eq, '=>' -> FatArrow, else Assign.
    let assign_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Assign"
    );
    let eq_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Eq"
    );
    let fat_arrow_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "FatArrow"
    );
    try ops.append(compiled_mir::operator(61, assign_tag, 61, eq_tag, 62, fat_arrow_tag));
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 43, "Plus");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 42, "Asterisk");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 47, "Slash");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 37, "Percent");
    try append_two_op(ir_lookup_index, ir_bytes, &var ops, 46, "Dot", 46, "Range");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 124, "Pipe");
    try append_single_op(ir_lookup_index, ir_bytes, &var ops, 64, "At");
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::raw_token_stmt(
        source_name, start_name, current_name, position_type, llvm_return_type,
        "kizu_kizu__lexer_token", "kizu_kizu__lexer_is_digit", "kizu_kizu__lexer_string_token",
        "kizu_kizu__lexer_number_token", "kizu_kizu__lexer_word_token", eof_tag, ops
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// token_kind_predicate_match_node unwraps the two parser predicate spellings: compact
// 'return match token.kind { ... };' and exhaustive statement 'match token.kind { X => return ...; }'
// (tracker 961, scope 4 prerequisite).
fn token_kind_predicate_match_node(
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !i64 {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let statement_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, statement, bs
    );
    if std::mem::equal_bytes(statement_kind, "Return") {
        let value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, statement, "value", 0, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value, bs
        );
        if !std::mem::equal_bytes(value_kind, "Match") {
            return error("compiled mir: token-kind predicate return value must be a match");
        }
        return value;
    }
    if std::mem::equal_bytes(statement_kind, "Match") {
        return statement;
    }
    if std::mem::equal_bytes(statement_kind, "ExprStmt") {
        let expr = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, statement, "expr", 0, bs
        );
        let expr_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, expr, bs
        );
        if std::mem::equal_bytes(expr_kind, "Match") {
            return expr;
        }
    }
    return error("compiled mir: token-kind predicate body must be a match");
}

fn token_kind_predicate_arm_value(
    ir_bytes: []u8,
    function_name: []u8,
    arm_body: i64,
    bs: i64
) -> !i64 {
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arm_body, bs);
    if std::mem::equal_bytes(body_kind, "Return") {
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_body, "value", 0, bs
        );
    }
    if std::mem::equal_bytes(body_kind, "ExprStmt") {
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_body, "expr", 0, bs
        );
    }
    return arm_body;
}

fn token_kind_predicate_arm_bool(
    ir_bytes: []u8,
    function_name: []u8,
    arm_body: i64,
    bs: i64
) -> !bool {
    let value = try token_kind_predicate_arm_value(ir_bytes, function_name, arm_body, bs);
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Bool") {
        return error("compiled mir: token-kind predicate arms must return bool");
    }
    let token = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, value, bs);
    return std::mem::equal_bytes(token, "true");
}

// function_is_bool_token_kind_predicate reports whether a single-statement function is a
// genuine bool TokenKind predicate: a 'match <scrutinee>.kind { ... }' (compact return-match
// or exhaustive statement match) whose scrutinee is a field access and whose every arm body
// returns a bool literal. It is non-erroring, so a non-bool dispatch match (whose arms return
// a ParseNode / an error union / any non-bool value) is reported false and falls through to
// the general lowering instead of being mis-specialized as a bool predicate (issue 1157
// PR-PD / B2). The narrow only removes false-positive specialization; every real bool
// predicate (bool and !bool return) still matches and keeps the fast path.
pub fn function_is_bool_token_kind_predicate(
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let statement_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, statement, bs
    );
    var match_node = 0 - 1;
    if std::mem::equal_bytes(statement_kind, "Match") {
        match_node = statement;
    } else {
        if std::mem::equal_bytes(statement_kind, "ExprStmt") {
            let expr = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "expr", 0, bs
            );
            let expr_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr, bs);
            if std::mem::equal_bytes(expr_kind, "Match") {
                match_node = expr;
            }
        } else {
            if std::mem::equal_bytes(statement_kind, "Return") {
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
                let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
                if std::mem::equal_bytes(value_kind, "Match") {
                    match_node = value;
                }
            }
        }
    }
    if match_node < 0 {
        return false;
    }
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, scrutinee, bs);
    if !std::mem::equal_bytes(scrutinee_kind, "FieldExpr") {
        return false;
    }
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_node, "arm", bs
    );
    if arm_count == 0 {
        return false;
    }
    var arm_index = 0;
    while arm_index < arm_count {
        let arm = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_node, "arm", arm_index, bs
        );
        let arm_body = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm, "body", 0, bs
        );
        let value = try token_kind_predicate_arm_value(ir_bytes, function_name, arm_body, bs);
        let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
        if !std::mem::equal_bytes(value_kind, "Bool") {
            return false;
        }
        arm_index = arm_index + 1;
    }
    return true;
}

// lower_token_kind_predicate_function lowers parser TokenKind predicates into a single
// TokenKindPredicate statement (tracker 961, scope 4 prerequisite). It reads the Token.kind
// scrutinee and records every arm whose body returns true; the renderer emits an i1 compare/OR
// chain. The field index comes from the Token facts and variant tags from TokenKind facts.
pub fn lower_token_kind_predicate_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let match_node = try token_kind_predicate_match_node(ir_bytes, function_name, bs);
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_node, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, scrutinee, bs);
    if !std::mem::equal_bytes(scrutinee_kind, "FieldExpr") {
        return error("compiled mir: token-kind predicate scrutinee must be a field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, scrutinee, "field", bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scrutinee, "receiver", 0, bs
    );
    let token_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs);
    let kind_abi = try resolve_token_kind_field_abi(
        ir_lookup_index, ir_bytes, function_name, params_spec,
        token_name, field_name, bs
    );
    var variant_tags = std::array::Array<i64>(std::mem::page_allocator());
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_node, "arm", bs
    );
    var arm_index = 0;
    while arm_index < arm_count {
        let arm = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_node, "arm", arm_index, bs
        );
        let arm_body = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm, "body", 0, bs
        );
        if try token_kind_predicate_arm_bool(ir_bytes, function_name, arm_body, bs) {
            let pattern = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arm, "pattern", 0, bs
            );
            let variant_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, pattern, bs
            );
            if std::mem::equal_bytes(variant_name, "_") {
                return error("compiled mir: token-kind predicate wildcard true arm unsupported");
            }
            let variant_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
                ir_lookup_index, ir_bytes, kind_abi.enum_module,
                kind_abi.enum_name, variant_name
            );
            try variant_tags.append(variant_tag);
        }
        arm_index = arm_index + 1;
    }
    if variant_tags.len() == 0 {
        return error("compiled mir: token-kind predicate must have a true arm");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::token_kind_predicate_stmt(
        token_name, kind_abi.token_type, kind_abi.field_index, variant_tags
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

fn parser_required_child(
    ir_bytes: []u8,
    function_name: []u8,
    parent: i64,
    edge: []u8,
    edge_index: i64,
    expected_kind: []u8,
    bs: i64
) -> !i64 {
    let child = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, parent, edge, edge_index, bs
    );
    let kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, child, bs
    );
    if !std::mem::equal_bytes(kind, expected_kind) {
        return error("compiled mir: parser helper call shape mismatch");
    }
    return child;
}

fn parser_call_from_condition(
    ir_bytes: []u8,
    function_name: []u8,
    condition: i64,
    bs: i64
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, condition, bs
    );
    if std::mem::equal_bytes(kind, "Call") {
        return condition;
    }
    if std::mem::equal_bytes(kind, "Prefix") {
        return try parser_required_child(
            ir_bytes, function_name, condition, "right", 0, "Call", bs
        );
    }
    return error("compiled mir: parser helper condition must contain a call");
}

fn exact_bool_source_call(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64
) -> !compiled_type_resolver::ResolvedFunction {
    let target = try compiled_type_resolver::call_target_indexed(
        index, ir_bytes, function_name, call_node
    );
    if !target.found {
        return error("compiled mir: parser helper source call target not found");
    }
    let function = try compiled_type_resolver::resolve_call_indexed(
        index, ir_bytes, function_name, call_node
    );
    if function.returns_error or
        fixed_abi_contract::from_llvm(function.return_type.abi).kind !=
            fixed_abi_contract::FixedAbiKind::Bool {
        return error("compiled mir: parser helper must return bool");
    }
    return function;
}

// lower_parser_span_predicate_function lowers the parser's source-span classifiers that drive
// namespace/type disambiguation. Their loop-carried booleans and segment cursors are deliberately
// outside the generic restricted while lowering. Helper identities come from each real Call node's
// exact package call target and signature; the MIR never carries a separately-authored symbol fact.
pub fn lower_parser_span_predicate_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    var mode = 0;
    if std::mem::equal_bytes(function_name, "std::kizu::parser::is_struct_literal_type_span") {
        mode = 1;
    }
    let source_name = try nth_param_field(params_spec, 0, true);
    let span_type = try nth_param_field(params_spec, 1, false);
    let span_name = try nth_param_field(params_spec, 1, true);
    var while_statement_index = 3;
    if mode == 1 { while_statement_index = 5; }
    let while_node = try parser_required_child(
        ir_bytes, function_name, 0, "statement", while_statement_index, "While", bs
    );
    let while_body = try parser_required_child(
        ir_bytes, function_name, while_node, "body", 0, "Block", bs
    );
    let name_if = try parser_required_child(
        ir_bytes, function_name, while_body, "statement", 1, "If", bs
    );
    let name_condition = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, name_if, "condition", 0, bs
    );
    let name_call = try parser_call_from_condition(
        ir_bytes, function_name, name_condition, bs
    );
    let name_function = try exact_bool_source_call(
        ir_lookup_index, ir_bytes, function_name, name_call
    );
    let name_else = try parser_required_child(
        ir_bytes, function_name, name_if, "else", 0, "Block", bs
    );
    let double_colon_if = try parser_required_child(
        ir_bytes, function_name, name_else, "statement", 0, "If", bs
    );
    let double_colon_condition = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, double_colon_if, "condition", 0, bs
    );
    let double_colon_call = try parser_call_from_condition(
        ir_bytes, function_name, double_colon_condition, bs
    );
    let double_colon_function = try exact_bool_source_call(
        ir_lookup_index, ir_bytes, function_name, double_colon_call
    );
    var upper_callee_qualified = ir_bytes[0..0];
    if mode == 1 {
        let upper_if = try parser_required_child(
            ir_bytes, function_name, 0, "statement", 7, "If", bs
        );
        let upper_condition = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, upper_if, "condition", 0, bs
        );
        let upper_call = try parser_call_from_condition(
            ir_bytes, function_name, upper_condition, bs
        );
        let upper_function = try exact_bool_source_call(
            ir_lookup_index, ir_bytes, function_name, upper_call
        );
        upper_callee_qualified = upper_function.canonical_identity;
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::parser_span_predicate_stmt(
        mode,
        source_name,
        span_name,
        span_type,
        name_function.canonical_identity,
        double_colon_function.canonical_identity,
        upper_callee_qualified
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_parser_postfix_start_function lowers the parser's AST-aware postfix guards. The body
// shapes are intentionally narrow: guard on left.next, bind ast.get(left.node), then classify the
// bound node span through one of the compiled span predicates (tracker 961).
pub fn lower_parser_postfix_start_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    var mode = 0;
    if std::mem::equal_bytes(function_name, "std::kizu::parser::is_struct_literal_start") {
        mode = 1;
    } else {
        if !std::mem::equal_bytes(function_name, "std::kizu::parser::is_type_apply_start") {
            return error("compiled mir: unknown parser postfix start predicate");
        }
    }
    let ast_name = try nth_param_field(params_spec, 0, true);
    let text_name = try nth_param_field(params_spec, 1, true);
    let left_type = try nth_param_field(params_spec, 2, false);
    let left_name = try nth_param_field(params_spec, 2, true);
    let fetch_call = try let_call_at_statement(ir_bytes, function_name, 1, bs);
    let span_fetch = try resolve_node_span_fetch_abi(
        ir_lookup_index, ir_bytes, function_name, fetch_call
    );
    let node_field = try exact_struct_field(
        ir_lookup_index, ir_bytes, "std::kizu::parser::", "ParseNode", "node"
    );
    let next_field = try exact_struct_field(
        ir_lookup_index, ir_bytes, "std::kizu::parser::", "ParseNode", "next"
    );
    if !node_field.found or !next_field.found {
        return error("compiled mir: parser postfix struct field not found");
    }
    let node_field_index = node_field.index;
    let next_field_index = next_field.index;
    let token_type = try exact_type_abi(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "Token"
    );
    let guard_if = try parser_required_child(
        ir_bytes, function_name, 0, "statement", 0, "If", bs
    );
    let guard_condition = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, guard_if, "condition", 0, bs
    );
    let guard_call = try parser_call_from_condition(
        ir_bytes, function_name, guard_condition, bs
    );
    let guard_function = try exact_bool_source_call(
        ir_lookup_index, ir_bytes, function_name, guard_call
    );
    var span_statement_index = 4;
    if mode == 1 { span_statement_index = 2; }
    let span_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", span_statement_index, bs
    );
    var span_call = -1;
    if mode == 0 {
        let span_if_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, span_statement, bs
        );
        if !std::mem::equal_bytes(span_if_kind, "If") {
            return error("compiled mir: type-apply span statement must be an if");
        }
        let span_condition = try parser_required_child(
            ir_bytes, function_name, span_statement, "condition", 0, "Binary", bs
        );
        span_call = try parser_required_child(
            ir_bytes, function_name, span_condition, "right", 0, "Call", bs
        );
    } else {
        let span_return_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, span_statement, bs
        );
        if !std::mem::equal_bytes(span_return_kind, "Return") {
            return error("compiled mir: struct-literal span statement must be a return");
        }
        span_call = try parser_required_child(
            ir_bytes, function_name, span_statement, "value", 0, "Call", bs
        );
    }
    let span_function = try exact_bool_source_call(
        ir_lookup_index, ir_bytes, function_name, span_call
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::parser_postfix_start_stmt(
        mode,
        ast_name,
        span_fetch.fetch.receiver_type,
        text_name,
        left_name,
        left_type,
        token_type,
        span_fetch.fetch.node_type,
        span_fetch.fetch.field_type,
        span_fetch.fetch.get_module,
        span_fetch.fetch.get_name,
        span_fetch.fetch.index_type,
        node_field_index,
        next_field_index,
        span_fetch.fetch.field_index,
        guard_function.canonical_identity,
        span_function.canonical_identity
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_first_token_function lowers std::kizu::lexer::first_token into a single FirstToken
// statement: 'return token_at(source, 0, position(1, 1));' (tracker 961, scope 4 prerequisite).
// Its nested call argument the generic path does not model, so it is dispatched by name.
pub fn lower_first_token_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let source_type = try nth_param_field(params_spec, 0, false);
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let statement_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, statement, bs
    );
    if !std::mem::equal_bytes(statement_kind, "Return") {
        return error("compiled mir: first token wrapper must return a call");
    }
    let token_at_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let token_at_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, token_at_call, bs
    );
    if !std::mem::equal_bytes(token_at_kind, "Call") {
        return error("compiled mir: first token return value must be a call");
    }
    let position_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, token_at_call, "arg", 2, bs
    );
    let position_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, position_call, bs
    );
    if !std::mem::equal_bytes(position_kind, "Call") {
        return error("compiled mir: first token position argument must be a call");
    }
    let position_function = try exact_non_error_call(
        ir_lookup_index, ir_bytes, function_name, position_call
    );
    let token_at_function = try exact_non_error_call(
        ir_lookup_index, ir_bytes, function_name, token_at_call
    );
    var position_args = try compiled_mir_types::lower_call_arg_types_indexed(
        ir_lookup_index, ir_bytes, ir_bytes[0..0], position_function.canonical_identity, 2
    );
    defer position_args.deinit();
    if position_args.len() != 2 {
        return error("compiled mir: first token position call must take two arguments");
    }
    let position_line_type = try position_args.get(0);
    let position_column_type = try position_args.get(1);
    var token_at_args = try compiled_mir_types::lower_call_arg_types_indexed(
        ir_lookup_index, ir_bytes, ir_bytes[0..0], token_at_function.canonical_identity, 3
    );
    defer token_at_args.deinit();
    if token_at_args.len() != 3 {
        return error("compiled mir: first token target call must take three arguments");
    }
    let offset_type = try token_at_args.get(1);
    try require_exact_call_arg_types(
        &token_at_args, source_type, offset_type, position_function.return_type.abi,
        ir_bytes[0..0], 3
    );
    if !std::mem::equal_bytes(token_at_function.return_type.abi, llvm_return_type) {
        return error("compiled mir: first token return ABI mismatch");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::first_token_stmt(
        source_name, source_type, position_function.return_type.abi, llvm_return_type,
        position_line_type, position_column_type, offset_type,
        position_function.owner_module, resolved_function_local_name(&position_function),
        token_at_function.owner_module, resolved_function_local_name(&token_at_function)
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_next_token_function lowers std::kizu::lexer::next_token into a single NextToken statement:
// it reads previous.start / end / line / column, advances the Position via advance_position, then
// returns token_at(source, previous.end, next) (tracker 961, scope 4 prerequisite). Its nested call
// arguments the generic path does not model, so it is dispatched by name.
pub fn lower_next_token_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let source_type = try nth_param_field(params_spec, 0, false);
    let previous_name = try nth_param_field(params_spec, 1, true);
    let previous_abi = try nth_param_field(params_spec, 1, false);
    let owner_module = try compiled_type_resolver::function_owner_module_indexed(
        ir_lookup_index, ir_bytes, function_name
    );
    let previous_spelling = try compiled_mir_types::resolve_value_kizu_type_indexed(
        ir_lookup_index, ir_bytes, function_name, owner_module,
        params_spec, previous_name, bs
    );
    let token_type = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, owner_module, previous_spelling
    );
    if !std::mem::equal_bytes(token_type.abi, previous_abi) or
        !std::mem::equal_bytes(token_type.abi, llvm_return_type) {
        return error("compiled mir: next token parameter/return ABI mismatch");
    }
    let start_field = try exact_struct_field_by_identity(
        ir_lookup_index, ir_bytes, token_type.canonical_identity, "start"
    );
    let end_field = try exact_struct_field_by_identity(
        ir_lookup_index, ir_bytes, token_type.canonical_identity, "end"
    );
    let line_field = try exact_struct_field_by_identity(
        ir_lookup_index, ir_bytes, token_type.canonical_identity, "line"
    );
    let column_field = try exact_struct_field_by_identity(
        ir_lookup_index, ir_bytes, token_type.canonical_identity, "column"
    );
    let start_field_type = try exact_field_type_abi(ir_lookup_index, ir_bytes, &start_field);
    let end_field_type = try exact_field_type_abi(ir_lookup_index, ir_bytes, &end_field);
    let line_field_type = try exact_field_type_abi(ir_lookup_index, ir_bytes, &line_field);
    let column_field_type = try exact_field_type_abi(ir_lookup_index, ir_bytes, &column_field);

    let advance_call = try let_call_at_statement(ir_bytes, function_name, 0, bs);
    let position_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, advance_call, "arg", 3, bs
    );
    let position_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, position_call, bs
    );
    if !std::mem::equal_bytes(position_kind, "Call") {
        return error("compiled mir: next token position argument must be a call");
    }
    let return_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let return_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, return_statement, bs
    );
    if !std::mem::equal_bytes(return_kind, "Return") {
        return error("compiled mir: next token second statement must be a return");
    }
    let token_at_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_statement, "value", 0, bs
    );
    let token_at_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, token_at_call, bs
    );
    if !std::mem::equal_bytes(token_at_kind, "Call") {
        return error("compiled mir: next token return value must be a call");
    }
    let position_function = try exact_non_error_call(
        ir_lookup_index, ir_bytes, function_name, position_call
    );
    let advance_function = try exact_non_error_call(
        ir_lookup_index, ir_bytes, function_name, advance_call
    );
    let token_at_function = try exact_non_error_call(
        ir_lookup_index, ir_bytes, function_name, token_at_call
    );
    var position_args = try compiled_mir_types::lower_call_arg_types_indexed(
        ir_lookup_index, ir_bytes, ir_bytes[0..0], position_function.canonical_identity, 2
    );
    defer position_args.deinit();
    try require_exact_call_arg_types(
        &position_args, line_field_type, column_field_type,
        ir_bytes[0..0], ir_bytes[0..0], 2
    );
    var advance_args = try compiled_mir_types::lower_call_arg_types_indexed(
        ir_lookup_index, ir_bytes, ir_bytes[0..0], advance_function.canonical_identity, 4
    );
    defer advance_args.deinit();
    try require_exact_call_arg_types(
        &advance_args, source_type, start_field_type, end_field_type,
        position_function.return_type.abi, 4
    );
    if !std::mem::equal_bytes(
        advance_function.return_type.abi, position_function.return_type.abi
    ) {
        return error("compiled mir: next token advance-position return ABI mismatch");
    }
    var token_at_args = try compiled_mir_types::lower_call_arg_types_indexed(
        ir_lookup_index, ir_bytes, ir_bytes[0..0], token_at_function.canonical_identity, 3
    );
    defer token_at_args.deinit();
    try require_exact_call_arg_types(
        &token_at_args, source_type, end_field_type, position_function.return_type.abi,
        ir_bytes[0..0], 3
    );
    if !std::mem::equal_bytes(token_at_function.return_type.abi, llvm_return_type) {
        return error("compiled mir: next token return call ABI mismatch");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::next_token_stmt(
        source_name, source_type, previous_name, position_function.return_type.abi,
        llvm_return_type, start_field_type, end_field_type, line_field_type,
        column_field_type, start_field.index, end_field.index, line_field.index,
        column_field.index,
        position_function.owner_module, resolved_function_local_name(&position_function),
        advance_function.owner_module, resolved_function_local_name(&advance_function),
        token_at_function.owner_module, resolved_function_local_name(&token_at_function)
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_token_at_function lowers std::kizu::lexer::token_at into a single TokenAt statement: the
// top-level tokenizer step that skips whitespace and line comments while tracking the pending doc
// span, then returns attach_doc(raw_token_at(...), doc_start, doc_end) (tracker 961, scope 4
// prerequisite). Its nested loops with five outer loop-carried variables and conditional doc-span
// updates the generic path does not model, so it is dispatched by name. All callees are the
// already-compiled lexer helpers.
pub fn lower_token_at_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let offset_name = try nth_param_field(params_spec, 1, true);
    let initial_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::token_at_stmt(
        source_name, offset_name, initial_name, position_type, llvm_return_type,
        "kizu_kizu__lexer_is_space", "kizu_kizu__lexer_advance_byte",
        "kizu_kizu__lexer_is_doc_comment_start", "kizu_kizu__lexer_skip_line_comment",
        "kizu_kizu__lexer_position", "kizu_kizu__lexer_raw_token_at",
        "kizu_kizu__lexer_attach_doc"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_skip_line_comment_function lowers std::kizu::lexer::skip_line_comment into a single
// SkipLineComment statement: a two-phi loop threading the i64 end and the Position struct current
// past a comment line, folding advance_byte until newline, then building the Eof Token (tracker
// 961, scope 4 prerequisite). Its struct loop-carried variable, compound 'end < len and
// source[end] != 10' condition, and call-in-loop the generic while machinery does not model, so it
// is dispatched by name. The TokenKind::Eof tag is resolved from the enum-variant facts.
pub fn lower_skip_line_comment_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let initial_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let eof_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Eof"
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::skip_line_comment_stmt(
        source_name, start_name, initial_name, position_type, llvm_return_type,
        "kizu_kizu__lexer_advance_byte", "kizu_kizu__lexer_token", eof_tag
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_is_doc_comment_start_function lowers std::kizu::lexer::is_doc_comment_start into a single
// IsDocCommentStart statement: a bounded branch chain returning i1 over three slash bytes plus a
// fourth-slash demotion check (tracker 961, scope 4 prerequisite). Its index loads inside compound
// boolean conditions the generic path does not model, so it is dispatched by name.
pub fn lower_is_doc_comment_start_function(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::is_doc_comment_start_stmt(source_name, start_name));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// append_word_keyword resolves a keyword's TokenKind discriminant from the enum-variant facts and
// appends it to word_token's keyword table (tracker 961, scope 4 prerequisite).
fn append_word_keyword(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    keywords: &var std::array::Array<compiled_mir::MirKeyword>,
    text: []u8,
    variant: []u8
) -> !void {
    let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", variant
    );
    try keywords.append(compiled_mir::keyword(text, tag));
    return;
}

// lower_word_token_function lowers std::kizu::lexer::word_token into a single WordToken statement:
// an is_word scan loop, an empty-run single-byte Ident, a keyword table compared via equal_bytes,
// and a multi-byte Ident fallback (tracker 961, scope 4 prerequisite). Its scan loop plus the
// keyword-comparison chain over string constants the generic path does not model, so it is
// dispatched by name. The keyword and Ident discriminants come from the enum-variant facts.
pub fn lower_word_token_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let source_name = try nth_param_field(params_spec, 0, true);
    let start_name = try nth_param_field(params_spec, 1, true);
    let current_name = try nth_param_field(params_spec, 2, true);
    let position_type = try nth_param_field(params_spec, 2, false);
    let ident_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, "std::kizu::lexer::", "TokenKind", "Ident"
    );
    var keywords = std::array::Array<compiled_mir::MirKeyword>(std::mem::page_allocator());
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "fn", "Fn");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "import", "Import");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "pub", "Pub");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "struct", "Struct");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "enum", "Enum");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "union", "Union");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "extern", "Extern");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "dyn", "Dyn");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "let", "Let");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "var", "Var");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "return", "Return");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "defer", "Defer");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "if", "If");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "else", "Else");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "while", "While");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "for", "For");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "break", "Break");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "continue", "Continue");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "match", "Match");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "unsafe", "Unsafe");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "comptime", "Comptime");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "try", "Try");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "true", "True");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "false", "False");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "and", "And");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "or", "Or");
    try append_word_keyword(ir_lookup_index, ir_bytes, &var keywords, "mut", "Mut");
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::word_token_stmt(
        llvm_symbol, source_name, start_name, current_name, position_type,
        llvm_return_type, "kizu_kizu__lexer_is_word", "kizu_kizu__lexer_token",
        "kizu_selfhost__slice_equal", ident_tag, keywords
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

pub fn lower_ast_node_text_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let text_name = try nth_param_field(params_spec, 0, true);
    let ast_name = try nth_param_field(params_spec, 1, true);
    let node_id_name = try nth_param_field(params_spec, 2, true);
    let fetch_call = try let_call_at_statement(ir_bytes, function_name, 0, bs);
    let span_fetch = try resolve_node_span_fetch_abi(
        ir_lookup_index, ir_bytes, function_name, fetch_call
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::ast_node_text_stmt(
        text_name, ast_name, span_fetch.fetch.receiver_type,
        node_id_name, span_fetch.fetch.index_type,
        span_fetch.fetch.get_module, span_fetch.fetch.get_name,
        span_fetch.fetch.node_type, span_fetch.fetch.field_type,
        span_fetch.fetch.field_index, span_fetch.start_index, span_fetch.end_index,
        "", "kizu_std__mem_trim_ascii"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_string_literal_span_function lowers selfhost::ir::codegen::string_literal_span into a
// single StringLiteralSpan statement: it binds the AstNode off Ast.get, reads the Span, checks
// the surrounding quotes, and forwards the inner payload slice to is_payload_supported, returning
// the trimmed PayloadSpan or empty_payload_span() (tracker 961, scope 4 prerequisite). Both
// helper callees live in this function's own selfhost::ir::codegen module.
pub fn lower_string_literal_span_function(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let text_name = try nth_param_field(params_spec, 0, true);
    let ast_name = try nth_param_field(params_spec, 1, true);
    let node_id_name = try nth_param_field(params_spec, 2, true);
    let fetch_call = try let_call_at_statement(ir_bytes, function_name, 0, bs);
    let span_fetch = try resolve_node_span_fetch_abi(
        ir_lookup_index, ir_bytes, function_name, fetch_call
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::string_literal_span_stmt(
        text_name, ast_name, span_fetch.fetch.receiver_type,
        node_id_name, span_fetch.fetch.index_type,
        span_fetch.fetch.get_module, span_fetch.fetch.get_name,
        span_fetch.fetch.node_type, span_fetch.fetch.field_type,
        span_fetch.fetch.field_index, span_fetch.start_index, span_fetch.end_index,
        module_prefix, "is_payload_supported", "empty_payload_span"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// return_value_is_literal_plus_try reports whether a single-return value is the shape
// '<int literal> + try <call>' (count_one / count_with_range, tracker 961).
pub fn return_value_is_literal_plus_try(
    ir_bytes: []u8,
    function_name: []u8,
    value: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left, bs);
    if !std::mem::equal_bytes(left_kind, "Int") {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right, bs);
    return std::mem::equal_bytes(right_kind, "TryExpr");
}

// lower_return_try_binary_function lowers 'return <int> + try <callee>(<args>);' into a
// single ReturnTryBinary statement (count_one / count_with_range, tracker 961).
pub fn lower_return_try_binary_function(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    instance_context: &compiled_instance_context::InstanceContext,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    try compiled_mir_types::set_instance_context(
        call_arg_type_cache, instance_context
    );
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let literal = try ir_contract::body_int_value_from(ir_bytes, function_name, left, bs);
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let inner_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, right, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner_call, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: return-try binary must wrap a call");
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, inner_call, bs, &call_arg_type_cache
    );
    let args = try compiled_mir_lower_call::lower_call_args_canonical(
        ir_bytes, function_name, module_prefix, params_spec, inner_call, 0, bs,
        ir_lookup_index, canonical_facts, &call_info.types,
        call_arg_type_cache
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::return_try_binary_stmt(
        literal, call_info.return_llvm_type, llvm_return_type,
        call_info.module_prefix, call_info.callee_name, 0, 0, args
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// match_union_arm_expr unwraps a match arm body to its value expression: the parser wraps
// a bare expression arm body in an ExprStmt, so the field chain / integer literal lives at
// the ExprStmt 'expr' child (tracker 961).
fn match_union_arm_expr(
    ir_bytes: []u8,
    function_name: []u8,
    arm_body: i64,
    bs: i64
) -> !i64 {
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arm_body, bs);
    if std::mem::equal_bytes(body_kind, "ExprStmt") {
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_body, "expr", 0, bs
        );
    }
    return arm_body;
}

// lower_array_len_method_return lowers a single 'return self.<field>.len();' where
// <field> is a std::array::Array<T> field of a struct value parameter. It is the
// first AST read-only accessor compiled into stage2 (std::kizu::ast::Ast.len): it
// lands the Ast struct value as a parameter, lowers the self.children field access
// as an extractvalue, and lowers Array.len() to the array_len builtin runtime call
// (@kizu_array_len). It deliberately does NOT touch the AstNode/AstData union,
// Arena.get, array_get, or error-union return; those remain blocked in tracker 961.
pub fn lower_array_len_method_return(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    // The callee FieldExpr names the method (len) and carries the array field
    // expression (self.children) as its receiver.
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "len") {
        return error("compiled mir: only Array.len method accessor is supported");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 0 {
        return error("compiled mir: Array.len accessor takes no arguments");
    }
    // The method receiver is the array field expression self.children.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, bs
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.len receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    // The field expression's receiver must be a plain struct value parameter (self).
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, bs
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.len field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(params_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, params_spec
    );
    let field = try exact_struct_field(
        ir_lookup_index, ir_bytes, module_prefix, struct_kizu_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.len receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.len receiver field is not a std::array::Array");
    }
    // Array<T> lowers to the %kizu.owned heap handle (the same { ptr } container the
    // selfhost runtime uses), and Array.len() lowers to the array_len builtin runtime
    // call @kizu_rt_array_len(%kizu.owned) returning i64. The only argument is the
    // array field extracted out of the struct value parameter.
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::field_access_call_arg(
        "%kizu.owned", receiver_llvm_type, var_name, field.index
    ));
    return compiled_mir_function::single_call_return_function(
        llvm_symbol,
        "i64",
        params_spec,
        "",
        "kizu_rt_array_len",
        args
    );
}
// lower_array_get_method_return lowers a single 'return self.<field>.get(index);'
// where <field> is a std::array::Array<T> field of a struct value parameter and
// index is an i64 parameter. It is the first checked Array<T>.get accessor compiled
// into stage2 (std::kizu::diagnostic::Diagnostic.related_get, tracker 961): it reads
// the Array field off the struct value parameter, calls the checked
// @kizu_rt_array_at runtime helper, and on success loads the element value out of
// the borrowed view and wraps it as the error-union success value; on failure it
// forwards the runtime message as the error-union failure value. The error branch
// is a real failure return, never 'unreachable'.
pub fn lower_array_get_method_return(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    call_node: i64,
    bs: i64
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    // The single argument is the i64 index parameter.
    let index_arg = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    let index_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, index_arg, bs
    );
    if !std::mem::equal_bytes(index_kind, "Var") {
        return error("compiled mir: Array.get index must be a parameter");
    }
    let index_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, index_arg, bs
    );
    // The method receiver is the array field expression self.<field>.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, bs
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.get receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", bs
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, bs
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, bs
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.get field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, bs
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(params_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, params_spec
    );
    let field = try exact_struct_field(
        ir_lookup_index, ir_bytes, module_prefix, struct_kizu_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.get receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.get receiver field is not a std::array::Array");
    }
    // The element type backs the by-value load out of the borrowed view. It is
    // looked up by its own fully-qualified name (empty module prefix) so the lookup
    // is independent of which module the accessor lives in.
    let element_kizu_type = try array_element_kizu_type(field.field_type);
    let element_llvm_type = try exact_type_abi(
        ir_lookup_index, ir_bytes, field.declaring_module, element_kizu_type
    );
    return compiled_mir_function::single_array_get_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        receiver_llvm_type,
        var_name,
        field.index,
        index_name,
        element_llvm_type
    );
}
pub fn lower_struct_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    instance_context: &compiled_instance_context::InstanceContext,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    try compiled_mir_types::set_instance_context(
        call_arg_type_cache, instance_context
    );
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let fields = try compiled_mir_lower_struct::lower_struct_fields(
        ir_bytes, function_name, module_prefix, params_spec, value_node, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return compiled_mir_function::single_struct_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        fields
    );
}

pub fn lower_expr_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    let value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, value_node, bs
    );
    if std::mem::equal_bytes(value_kind, "TryExpr") {
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value_node, "value", 0, bs
        );
        let inner_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, inner, bs
        );
        if std::mem::equal_bytes(inner_kind, "Call") and
            (try call_is_value_array_get_cached(
                ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
                inner, bs, call_arg_type_cache
            )) {
            var aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
            var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
            let stmt = try lower_multi_return_value_array_get(
                ir_bytes, function_name, module_prefix, params_spec,
                inner, 0, 0, &aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            try stmts.append(stmt);
            return compiled_mir_function::multi_statement_function(
                llvm_symbol,
                llvm_return_type,
                params_spec,
                stmts
            );
        }
    }
    let result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        value_node,
        0,
        0,
        &var insts,
        bs,
        ir_lookup_index,
        canonical_facts,
        call_arg_type_cache
    );
    return compiled_mir_function::single_expr_return_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        result_id,
        insts
    );
}

pub fn return_value_is_short_circuit_or(
    ir_bytes: []u8,
    function_name: []u8,
    value_node: i64,
    bs: i64
) -> !bool {
    return (try short_circuit_kind(ir_bytes, function_name, value_node, bs)) == 2;
}

pub fn lower_short_circuit_or_return_function(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    let prefix_result = try lower_short_circuit_or_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        value_node,
        0,
        0,
        0,
        &var stmts,
        bs,
        ir_lookup_index,
        canonical_facts,
        call_arg_type_cache
    );
    var final_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let final_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        prefix_result.final_node,
        prefix_result.string_counter,
        prefix_result.temp_counter,
        &var final_insts,
        bs,
        ir_lookup_index,
        canonical_facts,
        call_arg_type_cache
    );
    try stmts.append(compiled_mir::return_expr_stmt(
        prefix_result.string_counter,
        final_result,
        final_insts
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        stmts
    );
}

pub struct ShortCircuitOrLowerResult {
    pub final_node: i64,
    pub string_counter: i64,
    pub temp_counter: i64,
    pub if_index: i64,
}

fn lower_short_circuit_or_prefix(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !ShortCircuitOrLowerResult {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) != 2 {
        return ShortCircuitOrLowerResult {
            final_node: node,
            string_counter: string_counter,
            temp_counter: temp_counter,
            if_index: if_index
        };
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    let left_result = try append_short_circuit_or_operand_ifs(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        left_node,
        string_counter,
        temp_counter,
        if_index,
        stmts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return try lower_short_circuit_or_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        right_node,
        left_result.string_counter,
        left_result.temp_counter,
        left_result.if_index,
        stmts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
}

fn append_short_circuit_or_operand_ifs(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !ShortCircuitOrLowerResult {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) == 2 {
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        let left_result = try append_short_circuit_or_operand_ifs(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            params_spec,
            left_node,
            string_counter,
            temp_counter,
            if_index,
            stmts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        return try append_short_circuit_or_operand_ifs(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            params_spec,
            right_node,
            left_result.string_counter,
            left_result.temp_counter,
            left_result.if_index,
            stmts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        node,
        string_counter,
        temp_counter,
        &var cond_insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let cond_strings = try count_strings_in_insts(&cond_insts);
    let cond_len = cond_insts.len();
    try stmts.append(compiled_mir::if_stmt(
        if_index,
        string_counter,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
        compiled_mir::MirIfThenKind::ReturnBool,
        true,
        llvm_return_type,
        "",
        "",
        std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        string_counter + cond_strings,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator())
    ));
    return ShortCircuitOrLowerResult {
        final_node: node,
        string_counter: string_counter + cond_strings,
        temp_counter: temp_counter + cond_len,
        if_index: if_index + 1
    };
}

// ValueLoopInit carries the value-carried loop seed call's (module_prefix, callee_name) so the
// renderer can emit '@<module_prefix><callee>' for the first iteration value, plus the seed call's
// return kizu type -- the loop's element type, used for the array element width and the struct
// field layout (issue 1165).
struct ValueLoopInit {
    callee_qualified: []u8,
    element_kizu: []u8,
    element_owner_module: []u8,
    element_canonical_identity: []u8,
    returns_error: bool,
}

// node_kind_is reports whether a body node's kind equals the expected string. It wraps
// body_node_kind_from so callers avoid nesting a try-expression inside a call argument, which keeps
// the value-loop helpers within the std parser subset the selfhost compiler accepts (issue 1165).
fn node_kind_is(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    expected: []u8,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    return std::mem::equal_bytes(kind, expected);
}

// find_while_statement returns the sequence id of the first top-level While statement, or -1 when
// the function has none (issue 1165). Used to detect the value-carried array-append loop shape.
fn find_while_statement(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !i64 {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "While") {
            return statement;
        }
        index = index + 1;
    }
    return -1;
}

// find_while_index returns the statement index of the first top-level While, or -1 when the function
// has none. The index lets lower_value_array_loop bracket the loop with the seed append (index - 1)
// and the array return (index + 1) (issue 1165).
fn find_while_index(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !i64 {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        if try node_kind_is(ir_bytes, function_name, statement, "While", bs) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// value_loop_call_arg_var returns the local name of a call's nth argument, requiring it to be a Var.
// The value loop's seed / update calls take only local arguments, so a non-local is rejected rather
// than mis-lowered (issue 1165).
fn value_loop_call_arg_var(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    arg_index: i64,
    bs: i64
) -> ![]u8 {
    let arg = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", arg_index, bs
    );
    if !try node_kind_is(ir_bytes, function_name, arg, "Var", bs) {
        return error("compiled mir: value-loop call argument must be a local");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, arg, bs);
}

// is_value_array_loop_shape reports whether this multi-statement function is the value-carried
// array-append loop that generic lowering targets (issue 1165): a While whose condition is a
// single '<struct-value>.<field> != <Enum>::<Variant>' comparison -- a field-mode FieldExpr on
// the left and a namespace-mode FieldExpr (an enum constant) on the right. This is structurally
// distinct from the i64-induction While (whose condition compares an i64 Var), so detecting it
// here never diverts an induction loop. The body shape (reassign + try-append) and the array /
// seed lets are validated by lower_value_array_loop; a true result commits to that path.
fn is_value_array_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    let while_statement = try find_while_statement(ir_bytes, function_name, statement_count, bs);
    if while_statement < 0 {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    let cond_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, cond_node, bs);
    if !std::mem::equal_bytes(cond_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "not-eq") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_kind, "FieldExpr") {
        return false;
    }
    let left_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, left_node, bs
    );
    if !std::mem::equal_bytes(left_mode, "field") {
        return false;
    }
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(right_kind, "FieldExpr") {
        return false;
    }
    let right_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, right_node, bs
    );
    return std::mem::equal_bytes(right_mode, "namespace");
}

// find_value_loop_init locates the 'var <loop_var> = <callee>(<source>)' seed let and returns the
// callee's (module_prefix, callee_name). The seed supplies both the loop's preheader value and the
// element type that array_new / the append slices use (issue 1165).
fn find_value_loop_init(
    ir_bytes: []u8,
    function_name: []u8,
    loop_var: []u8,
    source_name: []u8,
    statement_count: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !ValueLoopInit {
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, loop_var) {
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
                let value_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, value, bs
                );
                if !std::mem::equal_bytes(value_kind, "Call") {
                    return error("compiled mir: value-loop seed must be a call");
                }
                if (try compiled_mir_types::count_call_args(ir_bytes, function_name, value, bs)) != 1 {
                    return error("compiled mir: value-loop seed takes exactly the source argument");
                }
                let seed_arg = try value_loop_call_arg_var(ir_bytes, function_name, value, 0, bs);
                if !std::mem::equal_bytes(seed_arg, source_name) {
                    return error("compiled mir: value-loop seed argument must be the source");
                }
                let init_function = try compiled_type_resolver::resolve_call_indexed(
                    ir_lookup_index, ir_bytes, function_name, value
                );
                return ValueLoopInit {
                    callee_qualified: init_function.canonical_identity,
                    element_kizu: init_function.return_spelling,
                    element_owner_module: init_function.owner_module,
                    element_canonical_identity: init_function.return_type.canonical_identity,
                    returns_error: init_function.returns_error
                };
            }
        }
        index = index + 1;
    }
    return error("compiled mir: value-loop seed let not found");
}

// value_loop_assert_append validates that <statement> is exactly 'try <array_name>.append(<value_name>);'
// -- an ExprStmt wrapping a try-call of the 'append' method on the array local, taking the carried
// value as its sole argument. Both the seed append (before the loop) and the body append are checked
// this way so a near-miss shape (wrong receiver, wrong/extra argument, different method) is an explicit
// error rather than a silent mis-lowering (issue 1165).
fn value_loop_assert_append(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    array_name: []u8,
    value_name: []u8,
    bs: i64
) -> !void {
    if !try node_kind_is(ir_bytes, function_name, statement, "ExprStmt", bs) {
        return error("compiled mir: value-loop append must be an expression statement");
    }
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, expr, "TryExpr", bs) {
        return error("compiled mir: value-loop append must be a try expression");
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, inner, "Call", bs) {
        return error("compiled mir: value-loop append must wrap a call");
    }
    if !try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: value-loop append must be a method call");
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "append") {
        return error("compiled mir: value-loop method must be append");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, receiver_node, "Var", bs) {
        return error("compiled mir: value-loop array receiver must be a local");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_name, array_name) {
        return error("compiled mir: value-loop append receiver must be the array");
    }
    if (try compiled_mir_types::count_call_args(ir_bytes, function_name, inner, bs)) != 1 {
        return error("compiled mir: value-loop append takes exactly one argument");
    }
    let arg_name = try value_loop_call_arg_var(ir_bytes, function_name, inner, 0, bs);
    if !std::mem::equal_bytes(arg_name, value_name) {
        return error("compiled mir: value-loop append argument must be the carried value");
    }
    return;
}

// value_loop_owned_constructor finds the exact TypeId-derived owned-sequence constructor let
// preceding the loop. The frontend descriptor proves the nominal constructor and element type;
// this shape check only enforces that the allocator matches the renderer's allocator parameter.
struct ValueLoopOwnedConstructor {
    name: []u8,
    result_abi: []u8,
    element_abi: []u8,
}

fn value_loop_owned_constructor(
    ir_bytes: []u8,
    function_name: []u8,
    allocator_name: []u8,
    before_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !ValueLoopOwnedConstructor {
    var index = 0;
    while index < before_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        if try node_kind_is(ir_bytes, function_name, statement, "Let", bs) {
            let value = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "value", 0, bs
            );
            if try node_kind_is(ir_bytes, function_name, value, "Call", bs) {
                let constructor = try compiled_type_resolver::owned_constructor_indexed(
                    ir_lookup_index, ir_bytes, function_name, value
                );
                if constructor.found {
                    if constructor.family != builtin_contract::owned_container_family_sequence() {
                        return error("compiled mir: value-loop constructor is not an owned sequence");
                    }
                    let ctor_args = try compiled_mir_types::count_call_args(
                        ir_bytes, function_name, value, bs
                    );
                    if ctor_args != 1 {
                        return error("compiled mir: value-loop owned sequence constructor takes exactly the allocator argument");
                    }
                    let ctor_arg = try value_loop_call_arg_var(
                        ir_bytes, function_name, value, 0, bs
                    );
                    if !std::mem::equal_bytes(ctor_arg, allocator_name) {
                        return error("compiled mir: value-loop owned sequence constructor argument must be the allocator");
                    }
                    let name_node = try ir_contract::body_child_sequence_from(
                        ir_bytes, function_name, statement, "name", 0, bs
                    );
                    return ValueLoopOwnedConstructor {
                        name: try ir_contract::body_token_or_empty_from(
                            ir_bytes, function_name, name_node, bs
                        ),
                        result_abi: constructor.result_type.abi,
                        element_abi: constructor.storage_type.abi
                    };
                }
            }
        }
        index = index + 1;
    }
    return error("compiled mir: value-loop owned sequence constructor let not found");
}

// lower_value_array_loop lowers the value-carried array-append loop (the std::kizu::lexer::tokenize
// shape) into a generic ArrayNew + ValueWhile pair (issue 1165). It derives every loop parameter
// from the IR rather than the function name: the loop var and array name from the condition / body,
// the element type and field index from resolving the condition's field access, the Eof sentinel
// tag from the condition's enum constant, and the seed / update callees from the seed let and the
// body reassignment. The element width and struct layout flow from the element type, so no size or
// symbol is hardcoded per function. ABI types (%kizu.owned / %kizu.error.void) and the runtime
// append symbol are fixed array-runtime constants, not tokenize specifics.
pub fn lower_value_array_loop(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let allocator_name = try nth_param_field(params_spec, 0, true);
    let source_name = try nth_param_field(params_spec, 1, true);
    let while_index = try find_while_index(ir_bytes, function_name, statement_count, bs);
    if while_index < 0 {
        return error("compiled mir: value-loop while statement not found");
    }
    // The loop must be directly preceded by the seed append and be the penultimate statement, with
    // the array return trailing it: [array-let, seed-let, seed-append, while, return] (issue 1165).
    if while_index < 1 {
        return error("compiled mir: value-loop while must follow the seed append");
    }
    if while_index + 1 != statement_count - 1 {
        return error("compiled mir: value-loop while must be the penultimate statement");
    }
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    let loop_var_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, left_node, "receiver", 0, bs
    );
    let loop_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, loop_var_receiver, bs
    );
    // The TypeId-derived owned-sequence constructor preceding the loop anchors the seed append,
    // body append, and return.
    let array_constructor = try value_loop_owned_constructor(
        ir_bytes, function_name, allocator_name, while_index, bs, ir_lookup_index
    );
    let array_name = array_constructor.name;
    // The seed call's return type is the carried struct -- the array element type. Deriving it from
    // the seed call avoids re-resolving the loop var's type through its field access, whose namespaced
    // same-module callee the local-type resolver mis-reads as an Arena.add (issue 1165). The element
    // kizu type then yields the LLVM element type and the compared field's struct index. The seed let
    // also pins 'var <loop_var> = <init>(<source>)'.
    let init = try find_value_loop_init(
        ir_bytes, function_name, loop_var, source_name, statement_count, bs,
        ir_lookup_index
    );
    let element_kizu = init.element_kizu;
    let element_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, init.element_owner_module, element_kizu
    );
    if !std::mem::equal_bytes(element_type, array_constructor.element_abi) {
        return error("compiled mir: value-loop element ABI does not match constructor fact");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, left_node, "field", bs
    );
    let field = try exact_struct_field(
        ir_lookup_index, ir_bytes, init.element_owner_module, element_kizu, field_name
    );
    if !field.found {
        return error("compiled mir: value-loop compared field not found");
    }
    let field_index = field.index;
    // The condition's right-hand enum constant supplies the loop's exit (Eof) discriminant tag.
    let enum_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, right_node, "receiver", 0, bs
    );
    let enum_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, enum_receiver, bs
    );
    let variant_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, right_node, "namespace", bs
    );
    let eof_tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
        ir_lookup_index, ir_bytes, module_prefix, enum_name, variant_name
    );
    // The statement directly before the loop must seed the array: 'try <array>.append(<loop_var>);'.
    let seed_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index - 1, bs
    );
    try value_loop_assert_append(
        ir_bytes, function_name, seed_statement, array_name, loop_var, bs
    );
    // The loop body must be exactly the reassignment then the try-append.
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 2 {
        return error("compiled mir: value-loop body must be reassignment then append");
    }
    let assign_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, assign_statement, "Assign", bs) {
        return error("compiled mir: value-loop body must begin with a reassignment");
    }
    let assign_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_statement, "target", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, assign_target, "Var", bs) {
        return error("compiled mir: value-loop reassignment target must be a local");
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, assign_target, bs), loop_var
    ) {
        return error("compiled mir: value-loop reassignment must target the carried value");
    }
    let update_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_statement, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, update_value, "Call", bs) {
        return error("compiled mir: value-loop reassignment must be a call");
    }
    if (try compiled_mir_types::count_call_args(ir_bytes, function_name, update_value, bs)) != 2 {
        return error("compiled mir: value-loop update takes the source and carried value");
    }
    let update_arg0 = try value_loop_call_arg_var(ir_bytes, function_name, update_value, 0, bs);
    if !std::mem::equal_bytes(update_arg0, source_name) {
        return error("compiled mir: value-loop update first argument must be the source");
    }
    let update_arg1 = try value_loop_call_arg_var(ir_bytes, function_name, update_value, 1, bs);
    if !std::mem::equal_bytes(update_arg1, loop_var) {
        return error("compiled mir: value-loop update second argument must be the carried value");
    }
    let update_function = try compiled_type_resolver::resolve_call_indexed(
        ir_lookup_index, ir_bytes, function_name, update_value
    );
    if !std::mem::equal_bytes(
        update_function.return_type.canonical_identity,
        init.element_canonical_identity
    ) or update_function.returns_error != init.returns_error {
        return error("compiled mir: value-loop update return type differs from seed");
    }
    let append_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    try value_loop_assert_append(
        ir_bytes, function_name, append_statement, array_name, loop_var, bs
    );
    // The statement directly after the loop must return the filled array: 'return <array>;'.
    let return_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index + 1, bs
    );
    if !try node_kind_is(ir_bytes, function_name, return_statement, "Return", bs) {
        return error("compiled mir: value-loop must end with the array return");
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_statement, "value", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, return_value, "Var", bs) {
        return error("compiled mir: value-loop return value must be the array local");
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs), array_name
    ) {
        return error("compiled mir: value-loop must return the filled array");
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    let allocator_spelling = try compiled_mir_types::resolve_value_kizu_type_indexed(
        ir_lookup_index, ir_bytes, function_name, module_prefix,
        params_spec, allocator_name, bs
    );
    let allocator_type = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, allocator_spelling
    );
    if !std::mem::equal_bytes(allocator_type.canonical_identity, "Allocator") {
        return error("compiled mir: value-loop constructor argument is not an Allocator");
    }
    try stmts.append(compiled_mir::array_new_stmt(
        array_name, array_constructor.result_abi,
        allocator_type.abi, allocator_name, element_type
    ));
    try stmts.append(compiled_mir::value_while_stmt(
        array_name, loop_var, source_name, element_type,
        array_constructor.result_abi, llvm_return_type, "%kizu.error.void",
        init.callee_qualified, update_function.canonical_identity,
        "kizu_rt_array_append", field_index, eof_tag, "vw0"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// grammar_branch_carried_name builds the owned SSA name a grammar-loop branch binds its carried
// value into ('<carried>_b<index>', issue 1157). Each branch reassigns the same carried variable in
// a distinct block, so the bound names must be distinct for valid SSA; the loop-head phi reads each
// on its back-edge. MirNameStore owns the generated bytes for the lifetime of the MIR lowering.
fn grammar_branch_carried_name(
    carried_var: []u8,
    index: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes(carried_var);
    try out.append_bytes("_b");
    try std::fmt::append_i64(&var out, index);
    return call_arg_type_cache.name_store.own(out);
}

// grammar_postfix_reassign_block_matches reports whether an if then-block is a single
// '<carried_var> = try <free-call>(...)' carried-value reassignment (issue 1157). A field-mode
// method call is rejected so only free error-union helpers carry the loop value.
fn grammar_postfix_reassign_block_matches(
    ir_bytes: []u8,
    function_name: []u8,
    then_node: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    if (try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, then_node, "statement", 1, bs
    )) >= 0 {
        return false;
    }
    let stmt = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    if stmt < 0 {
        return false;
    }
    if !(try node_kind_is(ir_bytes, function_name, stmt, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(ir_bytes, function_name, stmt, "target", 0, bs);
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), carried_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(ir_bytes, function_name, stmt, "value", 0, bs);
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(ir_bytes, function_name, value, "value", 0, bs);
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, inner, bs));
}

// grammar_postfix_body_matches reports whether a 'while true' body is a nested if/else chain whose
// non-final arms each reassign the carried value through a free try-call and whose final else
// returns the carried value (issue 1157). The chain is the parse_postfix_expr value-loop body; a
// true result commits lower_grammar_postfix_loop to that path.
fn grammar_postfix_body_matches(
    ir_bytes: []u8,
    function_name: []u8,
    while_statement: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    if (try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    )) >= 0 {
        return false;
    }
    var node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if node < 0 {
        return false;
    }
    while true {
        if !(try node_kind_is(ir_bytes, function_name, node, "If", bs)) {
            return false;
        }
        if (try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, node, "condition", 0, bs
        )) < 0 {
            return false;
        }
        let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, node, "then", 0, bs
        );
        if then_node < 0 {
            return false;
        }
        if !(try grammar_postfix_reassign_block_matches(
            ir_bytes, function_name, then_node, carried_var, bs
        )) {
            return false;
        }
        let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, node, "else", 0, bs
        );
        if else_node < 0 {
            return false;
        }
        if (try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, else_node, "statement", 1, bs
        )) >= 0 {
            return false;
        }
        let else_stmt = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, else_node, "statement", 0, bs
        );
        if else_stmt < 0 {
            return false;
        }
        if try node_kind_is(ir_bytes, function_name, else_stmt, "If", bs) {
            node = else_stmt;
            continue;
        }
        if !(try node_kind_is(ir_bytes, function_name, else_stmt, "Return", bs)) {
            return false;
        }
        let ret_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, else_stmt, "value", 0, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, ret_value, "Var", bs)) {
            return false;
        }
        return std::mem::equal_bytes(
            try ir_contract::body_token_or_empty_from(ir_bytes, function_name, ret_value, bs),
            carried_var
        );
    }
    return false;
}

// is_grammar_postfix_loop_shape reports whether this multi-statement function is the value-carried
// 'while true' grammar loop (the parse_postfix_expr shape, issue 1157): exactly 'var <cv> =
// <param>; while true { <nested if/else reassign chain ending in 'return <cv>'> }; return <cv>;'.
// The literal 'true' condition is structurally distinct from the i64-induction While (whose
// condition compares a counter) and the value-array loop (whose condition is a struct-field
// sentinel), so detecting it here never diverts either. lower_grammar_postfix_loop re-walks and
// commits on a true result.
fn is_grammar_postfix_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return false;
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_value, "Var", bs)) {
        return false;
    }
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let carried_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Bool", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, cond_node, bs), "true"
    ) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    return try grammar_postfix_body_matches(
        ir_bytes, function_name, while_statement, carried_var, bs
    );
}

// lower_grammar_postfix_loop lowers the value-carried 'while true' grammar loop (issue 1157) into a
// single GrammarLoop statement. It derives every parameter from the IR: the carried variable and
// its preheader seed from the init let, each branch's predicate condition (lowered through the
// shared expression path, so bool-predicate calls and field-access arguments reuse the generic
// machinery) and its free error-union reassignment try-call from the nested if/else chain. The
// terminal else returns the carried value, so the loop never falls through. Per-branch SSA names
// are namespaced by a unique try index and temp/string offset so the renderer's loop-head phi and
// try-call blocks never collide.
fn lower_grammar_postfix_loop(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let carried_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, init_value, bs);
    let carried_type = try compiled_mir_types::resolve_value_llvm_type_indexed(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, params_spec, carried_var, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    var branches = std::array::Array<compiled_mir::MirGrammarBranch>(std::mem::page_allocator());
    var aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer aliases.deinit();
    var string_counter = 0;
    var temp_counter = 0;
    var try_index = 0;
    var node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    while true {
        let cond_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "condition", 0, bs
        );
        var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
        let cond_result = try lower_expr_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            cond_node,
            string_counter,
            temp_counter,
            &var cond_insts,
            &aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let cond_strings = try count_strings_in_insts(&cond_insts);
        let cond_inst_count = cond_insts.len();
        let then_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "then", 0, bs
        );
        let then_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_node, "statement", 0, bs
        );
        let try_expr = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_stmt, "value", 0, bs
        );
        let call_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, try_expr, "value", 0, bs
        );
        let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, call_node, bs, &call_arg_type_cache
        );
        let success_type = try compiled_mir_types::call_info_error_success_llvm(
            ir_lookup_index, canonical_facts, ir_bytes, &call_info
        );
        let reassign_string_index = string_counter + cond_strings;
        let args = try compiled_mir_lower_call::lower_call_args_canonical(
            ir_bytes, function_name, module_prefix, params_spec, call_node, reassign_string_index, bs,
            ir_lookup_index, canonical_facts, &call_info.types,
            call_arg_type_cache
        );
        let arg_strings = try compiled_mir_lower_call::count_string_args(&args);
        let bound_name = try grammar_branch_carried_name(
            carried_var, try_index, call_arg_type_cache
        );
        let reassign = compiled_mir::MirLetTryCallStmt {
            name: bound_name,
            called_error_union: call_info.return_llvm_type,
            success_type: success_type,
            result_transport: builtin_contract::RuntimeResultTransport::Semantic,
            own_error_union: llvm_return_type,
            call_module_prefix: call_info.module_prefix,
            call_callee_name: call_info.callee_name,
            string_index: reassign_string_index,
            try_index: try_index,
            arg_insts: std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            call_args: args
        };
        try branches.append(compiled_mir::grammar_branch(cond_insts, cond_result, reassign));
        string_counter = reassign_string_index + arg_strings;
        temp_counter = temp_counter + cond_inst_count;
        try_index = try_index + 1;
        let else_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "else", 0, bs
        );
        let else_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, else_node, "statement", 0, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, else_stmt, "If", bs)) {
            break;
        }
        node = else_stmt;
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::grammar_loop_stmt(
        carried_var, carried_type, init_name, llvm_return_type, branches, "gloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// value_cursor_cond_is_prefix_not_call reports whether a while condition is '!<free bool-pred
// call>(..)' -- a Prefix 'not' whose operand is a plain Call (not a TryExpr) on a free function
// (issue 1157 NEW-A). This is the append-while header shape ('while !is_call_close_token(close)').
// It is structurally distinct from the i64-induction While (a Binary comparison), the value-array
// loop (a Binary not-eq of field accesses) and the grammar loop (a Bool literal 'true'), so a true
// result never overlaps any of those headers.
fn value_cursor_cond_is_prefix_not_call(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Prefix", bs)) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-prefix ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "not") {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, right, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, right, bs));
}

// value_cursor_cond_is_plain_call reports whether the while header is a bare bool-predicate call
// '<pred>(<cursor>)' (no 'not' prefix), the parse_import_segments 'while is_double_colon(token)'
// shape. A free-function call (callee is not a field-expr method) gates it apart from a borrowed
// '.is_empty()' method probe; lowering evaluates the whole condition node through the generic
// expression path, so the branch reads the predicate result directly with no negation to invert.
fn value_cursor_cond_is_plain_call(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, cond_node, bs));
}

// value_cursor_statement_is_array_append reports whether a body statement is a 'try
// <array>.append(<x>);' void try-call -- an ExprStmt wrapping a try-call of the 'append' method on
// a local/param Array receiver (issue 1157 NEW-A). It is the append-while's accumulation step; the
// argument is not constrained here because the body lowering re-validates it through the shared
// void-try-call path. A near-miss (wrong method, non-local receiver) returns false.
fn value_cursor_statement_is_array_append(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "ExprStmt", bs)) {
        return false;
    }
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, expr, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    if !(try callee_is_field_expr(ir_bytes, function_name, inner, bs)) {
        return false;
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "append") {
        return false;
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    return try node_kind_is(ir_bytes, function_name, receiver_node, "Var", bs);
}

// value_cursor_statement_is_local_void_call reports whether the body statement at stmt_index is a
// 'try <free-fn>(.. <body-local> ..);' void try-call that consumes a value bound by an earlier let
// in the same loop body (parse_import_segments: 'try add_name_child(ast, segment)', where 'segment'
// is the prior let). It is the embedded value-cursor loop's non-array accumulation step: the call
// is a free function (callee is not a field-expr method, distinguishing it from the '.append(x)'
// array case) and at least one Var argument resolves to a prior body-local, so this consumes the
// loop-local work rather than a free side effect. The body lowering re-validates it through the
// shared void-try-call path.
fn value_cursor_statement_is_local_void_call(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    stmt_index: i64,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", stmt_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, statement, "ExprStmt", bs)) {
        return false;
    }
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, expr, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return false;
    }
    let arg_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, inner, "arg", bs
    );
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, inner, "arg", arg_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, arg_node, "Var", bs) {
            let arg_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, arg_node, bs
            );
            if try value_cursor_body_has_prior_let(
                ir_bytes, function_name, body_node, stmt_index, arg_name, bs
            ) {
                return true;
            }
        }
        arg_index = arg_index + 1;
    }
    return false;
}

// value_cursor_latch_is_try_call reports whether a body statement is a '<cursor> = try
// <free-call>(..);' value-cursor latch -- an Assign whose target is the carried cursor Var and
// whose value is a TryExpr wrapping a free-function call (issue 1157 NEW-A). The latch reassigns
// the cursor through an error-union try-call (next_call_arg_token), so the loop-head phi reads its
// success on the back-edge. A field-mode method call is rejected so only free helpers latch.
fn value_cursor_latch_is_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, inner, bs));
}

// value_cursor_latch_is_plain_call reports whether a body statement is a '<cursor> =
// <free-call>(..);' value-cursor latch -- an Assign to the carried cursor Var whose value is a
// non-try free-function Call (parse_import_segments: 'token = next_token(text, segment)'). It mirrors
// value_cursor_latch_is_try_call but the call returns its success type directly (no error union), so
// the loop-head phi reads %<cursor>_next from the latch block rather than a try-cont block. A
// field-mode method call is rejected so only free helpers latch.
fn value_cursor_latch_is_plain_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, value, bs));
}

fn value_cursor_body_has_prior_let(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    latch_index: i64,
    local_name: []u8,
    bs: i64
) -> !bool {
    var body_index = 0;
    while body_index < latch_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, statement, "Let", bs) {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            if std::mem::equal_bytes(
                try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs),
                local_name
            ) {
                return true;
            }
        }
        body_index = body_index + 1;
    }
    return false;
}

// value_cursor_latch_is_field_read reports whether the terminal body statement is
// '<cursor> = <prior-let>.<field>;' -- an Assign to the carried cursor whose value is a
// field-mode FieldExpr over a variable bound by an earlier let in the same loop body. The field
// name is deliberately not dispatched on; lowering resolves its actual type from the receiver
// struct facts and wires that value to the loop-head phi.
fn value_cursor_latch_is_field_read(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    latch_index: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", latch_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs),
        cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "FieldExpr", bs)) {
        return false;
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, value, bs
    );
    if !std::mem::equal_bytes(mode, "field") {
        return false;
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "receiver", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, receiver, "Var", bs)) {
        return false;
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver, bs
    );
    return try value_cursor_body_has_prior_let(
        ir_bytes, function_name, body_node, latch_index, receiver_name, bs
    );
}

fn value_cursor_latch_is_supported(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    latch_index: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", latch_index, bs
    );
    if try value_cursor_latch_is_try_call(ir_bytes, function_name, statement, cursor_var, bs) {
        return true;
    }
    if try value_cursor_latch_is_plain_call(ir_bytes, function_name, statement, cursor_var, bs) {
        return true;
    }
    return try value_cursor_latch_is_field_read(
        ir_bytes, function_name, body_node, latch_index, cursor_var, bs
    );
}

// is_value_cursor_append_loop_shape reports whether this multi-statement function is the
// value-carried append-while loop NEW-A targets (issue 1157): exactly 'var <cursor> = <var>; while
// !<pred>(<cursor>) { <body incl. try <arr>.append(x)>; <cursor> = try <latch>(..); }; return
// <cursor>;'. The prefix-not bool-predicate-call header, the array-append body step and the
// free-try-call value-cursor latch are jointly distinct from the i64-induction While, the
// value-array loop and the grammar loop, so detecting it here diverts none of them.
// lower_value_cursor_append_loop re-walks and commits on a true result.
fn is_value_cursor_append_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return false;
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_value, "Var", bs)) {
        return false;
    }
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try value_cursor_cond_is_prefix_not_call(ir_bytes, function_name, cond_node, bs)) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_value, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs), cursor_var
    ) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return false;
    }
    // The last body statement is the value-cursor latch; at least one earlier statement is the
    // borrowed-array append. Both must hold for the append-while CFG to be well-formed.
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    if !(try value_cursor_latch_is_try_call(ir_bytes, function_name, latch_stmt, cursor_var, bs)) {
        return false;
    }
    var body_index = 0;
    while body_index < body_count - 1 {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if try value_cursor_statement_is_array_append(ir_bytes, function_name, body_stmt, bs) {
            return true;
        }
        body_index = body_index + 1;
    }
    return false;
}

// lower_value_cursor_append_loop lowers the value-carried append-while loop (issue 1157 NEW-A) into
// a single ValueCursorWhile statement. It derives every parameter from the IR: the cursor variable
// and its preheader seed from the init copy let, the loop-continue predicate (lowered through the
// shared expression path, so the prefix-not bool-predicate call reuses the generic machinery), the
// body statements (lowered through the same per-statement let/if/expr machinery the top level and
// the induction While body use, so a borrowed '&var Array' append lowers as a void try-call) and
// the free-try-call value-cursor latch. The carried type is the latch try-call's success type, so
// no struct width or symbol is hardcoded. The body try-calls take try indices below the latch's, so
// the renderer's fail/cont blocks never collide.
fn lower_value_cursor_append_loop(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    // The init copy 'var <cursor> = <init_name>' supplies the loop-head phi's preheader seed; the
    // copied local/param is an existing SSA value, so the let itself is elided (the phi subsumes it).
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, init_value, bs);
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, params_spec, cond_node, 0, 0, &var cond_insts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var body_string_counter = try count_strings_in_insts(&cond_insts);
    var body_temp_counter = cond_insts.len();
    var body_try_counter = 0;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let body_boundary = body_count - 1;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_alias_counter = 0;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, params_spec, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
                &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, params_spec, body_stmt,
                    body_string_counter, body_temp_counter, body_try_counter, body_alias_counter,
                    body_index + 1, &var body_aliases, &var body_stmts, -1, bs, ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, params_spec,
                        body_stmt, body_string_counter, body_temp_counter, body_try_counter,
                        &body_aliases,
                        &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_temp_counter = expr_result.temp_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported append-while body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    // The last body statement is the value-cursor latch '<cursor> = try <free-call>(..);'. It binds
    // the cursor's next value through a let-position try-call; the renderer suffixes the bound name
    // with "_next" so the loop-head phi reads it on the latch's tryK_cont back-edge. A failure
    // propagates as this function's own error union. The latch try-call's success type is the
    // carried (cursor) type -- a struct value, not the i64 the shared induction latch requires.
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let latch_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_stmt, "value", 0, bs
    );
    let latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_value, "value", 0, bs
    );
    let latch_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, latch_call, bs, &call_arg_type_cache
    );
    let cursor_type = try compiled_mir_types::call_info_error_success_llvm(
        ir_lookup_index, canonical_facts, ir_bytes, &latch_info
    );
    let latch_args = try compiled_mir_lower_call::lower_call_args_canonical(
        ir_bytes, function_name, module_prefix, params_spec, latch_call, body_string_counter, bs,
        ir_lookup_index, canonical_facts, &latch_info.types,
        call_arg_type_cache
    );
    let latch = compiled_mir::value_cursor_try_call_latch(
        cursor_var,
        latch_info.return_llvm_type,
        cursor_type,
        llvm_return_type,
        latch_info.module_prefix,
        latch_info.callee_name,
        body_string_counter,
        body_try_counter,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        latch_args
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::value_cursor_while_stmt(
        cursor_var, cursor_type, init_name, llvm_return_type, cond_insts, cond_result, body_stmts,
        latch, "vcw", true
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

fn precedence_loop_suffixed_name(
    name: []u8,
    suffix: []u8,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes(name);
    try out.append_bytes(suffix);
    return call_arg_type_cache.name_store.own(out);
}

fn precedence_loop_call_uses_carried_field(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, arg_node, "FieldExpr", bs) {
            let receiver = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arg_node, "receiver", 0, bs
            );
            if try node_kind_is(ir_bytes, function_name, receiver, "Var", bs) {
                if std::mem::equal_bytes(
                    try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs),
                    carried_var
                ) {
                    return true;
                }
            }
        }
        arg_index = arg_index + 1;
    }
    return false;
}

fn precedence_loop_let_is_free_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, inner, bs));
}

fn precedence_loop_scalar_init_matches(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, value, bs) {
        return false;
    }
    return try precedence_loop_call_uses_carried_field(
        ir_bytes, function_name, module_prefix, locals_spec, value, carried_var, bs
    );
}

fn precedence_loop_cond_is_scalar_gte(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    scalar_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Binary", bs)) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "gte") {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, left, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left, bs), scalar_var
    ) {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    return try while_condition_value_eager_safe(ir_bytes, function_name, right, bs);
}

fn precedence_loop_scalar_latch_matches(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    scalar_var: []u8,
    carried_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), scalar_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, value, bs) {
        return false;
    }
    return try precedence_loop_call_uses_carried_field(
        ir_bytes, function_name, module_prefix, locals_spec, value, carried_var, bs
    );
}

fn precedence_loop_body_prefix_matches(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    bs: i64
) -> !bool {
    var found_try_let = false;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, body_stmt, "Let", bs)) {
            return false;
        }
        if try precedence_loop_let_is_free_try_call(ir_bytes, function_name, body_stmt, bs) {
            found_try_let = true;
        }
        body_index = body_index + 1;
    }
    return found_try_let;
}

// dual_cursor_call_uses_carried_var reports whether a call passes the carried var directly as a
// plain Var argument (e.g. 'next_token(text, end)' carries 'end'). Unlike the precedence loop's
// '<value>.field' projection, this shape threads the carried value itself, so the back-edge phi of
// that value feeds the call.
fn dual_cursor_call_uses_carried_var(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    carried_var: []u8,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", arg_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, arg_node, "Var", bs) {
            if std::mem::equal_bytes(
                try ir_contract::body_token_or_empty_from(ir_bytes, function_name, arg_node, bs),
                carried_var
            ) {
                return true;
            }
        }
        arg_index = arg_index + 1;
    }
    return false;
}

// dual_cursor_cond_is_predicate_call reports whether the while header is a side-effect-free
// predicate call over the carried scalar cursor (e.g. 'is_double_colon(next)'). It is a plain Call
// (not a field-mode method, not a comparison, not a prefix-not), distinguishing this shape from the
// precedence loop's '>=' comparison and the value-cursor loop's prefix-not predicate.
fn dual_cursor_cond_is_predicate_call(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    scalar_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, cond_node, bs) {
        return false;
    }
    return try dual_cursor_call_uses_carried_var(
        ir_bytes, function_name, cond_node, scalar_var, bs
    );
}

// dual_cursor_scalar_latch_matches reports whether a body statement is the scalar plain-call latch
// '<scalar> = <plain>(.. <value> ..);' -- an Assign to the carried scalar cursor whose value is a
// free call threading the updated carried value (e.g. 'next = next_token(text, end)').
fn dual_cursor_scalar_latch_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    scalar_var: []u8,
    carried_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), scalar_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, value, bs) {
        return false;
    }
    return try dual_cursor_call_uses_carried_var(
        ir_bytes, function_name, value, carried_var, bs
    );
}

// dual_cursor_body_prefix_all_lets reports whether every body statement before the two trailing
// latches is a Let (the per-iteration intermediates the latches consume, e.g. 'let segment =
// next_token(text, next)'). They lower generically through lower_multi_let_statement.
fn dual_cursor_body_prefix_all_lets(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    bs: i64
) -> !bool {
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, body_stmt, "Let", bs)) {
            return false;
        }
        body_index = body_index + 1;
    }
    return true;
}

// is_dual_cursor_loop_shape reports whether this function is the copy-seeded two-carried-value
// cursor loop (parse_type_base_end's '::' segment walk): 'var <value> = <source>; var <scalar> =
// <plain>(<value>); while <predicate>(<scalar>) { <prefix lets>; <value> = try <latch>(..);
// <scalar> = <plain>(<value>); }; return <value>;'. It does not overlap the other while shapes:
// the precedence loop seeds its value with a try-call and compares a scalar with '>=', grammar and
// type-apply loops use a bool-literal header, value-cursor loops carry one value behind a
// prefix-not predicate, and counted induction loops carry an arithmetic scalar latch. The
// distinguishing marks are the Var-copy value seed, the predicate-call header, and the paired
// try-call value latch plus plain-call scalar latch.
fn is_dual_cursor_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 4 {
        return false;
    }
    let value_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value_init_stmt, "Let", bs)) {
        return false;
    }
    let value_init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value_init_value, "Var", bs)) {
        return false;
    }
    let value_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "name", 0, bs
    );
    let value_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_name_node, bs
    );
    let scalar_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, scalar_init_stmt, "Let", bs)) {
        return false;
    }
    let scalar_init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, scalar_init_value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, scalar_init_value, bs) {
        return false;
    }
    if !(try dual_cursor_call_uses_carried_var(
        ir_bytes, function_name, scalar_init_value, value_var, bs
    )) {
        return false;
    }
    let scalar_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "name", 0, bs
    );
    let scalar_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scalar_name_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try dual_cursor_cond_is_predicate_call(
        ir_bytes, function_name, cond_node, scalar_var, bs
    )) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 3, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_value, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs),
        value_var
    ) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return false;
    }
    let value_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 2, bs
    );
    if !(try value_cursor_latch_is_try_call(
        ir_bytes, function_name, value_latch_stmt, value_var, bs
    )) {
        return false;
    }
    let scalar_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    if !(try dual_cursor_scalar_latch_matches(
        ir_bytes, function_name, scalar_latch_stmt, scalar_var, value_var, bs
    )) {
        return false;
    }
    return try dual_cursor_body_prefix_all_lets(
        ir_bytes, function_name, body_node, body_count - 2, bs
    );
}

// trailing_token_field_receiver_is reports whether a node is a 'field-of-var' projection
// '<var_name>.<field>' (a FieldExpr whose receiver is the plain Var <var_name>), e.g. the
// 'current.start' operand of the compound-AND header. A nested or non-Var receiver returns false.
fn trailing_token_field_receiver_is(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    var_name: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, node, "FieldExpr", bs)) {
        return false;
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "receiver", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, receiver, "Var", bs)) {
        return false;
    }
    return std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs),
        var_name
    );
}

// trailing_token_compare_uses_current_field reports whether a node is a relational comparison
// (lt/lte/gt/gte) with at least one operand a '<current>.<field>' projection -- the
// 'current.start < open.start' arm of the dual Token-cursor header. The carried Token's field drives
// the loop's termination, distinguishing this from a constant or unrelated comparison.
fn trailing_token_compare_uses_current_field(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    current_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, node, "Binary", bs)) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, node, bs
    );
    if !(std::mem::equal_bytes(op, "lt") or std::mem::equal_bytes(op, "lte") or
        std::mem::equal_bytes(op, "gt") or std::mem::equal_bytes(op, "gte")) {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "left", 0, bs
    );
    if try trailing_token_field_receiver_is(ir_bytes, function_name, left, current_var, bs) {
        return true;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    return try trailing_token_field_receiver_is(ir_bytes, function_name, right, current_var, bs);
}

// trailing_token_predicate_uses_current reports whether a node is a side-effect-free bool predicate
// over the carried Token cursor -- a plain call carrying <current> as a Var argument, optionally
// wrapped in a prefix '!' (e.g. '!is_eof_token(current)'). It is the second AND arm of the header;
// keeping it side-effect-free is what lets the compound condition lower eagerly.
fn trailing_token_predicate_uses_current(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    current_var: []u8,
    bs: i64
) -> !bool {
    var call_node = node;
    if try node_kind_is(ir_bytes, function_name, node, "Prefix", bs) {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, node, bs
        );
        if !std::mem::equal_bytes(op, "not") {
            return false;
        }
        call_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
    }
    if !(try node_kind_is(ir_bytes, function_name, call_node, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, call_node, bs) {
        return false;
    }
    return try dual_cursor_call_uses_carried_var(
        ir_bytes, function_name, call_node, current_var, bs
    );
}

// trailing_token_cond_is_compound_advance reports whether the while header is the compound AND
// '<current>.<field> < <other>.<field> and <predicate>(<current>)' -- a field comparison advancing
// against a bound plus a side-effect-free bool predicate, both carrying the <current> cursor. The
// AND of a relational comparison with a predicate call is what distinguishes this header from the
// dual-cursor loop's single predicate call and the precedence loop's bare '>=' comparison.
fn trailing_token_cond_is_compound_advance(
    ir_bytes: []u8,
    function_name: []u8,
    cond_node: i64,
    current_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Binary", bs)) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "and") {
        return false;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    if !(try trailing_token_compare_uses_current_field(
        ir_bytes, function_name, left, current_var, bs
    )) {
        return false;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    return try trailing_token_predicate_uses_current(
        ir_bytes, function_name, right, current_var, bs
    );
}

// trailing_token_copy_latch_matches reports whether a body statement is the copy latch
// '<previous> = <current>;' -- an Assign to <previous> whose value is the plain Var <current>. This
// is the trailing-token tracker step: it carries no instruction at lowering (the head <previous> phi
// reads the <current> phi on the back edge), so detecting it here keeps the body to its two latches.
fn trailing_token_copy_latch_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    previous_var: []u8,
    current_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs), previous_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Var", bs)) {
        return false;
    }
    return std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, value, bs), current_var
    );
}

// is_trailing_token_loop_shape reports whether this function is the dual Token-cursor advance loop
// that tracks the trailing token (generic_type_allows_const_arg's '<'-walk, NEW-3 second half): 'var
// <current> = <plain init>; var <previous> = <current>; while <current>.<field> < <other>.<field>
// and <predicate>(<current>) { <previous> = <current>; <current> = <plain>(<current>); }; <post
// stmts using previous>'. Both cursors share one Token type. It does not overlap the other while
// shapes: the dual-cursor loop's statement 0 is a Var-copy (here it is the plain-call seed) and its
// header is a single predicate call (here a compound AND), the precedence loop seeds its value with a
// try-call and compares a scalar with '>=', grammar/type-apply/while-match loops use a bool-literal
// header, value-cursor loops carry one value behind a prefix-not predicate, and counted induction
// loops carry an arithmetic scalar latch. The distinguishing marks are the plain-call seed at
// statement 0, the Var-copy second seed at statement 1, the compound-AND header, the
// '<previous> = <current>' copy latch plus '<current> = <plain>(<current>)' advance latch, and the
// post-loop statements that consume <previous>.
fn is_trailing_token_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count < 4 {
        return false;
    }
    let current_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, current_init_stmt, "Let", bs)) {
        return false;
    }
    let current_init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, current_init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, current_init_value, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, current_init_value, bs) {
        return false;
    }
    let current_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, current_init_stmt, "name", 0, bs
    );
    let current_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, current_name_node, bs
    );
    let previous_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, previous_init_stmt, "Let", bs)) {
        return false;
    }
    let previous_init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, previous_init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, previous_init_value, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, previous_init_value, bs),
        current_var
    ) {
        return false;
    }
    let previous_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, previous_init_stmt, "name", 0, bs
    );
    let previous_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, previous_name_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try trailing_token_cond_is_compound_advance(
        ir_bytes, function_name, cond_node, current_var, bs
    )) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 2 {
        return false;
    }
    let copy_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !(try trailing_token_copy_latch_matches(
        ir_bytes, function_name, copy_latch_stmt, previous_var, current_var, bs
    )) {
        return false;
    }
    let advance_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    if !(try dual_cursor_scalar_latch_matches(
        ir_bytes, function_name, advance_latch_stmt, current_var, current_var, bs
    )) {
        return false;
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", statement_count - 1, bs
    );
    return try node_kind_is(ir_bytes, function_name, last_stmt, "Return", bs);
}

// is_precedence_loop_shape reports whether this function is the two-carried-value
// precedence-climbing loop targeted by issue 1157: exactly value try-call init, scalar
// plain-call init from a carried-value field, a while header comparing that scalar with
// '>=' against a side-effect-free rhs, body lets ending in value try-call latch plus scalar
// plain-call latch, and a final return of the carried value. This does not overlap the
// other while shapes: grammar loops use a bool-literal header, value-cursor loops use a
// prefix-not predicate and one carried value, value-array loops compare struct-field
// sentinels, and counted induction loops carry scalar arithmetic latches.
fn is_precedence_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 4 {
        return false;
    }
    let module_prefix = compiled_util::module_prefix_of(function_name);
    let value_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try precedence_loop_let_is_free_try_call(ir_bytes, function_name, value_init_stmt, bs)) {
        return false;
    }
    let value_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "name", 0, bs
    );
    let value_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_name_node, bs
    );
    let scalar_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try precedence_loop_scalar_init_matches(
        ir_bytes, function_name, module_prefix, params_spec, scalar_init_stmt, value_var, bs
    )) {
        return false;
    }
    let scalar_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "name", 0, bs
    );
    let scalar_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scalar_name_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try precedence_loop_cond_is_scalar_gte(
        ir_bytes, function_name, cond_node, scalar_var, bs
    )) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 3, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    let return_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_value, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, return_value, bs),
        value_var
    ) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 3 {
        return false;
    }
    let value_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 2, bs
    );
    if !(try value_cursor_latch_is_try_call(
        ir_bytes, function_name, value_latch_stmt, value_var, bs
    )) {
        return false;
    }
    let scalar_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    if !(try precedence_loop_scalar_latch_matches(
        ir_bytes, function_name, module_prefix, params_spec, scalar_latch_stmt,
        scalar_var, value_var, bs
    )) {
        return false;
    }
    return try precedence_loop_body_prefix_matches(
        ir_bytes, function_name, body_node, body_count - 2, bs
    );
}

fn lower_precedence_loop_try_call(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirLetTryCallStmt {
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    let success_type = try compiled_mir_types::call_info_error_success_llvm(
        ir_lookup_index, canonical_facts, ir_bytes, &call_info
    );
    var arg_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    let _lowered_args = try lower_try_call_args_with_local_aliases_cached(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        call_node,
        string_counter,
        temp_counter,
        aliases,
        &var arg_insts,
        &var args,
        bs,
        ir_lookup_index,
        canonical_facts,
        call_arg_type_cache
    );
    return compiled_mir::MirLetTryCallStmt {
        name: let_name,
        called_error_union: call_info.return_llvm_type,
        success_type: success_type,
            result_transport: builtin_contract::RuntimeResultTransport::Semantic,
        own_error_union: llvm_return_type,
        call_module_prefix: call_info.module_prefix,
        call_callee_name: call_info.callee_name,
        string_index: string_counter,
        try_index: try_counter,
        arg_insts: arg_insts,
        call_args: args
    };
}

fn lower_precedence_loop_plain_call(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    bind_name: []u8,
    call_node: i64,
    string_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirLetCallStmt {
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return compiled_mir::MirLetCallStmt {
        name: bind_name,
        llvm_type: call_info.return_llvm_type,
        string_index: string_counter,
        call_module_prefix: call_info.module_prefix,
        call_callee_name: call_info.callee_name,
        call_args: args
    };
}

fn lower_precedence_loop(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var empty_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer empty_aliases.deinit();
    let value_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let value_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "name", 0, bs
    );
    let value_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_name_node, bs
    );
    let value_init_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "value", 0, bs
    );
    let value_init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_expr, "value", 0, bs
    );
    let value_init = try lower_precedence_loop_try_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, llvm_return_type, params_spec,
        value_var, value_init_call, 0, 0, 0, &empty_aliases, bs, call_arg_type_cache
    );
    let value_type = value_init.success_type;
    let value_init_string_counter =
        try count_strings_in_insts(&value_init.arg_insts) +
        try compiled_mir_lower_call::count_string_args(&value_init.call_args);
    let value_init_temp_counter = value_init.arg_insts.len();
    let value_init_try_counter = 1;
    let value_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, value_var, value_type
    );
    let value_init_name = try precedence_loop_suffixed_name(
        value_var, "_init", call_arg_type_cache
    );
    var init_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer init_aliases.deinit();
    try init_aliases.append(LocalAliasState {
        source_name: value_var,
        current_name: value_init_name,
        loop_phi_name: ""
    });
    let scalar_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let scalar_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "name", 0, bs
    );
    let scalar_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scalar_name_node, bs
    );
    let scalar_init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "value", 0, bs
    );
    let scalar_init_name = try precedence_loop_suffixed_name(
        scalar_var, "_init", call_arg_type_cache
    );
    let scalar_init = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, value_locals,
        scalar_init_name, scalar_init_call, value_init_string_counter, &init_aliases, bs,
        call_arg_type_cache
    );
    let scalar_type = scalar_init.llvm_type;
    let scalar_init_string_counter =
        value_init_string_counter +
        try compiled_mir_lower_call::count_string_args(&scalar_init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, value_locals, scalar_var, scalar_type
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, loop_locals, cond_node,
        scalar_init_string_counter, value_init_temp_counter, &var cond_insts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var body_string_counter = scalar_init_string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = value_init_temp_counter + cond_insts.len();
    var body_try_counter = value_init_try_counter;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let body_boundary = body_count - 2;
    var body_locals = loop_locals;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_alias_counter = 0;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
                &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                    body_string_counter, body_temp_counter, body_try_counter, body_alias_counter,
                    body_index + 1, &var body_aliases, &var body_stmts, -1, bs, ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
                        body_stmt, body_string_counter, body_temp_counter, body_try_counter,
                        &body_aliases,
                        &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_temp_counter = expr_result.temp_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported precedence-loop body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    let value_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 2, bs
    );
    let value_latch_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_latch_stmt, "value", 0, bs
    );
    let value_latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_latch_expr, "value", 0, bs
    );
    let value_latch = try lower_precedence_loop_try_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
        value_var, value_latch_call, body_string_counter, body_temp_counter, body_try_counter,
        &body_aliases, bs, call_arg_type_cache
    );
    let value_latch_string_counter =
        body_string_counter + try count_strings_in_insts(&value_latch.arg_insts) +
        try compiled_mir_lower_call::count_string_args(&value_latch.call_args);
    let value_next_name = try precedence_loop_suffixed_name(
        value_var, "_next", call_arg_type_cache
    );
    var latch_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer latch_aliases.deinit();
    try latch_aliases.append(LocalAliasState {
        source_name: value_var,
        current_name: value_next_name,
        loop_phi_name: ""
    });
    let scalar_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let scalar_latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_latch_stmt, "value", 0, bs
    );
    let scalar_latch_name = try precedence_loop_suffixed_name(
        scalar_var, "_next", call_arg_type_cache
    );
    let scalar_latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, body_locals,
        scalar_latch_name, scalar_latch_call, value_latch_string_counter, &latch_aliases, bs,
        call_arg_type_cache
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::precedence_loop_stmt(
        value_var, value_type, scalar_var, scalar_type, llvm_return_type,
        value_init, scalar_init, cond_insts, cond_result, body_stmts,
        value_latch, scalar_latch, "ploop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

fn lower_dual_cursor_loop(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    // The value cursor is seeded by copying a prior local/param: its preheader phi value is that
    // source SSA name, so no value-init call is lowered.
    let value_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let value_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "name", 0, bs
    );
    let value_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_name_node, bs
    );
    let value_source_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_init_stmt, "value", 0, bs
    );
    let value_source_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, value_source_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    // The value type comes from the try-call latch's success type, which the copied source shares.
    let value_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 2, bs
    );
    let value_latch_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_latch_stmt, "value", 0, bs
    );
    let value_latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value_latch_expr, "value", 0, bs
    );
    let value_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, value_latch_call, bs, ir_lookup_index
    );
    let value_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, value_var, value_type
    );
    // The scalar cursor is seeded by a plain call that reads the copied value source, so its init
    // call is lowered with the value aliased to that source SSA name.
    let scalar_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let scalar_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "name", 0, bs
    );
    let scalar_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, scalar_name_node, bs
    );
    let scalar_init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_init_stmt, "value", 0, bs
    );
    var init_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer init_aliases.deinit();
    try init_aliases.append(LocalAliasState {
        source_name: value_var,
        current_name: value_source_var,
        loop_phi_name: ""
    });
    let scalar_init_name = try precedence_loop_suffixed_name(
        scalar_var, "_init", call_arg_type_cache
    );
    let scalar_init = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, value_locals,
        scalar_init_name, scalar_init_call, 0, &init_aliases, bs, call_arg_type_cache
    );
    let scalar_type = scalar_init.llvm_type;
    let scalar_init_string_counter =
        try compiled_mir_lower_call::count_string_args(&scalar_init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, value_locals, scalar_var, scalar_type
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, loop_locals, cond_node,
        scalar_init_string_counter, 0, &var cond_insts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var body_string_counter = scalar_init_string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = cond_insts.len();
    var body_try_counter = 0;
    let body_boundary = body_count - 2;
    var body_locals = loop_locals;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_alias_counter = 0;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
                &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            return error("compiled mir: unsupported dual-cursor-loop body statement");
        }
        body_index = body_index + 1;
    }
    let value_latch = try lower_precedence_loop_try_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
        value_var, value_latch_call, body_string_counter, body_temp_counter, body_try_counter,
        &body_aliases, bs, call_arg_type_cache
    );
    let value_latch_string_counter =
        body_string_counter + try count_strings_in_insts(&value_latch.arg_insts) +
        try compiled_mir_lower_call::count_string_args(&value_latch.call_args);
    let value_next_name = try precedence_loop_suffixed_name(
        value_var, "_next", call_arg_type_cache
    );
    var latch_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer latch_aliases.deinit();
    try latch_aliases.append(LocalAliasState {
        source_name: value_var,
        current_name: value_next_name,
        loop_phi_name: ""
    });
    let scalar_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let scalar_latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, scalar_latch_stmt, "value", 0, bs
    );
    let scalar_latch_name = try precedence_loop_suffixed_name(
        scalar_var, "_next", call_arg_type_cache
    );
    let scalar_latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, body_locals,
        scalar_latch_name, scalar_latch_call, value_latch_string_counter, &latch_aliases, bs,
        call_arg_type_cache
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::dual_cursor_loop_stmt(
        value_var, value_type, value_source_var, scalar_var, scalar_type, llvm_return_type,
        scalar_init, cond_insts, cond_result, body_stmts,
        value_latch, scalar_latch, "dcloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// lower_trailing_token_loop lowers the dual Token-cursor advance loop (NEW-3 second half). It seeds
// %<current> through the plain init call, lowers the compound-AND header eagerly, lowers the
// '<current> = <plain>(<current>)' advance latch (the '<previous> = <current>' copy latch needs no
// instruction -- it is the head <previous> phi's back edge), and emits one TrailingTokenLoop MirStmt
// whose renderer opens a fall-through exit block. The post-loop statements (statement 3 onward) lower
// through the same per-statement path the top-level function loop uses and are appended as ordinary
// trailing MirStmts so they render into that open exit block, reading the loop-carried %<previous>
// and %<current> phis. The post statements start their expr-temp window above the header insts so
// %t<n> names never collide with the loop head's condition temps.
fn lower_trailing_token_loop(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var empty_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer empty_aliases.deinit();
    // The current cursor is seeded by a plain call; its preheader phi value is %<current>_init.
    let current_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let current_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, current_init_stmt, "name", 0, bs
    );
    let current_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, current_name_node, bs
    );
    let current_init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, current_init_stmt, "value", 0, bs
    );
    let init_name = try precedence_loop_suffixed_name(
        current_var, "_init", call_arg_type_cache
    );
    let init = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, params_spec,
        init_name, current_init_call, 0, &empty_aliases, bs, call_arg_type_cache
    );
    let token_type = init.llvm_type;
    let init_string_counter = try compiled_mir_lower_call::count_string_args(&init.call_args);
    // The previous cursor is a Var-copy of current; both cursors share the Token type.
    let previous_init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let previous_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, previous_init_stmt, "name", 0, bs
    );
    let previous_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, previous_name_node, bs
    );
    let current_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, current_var, token_type
    );
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, current_locals, previous_var, token_type
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, loop_locals, cond_node,
        init_string_counter, 0, &var cond_insts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let cond_inst_count = cond_insts.len();
    let cond_string_counter = init_string_counter + try count_strings_in_insts(&cond_insts);
    // The advance latch '<current> = <plain>(<current>)' refreshes the cursor as %<current>_next.
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let advance_latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    let advance_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, advance_latch_stmt, "value", 0, bs
    );
    let latch_name = try precedence_loop_suffixed_name(
        current_var, "_next", call_arg_type_cache
    );
    let latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, loop_locals,
        latch_name, advance_call, cond_string_counter, &empty_aliases, bs, call_arg_type_cache
    );
    let latch_string_counter =
        cond_string_counter + try compiled_mir_lower_call::count_string_args(&latch.call_args);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::trailing_token_loop_stmt(
        current_var, previous_var, token_type, init, cond_insts, cond_result, latch, "ttloop"
    ));
    // The post-loop statements render into the loop's fall-through exit block. They read the
    // loop-carried %<previous>/%<current> phis, so lower them with both cursors in scope, and start
    // their expr-temp window past the header insts so %t<n> names never collide.
    var post_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer post_aliases.deinit();
    var post_locals = loop_locals;
    var post_string_counter = latch_string_counter;
    var post_temp_counter = cond_inst_count;
    var post_try_counter = 0;
    var post_alias_counter = 0;
    var post_index = 3;
    while post_index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", post_index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Return") {
            try stmts.append(try lower_multi_return_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, post_locals, statement,
                post_string_counter, post_temp_counter, &post_aliases, bs, ir_lookup_index,
                canonical_facts,
                call_arg_type_cache
            ));
        } else {
            if std::mem::equal_bytes(stmt_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, post_locals, statement,
                    post_string_counter, post_temp_counter, post_try_counter, post_alias_counter,
                    post_index, &var post_aliases, &var stmts, -1, bs, ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                post_temp_counter = if_result.temp_counter;
                post_string_counter = if_result.string_counter;
                post_try_counter = if_result.try_counter;
                post_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(stmt_kind, "Let") {
                    let let_result = try lower_multi_let_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, post_locals,
                        statement, post_string_counter, post_temp_counter, post_try_counter,
                        &var post_aliases, &var stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    post_locals = let_result.locals_spec;
                    post_string_counter = let_result.string_counter;
                    post_temp_counter = let_result.temp_counter;
                    post_try_counter = let_result.try_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                        let expr_result = try lower_multi_expr_statement(
                            ir_bytes, function_name, module_prefix, llvm_return_type, post_locals,
                            statement, post_string_counter, post_temp_counter, post_try_counter,
                            &post_aliases, &var stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                        );
                        post_string_counter = expr_result.string_counter;
                        post_temp_counter = expr_result.temp_counter;
                        post_try_counter = expr_result.try_counter;
                    } else {
                        return error("compiled mir: unsupported trailing-token-loop post statement");
                    }
                }
            }
        }
        post_index = post_index + 1;
    }
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

fn type_apply_loop_bool_true_header(
    ir_bytes: []u8,
    function_name: []u8,
    while_statement: i64,
    bs: i64
) -> !bool {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Bool", bs)) {
        return false;
    }
    return std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, cond_node, bs),
        "true"
    );
}

fn type_apply_loop_let_is_plain_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, value, bs));
}

fn type_apply_loop_assign_is_plain_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs),
        cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, value, bs));
}

fn type_apply_loop_return_is_error_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Return", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "Call", bs)) {
        return false;
    }
    return try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, value, bs);
}

fn type_apply_terminal_let_call_matches(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    stmt_index: i64,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, block_node, "statement", stmt_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    return try node_kind_is(ir_bytes, function_name, value, "Call", bs);
}

fn type_apply_terminal_index_init_matches(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    stmt_index: i64,
    bs: i64
) -> !bool {
    let statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, block_node, "statement", stmt_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, statement, "Let", bs)) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    return try node_kind_is(ir_bytes, function_name, value, "Int", bs);
}

fn type_apply_terminal_if_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "If", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, cond_node, bs) {
        return false;
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count != 7 {
        return false;
    }
    if !(try type_apply_terminal_let_call_matches(ir_bytes, function_name, then_node, 0, bs)) {
        return false;
    }
    if !(try type_apply_terminal_index_init_matches(ir_bytes, function_name, then_node, 1, bs)) {
        return false;
    }
    let child_loop = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, child_loop, "While", bs)) {
        return false;
    }
    if !(try type_apply_terminal_let_call_matches(ir_bytes, function_name, then_node, 3, bs)) {
        return false;
    }
    if !(try type_apply_terminal_let_call_matches(ir_bytes, function_name, then_node, 4, bs)) {
        return false;
    }
    if !(try type_apply_terminal_let_call_matches(ir_bytes, function_name, then_node, 5, bs)) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 6, bs
    );
    return try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs);
}

fn type_apply_error_guard_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "If", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    if !(try value_cursor_cond_is_prefix_not_call(ir_bytes, function_name, cond_node, bs)) {
        return false;
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count != 1 {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    return try type_apply_loop_return_is_error_call(ir_bytes, function_name, return_stmt, bs);
}

// is_type_apply_loop_shape reports whether this function is the parse_type_apply_expr_with_args
// cursor loop: a plain-call Token seed, a bool-literal 'while true' header, a try-call parse let,
// a borrowed-array append, a terminal construction return arm, a comma error guard, a plain-call
// cursor latch, and an unreachable trailing error return. This is orthogonal to the existing
// while-true grammar-postfix shape because that one starts from a Var seed and its body is a
// nested if/else reassignment chain; it also cannot overlap value-cursor/value-array loops, whose
// headers are prefix-not and struct-sentinel comparisons rather than the bool literal.
fn is_type_apply_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try type_apply_loop_let_is_plain_call(ir_bytes, function_name, init_stmt, bs)) {
        return false;
    }
    let cursor_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, cursor_name_node, bs
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    if !(try type_apply_loop_bool_true_header(ir_bytes, function_name, while_statement, bs)) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 5 {
        return false;
    }
    let parse_arg_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !(try precedence_loop_let_is_free_try_call(ir_bytes, function_name, parse_arg_stmt, bs)) {
        return false;
    }
    let append_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    if !(try value_cursor_statement_is_array_append(ir_bytes, function_name, append_stmt, bs)) {
        return false;
    }
    let terminal_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 2, bs
    );
    if !(try type_apply_terminal_if_matches(ir_bytes, function_name, terminal_stmt, bs)) {
        return false;
    }
    let guard_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 3, bs
    );
    if !(try type_apply_error_guard_matches(ir_bytes, function_name, guard_stmt, bs)) {
        return false;
    }
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 4, bs
    );
    if !(try type_apply_loop_assign_is_plain_call(
        ir_bytes, function_name, latch_stmt, cursor_var, bs
    )) {
        return false;
    }
    let trailing_return = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    return try type_apply_loop_return_is_error_call(
        ir_bytes, function_name, trailing_return, bs
    );
}

fn lower_type_apply_nested_counted_while(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    while_statement: i64,
    loop_index: i64,
    induction_var: []u8,
    induction_init: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, locals_spec, cond_node,
        string_counter, temp_counter, &var cond_insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var body_string_counter = string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = temp_counter + cond_insts.len();
    var body_try_counter = try_counter;
    var body_alias_counter = alias_counter;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let latch_count = try while_trailing_increment_count(
        ir_bytes, function_name, body_node, body_count, bs
    );
    let body_boundary = body_count - latch_count;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, aliases,
                &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, body_stmt,
                    body_string_counter, body_temp_counter, body_try_counter, body_alias_counter,
                    loop_index * 1000 + body_index + 1, aliases, &var body_stmts, -1, bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_string_counter = if_result.string_counter;
                body_temp_counter = if_result.temp_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                        body_stmt, body_string_counter, body_temp_counter, body_try_counter,
                        aliases, &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_temp_counter = expr_result.temp_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported type-apply child loop body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    let increment_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let step = try parse_induction_step(ir_bytes, function_name, increment_stmt, induction_var, bs);
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_var,
        induction_init,
        "",
        0,
        "add",
        step,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        "",
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        -1,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        false
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: body_try_counter,
        alias_counter: body_alias_counter
    };
}

fn lower_type_apply_terminal_block(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    then_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    terminal_stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    var terminal_locals = locals_spec;
    var terminal_strings = string_counter;
    var terminal_temps = temp_counter;
    var terminal_tries = try_counter;
    var terminal_alias_counter = alias_counter;
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    var body_index = 0;
    while body_index < then_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_node, "statement", body_index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let next_statement = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, then_node, "statement", body_index + 1, bs
            );
            var is_nested_induction_seed = false;
            if next_statement >= 0 {
                let next_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, next_statement, bs
                );
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "value", 0, bs
                );
                if std::mem::equal_bytes(next_kind, "While") and
                    (try node_kind_is(ir_bytes, function_name, value, "Int", bs)) {
                    is_nested_induction_seed = true;
                }
            }
            if is_nested_induction_seed {
                let name_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "name", 0, bs
                );
                let name = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, name_node, bs
                );
                terminal_locals = try compiled_signature::extend_locals_spec(
                    ir_bytes, terminal_locals, name, "i64"
                );
            } else {
                let let_result = try lower_multi_let_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, terminal_locals,
                    statement, terminal_strings, terminal_temps, terminal_tries, aliases,
                    terminal_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                terminal_locals = let_result.locals_spec;
                terminal_strings = let_result.string_counter;
                terminal_temps = let_result.temp_counter;
                terminal_tries = let_result.try_counter;
            }
        } else {
            if std::mem::equal_bytes(stmt_kind, "While") {
                let init_stmt = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, then_node, "statement", body_index - 1, bs
                );
                let name_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, init_stmt, "name", 0, bs
                );
                let induction_var = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, name_node, bs
                );
                let init_value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, init_stmt, "value", 0, bs
                );
                let init_literal = try ir_contract::body_int_value_from(
                    ir_bytes, function_name, init_value, bs
                );
                let while_result = try lower_type_apply_nested_counted_while(
                    ir_bytes, function_name, module_prefix, llvm_return_type, terminal_locals,
                    statement, 7000 + body_index, induction_var, init_literal, terminal_strings,
                    terminal_temps, terminal_tries, terminal_alias_counter, aliases,
                    terminal_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                terminal_strings = while_result.string_counter;
                terminal_temps = while_result.temp_counter;
                terminal_tries = while_result.try_counter;
                terminal_alias_counter = while_result.alias_counter;
            } else {
                if std::mem::equal_bytes(stmt_kind, "Return") {
                    try terminal_stmts.append(try lower_multi_return_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, terminal_locals,
                        statement, terminal_strings, terminal_temps, aliases, bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    ));
                    let ret_stmt = try terminal_stmts.at(terminal_stmts.len() - 1);
                    let advance = try continue_latch_return_advance(
                        &ret_stmt, terminal_temps, terminal_strings
                    );
                    terminal_strings = advance.string_counter;
                    terminal_temps = advance.temp_counter;
                } else {
                    return error("compiled mir: unsupported type-apply terminal statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    return MultiIfLowerResult {
        temp_counter: terminal_temps,
        string_counter: terminal_strings,
        try_counter: terminal_tries,
        alias_counter: terminal_alias_counter
    };
}

fn lower_type_apply_loop(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var empty_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer empty_aliases.deinit();
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let cursor_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, cursor_name_node, bs
    );
    let init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_name = try precedence_loop_suffixed_name(
        cursor_var, "_init", call_arg_type_cache
    );
    let init = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, params_spec,
        init_name, init_call, 0, &empty_aliases, bs, call_arg_type_cache
    );
    let cursor_type = init.llvm_type;
    let init_string_counter = try compiled_mir_lower_call::count_string_args(&init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, cursor_var, cursor_type
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let parse_arg_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    let arg_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, parse_arg_stmt, "name", 0, bs
    );
    let arg_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, arg_name_node, bs
    );
    let parse_arg_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, parse_arg_stmt, "value", 0, bs
    );
    let parse_arg_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, parse_arg_expr, "value", 0, bs
    );
    let parse_arg = try lower_precedence_loop_try_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, llvm_return_type, loop_locals,
        arg_var, parse_arg_call, init_string_counter, 0, 0, &empty_aliases, bs,
        call_arg_type_cache
    );
    let arg_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, loop_locals, arg_var, parse_arg.success_type
    );
    var body_string_counter =
        init_string_counter + try count_strings_in_insts(&parse_arg.arg_insts) +
        try compiled_mir_lower_call::count_string_args(&parse_arg.call_args);
    var body_temp_counter = parse_arg.arg_insts.len();
    var body_try_counter = 1;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    let append_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    let append_result = try lower_multi_expr_statement(
        ir_bytes, function_name, module_prefix, llvm_return_type, arg_locals, append_stmt,
        body_string_counter, body_temp_counter, body_try_counter, &body_aliases,
        &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    body_string_counter = append_result.string_counter;
    body_try_counter = append_result.try_counter;
    let terminal_if = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 2, bs
    );
    let terminal_cond = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "condition", 0, bs
    );
    var terminal_cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let terminal_cond_result = try lower_expr_with_local_aliases(
        ir_bytes, function_name, module_prefix, arg_locals, terminal_cond,
        body_string_counter, body_temp_counter, &var terminal_cond_insts, &body_aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let terminal_string_counter =
        body_string_counter + try count_strings_in_insts(&terminal_cond_insts);
    let terminal_temp_counter = body_temp_counter + terminal_cond_insts.len();
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "then", 0, bs
    );
    var terminal_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var terminal_aliases = try copy_local_aliases(&body_aliases);
    defer terminal_aliases.deinit();
    let terminal_result = try lower_type_apply_terminal_block(
        ir_bytes, function_name, module_prefix, llvm_return_type, arg_locals, then_node,
        terminal_string_counter, terminal_temp_counter, body_try_counter, 0,
        &var terminal_aliases, &var terminal_stmts, bs, ir_lookup_index,
        canonical_facts,
        call_arg_type_cache
    );
    var guard_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var guard_aliases = try copy_local_aliases(&body_aliases);
    defer guard_aliases.deinit();
    let guard_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 3, bs
    );
    let guard_result = try lower_multi_if_statement(
        ir_bytes, function_name, module_prefix, llvm_return_type, arg_locals, guard_stmt,
        terminal_result.string_counter, terminal_result.temp_counter,
        terminal_result.try_counter, terminal_result.alias_counter, 6000,
        &var guard_aliases, &var guard_stmts, -1, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 4, bs
    );
    let latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_stmt, "value", 0, bs
    );
    let latch_name = try precedence_loop_suffixed_name(
        cursor_var, "_next", call_arg_type_cache
    );
    let latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, arg_locals,
        latch_name, latch_call, guard_result.string_counter, &guard_aliases, bs,
        call_arg_type_cache
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::type_apply_loop_stmt(
        cursor_var, cursor_type, llvm_return_type, init, parse_arg, body_stmts,
        terminal_cond_insts, terminal_cond_result, terminal_stmts, guard_stmts,
        latch, "taloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// while_match_arm_body_or_minus_one returns the single statement node of a match arm body,
// unwrapping a one-statement Block, or -1 if the arm body holds more than one statement.
fn while_match_arm_body_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    arm_node: i64,
    bs: i64
) -> !i64 {
    let body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arm_node, "body", 0, bs
    );
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body, bs);
    if std::mem::equal_bytes(body_kind, "Block") {
        let extra = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, body, "statement", 1, bs
        );
        if extra >= 0 {
            return 0 - 1;
        }
        return try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body, "statement", 0, bs
        );
    }
    return body;
}

// while_match_body_is_cursor_try_latch reports whether a match-arm body statement is a cursor
// latch '<cursor> = try <free-call>(..)': an Assign whose target is the loop cursor Var and whose
// value is a TryExpr wrapping a non-field (free) Call.
fn while_match_body_is_cursor_try_latch(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "Assign", bs)) {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", bs)) {
        return false;
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs),
        cursor_var
    ) {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", bs)) {
        return false;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", bs)) {
        return false;
    }
    return !(try callee_is_field_expr(ir_bytes, function_name, inner, bs));
}

// while_match_arms_are_supported validates the match dispatch arms: at least two arms, exactly one
// cursor-latch arm, every other arm a single 'return', and the final (exhaustive fallthrough) arm a
// return arm rather than the latch. This keeps the latch off the unconditional fallthrough block so
// it always reaches the loop head through an explicit icmp.
fn while_match_arms_are_supported(
    ir_bytes: []u8,
    function_name: []u8,
    match_stmt: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_stmt, "arm", bs
    );
    if arm_count < 2 {
        return false;
    }
    var latch_count = 0;
    var index = 0;
    while index < arm_count {
        let arm_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_stmt, "arm", index, bs
        );
        let body = try while_match_arm_body_or_minus_one(ir_bytes, function_name, arm_node, bs);
        if body < 0 {
            return false;
        }
        if try while_match_body_is_cursor_try_latch(ir_bytes, function_name, body, cursor_var, bs) {
            if index == arm_count - 1 {
                return false;
            }
            latch_count = latch_count + 1;
        } else {
            if !(try node_kind_is(ir_bytes, function_name, body, "Return", bs)) {
                return false;
            }
        }
        index = index + 1;
    }
    return latch_count == 1;
}

// is_while_match_loop_shape reports whether this function is parse_generic_type_end's 'while true'
// + match-dispatch loop: a plain-call Token seed, a bool-literal 'while true' header, a body of
// [free try-call let, plain-call let, match <token>.kind { .. }] whose match latches the cursor in
// one arm and returns from every other, and a trailing error-call return. It reuses the type-apply
// loop's plain-call-let / bool-true-header / error-return detectors; the discriminator is the
// 3-statement body ending in a Match (the type-apply loop ends in parse/append/if/guard/latch),
// so the two never overlap, and the cursor-reassigning latch arm distinguishes it from the bare
// EnumDispatch shape (whose nonterminal arms are side-effecting expression statements).
fn is_while_match_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count != 3 {
        return false;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    if !(try type_apply_loop_let_is_plain_call(ir_bytes, function_name, init_stmt, bs)) {
        return false;
    }
    let cursor_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, cursor_name_node, bs
    );
    if std::mem::len(cursor_var) == 0 {
        return false;
    }
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    if !(try type_apply_loop_bool_true_header(ir_bytes, function_name, while_statement, bs)) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count != 3 {
        return false;
    }
    let parse_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    if !(try precedence_loop_let_is_free_try_call(ir_bytes, function_name, parse_stmt, bs)) {
        return false;
    }
    let next_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 1, bs
    );
    if !(try type_apply_loop_let_is_plain_call(ir_bytes, function_name, next_stmt, bs)) {
        return false;
    }
    let match_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 2, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, match_stmt, "Match", bs)) {
        return false;
    }
    if !(try while_match_arms_are_supported(
        ir_bytes, function_name, match_stmt, cursor_var, bs
    )) {
        return false;
    }
    let trailing_return = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 2, bs
    );
    return try type_apply_loop_return_is_error_call(
        ir_bytes, function_name, trailing_return, bs
    );
}

fn lower_while_match_loop(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var empty_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer empty_aliases.deinit();
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 0, bs
    );
    let cursor_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, cursor_name_node, bs
    );
    let init_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_name = try precedence_loop_suffixed_name(
        cursor_var, "_init", call_arg_type_cache
    );
    let init = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, params_spec,
        init_name, init_call, 0, &empty_aliases, bs, call_arg_type_cache
    );
    let cursor_type = init.llvm_type;
    let init_string_counter = try compiled_mir_lower_call::count_string_args(&init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, params_spec, cursor_var, cursor_type
    );
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", 1, bs
    );
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    // Lower the two prefix lets through the generic per-statement path, threading body_locals so
    // the match scrutinee 'next.kind' and the latch call arguments resolve their struct types.
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_locals = loop_locals;
    var body_string_counter = init_string_counter;
    var body_temp_counter = 0;
    var body_try_counter = 0;
    var prefix_index = 0;
    while prefix_index < 2 {
        let prefix_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", prefix_index, bs
        );
        let let_result = try lower_multi_let_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, prefix_stmt,
            body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
            &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        body_locals = let_result.locals_spec;
        body_string_counter = let_result.string_counter;
        body_temp_counter = let_result.temp_counter;
        body_try_counter = let_result.try_counter;
        prefix_index = prefix_index + 1;
    }
    let match_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 2, bs
    );
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_stmt, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, scrutinee, bs
    );
    let enum_kizu = try resolve_dispatch_enum_kizu_type(
        ir_bytes, function_name, module_prefix, body_locals, scrutinee, scrutinee_kind, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var scrutinee_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let scrutinee_result_id = try lower_expr_into(
        ir_bytes, function_name, module_prefix, body_locals, scrutinee,
        body_string_counter, body_temp_counter, &var scrutinee_insts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let arm_temp_base = body_temp_counter + scrutinee_insts.len();
    let arm_string_base = body_string_counter + try count_strings_in_insts(&scrutinee_insts);
    let arm_ssa_stride = 1000;
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, match_stmt, "arm", bs
    );
    // Locate the single cursor-latch arm and build its try-call latch (binding %<cursor>_next at
    // the next free try index after the body try-calls).
    var latch_arm_index = 0 - 1;
    var scan_index = 0;
    while scan_index < arm_count {
        let scan_arm = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_stmt, "arm", scan_index, bs
        );
        let scan_body = try while_match_arm_body_or_minus_one(
            ir_bytes, function_name, scan_arm, bs
        );
        if scan_body >= 0 and (try while_match_body_is_cursor_try_latch(
            ir_bytes, function_name, scan_body, cursor_var, bs
        )) {
            latch_arm_index = scan_index;
        }
        scan_index = scan_index + 1;
    }
    if latch_arm_index < 0 {
        return error("compiled mir: while-match loop requires a cursor latch arm");
    }
    let latch_arm_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, match_stmt, "arm", latch_arm_index, bs
    );
    let latch_body = try while_match_arm_body_or_minus_one(
        ir_bytes, function_name, latch_arm_node, bs
    );
    let latch_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_body, "value", 0, bs
    );
    let latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_value, "value", 0, bs
    );
    let latch = try lower_precedence_loop_try_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
        cursor_var, latch_call, arm_string_base + latch_arm_index * arm_ssa_stride,
        arm_temp_base + latch_arm_index * arm_ssa_stride, body_try_counter, &body_aliases, bs,
        call_arg_type_cache
    );
    // Build the arms: the latch arm carries no statements (the shared latch renders it); every
    // other arm lowers its 'return <expr>' off a private SSA window.
    var arms = std::array::Array<compiled_mir::MirWhileMatchArm>(std::mem::page_allocator());
    var arm_index = 0;
    while arm_index < arm_count {
        let arm_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, match_stmt, "arm", arm_index, bs
        );
        let pattern = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_node, "pattern", 0, bs
        );
        let variant_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, pattern, bs
        );
        let is_default = std::mem::equal_bytes(variant_name, "_");
        var tag = 0 - 1;
        if !is_default {
            tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
                ir_lookup_index, ir_bytes, ir_bytes[0..0], enum_kizu, variant_name
            );
        }
        var arm_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
        if arm_index == latch_arm_index {
            try arms.append(compiled_mir::while_match_arm(tag, is_default, true, arm_stmts));
        } else {
            let body = try while_match_arm_body_or_minus_one(
                ir_bytes, function_name, arm_node, bs
            );
            let arm_temp = arm_temp_base + arm_index * arm_ssa_stride;
            let arm_string = arm_string_base + arm_index * arm_ssa_stride;
            let return_stmt = try lower_multi_return_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body,
                arm_string, arm_temp, &body_aliases, bs, ir_lookup_index,
                canonical_facts,
                call_arg_type_cache
            );
            try arm_stmts.append(return_stmt);
            try arms.append(compiled_mir::while_match_arm(tag, is_default, false, arm_stmts));
        }
        arm_index = arm_index + 1;
    }
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try stmts.append(compiled_mir::while_match_loop_stmt(
        cursor_var, cursor_type, llvm_return_type, init, body_stmts, scrutinee_insts,
        scrutinee_result_id, arms, latch, "wmloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// guarded_cursor_terminal_if_matches reports whether a body's terminal statement is the if/else
// latch the guarded-cursor loop requires: a plain bool-predicate-call condition, a then arm of
// exactly one '<cursor> = <plain call>(..)' latch Assign, and an else arm whose last statement is a
// Return. The plain-call latch (rather than the value-cursor loop's terminal try-call Assign) and
// the returning else arm (rather than the type-apply / while-match loops' bool-literal headers) keep
// this shape disjoint from those.
fn guarded_cursor_terminal_if_matches(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    cursor_var: []u8,
    bs: i64
) -> !bool {
    if !(try node_kind_is(ir_bytes, function_name, statement, "If", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, cond_node, "Call", bs)) {
        return false;
    }
    if try callee_is_field_expr(ir_bytes, function_name, cond_node, bs) {
        return false;
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count != 1 {
        return false;
    }
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    if !(try type_apply_loop_assign_is_plain_call(
        ir_bytes, function_name, latch_stmt, cursor_var, bs
    )) {
        return false;
    }
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, statement, "else", 0, bs
    );
    if else_node < 0 {
        return false;
    }
    let else_count = try while_body_statement_count(ir_bytes, function_name, else_node, bs);
    if else_count < 1 {
        return false;
    }
    let last_else = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, else_node, "statement", else_count - 1, bs
    );
    return try node_kind_is(ir_bytes, function_name, last_else, "Return", bs);
}

// is_guarded_cursor_return_loop_shape reports whether this multi-statement function is the
// guarded-cursor loop (parse_type_params' '<T, U>' walk): zero or more plain prefix lets, a
// plain-call cursor seed, a prefix-not predicate 'while' header, and a trailing return, whose loop
// body ends in the if/else latch guarded_cursor_terminal_if_matches accepts. The prefix-not header
// (giving a normal exit) plus the terminal-if plain-call latch keep it disjoint from the value-cursor
// append loop (an unconditional terminal try-call latch and a bare cursor return), the type-apply /
// while-match loops (a bool-literal 'while true' header) and the i64-induction While (whose body ends
// in an arithmetic increment). lower_guarded_cursor_return_loop re-walks and commits on a true result.
fn is_guarded_cursor_return_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if statement_count < 3 {
        return false;
    }
    let while_index = statement_count - 2;
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, while_statement, "While", bs)) {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    if !(try value_cursor_cond_is_prefix_not_call(ir_bytes, function_name, cond_node, bs)) {
        return false;
    }
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", statement_count - 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, return_stmt, "Return", bs)) {
        return false;
    }
    let seed_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index - 1, bs
    );
    if !(try type_apply_loop_let_is_plain_call(ir_bytes, function_name, seed_stmt, bs)) {
        return false;
    }
    let seed_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, seed_name_node, bs
    );
    if std::mem::len(cursor_var) == 0 {
        return false;
    }
    var prefix_index = 0;
    while prefix_index < while_index - 1 {
        let prefix_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", prefix_index, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, prefix_stmt, "Let", bs)) {
            return false;
        }
        prefix_index = prefix_index + 1;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        return false;
    }
    let terminal_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    return try guarded_cursor_terminal_if_matches(
        ir_bytes, function_name, terminal_stmt, cursor_var, bs
    );
}

// lower_guarded_cursor_return_loop lowers the guarded-cursor loop into a head/body/latch/else/exit
// CFG behind a single MirGuardedCursorLoop statement. The pre-cursor lets emit as ordinary top-level
// statements ahead of the loop (so their values stay available to the return arms); the cursor seed
// becomes the plain-call init (%<cursor>_init); the header predicate, body statements, terminal
// condition, plain-call latch, else return arm and trailing exit return all lower through the same
// per-statement machinery the top level uses, with the carried cursor read from the loop-head phi.
// The two return arms take string-index windows 1000 apart so their struct-result SSA names never
// collide. Every type is derived from the IR; no callee, field, or function name is hardcoded.
fn lower_guarded_cursor_return_loop(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var top_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer top_aliases.deinit();
    var locals_spec = params_spec;
    var string_counter = 0;
    var temp_counter = 0;
    var try_counter = 0;

    let while_index = statement_count - 2;
    // Emit the pre-cursor lets (e.g. 'let start = begin_children()') ahead of the loop.
    var prefix_index = 0;
    while prefix_index < while_index - 1 {
        let prefix_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", prefix_index, bs
        );
        let prefix_result = try lower_multi_let_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, prefix_stmt,
            string_counter, temp_counter, try_counter, &var top_aliases, &var stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        locals_spec = prefix_result.locals_spec;
        string_counter = prefix_result.string_counter;
        temp_counter = prefix_result.temp_counter;
        try_counter = prefix_result.try_counter;
        prefix_index = prefix_index + 1;
    }

    // Cursor seed: lowered as the preheader plain-call init bound to %<cursor>_init.
    let seed_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index - 1, bs
    );
    let seed_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "name", 0, bs
    );
    let cursor_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, seed_name_node, bs
    );
    let seed_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "value", 0, bs
    );
    let init_name = try precedence_loop_suffixed_name(
        cursor_var, "_init", call_arg_type_cache
    );
    let init = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, locals_spec,
        init_name, seed_call, string_counter, &top_aliases, bs, call_arg_type_cache
    );
    let cursor_type = init.llvm_type;
    string_counter = string_counter +
        try compiled_mir_lower_call::count_string_args(&init.call_args);
    let loop_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, cursor_var, cursor_type
    );

    // Header predicate: the prefix-not call, read off the loop-head cursor phi.
    let while_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", while_index, bs
    );
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_with_local_aliases(
        ir_bytes, function_name, module_prefix, loop_locals, cond_node,
        string_counter, temp_counter, &var cond_insts, &body_aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    string_counter = string_counter + try count_strings_in_insts(&cond_insts);
    temp_counter = temp_counter + cond_insts.len();

    // Body statements before the terminal if.
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_locals = loop_locals;
    var body_index = 0;
    while body_index < body_count - 1 {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                string_counter, temp_counter, try_counter, &var body_aliases, &var body_stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            string_counter = let_result.string_counter;
            temp_counter = let_result.temp_counter;
            try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "ExprStmt") {
                let expr_result = try lower_multi_expr_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                    string_counter, temp_counter, try_counter, &body_aliases, &var body_stmts, bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                string_counter = expr_result.string_counter;
                temp_counter = expr_result.temp_counter;
                try_counter = expr_result.try_counter;
            } else {
                return error("compiled mir: unsupported guarded-cursor body statement");
            }
        }
        body_index = body_index + 1;
    }

    // Terminal if: condition, plain-call latch (then arm), and else return arm.
    let terminal_if = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let terminal_cond = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "condition", 0, bs
    );
    var terminal_cond_insts =
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let terminal_cond_result = try lower_expr_with_local_aliases(
        ir_bytes, function_name, module_prefix, body_locals, terminal_cond,
        string_counter, temp_counter, &var terminal_cond_insts, &body_aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    string_counter = string_counter + try count_strings_in_insts(&terminal_cond_insts);
    temp_counter = temp_counter + terminal_cond_insts.len();

    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "then", 0, bs
    );
    let latch_assign = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let latch_call = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_assign, "value", 0, bs
    );
    let latch_name = try precedence_loop_suffixed_name(
        cursor_var, "_next", call_arg_type_cache
    );
    let latch = try lower_precedence_loop_plain_call(
        ir_lookup_index, canonical_facts, ir_bytes, function_name, module_prefix, body_locals,
        latch_name, latch_call, string_counter, &body_aliases, bs, call_arg_type_cache
    );
    string_counter = string_counter +
        try compiled_mir_lower_call::count_string_args(&latch.call_args);

    // Else arm: lets followed by a terminal return, reading the body locals.
    let else_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "else", 0, bs
    );
    let else_count = try while_body_statement_count(ir_bytes, function_name, else_node, bs);
    var else_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var else_locals = body_locals;
    var else_aliases = try copy_local_aliases(&body_aliases);
    defer else_aliases.deinit();
    var else_index = 0;
    while else_index < else_count {
        let else_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, else_node, "statement", else_index, bs
        );
        let else_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, else_stmt, bs);
        if std::mem::equal_bytes(else_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, else_locals, else_stmt,
                string_counter, temp_counter, try_counter, &var else_aliases, &var else_stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            else_locals = let_result.locals_spec;
            string_counter = let_result.string_counter;
            temp_counter = let_result.temp_counter;
            try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(else_kind, "Return") {
                try else_stmts.append(try lower_multi_return_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, else_locals, else_stmt,
                    string_counter, temp_counter, &else_aliases, bs, ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                ));
            } else {
                return error("compiled mir: unsupported guarded-cursor else statement");
            }
        }
        else_index = else_index + 1;
    }

    // Normal exit: the trailing return reads the loop-head cursor phi (and the pre-cursor lets). It
    // takes a string-index window 1000 past the else arm so the two struct-result returns never
    // collide on '%v<index>_*' names.
    let return_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", statement_count - 1, bs
    );
    var exit_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    try exit_stmts.append(try lower_multi_return_statement(
        ir_bytes, function_name, module_prefix, llvm_return_type, loop_locals, return_stmt,
        string_counter + 1000, temp_counter + 1000, &top_aliases, bs, ir_lookup_index,
        canonical_facts,
        call_arg_type_cache
    ));

    try stmts.append(compiled_mir::guarded_cursor_loop_stmt(
        cursor_var, cursor_type, llvm_return_type, init, cond_insts, cond_result, body_stmts,
        terminal_cond_insts, terminal_cond_result, latch, else_stmts, exit_stmts, "gcloop"
    ));
    return compiled_mir_function::multi_statement_function(
        llvm_symbol, llvm_return_type, params_spec, stmts
    );
}

// value_cursor_previous_init_name_or_empty generalizes the value-cursor preheader-seed lookup to
// admit a plain Var-copy init in addition to a preceding call. The statement before the while binds
// the cursor either by 'let <cursor> = <Call>' (the parse_block_with_statements 'next_token' seed) or
// by 'var <cursor> = <Var>' (parse_program_with_declarations' 'var token = first', a copy of a
// parameter). Both are elided from emission by the induction-init scan when the loop's field-read
// latch carries the same name, so the cursor is carried purely by the loop-head phi; returning the
// bound name lets the embedded detector/lowerer recognize the cursor for either seed kind.
fn value_cursor_previous_init_name_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_index: i64,
    bs: i64
) -> ![]u8 {
    if stmt_index == 0 {
        return ir_bytes[0..0];
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", stmt_index - 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return ir_bytes[0..0];
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    let init_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, init_value, bs
    );
    if !std::mem::equal_bytes(init_value_kind, "Call") and
        !std::mem::equal_bytes(init_value_kind, "Var") {
        return ir_bytes[0..0];
    }
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "name", 0, bs
    );
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
}

// value_cursor_previous_copy_source_or_empty returns the source variable a Var-copy cursor init
// ('var <cursor> = <source>') copies from, or empty when the preceding init is a call seed. The
// embedded lowerer seeds the loop-head phi from %<source> on the entry edge (the copy itself is
// elided by the induction-init scan, so %<cursor> is never materialized before the loop), matching
// how the whole-function value-cursor lowerer threads its 'var close = first' copy seed.
fn value_cursor_previous_copy_source_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_index: i64,
    bs: i64
) -> ![]u8 {
    if stmt_index == 0 {
        return ir_bytes[0..0];
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", stmt_index - 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return ir_bytes[0..0];
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_value, "Var", bs)) {
        return ir_bytes[0..0];
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, init_value, bs);
}

// value_cursor_previous_call_node_or_minus_one returns the Call value node of a plain-call cursor
// init ('var <cursor> = next_token(text, token)') preceding the embedded value-cursor while, or -1
// when the preceding init is absent or a Var-copy seed. The embedded lowerer materializes this call
// in the loop preheader as %<cursor>_init and seeds the loop-head phi from it, replacing the
// degenerate self-referential phi seed that an elided call init would otherwise leave behind.
fn value_cursor_previous_call_node_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_index: i64,
    bs: i64
) -> !i64 {
    if stmt_index == 0 {
        return -1;
    }
    let init_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", stmt_index - 1, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_stmt, "Let", bs)) {
        return -1;
    }
    let init_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_stmt, "value", 0, bs
    );
    if !(try node_kind_is(ir_bytes, function_name, init_value, "Call", bs)) {
        return -1;
    }
    return init_value;
}

// value_cursor_pre_latch_is_guard_scan reports whether every body statement before the value-cursor
// latch is a guard 'if' (a sentinel early-exit such as 'if is_eof_token(current) { return error(..) }').
// A scan loop advances its cursor to a sentinel without accumulating into an array or a sink call, so
// it carries no append / void-call accumulation step; the predicate-call header, cursor seed, and
// value-cursor latch already pin it as a value-cursor loop, and the guard ifs lower through the same
// generic body-statement path the accumulation loops use (parse_skipped_top_level_block's brace scan).
fn value_cursor_pre_latch_is_guard_scan(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_count: i64,
    bs: i64
) -> !bool {
    if body_count < 2 {
        return false;
    }
    var body_index = 0;
    while body_index < body_count - 1 {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if !(try node_kind_is(ir_bytes, function_name, body_stmt, "If", bs)) {
            return false;
        }
        body_index = body_index + 1;
    }
    return true;
}
fn is_embedded_value_cursor_append_loop_shape(
    ir_bytes: []u8,
    function_name: []u8,
    stmt_index: i64,
    while_statement: i64,
    bs: i64
) -> !bool {
    let cursor_var = try value_cursor_previous_init_name_or_empty(
        ir_bytes, function_name, stmt_index, bs
    );
    if std::mem::len(cursor_var) == 0 {
        return false;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    // The header is either the prefix-not bool-predicate call ('while !is_at_end(token)') or a bare
    // bool-predicate call ('while is_double_colon(token)', parse_import_segments); both carry the
    // cursor and lower through the generic condition path.
    if !(try value_cursor_cond_is_prefix_not_call(ir_bytes, function_name, cond_node, bs)) and
        !(try value_cursor_cond_is_plain_call(ir_bytes, function_name, cond_node, bs)) {
        return false;
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return false;
    }
    if !(try value_cursor_latch_is_supported(
        ir_bytes, function_name, body_node, body_count - 1, cursor_var, bs
    )) {
        return false;
    }
    // The accumulation step is either a 'try <arr>.append(x)' array push or a non-array
    // 'try <free-fn>(.. <body-local> ..)' void try-call that consumes a prior body-local
    // (parse_import_segments: 'try add_name_child(ast, segment)'). Either marks this as the
    // value-cursor loop rather than a generic While; the latch already pinned the carried cursor.
    var body_index = 0;
    while body_index < body_count - 1 {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        if try value_cursor_statement_is_array_append(ir_bytes, function_name, body_stmt, bs) {
            return true;
        }
        if try value_cursor_statement_is_local_void_call(
            ir_bytes, function_name, body_node, body_index, bs
        ) {
            return true;
        }
        body_index = body_index + 1;
    }
    // No append / void-call accumulation: a sentinel scan loop whose pre-latch body is only guard
    // ifs is still a value-cursor loop (parse_skipped_top_level_block scans tokens to the opening
    // brace, advancing the cursor with no accumulation), so accept it through the guard-scan path.
    return try value_cursor_pre_latch_is_guard_scan(
        ir_bytes, function_name, body_node, body_count, bs
    );
}

fn lower_embedded_value_cursor_append_loop(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    while_statement: i64,
    stmt_index: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let cursor_var = try value_cursor_previous_init_name_or_empty(
        ir_bytes, function_name, stmt_index, bs
    );
    // A Var-copy init ('var token = first') is elided by the induction-init scan, so the loop-head
    // phi seeds from the copy's source (%first) on the entry edge -- %<cursor> is never materialized
    // before the loop. A plain-call init ('var current = next_token(text, token)') is also elided,
    // but its copied value has no prior SSA name, so it is materialized in the loop preheader as
    // %<cursor>_init and the phi seeds from that concrete value, replacing the degenerate %<cursor>
    // self-reference on the entry edge (an undef cursor cycle the optimizer's GVN can crash on).
    let copy_source = try value_cursor_previous_copy_source_or_empty(
        ir_bytes, function_name, stmt_index, bs
    );
    var seed_name = cursor_var;
    var seed_string_base = string_counter;
    var init_call_module_prefix = ir_bytes[0..0];
    var init_call_callee_name = ir_bytes[0..0];
    var init_call_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    if std::mem::len(copy_source) > 0 {
        seed_name = copy_source;
    } else {
        let init_call_node = try value_cursor_previous_call_node_or_minus_one(
            ir_bytes, function_name, stmt_index, bs
        );
        if init_call_node >= 0 {
            seed_name = try precedence_loop_suffixed_name(
                cursor_var, "_init", call_arg_type_cache
            );
            let init_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
                ir_lookup_index, canonical_facts, ir_bytes,
                function_name, module_prefix, init_call_node, bs, call_arg_type_cache
            );
            init_call_module_prefix = init_info.module_prefix;
            init_call_callee_name = init_info.callee_name;
            let init_args = try compiled_mir_lower_call::lower_call_args_canonical(
                ir_bytes, function_name, module_prefix, locals_spec, init_call_node,
                string_counter, bs, ir_lookup_index, canonical_facts,
                &init_info.types, call_arg_type_cache
            );
            seed_string_base = string_counter +
                try compiled_mir_lower_call::count_string_args(&init_args);
            init_call_args = init_args;
        }
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "condition", 0, bs
    );
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes, function_name, module_prefix, locals_spec, cond_node,
        seed_string_base, temp_counter, &var cond_insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var body_string_counter = seed_string_base + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = temp_counter + cond_insts.len();
    var body_try_counter = try_counter;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let body_boundary = body_count - 1;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_alias_counter = 0;
    // Body-local lets ('let statement = try parse_statement(...)') must be tracked so later body
    // statements and the loop latch resolve their struct types; the outer locals_spec lacks them.
    // Threading body_locals keeps 'statement.next' resolvable instead of mis-resolving the receiver
    // to NodeId (issue 1157 NEW-1 field-read latch).
    var body_locals = locals_spec;
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                body_string_counter, body_temp_counter, body_try_counter, &var body_aliases,
                &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                // Embedded loops can sit after top-level if statements, whose rendered labels are
                // numbered by their own statement index. Encode the body-if index as
                // stmt_index * 1000 + body_index + 1 (mirroring the i64-induction While body-if
                // encoding) so a body 'if' never reuses a preceding top-level if's ifN_then /
                // ifN_cont labels. stmt_index >= 1 for an embedded loop (it follows its cursor
                // init), so the encoded index clears the top-level statement-index range.
                let if_result = try lower_multi_if_statement(
                    ir_bytes, function_name, module_prefix, llvm_return_type, body_locals, body_stmt,
                    body_string_counter, body_temp_counter, body_try_counter, body_alias_counter,
                    stmt_index * 1000 + body_index + 1, &var body_aliases, &var body_stmts, -1, bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes, function_name, module_prefix, llvm_return_type, body_locals,
                        body_stmt, body_string_counter, body_temp_counter, body_try_counter,
                        &body_aliases,
                        &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_temp_counter = expr_result.temp_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    return error("compiled mir: unsupported embedded append-while body statement");
                }
            }
        }
        body_index = body_index + 1;
    }
    let latch_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let latch_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, latch_stmt, "value", 0, bs
    );
    let latch_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, latch_value, bs
    );
    var cursor_type = "";
    var result_string_counter = body_string_counter;
    var result_temp_counter = body_temp_counter;
    var result_try_counter = body_try_counter;
    var latch = compiled_mir::value_cursor_field_read_latch(
        cursor_var,
        body_string_counter,
        0,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator())
    );
    if std::mem::equal_bytes(latch_value_kind, "TryExpr") {
        let latch_call = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, latch_value, "value", 0, bs
        );
        let latch_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, latch_call, bs, call_arg_type_cache
        );
        cursor_type = try compiled_mir_types::call_info_error_success_llvm(
            ir_lookup_index, canonical_facts, ir_bytes, &latch_info
        );
        let latch_args = try compiled_mir_lower_call::lower_call_args_canonical(
            ir_bytes, function_name, module_prefix, body_locals, latch_call, body_string_counter, bs,
            ir_lookup_index, canonical_facts, &latch_info.types,
            call_arg_type_cache
        );
        let latch_arg_strings = try compiled_mir_lower_call::count_string_args(&latch_args);
        latch = compiled_mir::value_cursor_try_call_latch(
            cursor_var,
            latch_info.return_llvm_type,
            cursor_type,
            llvm_return_type,
            latch_info.module_prefix,
            latch_info.callee_name,
            body_string_counter,
            body_try_counter,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            latch_args
        );
        result_string_counter = body_string_counter + latch_arg_strings;
        result_try_counter = body_try_counter + 1;
    } else {
        if std::mem::equal_bytes(latch_value_kind, "FieldExpr") {
            let receiver = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, latch_value, "receiver", 0, bs
            );
            let receiver_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, receiver, bs
            );
            if !std::mem::equal_bytes(receiver_kind, "Var") {
                return error("compiled mir: value-cursor field latch receiver must be a local var");
            }
            let receiver_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, receiver, bs
            );
            // Read the receiver through its current local-alias name, not its source spelling. When
            // the body reassigns the receiver inside an if/else (parse_impl_decl: 'method' is
            // reseated in both arms), the body-if lowering merges the branch values into a
            // %void.then.alias.N load and rebinds 'method' to that alias. The latch must extract its
            // field from that merged value; using the source name would read the receiver's loop-top
            // let-init instead, so the carried cursor would never advance and the loop would spin
            // forever. An un-reassigned receiver has no alias, so this resolves back to its source
            // name and the single-binding (e.g. 'let statement = ...') latch is unchanged.
            let receiver_alias = try local_alias_current_name(&body_aliases, receiver_name);
            let info = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
                ir_lookup_index,
                ir_bytes, function_name, module_prefix, body_locals, latch_value, bs,
                call_arg_type_cache
            );
            cursor_type = info.field_llvm_type;
            var latch_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            try latch_insts.append(compiled_mir::field_access_expr_inst(
                0, cursor_type, receiver_alias, info.receiver_llvm_type, info.field_index
            ));
            latch = compiled_mir::value_cursor_field_read_latch(
                cursor_var, body_string_counter, 0, latch_insts
            );
        } else {
            if std::mem::equal_bytes(latch_value_kind, "Call") {
                // A plain-call latch ('token = next_token(text, segment)') reassigns the cursor
                // through a non-try free call: the return type is its success type directly (no
                // error union), the args lower through the same cached path as the try-call latch,
                // and the renderer binds %<cursor>_next in the latch block (no try fail/cont split).
                let latch_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
                    ir_lookup_index, canonical_facts, ir_bytes,
                    function_name, module_prefix, latch_value, bs, call_arg_type_cache
                );
                cursor_type = latch_info.return_llvm_type;
                let latch_args = try compiled_mir_lower_call::lower_call_args_canonical(
                    ir_bytes, function_name, module_prefix, body_locals, latch_value,
                    body_string_counter, bs, ir_lookup_index, canonical_facts,
                    &latch_info.types, call_arg_type_cache
                );
                let latch_arg_strings = try compiled_mir_lower_call::count_string_args(&latch_args);
                latch = compiled_mir::value_cursor_plain_call_latch(
                    cursor_var,
                    cursor_type,
                    body_string_counter,
                    latch_info.module_prefix,
                    latch_info.callee_name,
                    latch_args
                );
                result_string_counter = body_string_counter + latch_arg_strings;
            } else {
                return error("compiled mir: unsupported embedded value-cursor latch");
            }
        }
    }
    try stmts.append(compiled_mir::value_cursor_while_stmt_with_init(
        cursor_var, cursor_type, seed_name, llvm_return_type, cond_insts, cond_result,
        body_stmts, latch, "vcw", false,
        init_call_module_prefix, init_call_callee_name, init_call_args
    ));
    return MultiLowerResult {
        locals_spec: locals_spec,
        string_counter: result_string_counter,
        temp_counter: result_temp_counter,
        try_counter: result_try_counter
    };
}

fn lower_errdefer_registration(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    let sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, statement, bs
    );
    let call_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, sf
    );
    let call_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, call_node, sf
    );
    if !std::mem::equal_bytes(call_kind, "Call") {
        return error("compiled mir: errdefer cleanup must be a call");
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, sf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", sf
    );
    if !std::mem::equal_bytes(method_name, "deinit") {
        return error("compiled mir: errdefer cleanup must call deinit");
    }
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    if !std::mem::equal_bytes(info.return_llvm_type, "void") {
        return error("compiled mir: errdefer cleanup must return void");
    }
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, sf, call_arg_type_cache
    );
    if explicit_arg_count != 0 {
        return error("compiled mir: errdefer cleanup takes no arguments");
    }
    var arg_types = try method_call_arg_types(
        ir_bytes, function_name, module_prefix, &info, call_node, 0,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    defer arg_types.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(
        std::mem::page_allocator()
    );
    try args.append(method_receiver_call_arg(
        &info, try local_alias_current_name(aliases, info.receiver_name)
    ));
    var normalized_args = try normalize_runtime_method_args(&arg_types, args);
    return compiled_mir::errdefer_stmt(
        info.module_prefix, info.callee_name, normalized_args
    );
}

// emit_pending_defers lowers each recorded top-level 'defer <receiver>.deinit();' body and appends
// its side-effect-only MIR statement to the running statement list, in LIFO order (last defer
// registered runs first). Each body re-uses the validated owned-deinit expression path, so the
// receiver type and %kizu.owned representation are re-checked at every emission site. The defer body
// is a non-try '<receiver>.deinit()' call, which consumes no string/try counters, so the threaded
// counters are passed through unchanged. This is called immediately before each top-level Return so
// the cleanup precedes the produced return value.
fn emit_pending_defers(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    pending_defers: &std::array::Array<i64>,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !void {
    var defer_index = pending_defers.len();
    while defer_index > 0 {
        defer_index = defer_index - 1;
        let defer_body = try pending_defers.get(defer_index);
        let emitted = try lower_owned_deinit_expr_statement(
            ir_lookup_index,
            canonical_facts,
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            defer_body,
            string_counter,
            temp_counter,
            try_counter,
            aliases,
            stmts,
            bs,
            call_arg_type_cache
        );
        // The owned-deinit path returns the counters unchanged; bind to acknowledge the result.
        if emitted.string_counter != string_counter or
            emitted.temp_counter != temp_counter or
            emitted.try_counter != try_counter {
            return error("compiled mir: defer deinit unexpectedly consumed a counter");
        }
    }
    return;
}

pub fn lower_multi_statement_function(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    instance_context: &compiled_instance_context::InstanceContext,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement_count: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    if statement_count < 1 {
        return error("compiled mir: statement function requires at least one statement");
    }
    // The cache is owned by the render site so the names this lowering invents outlive it. The
    // specialized loop lowerings dispatched below share it, and build_fn_node_index appends into
    // it and is not idempotent: this must stay the only call for this function.
    try compiled_mir_types::set_instance_context(
        call_arg_type_cache, instance_context
    );
    // Build the per-function body-node position index once (pillar A): every per-node structural lookup
    // below resolves its node->line offset through fn_node_line_start in O(1) instead of the global
    // index binary search. Byte-identical (same offsets); only the lookup cost changes.
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    // The specialized loop/parser shapes below are compact structural forms. Huge dispatcher
    // functions such as code_render.tape_record_end and render_one_instruction are ordinary
    // top-level if chains; probing every shape against them turns into repeated full body-fact
    // scans before the generic path. Gate the probes by statement count so large dispatchers go
    // straight to the generic multi-statement lowerer.
    if statement_count <= 24 and !instance_context.found {
        let is_parser_component = compiled_mir_lower_is_parser_component(function_name);
        // A value-carried array-append loop (struct value threaded through a phi, appended into a
        // runtime array until a sentinel tag) lowers through the generic ArrayNew + ValueWhile path
        // rather than the i64-induction While machinery (issue 1165).
        if try is_value_array_loop_shape(ir_bytes, function_name, statement_count, bs) {
            return try lower_value_array_loop(
                ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec, statement_count, bs,
                ir_lookup_index
            );
        }
        if is_parser_component {
            // A value-carried 'while true' grammar loop (the parse_postfix_expr shape: a struct
            // value threaded through a loop-head phi, reassigned through a free try-call in each
            // guarded arm, and returned from the terminal else) lowers through the GrammarLoop CFG.
            if try is_grammar_postfix_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_grammar_postfix_loop(
                    ir_lookup_index, canonical_facts, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    bs, call_arg_type_cache
                );
            }
            // A type-apply parser loop also uses a bool-literal 'while true' header, but its carried
            // value is a Token cursor seeded and latched by plain calls.
            if try is_type_apply_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_type_apply_loop(
                    ir_lookup_index, canonical_facts, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    bs, call_arg_type_cache
                );
            }
            // A 'while true' + match-dispatch loop (parse_generic_type_end's generic-argument walk)
            // uses a plain-call Token seed and a bool-literal header.
            if try is_while_match_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_while_match_loop(
                    ir_lookup_index, canonical_facts, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    bs, call_arg_type_cache
                );
            }
            // A precedence-climbing expression loop carries both a ParseNode-like value and an i64
            // precedence through phis.
            if try is_precedence_loop_shape(ir_bytes, function_name, params_spec, statement_count, bs) {
                return try lower_precedence_loop(
                    ir_lookup_index, canonical_facts, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    bs, call_arg_type_cache
                );
            }
            // A copy-seeded two-carried-value cursor loop threads a value cursor and scalar cursor
            // through loop-head phis.
            if try is_dual_cursor_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_dual_cursor_loop(
                    ir_lookup_index, canonical_facts, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    bs, call_arg_type_cache
                );
            }
            // A dual Token-cursor advance loop threads previous/current Token cursors and consumes
            // the previous token after the loop.
            if try is_trailing_token_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_trailing_token_loop(
                    ir_lookup_index, canonical_facts, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    statement_count, bs, call_arg_type_cache
                );
            }
            // A value-carried append-while loop threads a value cursor through a loop-head phi and a
            // free-try-call latch.
            if try is_value_cursor_append_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_value_cursor_append_loop(
                    ir_lookup_index, canonical_facts, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    bs, call_arg_type_cache
                );
            }
            // A guarded-cursor loop threads a plain-call Token cursor through a prefix-not predicate
            // header and conditional latch.
            if try is_guarded_cursor_return_loop_shape(ir_bytes, function_name, statement_count, bs) {
                return try lower_guarded_cursor_return_loop(
                    ir_lookup_index, canonical_facts, ir_bytes, function_name, llvm_symbol, llvm_return_type, params_spec,
                    statement_count, bs, call_arg_type_cache
                );
            }
        }
    }
    let is_parser_component = compiled_mir_lower_is_parser_component(function_name);
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var locals_spec = params_spec;
    var string_counter = 0;
    var temp_counter = 0;
    var try_counter = 0;
    var alias_counter = 0;
    var aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer aliases.deinit();
    let has_top_level_while = try top_level_has_statement_kind(
        ir_bytes, function_name, statement_count, "While", bs, &call_arg_type_cache
    );
    // Top-level 'defer <receiver>.deinit();' statements register a cleanup that must run on every
    // exit path reached after the defer. We collect each defer body's inner expression node here and
    // re-lower it (via the owned-deinit expression path) immediately before each top-level Return,
    // in LIFO order, rather than emitting it in-place (issue 1157 parse_impl_decl Defer blocker).
    var pending_defers = std::array::Array<i64>(std::mem::page_allocator());
    defer pending_defers.deinit();
    var stmt_index = 0;
    // The root block's 'statement' edges interleave with each statement's subtree in the fact
    // stream, so rescanning from bs to find the stmt_index-th edge is O(function) per statement
    // (quadratic overall). stmt_scan_from advances to the current statement's body-node line
    // each turn: the next statement's edge sorts after this statement's whole subtree, which
    // begins at that line, so the walk stays byte-identical while the loop becomes O(function).
    var stmt_scan_from = bs;
    while stmt_index < statement_count {
        let statement = try compiled_mir_types::fn_body_child_sequence_from(
            &call_arg_type_cache,
            ir_bytes, function_name, 0, "statement", stmt_index, stmt_scan_from
        );
        // sf is this statement's body-node line via the per-function index (pillar A, O(1)); its own
        // structural facts (its kind here) sort at-or-after it, so a scan from sf is byte-identical
        // to one from bs.
        let sf = compiled_mir_types::fn_node_line_start(&call_arg_type_cache, statement, bs);
        stmt_scan_from = sf;
        let stmt_kind = try compiled_mir_types::fn_node_kind(
            &call_arg_type_cache, ir_bytes, function_name, statement, sf
        );
        if std::mem::equal_bytes(stmt_kind, "Let") {
            // A 'var counter = <int>' that a later while increments is the loop
            // induction initializer: it is not emitted as a let because the loop-head
            // phi supplies the initial value on the preheader edge, so emitting it
            // would redefine the induction SSA name (tracker 961).
            var is_induction_init = false;
            if has_top_level_while {
                is_induction_init = try statement_is_induction_init(
                    ir_bytes, function_name, 0, statement, statement_count, bs
                );
            }
            if is_induction_init and try loop_seed_must_stay_in_place(
                ir_bytes, function_name, 0, statement, statement_count, bs
            ) {
                let seed_result = try lower_loop_seed_binding_in_place(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    statement,
                    string_counter,
                    temp_counter,
                    try_counter,
                    &var aliases,
                    &var stmts,
                    bs,
                    ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                locals_spec = seed_result.locals_spec;
                string_counter = seed_result.string_counter;
                temp_counter = seed_result.temp_counter;
                try_counter = seed_result.try_counter;
                stmt_index = stmt_index + 1;
                continue;
            }
            if is_induction_init {
                if try induction_init_needs_prewhile_alias(
                    ir_bytes, function_name, statement, stmt_index, statement_count, bs
                ) {
                    let init_alias = try lower_induction_init_alias(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        statement,
                        string_counter,
                        temp_counter,
                        alias_counter,
                        &var aliases,
                        &var stmts,
                        bs,
                        ir_lookup_index,
                        canonical_facts,
                        call_arg_type_cache
                    );
                    string_counter = init_alias.string_counter;
                    temp_counter = init_alias.temp_counter;
                    alias_counter = init_alias.alias_counter;
                }
                stmt_index = stmt_index + 1;
                continue;
            }
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                statement,
                string_counter,
                temp_counter,
                try_counter,
                &var aliases,
                &var stmts,
                bs,
                ir_lookup_index,
                canonical_facts,
                call_arg_type_cache
            );
            locals_spec = let_result.locals_spec;
            string_counter = let_result.string_counter;
            temp_counter = let_result.temp_counter;
            try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(stmt_kind, "Defer") {
                // The defer body is the single 'expr' child of the Defer node (a '<receiver>.deinit()'
                // call). Record it for emission at each subsequent top-level exit; emit nothing here.
                let defer_body = try compiled_mir_types::fn_body_child_sequence_from(
                    &call_arg_type_cache,
                    ir_bytes, function_name, statement, "expr", 0, bs
                );
                try pending_defers.append(defer_body);
            } else {
            if std::mem::equal_bytes(stmt_kind, "ErrDefer") {
                try stmts.append(try lower_errdefer_registration(
                    ir_bytes, function_name, module_prefix, locals_spec,
                    statement, &aliases, bs, ir_lookup_index,
                    canonical_facts, call_arg_type_cache
                ));
            } else {
            if std::mem::equal_bytes(stmt_kind, "While") {
                if is_parser_component and try is_embedded_value_cursor_append_loop_shape(
                    ir_bytes, function_name, stmt_index, statement, bs
                ) {
                    let cursor_result = try lower_embedded_value_cursor_append_loop(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        statement,
                        stmt_index,
                        string_counter,
                        temp_counter,
                        try_counter,
                        &var stmts,
                        bs,
                        ir_lookup_index,
                        canonical_facts,
                        call_arg_type_cache
                    );
                    string_counter = cursor_result.string_counter;
                    temp_counter = cursor_result.temp_counter;
                    try_counter = cursor_result.try_counter;
                } else {
                    let while_result = try lower_multi_while_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        statement,
                        string_counter,
                        temp_counter,
                        alias_counter,
                        // The loop's own bucket, resolved here rather than left as the raw
                        // statement index: bucket 0 hands its children 1..1000, which is the band
                        // the top-level statements themselves occupy (see reserved_nested_base).
                        try reserved_nested_base(stmt_index, ir_bytes, function_name, bs),
                        0,
                        stmt_index,
                        &var aliases,
                        &var stmts,
                        bs,
                        ir_lookup_index,
                        canonical_facts,
                        call_arg_type_cache
                    );
                    temp_counter = while_result.temp_counter;
                    string_counter = while_result.string_counter;
                    alias_counter = while_result.alias_counter;
                }
            } else {
            if std::mem::equal_bytes(stmt_kind, "Return") {
                // Cleanups registered by earlier top-level 'defer' statements run on this exit, in
                // LIFO order, before the return value is produced.
                try emit_pending_defers(
                    ir_lookup_index,
                    canonical_facts,
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    &pending_defers,
                    string_counter,
                    temp_counter,
                    try_counter,
                    &aliases,
                    &var stmts,
                    bs,
                    call_arg_type_cache
                );
                try stmts.append(try lower_multi_return_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    statement,
                    string_counter,
                    temp_counter,
                    &aliases,
                    bs,
                    ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                ));
            } else {
                if std::mem::equal_bytes(stmt_kind, "If") {
                    let if_result = try lower_multi_if_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        statement,
                        string_counter,
                        temp_counter,
                        try_counter,
                        alias_counter,
                        // The if's own bucket, resolved here for the same reason the loop above
                        // resolves its own: bucket 0's children land in the top-level band.
                        try reserved_nested_base(stmt_index, ir_bytes, function_name, bs),
                        &var aliases,
                        &var stmts,
                        -1,
                        bs,
                        ir_lookup_index,
                        canonical_facts,
                        call_arg_type_cache
                    );
                    temp_counter = if_result.temp_counter;
                    string_counter = if_result.string_counter;
                    try_counter = if_result.try_counter;
                    alias_counter = if_result.alias_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                        let expr_result = try lower_multi_expr_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            statement,
                            string_counter,
                            temp_counter,
                            try_counter,
                            &aliases,
                            &var stmts,
                            bs,
                            ir_lookup_index,
                            canonical_facts,
                            call_arg_type_cache
                        );
                        string_counter = expr_result.string_counter;
                        temp_counter = expr_result.temp_counter;
                        try_counter = expr_result.try_counter;
                    } else {
                    if std::mem::equal_bytes(stmt_kind, "Match") {
                        // A non-bool enum-dispatch match lowers to branch-control-flow EnumDispatch.
                        // Terminal return arms stay terminal; side-effecting expression arms join
                        // and let later top-level statements continue. The result threads every
                        // namespace counter past the scrutinee and private arm windows.
                        let match_result = try lower_multi_match_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            statement,
                            string_counter,
                            temp_counter,
                            try_counter,
                            &var aliases,
                            &var stmts,
                            bs,
                            ir_lookup_index,
                            canonical_facts,
                            call_arg_type_cache,
                            false,
                            "",
                            ""
                        );
                        string_counter = match_result.string_counter;
                        temp_counter = match_result.temp_counter;
                        try_counter = match_result.try_counter;
                    } else {
                    if std::mem::equal_bytes(stmt_kind, "Assign") {
                        // A top-level '<local> = try <free-call>(args);' reassignment threads the
                        // call's success value into an existing local. It reuses the LetTryCall
                        // error-union branch/propagate path bound to a fresh alias name, then
                        // redirects later reads of the target through that alias (the same
                        // local-alias indirection the void-then-body reassignment uses), since the
                        // SSA name already exists and cannot be redefined.
                        let assign_result = try lower_multi_assign_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            statement,
                            string_counter,
                            temp_counter,
                            try_counter,
                            alias_counter,
                            &var aliases,
                            &var stmts,
                            bs,
                            ir_lookup_index,
                            canonical_facts,
                            call_arg_type_cache
                        );
                        locals_spec = assign_result.locals_spec;
                        string_counter = assign_result.string_counter;
                        temp_counter = assign_result.temp_counter;
                        try_counter = assign_result.try_counter;
                        alias_counter = assign_result.alias_counter;
                    } else {
                        var message = std::string::String(std::mem::page_allocator());
                        try message.append_bytes("compiled mir: unsupported statement kind: ");
                        try message.append_bytes(function_name);
                        try message.append_bytes(" node ");
                        try std::fmt::append_i64(&var message, statement);
                        try message.append_bytes(" kind ");
                        try message.append_bytes(stmt_kind);
                        let message_bytes = message.as_bytes();
                        return error(message_bytes);
                    }
                    }
                    }
                }
            }
            }
            }
            }
        }
        stmt_index = stmt_index + 1;
    }
    // A body that produces no value may end without writing 'return;' -- a '-> void' deinit that
    // just releases its fields is the common shape. The block still needs a terminator, so the
    // implicit return the source omits is synthesized here, exactly as 'return;' would lower. Only
    // an effect statement tail takes it: a trailing If, While, or Match ends in its own blocks,
    // whose arms carry their own returns.
    if try body_falls_off_a_value_free_end(
        ir_bytes, function_name, llvm_return_type, statement_count, bs
    ) {
        try stmts.append(compiled_mir::return_void_success_stmt());
    }
    return compiled_mir_function::multi_statement_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        stmts
    );
}

// body_falls_off_a_value_free_end reports whether a void or error-union-void body ends on an
// effect statement rather than a return, so the lowering owes it the return the source left out.
fn body_falls_off_a_value_free_end(
    ir_bytes: []u8,
    function_name: []u8,
    llvm_return_type: []u8,
    statement_count: i64,
    bs: i64
) -> !bool {
    if !std::mem::equal_bytes(llvm_return_type, "void") and
        !std::mem::equal_bytes(llvm_return_type, "%kizu.error.void") {
        return false;
    }
    if statement_count < 1 {
        return false;
    }
    let last = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, 0, "statement", statement_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, last, bs
    );
    return std::mem::equal_bytes(last_kind, "ExprStmt") or
        std::mem::equal_bytes(last_kind, "Let") or
        std::mem::equal_bytes(last_kind, "Assign");
}

fn compiled_mir_lower_is_parser_component(function_name: []u8) -> bool {
    return std::mem::starts_with(function_name, "std::kizu::parser::");
}

pub fn lower_single_match_statement_function(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    instance_context: &compiled_instance_context::InstanceContext,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_symbol: []u8,
    llvm_return_type: []u8,
    params_spec: []u8,
    statement: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirFunction {
    let module_prefix = compiled_util::module_prefix_of(function_name);
    var aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer aliases.deinit();
    try compiled_mir_types::set_instance_context(
        call_arg_type_cache, instance_context
    );
    try compiled_mir_types::build_fn_node_index(
        call_arg_type_cache, ir_lookup_index, ir_bytes, function_name
    );
    var stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    let _match_result = try lower_multi_match_statement(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        params_spec,
        statement,
        0,
        0,
        0,
        &var aliases,
        &var stmts,
        bs,
        ir_lookup_index,
        canonical_facts,
        call_arg_type_cache,
        false,
        "",
        ""
    );
    return compiled_mir_function::multi_statement_function(
        llvm_symbol,
        llvm_return_type,
        params_spec,
        stmts
    );
}

fn top_level_has_statement_kind(
    ir_bytes: []u8,
    function_name: []u8,
    statement_count: i64,
    kind: []u8,
    bs: i64,
    call_arg_type_cache: &compiled_mir_types::CallArgTypeCache
) -> !bool {
    var stmt_index = 0;
    var stmt_scan_from = bs;
    while stmt_index < statement_count {
        let statement = try compiled_mir_types::fn_body_child_sequence_from(
            call_arg_type_cache,
            ir_bytes, function_name, 0, "statement", stmt_index, stmt_scan_from
        );
        let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
        stmt_scan_from = sf;
        let stmt_kind = try compiled_mir_types::fn_node_kind(
            call_arg_type_cache, ir_bytes, function_name, statement, sf
        );
        if std::mem::equal_bytes(stmt_kind, kind) {
            return true;
        }
        stmt_index = stmt_index + 1;
    }
    return false;
}
pub struct MultiLowerResult {
    pub locals_spec: []u8,
    pub string_counter: i64,
    pub temp_counter: i64,
    pub try_counter: i64,
}

pub struct MultiAssignLowerResult {
    pub locals_spec: []u8,
    pub string_counter: i64,
    pub temp_counter: i64,
    pub try_counter: i64,
    pub alias_counter: i64,
}
struct TryCallArgsLowerResult {
    string_counter: i64,
    temp_counter: i64,
}
struct TryArgCallArgsLowerResult {
    locals_spec: []u8,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
}
pub struct MultiIfLowerResult {
    pub temp_counter: i64,
    pub string_counter: i64,
    pub try_counter: i64,
    pub alias_counter: i64,
}
pub struct MultiExprLowerResult {
    pub string_counter: i64,
    pub temp_counter: i64,
    pub try_counter: i64,
}

pub struct MultiMatchLowerResult {
    pub string_counter: i64,
    pub temp_counter: i64,
    pub try_counter: i64,
    // result_llvm is the ABI every arm of a value-binding dispatch produced, derived from the
    // first arm and required to match in the rest. It is empty for a statement dispatch.
    pub result_llvm: []u8,
}

pub struct CarriedScalarState {
    pub source_name: []u8,
    // head_name is the SSA name this loop's head binds for the scalar, and the key of its slot when
    // the loop carries in memory. It is the source name unless an enclosing loop's head already
    // took that name -- a loop nested inside one that carries the same variable -- in which case
    // this loop takes a scoped name of its own, exactly as a nested induction counter does.
    pub head_name: []u8,
    pub current_name: []u8,
    pub llvm_type: []u8,
    pub init_literal: i64,
    pub init_var: []u8,
    pub init_offset: i64,
    pub init_name: []u8,
}

pub struct LocalAliasState {
    pub source_name: []u8,
    pub current_name: []u8,
    // loop_phi_name records the SSA name a loop-head phi in this scope has already taken for this
    // variable. A later while over the same variable reads it to learn that %<var> is spoken for and
    // must take a scoped phi name of its own, which current_name alone cannot say: a plain alias
    // assignment also leaves an entry here, and it leaves %<var> free (issue 1165 / 1162).
    pub loop_phi_name: []u8,
}

pub struct BranchMergeCarriedAlias {
    pub source_name: []u8,
    pub phi_name: []u8,
    pub llvm_type: []u8,
    pub init_name: []u8,
}

pub struct VoidAssignLowerResult {
    pub string_counter: i64,
    pub temp_counter: i64,
    pub try_counter: i64,
    pub alias_counter: i64,
}

pub struct VoidBodyLowerResult {
    pub locals_spec: []u8,
    pub string_counter: i64,
    pub temp_counter: i64,
    pub try_counter: i64,
    pub alias_counter: i64,
    pub body_returns: bool,
}

fn void_then_alias_name(
    slot: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if slot < 0 {
        return error("compiled mir: negative void then alias slot");
    }
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes("void.then.alias.");
    try std::fmt::append_i64(&var out, slot);
    return call_arg_type_cache.name_store.own(out);
}

// shadow_binding_name renders a shadowed let binding's per-binding-unique SSA name,
// '<source>.shadow.<slot>'. The slot is the binding's own IR statement node, unique within
// the function, so two same-named bindings (e.g. parse_closed_start_slice's then-block
// 'let end = ast.add_empty(...)' and the enclosing 'let end = try parse_expr(...)') receive
// distinct LLVM names and never define the same %end twice. MirNameStore owns the generated
// bytes for the lifetime of this lowering cache.
fn shadow_binding_name(
    source_name: []u8,
    slot: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if slot < 0 {
        return error("compiled mir: negative shadow binding slot");
    }
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes(source_name);
    try out.append_bytes(".shadow.");
    try std::fmt::append_i64(&var out, slot);
    return call_arg_type_cache.name_store.own(out);
}

// llvm_reserved_local_name reports whether a source name is one the renderer already spells in the
// function's own local namespace. LLVM keeps block labels and values in one namespace, and 'entry'
// is the single block this backend names without an index -- every other block carries the index of
// the construct that owns it -- so a local spelled 'entry' would redefine the entry block. Such a
// binding is renamed through the alias map, which is what keeps the source spelling readable while
// the emitted name stays out of the renderer's way.
fn llvm_reserved_local_name(name: []u8) -> bool {
    return std::mem::equal_bytes(name, "entry");
}

// dispatch_payload_binding_name gives every match arm payload an SSA name unique
// within the function. Match arms commonly reuse the source name value for
// different variant payload types, so the source spelling cannot be defined in
// every arm. The statement node and arm ordinal are stable structural identities.
fn dispatch_payload_binding_name(
    statement: i64,
    arm_index: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes("dispatch.payload.");
    try std::fmt::append_i64(&var out, statement);
    try out.append_byte(cast<u8>(46));
    try std::fmt::append_i64(&var out, arm_index);
    return call_arg_type_cache.name_store.own(out);
}

// dispatch_result_arm_name gives every value-binding dispatch arm a distinct SSA name for the
// value it produces, keyed by the match statement and arm index so arms never collide.
fn dispatch_result_arm_name(
    statement: i64,
    arm_index: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes("dispatch.result.");
    try std::fmt::append_i64(&var out, statement);
    try out.append_byte(cast<u8>(46));
    try std::fmt::append_i64(&var out, arm_index);
    return call_arg_type_cache.name_store.own(out);
}

// count_let_bindings_in_block counts the let/var bindings of 'name' in one statement block,
// descending into while bodies and if then/else blocks so a binding nested in a branch counts
// alongside one at the enclosing level. Two or more bindings of the same name in a function
// means the name is shadowed: each binding must take a distinct SSA name.
fn count_let_bindings_in_block(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8,
    block_node: i64,
    bs: i64
) -> !i64 {
    var count = 0;
    var stmt_index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", stmt_index, bs
        );
        if statement < 0 {
            return count;
        }
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let bound = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(bound, name) {
                count = count + 1;
            }
        }
        if std::mem::equal_bytes(stmt_kind, "While") {
            let body_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "body", 0, bs
            );
            count = count + try count_let_bindings_in_block(
                ir_bytes, function_name, name, body_node, bs
            );
        }
        if std::mem::equal_bytes(stmt_kind, "If") {
            let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "then", 0, bs
            );
            if then_node >= 0 {
                count = count + try count_let_bindings_in_block(
                    ir_bytes, function_name, name, then_node, bs
                );
            }
            let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "else", 0, bs
            );
            if else_node >= 0 {
                count = count + try count_let_bindings_in_block(
                    ir_bytes, function_name, name, else_node, bs
                );
            }
        }
        stmt_index = stmt_index + 1;
    }
    return count;
}

// let_binding_is_shadowed reports whether 'name' is bound by two or more let/var statements in
// the function body. A shadowed name cannot keep its source spelling as its SSA name: the inner
// and outer bindings would define the same %name, which is invalid LLVM. The renamed binding is
// redirected through the local-alias map so in-scope reads still resolve to it.
// let_binding_is_local_to_branch reports whether every let/var binding of this name in the
// function lives inside this if's arms. Such a binding is created and dies inside the arm, so the
// enclosing scope holds no value of its own for it: merging one would seed the join slot from a
// name that is only ever defined inside the branch.
fn let_binding_is_local_to_branch(
    ir_bytes: []u8,
    function_name: []u8,
    then_node: i64,
    else_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let total = try count_let_bindings_in_block(ir_bytes, function_name, name, 0, bs);
    if total == 0 {
        return false;
    }
    var inside = 0;
    if then_node >= 0 {
        inside = inside + try count_let_bindings_in_block(
            ir_bytes, function_name, name, then_node, bs
        );
    }
    if else_node >= 0 {
        inside = inside + try count_let_bindings_in_block(
            ir_bytes, function_name, name, else_node, bs
        );
    }
    return inside == total;
}

fn let_binding_is_shadowed(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8,
    bs: i64
) -> !bool {
    let total = try count_let_bindings_in_block(ir_bytes, function_name, name, 0, bs);
    return total >= 2;
}

fn local_alias_index(
    aliases: &std::array::Array<LocalAliasState>,
    source_name: []u8
) -> !i64 {
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if std::mem::equal_bytes(state.source_name, source_name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn local_alias_current_name(
    aliases: &std::array::Array<LocalAliasState>,
    source_name: []u8
) -> ![]u8 {
    let index = try local_alias_index(aliases, source_name);
    if index < 0 {
        return source_name;
    }
    let state = try aliases.at(index);
    return state.current_name;
}

fn set_local_alias(
    aliases: &var std::array::Array<LocalAliasState>,
    source_name: []u8,
    current_name: []u8
) -> !void {
    let index = try local_alias_index(aliases, source_name);
    if index < 0 {
        try aliases.append(LocalAliasState {
            source_name: source_name,
            current_name: current_name,
            loop_phi_name: ""
        });
        return;
    }
    let existing = try aliases.at(index);
    // Read the claimed phi name out of the borrow before writing the slot back: a loop that already
    // took %<var> keeps that claim across later alias assignments to the same variable.
    let existing_loop_phi_name = existing.loop_phi_name;
    try aliases.set(index, LocalAliasState {
        source_name: source_name,
        current_name: current_name,
        loop_phi_name: existing_loop_phi_name
    });
    return;
}

// local_alias_loop_phi_name returns the SSA name a loop-head phi in this scope already took for
// source_name, or the empty slice when no loop has claimed one yet.
fn local_alias_loop_phi_name(
    aliases: &std::array::Array<LocalAliasState>,
    source_name: []u8
) -> ![]u8 {
    let index = try local_alias_index(aliases, source_name);
    if index < 0 {
        return "";
    }
    let state = try aliases.at(index);
    return state.loop_phi_name;
}

// claim_local_alias_loop_phi records that a loop-head phi now owns phi_name for source_name, and
// makes it the variable's current value: statements after the loop read the phi, which is what the
// loop leaves live on every exit edge.
fn claim_local_alias_loop_phi(
    aliases: &var std::array::Array<LocalAliasState>,
    source_name: []u8,
    phi_name: []u8
) -> !void {
    let index = try local_alias_index(aliases, source_name);
    if index < 0 {
        try aliases.append(LocalAliasState {
            source_name: source_name,
            current_name: phi_name,
            loop_phi_name: phi_name
        });
        return;
    }
    try aliases.set(index, LocalAliasState {
        source_name: source_name,
        current_name: phi_name,
        loop_phi_name: phi_name
    });
    return;
}

// claim_local_alias_loop_exit makes the same head claim claim_local_alias_loop_phi does, then
// points statements after the loop at exit_name instead of at the head. A slot-carried loop can be
// left from inside its body, where the head's definition is already behind the slot, so what
// survives the loop is the exit block's reload and not the value the head last read.
fn claim_local_alias_loop_exit(
    aliases: &var std::array::Array<LocalAliasState>,
    source_name: []u8,
    head_name: []u8,
    exit_name: []u8
) -> !void {
    let index = try local_alias_index(aliases, source_name);
    if index < 0 {
        try aliases.append(LocalAliasState {
            source_name: source_name,
            current_name: exit_name,
            loop_phi_name: head_name
        });
        return;
    }
    try aliases.set(index, LocalAliasState {
        source_name: source_name,
        current_name: exit_name,
        loop_phi_name: head_name
    });
    return;
}

// loop_exit_carried_name spells the name a slot-carried loop's exit block binds for one carried
// variable. It must match what the renderer emits there, so both spell 'loop<N>_exit_<var>'.
fn loop_exit_carried_name(
    source_name: []u8,
    loop_index: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if loop_index < 0 {
        return error("compiled mir: negative loop index");
    }
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes("loop");
    try std::fmt::append_i64(&var out, loop_index);
    try out.append_bytes("_exit_");
    try out.append_bytes(source_name);
    return call_arg_type_cache.name_store.own(out);
}

// loop_scoped_induction_phi_name spells the loop-head phi name a while takes when %<var> is
// already defined by an earlier loop in the same scope. loop_index is unique per while in a
// scope, so the name is too.
fn loop_scoped_induction_phi_name(
    source_name: []u8,
    loop_index: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if loop_index < 0 {
        return error("compiled mir: negative loop index");
    }
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes(source_name);
    try out.append_bytes(".loop.head.");
    try std::fmt::append_i64(&var out, loop_index);
    return call_arg_type_cache.name_store.own(out);
}

// loop_head_defines_phi_for reports whether this loop's head defines the SSA name a source variable
// resolves to inside the loop: its induction counter or one of its carried scalars. Those names must
// not be rewritten to an enclosing statement's alias -- the loop head, not that statement, supplies
// the value on the preheader edge.
fn loop_head_defines_phi_for(
    states: &std::array::Array<CarriedScalarState>,
    induction_var: []u8,
    name: []u8
) -> !bool {
    if std::mem::equal_bytes(name, induction_var) {
        return true;
    }
    return (try carried_scalar_index(states, name)) >= 0;
}

// rename_loop_cond_reads resolves a loop condition's variable reads against the enclosing scope. The
// condition lowers with no alias map, so a variable an earlier statement rebound to a fresh SSA name
// ('current = 0 - current;' ahead of 'while ... current <= ...' in std::fmt::append_i64) would read
// the pre-assignment value. The induction counter is rewritten last, to this loop's head phi.
fn rename_loop_cond_reads(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    states: &std::array::Array<CarriedScalarState>,
    induction_var: []u8,
    induction_phi: []u8
) -> !void {
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        let source_name = state.source_name;
        let current_name = state.current_name;
        if !std::mem::equal_bytes(source_name, current_name) and
            !(try loop_head_defines_phi_for(states, induction_var, source_name)) {
            try rename_induction_in_insts(insts, source_name, current_name);
        }
        index = index + 1;
    }
    // A carried scalar whose head name is scoped -- this loop is nested inside one carrying the
    // same variable -- is read in the condition under that scoped name, the one this head binds.
    var carried_index = 0;
    while carried_index < states.len() {
        let carried_state = try states.at(carried_index);
        if !std::mem::equal_bytes(carried_state.source_name, carried_state.head_name) {
            try rename_induction_in_insts(
                insts, carried_state.source_name, carried_state.head_name
            );
        }
        carried_index = carried_index + 1;
    }
    if !std::mem::equal_bytes(induction_phi, induction_var) {
        try rename_induction_in_insts(insts, induction_var, induction_phi);
    }
    return;
}

fn copy_local_aliases(
    aliases: &std::array::Array<LocalAliasState>
) -> !std::array::Array<LocalAliasState> {
    var copied = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        try copied.append(LocalAliasState {
            source_name: state.source_name,
            current_name: state.current_name,
            loop_phi_name: state.loop_phi_name
        });
        index = index + 1;
    }
    return copied;
}

fn lower_call_args_with_local_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    first_string_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !std::array::Array<compiled_mir::MirCallArg> {
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        index = index + 1;
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    return try compiled_mir_lower_call::lower_call_args_canonical_with_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        call_node,
        first_string_index,
        &alias_sources,
        &alias_currents,
        bs,
        ir_lookup_index,
        canonical_facts,
        &call_info.types,
        call_arg_type_cache
    );
}

fn lower_single_call_arg_with_local_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    string_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirCallArg {
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        index = index + 1;
    }
    return try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        arg_type,
        arg_node,
        string_index,
        &alias_sources,
        &alias_currents,
        bs,
        ir_lookup_index,
        canonical_facts,
        call_arg_type_cache
    );
}

fn carried_scalar_alias_name(source_name: []u8, loop_index: i64, slot: i64) -> ![]u8 {
    if slot == 0 {
        return "carried.scalar.0";
    }
    if slot == 1 {
        return "carried.scalar.1";
    }
    if slot == 2 {
        return "carried.scalar.2";
    }
    if slot == 3 {
        return "carried.scalar.3";
    }
    if slot == 4 {
        return "carried.scalar.4";
    }
    if slot == 5 {
        return "carried.scalar.5";
    }
    if slot == 6 {
        return "carried.scalar.6";
    }
    if slot == 7 {
        return "carried.scalar.7";
    }
    if slot == 8 {
        return "carried.scalar.8";
    }
    if slot == 9 {
        return "carried.scalar.9";
    }
    return error("compiled mir: too many carried scalar assignments");
}

fn loop_carried_alias_name(
    source_name: []u8,
    statement: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if statement < 0 {
        return error("compiled mir: negative loop-carried assignment node");
    }
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes(source_name);
    try out.append_bytes(".loop.");
    try std::fmt::append_i64(&var out, statement);
    return call_arg_type_cache.name_store.own(out);
}

// carried_scalar_seed_name spells the preheader binding a loop makes for a carried scalar whose
// 'var <name> = <init>' seed is not emitted as a let. loop_index is unique per while in a scope,
// so the name is too.
fn carried_scalar_seed_name(
    source_name: []u8,
    loop_index: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if loop_index < 0 {
        return error("compiled mir: negative loop index");
    }
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes(source_name);
    try out.append_bytes(".loop.seed.");
    try std::fmt::append_i64(&var out, loop_index);
    return call_arg_type_cache.name_store.own(out);
}

fn carried_scalar_index(
    states: &std::array::Array<CarriedScalarState>,
    source_name: []u8
) -> !i64 {
    var index = 0;
    while index < states.len() {
        let state = try states.at(index);
        if std::mem::equal_bytes(state.source_name, source_name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn rename_carried_scalars_in_insts(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    states: &std::array::Array<CarriedScalarState>
) -> !void {
    var index = 0;
    while index < states.len() {
        let state = try states.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try rename_induction_in_insts(insts, state.source_name, state.current_name);
        }
        index = index + 1;
    }
    return;
}

fn lower_expr_with_carried_renames(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    states: &std::array::Array<CarriedScalarState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        node,
        string_counter,
        temp_counter,
        insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    try rename_carried_scalars_in_insts(insts, states);
    return result;
}

fn scalar_assign_target_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    bs: i64
) -> ![]u8 {
    let assign_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, assign_node, bs);
    if !std::mem::equal_bytes(assign_kind, "Assign") {
        return "";
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return "";
    }
    let target_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    if try assign_is_self_scalar_arith(ir_bytes, function_name, assign_node, target_name, bs) {
        return target_name;
    }
    return "";
}

fn assign_is_self_scalar_arith(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    var_name: []u8,
    bs: i64
) -> !bool {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") and !std::mem::equal_bytes(op, "sub") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return false;
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_name, var_name) {
        return false;
    }
    let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
    return offset >= 1;
}

fn if_scalar_assign_node_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !i64 {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count == 1 {
        let only_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_node, "statement", 0, bs
        );
        let target = try scalar_assign_target_or_empty(ir_bytes, function_name, only_stmt, bs);
        if std::mem::len(target) > 0 {
            return only_stmt;
        }
    }
    if then_count == 2 {
        let second_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_node, "statement", 1, bs
        );
        let target = try scalar_assign_target_or_empty(ir_bytes, function_name, second_stmt, bs);
        if std::mem::len(target) > 0 {
            return second_stmt;
        }
    }
    return -1;
}

fn while_carries_scalar_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var body_index = 0;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "If") {
            let assign_node = try if_scalar_assign_node_or_minus_one(
                ir_bytes, function_name, body_stmt, bs
            );
            if assign_node >= 0 {
                let target = try scalar_assign_target_or_empty(
                    ir_bytes, function_name, assign_node, bs
                );
                if std::mem::equal_bytes(target, name) {
                    return true;
                }
            }
        }
        body_index = body_index + 1;
    }
    return false;
}

// lower_multi_expr_statement lowers side-effecting expression statements. Try-call statements keep
// the existing error-propagating paths for String append methods and free-function '!void' calls.
// Non-try calls are accepted only for the validated owned-handle destructor shape
// '<local-or-param>.deinit();': the receiver type must resolve to a supported runtime-owned
// resource and its LLVM representation must be %kizu.owned before the cleanup call is emitted.
fn lower_multi_expr_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    // sf tightens this expression statement's own structural facts (its expr/try/call subtree:
    // kinds, callee field-expr, receiver/arg edges and tokens) to its body-node line via the
    // index; the subtree sorts at-or-after it, so a scan from sf is byte-identical to one from bs.
    // The statement-lowering recursion (owned-deinit / free-try-call / array-append / string-arg /
    // method-try-call) and receiver type resolution keep bs because they read facts that can
    // precede this node.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, sf
    );
    let expr_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr, sf);
    if std::mem::equal_bytes(expr_kind, "Call") {
        let builtin = try compiled_type_resolver::call_builtin_indexed(
            ir_lookup_index, ir_bytes, function_name, expr
        );
        if builtin.found {
            let operation_id = builtin_contract::operation_from_name(builtin.operation);
            let language_abi = builtin_contract::language_builtin_abi(operation_id);
            if language_abi.found {
                if language_abi.lowering !=
                    builtin_contract::LanguageBuiltinLowering::Print {
                    return error("compiled mir: language builtin lowering unsupported");
                }
                return try lower_print_expr_statement(
                    ir_bytes, function_name, module_prefix, locals_spec, expr,
                    string_counter, temp_counter, try_counter, aliases, stmts, bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
            }
        }
        if !try callee_is_field_expr(ir_bytes, function_name, expr, bs) {
            return try lower_void_free_call_statement(
                ir_bytes, function_name, module_prefix, locals_spec, expr,
                string_counter, temp_counter, try_counter, aliases, stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        return try lower_owned_deinit_expr_statement(
            ir_lookup_index,
            canonical_facts,
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, expr,
            string_counter, temp_counter, try_counter, aliases, stmts, bs,
            call_arg_type_cache
        );
    }
    let inner = try try_statement_value_node(
        ir_bytes, function_name, statement, bs, call_arg_type_cache
    );
    let inner_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, inner, sf
    );
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return try lower_void_try_expr_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    if !try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return try lower_void_free_try_call_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    let arg_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, inner, "arg", 0, sf
    );
    let arg_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, arg_node, sf
    );
    if std::mem::equal_bytes(arg_kind, "TryExpr") {
        return lower_void_method_try_call_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type,
            locals_spec, inner, string_counter, temp_counter, try_counter,
            aliases, stmts, bs, ir_lookup_index, canonical_facts,
            call_arg_type_cache
        );
    }
    // A field-receiver append ('self.ranges.append(FactRange { .. })') needs no method-name
    // branch: the shared method path resolves the FieldExpr receiver through the same struct
    // facts, extracts the field into the receiver call arg, and hoists a computed argument
    // (struct literal, binary, cast, nested call) into a preceding binding.
    return lower_void_method_try_call_statement(
        ir_bytes, function_name, module_prefix, llvm_return_type,
        locals_spec, inner, string_counter, temp_counter, try_counter,
        aliases, stmts, bs, ir_lookup_index, canonical_facts,
        call_arg_type_cache
    );
}

fn lower_print_expr_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    let operation_id = builtin_contract::operation_from_name(builtin.operation);
    let language_abi = builtin_contract::language_builtin_abi(operation_id);
    if !language_abi.found or language_abi.lowering !=
        builtin_contract::LanguageBuiltinLowering::Print {
        return error("compiled mir: print call has no language builtin descriptor");
    }
    let call_types = try parsed_call_type_for_node(
        canonical_facts, ir_bytes, function_name, call_node,
        call_arg_type_cache
    );
    if call_types.actual_len != language_abi.param_count {
        return error("compiled mir: print canonical argument count mismatch");
    }
    let actual_id = try parsed_call_actual_type_id_cached(
        canonical_facts, call_arg_type_cache, &call_types, 0
    );
    let print_abi = try compiled_canonical_facts::parsed_print_runtime_abi(
        canonical_facts, actual_id
    );
    let value_llvm = try canonical_runtime_semantic_abi(
        ir_lookup_index, canonical_facts, ir_bytes, module_prefix, actual_id
    );
    let cf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, call_node, bs
    );
    let arg_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    var value_insts = std::array::Array<compiled_mir::MirExprInst>(
        std::mem::page_allocator()
    );
    let value_result_id = try lower_expr_with_local_aliases(
        ir_bytes, function_name, module_prefix, locals_spec, arg_node,
        string_counter, temp_counter, &var value_insts, aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let consumed_strings = try count_strings_in_insts(&value_insts);
    let consumed_temps = value_insts.len();
    try stmts.append(compiled_mir::print_stmt(
        print_abi.transport,
        value_llvm, value_result_id, value_insts
    ));
    return MultiExprLowerResult {
        string_counter: string_counter + consumed_strings,
        temp_counter: temp_counter + consumed_temps,
        try_counter: try_counter
    };
}

// try_statement_value_node validates the shared ExprStmt(TryExpr(...)) shell and returns the
// try's operand node. General expression-statement lowering decides between free calls, method
// calls, and the non-call operand path after this point; enum-dispatch effect arms reuse the
// same structural check but intentionally admit only the free !void path.
fn try_statement_value_node(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "expr", 0, sf
    );
    let expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, expr, sf
    );
    if !std::mem::equal_bytes(expr_kind, "TryExpr") {
        return error("compiled mir: unsupported expression statement");
    }
    return try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr, "value", 0, sf
    );
}

// lower_void_try_expr_statement lowers a bare 'try <expr>;' whose operand is not a call -- the
// deferred-propagation shape 'let result = <fallible call>; <cleanup>; try result;'. The operand
// lowers through the shared expression path with no operand-kind dispatch, so any expression that
// produces an error-union value is admitted; the produced LLVM type is that error union and the
// function's own return type is the union the failure propagates through. The success value is
// discarded because the try stands in statement position.
fn lower_void_try_expr_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    value_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    var value_insts = std::array::Array<compiled_mir::MirExprInst>(
        std::mem::page_allocator()
    );
    let value_result_id = try lower_expr_with_local_aliases(
        ir_bytes, function_name, module_prefix, locals_spec, value_node,
        string_counter, temp_counter, &var value_insts, aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let called_error_union = try expr_inst_llvm_type_by_id(&value_insts, value_result_id);
    let consumed_strings = try count_strings_in_insts(&value_insts);
    let consumed_temps = value_insts.len();
    try stmts.append(compiled_mir::void_try_expr_stmt(
        llvm_return_type, called_error_union,
        string_counter, try_counter, value_result_id, value_insts
    ));
    return MultiExprLowerResult {
        string_counter: string_counter + consumed_strings,
        temp_counter: temp_counter + consumed_temps,
        try_counter: try_counter + 1
    };
}

// array_receiver_lookup_kizu_type strips the borrow markers from a receiver type
// spelling ('&var std::array::Array<T>' arrives as '&var_std::array::Array<T>') so
// the Array<T> element extraction sees the bare container type.
fn array_receiver_lookup_kizu_type(kizu_type: []u8) -> []u8 {
    let stripped = compiled_mir_types::struct_lookup_kizu_type(kizu_type);
    if std::mem::starts_with(stripped, "var_") {
        return stripped[4..std::mem::len(stripped)];
    }
    return stripped;
}

// lower_owned_deinit_expr_statement lowers a non-try '<receiver>.deinit();' expression statement.
// Exact body-call-builtin classification supplies the owned-container action; the resolved
// receiver TypeId supplies its ABI. No receiver spelling participates in the decision.
fn lower_owned_deinit_expr_statement(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    if !try callee_is_field_expr(ir_bytes, function_name, call_node, bs) {
        return error("compiled mir: non-try expression statement must be a method call");
    }
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if !builtin.found {
        return lower_void_source_method_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            call_node, string_counter, temp_counter, try_counter, aliases, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    let operation_id = builtin_contract::operation_from_name(builtin.operation);
    let owned_operation = builtin_contract::owned_container_operation(operation_id);
    if !owned_operation.found {
        // Name the function and node: a statement-position builtin call the lowering has
        // no shape for is otherwise a native rebuild per attempt to locate.
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled mir: non-try builtin is not an owned-container deinit: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" node ");
        try std::fmt::append_i64(&var message, call_node);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    if owned_operation.action != builtin_contract::owned_container_action_deinit() {
        var action_message = std::string::String(std::mem::page_allocator());
        try action_message.append_bytes(
            "compiled mir: non-try builtin is not an owned-container deinit: "
        );
        try action_message.append_bytes(function_name);
        try action_message.append_bytes(" node ");
        try std::fmt::append_i64(&var action_message, call_node);
        let action_message_bytes = action_message.as_bytes();
        return error(action_message_bytes);
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 0 {
        return error("compiled mir: deinit expression statement takes no arguments");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return lower_void_source_method_statement(
            ir_bytes, function_name, module_prefix, llvm_return_type,
            locals_spec, call_node, string_counter, temp_counter, try_counter,
            aliases, stmts, bs, ir_lookup_index, canonical_facts,
            call_arg_type_cache
        );
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, bs
    );
    let receiver_type = try compiled_mir_types::resolve_receiver_value_type_indexed_cached(
        ir_lookup_index, call_arg_type_cache, ir_bytes, function_name,
        module_prefix, receiver_name, bs
    );
    let receiver_abi = fixed_abi_contract::from_llvm(receiver_type.abi);
    if receiver_abi.kind != fixed_abi_contract::FixedAbiKind::Owned {
        return error("compiled mir: deinit receiver must lower to %kizu.owned");
    }
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    try stmts.append(compiled_mir::owned_deinit_stmt(receiver_alias));
    return MultiExprLowerResult {
        string_counter: string_counter,
        temp_counter: temp_counter,
        try_counter: try_counter
    };
}

fn lower_void_source_method_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, call_node, bs
    );
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    if !std::mem::equal_bytes(info.return_llvm_type, "void") {
        return error("compiled mir: method statement must return void");
    }
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    var arg_types = try method_call_arg_types(
        ir_bytes, function_name, module_prefix, &info, call_node, explicit_arg_count,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    defer arg_types.deinit();
    var runtime_arg_nodes = try method_runtime_arg_nodes(
        ir_bytes, function_name, call_node, bs, ir_lookup_index,
        canonical_facts, call_arg_type_cache
    );
    defer runtime_arg_nodes.deinit();
    if arg_types.len() != runtime_arg_nodes.len() + 1 {
        return error("compiled mir: source method runtime argument ABI coverage mismatch");
    }
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(method_receiver_call_arg(
        &info, try local_alias_current_name(aliases, info.receiver_name)
    ));
    var cur_locals = locals_spec;
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    var arg_index = 0;
    while arg_index < runtime_arg_nodes.len() {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let arg_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, arg_node, bs
        );
        let arg_abi = try arg_types.at(arg_index + 1);
        let arg_type = arg_abi.semantic_llvm;
        let arg_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arg_node, arg_sf
        );
        let hoist_name = try hoisted_try_arg_name(cur_try, call_arg_type_cache);
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            let hoist = try lower_hoisted_try_arg(
                ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                arg_node, hoist_name, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            cur_locals = hoist.locals_spec;
            cur_string = hoist.string_counter;
            cur_temp = hoist.temp_counter;
            cur_try = hoist.try_counter;
            try args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
        } else {
            if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
                if std::mem::equal_bytes(arg_kind, "Call") {
                    let hoist = try lower_multi_let_call(
                        ir_bytes, function_name, module_prefix, cur_locals,
                        hoist_name, arg_node, cur_string, cur_temp, cur_try,
                        aliases, stmts, bs, ir_lookup_index, canonical_facts,
                        call_arg_type_cache
                    );
                    cur_locals = hoist.locals_spec;
                    cur_string = hoist.string_counter;
                    cur_temp = hoist.temp_counter;
                } else {
                    var hoist_insts =
                        std::array::Array<compiled_mir::MirExprInst>(
                            std::mem::page_allocator()
                        );
                    let result_id = try lower_expr_with_local_aliases(
                        ir_bytes, function_name, module_prefix, cur_locals,
                        arg_node, cur_string, cur_temp, &var hoist_insts, aliases, bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    let result_type = try expr_inst_llvm_type_by_id(
                        &hoist_insts, result_id
                    );
                    if !std::mem::equal_bytes(result_type, arg_type) {
                        return error("compiled mir: hoisted source method argument type mismatch");
                    }
                    let hoist_strings = try count_strings_in_insts(&hoist_insts);
                    let hoist_inst_count = hoist_insts.len();
                    try stmts.append(compiled_mir::let_expr_stmt(
                        hoist_name, cur_string, result_id, hoist_insts
                    ));
                    cur_locals = try compiled_signature::extend_locals_spec(
                        ir_bytes, cur_locals, hoist_name, arg_type
                    );
                    cur_string = cur_string + hoist_strings;
                    cur_temp = cur_temp + hoist_inst_count;
                }
                cur_try = cur_try + 1;
                try args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
            } else {
                let arg = try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
                    ir_bytes, function_name, module_prefix, cur_locals, arg_type,
                    arg_node, cur_string, &alias_sources, &alias_currents, bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                if arg.kind == compiled_mir::MirCallArgKind::String {
                    cur_string = cur_string + 1;
                }
                try args.append(arg);
            }
        }
        arg_index = arg_index + 1;
    }
    var normalized_args = try normalize_runtime_method_args(&arg_types, args);
    try stmts.append(compiled_mir::void_call_stmt(
        info.module_prefix, info.callee_name, string_counter, normalized_args
    ));
    return MultiExprLowerResult {
        string_counter: cur_string,
        temp_counter: cur_temp,
        try_counter: cur_try
    };
}

// lower_void_free_try_call_statement lowers a bare 'try <callee>(<args>);' statement whose
// callee is a free function (not a field method) returning an error-union void success (issue
// 1201). The shape is ExprStmt(TryExpr(Call(...))) reached after lower_multi_expr_statement
// rejects the field-method form, e.g.
// 'try append_sorted_imports(out, source, &format_tokens, &leading_imports);'. It validates the
// callee returns '!void' (an error union whose success type lowers to void), resolves the callee
// symbol + args the same way lower_multi_let_try_call does, and emits a VoidTryCall statement that
// propagates a runtime failure as this function's own error union and binds no value -- mirroring
// LetTryCall's failure propagation without a bound success value (no fake local). try_counter
// advances so the try-call gets a distinct block-label pair.
// lower_void_free_call_statement lowers a non-try free-function call used as an expression
// statement ('ignore_function_param_type_fact();'). The instance-scoped call facts supply the
// callee symbol and its resolved return ABI; only a void return may be discarded here, so a
// value-producing callee is an explicit error rather than a silently dropped result.
fn lower_void_free_call_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    if !std::mem::equal_bytes(call_info.return_llvm_type, "void") {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes(
            "compiled mir: non-try free call statement must return void: "
        );
        try message.append_bytes(function_name);
        try message.append_bytes(" callee ");
        try message.append_bytes(call_info.callee_name);
        try message.append_bytes(" returns ");
        try message.append_bytes(call_info.return_llvm_type);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node,
        string_counter, aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
    try stmts.append(compiled_mir::void_call_stmt(
        call_info.module_prefix, call_info.callee_name, string_counter, args
    ));
    return MultiExprLowerResult {
        string_counter: new_counter,
        temp_counter: temp_counter,
        try_counter: try_counter
    };
}

fn lower_void_free_try_call_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    let _success_type = try compiled_mir_types::call_info_error_success_llvm(
        ir_lookup_index, canonical_facts, ir_bytes, &call_info
    );
    if try call_has_try_arg(ir_bytes, function_name, call_node, bs) {
        var arg_insts = std::array::Array<compiled_mir::MirExprInst>(
            std::mem::page_allocator()
        );
        var args = std::array::Array<compiled_mir::MirCallArg>(
            std::mem::page_allocator()
        );
        let lowered = try lower_call_args_hoisting_try_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            call_node, string_counter, temp_counter, try_counter, aliases,
            &var arg_insts, &var args, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        if arg_insts.len() != 0 {
            return error("compiled mir: void try-call computed argument was not bound");
        }
        try stmts.append(compiled_mir::void_try_call_stmt(
            llvm_return_type, call_info.return_llvm_type,
            call_info.module_prefix, call_info.callee_name,
            string_counter, lowered.try_counter, args
        ));
        return MultiExprLowerResult {
            string_counter: lowered.string_counter,
            temp_counter: lowered.temp_counter,
            try_counter: lowered.try_counter + 1
        };
    }
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
    try stmts.append(compiled_mir::void_try_call_stmt(
        llvm_return_type, call_info.return_llvm_type,
        call_info.module_prefix, call_info.callee_name,
        string_counter, try_counter, args
    ));
    return MultiExprLowerResult {
        string_counter: new_counter,
        temp_counter: temp_counter,
        try_counter: try_counter + 1
    };
}

// hoisted_try_arg_name builds the durable SSA name a hoisted 'try <call>' method-call argument
// binds its unwrapped success into ('__try_arg<slot>', issue 1157 NEW-A). The 'try
// ast.add_child(try declarations.get(index));' child-drain shape -- pervasive across parse_program /
// parse_struct_decl / parse_call_with_args -- carries an inner 'try <call>' argument with no inline
// MirCallArg descriptor, so it lowers into a preceding LetArrayGet/LetTryCall binding referenced by
// a Var call arg. slot is the inner try-call's try index, unique per function, so the synthesized
// names never collide. MirNameStore owns the generated bytes for the lifetime of the MIR lowering.
fn hoisted_try_arg_name(
    slot: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes("__try_arg");
    try std::fmt::append_i64(&var out, slot);
    return call_arg_type_cache.name_store.own(out);
}

fn lower_void_method_try_call_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiExprLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    if !std::mem::equal_bytes(info.return_llvm_type, "%kizu.error.void") {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes(
            "compiled mir: method try-call statement must return !void: "
        );
        try message.append_bytes(function_name);
        try message.append_bytes(" node ");
        try std::fmt::append_i64(&var message, call_node);
        try message.append_bytes(" callee ");
        try message.append_bytes(info.callee_name);
        try message.append_bytes(" returns ");
        try message.append_bytes(info.return_llvm_type);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    var arg_types = try method_call_arg_types(
        ir_bytes, function_name, module_prefix, &info, call_node, explicit_arg_count,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    defer arg_types.deinit();
    var runtime_arg_nodes = try method_runtime_arg_nodes(
        ir_bytes, function_name, call_node, bs, ir_lookup_index,
        canonical_facts, call_arg_type_cache
    );
    defer runtime_arg_nodes.deinit();
    let runtime_arg_count = runtime_arg_nodes.len();
    if arg_types.len() != runtime_arg_count + 1 {
        return error("compiled mir: method runtime argument ABI coverage mismatch");
    }
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(method_receiver_call_arg(
        &info,
        try local_alias_current_name(aliases, info.receiver_name)
    ));
    // A 'try <call>' method argument (e.g. 'try ast.add_child(try declarations.get(index));', the
    // child-drain loop body shared by parse_program / parse_struct_decl / parse_call_with_args) has
    // no inline call-arg descriptor: its inner try-call propagates a failure of its own. Lower each
    // such argument into a preceding LetArrayGet/LetTryCall statement that binds the unwrapped
    // success into a synthesized %__try_arg<slot> local, then pass that local by Var. The hoisted
    // let consumes the inner try index; the void call takes the next try index so their fail/cont
    // block labels never collide.
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    var cur_locals = locals_spec;
    var arg_index = 0;
    while arg_index < runtime_arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_abi = try arg_types.at(arg_index + 1);
        let arg_type = arg_abi.semantic_llvm;
        let arg_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arg_node, arg_sf
        );
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            let inner = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arg_node, "value", 0, arg_sf
            );
            let inner_sf = compiled_mir_types::fn_node_line_start(
                call_arg_type_cache, inner, bs
            );
            let inner_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, inner, inner_sf
            );
            if !std::mem::equal_bytes(inner_kind, "Call") {
                return error("compiled mir: method try-call statement try arg must wrap a call");
            }
            let hoist_name = try hoisted_try_arg_name(cur_try, call_arg_type_cache);
            var hoist_result = MultiLowerResult {
                locals_spec: cur_locals,
                string_counter: cur_string,
                temp_counter: cur_temp,
                try_counter: cur_try
            };
            if try call_is_supported_let_try_accessor_cached(
                ir_lookup_index, ir_bytes, function_name, module_prefix, cur_locals,
                inner, bs, call_arg_type_cache
            ) {
                hoist_result = try lower_multi_let_array_get(
                    ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                    hoist_name, inner, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
            } else {
                hoist_result = try lower_multi_let_try_call(
                    ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                    hoist_name, inner, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
            }
            cur_locals = hoist_result.locals_spec;
            cur_string = hoist_result.string_counter;
            cur_temp = hoist_result.temp_counter;
            cur_try = hoist_result.try_counter;
            try args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
        } else {
            if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
                let hoist_name = try hoisted_try_arg_name(cur_try, call_arg_type_cache);
                if std::mem::equal_bytes(arg_kind, "Call") {
                    let hoist_result = try lower_multi_let_call(
                        ir_bytes, function_name, module_prefix, cur_locals,
                        hoist_name, arg_node, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    cur_locals = hoist_result.locals_spec;
                    cur_string = hoist_result.string_counter;
                    cur_temp = hoist_result.temp_counter;
                } else {
                    var hoist_insts =
                        std::array::Array<compiled_mir::MirExprInst>(
                            std::mem::page_allocator()
                        );
                    let hoist_result_id = try lower_expr_with_local_aliases(
                        ir_bytes, function_name, module_prefix, cur_locals,
                        arg_node, cur_string, cur_temp, &var hoist_insts, aliases, bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    let hoist_type = try expr_inst_llvm_type_by_id(
                        &hoist_insts, hoist_result_id
                    );
                    if !std::mem::equal_bytes(hoist_type, arg_type) {
                        return error("compiled mir: hoisted method argument type mismatch");
                    }
                    let hoist_strings = try count_strings_in_insts(&hoist_insts);
                    let hoist_inst_count = hoist_insts.len();
                    try stmts.append(compiled_mir::let_expr_stmt(
                        hoist_name, cur_string, hoist_result_id, hoist_insts
                    ));
                    cur_locals = try compiled_signature::extend_locals_spec(
                        ir_bytes, cur_locals, hoist_name, arg_type
                    );
                    cur_string = cur_string + hoist_strings;
                    cur_temp = cur_temp + hoist_inst_count;
                }
                // Each synthesized binding consumes one slot even when it has no try labels,
                // keeping later hoist names distinct from this void call's try index.
                cur_try = cur_try + 1;
                try args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
            } else {
                let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_type,
                    arg_node,
                    cur_string,
                    &alias_sources,
                    &alias_currents,
                    bs,
                    ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
                if is_string_arg {
                    cur_string = cur_string + 1;
                }
                try args.append(scalar_arg);
            }
        }
        arg_index = arg_index + 1;
    }
    var normalized_args = try normalize_runtime_method_args(&arg_types, args);
    try stmts.append(compiled_mir::void_try_call_stmt(
        llvm_return_type, info.storage_return_llvm_type,
        info.module_prefix, info.callee_name,
        cur_string, cur_try, normalized_args
    ));
    return MultiExprLowerResult {
        string_counter: cur_string,
        temp_counter: cur_temp,
        try_counter: cur_try + 1
    };
}

// lower_string_method_arg lowers the single argument of a String append method into the call
// argument array, returning the number of string-literal global slots it consumed (issue 1165
// slice 1). A local argument resolves to a Var call arg of the method's fixed LLVM type, a
// string literal resolves to a String call arg seeded at string_index, and a scalar cast over an
// integer literal resolves to an IntLiteral only after the cast target lowers to the method's
// expected LLVM argument type.
fn lower_string_method_arg(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    arg_type: []u8,
    arg_node: i64,
    string_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    args: &var std::array::Array<compiled_mir::MirCallArg>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, sf);
    if std::mem::equal_bytes(arg_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, sf
        );
        try args.append(compiled_mir::var_call_arg(
            arg_type, try local_alias_current_name(aliases, var_name)
        ));
        return 0;
    }
    if std::mem::equal_bytes(arg_kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, arg_node, sf
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid call string token"
        );
        try args.append(compiled_mir::string_call_arg(arg_type, token, string_index));
        return 1;
    }
    if std::mem::equal_bytes(arg_kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arg_node, "type", 0, sf
        );
        let type_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, type_node, bs
        );
        let type_text = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, type_sf
        );
        let target_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index, ir_bytes, module_prefix, type_text
        );
        if !std::mem::equal_bytes(target_llvm, arg_type) {
            return error("compiled mir: string method cast argument type mismatch");
        }
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arg_node, "value", 0, sf
        );
        let value_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, value_node, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value_node, value_sf
        );
        if !std::mem::equal_bytes(value_kind, "Int") {
            return error("compiled mir: unsupported string method cast operand");
        }
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, value_node, value_sf
        );
        try args.append(compiled_mir::int_literal_call_arg(arg_type, literal));
        return 0;
    }
    if std::mem::equal_bytes(arg_kind, "FieldExpr") {
        // A struct-field read argument (e.g. 'code.append(right_eval.next)') reuses the
        // shared call-arg field lowering; it consumes no string slot. It resolves through the
        // local aliases so a receiver reassigned by a branch merge ('methods.append(method.node)'
        // after 'method' is reseated in an if/else) reads the merged value, not the let-init.
        try args.append(try lower_single_call_arg_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, "", arg_type, arg_node,
            string_index, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        ));
        return 0;
    }
    if std::mem::equal_bytes(arg_kind, "Call") {
        // A nested call argument (e.g. 'tags.append(name_node_with_doc(ast, tag, ...))')
        // reuses the shared call-arg lowering, which emits a nested call descriptor whose
        // own operands are non-literal here, so it consumes no string slot. Its operands resolve
        // through the local aliases for the same branch-merge reason as the field-read arg above.
        try args.append(try lower_single_call_arg_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, "", arg_type, arg_node,
            string_index, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        ));
        return 0;
    }
    // A bare integer literal argument (e.g. 'args_scratch.append(0)' growing the
    // call-arg scratch stack, or a slot-0 stack-pointer read/write index) lowers
    // to an inline literal; it consumes no string slot.
    if std::mem::equal_bytes(arg_kind, "Int") {
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, arg_node, sf
        );
        try args.append(compiled_mir::int_literal_call_arg(arg_type, literal));
        return 0;
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled mir: unsupported string method argument: ");
    try message.append_bytes(function_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, arg_node);
    try message.append_bytes(" kind ");
    try message.append_bytes(arg_kind);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}
// lower_multi_let_statement lowers a 'let'/'var' binding. It resolves the binding's emitted SSA
// name first: a name bound more than once in the function is shadowed, so it takes a
// per-binding-unique '<source>.shadow.<node>' name and, after the value is lowered, redirects
// later reads of the source name through the local-alias map (the same indirection
// lower_multi_assign_statement uses). The alias is set *after* lower_multi_let_statement_named
// returns so a self-referential initializer ('let x = x + 1' shadowing an outer x) still reads
// the outer binding while its own value is lowered. Type resolution is unaffected: it resolves a
// name from the IR let-binding scan, not from the emitted SSA name.
fn lower_multi_let_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // sf tightens this Let statement's own structural facts (its 'name' edge / name token) to its
    // body-node line via the index; those facts sort at-or-after it, so a scan from sf is
    // byte-identical to one from bs. let_binding_is_shadowed scans for sibling bindings that can
    // precede this node, so it keeps bs, as does the named-lowering recursion below.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let let_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "name", 0, sf
    );
    let source_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, let_name_node, sf
    );
    let shadowed = try let_binding_is_shadowed(ir_bytes, function_name, source_name, bs);
    // A reserved name is renamed the same way a shadowed one is, but it is shadowing nothing: the
    // join-merge rule that skips shadowed names must keep treating it as an ordinary binding, so
    // the two answers stay apart rather than folding into one flag.
    let reserved = llvm_reserved_local_name(source_name);
    var emit_name = source_name;
    if shadowed or reserved {
        emit_name = try shadow_binding_name(source_name, statement, call_arg_type_cache);
    }
    let result = try lower_multi_let_statement_named(
        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, statement,
        source_name, emit_name, string_counter, temp_counter, try_counter, aliases, stmts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    if shadowed or reserved {
        try set_local_alias(aliases, source_name, emit_name);
    }
    return result;
}

// loop_seed_is_foldable reports whether a loop-seed declaration can be dropped in favour of the
// loop head's own definition. The loop rebuilds the seed at its preheader, which is free and
// unobservable for a pure expression over locals. A call is neither: rebuilding it there moves the
// work past every statement between the declaration and the loop, and dropping it leaves the reads
// in between naming a value only the loop head defines, later still. That is what
// cli::check::package_fast_diagnostics does -- 'var ok = try parse_package_fast_diagnostic_sources
// (..)', then 'if ok', then a while that carries ok.
fn loop_seed_is_foldable(
    ir_bytes: []u8,
    function_name: []u8,
    let_statement: i64,
    bs: i64
) -> !bool {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_statement, "value", 0, bs
    );
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if std::mem::equal_bytes(kind, "Call") {
        return false;
    }
    if std::mem::equal_bytes(kind, "TryExpr") {
        return false;
    }
    return true;
}

// loop_seed_must_stay_in_place answers whether a declaration a later while carries has to be
// emitted where it stands. Folding it into the loop head means the loop rebuilds the value at its
// preheader, and that is sound only when nothing can observe the declaration first. Two things have
// to hold for it not to be: the value cannot be rebuilt without moving work -- a call -- and the
// loop is not the very next statement, so something runs in between that could read it. A
// call-seeded induction counter declared immediately ahead of its loop keeps its existing preheader
// init; 'var ok = try parse_package_fast_diagnostic_sources(..)' with an 'if ok' before the loop
// that carries ok does not.
// The test is the statement's position in its scope, not its node number: a statement between the
// two that merely could read the name is enough, and answering that way needs no assumption about
// how subtree nodes are numbered relative to their parent.
fn loop_seed_must_stay_in_place(
    ir_bytes: []u8,
    function_name: []u8,
    scope_node: i64,
    let_statement: i64,
    statement_count: i64,
    bs: i64
) -> !bool {
    if try loop_seed_is_foldable(ir_bytes, function_name, let_statement, bs) {
        return false;
    }
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, name_node, bs
    );
    var let_index = -1;
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, scope_node, "statement", index, bs
        );
        if statement == let_statement {
            let_index = index;
        }
        if let_index >= 0 and index > let_index {
            let kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, statement, bs
            );
            if std::mem::equal_bytes(kind, "While") {
                if try while_carries_induction_var(
                    ir_bytes, function_name, statement, let_name, bs
                ) {
                    return index > let_index + 1;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// loop_seed_binding_name spells the name such a declaration binds. It is keyed by the declaration's
// own node, so it is unique in the function and cannot collide with the loop head's %<name>.
fn loop_seed_binding_name(
    source_name: []u8,
    statement: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if statement < 0 {
        return error("compiled mir: negative loop seed binding slot");
    }
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes(source_name);
    try out.append_bytes(".seed.");
    try std::fmt::append_i64(&var out, statement);
    return call_arg_type_cache.name_store.own(out);
}

// lower_loop_seed_binding_in_place emits a loop-seed declaration the loop must not rebuild. It
// stays where it stands, under a name of its own so the loop head is still free to define %<name>,
// and the alias map points both the reads between here and the loop, and the loop's own seed, at
// the value this statement actually produced.
fn lower_loop_seed_binding_in_place(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let let_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "name", 0, sf
    );
    let source_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, let_name_node, sf
    );
    let emit_name = try loop_seed_binding_name(source_name, statement, call_arg_type_cache);
    let result = try lower_multi_let_statement_named(
        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec, statement,
        source_name, emit_name, string_counter, temp_counter, try_counter, aliases, stmts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    try set_local_alias(aliases, source_name, emit_name);
    return result;
}

fn lower_multi_let_statement_named(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    binding_name: []u8,
    let_name: []u8,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // sf tightens this Let statement's own structural facts (its 'value' subtree: kind/edges,
    // callee detail, arg edges) to its body-node line via the index; the whole subtree sorts
    // at-or-after it, so a scan from sf is byte-identical to one from bs. Type/name resolution
    // (method_call_info, ast_get_receiver_is_ast, struct-field/return-type resolvers) and the
    // expr/call lowering recursion keep bs because they read let/param facts that can precede
    // this node (the index-keyed return/struct-type resolvers tighten their own structural read).
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let let_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, sf
    );
    let let_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, let_value, sf);
    // 'let <name> = match <scrutinee> { .. };' binds the dispatch's value: every arm lowers its
    // body expression into an arm-unique SSA name and the join merges them into <name>. The arms
    // supply the bound ABI, so no declared-type lookup is needed here.
    if std::mem::equal_bytes(let_value_kind, "Match") {
        // The dispatch lowering only reads the incoming aliases (it copies them per arm), so a
        // local copy satisfies its mutable parameter without exposing this statement's aliases.
        var match_aliases = try copy_local_aliases(aliases);
        defer match_aliases.deinit();
        let match_result = try lower_multi_match_statement(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            let_value,
            string_counter,
            temp_counter,
            try_counter,
            &var match_aliases,
            stmts,
            bs,
            ir_lookup_index,
            canonical_facts,
            call_arg_type_cache,
            false,
            let_name,
            ""
        );
        let bound_locals = try compiled_signature::extend_locals_spec(
            ir_bytes, locals_spec, let_name, match_result.result_llvm
        );
        try compiled_mir_types::bind_exact_local_llvm_type(
            call_arg_type_cache, let_name, match_result.result_llvm
        );
        return MultiLowerResult {
            locals_spec: bound_locals,
            string_counter: match_result.string_counter,
            temp_counter: match_result.temp_counter,
            try_counter: match_result.try_counter
        };
    }
    // A 'let <name> = try <callee>(<args>);' try-call over an error-union-returning free
    // function (the node_count traversal cluster, tracker 961). It lowers to a LetTryCall
    // statement: call the error union, branch on its ok flag, propagate the failure as this
    // function's own error union, and bind the success value.
    if std::mem::equal_bytes(let_value_kind, "TryExpr") {
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, let_value, "value", 0, sf
        );
        let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, sf);
        if !std::mem::equal_bytes(inner_kind, "Call") {
            return error("compiled mir: try let value must wrap a call");
        }
        // 'let next = try tokens.get(<expr>);' on a value-receiver Array<T> binds the
        // element by value off the checked array_at builtin and propagates a failure as
        // this function's own error union (issue 1165). The callee is a field-mode method,
        // so it is routed ahead of the free-function try-call path.
        if try call_is_supported_let_try_accessor_cached(
            ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
            inner, bs, call_arg_type_cache
        ) {
            return try lower_multi_let_array_get(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                let_name, inner, string_counter, temp_counter, try_counter, aliases, stmts,
                bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        return try lower_multi_let_try_call(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            let_name, inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(let_value_kind, "Call") {
        // A Call whose callee is a field-mode method is the checked Arena<T>.add
        // lowering (self.<field>.add(<struct literal>)), binding the appended slot
        // index. Ast.add_node is its first consumer (tracker 961). The element struct
        // consumes string_counter prefixes for its insertvalue chain, so the counter
        // advances by the element field count to keep later struct temps distinct.
        if try callee_is_field_expr_cached(ir_bytes, function_name, let_value, bs, call_arg_type_cache) {
            // 'let node = ast.get(<node_id>);' binds an AstNode by value off the
            // compiled external std::kizu::ast accessor in any statement position
            // (the match-union shapes special-case statement 0; this serves the rest).
            if try call_method_name_is(ir_bytes, function_name, let_value, "get", sf) {
                if try call_returns_spanned_node(
                    ir_lookup_index, ir_bytes, function_name, let_value
                ) {
                    return try lower_multi_let_ast_get(
                        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                        let_name, let_value, string_counter, temp_counter,
                        try_counter, aliases, stmts, bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                }
            }
            // 'let base = local_starts.len();' binds a value-receiver length read;
            // it lowers through the generic expression path (which already models
            // .len() on owned containers) as a let-expr statement.
            if try call_method_name_is(ir_bytes, function_name, let_value, "len", sf) {
                var len_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                let len_result_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    let_value,
                    string_counter,
                    temp_counter,
                    &var len_insts,
                    aliases,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                let len_inst_count = len_insts.len();
                let len_locals = try compiled_signature::extend_locals_spec(
                    ir_bytes, locals_spec, let_name, "i64"
                );
                try stmts.append(compiled_mir::let_expr_stmt(
                    let_name, string_counter, len_result_id, len_insts
                ));
                return MultiLowerResult {
                    locals_spec: len_locals,
                    string_counter: string_counter,
                    temp_counter: temp_counter + len_inst_count,
                    try_counter: try_counter
                };
            }
            // A value-receiver method with a real signature (for example
            // ast.add_bool(...)) lowers as a normal call expression with the receiver
            // passed as arg 0. Field receivers such as self.nodes.add(...) stay on the
            // Arena.add lowering below.
            if try call_method_receiver_is_var(ir_bytes, function_name, let_value, sf) {
                if try call_has_try_arg(ir_bytes, function_name, let_value, sf) {
                    let info = try method_call_info(
                        ir_bytes, function_name, module_prefix, locals_spec, let_value, bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    var method_arg_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                    var method_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
                    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
                        ir_bytes, function_name, let_value, sf, call_arg_type_cache
                    );
                    var method_arg_abis = try method_call_arg_types(
                        ir_bytes, function_name, module_prefix, &info, let_value,
                        explicit_arg_count, ir_lookup_index, canonical_facts,
                        call_arg_type_cache
                    );
                    defer method_arg_abis.deinit();
                    let lowered = try lower_method_call_args_hoisting_try_args_with_local_aliases(
                        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                        let_value, string_counter, temp_counter, try_counter, aliases,
                        &info, &method_arg_abis,
                        &var method_arg_insts, &var method_args, stmts, bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    var normalized_method_args = try normalize_runtime_method_args(
                        &method_arg_abis, method_args
                    );
                    let new_locals = try compiled_signature::extend_locals_spec(
                        ir_bytes, lowered.locals_spec, let_name, info.return_llvm_type
                    );
                    try compiled_mir_types::bind_exact_local_llvm_type(
                        call_arg_type_cache, binding_name, info.return_llvm_type
                    );
                    let semantic_result = match info.result_transport {
                        Semantic => true,
                        _ => false,
                    };
                    if method_arg_insts.len() > 0 or !semantic_result {
                        let result_id = lowered.temp_counter;
                        if !semantic_result {
                            try method_arg_insts.append(try compiled_mir::storage_call_expr_inst(
                                result_id, info.return_llvm_type, info.storage_return_llvm_type,
                                info.success_llvm_type,
                                info.result_transport,
                                info.module_prefix, info.callee_name, normalized_method_args
                            ));
                        } else {
                            try method_arg_insts.append(compiled_mir::call_expr_inst(
                                result_id, info.return_llvm_type, info.module_prefix,
                                info.callee_name, normalized_method_args
                            ));
                        }
                        try stmts.append(compiled_mir::let_expr_stmt(
                            let_name, string_counter, result_id, method_arg_insts
                        ));
                        return MultiLowerResult {
                            locals_spec: new_locals,
                            string_counter: lowered.string_counter,
                            temp_counter: lowered.temp_counter + 1,
                            try_counter: lowered.try_counter
                        };
                    } else {
                        try stmts.append(compiled_mir::let_call_stmt(
                            let_name, info.return_llvm_type, lowered.string_counter,
                            info.module_prefix, info.callee_name,
                            normalized_method_args
                        ));
                        return MultiLowerResult {
                            locals_spec: new_locals,
                            string_counter: lowered.string_counter,
                            temp_counter: lowered.temp_counter,
                            try_counter: lowered.try_counter
                        };
                    }
                }
                var method_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
                let method_result_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    let_value,
                    string_counter,
                    temp_counter,
                    &var method_insts,
                    aliases,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                let method_strings = try count_strings_in_insts(&method_insts);
                let method_inst_count = method_insts.len();
                try stmts.append(compiled_mir::let_expr_stmt(
                    let_name, string_counter, method_result_id, method_insts
                ));
                return MultiLowerResult {
                    locals_spec: locals_spec,
                    string_counter: string_counter + method_strings,
                    temp_counter: temp_counter + method_inst_count,
                    try_counter: try_counter
                };
            }
            return try lower_multi_let_arena_add(
                ir_bytes, function_name, module_prefix, locals_spec,
                let_name, let_value, string_counter, temp_counter, try_counter, stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        // Runtime-owned sequence construction is an orthogonal frontend fact derived from
        // exact TypeIds. It covers source nominal constructors and direct builtins uniformly.
        let owned_constructor = try compiled_type_resolver::owned_constructor_indexed(
            ir_lookup_index, ir_bytes, function_name, let_value
        );
        if owned_constructor.found {
            let constructor_runtime = builtin_contract::owned_container_constructor_runtime(
                owned_constructor.family
            );
            if !constructor_runtime.found {
                return error("compiled mir: unsupported owned constructor runtime ABI");
            }
            let ctor_arg_count = try compiled_mir_types::count_call_args_cached(
                ir_bytes, function_name, let_value, sf, call_arg_type_cache
            );
            if ctor_arg_count != 1 {
                return error("compiled mir: owned constructor takes exactly the allocator argument");
            }
            let alloc_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, let_value, "arg", 0, sf
            );
            let constructor_types = try parsed_call_type_for_node(
                canonical_facts, ir_bytes, function_name, let_value,
                call_arg_type_cache
            );
            if constructor_types.runtime_len != 1 {
                return error(
                    "compiled mir: owned constructor canonical allocator argument missing"
                );
            }
            let allocator_type_id =
                try compiled_canonical_facts::parsed_call_runtime_type_id(
                    canonical_facts, &constructor_types, 0
                );
            let allocator_identity =
                try compiled_canonical_facts::parsed_canonical_identity(
                    canonical_facts, allocator_type_id
                );
            if !std::mem::equal_bytes(allocator_identity, "Allocator") {
                return error("compiled mir: owned constructor argument is not an Allocator");
            }
            let allocator_abi =
                try compiled_canonical_facts::parsed_canonical_runtime_abi(
                    ir_lookup_index, canonical_facts, ir_bytes, allocator_type_id
                );
            let alloc_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, alloc_node, sf
            );
            var alloc_alias = ir_bytes[0..0];
            var constructor_string_counter = string_counter;
            var constructor_temp_counter = temp_counter;
            if std::mem::equal_bytes(alloc_kind, "Var") {
                let alloc_name = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, alloc_node, sf
                );
                alloc_alias = try local_alias_current_name(aliases, alloc_name);
            } else {
                var allocator_insts =
                    std::array::Array<compiled_mir::MirExprInst>(
                        std::mem::page_allocator()
                    );
                let allocator_result = try lower_expr_with_local_aliases(
                    ir_bytes, function_name, module_prefix, locals_spec,
                    alloc_node, string_counter, temp_counter,
                    &var allocator_insts, aliases, bs, ir_lookup_index,
                    canonical_facts, call_arg_type_cache
                );
                let lowered_allocator_abi = try expr_inst_llvm_type_by_id(
                    &allocator_insts, allocator_result
                );
                if !std::mem::equal_bytes(
                    lowered_allocator_abi, allocator_abi
                ) {
                    return error(
                        "compiled mir: owned constructor allocator ABI mismatch"
                    );
                }
                var allocator_name =
                    std::string::String(std::mem::page_allocator());
                try allocator_name.append_bytes(let_name);
                try allocator_name.append_bytes(".allocator.");
                try std::fmt::append_i64(&var allocator_name, alloc_node);
                alloc_alias =
                    try call_arg_type_cache.name_store.own(allocator_name);
                constructor_string_counter =
                    string_counter + try count_strings_in_insts(&allocator_insts);
                constructor_temp_counter =
                    temp_counter + allocator_insts.len();
                try stmts.append(compiled_mir::let_expr_stmt(
                    alloc_alias, string_counter, allocator_result,
                    allocator_insts
                ));
            }
            let owned_locals = try compiled_signature::extend_locals_spec(
                ir_bytes, locals_spec, let_name, owned_constructor.result_type.full_spelling
            );
            try compiled_mir_types::bind_exact_local_llvm_type(
                call_arg_type_cache, binding_name, owned_constructor.result_type.abi
            );
            var constructor_args = std::array::Array<compiled_mir::MirCallArg>(
                std::mem::page_allocator()
            );
            try constructor_args.append(compiled_mir::var_call_arg(
                allocator_abi, alloc_alias
            ));
            if constructor_runtime.type_size_argument_slot >= 0 {
                if !owned_constructor.type_arguments_concrete or
                    std::mem::len(owned_constructor.storage_type.abi) == 0 {
                    return error("compiled mir: owned constructor storage type is not concrete");
                }
                try constructor_args.append(try compiled_mir::type_size_call_arg(
                    owned_constructor.storage_type.abi
                ));
            }
            try stmts.append(compiled_mir::let_call_stmt(
                let_name, owned_constructor.result_type.abi,
                constructor_string_counter,
                "", constructor_runtime.symbol, constructor_args
            ));
            return MultiLowerResult {
                locals_spec: owned_locals,
                string_counter: constructor_string_counter,
                temp_counter: constructor_temp_counter,
                try_counter: try_counter
            };
        }
        // Some call arguments have no inline MirCallArg descriptor: nested calls,
        // struct literals, namespace field values, and checked single-element index loads.
        // Lower those calls through the generic expression path so each computed argument
        // is materialized into a temp first, mirroring return-statement handling.
        if try call_has_try_arg(ir_bytes, function_name, let_value, sf) {
            let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
                ir_lookup_index, canonical_facts, ir_bytes,
                function_name, module_prefix, let_value, sf, call_arg_type_cache
            );
            var call_arg_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            var call_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
            let lowered = try lower_call_args_hoisting_try_args_with_local_aliases_cached(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                let_value, string_counter, temp_counter, try_counter, aliases,
                &var call_arg_insts, &var call_args, stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let new_locals = try compiled_signature::extend_locals_spec(
                ir_bytes, lowered.locals_spec, let_name, call_info.return_llvm_type
            );
            try compiled_mir_types::bind_exact_local_llvm_type(
                call_arg_type_cache, binding_name, call_info.return_llvm_type
            );
            if call_arg_insts.len() > 0 {
                let result_id = lowered.temp_counter;
                try call_arg_insts.append(compiled_mir::call_expr_inst(
                    result_id, call_info.return_llvm_type,
                    call_info.module_prefix, call_info.callee_name, call_args
                ));
                try stmts.append(compiled_mir::let_expr_stmt(
                    let_name, string_counter, result_id, call_arg_insts
                ));
                return MultiLowerResult {
                    locals_spec: new_locals,
                    string_counter: lowered.string_counter,
                    temp_counter: lowered.temp_counter + 1,
                    try_counter: lowered.try_counter
                };
            } else {
                try stmts.append(compiled_mir::let_call_stmt(
                    let_name, call_info.return_llvm_type, lowered.string_counter,
                    call_info.module_prefix, call_info.callee_name, call_args
                ));
                return MultiLowerResult {
                    locals_spec: new_locals,
                    string_counter: lowered.string_counter,
                    temp_counter: lowered.temp_counter,
                    try_counter: lowered.try_counter
                };
            }
        }
        if try call_has_hoisted_arg_cached(
            ir_bytes, function_name, let_value, bs, call_arg_type_cache
        ) {
            var nested_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let nested_result_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                let_value,
                string_counter,
                temp_counter,
                &var nested_insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let nested_strings = try count_strings_in_insts(&nested_insts);
            let nested_inst_count = nested_insts.len();
            let nested_call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
                ir_lookup_index, canonical_facts, ir_bytes,
                function_name, module_prefix, let_value, bs, call_arg_type_cache
            );
            let nested_locals = try compiled_signature::extend_locals_spec(
                ir_bytes, locals_spec, let_name, nested_call_info.return_llvm_type
            );
            try compiled_mir_types::bind_exact_local_llvm_type(
                call_arg_type_cache, binding_name, nested_call_info.return_llvm_type
            );
            try stmts.append(compiled_mir::let_expr_stmt(
                let_name, string_counter, nested_result_id, nested_insts
            ));
            return MultiLowerResult {
                locals_spec: nested_locals,
                string_counter: string_counter + nested_strings,
                temp_counter: temp_counter + nested_inst_count,
                try_counter: try_counter
            };
        }
        let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, let_value, sf, call_arg_type_cache
        );
        let args = try lower_call_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, let_value, string_counter, aliases, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let new_locals = try compiled_signature::extend_locals_spec(
            ir_bytes, locals_spec, let_name, call_info.return_llvm_type
        );
        try compiled_mir_types::bind_exact_local_llvm_type(
            call_arg_type_cache, binding_name, call_info.return_llvm_type
        );
        let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
        try stmts.append(compiled_mir::let_call_stmt(
            let_name, call_info.return_llvm_type, string_counter,
            call_info.module_prefix, call_info.callee_name, args
        ));
        return MultiLowerResult {
            locals_spec: new_locals,
            string_counter: new_counter,
            temp_counter: temp_counter,
            try_counter: try_counter
        };
    }
    if std::mem::equal_bytes(let_value_kind, "StructLiteralExpr") {
        let struct_type = try compiled_signature::resolve_struct_literal_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, let_value, bs
        );
        let fields = try compiled_mir_lower_struct::lower_struct_fields(
            ir_bytes, function_name, module_prefix, locals_spec, let_value, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let field_count = fields.len();
        let new_locals = try compiled_signature::extend_locals_spec(
            ir_bytes, locals_spec, let_name, struct_type
        );
        try stmts.append(compiled_mir::let_struct_stmt(
            let_name, struct_type, string_counter, fields
        ));
        return MultiLowerResult {
            locals_spec: new_locals,
            string_counter: string_counter + field_count,
            temp_counter: temp_counter,
            try_counter: try_counter
        };
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        let_value,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    let expr_type = try expr_inst_llvm_type_by_id(&insts, result_id);
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, expr_type
    );
    try stmts.append(compiled_mir::let_expr_stmt(
        let_name, string_counter, result_id, insts
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: string_counter + expr_strings,
        temp_counter: next_temp,
        try_counter: try_counter
    };
}

fn lower_try_call_args_with_local_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    arg_insts: &var std::array::Array<compiled_mir::MirExprInst>,
    args: &var std::array::Array<compiled_mir::MirCallArg>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !TryCallArgsLowerResult {
    // cf is this call node's body-node line via the per-function index (pillar A, O(1)); its callee
    // detail and arg edges sort at-or-after it, so a scan from cf is byte-identical to one from bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    var runtime_arg_nodes =
        try compiled_mir_lower_call::canonical_runtime_arg_nodes(
            ir_bytes, function_name, call_node, bs, ir_lookup_index,
            &call_info.types
        );
    defer runtime_arg_nodes.deinit();
    let arg_count = runtime_arg_nodes.len();
    var arg_types = std::array::Array<[]u8>(std::mem::page_allocator());
    defer arg_types.deinit();
    var type_index = 0;
    while type_index < arg_count {
        let type_id = try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &call_info.types, type_index
        );
        try arg_types.append(
            try compiled_canonical_facts::parsed_canonical_runtime_abi(
                ir_lookup_index, canonical_facts, ir_bytes, type_id
            )
        );
        type_index = type_index + 1;
    }
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var arg_index = 0;
    var string_idx = string_counter;
    while arg_index < arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        // af tightens this argument's own structural reads (its hoist-kind check and scalar
        // lowering) to its body-node line; the expr-lowering recursion keeps bs (it re-tightens
        // internally through its own per-function index lookup).
        let af = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index);
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, af) {
            let before = arg_insts.len();
            let temp_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                arg_node,
                string_idx,
                temp_counter,
                arg_insts,
                aliases,
                bs,
                ir_lookup_index,
                canonical_facts,
                call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(arg_insts, before);
            try args.append(try call_arg_for_lowered_expr(arg_insts, arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                arg_type,
                arg_node,
                string_idx,
                &alias_sources,
                &alias_currents,
                bs,
                ir_lookup_index,
                canonical_facts,
                call_arg_type_cache
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    let arg_inst_count = arg_insts.len();
    return TryCallArgsLowerResult {
        string_counter: string_idx,
        temp_counter: temp_counter + arg_inst_count
    };
}

fn lower_hoisted_try_arg(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    arg_node: i64,
    hoist_name: []u8,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "value", 0, arg_sf
    );
    let inner_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, inner, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, inner, inner_sf
    );
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: try call argument must wrap a call");
    }
    if try call_is_supported_let_try_accessor_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
        inner, bs, call_arg_type_cache
    ) {
        return try lower_multi_let_array_get(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            hoist_name, inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    return try lower_multi_let_try_call(
        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
        hoist_name, inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
}

fn lower_call_args_hoisting_try_args_with_local_aliases_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    arg_insts: &var std::array::Array<compiled_mir::MirExprInst>,
    out_args: &var std::array::Array<compiled_mir::MirCallArg>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !TryArgCallArgsLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    var runtime_arg_nodes =
        try compiled_mir_lower_call::canonical_runtime_arg_nodes(
            ir_bytes, function_name, call_node, bs, ir_lookup_index,
            &call_info.types
        );
    defer runtime_arg_nodes.deinit();
    let arg_count = runtime_arg_nodes.len();
    var arg_types = std::array::Array<[]u8>(std::mem::page_allocator());
    defer arg_types.deinit();
    var type_index = 0;
    while type_index < arg_count {
        let type_id = try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &call_info.types, type_index
        );
        try arg_types.append(
            try compiled_canonical_facts::parsed_canonical_runtime_abi(
                ir_lookup_index, canonical_facts, ir_bytes, type_id
            )
        );
        type_index = type_index + 1;
    }
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var cur_locals = locals_spec;
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index);
        let arg_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arg_node, arg_sf
        );
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            let hoist_name = try hoisted_try_arg_name(cur_try, call_arg_type_cache);
            let hoist_result = try lower_hoisted_try_arg(
                ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                arg_node, hoist_name, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            cur_locals = hoist_result.locals_spec;
            cur_string = hoist_result.string_counter;
            cur_temp = hoist_result.temp_counter;
            cur_try = hoist_result.try_counter;
            try out_args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
        } else {
            if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
                let before = arg_insts.len();
                let temp_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_node,
                    cur_string,
                    cur_temp - before,
                    arg_insts,
                    aliases,
                    bs,
                    ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                cur_string = cur_string + try count_strings_in_insts_from(arg_insts, before);
                cur_temp = cur_temp + arg_insts.len() - before;
                try out_args.append(try call_arg_for_lowered_expr(arg_insts, arg_type, temp_id));
            } else {
                let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_type,
                    arg_node,
                    cur_string,
                    &alias_sources,
                    &alias_currents,
                    bs,
                    ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                if scalar_arg.kind == compiled_mir::MirCallArgKind::String {
                    cur_string = cur_string + 1;
                }
                try out_args.append(scalar_arg);
            }
        }
        arg_index = arg_index + 1;
    }
    return TryArgCallArgsLowerResult {
        locals_spec: cur_locals,
        string_counter: cur_string,
        temp_counter: cur_temp,
        try_counter: cur_try
    };
}

fn lower_method_call_args_hoisting_try_args_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    info: &MethodCallInfo,
    arg_types: &std::array::Array<RuntimeArgAbi>,
    arg_insts: &var std::array::Array<compiled_mir::MirExprInst>,
    out_args: &var std::array::Array<compiled_mir::MirCallArg>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !TryArgCallArgsLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    var runtime_arg_nodes = try method_runtime_arg_nodes(
        ir_bytes, function_name, call_node, bs, ir_lookup_index,
        canonical_facts, call_arg_type_cache
    );
    defer runtime_arg_nodes.deinit();
    let explicit_arg_count = runtime_arg_nodes.len();
    if arg_types.len() != explicit_arg_count + 1 {
        return error("compiled mir: method runtime argument ABI coverage mismatch");
    }
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    try out_args.append(method_receiver_call_arg(
        info,
        try local_alias_current_name(aliases, info.receiver_name)
    ));
    var cur_locals = locals_spec;
    var cur_string = string_counter;
    var cur_temp = temp_counter;
    var cur_try = try_counter;
    var arg_index = 0;
    while arg_index < explicit_arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_abi = try arg_types.at(arg_index + 1);
        let arg_type = arg_abi.semantic_llvm;
        let arg_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arg_node, arg_sf
        );
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            let hoist_name = try hoisted_try_arg_name(cur_try, call_arg_type_cache);
            let hoist_result = try lower_hoisted_try_arg(
                ir_bytes, function_name, module_prefix, llvm_return_type, cur_locals,
                arg_node, hoist_name, cur_string, cur_temp, cur_try, aliases, stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            cur_locals = hoist_result.locals_spec;
            cur_string = hoist_result.string_counter;
            cur_temp = hoist_result.temp_counter;
            cur_try = hoist_result.try_counter;
            try out_args.append(compiled_mir::var_call_arg(arg_type, hoist_name));
        } else {
            if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
                let before = arg_insts.len();
                let temp_id = try lower_expr_with_local_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_node,
                    cur_string,
                    cur_temp - before,
                    arg_insts,
                    aliases,
                    bs,
                    ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                cur_string = cur_string + try count_strings_in_insts_from(arg_insts, before);
                cur_temp = cur_temp + arg_insts.len() - before;
                try out_args.append(try call_arg_for_lowered_expr(arg_insts, arg_type, temp_id));
            } else {
                let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    cur_locals,
                    arg_type,
                    arg_node,
                    cur_string,
                    &alias_sources,
                    &alias_currents,
                    bs,
                    ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                if scalar_arg.kind == compiled_mir::MirCallArgKind::String {
                    cur_string = cur_string + 1;
                }
                try out_args.append(scalar_arg);
            }
        }
        arg_index = arg_index + 1;
    }
    return TryArgCallArgsLowerResult {
        locals_spec: cur_locals,
        string_counter: cur_string,
        temp_counter: cur_temp,
        try_counter: cur_try
    };
}

// lower_multi_let_try_call lowers a 'let <name> = try <callee>(<args>);' try-call into a
// LetTryCall statement (tracker 961). It resolves the callee's error-union return type
// (called_error_union), the unwrapped success type the bind takes, the callee symbol +
// args, and threads this function's own error-union return type for the failure
// propagation. try_counter advances so each try-call gets a distinct block-label pair.
fn lower_multi_let_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    if try call_is_supported_let_try_accessor_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
        call_node, bs, call_arg_type_cache
    ) {
        return try lower_multi_let_array_get(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            let_name, call_node, string_counter, temp_counter, try_counter, aliases, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if builtin.found {
        let runtime = builtin_contract::runtime_method_abi(
            builtin_contract::operation_from_name(builtin.operation)
        );
        let error_byte_view = match runtime.result_transport {
            ErrorByteView => true,
            _ => false,
        };
        if runtime.found and error_byte_view {
            let info = try method_call_info(
                ir_bytes, function_name, module_prefix, locals_spec, call_node, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
                ir_bytes, function_name, call_node, bs, call_arg_type_cache
            );
            var arg_types = try method_call_arg_types(
                ir_bytes, function_name, module_prefix, &info, call_node,
                explicit_arg_count, ir_lookup_index, canonical_facts,
                call_arg_type_cache
            );
            defer arg_types.deinit();
            var arg_insts = std::array::Array<compiled_mir::MirExprInst>(
                std::mem::page_allocator()
            );
            var args = std::array::Array<compiled_mir::MirCallArg>(
                std::mem::page_allocator()
            );
            let lowered = try lower_method_call_args_hoisting_try_args_with_local_aliases(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                call_node, string_counter, temp_counter, try_counter, aliases,
                &info, &arg_types, &var arg_insts, &var args, stmts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            var normalized_args = try normalize_runtime_method_args(&arg_types, args);
            let new_locals = try compiled_signature::extend_locals_spec(
                ir_bytes, lowered.locals_spec, let_name, info.success_llvm_type
            );
            try stmts.append(try compiled_mir::let_try_storage_call_stmt(
                let_name, info.storage_return_llvm_type, info.success_llvm_type,
                builtin_contract::RuntimeResultTransport::ErrorByteView,
                llvm_return_type, info.module_prefix, info.callee_name,
                string_counter, lowered.try_counter, arg_insts, normalized_args
            ));
            return MultiLowerResult {
                locals_spec: new_locals,
                string_counter: lowered.string_counter,
                temp_counter: lowered.temp_counter,
                try_counter: lowered.try_counter + 1
            };
        }
    }
    // A hoisted 'try <receiver>.<method>(args)' binds through the same LetTryCall shape as a
    // free call, but its receiver is not an arg edge: lowering it as a free call drops the
    // receiver entirely and shifts every remaining operand into the wrong parameter slot. The
    // receiver call arg and the runtime storage ABI come from the shared method machinery, so
    // no method name or receiver spelling is inspected here.
    if try callee_is_field_expr(ir_bytes, function_name, call_node, bs) {
        return try lower_multi_let_method_try_call(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            let_name, call_node, string_counter, temp_counter, try_counter, aliases,
            stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, cf, call_arg_type_cache
    );
    let success_id = try compiled_canonical_facts::parsed_canonical_error_success_child(
        canonical_facts, call_info.types.result_id
    );
    let success_type = try compiled_canonical_facts::parsed_canonical_runtime_abi(
        ir_lookup_index, canonical_facts, ir_bytes, success_id
    );
    var arg_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    let lowered_args = try lower_try_call_args_with_local_aliases_cached(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        call_node,
        string_counter,
        temp_counter,
        aliases,
        &var arg_insts,
        &var args,
        bs,
        ir_lookup_index,
        canonical_facts,
        call_arg_type_cache
    );
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, success_type
    );
    try stmts.append(compiled_mir::let_try_call_stmt(
        let_name, call_info.return_llvm_type, success_type, llvm_return_type,
        call_info.module_prefix, call_info.callee_name, string_counter, try_counter,
        arg_insts, args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: lowered_args.string_counter,
        temp_counter: lowered_args.temp_counter,
        try_counter: try_counter + 1
    };
}

// lower_multi_let_method_try_call binds 'let <name> = try <receiver>.<method>(args);'. It is the
// value-producing twin of lower_void_method_try_call_statement: the receiver resolves through the
// shared method facts into the leading call arg, the explicit arguments take their semantic types
// from the same ordered ABI table, and normalize_runtime_method_args applies the declared runtime
// storage transport. A runtime builtin whose result is an erased byte view is handled by the
// caller's ErrorByteView branch before this point, so the result here is a semantic value.
fn lower_multi_let_method_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, bs, call_arg_type_cache
    );
    var arg_types = try method_call_arg_types(
        ir_bytes, function_name, module_prefix, &info, call_node, explicit_arg_count,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    defer arg_types.deinit();
    var arg_insts = std::array::Array<compiled_mir::MirExprInst>(
        std::mem::page_allocator()
    );
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    let lowered = try lower_method_call_args_hoisting_try_args_with_local_aliases(
        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
        call_node, string_counter, temp_counter, try_counter, aliases,
        &info, &arg_types, &var arg_insts, &var args, stmts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var normalized_args = try normalize_runtime_method_args(&arg_types, args);
    let call_types = try parsed_call_type_for_node(
        canonical_facts, ir_bytes, function_name, call_node, call_arg_type_cache
    );
    let success_id = try compiled_canonical_facts::parsed_canonical_error_success_child(
        canonical_facts, call_types.result_id
    );
    let success_type = try compiled_canonical_facts::parsed_canonical_runtime_abi(
        ir_lookup_index, canonical_facts, ir_bytes, success_id
    );
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, lowered.locals_spec, let_name, success_type
    );
    try stmts.append(compiled_mir::let_try_call_stmt(
        let_name, info.return_llvm_type, success_type, llvm_return_type,
        info.module_prefix, info.callee_name, string_counter, lowered.try_counter,
        arg_insts, normalized_args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: lowered.string_counter,
        temp_counter: lowered.temp_counter,
        try_counter: lowered.try_counter + 1
    };
}

// lower_multi_assign_statement lowers a top-level '<local> = try <free-call>(args);' reassignment.
// The target is an already-bound local, so it cannot take a fresh SSA name like a 'let'. Instead the
// call's success value is bound to a fresh alias name through the shared LetTryCall error-union
// branch/propagate path, and the target local is redirected to that alias so later statements read
// the updated value -- the same local-alias indirection lower_void_then_body_assign uses for
// non-try reassignments inside if-then bodies. Only a free-function try-call value is accepted;
// other shapes surface an explicit error rather than silently mis-lowering.
fn lower_multi_assign_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiAssignLowerResult {
    // sf tightens this Assign statement's own structural facts (target/value subtree kinds, tokens,
    // edges, callee detail) to its body-node line via the index; the subtree sorts at-or-after it,
    // so a scan from sf is byte-identical to one from bs. The target type resolution reads back
    // across the function, and the let-try-call recursion / index-keyed success-type resolver keep
    // bs.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, sf
    );
    if !(try node_kind_is(ir_bytes, function_name, target, "Var", sf)) {
        return error("compiled mir: top-level assignment target must be a local");
    }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target, sf
    );
    // Resolving the target's type proves it is a bound local (an unbound name surfaces 'local type
    // not found' rather than being silently accepted) and yields the type the reassigned value carries.
    let target_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, target_name, bs, call_arg_type_cache
    );
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, sf
    );
    if !(try node_kind_is(ir_bytes, function_name, value, "TryExpr", sf)) {
        // Any other value is a plain expression, which the then-body reassignment lowering already
        // binds through this same fresh-alias indirection. A top-level reassignment is that same
        // operation in a different block, so it reuses it instead of restricting itself to calls.
        let assigned = try lower_void_then_body_assign(
            ir_bytes, function_name, module_prefix, locals_spec, statement,
            string_counter, temp_counter, try_counter, alias_counter, aliases, stmts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        return MultiAssignLowerResult {
            locals_spec: locals_spec,
            string_counter: assigned.string_counter,
            temp_counter: assigned.temp_counter,
            try_counter: assigned.try_counter,
            alias_counter: assigned.alias_counter
        };
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "value", 0, sf
    );
    if !(try node_kind_is(ir_bytes, function_name, inner, "Call", sf)) {
        return error("compiled mir: top-level assignment try value must wrap a call");
    }
    if try callee_is_field_expr_cached(ir_bytes, function_name, inner, bs, call_arg_type_cache) {
        return error("compiled mir: top-level assignment try-call callee must be a free function");
    }
    // The reassigned local must carry the call's success type; a mismatch would silently mis-lower.
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, inner, bs, ir_lookup_index
    );
    if !std::mem::equal_bytes(success_type, target_type) {
        return error("compiled mir: top-level assignment try-call success type mismatch");
    }
    let output_name = try void_then_alias_name(alias_counter, call_arg_type_cache);
    let lowered = try lower_multi_let_try_call(
        ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
        output_name, inner, string_counter, temp_counter, try_counter, aliases, stmts, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    try set_local_alias(aliases, target_name, output_name);
    return MultiAssignLowerResult {
        locals_spec: lowered.locals_spec,
        string_counter: lowered.string_counter,
        temp_counter: lowered.temp_counter,
        try_counter: lowered.try_counter,
        alias_counter: alias_counter + 1
    };
}

// lower_multi_let_call is the non-error-union mirror of lower_multi_let_try_call: it binds a
// plain (non-try) call's success value into 'let <name> = <call>;' so a method try-call statement
// argument that is itself a bare Call (e.g. 'ast.span(...)', which returns a non-error-union value
// and therefore has no inline call-arg descriptor) can be hoisted ahead of the statement and passed
// by Var. It emits a single MirLetCall with no fail/cont propagation, reusing the shared call
// callee/module/arg resolvers, then extends the locals so later statements resolve the bound type.
fn lower_multi_let_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // cf tightens the pure structural callee read (this call's 'body-call' detail) to the call
    // node's body-node line via the per-function index; the indexed callee/module resolvers still
    // do their cross-module signature probes through the global lookup index.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, cf, call_arg_type_cache
    );
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, call_info.return_llvm_type
    );
    let new_counter = string_counter + try compiled_mir_lower_call::count_string_args(&args);
    try stmts.append(compiled_mir::let_call_stmt(
        let_name, call_info.return_llvm_type, string_counter,
        call_info.module_prefix, call_info.callee_name, args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: new_counter,
        temp_counter: temp_counter,
        try_counter: try_counter
    };
}

// lower_multi_let_ast_child_at lowers 'let <name> = try <ast>.child_at(<range>, <index>);'
// into a LetTryCall against the compiled std::kizu::ast::ast_child_at accessor. The
// receiver forwards by value as the self argument, the range and index arguments lower
// through the shared call-arg path typed from the accessor's signature facts, and the
// bound NodeId success extends the locals so later statements resolve its type.
fn lower_multi_let_ast_child_at(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    callee_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver_node, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: child_at receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 2 {
        return error("compiled mir: child_at takes a range and an index argument");
    }
    let accessor = try compiled_type_resolver::resolve_call_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if !accessor.returns_error {
        return error("compiled mir: source accessor must return an error union");
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    let called_error_union = call_info.return_llvm_type;
    let success_type = try compiled_mir_types::call_info_error_success_llvm(
        ir_lookup_index, canonical_facts, ir_bytes, &call_info
    );
    var runtime_arg_nodes =
        try compiled_mir_lower_call::canonical_runtime_arg_nodes(
            ir_bytes, function_name, call_node, bs, ir_lookup_index,
            &call_info.types
        );
    defer runtime_arg_nodes.deinit();
    if runtime_arg_nodes.len() != 2 {
        return error("compiled mir: child_at canonical runtime argument mismatch");
    }
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    let receiver_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, call_info.types.receiver_id
        );
    try args.append(compiled_mir::var_call_arg(
        receiver_type, receiver_alias
    ));
    var consumed_strings = 0;
    var arg_index = 0;
    while arg_index < arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let type_id = try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &call_info.types, arg_index
        );
        let arg_type =
            try compiled_canonical_facts::parsed_canonical_runtime_abi(
                ir_lookup_index, canonical_facts, ir_bytes, type_id
            );
        let arg = try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
            ir_bytes, function_name, module_prefix, locals_spec, arg_type, arg_node,
            string_counter + consumed_strings, &alias_sources, &alias_currents, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        if arg.kind == compiled_mir::MirCallArgKind::String {
            consumed_strings = consumed_strings + 1;
        }
        try args.append(arg);
        arg_index = arg_index + 1;
    }
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, accessor.return_type.canonical_identity
    );
    try stmts.append(compiled_mir::let_try_call_stmt(
        let_name, called_error_union, success_type, llvm_return_type,
        call_info.module_prefix, call_info.callee_name, string_counter, try_counter,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        args
    ));
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: string_counter + consumed_strings,
        temp_counter: temp_counter,
        try_counter: try_counter + 1
    };
}

// lower_multi_let_array_get lowers 'let <name> = try <receiver>.get(<expr>);' where the
// receiver is a value std::array::Array<T> param/local (issue 1165). The receiver lowers
// to %kizu.owned, so the index expression lowers into expr_insts and the LetArrayGet
// renderer reads the handle straight off the named value, calls the checked
// @kizu_rt_array_at builtin, binds the element (element type T derived from Array<T>) to
// <name> on success, and propagates a failure as this function's own error union. An
// unsupported method/receiver/element type fails explicitly.
fn lower_multi_let_array_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    let_name: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiLowerResult {
    // cf tightens this call's own structural facts (its callee field-expr / method name, receiver
    // edge and kind/token, arg edge) to the call node's body-node line via the index; the subtree
    // sorts at-or-after it, so a scan from cf is byte-identical to one from bs. The receiver type
    // resolution reads back across the function and the index lowering recurses, so both keep bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", cf
    );
    let source_target = try compiled_type_resolver::call_target_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if source_target.found {
        return try lower_multi_let_ast_child_at(
            ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
            let_name, call_node, callee_node, string_counter, temp_counter,
            try_counter, aliases, stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    if !std::mem::equal_bytes(method_name, "get") {
        return error("compiled mir: only Array.get is supported in let-try position on a value receiver");
    }
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver_node, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: Array.get value receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs, call_arg_type_cache
    );
    let lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    if !is_array_field_type(lookup) {
        return error("compiled mir: Array.get receiver is not a std::array::Array");
    }
    let element_kizu_type = try array_element_kizu_type(lookup);
    let element_llvm_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, module_prefix, element_kizu_type
    );
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let index_result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        index_node,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    try stmts.append(compiled_mir::let_array_get_stmt(
        let_name,
        receiver_alias,
        element_llvm_type,
        llvm_return_type,
        index_result_id,
        string_counter,
        try_counter,
        insts
    ));
    let new_locals = try compiled_signature::extend_locals_spec(
        ir_bytes, locals_spec, let_name, element_llvm_type
    );
    return MultiLowerResult {
        locals_spec: new_locals,
        string_counter: string_counter + expr_strings,
        temp_counter: next_temp,
        try_counter: try_counter + 1
    };
}

// try_call_success_type resolves the unwrapped success type a 'try <callee>(...)' binds:
// it reads the callee's '!T' signature-return token, strips the leading '!', and lowers T.
fn try_call_success_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> ![]u8 {
    // cf tightens the structural callee read to the call node's body-node line via the global
    // index (this resolver is not threaded with the per-function index); the signature-return
    // lookup below is index-keyed by callee name, so it is unaffected. Byte-identical to bs.
    let cf = ir_index::body_node_line_start_for_sequence(
        ir_lookup_index, ir_bytes, function_name, call_node, bs
    );
    let callee_name = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, call_node, cf
    );
    let target = try compiled_type_resolver::call_target_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if target.found {
        let function = try compiled_type_resolver::resolve_call_indexed(
            ir_lookup_index, ir_bytes, function_name, call_node
        );
        if !function.returns_error {
            return error("compiled mir: try-call callee must return an error union");
        }
        let success = compiled_type_resolver::function_return_type(&function);
        return success.abi;
    }
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if builtin.found {
        if std::mem::len(builtin.canonical_identity) == 0 {
            return error("compiled mir: try builtin has no runtime identity");
        }
        let ret_kizu = try compiled_mir_types::builtin_return_spelling_indexed(
            ir_lookup_index, ir_bytes, builtin.canonical_identity
        );
        if std::mem::len(ret_kizu) == 0 or ret_kizu[0] != cast<u8>(33) {
            return error("compiled mir: try-call callee must return an error union");
        }
        let success_kizu = ret_kizu[1..std::mem::len(ret_kizu)];
        return try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index, ir_bytes,
            compiled_util::module_prefix_of(builtin.canonical_identity), success_kizu
        );
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes(
        "compiled mir: body call target not found [try-success]: function "
    );
    try message.append_bytes(function_name);
    try message.append_bytes(" callee ");
    try message.append_bytes(callee_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, call_node);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}
// prefix_not_try_call_inner_or_minus_one recognizes a '!(try <callee>(<args>))' expression: a
// prefix 'not' whose operand is a 'try <call>' over a free function returning an error-union bool
// (a try-call in sub-expression position, issue 1165 / 1162). It returns the inner Call node so the
// caller can lower it as a hoisted try-call whose unwrapped bool success is negated, or -1 when the
// shape does not match. A field-mode method call is rejected (returns -1) so only free-function
// try-calls take this path, and a callee whose unwrapped success type is not 'i1' is rejected too:
// the renderer negates the success with 'xor i1' and wraps an 'i1' field, so a non-bool callee (e.g.
// a '!i64') must fall through to the generic path rather than be silently mis-lowered.
fn prefix_not_try_call_inner_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(kind, "Prefix") {
        return -1;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-prefix ", function_name, node, bs
    );
    if !std::mem::equal_bytes(op, "not") {
        return -1;
    }
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right, bs);
    if !std::mem::equal_bytes(right_kind, "TryExpr") {
        return -1;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, right, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return -1;
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return -1;
    }
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, inner, bs, ir_lookup_index
    );
    if !std::mem::equal_bytes(success_type, "i1") {
        return -1;
    }
    return inner;
}

// positive_try_call_condition_inner_or_minus_one recognizes an if condition of the form
// 'try <free !bool callee>(<args>)'. It is a side-effecting condition, so it cannot be lowered as a
// straight-line MirExprInst: the rendered call must branch on the error-union ok flag, propagate a
// failure as this function's own error union, and branch on the unwrapped bool success. Near-miss
// TryExpr shapes are explicit errors instead of falling through to the generic expression path.
fn positive_try_call_condition_inner_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(kind, "TryExpr") {
        return -1;
    }
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: positive try-call condition must wrap a call");
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: positive try-call condition must be a free function");
    }
    let success_type = try try_call_success_type(
        ir_bytes, function_name, module_prefix, inner, bs, ir_lookup_index
    );
    if !std::mem::equal_bytes(success_type, "i1") {
        return error("compiled mir: positive try-call condition callee must return !bool");
    }
    return inner;
}

// require_if_not_try_guard_no_else rejects an 'if !(try <call>) { return <bool>; }' guard that also
// carries an else arm (issue 1165 / 1162). The if-not-try-call-return-bool statement is rendered as
// a then-only conditional branch -- the negation either returns the bool or falls through to the
// join the following statements render into -- so an else block with a real body would be silently
// dropped. It is an explicit error instead of a silent mis-lower. A missing else child reads as
// either an absent child or an 'Empty' node depending on how the body facts were emitted; both are
// accepted.
fn require_if_not_try_guard_no_else(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !void {
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    if else_node < 0 {
        return;
    }
    let else_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, else_node, bs);
    if !std::mem::equal_bytes(else_kind, "Empty") {
        return error("compiled mir: if-not-try guard must not carry an else arm");
    }
    return;
}

// require_void_then_block_no_else rejects a no-else void multi-statement if-then block that also
// carries an else arm (issue 1165 / 1162). The void then-block is rendered (once the renderer lands)
// as a then-only conditional branch into a fall-through join the following statements render into,
// so an else block with a real body would be silently dropped. It is an explicit error instead of a
// silent mis-lower. A missing else child reads as either an absent child or an 'Empty' node
// depending on how the body facts were emitted; both are accepted. Mirrors
// require_if_not_try_guard_no_else, which pins the same then-only-render invariant for the guard.
fn require_void_then_block_no_else(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !void {
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    if else_node < 0 {
        return;
    }
    let else_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, else_node, bs);
    if !std::mem::equal_bytes(else_kind, "Empty") {
        return error("compiled mir: void then block must not carry an else arm");
    }
    return;
}

// lower_try_call_void_if lowers 'if try <free !bool callee>(<args>) { <void body> }' and
// 'if !(try <free !bool callee>(<args>)) { <void body> }': the condition call is hoisted into a
// basic-block branch with failure propagation, and the then-body is lowered through the same
// no-else void-body path as ordinary bool conditions so assignments merge through the fall-through
// join. then_on_success records the condition polarity.
fn lower_try_call_void_if(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    then_node: i64,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    then_on_success: bool,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    try require_void_then_block_no_else(ir_bytes, function_name, statement, sf);

    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    let call_args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let call_arg_strings = try compiled_mir_lower_call::count_string_args(&call_args);

    var then_body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var merge_vars = std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator());
    var branch_aliases = try copy_local_aliases(aliases);
    defer branch_aliases.deinit();
    let then_body = try lower_void_then_body(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        then_node,
        string_counter + call_arg_strings,
        temp_counter,
        try_counter,
        alias_counter,
        if_index,
        &var branch_aliases,
        &var then_body_stmts,
        -1,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var branch_alias_index = 0;
    var merge_alias_counter = then_body.alias_counter;
    if !then_body.body_returns {
        while branch_alias_index < branch_aliases.len() {
            let branch_state = try branch_aliases.at(branch_alias_index);
            // A shadowed name is handled by per-binding SSA rename, not by a join phi: each
            // 'let <name>' inside a branch is an independent value that dies at the branch end, so
            // its branch alias must never merge into the enclosing scope's binding of the same name.
            if try let_binding_is_shadowed(ir_bytes, function_name, branch_state.source_name, bs) {
                branch_alias_index = branch_alias_index + 1;
                continue;
            }
            // A name this branch declares and no enclosing statement does has no incoming value to
            // seed the join slot with, so it takes no merge either.
            if try let_binding_is_local_to_branch(
                ir_bytes, function_name, then_node, -1, branch_state.source_name, bs
            ) {
                branch_alias_index = branch_alias_index + 1;
                continue;
            }
            let input_name = try local_alias_current_name(aliases, branch_state.source_name);
            if !std::mem::equal_bytes(input_name, branch_state.current_name) {
                let output_name = try void_then_alias_name(
                    merge_alias_counter, call_arg_type_cache
                );
                let merge_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
                    ir_lookup_index,
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    branch_state.source_name,
                    bs, call_arg_type_cache
                );
                try merge_vars.append(compiled_mir::if_merge_var(
                    branch_state.source_name,
                    input_name,
                    branch_state.current_name,
                    output_name,
                    merge_type
                ));
                try set_local_alias(aliases, branch_state.source_name, output_name);
                merge_alias_counter = merge_alias_counter + 1;
            }
            branch_alias_index = branch_alias_index + 1;
        }
    }
    try stmts.append(compiled_mir::if_try_call_void_body_stmt(
        if_index,
        string_counter,
        call_info.return_llvm_type,
        llvm_return_type,
        call_info.module_prefix,
        call_info.callee_name,
        call_args,
        then_on_success,
        then_body_stmts,
        merge_vars
    ));
    return MultiIfLowerResult {
        temp_counter: then_body.temp_counter,
        string_counter: then_body.string_counter,
        try_counter: then_body.try_counter,
        alias_counter: merge_alias_counter
    };
}

// lower_return_struct_literal lowers a 'return <Struct> { ... };' statement.
// Inside an error-union function ('return CodeEval { ... };' in '!CodeEval') the
// struct builds as the success value and wraps into the function's error union;
// a plain struct return keeps building into the return type directly (empty wrap
// markers).
fn lower_return_struct_literal(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    value: i64,
    string_counter: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    var wrap_error_union = ir_bytes[0..0];
    var success_llvm = ir_bytes[0..0];
    if std::mem::starts_with(llvm_return_type, "%kizu.error.") {
        wrap_error_union = llvm_return_type;
        success_llvm = try compiled_signature::resolve_struct_literal_type_indexed(
            ir_lookup_index, ir_bytes, function_name, module_prefix, value, bs
        );
    }
    let fields = try compiled_mir_lower_struct::lower_struct_fields(
        ir_bytes, function_name, module_prefix, locals_spec, value, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return compiled_mir::return_struct_wrapped_stmt(
        string_counter, wrap_error_union, success_llvm, fields
    );
}

fn lower_multi_return_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    // sf tightens this Return statement's own structural facts (its value subtree: kind, callee
    // detail/field-expr, arg edges) to its body-node line via the index; the subtree sorts
    // at-or-after it, so a scan from sf is byte-identical to one from bs. Shape detection that
    // reads back across the function, the expr/call lowering recursion, and the index-keyed
    // return-type resolver keep bs.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, sf
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, sf);
    // 'return !(try <callee>(<args>));' hoists the sub-expression try-call: the renderer emits the
    // call, propagates a failure as this function's own error union, and negates the unwrapped bool
    // success before wrapping it as the error-union success (issue 1165 / 1162).
    let return_not_try = try prefix_not_try_call_inner_or_minus_one(
        ir_bytes, function_name, module_prefix, value, bs, ir_lookup_index
    );
    if return_not_try >= 0 {
        let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, return_not_try, sf, call_arg_type_cache
        );
        let args = try lower_call_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, return_not_try,
            string_counter, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        return compiled_mir::return_not_try_call_stmt(
            call_info.return_llvm_type, llvm_return_type,
            call_info.module_prefix, call_info.callee_name,
            string_counter, args
        );
    }
    if std::mem::equal_bytes(value_kind, "Call") {
        if try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, value, sf) {
            let message_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, value, "arg", 0, sf
            );
            var message_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let message_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                message_node,
                string_counter,
                temp_counter,
                &var message_insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            return compiled_mir::return_error_stmt(
                string_counter, message_result, message_insts
            );
        }
        // Every field-mode call uses the canonical method ABI path. Receiver shape and
        // operation identity, rather than a method-name special case such as `get`, select
        // the runtime/source method symbol and result transport.
        if try callee_is_field_expr_cached(ir_bytes, function_name, value, bs, call_arg_type_cache) {
            var method_insts = std::array::Array<compiled_mir::MirExprInst>(
                std::mem::page_allocator()
            );
            let method_result_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                value,
                string_counter,
                temp_counter,
                &var method_insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            return compiled_mir::return_expr_stmt(
                string_counter, method_result_id, method_insts
            );
        }
        // 'return equal_bytes(token_text(...), expected);' carries a nested call argument and
        // 'return is_line_break(source[cursor]);' carries a single-element byte index load --
        // arguments the inline call-arg descriptors cannot model -- so each lowers through the
        // generic expression path (which materializes the nested call or checked byte load into a
        // preceding temp) as a return-expr statement instead of an inline return-call (issue 1165 /
        // 1162).
        if try call_has_hoisted_arg_cached(
            ir_bytes, function_name, value, bs, call_arg_type_cache
        ) {
            var nested_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let nested_result_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                value,
                string_counter,
                temp_counter,
                &var nested_insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            return compiled_mir::return_expr_stmt(string_counter, nested_result_id, nested_insts);
        }
        let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, value, bs, call_arg_type_cache
        );
        let args = try lower_call_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, value, string_counter, aliases, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        return compiled_mir::return_call_stmt(
            call_info.return_llvm_type, string_counter,
            call_info.module_prefix, call_info.callee_name, args
        );
    }
    // A bare 'return;' returns the void success (wrapped when the function returns
    // an error union).
    if std::mem::equal_bytes(value_kind, "Empty") {
        return compiled_mir::return_void_success_stmt();
    }
    // 'return try <callee>(<args>);' whose callee shares this function's error-union
    // return type is an identity tail: the callee's result returns directly, the
    // caller unwraps (the tape's recursive list walks end this way).
    if std::mem::equal_bytes(value_kind, "TryExpr") {
        let try_inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value, "value", 0, sf
        );
        let try_inner_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, try_inner, sf
        );
        if std::mem::equal_bytes(try_inner_kind, "Var") {
            var var_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let var_result_id = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                try_inner,
                string_counter,
                temp_counter,
                &var var_insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let var_type = try return_try_expr_inst_llvm_type_by_id(&var_insts, var_result_id);
            if !std::mem::equal_bytes(var_type, llvm_return_type) {
                let var_name = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, try_inner, sf
                );
                var message = std::string::String(std::mem::page_allocator());
                try message.append_bytes(
                    "compiled mir: return try variable must share the function's error union: "
                );
                try message.append_bytes(function_name);
                try message.append_bytes(" variable ");
                try message.append_bytes(var_name);
                try message.append_bytes(" actual ");
                try message.append_bytes(var_type);
                try message.append_bytes(" expected ");
                try message.append_bytes(llvm_return_type);
                let message_bytes = message.as_bytes();
                return error(message_bytes);
            }
            return compiled_mir::return_expr_stmt(string_counter, var_result_id, var_insts);
        }
        if !std::mem::equal_bytes(try_inner_kind, "Call") {
            return error("compiled mir: return try must wrap a call");
        }
        if try call_has_try_arg(
            ir_bytes, function_name, try_inner, sf
        ) {
            var nested_try_insts =
                std::array::Array<compiled_mir::MirExprInst>(
                    std::mem::page_allocator()
                );
            let nested_try_result = try lower_expr_with_local_aliases(
                ir_bytes, function_name, module_prefix, locals_spec, value,
                string_counter, temp_counter, &var nested_try_insts, aliases, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            return compiled_mir::return_expr_stmt(
                string_counter, nested_try_result, nested_try_insts
            );
        }
        let field_mode = try call_callee_field_expr_mode_cached(
            ir_bytes, function_name, try_inner, bs, call_arg_type_cache
        );
        if field_mode == 1 {
            var method_try_insts = std::array::Array<compiled_mir::MirExprInst>(
                std::mem::page_allocator()
            );
            let method_try_result = try lower_expr_with_local_aliases(
                ir_bytes, function_name, module_prefix, locals_spec, value,
                string_counter, temp_counter, &var method_try_insts, aliases, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            return compiled_mir::return_expr_stmt(
                string_counter, method_try_result, method_try_insts
            );
        }
        let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, try_inner, sf, call_arg_type_cache
        );
        if !std::mem::equal_bytes(call_info.return_llvm_type, llvm_return_type) {
            return error("compiled mir: return try call must share the function's error union");
        }
        let try_args = try lower_call_args_with_local_aliases_cached(
            ir_bytes, function_name, module_prefix, locals_spec, try_inner,
            string_counter, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        return compiled_mir::return_call_stmt(
            call_info.return_llvm_type, string_counter,
            call_info.module_prefix, call_info.callee_name, try_args
        );
    }
    if std::mem::equal_bytes(value_kind, "StructLiteralExpr") {
        // A literal whose fields are all shaped keeps the dedicated ReturnStruct statement. One
        // carrying an expression-valued field needs an instruction stream to build in, which only
        // the generic return-expression path at the tail of this function owns.
        let needs_expr_value =
            try compiled_mir_lower_struct::struct_literal_needs_expr_value(
                ir_bytes, function_name, value, bs
            );
        if !needs_expr_value {
            return try lower_return_struct_literal(
                ir_bytes, function_name, module_prefix, llvm_return_type, locals_spec,
                value, string_counter, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
    }
    if std::mem::equal_bytes(value_kind, "Match") {
        var match_stmts = std::array::Array<compiled_mir::MirStmt>(
            std::mem::page_allocator()
        );
        var match_aliases = try copy_local_aliases(aliases);
        defer match_aliases.deinit();
        let _match_result = try lower_multi_match_statement(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            value,
            string_counter,
            temp_counter,
            0,
            &var match_aliases,
            &var match_stmts,
            bs,
            ir_lookup_index,
            canonical_facts,
            call_arg_type_cache,
            true,
            "",
            ""
        );
        if match_stmts.len() != 1 {
            return error("compiled mir: return match must lower to one dispatch statement");
        }
        let match_stmt = try match_stmts.pop();
        match_stmts.deinit();
        return match_stmt;
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return compiled_mir::return_expr_stmt(string_counter, result_id, insts);
}
// lower_multi_match_statement lowers a non-bool enum-dispatch match statement into an EnumDispatch
// stmt (issue 1157 PR-PH / B3 / NEW-B). The scrutinee lowers to an i64 discriminant through
// lower_expr_into (a bare enum Var, a 'token.kind' field access, or a depth-2
// 'expr.next.kind' field access); each arm's variant tag is resolved from the enum-variant facts
// and its body uses the shared return lowerer or the narrow free !void try-call statement path.
// Method effects and other expression statements remain explicit blockers. The trailing '_' default
// (or final variant of an exhaustive match) carries no tag and renders as the unconditional dispatch
// fallthrough arm. Effect-only bodies branch to a common continuation; returns terminate.
// Each arm reserves a private temp/string SSA window (arm_index * ARM_SSA_STRIDE off the
// scrutinee end) so the per-arm '%t<id>' temps and string globals never collide across the arm
// blocks of the same function -- the same fixed-stride namespacing the if-renderer applies to
// its then/else block labels (if_index * 1000). The result advances the outer counters beyond all
// arm windows and threads try indices sequentially because try labels are function-global.
fn lower_multi_match_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache,
    arms_are_return_values: bool,
    // result_name / result_llvm bind the dispatch's value ('let x = match ..'). result_name is
    // empty for a statement dispatch, whose arms return or produce only effects.
    result_name: []u8,
    result_llvm: []u8
) -> !MultiMatchLowerResult {
    let arm_ssa_stride = 1000;
    // The scrutinee lowers to an i64 discriminant. A bare enum Var resolves its enum type from
    // the parameter/local kizu type; field access scrutinees resolve through the shared recursive
    // field resolver so both 'token.kind' and 'expr.next.kind' reach the same enum-variant facts.
    let scrutinee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let scrutinee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, scrutinee, bs
    );
    let enum_kizu = try resolve_dispatch_enum_kizu_type(
        ir_bytes, function_name, module_prefix, locals_spec, scrutinee, scrutinee_kind, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var scrutinee_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let scrutinee_result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        scrutinee,
        string_counter,
        temp_counter,
        &var scrutinee_insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let scrutinee_llvm_type = try expr_inst_llvm_type_by_id(
        &scrutinee_insts, scrutinee_result_id
    );
    let scrutinee_is_union = try compiled_fact_lookup::is_union_type_indexed(
        ir_lookup_index, ir_bytes, ir_bytes[0..0], enum_kizu
    );
    let scrutinee_temps = scrutinee_insts.len();
    let scrutinee_strings = try count_strings_in_insts(&scrutinee_insts);
    let arm_temp_base = temp_counter + scrutinee_temps;
    let arm_string_base = string_counter + scrutinee_strings;
    let arm_count = try ir_contract::body_edge_count_from(
        ir_bytes, function_name, statement, "arm", bs
    );
    if arm_count < 1 {
        return error("compiled mir: enum-dispatch match requires at least one arm");
    }
    var arms = std::array::Array<compiled_mir::MirEnumDispatchArm>(std::mem::page_allocator());
    // A value-binding dispatch takes its ABI from the first arm and requires the rest to agree,
    // so the caller does not have to know the bound type before the arms are lowered.
    var bound_llvm = result_llvm;
    let binds_value = std::mem::len(result_name) > 0;
    var next_try_counter = try_counter;
    var index = 0;
    while index < arm_count {
        let arm_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, statement, "arm", index, bs
        );
        let pattern = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_node, "pattern", 0, bs
        );
        let variant_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, pattern, bs
        );
        let is_default = std::mem::equal_bytes(variant_name, "_");
        var tag = 0 - 1;
        var payload_kizu = ir_bytes[0..0];
        var payload_module = ir_bytes[0..0];
        var payload_llvm = ir_bytes[0..0];
        if !is_default {
            if scrutinee_is_union {
                let union_variant = try compiled_fact_lookup::lookup_union_variant_by_prefix_indexed(
                    ir_lookup_index, ir_bytes, ir_bytes[0..0], enum_kizu, variant_name
                );
                tag = union_variant.tag;
                payload_kizu = union_variant.payload_kizu;
                payload_module = union_variant.declaring_module;
            } else {
                tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
                    ir_lookup_index, ir_bytes, ir_bytes[0..0], enum_kizu, variant_name
                );
            }
        }
        // A value-producing arm (a return-match or a value-binding match) takes the arm body as
        // an expression; an effect arm takes it as a statement.
        let arm_produces_value = arms_are_return_values or binds_value;
        var arm_body = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, arm_node, "body", 0, bs
        );
        if !arm_produces_value {
            arm_body = try dispatch_arm_body_statement(
                ir_bytes, function_name, arm_node, bs
            );
        }
        var arm_body_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arm_body, bs
        );
        if arm_produces_value and
            std::mem::equal_bytes(arm_body_kind, "ExprStmt") {
            arm_body = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arm_body, "expr", 0, bs
            );
            arm_body_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, arm_body, bs
            );
        }
        let arm_temp = arm_temp_base + index * arm_ssa_stride;
        let arm_string = arm_string_base + index * arm_ssa_stride;
        var arm_aliases = try copy_local_aliases(aliases);
        defer arm_aliases.deinit();
        var payload_binding_name = ir_bytes[0..0];
        var payload_output_name = ir_bytes[0..0];
        var has_payload_binding = false;
        if scrutinee_is_union and !is_default {
            let binding_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, arm_node, "binding", 0, bs
            );
            let binding_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, binding_node, bs
            );
            if !std::mem::equal_bytes(binding_kind, "Empty") {
                payload_binding_name = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, binding_node, bs
                );
                payload_output_name = try dispatch_payload_binding_name(
                    statement, index, call_arg_type_cache
                );
                payload_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
                    ir_lookup_index, ir_bytes, payload_module, payload_kizu
                );
                try compiled_mir_types::push_scoped_local_type(
                    call_arg_type_cache, payload_binding_name, payload_kizu,
                    payload_module
                );
                has_payload_binding = true;
                try set_local_alias(
                    &var arm_aliases, payload_binding_name, payload_output_name
                );
            }
        }
        var arm_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
        var falls_through = false;
        var arm_result_name = ir_bytes[0..0];
        if binds_value {
            // A value-binding arm lowers its body expression and copies it into an arm-unique
            // SSA name. The renderer stores that name into the dispatch slot and the join loads
            // the merged value into result_name, so every arm reaches the same binding.
            var value_insts = std::array::Array<compiled_mir::MirExprInst>(
                std::mem::page_allocator()
            );
            let value_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                arm_body,
                arm_string,
                arm_temp,
                &var value_insts,
                &arm_aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let value_type = try expr_inst_llvm_type_by_id(
                &value_insts, value_result
            );
            if std::mem::len(bound_llvm) == 0 {
                bound_llvm = value_type;
            }
            if !std::mem::equal_bytes(value_type, bound_llvm) {
                var message = std::string::String(std::mem::page_allocator());
                try message.append_bytes(
                    "compiled mir: match value arms must share one ABI: "
                );
                try message.append_bytes(function_name);
                try message.append_bytes(" arm value ");
                try message.append_bytes(value_type);
                try message.append_bytes(" bound ");
                try message.append_bytes(bound_llvm);
                let message_bytes = message.as_bytes();
                return error(message_bytes);
            }
            arm_result_name = try dispatch_result_arm_name(
                statement, index, call_arg_type_cache
            );
            try arm_stmts.append(compiled_mir::alias_assign_stmt(
                result_name, arm_result_name, bound_llvm, value_result, value_insts
            ));
            falls_through = true;
        } else {
        if arms_are_return_values {
            var value_insts = std::array::Array<compiled_mir::MirExprInst>(
                std::mem::page_allocator()
            );
            let value_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                arm_body,
                arm_string,
                arm_temp,
                &var value_insts,
                &arm_aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let value_type = try expr_inst_llvm_type_by_id(
                &value_insts, value_result
            );
            // An arm value is either the function's own error union already (an identity tail
            // such as 'try helper(..)') or the union's success value, which the return renderer
            // wraps. Both are admitted; the success ABI is checked by deriving the union name it
            // canonically wraps into, never by a nominal spelling.
            if !std::mem::equal_bytes(value_type, llvm_return_type) {
                let wraps_to_return = compiled_error_abi::wraps_success(
                    llvm_return_type, value_type
                );
                if !wraps_to_return {
                    var message = std::string::String(std::mem::page_allocator());
                    try message.append_bytes(
                        "compiled mir: match value arm ABI must match the function return ABI: "
                    );
                    try message.append_bytes(function_name);
                    try message.append_bytes(" arm value ");
                    try message.append_bytes(value_type);
                    try message.append_bytes(" return ");
                    try message.append_bytes(llvm_return_type);
                    let message_bytes = message.as_bytes();
                    return error(message_bytes);
                }
            }
            try arm_stmts.append(compiled_mir::return_expr_stmt(
                arm_string, value_result, value_insts
            ));
        } else {
        if std::mem::equal_bytes(arm_body_kind, "Return") {
            try arm_stmts.append(try lower_multi_return_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                arm_body,
                arm_string,
                arm_temp,
                &arm_aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            ));
        } else {
            if !std::mem::equal_bytes(arm_body_kind, "ExprStmt") {
                return error("compiled mir: enum-dispatch arm body must return or be an expression statement");
            }
            let expr_result = try lower_multi_expr_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                arm_body,
                arm_string,
                arm_temp,
                next_try_counter,
                &arm_aliases,
                &var arm_stmts,
                bs,
                ir_lookup_index,
                canonical_facts,
                call_arg_type_cache
            );
            if arm_stmts.len() != 1 {
                return error("compiled mir: enum-dispatch effect arm must lower to one statement");
            }
            let effect_stmt = try arm_stmts.at(0);
            var is_supported_effect = false;
            match effect_stmt {
                VoidCall(_) => is_supported_effect = true;,
                VoidTryCall(_) => is_supported_effect = true;,
                Print(_) => is_supported_effect = true;,
                AliasAssign(_) => is_supported_effect = true;,
                _ => is_supported_effect = false;,
            }
            if !is_supported_effect {
                return error("compiled mir: enum-dispatch effect arm must lower to a supported effect");
            }
            if expr_result.string_counter > arm_string + arm_ssa_stride {
                return error("compiled mir: enum-dispatch arm exhausted its string SSA window");
            }
            if expr_result.temp_counter > arm_temp + arm_ssa_stride {
                return error("compiled mir: enum-dispatch arm exhausted its temp SSA window");
            }
            next_try_counter = expr_result.try_counter;
            falls_through = true;
        }
        }
        }
        if has_payload_binding {
            try compiled_mir_types::pop_scoped_local_type(call_arg_type_cache);
        }
        if std::mem::len(arm_result_name) > 0 {
            try arms.append(compiled_mir::enum_dispatch_value_arm(
                tag, is_default, payload_output_name, payload_llvm,
                arm_result_name, arm_stmts
            ));
        } else {
        if std::mem::len(payload_output_name) > 0 {
            if falls_through {
                try arms.append(compiled_mir::enum_dispatch_fallthrough_payload_arm(
                    tag, payload_output_name, payload_llvm, arm_stmts
                ));
            } else {
                try arms.append(compiled_mir::enum_dispatch_payload_arm(
                    tag, payload_output_name, payload_llvm, arm_stmts
                ));
            }
        } else {
            if falls_through {
                try arms.append(compiled_mir::enum_dispatch_fallthrough_arm(
                    tag, is_default, arm_stmts
                ));
            } else {
                try arms.append(compiled_mir::enum_dispatch_arm(tag, is_default, arm_stmts));
            }
        }
        }
        index = index + 1;
    }
    try stmts.append(compiled_mir::enum_dispatch_stmt(
        scrutinee_insts, scrutinee_result_id, scrutinee_llvm_type, scrutinee_is_union,
        result_name, bound_llvm, arms
    ));
    return MultiMatchLowerResult {
        string_counter: arm_string_base + arm_count * arm_ssa_stride,
        temp_counter: arm_temp_base + arm_count * arm_ssa_stride,
        try_counter: next_try_counter,
        result_llvm: bound_llvm
    };
}
// resolve_dispatch_enum_kizu_type resolves the fully-qualified enum kizu type of an
// enum-dispatch match scrutinee: a bare Var reads its parameter/local kizu type, and a
// FieldExpr delegates to the shared field resolver so both receiver.field and
// receiver.field.field dispatches stay structural (issue 1157 PR-PH / B3 / NEW-B).
fn resolve_dispatch_enum_kizu_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    scrutinee: i64,
    scrutinee_kind: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if std::mem::equal_bytes(scrutinee_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, scrutinee, bs
        );
        let kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, locals_spec, var_name, bs,
            call_arg_type_cache
        );
        return compiled_mir_types::struct_lookup_kizu_type(kizu);
    }
    if std::mem::equal_bytes(scrutinee_kind, "FieldExpr") {
        let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
            ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec, scrutinee, bs,
            call_arg_type_cache
        );
        return compiled_mir_types::struct_lookup_kizu_type(field.field_kizu_type);
    }
    return error("compiled mir: enum-dispatch scrutinee must be a variable or field access");
}
// dispatch_arm_body_statement returns the single Return or ExprStmt backing an enum-dispatch
// arm. Return arms terminate in place; side-effecting ExprStmt arms continue through the shared
// dispatch join. Blocks must contain exactly one such statement so control-flow ownership stays
// explicit in the MIR arm rather than silently dropping trailing work.
fn dispatch_arm_body_statement(
    ir_bytes: []u8,
    function_name: []u8,
    arm_node: i64,
    bs: i64
) -> !i64 {
    let body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arm_node, "body", 0, bs
    );
    let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body, bs);
    if std::mem::equal_bytes(body_kind, "Return") or
        std::mem::equal_bytes(body_kind, "ExprStmt") {
        return body;
    }
    if std::mem::equal_bytes(body_kind, "Block") {
        let extra = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, body, "statement", 1, bs
        );
        if extra >= 0 {
            return error("compiled mir: enum-dispatch arm body must be a single statement");
        }
        let inner = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body, "statement", 0, bs
        );
        let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
        if !std::mem::equal_bytes(inner_kind, "Return") and
            !std::mem::equal_bytes(inner_kind, "ExprStmt") {
            return error("compiled mir: enum-dispatch arm block must return or contain an expression statement");
        }
        return inner;
    }
    return error("compiled mir: enum-dispatch arm body must return or be an expression statement");
}

// lower_multi_return_value_array_get lowers 'return try <receiver>.get(<expr>);' where
// <receiver> is a std::array::Array<T> value receiver. It shares the ReturnArrayGet renderer with
// the struct-field accessor, but uses field_index -1 to mean the receiver is already the %kizu.owned
// array handle. This keeps return-try Array.get on the same checked @kizu_rt_array_at path as
// let-try Array.get rather than routing it through free-function call lowering.
fn lower_multi_return_value_array_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", cf
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return error("compiled mir: return try value receiver method must be get");
    }
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: return try Array.get takes one index argument");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver_node, cf
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: return try Array.get receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_alias = try local_alias_current_name(aliases, receiver_name);
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, receiver_name, bs, call_arg_type_cache
    );
    let lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    if !is_array_field_type(lookup) {
        return error("compiled mir: return try Array.get receiver is not a std::array::Array");
    }
    let element_kizu_type = try array_element_kizu_type(lookup);
    let element_llvm_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, module_prefix, element_kizu_type
    );
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let index_result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        index_node,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return compiled_mir::return_array_get_stmt(
        "",
        receiver_alias,
        0 - 1,
        element_llvm_type,
        index_result_id,
        string_counter,
        insts
    );
}

// lower_multi_return_array_get lowers a multi-statement
// 'return self.<field>.get(<expr>);' (Array<T>.get -> !T, tracker 961). It lowers the
// index expression (e.g. range.start + index) into expr_insts, resolves the Array<T>
// field off the struct value receiver, and builds a ReturnArrayGet statement that the
// renderer turns into the checked @kizu_rt_array_at call + ok-branch + by-value load +
// error-union wrap. Ast.child_at is its first consumer.
fn lower_multi_return_array_get(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    call_node: i64,
    string_counter: i64,
    temp_counter: i64,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    // cf tightens this call's own structural facts (callee/receiver/field edges, kinds, tokens,
    // arg edge) to the call node's body-node line via the index; the subtree sorts at-or-after it,
    // so a scan from cf is byte-identical to one from bs. Param type resolution (find_param_*) and
    // the index expression lowering recursion keep bs.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", cf
    );
    if !std::mem::equal_bytes(method_name, "get") {
        return error("compiled mir: only Array.get method return is supported");
    }
    let arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    if arg_count != 1 {
        return error("compiled mir: Array.get accessor takes one index argument");
    }
    // The method receiver is the array field expression self.<field>.
    let field_expr = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, cf
    );
    let field_expr_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, field_expr, cf
    );
    if !std::mem::equal_bytes(field_expr_kind, "FieldExpr") {
        return error("compiled mir: Array.get receiver must be a struct field access");
    }
    let field_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, field_expr, "field", cf
    );
    let var_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr, "receiver", 0, cf
    );
    let var_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, var_node, cf
    );
    if !std::mem::equal_bytes(var_kind, "Var") {
        return error("compiled mir: Array.get field receiver must be a parameter");
    }
    let var_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, var_node, cf
    );
    let receiver_llvm_type = try compiled_signature::find_param_type(locals_spec, var_name);
    let struct_kizu_type = try compiled_signature::find_param_kizu_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, var_name, locals_spec
    );
    let field = try exact_struct_field(
        ir_lookup_index, ir_bytes, module_prefix, struct_kizu_type, field_name
    );
    if !field.found {
        return error("compiled mir: Array.get receiver field not found");
    }
    if !is_array_field_type(field.field_type) {
        return error("compiled mir: Array.get receiver field is not a std::array::Array");
    }
    let element_kizu_type = try array_element_kizu_type(field.field_type);
    let element_llvm_type = try exact_type_abi(
        ir_lookup_index, ir_bytes, field.declaring_module, element_kizu_type
    );
    // Lower the index expression (e.g. range.start + index) into expr_insts; the
    // result temp %t<index_result_id> feeds the checked array element accessor.
    let index_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, cf
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let index_result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        index_node,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return compiled_mir::return_array_get_stmt(
        receiver_llvm_type,
        var_name,
        field.index,
        element_llvm_type,
        index_result_id,
        string_counter,
        insts
    );
}
// short_circuit_kind classifies a condition node: 1 for and, 2 for or, 0
// otherwise. SPEC 6.9.1 requires and/or to short-circuit, so the if lowering
// evaluates the rhs only in the guarded block instead of eagerly.
fn short_circuit_kind(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if !std::mem::equal_bytes(kind, "Binary") {
        return 0;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, node, bs
    );
    if std::mem::equal_bytes(op, "and") {
        return 1;
    }
    if std::mem::equal_bytes(op, "or") {
        return 2;
    }
    return 0;
}
// condition_eager_safe reports whether every operand of a short-circuit `and`/`or`
// condition is side-effect-free, so eager boolean evaluation is observably identical.
// The condition may nest boolean operands,
// each of which is a bool local/literal, a field read, a comparison Binary over
// side-effect-free values, or a pure '<receiver>.len()' call. Any operand that could
// trap while its short-circuit guard is false is rejected (issue 1165 / 1162).
fn condition_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try short_circuit_kind(ir_bytes, function_name, node, bs);
    if kind == 1 or kind == 2 {
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        if !(try condition_eager_safe(ir_bytes, function_name, left, bs)) {
            return false;
        }
        return try condition_eager_safe(ir_bytes, function_name, right, bs);
    }
    return try while_condition_operand_eager_safe(ir_bytes, function_name, node, bs);
}
// while_condition_operand_eager_safe reports whether one leaf operand of an 'and' while
// header is side-effect-free: a bool local/literal or field read used directly, or a
// comparison Binary whose own operands are each a side-effect-free value.
fn while_condition_operand_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, node, bs
        );
        if !condition_op_is_comparison(op) {
            return false;
        }
        let left = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "left", 0, bs
        );
        let right = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "right", 0, bs
        );
        if !(try while_condition_value_eager_safe(ir_bytes, function_name, left, bs)) {
            return false;
        }
        return try while_condition_value_eager_safe(ir_bytes, function_name, right, bs);
    }
    return try while_condition_value_eager_safe(ir_bytes, function_name, node, bs);
}
// while_condition_value_eager_safe reports whether a comparison operand value is
// side-effect-free: a local/literal/field read, or a pure '<receiver>.len()' call. A
// guarded array index load, a try-call, or any other call could trap and is rejected.
fn while_condition_value_eager_safe(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, node, bs);
    if std::mem::equal_bytes(kind, "Var") or std::mem::equal_bytes(kind, "Int") or
        std::mem::equal_bytes(kind, "Bool") or std::mem::equal_bytes(kind, "String") or
        std::mem::equal_bytes(kind, "FieldExpr") {
        return true;
    }
    if std::mem::equal_bytes(kind, "Call") {
        let callee_name = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, node, bs
        );
        if std::mem::equal_bytes(callee_name, "std::mem::equal_bytes") {
            if (try compiled_mir_types::count_call_args(ir_bytes, function_name, node, bs)) != 2 {
                return false;
            }
            let left_arg = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, node, "arg", 0, bs
            );
            let right_arg = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, node, "arg", 1, bs
            );
            if !(try while_condition_value_eager_safe(ir_bytes, function_name, left_arg, bs)) {
                return false;
            }
            return try while_condition_value_eager_safe(ir_bytes, function_name, right_arg, bs);
        }
        if !(try callee_is_field_expr(ir_bytes, function_name, node, bs)) {
            return false;
        }
        let callee_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, node, "callee", 0, bs
        );
        let method_name = try ir_contract::body_field_expr_name_from(
            ir_bytes, function_name, callee_node, "field", bs
        );
        return std::mem::equal_bytes(method_name, "len");
    }
    return false;
}
fn condition_op_is_comparison(op: []u8) -> bool {
    return std::mem::equal_bytes(op, "eq") or std::mem::equal_bytes(op, "not-eq") or
        std::mem::equal_bytes(op, "lt") or std::mem::equal_bytes(op, "lte") or
        std::mem::equal_bytes(op, "gt") or std::mem::equal_bytes(op, "gte");
}
// CondLeaf is one operand of a short-circuit condition tree together with the two destinations
// its i1 result selects, using the MirCondTarget encoding (-1 condition-true, -2 condition-false,
// k >= 0 leaf k's block).
pub struct CondLeaf {
    pub node: i64,
    pub true_target: i64,
    pub false_target: i64,
}

// cond_leaf_count reports how many leaves an and/or tree contributes, descending through both
// operators so a mixed tree is counted the same way it is evaluated.
fn cond_leaf_count(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    bs: i64
) -> !i64 {
    if (try short_circuit_kind(ir_bytes, function_name, node, bs)) == 0 {
        return 1;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "left", 0, bs
    );
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    return (try cond_leaf_count(ir_bytes, function_name, left, bs)) +
        (try cond_leaf_count(ir_bytes, function_name, right, bs));
}

// collect_cond_leaves appends an and/or tree's leaves in left-to-right evaluation order, giving
// each the two destinations its result branches to. next_index is the leaf index this subtree's
// first leaf will occupy, so the right subtree's first leaf index is known before the left subtree
// is walked and no backpatching pass is needed. An 'and' routes its left operand's true edge into
// the right subtree and its false edge to the tree's own false destination; an 'or' swaps the two.
// Both operators descend into either side, so nesting ('a or b or (c and d)') needs no special
// case: only the edges differ, never the flat evaluation order.
fn collect_cond_leaves(
    ir_bytes: []u8,
    function_name: []u8,
    node: i64,
    next_index: i64,
    true_target: i64,
    false_target: i64,
    leaves: &var std::array::Array<CondLeaf>,
    bs: i64
) -> !void {
    let kind = try short_circuit_kind(ir_bytes, function_name, node, bs);
    if kind == 0 {
        try leaves.append(CondLeaf {
            node: node,
            true_target: true_target,
            false_target: false_target
        });
        return;
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "left", 0, bs
    );
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node, "right", 0, bs
    );
    let right_index = next_index +
        try cond_leaf_count(ir_bytes, function_name, left, bs);
    if kind == 1 {
        try collect_cond_leaves(
            ir_bytes, function_name, left, next_index,
            right_index, false_target, leaves, bs
        );
    } else {
        try collect_cond_leaves(
            ir_bytes, function_name, left, next_index,
            true_target, right_index, leaves, bs
        );
    }
    try collect_cond_leaves(
        ir_bytes, function_name, right, right_index,
        true_target, false_target, leaves, bs
    );
    return;
}
// lower_void_then_body_assign lowers a '<target> = <value>;' reassignment statement inside a no-else
// void then-body (issue 1207). The formatter's leading-import sort branch reassigns six scalar carry
// locals after its try-call -- 'index = next_index;', 'cursor = last_import.end;', 'previous = ";";',
// 'last_top_level_decl = "import";', 'last = cast<u8>(10);', 'at_line_start = true;'
// (selfhost/src/parser/format.kizu:33-38) -- each updating a local bound before the then-body, not a
// fresh binding. It is shape-driven, not name-driven: the target must be a Var naming a local already
// resolvable in this function (so locals_spec is left unchanged and no binding is fabricated), the
// value is lowered through the shared expression path, including source/builtin methods and try
// propagation, and its lowered LLVM type must match the target's resolved type. The value binds to a
// fresh MirAliasAssign name, never to the target itself, so rendering cannot redefine the original
// SSA name. The
// enclosing no-else void if later compares incoming vs then-body aliases and emits merge metadata
// for the fall-through join.
fn lower_void_then_body_assign(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !VoidAssignLowerResult {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: void then-body assignment target must be a local");
    }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target, bs
    );
    // Resolving the target's LLVM type proves it is a local bound before the then-body (an unbound
    // name surfaces 'local type not found' rather than being silently accepted) and yields the type
    // the reassigned value must carry.
    let target_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, target_name, bs, call_arg_type_cache
    );
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let value_type = try expr_inst_llvm_type_by_id(&insts, result_id);
    if !std::mem::equal_bytes(value_type, target_type) {
        return error("compiled mir: void then-body assignment operand type mismatch");
    }
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    let output_name = try void_then_alias_name(alias_counter, call_arg_type_cache);
    try stmts.append(compiled_mir::alias_assign_stmt(
        target_name, output_name, target_type, result_id, insts
    ));
    try set_local_alias(aliases, target_name, output_name);
    return VoidAssignLowerResult {
        string_counter: string_counter + expr_strings,
        temp_counter: next_temp,
        try_counter: try_counter,
        alias_counter: alias_counter + 1
    };
}

fn lower_induction_init_alias(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !VoidAssignLowerResult {
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "name", 0, bs
    );
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, name_node, bs
    );
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if std::mem::equal_bytes(value_kind, "Call") or
        std::mem::equal_bytes(value_kind, "TryExpr") {
        return VoidAssignLowerResult {
            string_counter: string_counter,
            temp_counter: temp_counter,
            try_counter: 0,
            alias_counter: alias_counter
        };
    }
    let target_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, target_name, bs, call_arg_type_cache
    );
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value,
        string_counter,
        temp_counter,
        &var insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let value_type = try expr_inst_llvm_type_by_id(&insts, result_id);
    if !std::mem::equal_bytes(value_type, target_type) {
        return error("compiled mir: induction alias init type mismatch");
    }
    let output_name = try void_then_alias_name(alias_counter, call_arg_type_cache);
    let expr_strings = try count_strings_in_insts(&insts);
    let expr_len = insts.len();
    try stmts.append(compiled_mir::alias_assign_stmt(
        target_name, output_name, target_type, result_id, insts
    ));
    try set_local_alias(aliases, target_name, output_name);
    return VoidAssignLowerResult {
        string_counter: string_counter + expr_strings,
        temp_counter: temp_counter + expr_len,
        try_counter: 0,
        alias_counter: alias_counter + 1
    };
}
fn return_body_advance(
    stmt: &compiled_mir::MirStmt,
    base_temp: i64,
    base_string: i64
) -> !MultiIfLowerResult {
    match stmt {
        ReturnCall(payload) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string + try compiled_mir_lower_call::count_string_args(
                &payload.call_args
            ),
            try_counter: 0,
            alias_counter: 0
        };,
        ReturnNotTryCall(payload) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string + try compiled_mir_lower_call::count_string_args(
                &payload.call_args
            ),
            try_counter: 0,
            alias_counter: 0
        };,
        ReturnExpr(payload) => return try return_expr_advance(
            &payload.expr_insts, base_temp, base_string
        );,
        ReturnError(payload) => return try return_expr_advance(
            &payload.expr_insts, base_temp, base_string
        );,
        ReturnArrayGet(payload) => return try return_expr_advance(
            &payload.expr_insts, base_temp, base_string
        );,
        ReturnStruct(payload) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string + payload.struct_fields.len(),
            try_counter: 0,
            alias_counter: 0
        };,
        VoidReturnSuccess(_) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string,
            try_counter: 0,
            alias_counter: 0
        };,
        ReturnTryBinary(payload) => return MultiIfLowerResult {
            temp_counter: base_temp,
            string_counter: base_string + try compiled_mir_lower_call::count_string_args(
                &payload.call_args
            ),
            try_counter: 0,
            alias_counter: 0
        };,
        _ => return error("compiled mir: void then-body return did not lower to a return statement");,
    }
}

// reserved_nested_base maps a control construct's index to the base its nested children use to
// namespace their LLVM block labels ('base * 1000 + body_index + 1'). A control construct that is
// the function's first top-level statement carries index 0, so its children would encode into
// bucket 0 = {1, 2, ...} -- exactly the numbers sibling top-level statements use for their own
// if<n>/loop<n> labels. clang does not reject the resulting duplicate block labels; it silently
// merges the same-named blocks, producing a malformed, non-terminating CFG (the issue 1157 hang in
// parse_ident_top_level_decl, whose leading 'if try is_token_text("test")' nests an 'if public'
// that collides with the sibling top-level 'if try is_token_text("impl")'). To reserve bucket 0,
// an index-0 parent namespaces its children under the function's top-level statement count instead:
// that bucket (statement_count * 1000) sits one bucket past every sibling's bucket and own label,
// so the labels stay disjoint. Every other statement (index >= 1) and every already-nested
// encoding (index >= 1) is returned unchanged, so only the first top-level statement's children
// move.
// The same bucket also namespaces the call-argument temporaries the renderer emits for each nested
// statement ('%arg<base * 1000 + body_index + 1>_<n>'), and there the merge clang performs on
// duplicate labels becomes an outright duplicate SSA definition. So the top-level dispatch resolves
// an If's or a While's own bucket through here before handing it down, rather than leaving the raw
// statement index for the nested encoders to correct: the construct's index and the base its
// children encode under are then the same number, which is what lets the renderer derive the
// children's namespace from the index it can see.
fn reserved_nested_base(
    index: i64,
    ir_bytes: []u8,
    function_name: []u8,
    bs: i64
) -> !i64 {
    if index != 0 {
        return index;
    }
    return try ir_contract::body_edge_count_from(ir_bytes, function_name, 0, "statement", bs);
}

// lower_void_then_body lowers the statement list of a no-else void multi-statement if-then block
// into then_body_stmts, dispatching each statement by kind through the same per-kind lowering the
// top-level body loop uses. It is shape-driven, not name-driven: a then-block whose controlling
// statement is not a single Return is a side-effecting body (let bindings, nested ifs, call
// statements, assignments, and terminal returns), so it descends into the statement list rather
// than the Return-only then-kind machinery. A Return must be the final statement; the result marks
// that the then branch does not merge into the continuation. The Let, If, and ExprStmt dispatches
// are exercised today: the leading_imports sort branch at selfhost/src/parser/format.kizu:28 opens
// with two 'let' bindings ('next_index', 'last_import'), then a nested
// 'if !has_line_comment_between(...) { ... }' (selfhost/src/parser/format.kizu:31) whose own void
// then-body opens with a try-call statement 'try append_sorted_imports(...)'
// (selfhost/src/parser/format.kizu:32). The nested 'if' dispatches through
// lower_multi_if_statement -- the same if-lowering the top-level loop uses, which recognizes the
// void then-block shape and descends here again -- and that inner ExprStmt dispatches through
// lower_multi_expr_statement. The following Assign statements bind fresh aliases, and nested
// lower_multi_if_statement calls thread try_counter / alias_counter so the rendered void then-body
// can merge through its fall-through join without try-label or SSA-name collisions.
fn lower_void_then_body(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    then_node: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    then_body_stmts: &var std::array::Array<compiled_mir::MirStmt>,
    continue_loop_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !VoidBodyLowerResult {
    var body_locals = locals_spec;
    var body_strings = string_counter;
    var body_temps = temp_counter;
    var body_tries = try_counter;
    var body_alias_counter = alias_counter;
    var pending_defers = std::array::Array<i64>(std::mem::page_allocator());
    defer pending_defers.deinit();
    // Namespace base for this block's nested-if labels. Identity for an already-nested block
    // (if_index >= 1); for the function's first top-level statement (if_index 0) it resolves to the
    // top-level statement count so the children clear bucket 0 (see reserved_nested_base, issue 1157).
    let child_namespace = try reserved_nested_base(if_index, ir_bytes, function_name, bs);
    var body_index = 0;
    var body_returns = false;
    var body_scan_from = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, then_node, bs
    );
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, then_node, "statement", body_index, body_scan_from
        );
        if statement < 0 {
            break;
        }
        let stmt_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, statement, bs
        );
        body_scan_from = stmt_sf;
        let stmt_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, statement, stmt_sf
        );
        if std::mem::equal_bytes(stmt_kind, "Let") {
            // A 'var counter = <init>' a while in this arm advances is that loop's seed: the loop
            // head supplies the value, through a phi or through a slot load, so emitting the let
            // would define the same SSA name twice. The function-body walk and the loop-body walk
            // already apply this rule; an arm is a statement list like either of them.
            if try statement_is_induction_init(
                ir_bytes,
                function_name,
                then_node,
                statement,
                try ir_contract::body_edge_count_from(
                    ir_bytes, function_name, then_node, "statement", bs
                ),
                bs
            ) {
                // Unless something between it and the loop reads a value the loop cannot rebuild,
                // in which case it stays here under a name of its own and the loop seeds from that.
                if !(try loop_seed_must_stay_in_place(
                    ir_bytes,
                    function_name,
                    then_node,
                    statement,
                    try ir_contract::body_edge_count_from(
                        ir_bytes, function_name, then_node, "statement", bs
                    ),
                    bs
                )) {
                    body_index = body_index + 1;
                    continue;
                }
                let seed_result = try lower_loop_seed_binding_in_place(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    body_locals,
                    statement,
                    body_strings,
                    body_temps,
                    body_tries,
                    aliases,
                    then_body_stmts,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_locals = seed_result.locals_spec;
                body_strings = seed_result.string_counter;
                body_temps = seed_result.temp_counter;
                body_tries = seed_result.try_counter;
                body_index = body_index + 1;
                continue;
            }
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                body_locals,
                statement,
                body_strings,
                body_temps,
                body_tries,
                aliases,
                then_body_stmts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_strings = let_result.string_counter;
            body_temps = let_result.temp_counter;
            body_tries = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(stmt_kind, "Defer") {
                let defer_body = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "expr", 0, stmt_sf
                );
                try pending_defers.append(defer_body);
            } else {
            if std::mem::equal_bytes(stmt_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    body_locals,
                    statement,
                    body_strings,
                    body_temps,
                    body_tries,
                    body_alias_counter,
                    child_namespace * 1000 + body_index + 1,
                    aliases,
                    then_body_stmts,
                    continue_loop_index,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_strings = if_result.string_counter;
                body_temps = if_result.temp_counter;
                body_tries = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        body_locals,
                        statement,
                        body_strings,
                        body_temps,
                        body_tries,
                        aliases,
                        then_body_stmts,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_strings = expr_result.string_counter;
                    body_temps = expr_result.temp_counter;
                    body_tries = expr_result.try_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "Assign") {
                        // The nested then-body's try-call statement is followed by six scalar
                        // reassignments ('index = next_index;' ..  'at_line_start = true;',
                        // selfhost/src/parser/format.kizu:33-38), each updating a local bound
                        // before the then-body. lower_void_then_body_assign lowers the value
                        // through the generic expr lowering and binds a fresh AliasAssign so the
                        // join can merge the updated local without redefining the source SSA name
                        // (issue 1207).
                        let assign_result = try lower_void_then_body_assign(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            body_locals,
                            statement,
                            body_strings,
                            body_temps,
                            body_tries,
                            body_alias_counter,
                            aliases,
                            then_body_stmts,
                            bs,
                            ir_lookup_index, canonical_facts, call_arg_type_cache
                        );
                        body_strings = assign_result.string_counter;
                        body_temps = assign_result.temp_counter;
                        body_tries = assign_result.try_counter;
                        body_alias_counter = assign_result.alias_counter;
                    } else {
                        if std::mem::equal_bytes(stmt_kind, "While") {
                            // A loop inside an if arm lowers through the same path a loop in
                            // another loop's body takes. Its labels and carried names take this
                            // block's own namespace, and its seeds resolve against this block --
                            // the lexical scope walk reaches whatever the enclosing blocks declare.
                            let nested_result = try lower_multi_while_statement(
                                ir_bytes,
                                function_name,
                                module_prefix,
                                llvm_return_type,
                                body_locals,
                                statement,
                                body_strings,
                                body_temps,
                                body_alias_counter,
                                child_namespace * 1000 + body_index + 1,
                                then_node,
                                body_index,
                                aliases,
                                then_body_stmts,
                                bs,
                                ir_lookup_index, canonical_facts, call_arg_type_cache
                            );
                            body_strings = nested_result.string_counter;
                            body_temps = nested_result.temp_counter;
                            body_alias_counter = nested_result.alias_counter;
                        } else {
                        if std::mem::equal_bytes(stmt_kind, "Return") {
                            let after_return = try ir_contract::body_child_sequence_or_minus_one_from(
                                ir_bytes, function_name, then_node, "statement",
                                body_index + 1, body_scan_from
                            );
                            if after_return >= 0 {
                                return error("compiled mir: void then-body return must be final");
                            }
                            try emit_pending_defers(
                                ir_lookup_index, canonical_facts, ir_bytes,
                                function_name, module_prefix, llvm_return_type,
                                body_locals, &pending_defers, body_strings,
                                body_temps, body_tries, aliases, then_body_stmts,
                                bs, call_arg_type_cache
                            );
                            let return_stmt = try lower_multi_return_statement(
                                ir_bytes,
                                function_name,
                                module_prefix,
                                llvm_return_type,
                                body_locals,
                                statement,
                                body_strings,
                                body_temps,
                                aliases,
                                bs,
                                ir_lookup_index, canonical_facts, call_arg_type_cache
                            );
                            try then_body_stmts.append(return_stmt);
                            let appended = try then_body_stmts.at(then_body_stmts.len() - 1);
                            let advance = try return_body_advance(
                                &appended, body_temps, body_strings
                            );
                            body_strings = advance.string_counter;
                            body_temps = advance.temp_counter;
                            body_returns = true;
                        } else {
                        if std::mem::equal_bytes(stmt_kind, "Break") {
                            // A break ends its block the way a continue does, and leaves by the
                            // loop's exit edge instead of its back edge.
                            let after_break =
                                try ir_contract::body_child_sequence_or_minus_one_from(
                                    ir_bytes, function_name, then_node, "statement",
                                    body_index + 1, body_scan_from
                                );
                            if after_break >= 0 {
                                return error(
                                    "compiled mir: void then-body break must be final"
                                );
                            }
                            if continue_loop_index < 0 {
                                return error(
                                    "compiled mir: break is not supported in this loop shape"
                                );
                            }
                            try emit_pending_defers(
                                ir_lookup_index, canonical_facts, ir_bytes,
                                function_name, module_prefix, llvm_return_type,
                                body_locals, &pending_defers, body_strings,
                                body_temps, body_tries, aliases, then_body_stmts,
                                bs, call_arg_type_cache
                            );
                            try then_body_stmts.append(
                                compiled_mir::loop_break_stmt(continue_loop_index)
                            );
                            body_returns = true;
                        } else {
                        if std::mem::equal_bytes(stmt_kind, "Continue") {
                            // A continue ends its block the way a return does: whatever follows it
                            // in the source is unreachable, so there must be nothing to lower.
                            let after_continue =
                                try ir_contract::body_child_sequence_or_minus_one_from(
                                    ir_bytes, function_name, then_node, "statement",
                                    body_index + 1, body_scan_from
                                );
                            if after_continue >= 0 {
                                return error(
                                    "compiled mir: void then-body continue must be final"
                                );
                            }
                            if continue_loop_index < 0 {
                                // Only a loop that carries its values in slots can be re-entered
                                // from an arbitrary point in its body. Every other loop shape
                                // reaches here with -1, and saying so beats emitting a branch to a
                                // head whose phis have no operand for this edge.
                                return error(
                                    "compiled mir: continue is not supported in this loop shape"
                                );
                            }
                            try emit_pending_defers(
                                ir_lookup_index, canonical_facts, ir_bytes,
                                function_name, module_prefix, llvm_return_type,
                                body_locals, &pending_defers, body_strings,
                                body_temps, body_tries, aliases, then_body_stmts,
                                bs, call_arg_type_cache
                            );
                            try then_body_stmts.append(
                                compiled_mir::loop_continue_stmt(continue_loop_index)
                            );
                            body_returns = true;
                        } else {
                            var message = std::string::String(std::mem::page_allocator());
                            try message.append_bytes(
                                "compiled mir: unsupported then-body statement kind: "
                            );
                            try message.append_bytes(function_name);
                            try message.append_bytes(" node ");
                            try std::fmt::append_i64(&var message, statement);
                            try message.append_bytes(" kind ");
                            try message.append_bytes(stmt_kind);
                            let message_bytes = message.as_bytes();
                            return error(message_bytes);
                        }
                        }
                        }
                        }
                    }
                }
            }
            }
        }
        body_index = body_index + 1;
        if body_returns {
            break;
        }
    }
    if !body_returns {
        try emit_pending_defers(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, llvm_return_type,
            body_locals, &pending_defers, body_strings,
            body_temps, body_tries, aliases, then_body_stmts,
            bs, call_arg_type_cache
        );
    }
    return VoidBodyLowerResult {
        locals_spec: body_locals,
        string_counter: body_strings,
        temp_counter: body_temps,
        try_counter: body_tries,
        alias_counter: body_alias_counter,
        body_returns: body_returns
    };
}

fn copy_aliases_into(
    aliases: &var std::array::Array<LocalAliasState>,
    source_aliases: &std::array::Array<LocalAliasState>
) -> !void {
    var index = 0;
    while index < source_aliases.len() {
        let state = try source_aliases.at(index);
        try set_local_alias(aliases, state.source_name, state.current_name);
        index = index + 1;
    }
    return;
}

fn append_void_if_else_merge_for_source(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    source_name: []u8,
    then_node: i64,
    else_node: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    then_aliases: &std::array::Array<LocalAliasState>,
    else_aliases: &std::array::Array<LocalAliasState>,
    merge_vars: &var std::array::Array<compiled_mir::MirIfMergeVar>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    // A shadowed name is handled by per-binding SSA rename, not by a join phi: a 'let <name>'
    // inside either arm is an independent value that dies at the arm's end, so its branch alias
    // must never merge into the enclosing scope's binding of the same name.
    if try let_binding_is_shadowed(ir_bytes, function_name, source_name, bs) {
        return alias_counter;
    }
    // A name this if's arms declare and no enclosing statement does has no incoming value to seed
    // the join slot with, so it takes no merge either.
    if try let_binding_is_local_to_branch(
        ir_bytes, function_name, then_node, else_node, source_name, bs
    ) {
        return alias_counter;
    }
    let input_name = try local_alias_current_name(aliases, source_name);
    let then_name = try local_alias_current_name(then_aliases, source_name);
    let else_name = try local_alias_current_name(else_aliases, source_name);
    if std::mem::equal_bytes(input_name, then_name) and
        std::mem::equal_bytes(input_name, else_name) {
        return alias_counter;
    }
    let output_name = try void_then_alias_name(alias_counter, call_arg_type_cache);
    let merge_type = try compiled_mir_types::resolve_value_llvm_type_indexed(
        ir_lookup_index,
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        source_name,
        bs
    );
    try merge_vars.append(compiled_mir::if_else_merge_var(
        source_name,
        input_name,
        then_name,
        else_name,
        output_name,
        merge_type
    ));
    try set_local_alias(aliases, source_name, output_name);
    return alias_counter + 1;
}

fn append_void_if_else_merge_vars(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    then_node: i64,
    else_node: i64,
    alias_counter: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    then_aliases: &std::array::Array<LocalAliasState>,
    else_aliases: &std::array::Array<LocalAliasState>,
    merge_vars: &var std::array::Array<compiled_mir::MirIfMergeVar>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    var merge_alias_counter = alias_counter;
    var then_index = 0;
    while then_index < then_aliases.len() {
        let state = try then_aliases.at(then_index);
        merge_alias_counter = try append_void_if_else_merge_for_source(
            ir_lookup_index,
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            state.source_name,
            then_node,
            else_node,
            merge_alias_counter,
            aliases,
            then_aliases,
            else_aliases,
            merge_vars,
            bs,
            call_arg_type_cache
        );
        then_index = then_index + 1;
    }
    var else_index = 0;
    while else_index < else_aliases.len() {
        let state = try else_aliases.at(else_index);
        if (try local_alias_index(then_aliases, state.source_name)) < 0 {
            merge_alias_counter = try append_void_if_else_merge_for_source(
                ir_lookup_index,
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                state.source_name,
                then_node,
                else_node,
                merge_alias_counter,
                aliases,
                then_aliases,
                else_aliases,
                merge_vars,
                bs,
                call_arg_type_cache
            );
        }
        else_index = else_index + 1;
    }
    return merge_alias_counter;
}

fn lower_void_if_else_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    string_counter: i64,
    cond_result: i64,
    cond_insts: &std::array::Array<compiled_mir::MirExprInst>,
    then_node: i64,
    else_node: i64,
    then_string_base: i64,
    then_base: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    continue_loop_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    var then_body_stmts =
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var merge_vars =
        std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator());
    var then_aliases = try copy_local_aliases(aliases);
    defer then_aliases.deinit();
    let then_body = try lower_void_then_body(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        then_node,
        then_string_base,
        then_base,
        try_counter,
        alias_counter,
        if_index,
        &var then_aliases,
        &var then_body_stmts,
        continue_loop_index,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var else_body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var else_aliases = try copy_local_aliases(aliases);
    defer else_aliases.deinit();
    let else_body = try lower_void_then_body(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        else_node,
        then_body.string_counter,
        then_body.temp_counter,
        then_body.try_counter,
        then_body.alias_counter,
        // Else-body nested-if namespace base: the then base * 1000 + 500 reserves the else its own
        // sub-bucket above the then body's range. reserved_nested_base keeps the statement-0 case
        // (if_index 0) out of bucket 0 here too, matching the then body (issue 1157).
        (try reserved_nested_base(if_index, ir_bytes, function_name, bs)) * 1000 + 500,
        &var else_aliases,
        &var else_body_stmts,
        continue_loop_index,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var merge_alias_counter = else_body.alias_counter;
    if then_body.body_returns and else_body.body_returns {
        return error("compiled mir: void if/else with both branches returning not yet supported");
    }
    if then_body.body_returns {
        try copy_aliases_into(aliases, &else_aliases);
    } else {
        if else_body.body_returns {
            try copy_aliases_into(aliases, &then_aliases);
        } else {
            merge_alias_counter = try append_void_if_else_merge_vars(
                ir_lookup_index,
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                then_node,
                else_node,
                else_body.alias_counter,
                aliases,
                &then_aliases,
                &else_aliases,
                &var merge_vars,
                bs,
                call_arg_type_cache
            );
        }
    }
    try stmts.append(compiled_mir::if_else_void_body_stmt(
        if_index,
        string_counter,
        cond_result,
        try compiled_mir::copy_expr_insts(cond_insts),
        then_body_stmts,
        else_body_stmts,
        merge_vars
    ));
    return MultiIfLowerResult {
        temp_counter: else_body.temp_counter,
        string_counter: else_body.string_counter,
        try_counter: else_body.try_counter,
        alias_counter: merge_alias_counter
    };
}

fn lower_void_if_no_else_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    cond_result: i64,
    cond_insts: &std::array::Array<compiled_mir::MirExprInst>,
    cond_short_circuit: i64,
    cond_rhs_result: i64,
    cond_rhs_insts: &std::array::Array<compiled_mir::MirExprInst>,
    cond_extra_operands: &std::array::Array<compiled_mir::MirCondOperand>,
    cond_targets: &std::array::Array<compiled_mir::MirCondTarget>,
    then_node: i64,
    then_string_base: i64,
    then_base: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    continue_loop_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    try require_void_then_block_no_else(ir_bytes, function_name, statement, bs);
    var then_body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var merge_vars = std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator());
    var branch_aliases = try copy_local_aliases(aliases);
    defer branch_aliases.deinit();
    let then_body = try lower_void_then_body(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        then_node,
        then_string_base,
        then_base,
        try_counter,
        alias_counter,
        if_index,
        &var branch_aliases,
        &var then_body_stmts,
        continue_loop_index,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var branch_alias_index = 0;
    var merge_alias_counter = then_body.alias_counter;
    if !then_body.body_returns {
        while branch_alias_index < branch_aliases.len() {
            let branch_state = try branch_aliases.at(branch_alias_index);
            // A shadowed name is handled by per-binding SSA rename, not by a join phi: each
            // 'let <name>' inside a branch is an independent value that dies at the branch end, so
            // its branch alias must never merge into the enclosing scope's binding of the same name.
            if try let_binding_is_shadowed(ir_bytes, function_name, branch_state.source_name, bs) {
                branch_alias_index = branch_alias_index + 1;
                continue;
            }
            // A name this branch declares and no enclosing statement does has no incoming value to
            // seed the join slot with, so it takes no merge either.
            if try let_binding_is_local_to_branch(
                ir_bytes, function_name, then_node, -1, branch_state.source_name, bs
            ) {
                branch_alias_index = branch_alias_index + 1;
                continue;
            }
            let input_name = try local_alias_current_name(aliases, branch_state.source_name);
            if !std::mem::equal_bytes(input_name, branch_state.current_name) {
                let output_name = try void_then_alias_name(
                    merge_alias_counter, call_arg_type_cache
                );
                let merge_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
                    ir_lookup_index,
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    branch_state.source_name,
                    bs, call_arg_type_cache
                );
                try merge_vars.append(compiled_mir::if_merge_var(
                    branch_state.source_name,
                    input_name,
                    branch_state.current_name,
                    output_name,
                    merge_type
                ));
                try set_local_alias(aliases, branch_state.source_name, output_name);
                merge_alias_counter = merge_alias_counter + 1;
            }
            branch_alias_index = branch_alias_index + 1;
        }
    }
    try stmts.append(compiled_mir::if_stmt(
        if_index,
        string_counter,
        cond_result,
        try compiled_mir::copy_expr_insts(cond_insts),
        cond_short_circuit,
        cond_rhs_result,
        try compiled_mir::copy_expr_insts(cond_rhs_insts),
        try compiled_mir::copy_cond_operands(cond_extra_operands),
        try compiled_mir::copy_cond_targets(cond_targets),
        compiled_mir::MirIfThenKind::VoidBody,
        false,
        llvm_return_type,
        "",
        "",
        std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        then_string_base,
        then_body_stmts,
        merge_vars
    ));
    return MultiIfLowerResult {
        temp_counter: then_body.temp_counter,
        string_counter: then_body.string_counter,
        try_counter: then_body.try_counter,
        alias_counter: merge_alias_counter
    };
}

fn lower_void_if_body_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    cond_result: i64,
    cond_insts: &std::array::Array<compiled_mir::MirExprInst>,
    cond_short_circuit: i64,
    cond_rhs_result: i64,
    cond_rhs_insts: &std::array::Array<compiled_mir::MirExprInst>,
    cond_extra_operands: &std::array::Array<compiled_mir::MirCondOperand>,
    cond_targets: &std::array::Array<compiled_mir::MirCondTarget>,
    then_node: i64,
    then_string_base: i64,
    then_base: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    continue_loop_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, statement, "else", 0, sf
    );
    if else_node >= 0 {
        let else_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, else_node, bs
        );
        let else_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, else_node, else_sf
        );
        if !std::mem::equal_bytes(else_kind, "Empty") {
            if !std::mem::equal_bytes(else_kind, "Block") {
                return error("compiled mir: void if/else else arm must be a block");
            }
            if cond_short_circuit != 0 {
                // Name the function and node. A bare "not yet supported" costs a native
                // rebuild per attempt to locate, and this is the message a source landing
                // outside the lowered subset hits first.
                return unsupported_lowering_shape(
                    "void if/else short-circuit condition", function_name, statement
                );
            }
            return try lower_void_if_else_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                string_counter,
                cond_result,
                cond_insts,
                then_node,
                else_node,
                then_string_base,
                then_base,
                try_counter,
                alias_counter,
                if_index,
                aliases,
                stmts,
                continue_loop_index,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
    }
    return try lower_void_if_no_else_statement(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        statement,
        string_counter,
        cond_result,
        cond_insts,
        cond_short_circuit,
        cond_rhs_result,
        cond_rhs_insts,
        cond_extra_operands,
        cond_targets,
        then_node,
        then_string_base,
        then_base,
        try_counter,
        alias_counter,
        if_index,
        aliases,
        stmts,
        continue_loop_index,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
}

fn lower_multi_if_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    if_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    continue_loop_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    // sf tightens this If statement's own structural facts (condition/then/else edges, the
    // guard-then block's statement/return shape, the guard callee detail) to its body-node line
    // via the index; that subtree sorts at-or-after it, so a scan from sf is byte-identical to one
    // from bs. The try-call shape detectors that read back across the function, the then/else block
    // lowering recursion, and the index-keyed return-type resolver keep bs.
    let sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, statement, bs);
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, sf
    );
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "then", 0, sf
    );
    let cond_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, cond_node, bs);
    let then_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, then_node, bs);
    let cond_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, cond_node, cond_sf
    );
    // Prefix-not try-call conditions hoist the sub-expression try-call (issue 1165 / 1162). The
    // existing return-bool guard keeps its dedicated renderer; void then-bodies share the positive
    // try-call if lowering with inverted branch polarity, so failure propagation and alias merging
    // stay on the same path.
    var guard_not_try = -1;
    if std::mem::equal_bytes(cond_kind, "Prefix") {
        guard_not_try = try prefix_not_try_call_inner_or_minus_one(
            ir_bytes, function_name, module_prefix, cond_node, cond_sf, ir_lookup_index
        );
    }
    if guard_not_try >= 0 {
        let guard_then_extra = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, then_node, "statement", 1, sf
        );
        if guard_then_extra < 0 {
            let guard_then_stmt = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, then_node, "statement", 0, sf
            );
            let guard_then_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, guard_then_stmt, sf
            );
            if std::mem::equal_bytes(guard_then_kind, "Return") {
                let guard_ret_value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, guard_then_stmt, "value", 0, sf
                );
                let guard_ret_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, guard_ret_value, sf
                );
                if std::mem::equal_bytes(guard_ret_kind, "Bool") {
                    // The guard is rendered then-only (the negation returns the bool or falls through
                    // to the join), so an else arm with a real body would be silently dropped: reject
                    // it as an explicit error rather than mis-lower it (issue 1165 / 1162).
                    try require_if_not_try_guard_no_else(ir_bytes, function_name, statement, sf);
                    let guard_token = try ir_contract::body_token_or_empty_from(
                        ir_bytes, function_name, guard_ret_value, sf
                    );
                    let guard_bool_value = std::mem::equal_bytes(guard_token, "true");
                    let guard_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
                        ir_lookup_index, canonical_facts, ir_bytes,
                        function_name, module_prefix, guard_not_try, sf, call_arg_type_cache
                    );
                    let guard_args = try lower_call_args_with_local_aliases_cached(
                        ir_bytes, function_name, module_prefix, locals_spec, guard_not_try,
                        string_counter, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    let guard_arg_strings = try compiled_mir_lower_call::count_string_args(&guard_args);
                    try stmts.append(compiled_mir::if_not_try_call_return_bool_stmt(
                        guard_info.return_llvm_type, llvm_return_type,
                        guard_info.module_prefix, guard_info.callee_name,
                        guard_bool_value, string_counter, guard_args
                    ));
                    return MultiIfLowerResult {
                        temp_counter: temp_counter,
                        string_counter: string_counter + guard_arg_strings,
                        try_counter: try_counter,
                        alias_counter: alias_counter
                    };
                }
            }
        }
        return try lower_try_call_void_if(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            then_node,
            guard_not_try,
            string_counter,
            temp_counter,
            try_counter,
            alias_counter,
            if_index,
            false,
            aliases,
            stmts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    var positive_try = -1;
    if std::mem::equal_bytes(cond_kind, "TryExpr") {
        positive_try = try positive_try_call_condition_inner_or_minus_one(
            ir_bytes, function_name, module_prefix, cond_node, cond_sf, ir_lookup_index
        );
    }
    if positive_try >= 0 {
        return try lower_try_call_void_if(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            then_node,
            positive_try,
            string_counter,
            temp_counter,
            try_counter,
            alias_counter,
            if_index,
            true,
            aliases,
            stmts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    var cond_short_circuit = 0;
    if std::mem::equal_bytes(cond_kind, "Binary") {
        cond_short_circuit = try short_circuit_kind(ir_bytes, function_name, cond_node, cond_sf);
        if cond_short_circuit != 0 and
            (try condition_eager_safe(ir_bytes, function_name, cond_node, cond_sf)) {
            cond_short_circuit = 0;
        }
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_rhs_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_extra_operands = std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator());
    var cond_targets = std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator());
    var cond_result = -1;
    var cond_rhs_result = -1;
    var last_cond_result = -1;
    var cond_strings = 0;
    if cond_short_circuit == 0 {
        cond_result = try lower_expr_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            cond_node,
            string_counter,
            temp_counter,
            &var cond_insts,
            aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        cond_strings = try count_strings_in_insts(&cond_insts);
        last_cond_result = cond_result;
    } else {
        // A short-circuit condition lowers as a chain of leaf operands evaluated left to right,
        // each in its own block and each carrying the two destinations its i1 result branches to.
        // Leaf 0 fills cond_insts (the unguarded entry block), leaf 1 fills cond_rhs_insts (the
        // first guarded block), and any further leaves fill cond_extra_operands. Nesting is
        // structural rather than special-cased: collect_cond_leaves descends 'and' and 'or' alike,
        // so a mixed tree changes only the recorded edges (issue 1165 / 1162).
        var leaves = std::array::Array<CondLeaf>(std::mem::page_allocator());
        try collect_cond_leaves(
            ir_bytes, function_name, cond_node, 0,
            compiled_mir::cond_target_condition_true(),
            compiled_mir::cond_target_condition_false(),
            &var leaves, bs
        );
        let first_leaf = try leaves.at(0);
        let first_node = first_leaf.node;
        let first_true = first_leaf.true_target;
        let first_false = first_leaf.false_target;
        cond_result = try lower_expr_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            first_node,
            string_counter,
            temp_counter,
            &var cond_insts,
            aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        try cond_targets.append(compiled_mir::cond_target(first_true, first_false));
        var acc_strings = try count_strings_in_insts(&cond_insts);
        var acc_temp = temp_counter + cond_insts.len();
        let second_leaf = try leaves.at(1);
        let second_node = second_leaf.node;
        let second_true = second_leaf.true_target;
        let second_false = second_leaf.false_target;
        cond_rhs_result = try lower_expr_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            second_node,
            string_counter + acc_strings,
            acc_temp,
            &var cond_rhs_insts,
            aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        try cond_targets.append(compiled_mir::cond_target(second_true, second_false));
        acc_strings = acc_strings + try count_strings_in_insts(&cond_rhs_insts);
        acc_temp = acc_temp + cond_rhs_insts.len();
        last_cond_result = cond_rhs_result;
        var leaf_index = 2;
        while leaf_index < leaves.len() {
            var operand_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let leaf = try leaves.at(leaf_index);
            let leaf_node = leaf.node;
            let leaf_true = leaf.true_target;
            let leaf_false = leaf.false_target;
            let operand_result = try lower_expr_with_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                leaf_node,
                string_counter + acc_strings,
                acc_temp,
                &var operand_insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            acc_strings = acc_strings + try count_strings_in_insts(&operand_insts);
            acc_temp = acc_temp + operand_insts.len();
            last_cond_result = operand_result;
            try cond_extra_operands.append(
                compiled_mir::cond_operand(operand_result, operand_insts)
            );
            try cond_targets.append(compiled_mir::cond_target(leaf_true, leaf_false));
            leaf_index = leaf_index + 1;
        }
        cond_strings = acc_strings;
        leaves.deinit();
        cond_short_circuit = 1;
    }
    let then_string_base = string_counter + cond_strings;
    let then_base = last_cond_result + 1;
    let then_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, then_sf
    );
    let then_stmt_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, then_stmt, bs
    );
    let then_stmt_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, then_stmt, then_stmt_sf
    );
    // A continue-latch then-block ('{ <induction> = <induction> + <step>; continue; }') carries no
    // return value: it folds its increment into the loop's shared constant-step latch and branches
    // back to the loop head, so it lowers to a ContinueLatch if whose then-block the renderer turns
    // into 'br label %loop<N>_latch'. line_comment_has_blank_after is its first consumer (issue 1165
    // / 1162). It shares the single if_stmt append below: the then-block fields stay empty and the
    // temp / string counters do not advance.
    var is_continue_latch_then = false;
    let then_continue = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, then_node, "statement", 1, then_sf
    );
    if then_continue >= 0 {
        let then_continue_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, then_continue, bs
        );
        let then_continue_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, then_continue, then_continue_sf
        );
        if std::mem::equal_bytes(then_stmt_kind, "Assign") and
            std::mem::equal_bytes(then_continue_kind, "Continue") {
            is_continue_latch_then = true;
            let then_extra = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, then_node, "statement", 2, then_continue_sf
            );
            if then_extra >= 0 {
                return error("compiled mir: continue-latch then-block must be '<increment>; continue;'");
            }
            // Validate the increment is a foldable induction advance against its own target so a
            // near-miss assign is an explicit error rather than a silently dropped latch update; the
            // while lowering re-reads the target/step (or copy source) to drive the latch. The
            // advance is either a constant-step '<var> = <var> + <int>' increment or a copy-decrement
            // '<var> = <local>' copy (its local validated as a '<var> - <int>' decrement at the while
            // level through validate_copy_latch_source).
            let incr_target = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, then_stmt, "target", 0, bs
            );
            let incr_target_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, incr_target, bs
            );
            if !std::mem::equal_bytes(incr_target_kind, "Var") {
                return error("compiled mir: continue-latch increment target must be a var");
            }
            let incr_target_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, incr_target, bs
            );
            if !(try while_assign_is_induction_copy(ir_bytes, function_name, then_stmt, bs)) {
                let _step = try parse_induction_step(
                    ir_bytes, function_name, then_stmt, incr_target_name, bs
                );
            }
        }
    }
    if !is_continue_latch_then and !std::mem::equal_bytes(then_stmt_kind, "Return") {
        return try lower_void_if_body_statement(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            cond_result,
            &cond_insts,
            cond_short_circuit,
            cond_rhs_result,
            &cond_rhs_insts,
            &cond_extra_operands,
            &cond_targets,
            then_node,
            then_string_base,
            then_base,
            try_counter,
            alias_counter,
            if_index,
            aliases,
            stmts,
            continue_loop_index,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    var then_kind = compiled_mir::MirIfThenKind::ContinueLatch;
    var bool_value = false;
    var call_type = llvm_return_type;
    var then_module_prefix = "";
    var callee_name = "";
    var call_args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var then_result = -1;
    var then_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var then_struct_fields = std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator());
    var then_body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var merge_vars = std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator());
    var then_struct_strings = 0;
    var next_temp = then_base;
    var new_string_counter = then_string_base;
    var new_try_counter = try_counter;
    var new_alias_counter = alias_counter;
    if !is_continue_latch_then {
        let ret_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, then_stmt, "value", 0, then_stmt_sf
        );
        let ret_value_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, ret_value, bs
        );
        let ret_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, ret_value, ret_value_sf
        );
        then_kind = compiled_mir::MirIfThenKind::ReturnExpr;
        var then_body_return_done = false;
        if std::mem::equal_bytes(ret_kind, "TryExpr") {
            let try_inner = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, ret_value, "value", 0, ret_value_sf
            );
            let try_inner_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, try_inner, ret_value_sf
            );
            if std::mem::equal_bytes(try_inner_kind, "Call") and
                (try call_is_value_array_get_cached(
                    ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
                    try_inner, bs, call_arg_type_cache
                )) {
                then_kind = compiled_mir::MirIfThenKind::VoidBody;
                let return_stmt = try lower_multi_return_value_array_get(
                    ir_bytes, function_name, module_prefix, locals_spec,
                    try_inner, then_string_base, then_base, aliases, bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                try then_body_stmts.append(return_stmt);
                let appended = try then_body_stmts.at(then_body_stmts.len() - 1);
                let advance = try return_body_advance(&appended, then_base, then_string_base);
                next_temp = advance.temp_counter;
                new_string_counter = advance.string_counter;
                then_body_return_done = true;
            }
        }
        if !then_body_return_done {
        // 'if <cond> { return try <callee>(<args>); }' whose callee shares this
        // function's error-union return is an identity tail: unwrap it to the inner
        // call here (validating the error-union match) so the existing Call branch
        // below lowers it as a ReturnCall without adding nesting depth.
        let then_return_value = try unwrap_then_identity_try(
            ir_lookup_index, canonical_facts, call_arg_type_cache,
            ir_bytes, function_name, llvm_return_type, ret_value, ret_kind, bs
        );
        let resolved_ret_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, then_return_value, bs
        );
        if std::mem::equal_bytes(resolved_ret_kind, "Empty") {
            then_kind = compiled_mir::MirIfThenKind::VoidReturnSuccess;
        } else {
        if std::mem::equal_bytes(resolved_ret_kind, "Bool") {
            let token = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, then_return_value, bs
            );
            then_kind = compiled_mir::MirIfThenKind::ReturnBool;
            bool_value = std::mem::equal_bytes(token, "true");
        } else {
            if std::mem::equal_bytes(resolved_ret_kind, "Call") {
                if try callee_is_field_expr_cached(
                    ir_bytes, function_name, then_return_value, bs,
                    call_arg_type_cache
                ) or try call_has_hoisted_arg_cached(
                    ir_bytes, function_name, then_return_value, bs,
                    call_arg_type_cache
                ) {
                    then_result = try lower_expr_with_local_aliases(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        then_return_value,
                        then_string_base,
                        then_base,
                        &var then_insts,
                        aliases,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    then_kind = compiled_mir::MirIfThenKind::ReturnExpr;
                } else {
                if try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, then_return_value, bs) {
                    then_kind = compiled_mir::MirIfThenKind::ReturnError;
                    let message_node = try ir_contract::body_child_sequence_from(
                        ir_bytes, function_name, then_return_value, "arg", 0, bs
                    );
                    then_result = try lower_expr_with_local_aliases(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        message_node,
                        then_string_base,
                        then_base,
                        &var then_insts,
                        aliases,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                } else {
                let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
                    ir_lookup_index, canonical_facts, ir_bytes,
                    function_name, module_prefix, then_return_value, bs, call_arg_type_cache
                );
                call_type = call_info.return_llvm_type;
                callee_name = call_info.callee_name;
                call_args = try lower_call_args_with_local_aliases_cached(
                    ir_bytes, function_name, module_prefix, locals_spec, then_return_value, then_string_base,
                    aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                then_kind = compiled_mir::MirIfThenKind::ReturnCall;
                then_module_prefix = call_info.module_prefix;
                }
                }
            } else {
                if std::mem::equal_bytes(resolved_ret_kind, "StructLiteralExpr") {
                    // A struct-literal then-block such as a return of PayloadSpan { .. }
                    // reuses the generic struct-field lowering. The struct SSA and global
                    // names are seeded from then_string_base, and the string counter then
                    // advances by the field count so a later then-block in the same
                    // function never reuses the same per-field SSA names.
                    then_struct_fields = try compiled_mir_lower_struct::lower_struct_fields(
                        ir_bytes, function_name, module_prefix, locals_spec, then_return_value, bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    then_kind = compiled_mir::MirIfThenKind::ReturnStruct;
                    then_struct_strings = then_struct_fields.len();
                } else {
                    then_result = try lower_expr_with_local_aliases(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        locals_spec,
                        then_return_value,
                        then_string_base,
                        then_base,
                        &var then_insts,
                        aliases,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                }
            }
        }
        }
        let then_call_strings = try compiled_mir_lower_call::count_string_args(&call_args);
        let then_expr_strings = try count_strings_in_insts(&then_insts);
        new_string_counter = then_string_base + then_call_strings + then_expr_strings + then_struct_strings;
        if then_kind == compiled_mir::MirIfThenKind::ReturnCall {
            next_temp = then_base + 1;
        }
        if then_kind == compiled_mir::MirIfThenKind::ReturnExpr {
            next_temp = then_result + 1;
        }
        if then_kind == compiled_mir::MirIfThenKind::ReturnError {
            next_temp = then_result + 1;
        }
        }
    }
    try stmts.append(compiled_mir::if_stmt(
            if_index,
            string_counter,
            cond_result,
            cond_insts,
            cond_short_circuit,
            cond_rhs_result,
            cond_rhs_insts,
            cond_extra_operands,
            cond_targets,
            then_kind,
            bool_value,
            call_type,
            then_module_prefix,
            callee_name,
            call_args,
            then_result,
            then_insts,
            then_struct_fields,
            then_string_base,
            then_body_stmts,
            merge_vars
    ));
    return MultiIfLowerResult {
        temp_counter: next_temp,
        string_counter: new_string_counter,
        try_counter: new_try_counter,
        alias_counter: new_alias_counter
    };
}
// unwrap_then_identity_try resolves a then-block return value: a 'return try <call>;'
// whose callee shares the function's error-union return is an identity tail, so it
// unwraps to the inner call node (validated against the return type) for the existing
// ReturnCall path; any other value passes through unchanged.
fn unwrap_then_identity_try(
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &compiled_mir_types::CallArgTypeCache,
    ir_bytes: []u8,
    function_name: []u8,
    llvm_return_type: []u8,
    ret_value: i64,
    ret_kind: []u8,
    bs: i64
) -> !i64 {
    if !std::mem::equal_bytes(ret_kind, "TryExpr") {
        return ret_value;
    }
    let try_inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, ret_value, "value", 0, bs
    );
    let try_inner_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, try_inner, bs
    );
    if !std::mem::equal_bytes(try_inner_kind, "Call") {
        return error("compiled mir: then-body return try must wrap a call");
    }
    let span = try compiled_mir_types::fn_call_span(
        call_arg_type_cache, ir_bytes, try_inner
    );
    var call_types = compiled_canonical_facts::ParsedCallTypeFact {
        receiver_id: -1,
        result_id: -1,
        runtime_start: -1,
        runtime_len: 0,
        actual_start: -1,
        actual_len: 0
    };
    if call_arg_type_cache.instance_id >= 0 {
        call_types =
            try compiled_canonical_facts::parsed_call_type_for_span_instance_id(
                canonical_facts, call_arg_type_cache.instance_id,
                span.start, span.end
            );
    } else {
        call_types = try compiled_canonical_facts::parsed_call_type_for_span(
            canonical_facts, &function_name, span.start, span.end
        );
    }
    let try_call_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, call_types.result_id
        );
    if !std::mem::equal_bytes(try_call_type, llvm_return_type) {
        return error("compiled mir: then-body return try must share the function's error union");
    }
    return try_inner;
}

// while_body_statement_count counts the statements in a while body Block by walking
// its "statement" child sequences until none remain.
fn while_body_statement_count(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    bs: i64
) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, body_node, "statement", count, bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}
// while_induction_var returns the counter a while loop carries: the target of the
// trailing 'name = name + step' increment that must close the loop body. The body's
// last statement must be that Assign to a Var (tracker 961).
fn while_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> ![]u8 {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes(
            "compiled mir: while body must end with the induction increment: "
        );
        try message.append_bytes(function_name);
        try message.append_bytes(" empty body");
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "Assign") {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes(
            "compiled mir: while body must end with the induction increment: "
        );
        try message.append_bytes(function_name);
        try message.append_bytes(" last kind ");
        try message.append_bytes(last_kind);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: induction increment target must be a var");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
}
// statement_is_induction_init reports whether a let declares an induction counter of some while
// in the same scope (scope_node's statement list), matching the let name against each while's induction
// variables. Both the primary counter (the trailing increment target) and every secondary
// lockstep counter (an earlier increment in the trailing run) are matched, so a 'var
// left_index = left + 1;' seed for a secondary counter is skipped at the top level and never
// emitted as a let that would redefine the loop-head phi %left_index (issue 1165 / 1162).
fn statement_is_induction_init(
    ir_bytes: []u8,
    function_name: []u8,
    scope_node: i64,
    let_statement: i64,
    statement_count: i64,
    bs: i64
) -> !bool {
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, name_node, bs
    );
    var index = 0;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, scope_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "While") {
            if try while_carries_induction_var(ir_bytes, function_name, statement, let_name, bs) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

fn assign_targets_var(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target, bs
    );
    return std::mem::equal_bytes(target_name, name);
}

fn no_else_if_then_assigns_to_var(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    if else_node >= 0 {
        let else_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, else_node, bs
        );
        if !std::mem::equal_bytes(else_kind, "Empty") {
            return false;
        }
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    return try block_assigns_to_var(ir_bytes, function_name, then_node, name, bs);
}

fn statement_assigns_to_var(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    name: []u8,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
    if std::mem::equal_bytes(kind, "Assign") {
        return try assign_targets_var(ir_bytes, function_name, statement, name, bs);
    }
    if std::mem::equal_bytes(kind, "If") {
        return try no_else_if_then_assigns_to_var(ir_bytes, function_name, statement, name, bs);
    }
    return false;
}

fn block_assigns_to_var(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    var index = 0;
    while true {
        let statement = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, block_node, "statement", index, bs
        );
        if statement < 0 {
            return false;
        }
        if try statement_assigns_to_var(ir_bytes, function_name, statement, name, bs) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// induction_init_needs_prewhile_alias reports whether a skipped induction initializer still needs a
// concrete value before its loop phi: the variable is reassigned by a no-else then-block before the
// matching while, so the then-only branch join must merge the pre-branch value with the assigned
// value. Plain induction initializers keep the historical phi seed path and do not materialize an
// alias, preserving existing backend artifact contracts.
fn induction_init_needs_prewhile_alias(
    ir_bytes: []u8,
    function_name: []u8,
    let_statement: i64,
    let_index: i64,
    statement_count: i64,
    bs: i64
) -> !bool {
    let name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, let_statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, name_node, bs
    );
    var has_prewhile_assignment = false;
    var index = let_index + 1;
    while index < statement_count {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "While") {
            if try while_carries_induction_var(ir_bytes, function_name, statement, let_name, bs) {
                return has_prewhile_assignment;
            }
        }
        if std::mem::equal_bytes(kind, "If") {
            if try no_else_if_then_assigns_to_var(
                ir_bytes, function_name, statement, let_name, bs
            ) {
                has_prewhile_assignment = true;
            }
        }
        index = index + 1;
    }
    return false;
}
// while_carries_induction_var reports whether a while loop advances a counter named name,
// counting both the primary trailing increment target and every secondary increment in the
// trailing run (issue 1165 / 1162).
// while_assign_is_induction_copy reports whether a body Assign is a copy-decrement latch advance:
// a Var target and a plain Var value ('cursor = previous'). The continue-latch lowering validates
// the copied local is a genuine '<induction> - <int>' decrement of the target through
// validate_copy_latch_source before lowering it; here it only classifies the assign shape so the
// continue-latch marker recognizes a copy-decrement step alongside the constant-step one (issue
// 1165 / 1162).
fn while_assign_is_induction_copy(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    bs: i64
) -> !bool {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    return std::mem::equal_bytes(value_kind, "Var");
}
// if_carries_continue_increment reports whether an if statement is the continue-latch marker: a
// then-block of exactly two statements, an induction advance followed by a bare 'continue'. The
// advance is either a constant-step '<var> = <var> + <int>' increment (folded into the shared
// latch add) or a copy-decrement '<var> = <local>' copy whose local is a '<var> - <int>' decrement
// computed earlier in the loop body (driving the latch through latch_copy_var). Both shapes are
// foldable by lower_multi_while_continue_latch, so recognizing them here routes the loop to that
// dedicated path rather than the trailing-increment machinery (issue 1165 / 1162).
fn if_carries_continue_increment(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !bool {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if count != 2 {
        return false;
    }
    let increment = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let continue_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 1, bs
    );
    let continue_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, continue_stmt, bs
    );
    if !std::mem::equal_bytes(continue_kind, "Continue") {
        return false;
    }
    let increment_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, increment, bs
    );
    if !std::mem::equal_bytes(increment_kind, "Assign") {
        return false;
    }
    if try while_assign_is_constant_step(ir_bytes, function_name, increment, bs) {
        return true;
    }
    return try while_assign_is_induction_copy(ir_bytes, function_name, increment, bs);
}
// while_is_continue_latch reports whether a while loop advances its induction variable through a
// continue-latch: a body 'if <cond> { <induction> = <induction> + <step>; continue; }' whose
// then-block is a constant-step increment followed by 'continue', rather than a trailing increment
// assign. Such a loop has no trailing latch statement -- the increment lives inside the continue-if
// and the loop's non-continue path falls through to a 'return'. line_comment_has_blank_after is its
// first consumer (issue 1165 / 1162).
fn while_is_continue_latch(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var index = 0;
    while index < body_count {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "If") {
            if try if_carries_continue_increment(ir_bytes, function_name, stmt, bs) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}
// while_continue_increment_assign returns the '<induction> = <induction> + <step>' Assign node
// inside a continue-latch loop's body continue-if -- the first statement of the if whose then-block
// ends in 'continue' (issue 1165 / 1162).
fn while_continue_increment_assign(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !i64 {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var index = 0;
    while index < body_count {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "If") {
            if try if_carries_continue_increment(ir_bytes, function_name, stmt, bs) {
                let then_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, stmt, "then", 0, bs
                );
                return try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, then_node, "statement", 0, bs
                );
            }
        }
        index = index + 1;
    }
    return error("compiled mir: continue-latch increment not found");
}
// while_continue_induction_var returns the induction variable a continue-latch loop advances: the
// target of the '<induction> = <induction> + <step>' increment inside the body continue-if (issue
// 1165 / 1162).
fn while_continue_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> ![]u8 {
    let assign = try while_continue_increment_assign(ir_bytes, function_name, while_node, bs);
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return error("compiled mir: continue-latch increment target must be a var");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
}
// branch_arm_last_assign_or_minus_one returns the closing statement of a branch-merge arm block
// when it is an Assign, or -1 otherwise. A branch-merge induction latch advances the loop counter
// with the Assign that closes each terminal-if arm, so the arm classifiers key on this last
// statement (issue 1165 / 1162).
fn branch_arm_last_assign_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !i64 {
    let count = try while_body_statement_count(ir_bytes, function_name, block_node, bs);
    if count < 1 {
        return -1;
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, block_node, "statement", count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "Assign") {
        return -1;
    }
    return last_stmt;
}
// branch_arm_assign_target_or_empty returns the Var name a branch-merge arm assigns in its closing
// Assign, or "" when the arm does not end in an Assign to a Var (issue 1165 / 1162).
fn branch_arm_assign_target_or_empty(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> ![]u8 {
    let assign = try branch_arm_last_assign_or_minus_one(ir_bytes, function_name, block_node, bs);
    if assign < 0 {
        return "";
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return "";
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
}
// branch_arm_is_constant_step reports whether a branch-merge arm closes with a constant-step
// '<var> = <var> + <int>' increment (the advance arm) rather than a loop-terminating jump such as
// 'index = format_tokens.len()' (issue 1165 / 1162).
fn branch_arm_is_constant_step(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    bs: i64
) -> !bool {
    let assign = try branch_arm_last_assign_or_minus_one(ir_bytes, function_name, block_node, bs);
    if assign < 0 {
        return false;
    }
    return try while_assign_is_constant_step(ir_bytes, function_name, assign, bs);
}
// while_branch_merge_terminal_if_or_minus_one returns the terminal branch-merge If node at the end
// of a while body, or -1 when the last body statement is not one. A branch-merge induction latch
// advances the loop counter inside a terminal if/else whose then- and else-blocks each END in an
// Assign to the same Var: one arm a constant-step '<var> = <var> + <int>' advance, the other a
// loop-terminating '<var> = <expr>' jump (e.g. 'index = format_tokens.len()' on format_source's eof
// arm) that drives the counter to the bound so the header comparison fails on the next test. Only
// this exact shape returns the If; every near miss -- last statement not an If, a missing/Empty
// else, an else that is an else-if (another If) rather than a block, an arm not ending in an Assign
// to a Var, the two arms targeting different vars, or neither/both arms being the constant-step
// advance -- returns -1 so callers classify without erroring. The dedicated lowering re-validates
// the shape with explicit errors before it lowers (issue 1165 / 1162).
fn while_branch_merge_terminal_if_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !i64 {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        return -1;
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "If") {
        return -1;
    }
    let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
        ir_bytes, function_name, last_stmt, "else", 0, bs
    );
    if else_node < 0 {
        return -1;
    }
    let else_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, else_node, bs);
    // A missing else is emitted as an Empty node; an else-if chains another If here. Neither is a
    // two-block branch merge.
    if std::mem::equal_bytes(else_kind, "Empty") or std::mem::equal_bytes(else_kind, "If") {
        return -1;
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "then", 0, bs
    );
    let then_target = try branch_arm_assign_target_or_empty(ir_bytes, function_name, then_node, bs);
    if std::mem::len(then_target) == 0 {
        return -1;
    }
    let else_target = try branch_arm_assign_target_or_empty(ir_bytes, function_name, else_node, bs);
    if std::mem::len(else_target) == 0 {
        return -1;
    }
    if !std::mem::equal_bytes(then_target, else_target) {
        return -1;
    }
    // Exactly one arm must advance by a constant step; the other is the loop-terminating jump.
    let then_step = try branch_arm_is_constant_step(ir_bytes, function_name, then_node, bs);
    let else_step = try branch_arm_is_constant_step(ir_bytes, function_name, else_node, bs);
    if then_step == else_step {
        return -1;
    }
    return last_stmt;
}
// while_is_branch_merge_latch reports whether a while loop advances its induction counter through a
// terminal branch-merge if/else (issue 1165 / 1162).
fn while_is_branch_merge_latch(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !bool {
    let if_node = try while_branch_merge_terminal_if_or_minus_one(
        ir_bytes, function_name, while_node, bs
    );
    return if_node >= 0;
}
// while_branch_merge_induction_var returns the induction variable a branch-merge latch advances:
// the common Assign target both terminal-if arms close on (issue 1165 / 1162).
fn while_branch_merge_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> ![]u8 {
    let if_node = try while_branch_merge_terminal_if_or_minus_one(
        ir_bytes, function_name, while_node, bs
    );
    if if_node < 0 {
        return error("compiled mir: while body is not a branch-merge induction latch");
    }
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    return try branch_arm_assign_target_or_empty(ir_bytes, function_name, then_node, bs);
}

fn branch_merge_advance_block(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !i64 {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let else_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    let then_step = try branch_arm_is_constant_step(ir_bytes, function_name, then_node, bs);
    let else_step = try branch_arm_is_constant_step(ir_bytes, function_name, else_node, bs);
    if then_step == else_step {
        return error("compiled mir: branch-merge latch must have exactly one advance arm");
    }
    if then_step {
        return then_node;
    }
    return else_node;
}

fn branch_merge_exit_block(
    ir_bytes: []u8,
    function_name: []u8,
    if_node: i64,
    bs: i64
) -> !i64 {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let else_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "else", 0, bs
    );
    let then_step = try branch_arm_is_constant_step(ir_bytes, function_name, then_node, bs);
    let else_step = try branch_arm_is_constant_step(ir_bytes, function_name, else_node, bs);
    if then_step == else_step {
        return error("compiled mir: branch-merge latch must have exactly one exit arm");
    }
    if then_step {
        return else_node;
    }
    return then_node;
}

fn branch_merge_last_assign(
    ir_bytes: []u8,
    function_name: []u8,
    block_node: i64,
    message: []u8,
    bs: i64
) -> !i64 {
    let assign = try branch_arm_last_assign_or_minus_one(ir_bytes, function_name, block_node, bs);
    if assign < 0 {
        return error(message);
    }
    return assign;
}

fn branch_merge_values_match_bound(
    ir_bytes: []u8,
    function_name: []u8,
    left_node: i64,
    right_node: i64,
    bs: i64
) -> !bool {
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, right_kind) {
        return false;
    }
    if std::mem::equal_bytes(left_kind, "Var") {
        let left_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, left_node, bs
        );
        let right_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, right_node, bs
        );
        return std::mem::equal_bytes(left_name, right_name);
    }
    if std::mem::equal_bytes(left_kind, "Int") {
        let left_value = try ir_contract::body_int_value_from(
            ir_bytes, function_name, left_node, bs
        );
        let right_value = try ir_contract::body_int_value_from(
            ir_bytes, function_name, right_node, bs
        );
        return left_value == right_value;
    }
    if std::mem::equal_bytes(left_kind, "Call") {
        let left_callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, left_node, bs
        );
        let right_callee = try ir_contract::body_call_callee_or_empty_from(
            ir_bytes, function_name, right_node, bs
        );
        if !std::mem::equal_bytes(left_callee, right_callee) {
            return false;
        }
        let left_args = try compiled_mir_types::count_call_args(
            ir_bytes, function_name, left_node, bs
        );
        let right_args = try compiled_mir_types::count_call_args(
            ir_bytes, function_name, right_node, bs
        );
        return left_args == 0 and right_args == 0;
    }
    return false;
}

fn validate_branch_merge_exit_assign(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    cond_node: i64,
    exit_assign: i64,
    induction_var: []u8,
    string_counter: i64,
    temp_counter: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !void {
    let target_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, locals_spec, induction_var, bs, call_arg_type_cache
    );
    if !std::mem::equal_bytes(target_type, "i64") {
        return error("compiled mir: branch-merge induction target must be i64");
    }
    let cond_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, cond_node, bs);
    if !std::mem::equal_bytes(cond_kind, "Binary") {
        return error("compiled mir: branch-merge while header must compare the induction bound");
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, cond_node, bs
    );
    if !std::mem::equal_bytes(op, "lt") {
        return error("compiled mir: branch-merge while header must use a less-than bound");
    }
    let header_left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "left", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, header_left, "Var", bs) {
        return error("compiled mir: branch-merge while header must read the induction variable");
    }
    let header_var = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, header_left, bs
    );
    if !std::mem::equal_bytes(header_var, induction_var) {
        return error("compiled mir: branch-merge while header must read the induction variable");
    }
    let header_bound = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, cond_node, "right", 0, bs
    );
    let exit_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, exit_assign, "target", 0, bs
    );
    if !try node_kind_is(ir_bytes, function_name, exit_target, "Var", bs) {
        return error("compiled mir: branch-merge exit assignment target must be a var");
    }
    let exit_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, exit_target, bs
    );
    if !std::mem::equal_bytes(exit_target_name, induction_var) {
        return error("compiled mir: branch-merge exit assignment must target the induction variable");
    }
    let exit_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, exit_assign, "value", 0, bs
    );
    if !(try branch_merge_values_match_bound(
        ir_bytes, function_name, exit_value, header_bound, bs
    )) {
        return error("compiled mir: branch-merge exit assignment must set the induction to the loop bound");
    }
    var exit_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let exit_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        exit_value,
        string_counter,
        temp_counter,
        &var exit_insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let exit_type = try expr_inst_llvm_type_by_id(&exit_insts, exit_result);
    if !std::mem::equal_bytes(exit_type, target_type) {
        return error("compiled mir: branch-merge exit assignment type mismatch");
    }
    exit_insts.deinit();
    return;
}
// while_carries_body_scalar_var reports whether a body statement ahead of the latch reassigns
// `name`. It matches the scan lower_multi_while_statement runs to collect the loop's carried
// scalars, so the two agree on which names the loop-head phi owns.
fn while_carries_body_scalar_var(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    name: []u8,
    bs: i64
) -> !bool {
    var index = 0;
    while index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        if try node_kind_is(ir_bytes, function_name, body_stmt, "Assign", bs) {
            if try assign_targets_var(ir_bytes, function_name, body_stmt, name, bs) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// while_carries_body_scalar_var_deep answers the same question for the counter-loop lowering,
// which gives a loop-head phi to every scalar its body reassigns -- including one reassigned
// inside an if arm. It must agree exactly with the carried-scalar scan: this answer also keeps
// the scalar's 'var <name> = <init>' seed off the emitted-let path, and a disagreement either
// defines one SSA name twice or leaves the phi's operand undefined. The shallow form above stays
// with the loop shapes whose lowerings carry only their cursor.
fn while_carries_body_scalar_var_deep(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    name: []u8,
    bs: i64
) -> !bool {
    var index = 0;
    while index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        var assigned = std::array::Array<[]u8>(std::mem::page_allocator());
        defer assigned.deinit();
        try collect_loop_assigned_var_names(
            ir_bytes, function_name, body_stmt, &var assigned, bs
        );
        var assigned_index = 0;
        while assigned_index < assigned.len() {
            let assigned_name = try assigned.get(assigned_index);
            if std::mem::equal_bytes(assigned_name, name) {
                return true;
            }
            assigned_index = assigned_index + 1;
        }
        index = index + 1;
    }
    return false;
}

// while_has_no_trailing_latch reports whether a loop advances nothing at the end of its body. The
// trailing-latch machinery requires the last body statement to be the induction increment; a loop
// ending in anything else -- an if that updates a cursor in one arm, a call, a nested loop -- has
// no single value for a latch to write, and so no loop-head phi to seed either. It carries
// whatever the body updates in slots instead, which is the same answer a continue forces.
//
// The shapes that hide their advance elsewhere (continue-latch, leading-decrement, branch-merge)
// are dispatched before this is asked, so a loop that reaches here genuinely has no latch.
fn while_has_no_trailing_latch(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        return false;
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, last_stmt, bs
    );
    if !std::mem::equal_bytes(last_kind, "Assign") {
        return true;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, target, bs
    );
    return !std::mem::equal_bytes(target_kind, "Var");
}

// while_is_condition_only reports whether a loop threads no value from one iteration to the next.
// Nothing in its body assigns a name, so there is no counter to advance, no latch to find, and no
// loop-head phi to seed: the header alone decides the exit, re-reading state the body mutated
// through calls on an owned aggregate.
//
//   while parsed_sources.len() > 0 {
//       let parsed = try parsed_sources.pop();
//       parsed.deinit();
//   }
//
// This is a property of the loop, not a source shape: the question is only whether any body
// statement assigns, which collect_loop_assigned_var_names answers for nested arms too. A loop
// that does assign is left to the trailing-latch machinery, so a genuinely missing induction
// increment still fails loudly instead of silently losing an advance.
fn while_is_condition_only(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    bs: i64
) -> !bool {
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 1 {
        return false;
    }
    var index = 0;
    while index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        var assigned = std::array::Array<[]u8>(std::mem::page_allocator());
        defer assigned.deinit();
        try collect_loop_assigned_var_names(
            ir_bytes, function_name, body_stmt, &var assigned, bs
        );
        if assigned.len() > 0 {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn while_carries_induction_var(
    ir_bytes: []u8,
    function_name: []u8,
    while_node: i64,
    name: []u8,
    bs: i64
) -> !bool {
    // A continue-latch loop has no trailing increment run; its induction variable is the target of
    // the increment inside the body continue-if (issue 1165 / 1162).
    if try while_is_continue_latch(ir_bytes, function_name, while_node, bs) {
        let continue_var = try while_continue_induction_var(ir_bytes, function_name, while_node, bs);
        return std::mem::equal_bytes(continue_var, name);
    }
    // A branch-merge latch loop has no trailing increment run either; its induction variable is the
    // common Assign target both arms of the terminal if/else close on (one arm a constant-step
    // advance, the other a loop-terminating jump to the bound). Recognizing it here keeps the
    // trailing-increment count below from erroring on the non-Assign (terminal If) tail (issue
    // 1165 / 1162).
    if try while_is_branch_merge_latch(ir_bytes, function_name, while_node, bs) {
        let merge_var = try while_branch_merge_induction_var(ir_bytes, function_name, while_node, bs);
        return std::mem::equal_bytes(merge_var, name);
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "body", 0, bs
    );
    // A leading-decrement loop has no trailing increment run either; its induction variable is the
    // target of the body-opening '<var> = <var> - <int>' self-decrement. Recognizing it here keeps
    // its 'var <var> = <init>' seed off the emitted-let path (the loop-head phi supplies the seed on
    // the preheader edge) and avoids the trailing-increment count erroring on its non-Assign tail
    // (issue 1165 / 1162).
    if try while_is_leading_decrement(ir_bytes, function_name, body_node, bs) {
        let first_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", 0, bs
        );
        let decrement_target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, first_stmt, "target", 0, bs
        );
        let decrement_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, decrement_target, bs
        );
        if std::mem::equal_bytes(decrement_name, name) {
            return true;
        }
        return try while_carries_scalar_var(ir_bytes, function_name, while_node, name, bs);
    }
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    // The value-cursor lowering is selected by the loop's condition, not by its latch: it needs a
    // predicate call over the cursor. A loop that merely ends in a cursor reassignment but tests
    // something else ('while depth > 0 { ... token = next_token(text, token); }') lowers through
    // the counter path, which gives every carried scalar a loop-head phi, so classifying it as a
    // value cursor here would leave those scalars' seeds on the emitted-let path and define their
    // names twice.
    let cursor_cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, while_node, "condition", 0, bs
    );
    var cond_is_cursor_predicate = try value_cursor_cond_is_prefix_not_call(
        ir_bytes, function_name, cursor_cond_node, bs
    );
    if !cond_is_cursor_predicate {
        cond_is_cursor_predicate = try value_cursor_cond_is_plain_call(
            ir_bytes, function_name, cursor_cond_node, bs
        );
    }
    if body_count > 0 and cond_is_cursor_predicate {
        let latch_index = body_count - 1;
        let latch_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", latch_index, bs
        );
        if try node_kind_is(ir_bytes, function_name, latch_stmt, "Assign", bs) {
            let target = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, latch_stmt, "target", 0, bs
            );
            if try node_kind_is(ir_bytes, function_name, target, "Var", bs) {
                let target_name = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, target, bs
                );
                if try value_cursor_latch_is_field_read(
                    ir_bytes, function_name, body_node, latch_index, target_name, bs
                ) {
                    return std::mem::equal_bytes(target_name, name);
                }
                // A value-cursor plain-call latch ('token = next_token(text, segment)',
                // parse_import_segments) reassigns the carried cursor through a non-try free call.
                // Like the field-read latch above, the cursor is carried by the value-cursor phi, not
                // an i64 trailing increment, so classify it here and return whether it is the queried
                // seed name -- otherwise the trailing-increment count below errors on the Call-valued
                // tail (the embedded value-cursor lowerer handles the loop itself).
                if try value_cursor_latch_is_plain_call(
                    ir_bytes, function_name, latch_stmt, target_name, bs
                ) {
                    return std::mem::equal_bytes(target_name, name);
                }
            }
        }
    }
    // A loop with no trailing latch advances no counter, so no 'var <name> = <init>' ahead of it
    // seeds a counter phi. It still carries whatever its body reassigns, in slots rather than
    // phis, and its head binds %<name> for each of those exactly as a phi would -- so the seed let
    // has to stay off the emitted-let path here for the same reason, or the let and the head load
    // define one SSA name twice. The slot takes its seed from the declaration's metadata instead.
    // Answering before the trailing-increment count below also keeps that count from erroring on
    // the non-Assign tail such a loop ends with.
    if try while_has_no_trailing_latch(ir_bytes, function_name, while_node, bs) {
        return try while_carries_body_scalar_var_deep(
            ir_bytes, function_name, body_node, body_count, name, bs
        );
    }
    let latch_count = try while_trailing_increment_count(
        ir_bytes, function_name, body_node, body_count, bs
    );
    // A scalar the body reassigns ahead of the latch is one of the loop's carried scalars, so the
    // loop-head phi supplies its value on the preheader edge exactly as it does for the induction
    // counter. Its 'var <name> = <init>' seed must be left off the emitted-let path too, or the
    // let and the phi both define the same SSA name.
    if try while_carries_body_scalar_var_deep(
        ir_bytes, function_name, body_node, body_count - latch_count, name, bs
    ) {
        return true;
    }
    var index = body_count - latch_count;
    while index < body_count {
        let increment_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, increment_stmt, "target", 0, bs
        );
        let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
        if std::mem::equal_bytes(target_kind, "Var") {
            let target_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, target, bs
            );
            if std::mem::equal_bytes(target_name, name) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}
// InductionInit is the resolved 'var counter = <init>' loop-head phi seed. An integer
// literal initializer ('var index = 0') sets literal and leaves var_name empty; a
// parameter/local initializer ('var index = import_index') sets var_name to the source
// name and leaves literal at 0; a base-plus-offset initializer ('var left_index = left + 1')
// sets var_name to the base name and offset to the integer addend. The renderer prints
// %<var_name> on the preheader edge when var_name is non-empty and offset is zero, computes
// '%<var>_init = add i64 %<var_name>, offset' for a non-zero offset, and otherwise prints the
// literal (issue 1165 / 1162).
pub struct InductionInit {
    pub literal: i64,
    pub var_name: []u8,
    pub offset: i64,
}
// find_induction_init finds the 'var counter = <init>' initializer for the while at
// scope_stmt_index of the block scope_node and returns its loop-head phi seed. Visibility is
// ordinary lexical scoping (scope_chain_init_value_node): the innermost block wins over an
// enclosing one, and within a block the nearest preceding declaration wins, so two whiles reusing
// the same counter name each resolve their own initializer rather than aliasing the first, and a
// loop nested in another loop's body prefers the seed the enclosing body binds over a same-named
// one further out. Only an integer literal or a plain parameter/local name init is accepted;
// any other initializer shape is an explicit error so the restricted loop support never
// silently lowers a computed seed.
// ScopeFrame is one lexical block on the chain enclosing a statement: the block itself, and the
// index that statement occupies in it. A name declared before that index in that block is visible
// to the statement.
struct ScopeFrame {
    node: i64,
    stmt_index: i64,
}

// enclosing_scope_frame answers the next lexical scope outward from a block. It follows the body
// node's owner edges until one is a block's statement list; that block, together with the index of
// the statement this scope hangs off, is the next frame. A node with no owner is the function body
// root, which ends the walk.
fn enclosing_scope_frame(
    ir_bytes: []u8,
    function_name: []u8,
    scope_node: i64,
    bs: i64
) -> !ScopeFrame {
    var current = scope_node;
    while current >= 0 {
        let edge = try ir_contract::body_parent_edge_from(
            ir_bytes, function_name, current, bs
        );
        if edge.parent < 0 {
            return ScopeFrame { node: -1, stmt_index: -1 };
        }
        if edge.is_statement {
            return ScopeFrame { node: edge.parent, stmt_index: edge.ordinal };
        }
        current = edge.parent;
    }
    return ScopeFrame { node: -1, stmt_index: -1 };
}

// scope_chain_init_value_node returns the value node of the nearest 'var <name> = <value>'
// declaration visible from the statement at scope_stmt_index of scope_node: the innermost block
// first, then each enclosing block in turn, and within a block the last declaration that precedes
// the statement. It answers -1 when no visible scope declares the name.
//
// The chain is the point. A loop nested in another loop's body sees the names its own block
// declares, the names every enclosing block declares, and the ones at the function's top level;
// a counter or a carried scalar may be declared at any of those depths. Searching only the
// immediate block missed every outer declaration, which either failed a seed lookup outright
// (std::path::join declares its `depth` counter two blocks out) or, worse, answered "not
// declared" for a carried scalar and left it without a loop-head phi.
fn scope_chain_init_value_node(
    ir_bytes: []u8,
    function_name: []u8,
    name: []u8,
    scope_node: i64,
    scope_stmt_index: i64,
    bs: i64
) -> !i64 {
    var frame_node = scope_node;
    var frame_index = scope_stmt_index;
    while frame_node >= 0 {
        var init_value = -1;
        var index = 0;
        while index < frame_index {
            let statement = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, frame_node, "statement", index, bs
            );
            let kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, statement, bs
            );
            if std::mem::equal_bytes(kind, "Let") {
                let name_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "name", 0, bs
                );
                let declared = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, name_node, bs
                );
                if std::mem::equal_bytes(declared, name) {
                    init_value = try ir_contract::body_child_sequence_from(
                        ir_bytes, function_name, statement, "value", 0, bs
                    );
                }
            }
            index = index + 1;
        }
        if init_value >= 0 {
            return init_value;
        }
        let outer = try enclosing_scope_frame(ir_bytes, function_name, frame_node, bs);
        frame_node = outer.node;
        frame_index = outer.stmt_index;
    }
    return -1;
}

fn find_induction_init(
    ir_bytes: []u8,
    function_name: []u8,
    induction_var: []u8,
    scope_node: i64,
    scope_stmt_index: i64,
    bs: i64
) -> !InductionInit {
    let init_value = try scope_chain_init_value_node(
        ir_bytes, function_name, induction_var, scope_node, scope_stmt_index, bs
    );
    if init_value < 0 {
        // Name the function and the counter. Which loop failed to find its seed is the whole
        // question here, and a bare "not found" makes the reader scan every while in the
        // compiled closure for one whose counter no visible scope declares.
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled mir: induction variable initializer not found: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" counter ");
        try message.append_bytes(induction_var);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, init_value, bs
    );
    if std::mem::equal_bytes(value_kind, "Int") {
        let literal = try ir_contract::body_int_value_from(
            ir_bytes, function_name, init_value, bs
        );
        return InductionInit { literal: literal, var_name: "", offset: 0 };
    }
    if std::mem::equal_bytes(value_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, init_value, bs
        );
        return InductionInit { literal: 0, var_name: var_name, offset: 0 };
    }
    // 'var left_index = left + 1;' seeds the phi from a base parameter/local plus an integer
    // offset; the preheader computes the addend so two lockstep cursors can start one past
    // their respective import keywords (issue 1165 / 1162).
    if std::mem::equal_bytes(value_kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, init_value, bs
        );
        if !std::mem::equal_bytes(op, "add") {
            return error("compiled mir: induction base-plus-offset init must be an addition");
        }
        let base_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, init_value, "left", 0, bs
        );
        let offset_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, init_value, "right", 0, bs
        );
        let base_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, base_node, bs);
        let offset_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, offset_node, bs);
        if !std::mem::equal_bytes(base_kind, "Var") or !std::mem::equal_bytes(offset_kind, "Int") {
            return error("compiled mir: induction base-plus-offset init must be name + integer");
        }
        let base_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, base_node, bs);
        let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, offset_node, bs);
        return InductionInit { literal: 0, var_name: base_name, offset: offset };
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes(
        "compiled mir: induction variable must be initialized to an integer or a parameter: "
    );
    try message.append_bytes(function_name);
    try message.append_bytes(" variable ");
    try message.append_bytes(induction_var);
    try message.append_bytes(" kind ");
    try message.append_bytes(value_kind);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}
// induction_init_is_base_plus_offset reports whether a loop seed is the '<name> + <integer>' shape
// find_induction_init renders as an init_var/init_offset pair, which the preheader spells as
// %<var>_init. It must agree with find_induction_init's Binary branch: a seed this accepts and that
// rejects would reach the compact path and fail there instead of lowering as an expression.
fn induction_init_is_base_plus_offset(
    ir_bytes: []u8,
    function_name: []u8,
    init_node: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, init_node, bs);
    if !std::mem::equal_bytes(kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, init_node, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return false;
    }
    let base_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_node, "left", 0, bs
    );
    let base_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, base_node, bs);
    if !std::mem::equal_bytes(base_kind, "Var") {
        return false;
    }
    let offset_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, init_node, "right", 0, bs
    );
    let offset_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, offset_node, bs
    );
    return std::mem::equal_bytes(offset_kind, "Int");
}

// find_induction_init_value_node returns the value node of the nearest preceding 'var counter =
// <value>' initializer for the while at scope_stmt_index of the block scope_node, without
// classifying the value. The
// continue-latch lowering uses it to detect a call-seeded init ('var cursor =
// line_end_including_break(source, comment_end)') and lower the call into the preheader; a
// non-call seed falls back to find_induction_init's literal/copy/offset classification (issue 1165
// / 1162).
fn find_induction_init_value_node(
    ir_bytes: []u8,
    function_name: []u8,
    induction_var: []u8,
    scope_node: i64,
    scope_stmt_index: i64,
    bs: i64
) -> !i64 {
    let init_value = try scope_chain_init_value_node(
        ir_bytes, function_name, induction_var, scope_node, scope_stmt_index, bs
    );
    if init_value < 0 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes("compiled mir: induction variable initializer not found: ");
        try message.append_bytes(function_name);
        try message.append_bytes(" counter ");
        try message.append_bytes(induction_var);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    return init_value;
}

// find_induction_init_value_node_or_minus_one answers the same question without failing.
// A name assigned inside a loop body but declared inside that body -- a branch-local binding --
// is declared by no scope that encloses the loop, and the carried-scalar scan uses the -1 answer
// to leave it alone instead of claiming a loop-head phi for a value the loop does not carry. The
// scope walk only reaches declarations that precede the loop, so a body-local stays invisible to
// it however deeply the loop itself is nested.
fn find_induction_init_value_node_or_minus_one(
    ir_bytes: []u8,
    function_name: []u8,
    induction_var: []u8,
    scope_node: i64,
    scope_stmt_index: i64,
    bs: i64
) -> !i64 {
    let init_value = try scope_chain_init_value_node(
        ir_bytes, function_name, induction_var, scope_node, scope_stmt_index, bs
    );
    if init_value < 0 {
        return -1;
    }
    return 0;
}

// statement_has_loop_jump reports whether a loop body statement contains a 'continue' or a 'break'
// that belongs to this loop. It follows blocks and if arms and stops at a nested while, whose
// jumps are that loop's edges rather than this one's.
fn statement_has_loop_jump(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    bs: i64
) -> !bool {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
    if std::mem::equal_bytes(kind, "Continue") {
        return true;
    }
    if std::mem::equal_bytes(kind, "Break") {
        return true;
    }
    if std::mem::equal_bytes(kind, "While") {
        return false;
    }
    if std::mem::equal_bytes(kind, "Block") {
        var child_index = 0;
        while true {
            let child = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "statement", child_index, bs
            );
            if child < 0 {
                return false;
            }
            if try statement_has_loop_jump(ir_bytes, function_name, child, bs) {
                return true;
            }
            child_index = child_index + 1;
        }
        return false;
    }
    if std::mem::equal_bytes(kind, "If") {
        let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, statement, "then", 0, bs
        );
        if then_node >= 0 {
            if try statement_has_loop_jump(ir_bytes, function_name, then_node, bs) {
                return true;
            }
        }
        let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, statement, "else", 0, bs
        );
        if else_node >= 0 {
            if try statement_has_loop_jump(ir_bytes, function_name, else_node, bs) {
                return true;
            }
        }
        return false;
    }
    return false;
}

// while_body_has_loop_jump answers whether this loop must carry its values in slots rather than
// loop-head phis, which is exactly the question of whether its body jumps to an edge the latch does
// not run through. A continue re-enters the head from a point no latch value describes; a break
// leaves from a point the head's definitions are already behind, and phis can only say what either
// one carries by taking an operand per jump site. One slot per variable says it once, for any
// number of sites. The restricted continue-latch shape is dispatched before this is asked, so a
// loop that reaches here and answers true is one whose jumps do not fold into its latch.
fn while_body_has_loop_jump(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    bs: i64
) -> !bool {
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var index = 0;
    while index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        if try statement_has_loop_jump(ir_bytes, function_name, body_stmt, bs) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// collect_loop_assigned_var_names appends every local a loop body statement reassigns, following
// nested blocks and if arms. A scalar updated inside 'if ... { line = line + 1; }' is carried by
// the loop exactly like one updated at the body's top level: it is live on the back edge and
// after the loop. Collecting only top-level assignments left such a variable without a loop-head
// phi, so every iteration re-read the value the preheader computed and the updates were dropped.
fn collect_loop_assigned_var_names(
    ir_bytes: []u8,
    function_name: []u8,
    statement: i64,
    out: &var std::array::Array<[]u8>,
    bs: i64
) -> !void {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
    if std::mem::equal_bytes(kind, "Assign") {
        let target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, statement, "target", 0, bs
        );
        let target_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, target, bs
        );
        if !std::mem::equal_bytes(target_kind, "Var") {
            return error("compiled mir: loop-carried assignment target must be a local");
        }
        let name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, target, bs
        );
        try out.append(name);
        return;
    }
    if std::mem::equal_bytes(kind, "Block") {
        var child_index = 0;
        while true {
            let child = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, statement, "statement", child_index, bs
            );
            if child < 0 {
                return;
            }
            try collect_loop_assigned_var_names(ir_bytes, function_name, child, out, bs);
            child_index = child_index + 1;
        }
        return;
    }
    if std::mem::equal_bytes(kind, "If") {
        let then_node = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, statement, "then", 0, bs
        );
        if then_node >= 0 {
            try collect_loop_assigned_var_names(ir_bytes, function_name, then_node, out, bs);
        }
        let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, statement, "else", 0, bs
        );
        if else_node >= 0 {
            try collect_loop_assigned_var_names(ir_bytes, function_name, else_node, out, bs);
        }
        return;
    }
    // A scalar a nested loop advances is carried by this loop exactly like one its own body
    // assigns: the nested loop leaves a value behind, and the next iteration has to read that
    // rather than the one the preheader computed. Stopping at the nested while left the enclosing
    // loop's condition reading its own seed forever, and let the nested loop's head define a name
    // this loop's head had already defined.
    if std::mem::equal_bytes(kind, "While") {
        let nested_body = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes, function_name, statement, "body", 0, bs
        );
        if nested_body < 0 {
            return;
        }
        var nested_index = 0;
        while true {
            let nested_stmt = try ir_contract::body_child_sequence_or_minus_one_from(
                ir_bytes, function_name, nested_body, "statement", nested_index, bs
            );
            if nested_stmt < 0 {
                return;
            }
            try collect_loop_assigned_var_names(
                ir_bytes, function_name, nested_stmt, out, bs
            );
            nested_index = nested_index + 1;
        }
        return;
    }
    return;
}

// parse_induction_step validates the trailing 'name = name + <int>' increment for
// the induction variable and returns the integer step. Only this simple counter
// increment shape is accepted; anything else is rejected so the restricted loop
// support never silently lowers general assignment (tracker 961).
fn parse_induction_step(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    induction_var: []u8,
    bs: i64
) -> !i64 {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return error("compiled mir: induction increment must be an addition");
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return error("compiled mir: induction increment must be an addition");
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return error("compiled mir: induction increment must be name + integer");
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_name, induction_var) {
        return error("compiled mir: induction increment must add to the induction variable");
    }
    return try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
}

struct InductionUpdate {
    llvm_op: []u8,
    operand: i64,
}

fn parse_induction_update(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    induction_var: []u8,
    bs: i64
) -> !InductionUpdate {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs),
        "Binary"
    ) {
        return error("compiled mir: induction update must be binary");
    }
    let source_op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    var llvm_op = "";
    if std::mem::equal_bytes(source_op, "add") {
        llvm_op = "add";
    } else {
        if std::mem::equal_bytes(source_op, "sub") {
            llvm_op = "sub";
        } else {
            if std::mem::equal_bytes(source_op, "mul") {
                llvm_op = "mul";
            } else {
                if std::mem::equal_bytes(source_op, "div") {
                    llvm_op = "sdiv";
                } else {
                    if std::mem::equal_bytes(source_op, "mod") {
                        llvm_op = "srem";
                    } else {
                        return error(
                            "compiled mir: induction update operation unsupported"
                        );
                    }
                }
            }
        }
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, left_node, bs
        ),
        "Var"
    ) or !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, right_node, bs
        ),
        "Int"
    ) {
        return error("compiled mir: induction update must be name op integer");
    }
    if !std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, left_node, bs
        ),
        induction_var
    ) {
        return error(
            "compiled mir: induction update must read the induction variable"
        );
    }
    return InductionUpdate {
        llvm_op: llvm_op,
        operand: try ir_contract::body_int_value_from(
            ir_bytes, function_name, right_node, bs
        )
    };
}

fn while_assign_is_supported_update(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    bs: i64
) -> !bool {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, target, bs
    );
    if !std::mem::equal_bytes(target_kind, "Var") { return false; }
    let target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, target, bs
    );
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs),
        "Binary"
    ) {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") and
        !std::mem::equal_bytes(op, "sub") and
        !std::mem::equal_bytes(op, "mul") and
        !std::mem::equal_bytes(op, "div") and
        !std::mem::equal_bytes(op, "mod") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, left_node, bs
        ),
        "Var"
    ) or !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, right_node, bs
        ),
        "Int"
    ) {
        return false;
    }
    return std::mem::equal_bytes(
        try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, left_node, bs
        ),
        target_name
    );
}

// while_assign_is_constant_step reports whether a body Assign is a constant-step
// 'name = name + <int>' induction increment: a Var target, a Binary add value whose left is
// that same Var and whose right is an integer literal. It backs the trailing-increment run
// detection that recognizes a multi-counter latch suffix (issue 1165 / 1162).
fn while_assign_is_constant_step(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    bs: i64
) -> !bool {
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let target_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "add") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return false;
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    return std::mem::equal_bytes(left_name, target_name);
}
// while_trailing_increment_count returns the number of trailing latch statements at the end
// of a loop body. A loop-carried 'index = try <callee>(.., index);' try-call latch is a
// single statement; otherwise the latch is the maximal trailing run of constant-step
// 'name = name + <int>' increments (one for a single counter, several for lockstep counters).
// The last body statement must be an Assign in both shapes (issue 1165 / 1162).
fn while_trailing_increment_count(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_count: i64,
    bs: i64
) -> !i64 {
    if body_count < 1 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes(
            "compiled mir: while body must end with the induction increment: "
        );
        try message.append_bytes(function_name);
        try message.append_bytes(" empty body");
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if !std::mem::equal_bytes(last_kind, "Assign") {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes(
            "compiled mir: while body must end with the induction increment: "
        );
        try message.append_bytes(function_name);
        try message.append_bytes(" last kind ");
        try message.append_bytes(last_kind);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    let last_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, last_stmt, "value", 0, bs
    );
    let last_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_value, bs);
    if std::mem::equal_bytes(last_value_kind, "TryExpr") {
        return 1;
    }
    // A copy-decrement latch 'index = previous' (the value is a plain Var read of a body-local
    // bound to 'index - <int>' earlier in the loop) is a single-statement latch like the try-call
    // update; the referenced let stays in the body so source[previous] still loads it (issue 1165
    // / 1162). This only classifies the latch length; the caller (lower_multi_while_statement)
    // validates the copied local is a genuine induction-variable decrement through
    // validate_copy_latch_source before lowering it.
    if std::mem::equal_bytes(last_value_kind, "Var") {
        return 1;
    }
    // A token-carried plain-call latch '<cursor> = <free call>(.., <cursor>)' reseats the loop
    // variable from a free function's result rather than a numeric add (the value is a Call, e.g.
    // 'token = next_token(text, token)'). Like the try-call and copy-decrement latches it is a
    // single trailing statement; lower_multi_while_statement dispatches the Call increment value to
    // lower_while_latch_call, which binds %<cursor>_next on the latch edge for the loop-head phi
    // (issue 1157 PR-P4 latch shape). This only classifies the latch length; the caller validates
    // the call shape (free function, i64 result) before lowering it.
    if std::mem::equal_bytes(last_value_kind, "Call") {
        return 1;
    }
    var count = 0;
    var index = body_count - 1;
    while index >= 0 {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if !std::mem::equal_bytes(kind, "Assign") {
            index = -1;
            continue;
        }
        var supported = false;
        if count == 0 {
            supported = try while_assign_is_supported_update(
                ir_bytes, function_name, stmt, bs
            );
        } else {
            supported = try while_assign_is_constant_step(
                ir_bytes, function_name, stmt, bs
            );
        }
        if !supported {
            index = -1;
            continue;
        }
        count = count + 1;
        index = index - 1;
    }
    if count < 1 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes(
            "compiled mir: while body must end with the induction increment: "
        );
        try message.append_bytes(function_name);
        try message.append_bytes(" last assign value kind ");
        try message.append_bytes(last_value_kind);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    return count;
}
// validate_copy_latch_source checks that a copy-decrement latch's source local ('previous' in
// 'index = previous') is bound earlier in the same loop body, before the latch suffix, by a
// 'let previous = <induction_var> - <positive int>' decrement. Anything else -- a missing
// binding, a non-Binary value, a non-subtraction, a base that is not the induction variable, or
// a non-integer / non-positive offset -- is an explicit error so the copy latch never silently
// lowers a value that would not count the loop down (issue 1165 / 1162).
fn validate_copy_latch_source(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_boundary: i64,
    induction_var: []u8,
    copy_source: []u8,
    bs: i64
) -> !void {
    var index = 0;
    while index < body_boundary {
        let stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, stmt, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, stmt, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, name_node, bs);
            if std::mem::equal_bytes(name, copy_source) {
                let value = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, stmt, "value", 0, bs
                );
                let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
                if !std::mem::equal_bytes(value_kind, "Binary") {
                    // Name the function: the latch shapes are an enumerated set, and a
                    // loop written outside them is otherwise a native rebuild to locate.
                    var message = std::string::String(std::mem::page_allocator());
                    try message.append_bytes(
                        "compiled mir: copy latch source must be '<induction> - <int>': "
                    );
                    try message.append_bytes(function_name);
                    try message.append_bytes(" latch ");
                    try message.append_bytes(copy_source);
                    let message_bytes = message.as_bytes();
                    return error(message_bytes);
                }
                let op = try ir_contract::sequence_fact_value_from(
                    ir_bytes, "body-binary ", function_name, value, bs
                );
                if !std::mem::equal_bytes(op, "sub") and
                    !std::mem::equal_bytes(op, "add") {
                    return error(
                        "compiled mir: copy latch source must offset the induction variable"
                    );
                }
                let base_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, value, "left", 0, bs
                );
                let offset_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, value, "right", 0, bs
                );
                let base_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, base_node, bs);
                let offset_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, offset_node, bs);
                if !std::mem::equal_bytes(base_kind, "Var") or !std::mem::equal_bytes(offset_kind, "Int") {
                    return error("compiled mir: copy latch source must be '<induction> - <int>'");
                }
                let base_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, base_node, bs);
                if !std::mem::equal_bytes(base_name, induction_var) {
                    return error(
                        "compiled mir: copy latch source must offset the induction variable"
                    );
                }
                let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, offset_node, bs);
                if offset < 1 {
                    return error("compiled mir: copy latch source decrement must be positive");
                }
                return;
            }
        }
        index = index + 1;
    }
    return error("compiled mir: copy latch source local not found in the loop body");
}

fn lower_branch_merge_block_prefix(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    block_node: i64,
    statement_limit: i64,
    string_counter: i64,
    temp_counter: i64,
    try_counter: i64,
    alias_counter: i64,
    label_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !VoidBodyLowerResult {
    var body_locals = locals_spec;
    var body_strings = string_counter;
    var body_temps = temp_counter;
    var body_tries = try_counter;
    var body_alias_counter = alias_counter;
    var body_index = 0;
    while body_index < statement_limit {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, block_node, "statement", body_index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                body_locals,
                statement,
                body_strings,
                body_temps,
                body_tries,
                aliases,
                stmts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_locals = let_result.locals_spec;
            body_strings = let_result.string_counter;
            body_temps = let_result.temp_counter;
            body_tries = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(stmt_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    body_locals,
                    statement,
                    body_strings,
                    body_temps,
                    body_tries,
                    body_alias_counter,
                    label_index * 1000 + body_index + 1,
                    aliases,
                    stmts,
                    -1,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_strings = if_result.string_counter;
                body_temps = if_result.temp_counter;
                body_tries = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(stmt_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        body_locals,
                        statement,
                        body_strings,
                        body_temps,
                        body_tries,
                        aliases,
                        stmts,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_strings = expr_result.string_counter;
                    body_temps = expr_result.temp_counter;
                    body_tries = expr_result.try_counter;
                } else {
                    if std::mem::equal_bytes(stmt_kind, "Assign") {
                        let assign_result = try lower_void_then_body_assign(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            body_locals,
                            statement,
                            body_strings,
                            body_temps,
                            body_tries,
                            body_alias_counter,
                            aliases,
                            stmts,
                            bs,
                            ir_lookup_index, canonical_facts, call_arg_type_cache
                        );
                        body_strings = assign_result.string_counter;
                        body_temps = assign_result.temp_counter;
                        body_tries = assign_result.try_counter;
                        body_alias_counter = assign_result.alias_counter;
                    } else {
                        return error("compiled mir: unsupported branch-merge while body statement");
                    }
                }
            }
        }
        body_index = body_index + 1;
    }
    return VoidBodyLowerResult {
        locals_spec: body_locals,
        string_counter: body_strings,
        temp_counter: body_temps,
        try_counter: body_tries,
        alias_counter: body_alias_counter,
        body_returns: false
    };
}

fn branch_merge_carried_type_supported(llvm_type: []u8) -> bool {
    let abi = fixed_abi_contract::from_llvm(llvm_type);
    if abi.kind == fixed_abi_contract::FixedAbiKind::Missing { return false; }
    if abi.kind == fixed_abi_contract::FixedAbiKind::Bool { return true; }
    if abi.kind == fixed_abi_contract::FixedAbiKind::Integer8 or
        abi.kind == fixed_abi_contract::FixedAbiKind::Integer64 {
        return true;
    }
    return abi.kind == fixed_abi_contract::FixedAbiKind::SliceU8;
}

fn branch_merge_carried_phi_name(
    loop_index: i64,
    slot: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    if slot < 0 {
        return error("compiled mir: negative branch-merge carried scalar slot");
    }
    var out = std::string::String(std::mem::page_allocator());
    errdefer out.deinit();
    try out.append_bytes("branch.carried.scalar.");
    try std::fmt::append_i64(&var out, loop_index);
    try out.append_bytes(".");
    try std::fmt::append_i64(&var out, slot);
    return call_arg_type_cache.name_store.own(out);
}

fn branch_merge_carried_alias_index(
    states: &std::array::Array<BranchMergeCarriedAlias>,
    source_name: []u8
) -> !i64 {
    var index = 0;
    while index < states.len() {
        let state = try states.at(index);
        if std::mem::equal_bytes(state.source_name, source_name) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

fn branch_merge_param_spec_contains(params_spec: []u8, name: []u8) -> bool {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            let param_name = params_spec[space_pos + 1..entry_end];
            if std::mem::equal_bytes(param_name, name) {
                return true;
            }
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return false;
}

fn branch_merge_top_level_local_before_loop(
    ir_bytes: []u8,
    function_name: []u8,
    source_name: []u8,
    while_stmt_index: i64,
    bs: i64
) -> !bool {
    var index = 0;
    while index < while_stmt_index {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, 0, "statement", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(kind, "Let") {
            let name_node = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "name", 0, bs
            );
            let name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, name_node, bs
            );
            if std::mem::equal_bytes(name, source_name) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

fn branch_merge_carried_source_available_before_loop(
    ir_bytes: []u8,
    function_name: []u8,
    locals_spec: []u8,
    source_name: []u8,
    while_stmt_index: i64,
    bs: i64
) -> !bool {
    if branch_merge_param_spec_contains(locals_spec, source_name) {
        return true;
    }
    return try branch_merge_top_level_local_before_loop(
        ir_bytes, function_name, source_name, while_stmt_index, bs
    );
}

fn append_branch_merge_carried_alias(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    source_name: []u8,
    induction_var: []u8,
    loop_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    states: &var std::array::Array<BranchMergeCarriedAlias>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !void {
    if std::mem::equal_bytes(source_name, induction_var) {
        return;
    }
    if (try branch_merge_carried_alias_index(states, source_name)) >= 0 {
        return;
    }
    if !(try branch_merge_carried_source_available_before_loop(
        ir_bytes, function_name, locals_spec, source_name, loop_index, bs
    )) {
        return;
    }
    let llvm_type = try compiled_mir_types::resolve_value_llvm_type_indexed(
        ir_lookup_index, ir_bytes, function_name, module_prefix,
        locals_spec, source_name, bs
    );
    if !branch_merge_carried_type_supported(llvm_type) {
        return error("compiled mir: branch-merge carried scalar type unsupported");
    }
    let slot = states.len();
    try states.append(BranchMergeCarriedAlias {
        source_name: source_name,
        phi_name: try branch_merge_carried_phi_name(
            loop_index, slot, call_arg_type_cache
        ),
        llvm_type: llvm_type,
        init_name: try local_alias_current_name(aliases, source_name)
    });
    return;
}

fn collect_branch_merge_block_carried_aliases(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    block_node: i64,
    statement_limit: i64,
    induction_var: []u8,
    loop_index: i64,
    aliases: &std::array::Array<LocalAliasState>,
    states: &var std::array::Array<BranchMergeCarriedAlias>,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !void {
    var index = 0;
    while index < statement_limit {
        let statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, block_node, "statement", index, bs
        );
        let stmt_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, statement, bs);
        if std::mem::equal_bytes(stmt_kind, "Assign") {
            let target = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, statement, "target", 0, bs
            );
            let target_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, target, bs
            );
            if !std::mem::equal_bytes(target_kind, "Var") {
                return error("compiled mir: branch-merge carried scalar target must be a var");
            }
            let target_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, target, bs
            );
            try append_branch_merge_carried_alias(
                ir_lookup_index,
                ir_bytes, function_name, module_prefix, locals_spec, target_name, induction_var,
                loop_index, aliases, states, bs, call_arg_type_cache
            );
        } else {
            if std::mem::equal_bytes(stmt_kind, "If") {
                let then_node = try ir_contract::body_child_sequence_from(
                    ir_bytes, function_name, statement, "then", 0, bs
                );
                let then_count = try while_body_statement_count(
                    ir_bytes, function_name, then_node, bs
                );
                try collect_branch_merge_block_carried_aliases(
                    ir_lookup_index,
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    then_node,
                    then_count,
                    induction_var,
                    loop_index,
                    aliases,
                    states,
                    bs,
                    call_arg_type_cache
                );
                let else_node = try ir_contract::body_child_sequence_or_minus_one_from(
                    ir_bytes, function_name, statement, "else", 0, bs
                );
                if else_node >= 0 {
                    let else_kind = try ir_contract::body_node_kind_from(
                        ir_bytes, function_name, else_node, bs
                    );
                    if !std::mem::equal_bytes(else_kind, "Empty") {
                        let else_count = try while_body_statement_count(
                            ir_bytes, function_name, else_node, bs
                        );
                        try collect_branch_merge_block_carried_aliases(
                            ir_lookup_index,
                            ir_bytes,
                            function_name,
                            module_prefix,
                            locals_spec,
                            else_node,
                            else_count,
                            induction_var,
                            loop_index,
                            aliases,
                            states,
                            bs,
                            call_arg_type_cache
                        );
                    }
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn branch_merge_loop_aliases(
    aliases: &std::array::Array<LocalAliasState>,
    carried: &std::array::Array<BranchMergeCarriedAlias>
) -> !std::array::Array<LocalAliasState> {
    var loop_aliases = try copy_local_aliases(aliases);
    var index = 0;
    while index < carried.len() {
        let state = try carried.at(index);
        try set_local_alias(&var loop_aliases, state.source_name, state.phi_name);
        index = index + 1;
    }
    return loop_aliases;
}

fn validate_branch_merge_no_unmodelled_aliases(
    before: &std::array::Array<LocalAliasState>,
    after: &std::array::Array<LocalAliasState>,
    induction_var: []u8,
    carried: &std::array::Array<BranchMergeCarriedAlias>
) -> !void {
    var index = 0;
    while index < after.len() {
        let state = try after.at(index);
        if !std::mem::equal_bytes(state.source_name, induction_var) {
            let input_name = try local_alias_current_name(before, state.source_name);
            if !std::mem::equal_bytes(input_name, state.current_name) and
                (try branch_merge_carried_alias_index(carried, state.source_name)) < 0 {
                return error("compiled mir: branch-merge carried scalar not yet supported");
            }
        }
        index = index + 1;
    }
    return;
}

fn materialize_branch_merge_carried_scalars(
    carried: &std::array::Array<BranchMergeCarriedAlias>,
    advance_aliases: &std::array::Array<LocalAliasState>
) -> !std::array::Array<compiled_mir::MirCarriedScalar> {
    var scalars = std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator());
    var index = 0;
    while index < carried.len() {
        let state = try carried.at(index);
        let latch_name = try local_alias_current_name(advance_aliases, state.source_name);
        try scalars.append(compiled_mir::carried_scalar(
            state.phi_name,
            state.llvm_type,
            0,
            "",
            0,
            state.init_name,
            latch_name
        ));
        index = index + 1;
    }
    return scalars;
}

// lower_multi_while_branch_merge_latch lowers a bounded counter loop whose induction update is carried
// by a terminal if/else instead of a trailing body Assign (issue 1165 / 1162):
//   while index < bound {
//       ...
//       if done {
//           index = bound;
//       } else {
//           ...
//           index = index + 1;
//       }
//   }
// The shape is generic: the terminal If must have two block arms that assign the same Var, exactly one
// arm must close with a constant-step '<var> = <var> + <int>' advance, the other must be a single
// '<var> = <bound>' exit assignment, and the target/value types must be i64.
fn lower_multi_while_branch_merge_latch(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: branch-merge while header must be a single comparison");
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    let terminal_if = try while_branch_merge_terminal_if_or_minus_one(
        ir_bytes, function_name, statement, bs
    );
    if terminal_if < 0 {
        return error("compiled mir: branch-merge while body must end with a terminal if/else latch");
    }
    let induction_var = try while_branch_merge_induction_var(
        ir_bytes, function_name, statement, bs
    );
    let induction_init = try find_induction_init(
        ir_bytes, function_name, induction_var, 0, loop_index, bs
    );
    var induction_init_literal = induction_init.literal;
    var induction_init_var = induction_init.var_name;
    var induction_init_offset = induction_init.offset;
    let induction_alias = try local_alias_current_name(aliases, induction_var);
    if !std::mem::equal_bytes(induction_alias, induction_var) {
        induction_init_literal = 0;
        induction_init_var = induction_alias;
        induction_init_offset = 0;
    }

    let advance_block = try branch_merge_advance_block(
        ir_bytes, function_name, terminal_if, bs
    );
    let exit_block = try branch_merge_exit_block(
        ir_bytes, function_name, terminal_if, bs
    );
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "then", 0, bs
    );
    let advance_count = try while_body_statement_count(ir_bytes, function_name, advance_block, bs);
    var carried_aliases =
        std::array::Array<BranchMergeCarriedAlias>(std::mem::page_allocator());
    defer carried_aliases.deinit();
    try collect_branch_merge_block_carried_aliases(
        ir_lookup_index,
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        body_node,
        body_count - 1,
        induction_var,
        loop_index,
        aliases,
        &var carried_aliases,
        bs,
        call_arg_type_cache
    );
    try collect_branch_merge_block_carried_aliases(
        ir_lookup_index,
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        advance_block,
        advance_count - 1,
        induction_var,
        loop_index,
        aliases,
        &var carried_aliases,
        bs,
        call_arg_type_cache
    );
    var loop_aliases = try branch_merge_loop_aliases(aliases, &carried_aliases);
    defer loop_aliases.deinit();
    // The preheader phi may seed from a current alias for the induction variable, but once the
    // branch-merge loop starts, reads of that source variable must resolve to the loop-head phi.
    try set_local_alias(&var loop_aliases, induction_var, induction_var);

    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        &loop_aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let body_string_start = string_counter + try count_strings_in_insts(&cond_insts);
    let body_temp_start = temp_counter + cond_insts.len();

    let advance_assign = try branch_merge_last_assign(
        ir_bytes,
        function_name,
        advance_block,
        "compiled mir: branch-merge advance arm must end with the induction increment",
        bs
    );
    let step = try parse_induction_step(
        ir_bytes, function_name, advance_assign, induction_var, bs
    );
    let exit_assign = try branch_merge_last_assign(
        ir_bytes,
        function_name,
        exit_block,
        "compiled mir: branch-merge exit arm must end with a bound assignment",
        bs
    );
    let exit_count = try while_body_statement_count(ir_bytes, function_name, exit_block, bs);
    if exit_count != 1 {
        var message = std::string::String(std::mem::page_allocator());
        try message.append_bytes(
            "compiled mir: branch-merge exit arm must only set the induction bound: function "
        );
        try message.append_bytes(function_name);
        try message.append_bytes(" statements ");
        try std::fmt::append_i64(&var message, exit_count);
        let message_bytes = message.as_bytes();
        return error(message_bytes);
    }
    var branch_latch_exit_on_true = false;
    if then_node == exit_block {
        branch_latch_exit_on_true = true;
    } else {
        if then_node != advance_block {
            return error("compiled mir: branch-merge terminal arms could not be classified");
        }
    }
    try validate_branch_merge_exit_assign(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        exit_assign,
        induction_var,
        body_string_start,
        body_temp_start,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );

    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = try copy_local_aliases(&loop_aliases);
    defer body_aliases.deinit();
    let body_result = try lower_branch_merge_block_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        body_node,
        body_count - 1,
        body_string_start,
        body_temp_start,
        loop_index * 1000,
        alias_counter,
        loop_index,
        &var body_aliases,
        &var body_stmts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    var branch_cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let branch_cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, terminal_if, "condition", 0, bs
    );
    if (try short_circuit_kind(ir_bytes, function_name, branch_cond_node, bs)) != 0 {
        return error("compiled mir: branch-merge terminal condition short-circuit unsupported");
    }
    let branch_cond_result = try lower_expr_with_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        body_result.locals_spec,
        branch_cond_node,
        body_result.string_counter,
        body_result.temp_counter,
        &var branch_cond_insts,
        &body_aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let branch_cond_type = try expr_inst_llvm_type_by_id(&branch_cond_insts, branch_cond_result);
    if !std::mem::equal_bytes(branch_cond_type, "i1") {
        return error("compiled mir: branch-merge terminal condition must be bool");
    }
    let branch_cond_strings = try count_strings_in_insts(&branch_cond_insts);
    var branch_advance_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var advance_aliases = try copy_local_aliases(&body_aliases);
    defer advance_aliases.deinit();
    let advance_result = try lower_branch_merge_block_prefix(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        body_result.locals_spec,
        advance_block,
        advance_count - 1,
        body_result.string_counter + branch_cond_strings,
        body_result.temp_counter + branch_cond_insts.len(),
        body_result.try_counter,
        body_result.alias_counter,
        loop_index * 1000 + body_count,
        &var advance_aliases,
        &var branch_advance_stmts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    try validate_branch_merge_no_unmodelled_aliases(
        &loop_aliases, &body_aliases, induction_var, &carried_aliases
    );
    try validate_branch_merge_no_unmodelled_aliases(
        &body_aliases, &advance_aliases, induction_var, &carried_aliases
    );
    let carried_scalars = try materialize_branch_merge_carried_scalars(
        &carried_aliases, &advance_aliases
    );
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_var,
        induction_init_literal,
        induction_init_var,
        induction_init_offset,
        "add",
        step,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        "",
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        carried_scalars,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        -1,
        branch_latch_exit_on_true,
        branch_cond_result,
        branch_cond_insts,
        branch_advance_stmts,
        false
    ));
    return MultiIfLowerResult {
        temp_counter: advance_result.temp_counter,
        string_counter: advance_result.string_counter,
        try_counter: 0,
        alias_counter: advance_result.alias_counter
    };
}
// lower_multi_while_statement lowers a restricted bounded counter loop: a single i64
// induction variable, a non-short-circuit comparison condition that reads it, a body
// of Let/If statements, and a trailing 'name = name + step' increment. The body
// statements reuse the same let/if lowering as the top level; body if labels are
// offset by the loop index so they never collide with top-level if labels. The
// induction increment is folded into induction_step and rendered in the loop latch.
fn lower_multi_while_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    // loop_index namespaces this loop's labels and carried-scalar names; scope_node /
    // scope_stmt_index locate the loop inside its enclosing block so its induction seed resolves
    // against the statements that actually precede it. A top-level loop passes the function body
    // and its top-level statement index; a nested one passes the enclosing loop body.
    scope_node: i64,
    scope_stmt_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    // A while header is one of three shapes. A single comparison, or a short-circuit 'and'
    // chain whose operands are all side-effect-free (bool/int locals and literals, field
    // reads, and pure '<receiver>.len()' calls), folds into an eager 'and i1' that is
    // observably identical to short-circuit evaluation, so it lowers through the same
    // lower_expr_into path the bare comparison uses (mir_short_circuit stays 0). A genuine
    // short-circuit 'and' -- one whose later operand could trap when an earlier one is false,
    // such as line_end_excluding_break's '!is_line_break(source[index])' guarded by 'index <
    // length' -- lowers as a chain of operand blocks: the first operand fills cond_insts (the
    // loop head), the second fills cond_rhs_insts (a guarded loopN_head_rhs block), and any
    // further operands fill cond_extra_operands, so the guarded byte load only runs when its
    // guard holds. An `or` header is accepted only when the same eager-safety proof succeeds.
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    // A continue-latch loop carries its increment inside a body 'if <cond> { <induction> =
    // <induction> + <step>; continue; }' rather than in a trailing assign, so it has no trailing
    // latch statement and the existing trailing-increment machinery does not apply. It lowers
    // through a dedicated path (line_comment_has_blank_after, issue 1165 / 1162).
    if try while_is_continue_latch(ir_bytes, function_name, statement, bs) {
        // A top-level continue-latch loop resolves its 'var <induction> = <init>' seed from the
        // function body and keeps the induction variable's own name (no rename): "" / "" leave the
        // seed and rename to lower_multi_while_continue_latch's defaults (issue 1165 / 1162).
        return try lower_multi_while_continue_latch(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            temp_counter,
            alias_counter,
            loop_index,
            "",
            "",
            stmts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    // A leading-decrement loop advances its counter through a body-opening '<var> = <var> - <int>'
    // self-decrement rather than a trailing increment, so the trailing-latch machinery below (which
    // requires the last body statement to be the induction increment) does not apply. It lowers
    // through a dedicated path that reseats the loop-head phi and synthesizes the decrement as a body
    // let (lbrace_opens_enum_decl, issue 1165 / 1162).
    if try while_is_leading_decrement(ir_bytes, function_name, body_node, bs) {
        return try lower_multi_while_leading_decrement(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            temp_counter,
            alias_counter,
            loop_index,
            stmts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    // A branch-merge latch advances or exits through a terminal if/else, so it has no trailing
    // increment Assign for while_induction_var to read. Dispatch it before the trailing-latch path
    // so the shape is validated by the branch-merge lowering instead of failing the old suffix
    // precondition (issue 1165 / 1162).
    if try while_is_branch_merge_latch(ir_bytes, function_name, statement, bs) {
        return try lower_multi_while_branch_merge_latch(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            temp_counter,
            alias_counter,
            loop_index,
            aliases,
            stmts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    // A condition-only loop carries nothing between iterations, so it has no latch to find and no
    // loop-head phi to seed. Dispatch it before the trailing-latch machinery below, which requires
    // the body's last statement to be the induction increment.
    if try while_is_condition_only(ir_bytes, function_name, statement, bs) {
        return try lower_multi_while_condition_only(
            ir_bytes,
            function_name,
            module_prefix,
            llvm_return_type,
            locals_spec,
            statement,
            string_counter,
            temp_counter,
            alias_counter,
            loop_index,
            aliases,
            stmts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    // A loop whose body contains a continue is re-entered from a point the latch never sees, and a
    // loop whose body contains a break is left from one the head never sees. Either way it carries
    // its values in slots instead of loop-head phis: the head reloads them however control got
    // back, the exit reloads them however control got out, and the jump itself is a bare branch.
    // A loop that advances nothing at the end of its body has no counter either, and the shapes
    // that hide their advance elsewhere are already dispatched above. It carries whatever the body
    // updates in slots for the same reason a continue does: there is no single latch value for a
    // loop-head phi to take.
    let no_trailing_latch = try while_has_no_trailing_latch(
        ir_bytes, function_name, statement, bs
    );
    let memory_carried =
        no_trailing_latch or try while_body_has_loop_jump(ir_bytes, function_name, body_node, bs);
    let body_count = try while_body_statement_count(
        ir_bytes, function_name, body_node, bs
    );
    var latch_count = 0;
    if !no_trailing_latch {
        latch_count = try while_trailing_increment_count(
            ir_bytes, function_name, body_node, body_count, bs
        );
    }
    // An empty induction variable is what the rest of this function reads as "no counter": every
    // derived value below computes trivially from it, and the blocks that only make sense for a
    // counter are guarded on it.
    var induction_var = "";
    if !no_trailing_latch {
        induction_var = try while_induction_var(ir_bytes, function_name, statement, bs);
    }
    let induction_alias = try local_alias_current_name(aliases, induction_var);
    // The loop-head phi is named after the induction variable, so two whiles over one variable in a
    // single function would define %<var> twice. When an earlier loop in this scope already claimed
    // the name, this loop takes a scoped phi name and seeds from the value that loop left live
    // ('var divisor = 1; while <scan> {} while divisor > 0 {}', std::fmt::append_i64).
    let claimed_induction_phi = try local_alias_loop_phi_name(aliases, induction_var);
    var induction_phi = induction_var;
    if std::mem::len(claimed_induction_phi) > 0 {
        induction_phi = try loop_scoped_induction_phi_name(
            induction_var, loop_index, call_arg_type_cache
        );
    }
    let induction_phi_is_renamed = !std::mem::equal_bytes(induction_phi, induction_var);
    // A renamed phi always seeds by name from the incoming value; so does an induction variable an
    // earlier statement rebound to an alias.
    let induction_seeds_from_alias =
        induction_phi_is_renamed or !std::mem::equal_bytes(induction_alias, induction_var);
    // A loop whose induction variable is also reassigned by the body ahead of the latch plays two
    // roles at once: the body carries it as a scalar and the tail advances it. Modelling those
    // separately would emit two loop-head phis for one name, so fold the tail into the carried run --
    // every body statement including the advance lowers as a carried assign, and the loop-head phi
    // reads the final carried alias on the latch edge through latch_copy_var (issue 1165 / 1162).
    let induction_is_carried = try while_carries_body_scalar_var(
        ir_bytes, function_name, body_node, body_count - latch_count, induction_var, bs
    );
    var body_boundary = body_count - latch_count;
    if induction_is_carried {
        body_boundary = body_count;
    }
    var carried_scalar_states =
        std::array::Array<CarriedScalarState>(std::mem::page_allocator());
    defer carried_scalar_states.deinit();
    // Materializing a carried scalar's seed into the enclosing block consumes string and temp
    // slots ahead of the condition, so the scan carries its own counters forward.
    var seed_string_counter = string_counter;
    var seed_temp_counter = temp_counter;
    var carried_scan_index = 0;
    while carried_scan_index < body_boundary {
        let carried_statement = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement",
            carried_scan_index, bs
        );
        var carried_names = std::array::Array<[]u8>(std::mem::page_allocator());
        defer carried_names.deinit();
        try collect_loop_assigned_var_names(
            ir_bytes, function_name, carried_statement, &var carried_names, bs
        );
        var carried_name_index = 0;
        while carried_name_index < carried_names.len() {
            let carried_name = try carried_names.get(carried_name_index);
            carried_name_index = carried_name_index + 1;
            // A name the enclosing scope never bound is declared inside the body, so the loop
            // does not carry it across the back edge and it takes no loop-head phi.
            if (try find_induction_init_value_node_or_minus_one(
                ir_bytes, function_name, carried_name, scope_node, scope_stmt_index, bs
            )) < 0 {
                continue;
            }
            // The induction variable already owns the loop-head phi the latch advances. It joins
            // the carried run only through induction_is_carried, which folds the advance into it;
            // registering it here as well would define its phi twice.
            if !induction_is_carried and std::mem::equal_bytes(carried_name, induction_var) {
                continue;
            }
            if (try carried_scalar_index(
                &carried_scalar_states, carried_name
            )) < 0 {
                let carried_type =
                    try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
                        ir_lookup_index, ir_bytes, function_name, module_prefix,
                        locals_spec, carried_name, bs, call_arg_type_cache
                    );
                let carried_init_node = try find_induction_init_value_node(
                    ir_bytes, function_name, carried_name, scope_node, scope_stmt_index, bs
                );
                let carried_init_kind = try ir_contract::body_node_kind_from(
                    ir_bytes, function_name, carried_init_node, bs
                );
                var carried_init_literal = 0;
                var carried_init_var = "";
                var carried_init_offset = 0;
                var carried_init_name = "";
                // The compact loop-head phi seed spells an i64 literal, copy, or base-plus-offset
                // directly. Any other seed -- a call result, a negated literal such as 'var
                // last_dot = -1;', or a value of another type such as 'var wildcard = false;' --
                // seeds the phi by name from the value bound before the loop instead, which is
                // what the typed phi renders.
                var carried_init_is_compact = false;
                // An enclosing loop that carries the same scalar re-enters this one on every one of
                // its own iterations, so the value on this loop's preheader edge is whatever the
                // enclosing loop holds by then -- not the 'var <name> = <init>' the compact seed
                // resolves to, which would reset the scalar each time the outer loop came round.
                let carried_is_claimed =
                    std::mem::len(try local_alias_loop_phi_name(aliases, carried_name)) > 0;
                if std::mem::equal_bytes(carried_type, "i64") and !carried_is_claimed {
                    if std::mem::equal_bytes(carried_init_kind, "Int") or
                        std::mem::equal_bytes(carried_init_kind, "Var") or
                        std::mem::equal_bytes(carried_init_kind, "Binary") {
                        carried_init_is_compact = true;
                    }
                }
                if !carried_init_is_compact {
                    carried_init_name = try local_alias_current_name(
                        aliases, carried_name
                    );
                    if std::mem::equal_bytes(carried_init_name, carried_name) {
                        // Nothing in SSA carries this scalar into the loop: its 'var <name> =
                        // <init>' seed is kept off the emitted-let path so it cannot redefine the
                        // loop-head phi's name. Lower the initializer here instead, under a scoped
                        // name, so the phi seeds from a value that exists rather than from itself.
                        var seed_insts =
                            std::array::Array<compiled_mir::MirExprInst>(
                                std::mem::page_allocator()
                            );
                        let seed_result = try lower_expr_with_local_aliases(
                            ir_bytes, function_name, module_prefix, locals_spec,
                            carried_init_node, seed_string_counter,
                            seed_temp_counter, &var seed_insts, aliases, bs,
                            ir_lookup_index, canonical_facts, call_arg_type_cache
                        );
                        let seed_type = try expr_inst_llvm_type_by_id(
                            &seed_insts, seed_result
                        );
                        if !std::mem::equal_bytes(seed_type, carried_type) {
                            return error(
                                "compiled mir: loop-carried scalar seed type mismatch"
                            );
                        }
                        let seed_name = try carried_scalar_seed_name(
                            carried_name, loop_index, call_arg_type_cache
                        );
                        let seed_strings = try count_strings_in_insts(&seed_insts);
                        let seed_temps = seed_insts.len();
                        try stmts.append(compiled_mir::let_expr_stmt(
                            seed_name, seed_string_counter, seed_result, seed_insts
                        ));
                        seed_string_counter = seed_string_counter + seed_strings;
                        seed_temp_counter = seed_temp_counter + seed_temps;
                        carried_init_name = seed_name;
                    }
                } else {
                    let carried_init = try find_induction_init(
                        ir_bytes, function_name, carried_name, scope_node, scope_stmt_index, bs
                    );
                    carried_init_literal = carried_init.literal;
                    carried_init_var = carried_init.var_name;
                    carried_init_offset = carried_init.offset;
                }
                var carried_current_name = carried_name;
                if induction_phi_is_renamed and
                    std::mem::equal_bytes(carried_name, induction_var) {
                    carried_current_name = induction_phi;
                } else {
                    // An enclosing loop that carries this same scalar has already bound %<name> at
                    // its own head, so this loop cannot bind it again. It takes a scoped name for
                    // the same reason a nested induction counter does -- the reads inside this
                    // body then resolve to it through the body alias map.
                    if carried_is_claimed {
                        carried_current_name = try loop_scoped_induction_phi_name(
                            carried_name, loop_index, call_arg_type_cache
                        );
                    }
                }
                try carried_scalar_states.append(CarriedScalarState {
                    source_name: carried_name,
                    head_name: carried_current_name,
                    current_name: carried_current_name,
                    llvm_type: carried_type,
                    init_literal: carried_init_literal,
                    init_var: carried_init_var,
                    init_offset: carried_init_offset,
                    init_name: carried_init_name
                });
            }
        }
        carried_scan_index = carried_scan_index + 1;
    }
    // loop_index is this while's top-level statement index, so the induction initializer
    // is the nearest preceding 'var <induction_var> = <init>'.
    var induction_init_literal = 0;
    var induction_init_var = "";
    var induction_init_offset = 0;
    // A computed primary init (for example 'var token = next_token(text, open)' or
    // 'var index = span.start') lowers into the preheader. init_insts run before the loop head and
    // the phi reads init_result_id. Integer literals and plain copies retain their compact direct
    // representation. Only a fresh cursor with no incoming alias takes the computed-expression
    // path; an aliased induction variable seeds from that already-emitted SSA value.
    var init_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var init_result_id = -1;
    var cond_string_base = seed_string_counter;
    var cond_temp_base = seed_temp_counter;
    // Only a counter has a seed to resolve. A slot-carried loop with no counter leaves these at
    // their empty defaults; its carried values were seeded above, each from its own declaration.
    if std::mem::len(induction_var) > 0 {
    let init_node = try find_induction_init_value_node(
        ir_bytes, function_name, induction_var, scope_node, scope_stmt_index, bs
    );
    let init_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, init_node, bs);
    // A base-plus-offset seed ('var right_index = right + 1') has the same compact spelling the
    // secondary counters and carried scalars already use, so the preheader binds it as
    // %<var>_init. Lowering it as a general expression instead would leave the primary phi of a
    // lockstep pair seeding from an anonymous temp while its partner seeds from a named value.
    let init_is_base_plus_offset = try induction_init_is_base_plus_offset(
        ir_bytes, function_name, init_node, bs
    );
    if !std::mem::equal_bytes(init_kind, "Int") and
        !std::mem::equal_bytes(init_kind, "Var") and
        !init_is_base_plus_offset and
        !induction_seeds_from_alias {
        init_result_id = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            init_node,
            seed_string_counter,
            seed_temp_counter,
            &var init_insts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        cond_string_base = seed_string_counter + try count_strings_in_insts(&init_insts);
        cond_temp_base = seed_temp_counter + init_insts.len();
    } else {
        let induction_init = try find_induction_init(
            ir_bytes, function_name, induction_var, scope_node, scope_stmt_index, bs
        );
        induction_init_literal = induction_init.literal;
        induction_init_var = induction_init.var_name;
        induction_init_offset = induction_init.offset;
        if induction_seeds_from_alias {
            induction_init_literal = 0;
            induction_init_var = induction_alias;
            induction_init_offset = 0;
        }
    }
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_rhs_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var cond_extra_operands = std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator());
    var cond_targets = std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator());
    var cond_result = -1;
    var cond_rhs_result = -1;
    var mir_short_circuit = 0;
    var body_string_counter = cond_string_base;
    var body_temp_counter = cond_temp_base;
    if cond_kind != 0 and
        !(try condition_eager_safe(ir_bytes, function_name, cond_node, bs)) {
        // A genuine short-circuit boolean chain: the leaf operands are evaluated left to right in
        // their own blocks, each carrying the two destinations its result branches to. The first
        // fills cond_insts, the second fills cond_rhs_insts, and any further leaves fill
        // cond_extra_operands, mirroring the short-circuit if-chain. Mixing `and` and `or` is
        // structural: collect_cond_leaves descends both, so only the recorded edges differ.
        mir_short_circuit = 1;
        var leaves = std::array::Array<CondLeaf>(std::mem::page_allocator());
        try collect_cond_leaves(
            ir_bytes, function_name, cond_node, 0,
            compiled_mir::cond_target_condition_true(),
            compiled_mir::cond_target_condition_false(),
            &var leaves, bs
        );
        let first_leaf = try leaves.at(0);
        let first_node = first_leaf.node;
        let first_true = first_leaf.true_target;
        let first_false = first_leaf.false_target;
        cond_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            first_node,
            cond_string_base,
            cond_temp_base,
            &var cond_insts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        try rename_loop_cond_reads(
            &var cond_insts, aliases, &carried_scalar_states, induction_var, induction_phi
        );
        try cond_targets.append(compiled_mir::cond_target(first_true, first_false));
        var acc_strings = try count_strings_in_insts(&cond_insts);
        var acc_temp = cond_temp_base + cond_insts.len();
        let second_leaf = try leaves.at(1);
        let second_node = second_leaf.node;
        let second_true = second_leaf.true_target;
        let second_false = second_leaf.false_target;
        cond_rhs_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            second_node,
            cond_string_base + acc_strings,
            acc_temp,
            &var cond_rhs_insts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        try rename_loop_cond_reads(
            &var cond_rhs_insts, aliases, &carried_scalar_states, induction_var, induction_phi
        );
        try cond_targets.append(compiled_mir::cond_target(second_true, second_false));
        acc_strings = acc_strings + try count_strings_in_insts(&cond_rhs_insts);
        acc_temp = acc_temp + cond_rhs_insts.len();
        var leaf_index = 2;
        while leaf_index < leaves.len() {
            var operand_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
            let leaf = try leaves.at(leaf_index);
            let leaf_node = leaf.node;
            let leaf_true = leaf.true_target;
            let leaf_false = leaf.false_target;
            let operand_result = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                leaf_node,
                cond_string_base + acc_strings,
                acc_temp,
                &var operand_insts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            try rename_loop_cond_reads(
                &var operand_insts, aliases, &carried_scalar_states, induction_var, induction_phi
            );
            acc_strings = acc_strings + try count_strings_in_insts(&operand_insts);
            acc_temp = acc_temp + operand_insts.len();
            try cond_extra_operands.append(
                compiled_mir::cond_operand(operand_result, operand_insts)
            );
            try cond_targets.append(compiled_mir::cond_target(leaf_true, leaf_false));
            leaf_index = leaf_index + 1;
        }
        body_string_counter = cond_string_base + acc_strings;
        body_temp_counter = acc_temp;
        leaves.deinit();
    } else {
        cond_result = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            locals_spec,
            cond_node,
            cond_string_base,
            cond_temp_base,
            &var cond_insts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        try rename_loop_cond_reads(
            &var cond_insts, aliases, &carried_scalar_states, induction_var, induction_phi
        );
        body_string_counter = cond_string_base + try count_strings_in_insts(&cond_insts);
        body_temp_counter = cond_temp_base + cond_insts.len();
    }
    var body_try_counter = loop_index * 1000;
    var body_alias_counter = alias_counter;
    // The body ends with a latch suffix: one statement (a constant-step 'index = index +
    // <int>' increment or a loop-carried 'index = try <callee>(.., index);' try-call), or a
    // run of constant-step increments when the loop advances several lockstep counters
    // ('left_index = left_index + 1; right_index = right_index + 1;'). The primary induction
    // is the last increment; earlier increments in the run become secondary inductions
    // rendered alongside it (issue 1165 / 1162).
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    // The body sees the enclosing scope's current SSA names: a variable an earlier statement
    // rebound reads that value inside the loop, not the one it had before. The names this loop's
    // head defines are then reseated onto their phis, which own the value in the body.
    var body_aliases = try copy_local_aliases(aliases);
    defer body_aliases.deinit();
    // Claimed rather than merely set: the head has defined these names, so a nested loop in this
    // body over the same variable must take a scoped phi name instead of redefining one of them.
    if std::mem::len(induction_var) > 0 {
        try claim_local_alias_loop_phi(&var body_aliases, induction_var, induction_phi);
    }
    var carried_reset_index = 0;
    while carried_reset_index < carried_scalar_states.len() {
        let carried_reset_state = try carried_scalar_states.at(carried_reset_index);
        let carried_reset_source = carried_reset_state.source_name;
        let carried_reset_current = carried_reset_state.current_name;
        try claim_local_alias_loop_phi(
            &var body_aliases, carried_reset_source, carried_reset_current
        );
        carried_reset_index = carried_reset_index + 1;
    }
    var body_index = 0;
    while body_index < body_boundary {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            // A 'var counter = <init>' a nested while in this body advances is that loop's
            // induction seed. Its loop-head phi supplies the value on the preheader edge, so
            // emitting the let would define the same SSA name twice -- the rule the top-level
            // statement walk already applies (issue 1165 / 1162).
            if try statement_is_induction_init(
                ir_bytes, function_name, body_node, body_stmt, body_boundary, bs
            ) {
                // Unless something between it and the loop reads a value the loop cannot rebuild,
                // in which case it stays here under a name of its own and the loop seeds from that.
                if !(try loop_seed_must_stay_in_place(
                    ir_bytes, function_name, body_node, body_stmt, body_boundary, bs
                )) {
                    body_index = body_index + 1;
                    continue;
                }
                let seed_result = try lower_loop_seed_binding_in_place(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_try_counter,
                    &var body_aliases,
                    &var body_stmts,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_string_counter = seed_result.string_counter;
                body_temp_counter = seed_result.temp_counter;
                body_try_counter = seed_result.try_counter;
                body_index = body_index + 1;
                continue;
            }
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                body_stmt,
                body_string_counter,
                body_temp_counter,
                body_try_counter,
                &var body_aliases,
                &var body_stmts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let body_if_index = loop_index * 1000 + body_index + 1;
                // Only a slot-carried loop can be re-entered or left from inside its body. A loop
                // that still uses head phis has no operand for such an edge, so it names itself -1
                // and a continue or break under it is rejected rather than emitted as a branch
                // into a phi that does not expect it.
                var body_continue_target = -1;
                if memory_carried {
                    body_continue_target = loop_index;
                }
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_try_counter,
                    body_alias_counter,
                    body_if_index,
                    &var body_aliases,
                    &var body_stmts,
                    body_continue_target,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    // A void try-call statement inside the loop body (e.g.
                    // 'try render_llvm_c_byte(out, byte);') lowers through the same
                    // expression-statement path the then-body uses.
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        body_stmt,
                        body_string_counter,
                        body_temp_counter,
                        body_try_counter,
                        &body_aliases,
                        &var body_stmts,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_temp_counter = expr_result.temp_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    if std::mem::equal_bytes(body_kind, "Match") {
                        // An enum/union dispatch inside the loop body lowers through the same
                        // EnumDispatch path top-level statements use. The renderer scopes every
                        // dispatch label by the body statement's local prefix, so the arms never
                        // collide with the loop's own head/latch/exit labels.
                        let match_result = try lower_multi_match_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            body_stmt,
                            body_string_counter,
                            body_temp_counter,
                            body_try_counter,
                            &var body_aliases,
                            &var body_stmts,
                            bs,
                            ir_lookup_index,
                            canonical_facts,
                            call_arg_type_cache,
                            false,
                            "",
                            ""
                        );
                        body_string_counter = match_result.string_counter;
                        body_temp_counter = match_result.temp_counter;
                        body_try_counter = match_result.try_counter;
                    } else {
                    if std::mem::equal_bytes(body_kind, "Assign") {
                        let target = try ir_contract::body_child_sequence_from(
                            ir_bytes, function_name, body_stmt, "target", 0, bs
                        );
                        let target_name =
                            try ir_contract::body_token_or_empty_from(
                                ir_bytes, function_name, target, bs
                            );
                        let state_index = try carried_scalar_index(
                            &carried_scalar_states, target_name
                        );
                        if state_index < 0 {
                            return error(
                                "compiled mir: loop assignment target is not carried"
                            );
                        }
                        let state = try carried_scalar_states.at(state_index);
                        let state_source_name = state.source_name;
                        let state_head_name = state.head_name;
                        let state_llvm_type = state.llvm_type;
                        let state_init_literal = state.init_literal;
                        let state_init_var = state.init_var;
                        let state_init_offset = state.init_offset;
                        let state_init_name = state.init_name;
                        let value = try ir_contract::body_child_sequence_from(
                            ir_bytes, function_name, body_stmt, "value", 0, bs
                        );
                        var value_insts =
                            std::array::Array<compiled_mir::MirExprInst>(
                                std::mem::page_allocator()
                            );
                        let value_result =
                            try lower_expr_with_carried_renames(
                                ir_bytes, function_name, module_prefix,
                                locals_spec, value, body_string_counter,
                                body_temp_counter, &var value_insts,
                                &carried_scalar_states, bs, ir_lookup_index,
                                canonical_facts, call_arg_type_cache
                            );
                        let value_type = try expr_inst_llvm_type_by_id(
                            &value_insts, value_result
                        );
                        if !std::mem::equal_bytes(
                            value_type, state_llvm_type
                        ) {
                            return error(
                                "compiled mir: loop-carried assignment type mismatch"
                            );
                        }
                        let output_name = try loop_carried_alias_name(
                            target_name, body_stmt, call_arg_type_cache
                        );
                        let value_strings = try count_strings_in_insts(
                            &value_insts
                        );
                        let value_temps = value_insts.len();
                        var carry_index = -1;
                        if memory_carried {
                            carry_index = loop_index;
                        }
                        // The store this assignment makes is keyed by the loop's own head name for
                        // the scalar, which is the slot's key.
                        try body_stmts.append(compiled_mir::carried_alias_assign_stmt(
                            state_head_name, output_name, state_llvm_type,
                            value_result, value_insts, carry_index
                        ));
                        // Statements after this assign read the value it just produced, not the
                        // loop-head phi, so the body alias map has to follow the rename the way it
                        // does for every other alias assignment (issue 1165 / 1162).
                        try set_local_alias(
                            &var body_aliases, target_name, output_name
                        );
                        try carried_scalar_states.set(
                            state_index,
                            CarriedScalarState {
                                source_name: state_source_name,
                                head_name: state_head_name,
                                current_name: output_name,
                                llvm_type: state_llvm_type,
                                init_literal: state_init_literal,
                                init_var: state_init_var,
                                init_offset: state_init_offset,
                                init_name: state_init_name
                            }
                        );
                        body_string_counter =
                            body_string_counter + value_strings;
                        body_temp_counter =
                            body_temp_counter + value_temps;
                    } else {
                    if std::mem::equal_bytes(body_kind, "While") {
                        // A nested loop lowers through this same path. Its labels and
                        // carried-scalar names take the body statement's own namespace -- the one
                        // body ifs already use, in a separate label prefix -- and its induction
                        // seed resolves against this body, where the 'var <counter> = <init>' that
                        // precedes it lives.
                        let nested_result = try lower_multi_while_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            body_stmt,
                            body_string_counter,
                            body_temp_counter,
                            body_alias_counter,
                            loop_index * 1000 + body_index + 1,
                            body_node,
                            body_index,
                            &var body_aliases,
                            &var body_stmts,
                            bs,
                            ir_lookup_index, canonical_facts, call_arg_type_cache
                        );
                        body_string_counter = nested_result.string_counter;
                        body_temp_counter = nested_result.temp_counter;
                        body_alias_counter = nested_result.alias_counter;
                        // A value this loop carries in a slot is stored where it is assigned, so a
                        // continue reaching the head still finds it. A nested loop updates it
                        // without any assignment of its own -- it leaves the value under its own
                        // exit name -- so the store it never made is made here instead.
                        if memory_carried {
                            var nested_carry_index = 0;
                            while nested_carry_index < carried_scalar_states.len() {
                                let nested_state =
                                    try carried_scalar_states.at(nested_carry_index);
                                let nested_source = nested_state.source_name;
                                let nested_head = nested_state.head_name;
                                let nested_before = nested_state.current_name;
                                let nested_type = nested_state.llvm_type;
                                let nested_init_literal = nested_state.init_literal;
                                let nested_init_var = nested_state.init_var;
                                let nested_init_offset = nested_state.init_offset;
                                let nested_init_name = nested_state.init_name;
                                let nested_after = try local_alias_current_name(
                                    &body_aliases, nested_source
                                );
                                if !std::mem::equal_bytes(nested_after, nested_before) {
                                    try body_stmts.append(compiled_mir::loop_carry_store_stmt(
                                        loop_index, nested_head, nested_type, nested_after
                                    ));
                                    try carried_scalar_states.set(
                                        nested_carry_index,
                                        CarriedScalarState {
                                            source_name: nested_source,
                                            head_name: nested_head,
                                            current_name: nested_after,
                                            llvm_type: nested_type,
                                            init_literal: nested_init_literal,
                                            init_var: nested_init_var,
                                            init_offset: nested_init_offset,
                                            init_name: nested_init_name
                                        }
                                    );
                                }
                                nested_carry_index = nested_carry_index + 1;
                            }
                        }
                    } else {
                        var message =
                            std::string::String(std::mem::page_allocator());
                        try message.append_bytes(
                            "compiled mir: unsupported while body statement: function "
                        );
                        try message.append_bytes(function_name);
                        try message.append_bytes(" node ");
                        try std::fmt::append_i64(&var message, body_stmt);
                        try message.append_bytes(" kind ");
                        try message.append_bytes(body_kind);
                        let message_bytes = message.as_bytes();
                        return error(message_bytes);
                    }
                    }
                    }
                }
            }
        }
        body_index = body_index + 1;
    }
    // A carried scalar the body updated inside an if arm leaves the loop through that if's join,
    // not through a top-level alias assign, so its latch value is whatever the body alias map
    // holds once the body has lowered. Reading it back here is what makes the back edge carry the
    // merged value instead of the loop-head phi referring to itself.
    var carried_sync_index = 0;
    while carried_sync_index < carried_scalar_states.len() {
        let sync_state = try carried_scalar_states.at(carried_sync_index);
        let sync_source = sync_state.source_name;
        let sync_head = sync_state.head_name;
        let sync_previous = sync_state.current_name;
        let sync_llvm_type = sync_state.llvm_type;
        let sync_init_literal = sync_state.init_literal;
        let sync_init_var = sync_state.init_var;
        let sync_init_offset = sync_state.init_offset;
        let sync_init_name = sync_state.init_name;
        let sync_current = try local_alias_current_name(&body_aliases, sync_source);
        if !std::mem::equal_bytes(sync_current, sync_previous) {
            try carried_scalar_states.set(
                carried_sync_index,
                CarriedScalarState {
                    source_name: sync_source,
                    head_name: sync_head,
                    current_name: sync_current,
                    llvm_type: sync_llvm_type,
                    init_literal: sync_init_literal,
                    init_var: sync_init_var,
                    init_offset: sync_init_offset,
                    init_name: sync_init_name
                }
            );
        }
        carried_sync_index = carried_sync_index + 1;
    }
    var induction_op = "add";
    var step = 0;
    var latch_copy_var = "";
    var latch_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    // Only a counter has a latch to build. A slot-carried loop with no counter leaves the latch a
    // bare branch back to the head: everything it carries was stored where it was updated.
    if std::mem::len(induction_var) > 0 {
    if induction_is_carried {
        // The tail advance already lowered as this loop's last carried assign, so the latch
        // emits no add of its own: the loop-head phi reads that assign's alias on the latch
        // edge, exactly as a copy-decrement latch does (issue 1165 / 1162).
        let carried_index = try carried_scalar_index(
            &carried_scalar_states, induction_var
        );
        if carried_index < 0 {
            return error(
                "compiled mir: carried induction variable has no loop-carried state"
            );
        }
        let carried_state = try carried_scalar_states.at(carried_index);
        latch_copy_var = carried_state.current_name;
    } else {
        let increment_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_count - 1, bs
        );
        let increment_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, increment_stmt, bs
        );
        if !std::mem::equal_bytes(increment_kind, "Assign") {
            var message = std::string::String(std::mem::page_allocator());
            try message.append_bytes(
                "compiled mir: while body must end with the induction increment: "
            );
            try message.append_bytes(function_name);
            try message.append_bytes(" last kind ");
            try message.append_bytes(increment_kind);
            let message_bytes = message.as_bytes();
            return error(message_bytes);
        }
        // The induction latch is either a constant-step 'index = index + <int>' increment or a
        // loop-carried 'index = try <callee>(.., index);' try-call update. The increment target
        // must name the induction variable in both shapes (issue 1165).
        let increment_target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, increment_stmt, "target", 0, bs
        );
        let increment_target_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, increment_target, bs
        );
        if !std::mem::equal_bytes(increment_target_name, induction_var) {
            return error("compiled mir: induction increment must assign to the induction variable");
        }
        let increment_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, increment_stmt, "value", 0, bs
        );
        let increment_value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, increment_value, bs
        );
        if std::mem::equal_bytes(increment_value_kind, "TryExpr") {
            // 'index = try index_after_import(tokens, index);' advances the counter by a try-call
            // whose i64 success value feeds the loop-head phi (%<var>_next) and whose failure
            // propagates as this function's own error union. The latch try-call is given a try
            // index past the body try-calls (body_try_counter) and a call-arg setup prefix past
            // the body statement prefixes (loop_index * 1000 + body_count) so its SSA names never
            // collide with the body (issue 1165).
            let latch_stmt = try lower_while_latch_try_call(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                induction_phi,
                increment_value,
                body_string_counter,
                body_try_counter,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            try latch_stmts.append(latch_stmt);
        } else {
            if std::mem::equal_bytes(increment_value_kind, "Call") {
                // 'token = synth_next_token(token);' advances the induction variable through a
                // token-carried call result rather than a numeric add: the loop variable is
                // reseated from a free function returning i64, whose result feeds the loop-head
                // phi (%<var>_next). Unlike the try-call latch this call propagates no error, so
                // it ends in loopN_latch with no fail/cont block (issue 1157 PR-P4).
                let latch_stmt = try lower_while_latch_call(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    induction_phi,
                    increment_value,
                    body_string_counter,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                try latch_stmts.append(latch_stmt);
            } else {
            if std::mem::equal_bytes(increment_value_kind, "FieldExpr") {
                // 'token = declaration.next;' advances the induction variable from a struct field
                // of a body-local (a field-access latch) rather than a numeric add or a call result.
                // The loop body binds the struct earlier ('let declaration = ...;') and this reads its
                // i64 field into the loop-head phi (%<var>_next). Like the plain-call latch it carries
                // no control flow, so it ends in loopN_latch with no fail/cont block. This is the
                // shape parse_program_with_declarations / parse_block_with_statements need (issue 1157
                // PR-PF).
                let latch_stmt = try lower_while_latch_field_access(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    locals_spec,
                    induction_phi,
                    increment_value,
                    body_string_counter,
                    bs,
                    ir_lookup_index,
                    canonical_facts,
                    call_arg_type_cache
                );
                try latch_stmts.append(latch_stmt);
            } else {
            if std::mem::equal_bytes(increment_value_kind, "Var") {
                // 'index = previous' copies a body-local back into the induction variable. The local
                // must be bound earlier in this loop body by 'let previous = index - <int>', a
                // decrement of the induction variable, so the loop counts down and terminates against
                // its 'index > 0' header. The local is kept in the body (it also feeds source[previous]),
                // so the latch carries no add: the loop-head phi reads %previous directly on the latch
                // edge (issue 1165 / 1162).
                let latch_copy_source = try ir_contract::body_token_or_empty_from(
                    ir_bytes, function_name, increment_value, bs
                );
                try validate_copy_latch_source(
                    ir_bytes, function_name, body_node, body_boundary,
                    induction_var, latch_copy_source, bs
                );
                latch_copy_var = try local_alias_current_name(
                    &body_aliases, latch_copy_source
                );
            } else {
                let update = try parse_induction_update(
                    ir_bytes, function_name, increment_stmt, induction_var, bs
                );
                induction_op = update.llvm_op;
                step = update.operand;
            }
            }
            }
        }
    }
    }
    // The increments before the primary latch (body_boundary .. body_count - 2) are the
    // secondary lockstep counters. Each is a constant-step 'name = name + <int>' increment
    // with its own preceding 'var name = <init>' initializer, so it gets its own loop-head
    // phi and latch add (issue 1165 / 1162).
    var secondary_inductions =
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator());
    var secondary_index = body_boundary;
    while secondary_index < body_count - 1 {
        let secondary_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", secondary_index, bs
        );
        let secondary_target = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, secondary_stmt, "target", 0, bs
        );
        let secondary_var = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, secondary_target, bs
        );
        let secondary_step = try parse_induction_step(
            ir_bytes, function_name, secondary_stmt, secondary_var, bs
        );
        let secondary_init = try find_induction_init(
            ir_bytes, function_name, secondary_var, scope_node, scope_stmt_index, bs
        );
        try secondary_inductions.append(compiled_mir::secondary_induction(
            secondary_var,
            secondary_init.literal,
            secondary_init.var_name,
            secondary_init.offset,
            secondary_step
        ));
        secondary_index = secondary_index + 1;
    }
    var carried_exclude = "";
    if induction_is_carried {
        carried_exclude = induction_var;
    }
    // Statements after the loop read the value it leaves live on every exit edge: the loop-head
    // phi. Claiming the name here also tells a later loop over the same variable that %<phi> is
    // taken, so it renames its own head phi instead of redefining this one.
    // A slot-carried loop leaves a different value live. Its head is only current for an exit taken
    // at the head; a break leaves from inside the body, after stores the head never saw. The exit
    // block reloads every slot for exactly that reason, so the reads after the loop go there --
    // while the head keeps its claim on %<phi>, which is still a definition a later loop must not
    // collide with.
    if std::mem::len(induction_var) > 0 {
        if memory_carried {
            let induction_exit_name = try loop_exit_carried_name(
                induction_phi, loop_index, call_arg_type_cache
            );
            try claim_local_alias_loop_exit(
                aliases, induction_var, induction_phi, induction_exit_name
            );
        } else {
            try claim_local_alias_loop_phi(aliases, induction_var, induction_phi);
        }
    }
    let carried_scalars = try materialize_carried_scalars(
        &carried_scalar_states, carried_exclude
    );
    if memory_carried {
        var exit_secondary_index = 0;
        while exit_secondary_index < secondary_inductions.len() {
            let exit_secondary = try secondary_inductions.at(exit_secondary_index);
            let exit_secondary_name = exit_secondary.var_name;
            let secondary_exit_name = try loop_exit_carried_name(
                exit_secondary_name, loop_index, call_arg_type_cache
            );
            try set_local_alias(aliases, exit_secondary_name, secondary_exit_name);
            exit_secondary_index = exit_secondary_index + 1;
        }
        // Keyed by the source name, valued by the exit reload of the head name: the two differ for
        // a scalar this loop had to rename because an enclosing loop carries it too.
        var exit_carried_index = 0;
        while exit_carried_index < carried_scalar_states.len() {
            let exit_carried = try carried_scalar_states.at(exit_carried_index);
            let exit_carried_source = exit_carried.source_name;
            let exit_carried_head = exit_carried.head_name;
            if !std::mem::equal_bytes(exit_carried_source, carried_exclude) {
                let carried_exit_name = try loop_exit_carried_name(
                    exit_carried_head, loop_index, call_arg_type_cache
                );
                try set_local_alias(aliases, exit_carried_source, carried_exit_name);
            }
            exit_carried_index = exit_carried_index + 1;
        }
    } else {
        // A phi-carried loop leaves each carried scalar live in its head phi, so statements after
        // the loop read that -- the same claim the induction counter makes just above. Without it a
        // scalar whose declaration bound a name of its own keeps resolving to that declaration, and
        // reads after the loop see the value from before the first iteration.
        var phi_carried_index = 0;
        while phi_carried_index < carried_scalar_states.len() {
            let phi_carried = try carried_scalar_states.at(phi_carried_index);
            let phi_carried_source = phi_carried.source_name;
            let phi_carried_head = phi_carried.head_name;
            if !std::mem::equal_bytes(phi_carried_source, carried_exclude) {
                try claim_local_alias_loop_phi(
                    aliases, phi_carried_source, phi_carried_head
                );
            }
            phi_carried_index = phi_carried_index + 1;
        }
    }
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_phi,
        induction_init_literal,
        induction_init_var,
        induction_init_offset,
        induction_op,
        step,
        cond_result,
        cond_insts,
        mir_short_circuit,
        cond_rhs_result,
        cond_rhs_insts,
        cond_extra_operands,
        cond_targets,
        body_stmts,
        latch_stmts,
        latch_copy_var,
        secondary_inductions,
        carried_scalars,
        init_insts,
        init_result_id,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        memory_carried
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: 0,
        alias_counter: body_alias_counter
    };
}
// lower_multi_while_condition_only lowers a loop that threads no value between iterations. It
// emits a MirWhileStmt whose induction variable is empty, which the renderer spells as the same
// preheader/head/body/latch/exit layout every other while uses, minus the counter phi and the
// latch advance. There is no induction seed to resolve, no secondary counter, no carried scalar,
// and no latch statement, so the body lowers as a plain statement run.
fn lower_multi_while_condition_only(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    aliases: &var std::array::Array<LocalAliasState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    // A genuine short-circuit header exists to keep a later leaf from running until an earlier one
    // has decided -- the guard that lets 'index < length and !is_line_break(source[index])' load a
    // byte safely. A condition-only loop has no counter for such a guard to range over, so the
    // chain lowering is not wired here; an eager comparison tree still folds into one 'br i1'.
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: condition-only loop header must fold into a single branch");
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    // The header reads the enclosing scope's current SSA names. This loop defines no phi, so there
    // is nothing for the rename to hold back: the empty carried set and empty induction names leave
    // only the enclosing aliases to apply.
    var carried_scalar_states =
        std::array::Array<CarriedScalarState>(std::mem::page_allocator());
    defer carried_scalar_states.deinit();
    try rename_loop_cond_reads(&var cond_insts, aliases, &carried_scalar_states, "", "");
    var body_string_counter = string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = temp_counter + cond_insts.len();
    var body_try_counter = loop_index * 1000;
    var body_alias_counter = alias_counter;
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = try copy_local_aliases(aliases);
    defer body_aliases.deinit();
    var body_index = 0;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, body_stmt, bs
        );
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                body_stmt,
                body_string_counter,
                body_temp_counter,
                body_try_counter,
                &var body_aliases,
                &var body_stmts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_try_counter,
                    body_alias_counter,
                    loop_index * 1000 + body_index + 1,
                    &var body_aliases,
                    &var body_stmts,
                    loop_index,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
            } else {
                if std::mem::equal_bytes(body_kind, "ExprStmt") {
                    let expr_result = try lower_multi_expr_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        body_stmt,
                        body_string_counter,
                        body_temp_counter,
                        body_try_counter,
                        &body_aliases,
                        &var body_stmts,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_string_counter = expr_result.string_counter;
                    body_temp_counter = expr_result.temp_counter;
                    body_try_counter = expr_result.try_counter;
                } else {
                    if std::mem::equal_bytes(body_kind, "Match") {
                        let match_result = try lower_multi_match_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            body_stmt,
                            body_string_counter,
                            body_temp_counter,
                            body_try_counter,
                            &var body_aliases,
                            &var body_stmts,
                            bs,
                            ir_lookup_index,
                            canonical_facts,
                            call_arg_type_cache,
                            false,
                            "",
                            ""
                        );
                        body_string_counter = match_result.string_counter;
                        body_temp_counter = match_result.temp_counter;
                        body_try_counter = match_result.try_counter;
                    } else {
                        return error(
                            "compiled mir: unsupported condition-only loop body statement"
                        );
                    }
                }
            }
        }
        body_index = body_index + 1;
    }
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        "",
        0,
        "",
        0,
        "",
        0,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        "",
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        -1,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        false
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: 0,
        alias_counter: body_alias_counter
    };
}
// assign_is_self_decrement reports whether a body Assign is a constant-step self-decrement
// '<var> = <var> - <int>' of the named variable: a Binary 'sub' value whose left is that same Var
// and whose right is a positive integer literal. It classifies the leading induction advance of a
// leading-decrement loop (issue 1165 / 1162).
fn assign_is_self_decrement(
    ir_bytes: []u8,
    function_name: []u8,
    assign_node: i64,
    var_name: []u8,
    bs: i64
) -> !bool {
    let value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    let value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, value, bs);
    if !std::mem::equal_bytes(value_kind, "Binary") {
        return false;
    }
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, value, bs
    );
    if !std::mem::equal_bytes(op, "sub") {
        return false;
    }
    let left_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "left", 0, bs
    );
    let right_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, value, "right", 0, bs
    );
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left_node, bs);
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right_node, bs);
    if !std::mem::equal_bytes(left_kind, "Var") or !std::mem::equal_bytes(right_kind, "Int") {
        return false;
    }
    let left_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, left_node, bs);
    if !std::mem::equal_bytes(left_name, var_name) {
        return false;
    }
    let offset = try ir_contract::body_int_value_from(ir_bytes, function_name, right_node, bs);
    return offset >= 1;
}
// while_is_leading_decrement reports whether a bounded loop advances its induction variable through
// a leading self-decrement rather than a trailing 'name = name + step' increment or a continue-latch:
// its first body statement is '<var> = <var> - <int>' and its last body statement is not an
// induction increment assign. lbrace_opens_enum_decl's backward brace scan is its first consumer
// (issue 1165 / 1162):
//   var cursor = index;
//   while cursor > 0 {
//       cursor = cursor - 1;
//       let token = try tokens.get(cursor);
//       ...
//   }
// The continue-latch shape is dispatched before this check, so a leading decrement here is always a
// fall-through (non-continue) loop whose body reads the decremented counter.
fn while_is_leading_decrement(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    bs: i64
) -> !bool {
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return false;
    }
    let first_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    let first_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, first_stmt, bs);
    if !std::mem::equal_bytes(first_kind, "Assign") {
        return false;
    }
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, first_stmt, "target", 0, bs
    );
    let target_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, target, bs);
    if !std::mem::equal_bytes(target_kind, "Var") {
        return false;
    }
    let target_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    if !(try assign_is_self_decrement(ir_bytes, function_name, first_stmt, target_name, bs)) {
        return false;
    }
    // The induction is advanced only by the leading decrement: a trailing Assign as the last body
    // statement is the trailing-latch (or lockstep-counter) path, so a loop that both leads with a
    // decrement and trails with an increment is left to that lowering rather than mis-detected here.
    let last_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_stmt, bs);
    if std::mem::equal_bytes(last_kind, "Assign") {
        return false;
    }
    return true;
}

fn append_leading_decrement_carried_scalar(
    ir_bytes: []u8,
    function_name: []u8,
    target_name: []u8,
    loop_index: i64,
    states: &var std::array::Array<CarriedScalarState>,
    bs: i64
) -> !void {
    if (try carried_scalar_index(states, target_name)) >= 0 {
        return;
    }
    if states.len() > 0 {
        return error("compiled mir: only one carried scalar per leading-decrement loop is supported");
    }
    let init = try find_induction_init(ir_bytes, function_name, target_name, 0, loop_index, bs);
    try states.append(CarriedScalarState {
        source_name: target_name,
        head_name: target_name,
        current_name: target_name,
        llvm_type: "i64",
        init_literal: init.literal,
        init_var: init.var_name,
        init_offset: init.offset,
        init_name: ""
    });
    return;
}

fn collect_leading_decrement_carried_scalars(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    loop_index: i64,
    bs: i64
) -> !std::array::Array<CarriedScalarState> {
    var states = std::array::Array<CarriedScalarState>(std::mem::page_allocator());
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var body_index = 0;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "If") {
            let assign_node = try if_scalar_assign_node_or_minus_one(
                ir_bytes, function_name, body_stmt, bs
            );
            if assign_node >= 0 {
                let target = try scalar_assign_target_or_empty(
                    ir_bytes, function_name, assign_node, bs
                );
                if std::mem::len(target) > 0 {
                    try append_leading_decrement_carried_scalar(
                        ir_bytes, function_name, target, loop_index, &var states, bs
                    );
                }
            }
        }
        body_index = body_index + 1;
    }
    return states;
}

// materialize_carried_scalars renders the collected carried-scalar states as loop-head phi
// descriptors. exclude_name drops one state from the result: a name the loop already owns a
// phi for -- the induction variable of a loop that also carries it in the body -- would
// otherwise define the same SSA value twice at the loop head (issue 1165 / 1162).
fn materialize_carried_scalars(
    states: &std::array::Array<CarriedScalarState>,
    exclude_name: []u8
) -> !std::array::Array<compiled_mir::MirCarriedScalar> {
    var carried = std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator());
    var index = 0;
    while index < states.len() {
        let state = try states.at(index);
        if !std::mem::equal_bytes(state.source_name, exclude_name) {
            try carried.append(compiled_mir::carried_scalar(
                state.head_name,
                state.llvm_type,
                state.init_literal,
                state.init_var,
                state.init_offset,
                state.init_name,
                state.current_name
            ));
        }
        index = index + 1;
    }
    return carried;
}

fn lower_scalar_select_assign_from_if(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    if_node: i64,
    assign_node: i64,
    string_counter: i64,
    temp_counter: i64,
    loop_index: i64,
    body_index: i64,
    states: &var std::array::Array<CarriedScalarState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let target_name = try scalar_assign_target_or_empty(ir_bytes, function_name, assign_node, bs);
    if std::mem::len(target_name) == 0 {
        return error("compiled mir: scalar select assignment must be a self add/sub");
    }
    let state_index = try carried_scalar_index(states, target_name);
    if state_index < 0 {
        return error("compiled mir: scalar select assignment target is not loop-carried");
    }
    let state = try states.at(state_index);
    let state_source_name = state.source_name;
    let state_head_name = state.head_name;
    let state_current_name = state.current_name;
    let state_llvm_type = state.llvm_type;
    let state_init_literal = state.init_literal;
    let state_init_var = state.init_var;
    let state_init_offset = state.init_offset;
    let state_init_name = state.init_name;
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: scalar select assignment condition must be a single expression");
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        states,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let cond_strings = try count_strings_in_insts(&cond_insts);
    let value_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_node, "value", 0, bs
    );
    var value_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let value_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        value_node,
        string_counter + cond_strings,
        temp_counter + cond_insts.len(),
        &var value_insts,
        states,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let value_strings = try count_strings_in_insts(&value_insts);
    let cond_len = cond_insts.len();
    let value_len = value_insts.len();
    let output_name = try carried_scalar_alias_name(target_name, loop_index, body_index);
    try stmts.append(compiled_mir::scalar_select_assign_stmt(
        target_name,
        state_current_name,
        output_name,
        state_llvm_type,
        cond_result,
        cond_insts,
        value_result,
        value_insts
    ));
    try states.set(state_index, CarriedScalarState {
        source_name: state_source_name,
        head_name: state_head_name,
        current_name: output_name,
        llvm_type: state_llvm_type,
        init_literal: state_init_literal,
        init_var: state_init_var,
        init_offset: state_init_offset,
        init_name: state_init_name
    });
    return MultiIfLowerResult {
        temp_counter: temp_counter + cond_len + value_len,
        string_counter: string_counter + cond_strings + value_strings,
        try_counter: 0,
        alias_counter: 0
    };
}

fn lower_carried_return_if_from_cond(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    return_statement: i64,
    if_index: i64,
    string_counter: i64,
    cond_result: i64,
    cond_insts: std::array::Array<compiled_mir::MirExprInst>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let then_string_base = string_counter + try count_strings_in_insts(&cond_insts);
    let then_base = cond_result + 1;
    let ret_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, return_statement, "value", 0, bs
    );
    var ret_node = ret_value;
    var ret_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, ret_node, bs);
    if std::mem::equal_bytes(ret_kind, "TryExpr") {
        ret_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, ret_node, "value", 0, bs
        );
        ret_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, ret_node, bs);
    }
    if std::mem::equal_bytes(ret_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, ret_node, bs
        );
        let bool_value = std::mem::equal_bytes(token, "true");
        try stmts.append(compiled_mir::if_stmt(
            if_index,
            string_counter,
            cond_result,
            try compiled_mir::copy_expr_insts(&cond_insts),
            0,
            -1,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
            compiled_mir::MirIfThenKind::ReturnBool,
            bool_value,
            llvm_return_type,
            "",
            "",
            std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
            -1,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
            then_string_base,
            std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator())
        ));
        return MultiIfLowerResult {
            temp_counter: then_base,
            string_counter: then_string_base,
            try_counter: 0,
            alias_counter: 0
        };
    }

    if std::mem::equal_bytes(ret_kind, "Call") {
        let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, ret_node, bs, call_arg_type_cache
        );
        if !std::mem::equal_bytes(call_info.return_llvm_type, llvm_return_type) {
            return error("compiled mir: carried return call must return this function's error union");
        }
        let call_args = try compiled_mir_lower_call::lower_call_args_canonical(
            ir_bytes, function_name, module_prefix, locals_spec, ret_node, then_string_base, bs,
            ir_lookup_index, canonical_facts, &call_info.types,
            call_arg_type_cache
        );
        let call_arg_strings = try compiled_mir_lower_call::count_string_args(&call_args);
        try stmts.append(compiled_mir::if_stmt(
            if_index,
            string_counter,
            cond_result,
            try compiled_mir::copy_expr_insts(&cond_insts),
            0,
            -1,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
            compiled_mir::MirIfThenKind::ReturnCall,
            false,
            call_info.return_llvm_type,
            call_info.module_prefix,
            call_info.callee_name,
            call_args,
            -1,
            std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
            then_string_base,
            std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
            std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator())
        ));
        return MultiIfLowerResult {
            temp_counter: then_base + 1,
            string_counter: then_string_base + call_arg_strings,
            try_counter: 0,
            alias_counter: 0
        };
    }

    var then_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let then_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        ret_node,
        then_string_base,
        then_base,
        &var then_insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let then_strings = try count_strings_in_insts(&then_insts);
    try stmts.append(compiled_mir::if_stmt(
        if_index,
        string_counter,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
        compiled_mir::MirIfThenKind::ReturnExpr,
        false,
        llvm_return_type,
        "",
        "",
        std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator()),
        then_result,
        then_insts,
        std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator()),
        then_string_base,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirIfMergeVar>(std::mem::page_allocator())
    ));
    return MultiIfLowerResult {
        temp_counter: then_result + 1,
        string_counter: then_string_base + then_strings,
        try_counter: 0,
        alias_counter: 0
    };
}

fn lower_carried_return_if_statement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    if_node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    states: &std::array::Array<CarriedScalarState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind == 2 and
        !(try condition_eager_safe(ir_bytes, function_name, cond_node, bs)) {
        return error("compiled mir: carried return-if or condition is unsupported");
    }
    if cond_kind == 1 and !(try condition_eager_safe(ir_bytes, function_name, cond_node, bs)) {
        return error("compiled mir: carried return-if condition is not eager-safe");
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        states,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let then_count = try while_body_statement_count(ir_bytes, function_name, then_node, bs);
    if then_count != 1 {
        return error("compiled mir: carried return-if then-block must be a single return");
    }
    let return_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let return_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, return_statement, bs
    );
    if !std::mem::equal_bytes(return_kind, "Return") {
        return error("compiled mir: carried return-if then-block must return");
    }
    return try lower_carried_return_if_from_cond(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        return_statement,
        if_index,
        string_counter,
        cond_result,
        cond_insts,
        stmts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
}

fn lower_guarded_return_then_scalar_assign(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    if_node: i64,
    assign_node: i64,
    string_counter: i64,
    temp_counter: i64,
    if_index: i64,
    loop_index: i64,
    body_index: i64,
    states: &var std::array::Array<CarriedScalarState>,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let then_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "then", 0, bs
    );
    let nested_if = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, then_node, "statement", 0, bs
    );
    let nested_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, nested_if, bs);
    if !std::mem::equal_bytes(nested_kind, "If") {
        return error("compiled mir: guarded scalar assignment must begin with a return-if");
    }
    let outer_cond = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, if_node, "condition", 0, bs
    );
    let nested_cond = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, nested_if, "condition", 0, bs
    );
    let outer_kind = try short_circuit_kind(ir_bytes, function_name, outer_cond, bs);
    let nested_cond_kind = try short_circuit_kind(ir_bytes, function_name, nested_cond, bs);
    if outer_kind != 0 or nested_cond_kind != 0 {
        return error("compiled mir: guarded scalar return condition must be simple");
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let outer_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        outer_cond,
        string_counter,
        temp_counter,
        &var cond_insts,
        states,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let outer_strings = try count_strings_in_insts(&cond_insts);
    let outer_len = cond_insts.len();
    let nested_result = try lower_expr_with_carried_renames(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        nested_cond,
        string_counter + outer_strings,
        temp_counter + outer_len,
        &var cond_insts,
        states,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let and_id = nested_result + 1;
    let and_inst = try compiled_mir::binary_expr_inst(
        and_id, "and", outer_result, nested_result, "i1"
    );
    try cond_insts.append(and_inst);
    let nested_then = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, nested_if, "then", 0, bs
    );
    let nested_then_count = try while_body_statement_count(ir_bytes, function_name, nested_then, bs);
    if nested_then_count != 1 {
        return error("compiled mir: guarded scalar nested then-block must return");
    }
    let return_statement = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, nested_then, "statement", 0, bs
    );
    let return_result = try lower_carried_return_if_from_cond(
        ir_bytes,
        function_name,
        module_prefix,
        llvm_return_type,
        locals_spec,
        return_statement,
        if_index,
        string_counter,
        and_id,
        cond_insts,
        stmts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let assign_result = try lower_scalar_select_assign_from_if(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        if_node,
        assign_node,
        return_result.string_counter,
        return_result.temp_counter,
        loop_index,
        body_index,
        states,
        stmts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return assign_result;
}
// lower_multi_while_leading_decrement lowers a bounded loop whose induction variable is advanced by a
// leading self-decrement '<var> = <var> - <int>' (issue 1165 / 1162). The decrement reassigns the
// counter at the top of the body, so every later body read of <var> means the decremented value. To
// keep the loop-head phi (the pre-decrement value the 'cursor > bound' header tests) distinct from
// the body value, the phi is reseated onto a reserved name (leading.decrement.head, which no kizu
// identifier can spell) and the decrement is synthesized as the first body statement 'let <var> =
// leading.decrement.head - <int>'. The header comparison and the decrement's right-hand side rename
// their <var> read to the reserved phi name; every other body statement reads <var> unchanged and so
// resolves to the synthesized let. The loop-head phi reads %<var> on the latch edge (the
// copy-decrement latch the renderer already supports, latch_copy_var = <var>), and the body carries
// no trailing latch. Only one leading-decrement loop per function is supported (a second would reuse
// the reserved phi name); every current consumer carries exactly one.
fn lower_multi_while_leading_decrement(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let head_var = "leading.decrement.head";
    // The reserved phi name is shared by every leading-decrement loop, so a second one in the same
    // function would define %leading.decrement.head twice. Leading-decrement loops only lower at the
    // top level (a nested while is an unsupported body statement below), so scanning the already
    // lowered top-level statements for an earlier leading-decrement while catches the collision as an
    // explicit error rather than emitting an invalid duplicate phi (issue 1165 / 1162).
    var existing_index = 0;
    while existing_index < stmts.len() {
        let existing = try stmts.at(existing_index);
        let existing_head = match existing {
            While(payload) => payload.induction_var,
            _ => "",
        };
        if std::mem::len(existing_head) > 0 and std::mem::equal_bytes(existing_head, head_var) {
            return error("compiled mir: only one leading-decrement loop per function is supported");
        }
        existing_index = existing_index + 1;
    }
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: leading-decrement loop header must be a single comparison");
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    var carried_states = try collect_leading_decrement_carried_scalars(
        ir_bytes, function_name, body_node, loop_index, bs
    );
    let decrement_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", 0, bs
    );
    let target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, decrement_stmt, "target", 0, bs
    );
    let induction_var = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, target, bs);
    let induction_init = try find_induction_init(
        ir_bytes, function_name, induction_var, 0, loop_index, bs
    );
    // The loop-head comparison reads the pre-decrement counter, so its <var> read renames to the
    // reserved phi name.
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        string_counter,
        temp_counter,
        &var cond_insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    try rename_induction_in_insts(&var cond_insts, induction_var, head_var);
    // The header must test the decremented counter: after the rename, the condition has to read the
    // reserved phi name at least once. A no-op rename means the loop-head comparison reads some other
    // variable (e.g. 'while other > 0 { cursor = cursor - 1; ... }'), so the phi would track 'cursor'
    // while the header tests 'other' -- a mis-detected shape that is an explicit error here rather
    // than a silent mis-lower (issue 1165 / 1162).
    if !(try insts_reference_var(&cond_insts, head_var)) {
        return error("compiled mir: leading-decrement loop header must test the induction variable");
    }
    var body_string_counter = string_counter + try count_strings_in_insts(&cond_insts);
    var body_temp_counter = temp_counter + cond_insts.len();
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    // The synthesized decrement 'let <var> = leading.decrement.head - <int>' binds the body value of
    // the counter; its right-hand side reads the pre-decrement phi, so it too renames to the reserved
    // name.
    let decrement_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, decrement_stmt, "value", 0, bs
    );
    var dec_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let dec_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        decrement_value,
        body_string_counter,
        body_temp_counter,
        &var dec_insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    try rename_induction_in_insts(&var dec_insts, induction_var, head_var);
    let dec_strings = try count_strings_in_insts(&dec_insts);
    let dec_temp = body_temp_counter + dec_insts.len();
    try body_stmts.append(compiled_mir::let_expr_stmt(
        induction_var, body_string_counter, dec_result, dec_insts
    ));
    body_string_counter = body_string_counter + dec_strings;
    body_temp_counter = dec_temp;
    // The remaining body statements read the decremented counter through the synthesized let, so they
    // lower exactly like a top-level Let/If run with no rename. The body-if index reuses the same
    // 'loop_index * 1000 + statement_index + 1' encoding the trailing-latch body uses; the
    // synthesized decrement occupies body_stmts[0] at the same statement_index 0 as the source
    // decrement, so later statement indices line up with their body_stmts slots.
    var body_try_counter = loop_index * 1000;
    var body_alias_counter = alias_counter;
    var body_index = 1;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            let let_result = try lower_multi_let_statement(
                ir_bytes,
                function_name,
                module_prefix,
                llvm_return_type,
                locals_spec,
                body_stmt,
                body_string_counter,
                body_temp_counter,
                body_try_counter,
                &var body_aliases,
                &var body_stmts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_string_counter = let_result.string_counter;
            body_temp_counter = let_result.temp_counter;
            body_try_counter = let_result.try_counter;
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let body_if_index = loop_index * 1000 + body_index + 1;
                if carried_states.len() > 0 {
                    let assign_node = try if_scalar_assign_node_or_minus_one(
                        ir_bytes, function_name, body_stmt, bs
                    );
                    var carried_result = MultiIfLowerResult {
                        temp_counter: body_temp_counter,
                        string_counter: body_string_counter,
                        try_counter: 0,
                        alias_counter: 0
                    };
                    if assign_node >= 0 {
                        let then_node = try ir_contract::body_child_sequence_from(
                            ir_bytes, function_name, body_stmt, "then", 0, bs
                        );
                        let then_count = try while_body_statement_count(
                            ir_bytes, function_name, then_node, bs
                        );
                        if then_count == 1 {
                            carried_result = try lower_scalar_select_assign_from_if(
                                ir_bytes,
                                function_name,
                                module_prefix,
                                locals_spec,
                                body_stmt,
                                assign_node,
                                body_string_counter,
                                body_temp_counter,
                                loop_index,
                                body_index,
                                &var carried_states,
                                &var body_stmts,
                                bs,
                                ir_lookup_index, canonical_facts, call_arg_type_cache
                            );
                        } else {
                            if then_count == 2 {
                                carried_result = try lower_guarded_return_then_scalar_assign(
                                    ir_bytes,
                                    function_name,
                                    module_prefix,
                                    llvm_return_type,
                                    locals_spec,
                                    body_stmt,
                                    assign_node,
                                    body_string_counter,
                                    body_temp_counter,
                                    body_if_index,
                                    loop_index,
                                    body_index,
                                    &var carried_states,
                                    &var body_stmts,
                                    bs,
                                    ir_lookup_index, canonical_facts, call_arg_type_cache
                                );
                            } else {
                                return error("compiled mir: unsupported carried scalar if shape");
                            }
                        }
                    } else {
                        carried_result = try lower_carried_return_if_statement(
                            ir_bytes,
                            function_name,
                            module_prefix,
                            llvm_return_type,
                            locals_spec,
                            body_stmt,
                            body_string_counter,
                            body_temp_counter,
                            body_if_index,
                            &carried_states,
                            &var body_stmts,
                            bs,
                            ir_lookup_index, canonical_facts, call_arg_type_cache
                        );
                    }
                    body_temp_counter = carried_result.temp_counter;
                    body_string_counter = carried_result.string_counter;
                } else {
                    let if_result = try lower_multi_if_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        body_stmt,
                        body_string_counter,
                        body_temp_counter,
                        body_try_counter,
                        body_alias_counter,
                        body_if_index,
                        &var body_aliases,
                        &var body_stmts,
                        -1,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    );
                    body_temp_counter = if_result.temp_counter;
                    body_string_counter = if_result.string_counter;
                    body_try_counter = if_result.try_counter;
                    body_alias_counter = if_result.alias_counter;
                }
            } else {
                return error("compiled mir: unsupported leading-decrement while body statement");
            }
        }
        body_index = body_index + 1;
    }
    let carried_scalars = try materialize_carried_scalars(&carried_states, "");
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        head_var,
        induction_init.literal,
        induction_init.var_name,
        induction_init.offset,
        "add",
        0,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        induction_var,
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        carried_scalars,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        -1,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        false
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: 0,
        alias_counter: body_alias_counter
    };
}
// return_expr_advance returns the counters past an expression-return statement's instructions: the
// temp counter advances by the instruction count and the string counter by the string literals
// among them. It backs continue_latch_return_advance (issue 1165 / 1162).
fn return_expr_advance(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    base_temp: i64,
    base_string: i64
) -> !MultiIfLowerResult {
    return MultiIfLowerResult {
        temp_counter: base_temp + insts.len(),
        string_counter: base_string + try count_strings_in_insts(insts),
        try_counter: 0,
        alias_counter: 0
    };
}
// continue_latch_return_advance returns the counters past a continue-latch loop's terminal return so
// statements after the while never reuse a temp or string slot the return emitted. The tail must be
// an expression return (a hoisted-call 'return is_line_break(source[cursor])', a bool, or a plain
// value); any other return shape is an explicit error rather than a silently un-counted lowering
// (issue 1165 / 1162).
fn continue_latch_return_advance(
    stmt: &compiled_mir::MirStmt,
    base_temp: i64,
    base_string: i64
) -> !MultiIfLowerResult {
    match stmt {
        ReturnExpr(payload) => return try return_expr_advance(&payload.expr_insts, base_temp, base_string);,
        _ => return error("compiled mir: continue-latch loop tail must be an expression return");,
    }
}
// rename_induction_in_insts rewrites every plain Var read of 'from' to 'to' in an expression
// instruction array. A nested continue-latch loop reuses the enclosing loop's induction variable
// name ('cursor' in line_comment_has_blank_before's inner scan), so its loop-head phi would clash
// with the enclosing loop's phi of the same name. Renaming the induction reads in the inner loop's
// header and body lets it take a distinct phi name. The induction variable is always an i64 loop
// counter, so the rewritten Var keeps the i64 type; only the Var name carries the induction, so
// operand-id references (Binary / IndexLoad index / call args) follow the renamed Var without
// further rewriting (issue 1165 / 1162).
fn rename_induction_in_insts(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    from: []u8,
    to: []u8
) -> !void {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        let name = match inst {
            Var(payload) => payload.value,
            _ => "",
        };
        var do_rename = false;
        var hold_id = 0;
        if std::mem::len(name) > 0 and std::mem::equal_bytes(name, from) {
            do_rename = true;
            hold_id = compiled_mir::expr_inst_id(inst);
        }
        if do_rename {
            try insts.set(index, compiled_mir::var_expr_inst(hold_id, "i64", to));
        }
        index = index + 1;
    }
    return;
}

fn expr_inst_var_name_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        Var(payload) => payload.value,
        _ => "",
    };
}

fn expr_inst_field_base_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        FieldAccess(payload) => payload.value,
        _ => "",
    };
}

fn expr_inst_field_left_or_zero(inst: &compiled_mir::MirExprInst) -> i64 {
    return match inst {
        FieldAccess(payload) => payload.left,
        _ => 0,
    };
}

fn expr_inst_field_source_type_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        FieldAccess(payload) => payload.source_type,
        _ => "",
    };
}

fn expr_inst_field_source_index_or_zero(inst: &compiled_mir::MirExprInst) -> i64 {
    return match inst {
        FieldAccess(payload) => payload.source_field_index,
        _ => 0,
    };
}

fn expr_inst_index_target_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        IndexLoad(payload) => payload.target,
        _ => "",
    };
}

fn expr_inst_index_operand_or_zero(inst: &compiled_mir::MirExprInst) -> i64 {
    return match inst {
        IndexLoad(payload) => payload.index,
        _ => 0,
    };
}

fn expr_inst_array_len_receiver_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        ArrayLen(payload) => payload.receiver_name,
        _ => "",
    };
}

fn expr_inst_string_len_receiver_or_empty(inst: &compiled_mir::MirExprInst) -> []u8 {
    return match inst {
        StringLen(payload) => payload.receiver_name,
        _ => "",
    };
}

fn rename_var_in_insts(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    from: []u8,
    to: []u8
) -> !void {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        let inst_id = compiled_mir::expr_inst_id(inst);
        let inst_type = compiled_mir::expr_inst_llvm_type(inst);
        let var_name = expr_inst_var_name_or_empty(inst);
        let field_base = expr_inst_field_base_or_empty(inst);
        let field_left = expr_inst_field_left_or_zero(inst);
        let field_source_type = expr_inst_field_source_type_or_empty(inst);
        let field_source_index = expr_inst_field_source_index_or_zero(inst);
        let index_target = expr_inst_index_target_or_empty(inst);
        let index_operand = expr_inst_index_operand_or_zero(inst);
        let array_len_receiver = expr_inst_array_len_receiver_or_empty(inst);
        let string_len_receiver = expr_inst_string_len_receiver_or_empty(inst);
        if std::mem::len(var_name) > 0 and std::mem::equal_bytes(var_name, from) {
            try insts.set(index, compiled_mir::var_expr_inst(inst_id, inst_type, to));
        } else {
            if field_left < 0 and
                std::mem::len(field_base) > 0 and
                std::mem::equal_bytes(field_base, from) {
                try insts.set(index, compiled_mir::field_access_expr_inst(
                    inst_id,
                    inst_type,
                    to,
                    field_source_type,
                    field_source_index
                ));
            } else {
                if std::mem::len(index_target) > 0 and std::mem::equal_bytes(index_target, from) {
                    try insts.set(index, compiled_mir::index_load_expr_inst(
                        inst_id,
                        to,
                        index_operand
                    ));
                } else {
                    if std::mem::len(array_len_receiver) > 0 and
                        std::mem::equal_bytes(array_len_receiver, from) {
                        try insts.set(index, compiled_mir::array_len_expr_inst(
                            inst_id,
                            to
                        ));
                    } else {
                        if std::mem::len(string_len_receiver) > 0 and
                            std::mem::equal_bytes(string_len_receiver, from) {
                            try insts.set(index, compiled_mir::string_len_expr_inst(
                                inst_id,
                                to
                            ));
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    return;
}

fn rename_local_aliases_in_insts(
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>
) -> !void {
    var index = 0;
    while index < aliases.len() {
        let state = try aliases.at(index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try rename_var_in_insts(insts, state.source_name, state.current_name);
        }
        index = index + 1;
    }
    return;
}

fn lower_expr_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    node: i64,
    string_counter: i64,
    temp_counter: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    return try lower_expr_into_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        node,
        string_counter,
        temp_counter,
        insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
}
// insts_reference_var reports whether an expression instruction array reads a Var named 'name'.
// A renamed nested continue-latch body lowers its if / return statements through the shared
// lowering (no rename threaded in), so this guards that those statements never reference the
// induction variable in a position the inner rename did not reach -- a near-miss shape is an
// explicit error rather than a silent unrenamed phi reference (issue 1165 / 1162).
fn insts_reference_var(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    name: []u8
) -> !bool {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        let var_name = match inst {
            Var(payload) => payload.value,
            _ => "",
        };
        if std::mem::len(var_name) > 0 and std::mem::equal_bytes(var_name, name) {
            return true;
        }
        index = index + 1;
    }
    return false;
}
// if_payload_references_induction reports whether an if statement reads the induction variable in
// any of its condition operand blocks or its expression then-block. A copy-decrement continue-if's
// then-block carries no expression insts (its increment folds into the latch), so this catches an
// induction reference only where the inner rename did not reach (issue 1165 / 1162).
fn if_payload_references_induction(
    payload: &compiled_mir::MirIfStmt,
    name: []u8
) -> !bool {
    if try insts_reference_var(&payload.cond_insts, name) {
        return true;
    }
    if try insts_reference_var(&payload.cond_rhs_insts, name) {
        return true;
    }
    let extra_operands = &payload.cond_extra_operands;
    var extra_index = 0;
    while extra_index < extra_operands.len() {
        let operand = try extra_operands.at(extra_index);
        if try insts_reference_var(&operand.insts, name) {
            return true;
        }
        extra_index = extra_index + 1;
    }
    return try insts_reference_var(&payload.then_expr_insts, name);
}
// stmt_references_induction reports whether a renamed nested continue-latch body's if or return
// statement still reads the induction variable. The inner rename only rewrites the loop header and
// the body lets it lowers itself; an if condition or a return value that reads the induction is an
// unsupported shape, so it is an explicit error rather than a silently unrenamed reference (issue
// 1165 / 1162).
fn stmt_references_induction(
    stmt: &compiled_mir::MirStmt,
    name: []u8
) -> !bool {
    match stmt {
        If(payload) => return try if_payload_references_induction(payload, name);,
        ReturnExpr(payload) => return try insts_reference_var(&payload.expr_insts, name);,
        _ => return error("compiled mir: nested continue-latch body statement is not an if or return");,
    }
}
// lower_multi_while_continue_latch lowers a continue-latch bounded loop -- one whose induction
// variable advances inside a body 'if <cond> { <induction> = <step>; continue; }' rather than
// through a trailing increment assign. line_comment_has_blank_after is its first consumer, with the
// nested-loop / copy-decrement generalization added for line_comment_has_blank_before (issue 1165 /
// 1162):
//   var cursor = line_end_including_break(source, comment_end);
//   while cursor < end {
//       if is_horizontal_space(source[cursor]) { cursor = cursor + 1; continue; }
//       return is_line_break(source[cursor]);
//   }
//   return false;
// The induction advance is either a constant-step '<var> = <var> + <int>' increment (folded into a
// shared '%var_next = add i64 %var, step' in loopN_latch) or a copy-decrement '<var> = <local>'
// copy whose local is a '<var> - <int>' decrement computed earlier in the body (the loop-head phi
// reads %<local> on the latch edge through latch_copy_var, and the latch emits no add). The
// continue-if's then-block becomes 'br label %loopN_latch' either way, and the loop's non-continue
// tail (a 'return') falls through the if-continuation block, so the body already terminates and
// append_multi_while emits no trailing 'br' into the latch.
//
// The seed comes from one of two places. A top-level loop (explicit_seed_var == "") resolves its
// 'var <induction> = <init>' from the function body: a call-seeded init lowers the call into
// init_insts (run in the preheader, the phi reading its result), and a literal / plain-copy /
// base-plus-offset seed reuses find_induction_init's classification. A nested loop (explicit_seed_var
// != "") seeds its phi by a plain copy of that local -- the '<induction> = <local>' re-seed assign
// that precedes it in the enclosing body -- and renames its induction reads to rename_to so its
// loop-head phi does not clash with the enclosing loop's phi of the same induction name.
//
// The body carries the continue-if, optional early-return ifs, and -- for a nested scan -- a
// '<induction> = <local>' re-seed assign immediately followed by the nested while it seeds. A
// short-circuit header, a non-return body tail, a re-seed assign not followed by a nested while,
// nesting deeper than one level, or any other body statement is an explicit error so a near-miss
// never silently mis-lowers.
fn lower_multi_while_continue_latch(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    statement: i64,
    string_counter: i64,
    temp_counter: i64,
    alias_counter: i64,
    loop_index: i64,
    explicit_seed_var: []u8,
    rename_to: []u8,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let cond_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "condition", 0, bs
    );
    let cond_kind = try short_circuit_kind(ir_bytes, function_name, cond_node, bs);
    if cond_kind != 0 {
        return error("compiled mir: continue-latch loop header must be a single comparison");
    }
    let body_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "body", 0, bs
    );
    let body_count = try while_body_statement_count(ir_bytes, function_name, body_node, bs);
    if body_count < 2 {
        return error("compiled mir: continue-latch loop body must carry the continue-if and a return");
    }
    // The loop's non-continue path must terminate: its last body statement is the 'return' the
    // continue-if falls through to. Because it already terminates, append_multi_while emits no
    // trailing 'br' into the latch -- the only edge back to the head is the continue-if's branch.
    let last_body = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_count - 1, bs
    );
    let last_body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, last_body, bs);
    if !std::mem::equal_bytes(last_body_kind, "Return") {
        return error("compiled mir: continue-latch loop body must end with a return");
    }
    let induction_var = try while_continue_induction_var(ir_bytes, function_name, statement, bs);
    let increment_assign = try while_continue_increment_assign(ir_bytes, function_name, statement, bs);
    // The continue-if's induction advance is a constant-step increment or a copy-decrement. A
    // copy-decrement drives the latch through latch_copy_var (validated as a '<induction> - <int>'
    // decrement bound earlier in the body); a constant-step folds into the shared latch add.
    let increment_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, increment_assign, "value", 0, bs
    );
    let increment_value_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, increment_value, bs
    );
    var step = 0;
    var latch_copy_var = "";
    if std::mem::equal_bytes(increment_value_kind, "Var") {
        latch_copy_var = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, increment_value, bs
        );
        try validate_copy_latch_source(
            ir_bytes, function_name, body_node, body_count, induction_var, latch_copy_var, bs
        );
    } else {
        step = try parse_induction_step(
            ir_bytes, function_name, increment_assign, induction_var, bs
        );
    }
    // Resolve the seed. A nested loop seeds its phi by a plain copy of explicit_seed_var (the
    // enclosing body's '<induction> = <local>' re-seed); a top-level loop resolves the 'var
    // <induction> = <init>' initializer, lowering a call seed into init_insts.
    var induction_init = 0;
    var induction_init_var = "";
    var induction_init_offset = 0;
    var init_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    var init_result_id = -1;
    var body_string_counter = string_counter;
    var body_temp_counter = temp_counter;
    if std::mem::len(explicit_seed_var) > 0 {
        induction_init_var = explicit_seed_var;
    } else {
        let init_node = try find_induction_init_value_node(
            ir_bytes, function_name, induction_var, 0, loop_index, bs
        );
        let init_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, init_node, bs);
        if std::mem::equal_bytes(init_kind, "Call") {
            init_result_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                locals_spec,
                init_node,
                string_counter,
                temp_counter,
                &var init_insts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            body_string_counter = string_counter + try count_strings_in_insts(&init_insts);
            body_temp_counter = temp_counter + init_insts.len();
        } else {
            let resolved_init = try find_induction_init(
                ir_bytes, function_name, induction_var, 0, loop_index, bs
            );
            induction_init = resolved_init.literal;
            induction_init_var = resolved_init.var_name;
            induction_init_offset = resolved_init.offset;
        }
    }
    var cond_insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let cond_result = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        cond_node,
        body_string_counter,
        body_temp_counter,
        &var cond_insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    body_string_counter = body_string_counter + try count_strings_in_insts(&cond_insts);
    body_temp_counter = body_temp_counter + cond_insts.len();
    if std::mem::len(rename_to) > 0 {
        try rename_induction_in_insts(&var cond_insts, induction_var, rename_to);
    }
    // Every body statement lowers; there is no trailing latch assign to strip. The continue-if
    // lowers to a ContinueLatch if, the trailing return to a return statement, and -- for a nested
    // scan -- a '<induction> = <local>' re-seed assign is consumed (it emits no instruction) and
    // its following nested while lowers through a recursive continue-latch call.
    var body_try_counter = loop_index * 1000;
    var body_alias_counter = alias_counter;
    var body_stmts = std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator());
    var body_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
    defer body_aliases.deinit();
    var body_index = 0;
    while body_index < body_count {
        let body_stmt = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, body_node, "statement", body_index, bs
        );
        let body_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, body_stmt, bs);
        if std::mem::equal_bytes(body_kind, "Let") {
            if std::mem::len(rename_to) > 0 {
                let let_advance = try lower_renamed_continue_latch_let(
                    ir_bytes, function_name, module_prefix, locals_spec, body_stmt,
                    induction_var, rename_to, body_string_counter, body_temp_counter,
                    &var body_stmts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_string_counter = let_advance.string_counter;
                body_temp_counter = let_advance.temp_counter;
            } else {
                let let_result = try lower_multi_let_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_try_counter,
                    &var body_aliases,
                    &var body_stmts,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_string_counter = let_result.string_counter;
                body_temp_counter = let_result.temp_counter;
                body_try_counter = let_result.try_counter;
            }
        } else {
            if std::mem::equal_bytes(body_kind, "If") {
                let body_if_index = loop_index * 1000 + body_index + 1;
                let if_result = try lower_multi_if_statement(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    llvm_return_type,
                    locals_spec,
                    body_stmt,
                    body_string_counter,
                    body_temp_counter,
                    body_try_counter,
                    body_alias_counter,
                    body_if_index,
                    &var body_aliases,
                    &var body_stmts,
                    -1,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                body_temp_counter = if_result.temp_counter;
                body_string_counter = if_result.string_counter;
                body_try_counter = if_result.try_counter;
                body_alias_counter = if_result.alias_counter;
                // A renamed nested body lowers its ifs through the shared path without a rename, so
                // an induction reference in the if condition would be an unrenamed phi reference.
                if std::mem::len(rename_to) > 0 {
                    let if_stmt = try body_stmts.at(body_stmts.len() - 1);
                    if try stmt_references_induction(if_stmt, induction_var) {
                        return error("compiled mir: nested continue-latch if references the induction variable");
                    }
                }
            } else {
                if std::mem::equal_bytes(body_kind, "Return") {
                    try body_stmts.append(try lower_multi_return_statement(
                        ir_bytes,
                        function_name,
                        module_prefix,
                        llvm_return_type,
                        locals_spec,
                        body_stmt,
                        body_string_counter,
                        body_temp_counter,
                        &body_aliases,
                        bs,
                        ir_lookup_index, canonical_facts, call_arg_type_cache
                    ));
                    // A renamed nested body lowers its return through the shared path without a
                    // rename, so an induction reference in the return value would be an unrenamed phi
                    // reference. The canonical tail ('return is_line_break(source[<local>])') reads
                    // only the decrement local.
                    if std::mem::len(rename_to) > 0 {
                        let checked_return = try body_stmts.at(body_stmts.len() - 1);
                        if try stmt_references_induction(checked_return, induction_var) {
                            return error("compiled mir: nested continue-latch return references the induction variable");
                        }
                    }
                    // Advance the counters past the loop's terminal return so the result counters
                    // this function returns -- consumed by statements after the while -- never reuse
                    // a temp or string slot the return emitted. The tail must lower to an expression
                    // return ('return is_line_break(source[cursor])'); any other return shape is an
                    // explicit error rather than a silently un-counted lowering (issue 1165 / 1162).
                    let return_stmt = try body_stmts.at(body_stmts.len() - 1);
                    let advance = try continue_latch_return_advance(
                        return_stmt, body_temp_counter, body_string_counter
                    );
                    body_temp_counter = advance.temp_counter;
                    body_string_counter = advance.string_counter;
                } else {
                    if std::mem::equal_bytes(body_kind, "Assign") {
                        // A '<induction> = <local>' re-seed before a nested while: it does not advance
                        // the enclosing continue-latch (whose only back-edge is its continue-if) and
                        // emits no instruction -- it names the seed the following nested loop's phi
                        // reads on its preheader edge. The next body statement must be that while.
                        try validate_continue_latch_reseed(
                            ir_bytes, function_name, body_node, body_count, body_index, induction_var, bs
                        );
                    } else {
                        if std::mem::equal_bytes(body_kind, "While") {
                            // A nested continue-latch scan. It seeds from the immediately preceding
                            // '<induction> = <local>' re-seed assign and renames its induction reads to
                            // a dot-qualified reserved name that no kizu source identifier can spell, so
                            // its loop-head phi never clashes with the enclosing loop's phi or any other
                            // SSA name. One level of nesting is supported; a deeper nest is an explicit
                            // error.
                            if std::mem::len(rename_to) > 0 {
                                return error("compiled mir: nested continue-latch nesting deeper than one level is unsupported");
                            }
                            let seed_var = try continue_latch_nested_seed_var(
                                ir_bytes, function_name, body_node, body_index, induction_var, bs
                            );
                            let inner_loop_index = loop_index * 1000 + body_index + 1;
                            let inner_result = try lower_multi_while_continue_latch(
                                ir_bytes,
                                function_name,
                                module_prefix,
                                llvm_return_type,
                                locals_spec,
                                body_stmt,
                                body_string_counter,
                                body_temp_counter,
                                body_alias_counter,
                                inner_loop_index,
                                seed_var,
                                "nested.loop.induction",
                                &var body_stmts,
                                bs,
                                ir_lookup_index, canonical_facts, call_arg_type_cache
                            );
                            body_string_counter = inner_result.string_counter;
                            body_temp_counter = inner_result.temp_counter;
                            body_alias_counter = inner_result.alias_counter;
                        } else {
                            return error("compiled mir: unsupported continue-latch body statement");
                        }
                    }
                }
            }
        }
        body_index = body_index + 1;
    }
    var induction_field = induction_var;
    if std::mem::len(rename_to) > 0 {
        induction_field = rename_to;
    }
    try stmts.append(compiled_mir::while_stmt(
        loop_index,
        induction_field,
        induction_init,
        induction_init_var,
        induction_init_offset,
        "add",
        step,
        cond_result,
        cond_insts,
        0,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondOperand>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCondTarget>(std::mem::page_allocator()),
        body_stmts,
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        latch_copy_var,
        std::array::Array<compiled_mir::MirSecondaryInduction>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirCarriedScalar>(std::mem::page_allocator()),
        init_insts,
        init_result_id,
        false,
        -1,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        std::array::Array<compiled_mir::MirStmt>(std::mem::page_allocator()),
        false
    ));
    return MultiIfLowerResult {
        temp_counter: body_temp_counter,
        string_counter: body_string_counter,
        try_counter: 0,
        alias_counter: body_alias_counter
    };
}
// lower_renamed_continue_latch_let lowers a nested continue-latch body's 'let <name> = <expr>' with
// the induction variable renamed to rename_to. The inner scan's lets are simple i64 expressions
// (the '<local> = <induction> - <int>' decrement that feeds both the source[<local>] byte load and
// the copy latch); a call / struct / try let would need the rename threaded through its own
// lowering, so it is an explicit error rather than a silently unrenamed reference (issue 1165 /
// 1162).
fn lower_renamed_continue_latch_let(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    statement: i64,
    induction_var: []u8,
    rename_to: []u8,
    string_counter: i64,
    temp_counter: i64,
    stmts: &var std::array::Array<compiled_mir::MirStmt>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !MultiIfLowerResult {
    let let_name_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "name", 0, bs
    );
    let let_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, let_name_node, bs
    );
    let let_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, statement, "value", 0, bs
    );
    let let_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, let_value, bs);
    if std::mem::equal_bytes(let_value_kind, "Call") or
        std::mem::equal_bytes(let_value_kind, "TryExpr") or
        std::mem::equal_bytes(let_value_kind, "StructLiteralExpr") {
        return error("compiled mir: nested continue-latch let must be a simple expression");
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    let result_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        locals_spec,
        let_value,
        string_counter,
        temp_counter,
        &var insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    try rename_induction_in_insts(&var insts, induction_var, rename_to);
    let expr_strings = try count_strings_in_insts(&insts);
    let next_temp = temp_counter + insts.len();
    try stmts.append(compiled_mir::let_expr_stmt(
        let_name, string_counter, result_id, insts
    ));
    return MultiIfLowerResult {
        temp_counter: next_temp,
        string_counter: string_counter + expr_strings,
        try_counter: 0,
        alias_counter: 0
    };
}
// validate_continue_latch_reseed checks a '<induction> = <local>' re-seed assign: its target is the
// induction variable, its value is a plain Var copy, and the next body statement is the nested
// while it seeds. Anything else is an explicit error so a near-miss never silently mis-lowers (issue
// 1165 / 1162).
fn validate_continue_latch_reseed(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_count: i64,
    body_index: i64,
    induction_var: []u8,
    bs: i64
) -> !void {
    let assign_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_index, bs
    );
    let assign_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, assign_stmt, "target", 0, bs
    );
    let assign_target_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, assign_target, bs
    );
    if !std::mem::equal_bytes(assign_target_kind, "Var") {
        return error("compiled mir: continue-latch body assign target must be a var");
    }
    let assign_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, assign_target, bs
    );
    if !std::mem::equal_bytes(assign_target_name, induction_var) {
        return error("compiled mir: continue-latch body assign must target the induction variable");
    }
    if !(try while_assign_is_induction_copy(ir_bytes, function_name, assign_stmt, bs)) {
        return error("compiled mir: continue-latch body assign must copy a local");
    }
    let next_index = body_index + 1;
    if next_index >= body_count {
        return error("compiled mir: continue-latch re-seed assign must precede a nested while");
    }
    let next_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", next_index, bs
    );
    let next_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, next_stmt, bs);
    if !std::mem::equal_bytes(next_kind, "While") {
        return error("compiled mir: continue-latch re-seed assign must precede a nested while");
    }
    return;
}
// continue_latch_nested_seed_var returns the local a nested continue-latch while seeds from: the
// value of the immediately preceding '<induction> = <local>' re-seed assign. The assign was already
// validated when the body loop visited it, so this re-reads its copy source (issue 1165 / 1162).
fn continue_latch_nested_seed_var(
    ir_bytes: []u8,
    function_name: []u8,
    body_node: i64,
    body_index: i64,
    induction_var: []u8,
    bs: i64
) -> ![]u8 {
    if body_index < 1 {
        return error("compiled mir: nested continue-latch while must follow a re-seed assign");
    }
    let seed_stmt = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, body_node, "statement", body_index - 1, bs
    );
    let seed_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, seed_stmt, bs);
    if !std::mem::equal_bytes(seed_kind, "Assign") {
        return error("compiled mir: nested continue-latch while must follow a re-seed assign");
    }
    let seed_target = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "target", 0, bs
    );
    let seed_target_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, seed_target, bs
    );
    if !std::mem::equal_bytes(seed_target_name, induction_var) {
        return error("compiled mir: nested continue-latch re-seed must target the induction variable");
    }
    let seed_value = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, seed_stmt, "value", 0, bs
    );
    let seed_value_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, seed_value, bs);
    if !std::mem::equal_bytes(seed_value_kind, "Var") {
        return error("compiled mir: nested continue-latch re-seed must copy a local");
    }
    return try ir_contract::body_token_or_empty_from(ir_bytes, function_name, seed_value, bs);
}

// lower_while_latch_try_call lowers a loop-carried 'index = try <callee>(.., index);' latch
// update into a LetTryCall statement bound to <induction_var>_next (issue 1165). The bound
// name feeds the loop-head phi on the latch edge, so the success value (field 1) becomes
// %<var>_next and a failure propagates as this function's own error union, exactly like a
// let-position try-call. The callee must be a free function (a field-mode method, e.g.
// tokens.get(..), is rejected here); index_after_leading_imports calling index_after_import
// is its first consumer. try_index is seeded past the body try-calls so the fail/cont block
// labels never collide with a body try-call's.
fn lower_while_latch_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    llvm_return_type: []u8,
    locals_spec: []u8,
    induction_var: []u8,
    try_node: i64,
    string_counter: i64,
    try_index: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    let inner = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, try_node, "value", 0, bs
    );
    let inner_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, inner, bs);
    if !std::mem::equal_bytes(inner_kind, "Call") {
        return error("compiled mir: induction latch try value must wrap a call");
    }
    if try callee_is_field_expr(ir_bytes, function_name, inner, bs) {
        return error("compiled mir: induction latch try-call must be a free function");
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, inner, bs, call_arg_type_cache
    );
    let success_type = try compiled_mir_types::call_info_error_success_llvm(
        ir_lookup_index, canonical_facts, ir_bytes, &call_info
    );
    if !std::mem::equal_bytes(success_type, "i64") {
        return error("compiled mir: induction latch try-call must return an i64");
    }
    let args = try compiled_mir_lower_call::lower_call_args_canonical(
        ir_bytes, function_name, module_prefix, locals_spec, inner, string_counter, bs,
        ir_lookup_index, canonical_facts, &call_info.types,
        call_arg_type_cache
    );
    // The bound name is the induction variable itself; the latch renderer suffixes every SSA
    // name with "_next", so the success value binds to %<induction_var>_next which the
    // loop-head phi consumes on the latch edge (issue 1165).
    return compiled_mir::let_try_call_stmt(
        induction_var, call_info.return_llvm_type, success_type, llvm_return_type,
        call_info.module_prefix, call_info.callee_name, string_counter, try_index,
        std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator()),
        args
    );
}

// latch_call_cursor_type_is_seedable reports whether a token-carried plain-call latch's result type
// can drive the loop-head induction phi. i64 is the historical scalar cursor; a named struct value
// type (e.g. %kizu.kizu.lexer.token, the seven-i64 Token) is the struct cursor, symmetric with the
// call-seeded primary init lowered through lower_expr_into. An error-union result (%kizu.error.*) is
// rejected -- only a try-call latch carries one -- as is any other non-i64, non-named type, so the
// relaxation stays bounded to the cursor types the init seed can produce (issue 1157 PR-P4 follow-up).
fn latch_call_cursor_type_is_seedable(call_type: []u8) -> bool {
    if std::mem::equal_bytes(call_type, "i64") {
        return true;
    }
    if std::mem::starts_with(call_type, "%kizu.error.") {
        return false;
    }
    return std::mem::starts_with(call_type, "%");
}

// lower_while_latch_call lowers a token-carried 'token = synth_next_token(token);' latch
// update into a LetCall statement whose bound name is the induction variable (issue 1157
// PR-P4). The latch renderer suffixes the bind name with "_next", so the call result binds
// to %<induction_var>_next which the loop-head phi consumes on the latch edge. The callee
// must be a free function; an i64 result drives a scalar cursor and a struct value result (a
// named LLVM type) drives a struct cursor, symmetric with the call-seeded init. A field-mode
// method or an unseedable result type (error union / other) is rejected.
fn lower_while_latch_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    induction_var: []u8,
    call_node: i64,
    string_counter: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    if try callee_is_field_expr(ir_bytes, function_name, call_node, bs) {
        return error("compiled mir: token-carried latch call must be a free function");
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    // The latch reseats the cursor from the call's return value, which the loop-head phi reads on
    // the latch edge. An i64 result drives the historical scalar cursor; a struct value result -- a
    // named LLVM type such as %kizu.kizu.lexer.token (the seven-i64 Token) -- drives a struct cursor,
    // the symmetric counterpart of the call-seeded primary init that lower_multi_while_statement
    // lowers through lower_expr_into. Both the init seed and this latch update carry the cursor's
    // declared type (the source's type system guarantees they agree), so the loop-head phi renders
    // that exact type. The relaxation stays bounded to init-side-seedable cursors: an error-union
    // result (%kizu.error.*, which only a try-call latch carries) or any non-i64, non-named type is
    // still rejected (issue 1157 PR-P4 follow-up).
    if !latch_call_cursor_type_is_seedable(call_info.return_llvm_type) {
        return error("compiled mir: token-carried latch call must return an i64 or struct value");
    }
    let args = try compiled_mir_lower_call::lower_call_args_canonical(
        ir_bytes, function_name, module_prefix, locals_spec, call_node, string_counter, bs,
        ir_lookup_index, canonical_facts, &call_info.types,
        call_arg_type_cache
    );
    return compiled_mir::let_call_stmt(
        induction_var, call_info.return_llvm_type, string_counter,
        call_info.module_prefix, call_info.callee_name, args
    );
}

// lower_while_latch_field_access lowers a field-access 'token = declaration.next;' latch into
// a LetExpr statement holding the field access bound to the induction variable (issue 1157
// PR-PF). The latch renderer suffixes the bind name with "_next", so the loaded i64 field
// binds to %<induction_var>_next which the loop-head phi consumes on the latch edge. The
// receiver must be a local var (the loop body's struct binding) and the field must be an i64;
// it carries no control flow, so the phi reads it on the loopN_latch edge like a plain call.
fn lower_while_latch_field_access(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    locals_spec: []u8,
    induction_var: []u8,
    field_expr_node: i64,
    string_counter: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStmt {
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_expr_node, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, receiver, bs);
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: field-access latch receiver must be a local var");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, receiver, bs);
    let info = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index, ir_bytes, function_name, module_prefix, locals_spec,
        field_expr_node, bs, call_arg_type_cache
    );
    if !std::mem::equal_bytes(info.field_llvm_type, "i64") {
        return error("compiled mir: field-access latch field must be an i64");
    }
    var insts = std::array::Array<compiled_mir::MirExprInst>(std::mem::page_allocator());
    try insts.append(compiled_mir::field_access_expr_inst(
        0, info.field_llvm_type, receiver_name, info.receiver_llvm_type, info.field_index
    ));
    return compiled_mir::let_expr_stmt(induction_var, string_counter, 0, insts);
}

fn count_strings_in_insts(
    insts: &std::array::Array<compiled_mir::MirExprInst>
) -> !i64 {
    return try count_strings_in_insts_from(insts, 0);
}
fn count_strings_in_insts_from(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    start: i64
) -> !i64 {
    var count = 0;
    var index = start;
    while index < insts.len() {
        let inst = try insts.at(index);
        count = count + try count_strings_in_inst(inst);
        index = index + 1;
    }
    return count;
}
fn count_strings_in_inst(
    inst: &compiled_mir::MirExprInst
) -> !i64 {
    match inst {
        ConstString(payload) => return 1;,
        Call(payload) => return try compiled_mir_lower_call::count_string_args(&payload.call_args);,
        StructLiteral(payload) => return try count_strings_in_struct_fields(&payload.struct_fields);,
        _ => return 0;,
    }
}
fn count_strings_in_struct_fields(
    fields: &std::array::Array<compiled_mir::MirStructField>
) -> !i64 {
    var count = 0;
    var index = 0;
    while index < fields.len() {
        let field = try fields.at(index);
        if field.kind == compiled_mir::MirStructFieldKind::ConstString {
            count = count + 1;
        }
        if field.kind == compiled_mir::MirStructFieldKind::Call {
            count = count + try compiled_mir_lower_call::count_string_args(&field.call_args);
        }
        if field.kind == compiled_mir::MirStructFieldKind::StructLiteral {
            count = count + try count_strings_in_struct_fields(&field.nested_fields);
        }
        index = index + 1;
    }
    return count;
}
// struct_fields_have_pending_expr reports whether any field of a lowered struct literal -- at any
// nesting depth -- still awaits the general expression path.
fn struct_fields_have_pending_expr(
    fields: &std::array::Array<compiled_mir::MirStructField>
) -> !bool {
    var index = 0;
    while index < fields.len() {
        let field = try fields.at(index);
        if field.kind == compiled_mir::MirStructFieldKind::PendingExpr {
            return true;
        }
        if field.kind == compiled_mir::MirStructFieldKind::StructLiteral {
            if try struct_fields_have_pending_expr(&field.nested_fields) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// resolve_struct_field_exprs turns every PendingExpr field of a lowered struct literal into an Expr
// field: the field's source expression lowers into the enclosing instruction stream, whose
// instructions the renderer emits before the insertvalue chain reaches the field, and the field
// keeps only the instruction id producing its value. A literal with no pending field passes through
// untouched, so the shaped-field lowering stays byte-identical.
fn resolve_struct_field_exprs(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    fields: std::array::Array<compiled_mir::MirStructField>,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !std::array::Array<compiled_mir::MirStructField> {
    var shaped = fields;
    let has_pending = try struct_fields_have_pending_expr(&shaped);
    if has_pending {
        let resolved = try lower_pending_struct_fields(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            &shaped,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        return resolved;
    }
    return shaped;
}

// lower_pending_struct_fields rebuilds one field list with its pending fields resolved. Nested
// literals recurse, so a pending field at any depth resolves against the same instruction stream.
fn lower_pending_struct_fields(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    fields: &std::array::Array<compiled_mir::MirStructField>,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !std::array::Array<compiled_mir::MirStructField> {
    var resolved = std::array::Array<compiled_mir::MirStructField>(
        std::mem::page_allocator()
    );
    var index = 0;
    while index < fields.len() {
        let field = try fields.at(index);
        if field.kind == compiled_mir::MirStructFieldKind::PendingExpr {
            let value_id = try lower_expr_into_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                field.expr_node,
                string_index,
                id_base,
                insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let value_type = try expr_inst_llvm_type_by_id(insts, value_id);
            try resolved.append(compiled_mir::expr_value_struct_field(
                field.index, value_type, value_id
            ));
        } else {
            if field.kind == compiled_mir::MirStructFieldKind::StructLiteral {
                let nested = try lower_pending_struct_fields(
                    ir_bytes,
                    function_name,
                    module_prefix,
                    params_spec,
                    &field.nested_fields,
                    string_index,
                    id_base,
                    insts,
                    aliases,
                    bs,
                    ir_lookup_index, canonical_facts, call_arg_type_cache
                );
                try resolved.append(compiled_mir::struct_literal_struct_field(
                    field.index, field.llvm_type, nested
                ));
            } else {
                try resolved.append(try compiled_mir::copy_struct_field(field));
            }
        }
        index = index + 1;
    }
    return resolved;
}

// expr_inst_llvm_type_by_id returns the LLVM type of the lowered expression instruction whose id is
// result_id, so an assignment lowering can compare its value's type against the reassignment
// target's resolved type (issue 1201). A missing id is an internal inconsistency rather than a
// source-level near-miss, so it surfaces as an explicit error.
fn expr_inst_llvm_type_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> ![]u8 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return compiled_mir::expr_inst_llvm_type(inst);
        }
        index = index + 1;
    }
    return error("compiled mir: assignment value expression result not found");
}

fn expr_inst_try_success_type_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> ![]u8 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return match inst {
                Call(payload) => payload.success_llvm_type,
                _ => "",
            };
        }
        index = index + 1;
    }
    return error("compiled mir: try expression result not found");
}

fn return_try_expr_inst_llvm_type_by_id(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    result_id: i64
) -> ![]u8 {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == result_id {
            return compiled_mir::expr_inst_llvm_type(inst);
        }
        index = index + 1;
    }
    return error("compiled mir: return try expression result not found");
}

// call_has_call_arg reports whether any argument of a Call node is itself a Call.
// Inline call-arg descriptors cannot carry a computed call result, so such calls take
// the nested-argument expression path instead (issue 1165).
fn call_has_call_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
        if std::mem::equal_bytes(arg_kind, "Call") {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// arg_is_single_element_index reports whether a call argument is a single-element byte
// index load 'source[index]' (an IndexExpr whose 'end' bound is Empty), as distinct from a
// two-bound slice 'source[start..end]'. A single-element index has no inline MirCallArg
// descriptor -- the slice descriptor lower_call_index_arg builds assumes a real end bound --
// so such an argument is hoisted into a preceding index-load expr temp and passed by Temp
// reference instead. is_line_break(source[index]) inside line_end_excluding_break's
// short-circuit while header is its first consumer (issue 1165 / 1162).
fn arg_is_single_element_index(
    ir_bytes: []u8,
    function_name: []u8,
    arg_node: i64,
    bs: i64
) -> !bool {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if !std::mem::equal_bytes(arg_kind, "IndexExpr") {
        return false;
    }
    let end_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, arg_node, "end", 0, bs
    );
    let end_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, end_node, bs);
    return std::mem::equal_bytes(end_kind, "Empty");
}

fn arg_is_namespace_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    arg_node: i64,
    bs: i64
) -> !bool {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if !std::mem::equal_bytes(arg_kind, "FieldExpr") {
        return false;
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, arg_node, bs
    );
    return std::mem::equal_bytes(mode, "namespace");
}

// call_arg_for_lowered_expr turns a hoisted argument's lowered result into the call argument that
// reads it. Var, bool, int, and enum-tag instructions render no definition -- every consumer prints
// their value directly -- so naming one as '%t<id>' would reference an SSA value the renderer never
// emits. Those fold back into the matching named or literal argument; any other result is a real
// temp the renderer does define.
fn call_arg_for_lowered_expr(
    insts: &std::array::Array<compiled_mir::MirExprInst>,
    arg_type: []u8,
    temp_id: i64
) -> !compiled_mir::MirCallArg {
    var index = 0;
    while index < insts.len() {
        let inst = try insts.at(index);
        if compiled_mir::expr_inst_id(inst) == temp_id {
            match inst {
                Var(payload) => return compiled_mir::var_call_arg(arg_type, payload.value);,
                ConstBool(payload) => return compiled_mir::bool_call_arg(
                    arg_type, payload.bool_value
                );,
                ConstInt(payload) => return compiled_mir::int_literal_call_arg(
                    arg_type, payload.int_value
                );,
                ConstEnumTag(payload) => return compiled_mir::int_literal_call_arg(
                    arg_type, payload.int_value
                );,
                _ => return compiled_mir::temp_call_arg(arg_type, temp_id);,
            }
        }
        index = index + 1;
    }
    return error("compiled mir: hoisted call argument result not found");
}

fn call_arg_must_hoist(
    ir_bytes: []u8,
    function_name: []u8,
    arg_node: i64,
    bs: i64
) -> !bool {
    let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
    if std::mem::equal_bytes(arg_kind, "Call") {
        return true;
    }
    if std::mem::equal_bytes(arg_kind, "Binary") {
        return true;
    }
    if std::mem::equal_bytes(arg_kind, "CastExpr") {
        return true;
    }
    if std::mem::equal_bytes(arg_kind, "StructLiteralExpr") {
        return true;
    }
    if std::mem::equal_bytes(arg_kind, "TryExpr") {
        return true;
    }
    if try arg_is_namespace_field_expr(ir_bytes, function_name, arg_node, bs) {
        return true;
    }
    return std::mem::equal_bytes(arg_kind, "IndexExpr");
}

fn call_has_try_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        let arg_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, arg_node, bs);
        if std::mem::equal_bytes(arg_kind, "TryExpr") {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// call_has_hoisted_arg reports whether a call carries an argument that has no inline
// MirCallArg descriptor and must be lowered into a preceding expr temp: a nested call, a
// cast, struct literal, a namespace field value (enum tag / payload-less union variant), or
// a single-element byte index load. Each is referenced through a Temp call arg once
// materialized (issue 1165 / 1162 / 1157).
pub fn call_has_hoisted_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, bs) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

pub fn call_has_hoisted_arg_cached(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, cf
    );
    var index = 0;
    while index < arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, cf
        );
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// lower_expr_value_len lowers value-receiver len() calls in expression context.
// Array<T>.len() and std::string::String.len() both read a local/param %kizu.owned handle and
// return i64, but they dispatch to different runtime helpers, so the receiver Kizu type chooses
// the MIR instruction. get() returns !T and remains let-try-only.
fn lower_expr_value_len(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "field", callee_sf
    );
    if !std::mem::equal_bytes(method_name, "len") {
        return error("compiled mir: only value-receiver len is supported in expression position");
    }
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, cf
    );
    if arg_count != 0 {
        return error("compiled mir: value-receiver len takes no arguments");
    }
    let receiver_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, receiver_node, bs);
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: value-receiver len receiver must be a local or parameter");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, receiver_node, receiver_sf
    );
    let receiver_kizu = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, params_spec, receiver_name, bs, call_arg_type_cache
    );
    let lookup = compiled_mir_types::struct_lookup_kizu_type(receiver_kizu);
    if is_array_field_type(lookup) {
        let id = id_base + insts.len();
        try insts.append(compiled_mir::array_len_expr_inst(id, receiver_name));
        return id;
    }
    if is_string_value_type(lookup) {
        let id = id_base + insts.len();
        try insts.append(compiled_mir::string_len_expr_inst(id, receiver_name));
        return id;
    }
    return error("compiled mir: value-receiver len receiver type is unsupported");
}

// append_call_arg_into_exprs is the shared boundary for call arguments that may require
// expression evaluation before the call. Inline Var/literal/string/field descriptors use the
// common single-arg lowerer; nested calls and other computed values use lower_expr_into and
// become MirCallArg::Temp. string_count lets every owner thread one global string namespace.
fn append_call_arg_into_exprs(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    arg_type: []u8,
    arg_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    args: &var std::array::Array<compiled_mir::MirCallArg>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
    if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
        let before = insts.len();
        let temp_id = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, arg_node,
            string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        try args.append(try call_arg_for_lowered_expr(insts, arg_type, temp_id));
        return try count_strings_in_insts_from(insts, before);
    }
    let arg = try compiled_mir_lower_call::lower_single_call_arg_canonical(
        ir_bytes, function_name, module_prefix, params_spec, arg_type,
        arg_node, string_index, bs, ir_lookup_index, canonical_facts,
        call_arg_type_cache
    );
    var string_count = 0;
    if arg.kind == compiled_mir::MirCallArgKind::String {
        string_count = 1;
    } else {
        if arg.kind == compiled_mir::MirCallArgKind::Call {
            string_count = try compiled_mir_lower_call::count_string_args(&arg.call_args);
        }
    }
    try args.append(arg);
    return string_count;
}

// lower_expr_call_with_nested_args lowers a Call whose argument list contains an argument
// with no inline descriptor -- a nested call (equal_bytes(token_text(...), expected)), a
// namespace field value (AstData::Empty), or a single-element byte index load
// (is_line_break(source[index])) (issue 1165 / 1162 / 1157). Each such argument is lowered
// into a preceding expr temp and referenced through a Temp call arg; scalar and
// two-bound-slice arguments use the shared single-arg descriptor. The outer call inst is
// appended once every argument temp is materialized so the temps dominate the call.
fn lower_expr_call_with_nested_args(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    var runtime_arg_nodes =
        try compiled_mir_lower_call::canonical_runtime_arg_nodes(
            ir_bytes, function_name, call_node, bs, ir_lookup_index,
            &call_info.types
        );
    defer runtime_arg_nodes.deinit();
    let arg_count = runtime_arg_nodes.len();
    var arg_types = std::array::Array<[]u8>(std::mem::page_allocator());
    defer arg_types.deinit();
    var type_index = 0;
    while type_index < arg_count {
        let type_id = try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &call_info.types, type_index
        );
        try arg_types.append(
            try compiled_canonical_facts::parsed_canonical_runtime_abi(
                ir_lookup_index, canonical_facts, ir_bytes, type_id
            )
        );
        type_index = type_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let arg_type = try arg_types.get(arg_index);
        let string_count = try append_call_arg_into_exprs(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node,
            string_idx, id_base, insts, &var args, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        string_idx = string_idx + string_count;
        arg_index = arg_index + 1;
    }
    let id = id_base + insts.len();
    try insts.append(compiled_mir::call_expr_inst(
        id, call_info.return_llvm_type,
        call_info.module_prefix, call_info.callee_name, args
    ));
    return id;
}

fn lower_expr_call_with_nested_args_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, call_node, bs, call_arg_type_cache
    );
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var runtime_arg_nodes =
        try compiled_mir_lower_call::canonical_runtime_arg_nodes(
            ir_bytes, function_name, call_node, bs, ir_lookup_index,
            &call_info.types
        );
    defer runtime_arg_nodes.deinit();
    let arg_count = runtime_arg_nodes.len();
    var arg_types = std::array::Array<[]u8>(std::mem::page_allocator());
    defer arg_types.deinit();
    var type_index = 0;
    while type_index < arg_count {
        let type_id = try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &call_info.types, type_index
        );
        try arg_types.append(
            try compiled_canonical_facts::parsed_canonical_runtime_abi(
                ir_lookup_index, canonical_facts, ir_bytes, type_id
            )
        );
        type_index = type_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_type = try arg_types.get(arg_index);
        let hoist_arg = try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf);
        if hoist_arg {
            let before = insts.len();
            let temp_id = try lower_expr_with_local_aliases(
                ir_bytes, function_name, module_prefix, params_spec, arg_node,
                string_idx, id_base, insts, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(insts, before);
            try args.append(try call_arg_for_lowered_expr(insts, arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                arg_type,
                arg_node,
                string_idx,
                &alias_sources,
                &alias_currents,
                bs,
                ir_lookup_index,
                canonical_facts,
                call_arg_type_cache
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    let id = id_base + insts.len();
    try insts.append(compiled_mir::call_expr_inst(
        id, call_info.return_llvm_type,
        call_info.module_prefix, call_info.callee_name, args
    ));
    return id;
}

fn lower_expr_method_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, params_spec, call_node, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, bs, call_arg_type_cache
    );
    var arg_types = try method_call_arg_types(
        ir_bytes, function_name, module_prefix, &info, call_node, explicit_arg_count,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    defer arg_types.deinit();
    var runtime_arg_nodes = try method_runtime_arg_nodes(
        ir_bytes, function_name, call_node, bs, ir_lookup_index,
        canonical_facts, call_arg_type_cache
    );
    defer runtime_arg_nodes.deinit();
    let runtime_arg_count = runtime_arg_nodes.len();
    if arg_types.len() != runtime_arg_count + 1 {
        return error("compiled mir: method runtime argument ABI coverage mismatch");
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(method_receiver_call_arg(&info, info.receiver_name));
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < runtime_arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let arg_abi = try arg_types.at(arg_index + 1);
        let arg_type = arg_abi.semantic_llvm;
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, bs) {
            let before = insts.len();
            let temp_id = try lower_expr_into(
                ir_bytes, function_name, module_prefix, params_spec, arg_node,
                string_idx, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(insts, before);
            try args.append(try call_arg_for_lowered_expr(insts, arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_canonical(
                ir_bytes, function_name, module_prefix, params_spec, arg_type,
                arg_node, string_idx, bs, ir_lookup_index, canonical_facts,
                call_arg_type_cache
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    var normalized_args = try normalize_runtime_method_args(&arg_types, args);
    let id = id_base + insts.len();
    let semantic_result = match info.result_transport {
        Semantic => true,
        _ => false,
    };
    if !semantic_result {
        try insts.append(try compiled_mir::storage_call_expr_inst(
            id, info.return_llvm_type, info.storage_return_llvm_type,
            info.success_llvm_type, info.result_transport,
            info.module_prefix, info.callee_name, normalized_args
        ));
    } else {
        try insts.append(compiled_mir::call_expr_inst(
            id, info.return_llvm_type, info.module_prefix, info.callee_name,
            normalized_args
        ));
    }
    return id;
}

fn lower_expr_method_call_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    // cf tightens this call's own structural facts (its arg edges, per-arg hoist kind checks)
    // to the call node's body-node line via the index; the args sort after it, so a scan from
    // cf reaches the byte-identical facts a scan from bs would. bs is kept for receiver/return
    // type resolution and lowering recursion, which read facts that can precede this node.
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let info = try method_call_info(
        ir_bytes, function_name, module_prefix, params_spec, call_node, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let explicit_arg_count = try compiled_mir_types::count_call_args_cached(
        ir_bytes, function_name, call_node, cf, call_arg_type_cache
    );
    var arg_types = try method_call_arg_types(
        ir_bytes, function_name, module_prefix, &info, call_node, explicit_arg_count,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    defer arg_types.deinit();
    var runtime_arg_nodes = try method_runtime_arg_nodes(
        ir_bytes, function_name, call_node, bs, ir_lookup_index,
        canonical_facts, call_arg_type_cache
    );
    defer runtime_arg_nodes.deinit();
    let runtime_arg_count = runtime_arg_nodes.len();
    if arg_types.len() != runtime_arg_count + 1 {
        return error("compiled mir: method runtime argument ABI coverage mismatch");
    }
    var alias_sources = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_sources.deinit();
    var alias_currents = std::array::Array<[]u8>(std::mem::page_allocator());
    defer alias_currents.deinit();
    var alias_index = 0;
    while alias_index < aliases.len() {
        let state = try aliases.at(alias_index);
        if !std::mem::equal_bytes(state.source_name, state.current_name) {
            try alias_sources.append(state.source_name);
            try alias_currents.append(state.current_name);
        }
        alias_index = alias_index + 1;
    }
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(method_receiver_call_arg(
        &info,
        try local_alias_current_name(aliases, info.receiver_name)
    ));
    var arg_index = 0;
    var string_idx = string_index;
    while arg_index < runtime_arg_count {
        let arg_node = try runtime_arg_nodes.get(arg_index);
        let arg_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, arg_node, bs);
        let arg_abi = try arg_types.at(arg_index + 1);
        let arg_type = arg_abi.semantic_llvm;
        if try call_arg_must_hoist(ir_bytes, function_name, arg_node, arg_sf) {
            let before = insts.len();
            let temp_id = try lower_expr_with_local_aliases(
                ir_bytes, function_name, module_prefix, params_spec, arg_node,
                string_idx, id_base, insts, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            string_idx = string_idx + try count_strings_in_insts_from(insts, before);
            try args.append(try call_arg_for_lowered_expr(insts, arg_type, temp_id));
        } else {
            let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg_canonical_with_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                arg_type,
                arg_node,
                string_idx,
                &alias_sources,
                &alias_currents,
                bs,
                ir_lookup_index,
                canonical_facts,
                call_arg_type_cache
            );
            let is_string_arg = scalar_arg.kind == compiled_mir::MirCallArgKind::String;
            try args.append(scalar_arg);
            if is_string_arg {
                string_idx = string_idx + 1;
            }
        }
        arg_index = arg_index + 1;
    }
    var normalized_args = try normalize_runtime_method_args(&arg_types, args);
    let id = id_base + insts.len();
    let semantic_result = match info.result_transport {
        Semantic => true,
        _ => false,
    };
    if !semantic_result {
        try insts.append(try compiled_mir::storage_call_expr_inst(
            id, info.return_llvm_type, info.storage_return_llvm_type,
            info.success_llvm_type, info.result_transport,
            info.module_prefix, info.callee_name, normalized_args
        ));
    } else {
        try insts.append(compiled_mir::call_expr_inst(
            id, info.return_llvm_type, info.module_prefix, info.callee_name,
            normalized_args
        ));
    }
    return id;
}

fn lower_expr_call_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let id = id_base + insts.len();
    // The call-shape probes below use the per-function node-line cache for this call's own
    // structural facts; type resolution and lowering recursion keep bs because they read
    // let/param facts that can precede this node.
    let callee_mode = try call_callee_field_expr_mode_cached(
        ir_bytes, function_name, expr_node, bs, call_arg_type_cache
    );
    if callee_mode == 1 {
        return try lower_expr_method_call_with_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, expr_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    if callee_mode == 2 {
        if try callee_is_namespace_union_ctor_cached(
            ir_bytes, function_name, module_prefix, expr_node, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        ) {
            return try lower_expr_union_ctor_call(
                ir_bytes, function_name, module_prefix, params_spec, expr_node,
                string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
    }
    if try call_has_hoisted_arg_cached(
        ir_bytes, function_name, expr_node, bs, call_arg_type_cache
    ) {
        return try lower_expr_call_with_nested_args_with_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, expr_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, expr_node, bs, call_arg_type_cache
    );
    let args = try lower_call_args_with_local_aliases_cached(
        ir_bytes, function_name, module_prefix, params_spec, expr_node, string_index, aliases, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    try insts.append(compiled_mir::call_expr_inst(
        id,
        call_info.return_llvm_type,
        call_info.module_prefix,
        call_info.callee_name,
        args
    ));
    return id;
}

fn lower_expr_into_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    // nf tightens the body-fact scan for this node's own structural facts (its kind, child
    // edges, detail token/int/op) to its body-node line via the index instead of rescanning
    // from the function body start. This node's children sort after it, so a scan from nf
    // reaches the byte-identical facts a scan from bs would (perf only). bs is kept for
    // type/name resolution and lowering recursion, which read facts that can precede this node.
    let nf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, expr_node, bs);
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr_node, nf);
    let id = id_base + insts.len();
    if std::mem::equal_bytes(kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            nf
        );
        let var_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, params_spec, var_name, bs, call_arg_type_cache
        );
        try insts.append(compiled_mir::var_expr_inst(
            id, var_type, try local_alias_current_name(aliases, var_name)
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            nf
        );
        try insts.append(compiled_mir::bool_expr_inst(
            id,
            std::mem::equal_bytes(token, "true")
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Int") {
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes,
            function_name,
            expr_node,
            nf
        );
        try insts.append(compiled_mir::int_expr_inst(id, int_value));
        return id;
    }
    if std::mem::equal_bytes(kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            nf
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid expression string token"
        );
        try insts.append(compiled_mir::string_expr_inst(
            id,
            token,
            string_index
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Prefix") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, expr_node, nf
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, nf
        );
        if std::mem::equal_bytes(op, "neg") {
            let right_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, right_node, nf
            );
            if !std::mem::equal_bytes(right_kind, "Int") {
                return error("compiled mir: unsupported neg operand");
            }
            let int_value = try ir_contract::body_int_value_from(
                ir_bytes, function_name, right_node, nf
            );
            try insts.append(compiled_mir::int_expr_inst(id, 0 - int_value));
            return id;
        }
        if std::mem::equal_bytes(op, "borrow") or
            std::mem::equal_bytes(op, "mut-borrow") {
            return lower_expr_into_local_aliases(
                ir_bytes, function_name, module_prefix, params_spec, right_node,
                string_index, id_base, insts, aliases, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        if !std::mem::equal_bytes(op, "not") {
            var message = std::string::String(std::mem::page_allocator());
            try message.append_bytes("compiled mir: unsupported prefix op: ");
            try message.append_bytes(function_name);
            try message.append_bytes(" node ");
            try std::fmt::append_i64(&var message, expr_node);
            try message.append_bytes(" op ");
            try message.append_bytes(op);
            let message_bytes = message.as_bytes();
            return error(message_bytes);
        }
        let operand = try lower_expr_into_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            right_node,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::prefix_not_expr_inst(result_id, operand));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, expr_node, nf
        );
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "left", 0, nf
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, nf
        );
        let before_left = insts.len();
        let left = try lower_expr_into_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, left_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let right_string_index = string_index + try count_strings_in_insts_from(insts, before_left);
        let right = try lower_expr_into_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, right_node,
            right_string_index, id_base, insts, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        // An arithmetic result carries the operands' width, so read it off the lowered left
        // operand rather than assuming the i64 that most of them happen to be.
        let left_llvm = try expr_inst_llvm_type_by_id(insts, left);
        let result_id = id_base + insts.len();
        let binary_inst = try compiled_mir::binary_expr_inst(
            result_id, op, left, right, left_llvm
        );
        try insts.append(binary_inst);
        return result_id;
    }
    if std::mem::equal_bytes(kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "type", 0, nf
        );
        let type_text = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, nf
        );
        let target_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, module_prefix, type_text
        );
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, nf
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value_node, nf
        );
        if std::mem::equal_bytes(value_kind, "Int") {
            let int_value = try ir_contract::body_int_value_from(
                ir_bytes, function_name, value_node, nf
            );
            try insts.append(compiled_mir::typed_int_expr_inst(id, int_value, target_llvm));
            return id;
        }
        // A non-literal integer operand ('cast<u8>(48 + value)') lowers the operand
        // into a preceding temp, then casts that result to the target integer width
        // (trunc/sext/copy in the renderer).
        let operand_id = try lower_expr_into_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, value_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let source_llvm = try expr_inst_llvm_type_by_id(insts, operand_id);
        let cast_id = id_base + insts.len();
        try insts.append(compiled_mir::int_cast_expr_inst(
            cast_id, operand_id, source_llvm, target_llvm
        ));
        return cast_id;
    }
    if std::mem::equal_bytes(kind, "FieldExpr") {
        return try lower_expr_field_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            expr_node,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(kind, "IndexExpr") {
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "end", 0, nf
        );
        let end_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, end_node, nf
        );
        let target_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "target", 0, nf
        );
        let index_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "start", 0, nf
        );
        if !std::mem::equal_bytes(end_kind, "Empty") {
            let target_id = try lower_expr_into_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                target_node,
                string_index,
                id_base,
                insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let start_id = try lower_expr_into_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                index_node,
                string_index,
                id_base,
                insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let end_id = try lower_expr_into_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                end_node,
                string_index,
                id_base,
                insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let result_id = id_base + insts.len();
            try insts.append(compiled_mir::slice_expr_inst(
                result_id, target_id, start_id, end_id
            ));
            return result_id;
        }
        let target_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, target_node, nf
        );
        if !std::mem::equal_bytes(target_kind, "Var") {
            return error("compiled mir: index target must be a var");
        }
        let target_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, target_node, nf
        );
        let index_id = try lower_expr_into_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            index_node,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::index_load_expr_inst(
            result_id,
            try local_alias_current_name(aliases, target_name),
            index_id
        ));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "StructLiteralExpr") {
        let struct_type = try compiled_signature::resolve_struct_literal_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, expr_node, bs
        );
        // A struct whose ABI is a fixed runtime representation wraps that representation instead of
        // declaring an aggregate, so the literal's value is the wrapped field's value.
        if compiled_mir_lower_struct::struct_literal_is_transparent(struct_type) {
            let wrapped = try compiled_mir_lower_struct::transparent_struct_literal_value(
                ir_bytes, function_name, expr_node, bs
            );
            return try lower_expr_into_local_aliases(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                wrapped,
                string_index,
                id_base,
                insts,
                aliases,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        let shaped_fields = try compiled_mir_lower_struct::lower_struct_fields(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        // Field values the shapes cannot represent lower into this same stream first, so their
        // instructions render ahead of the struct literal's insertvalue chain and the fields can
        // reference the produced ids.
        let fields = try resolve_struct_field_exprs(
            ir_bytes, function_name, module_prefix, params_spec, shaped_fields,
            string_index, id_base, insts, aliases, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let struct_id = id_base + insts.len();
        try insts.append(compiled_mir::struct_literal_expr_inst(
            struct_id, struct_type, fields
        ));
        return struct_id;
    }
    if std::mem::equal_bytes(kind, "Call") {
        return try lower_expr_call_with_local_aliases(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            expr_node,
            string_index,
            id_base,
            insts,
            aliases,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    // A 'try <expr>' in value/sub-expression position lowers its inner child generically
    // through the same expr path (no inner-kind dispatch), reads the inner's produced
    // error-union LLVM type, and emits a TryUnwrap that unwraps the success value or
    // propagates the failure through this function's own error union (issue 1157 big-bang).
    if std::mem::equal_bytes(kind, "TryExpr") {
        let inner_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, nf
        );
        let operand = try lower_expr_into_local_aliases(
            ir_bytes, function_name, module_prefix, params_spec, inner_node,
            string_index, id_base, insts, aliases, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let called_error_union = try expr_inst_llvm_type_by_id(insts, operand);
        var success_type = try expr_inst_try_success_type_by_id(insts, operand);
        if std::mem::len(success_type) == 0 {
            success_type = try try_call_success_type(
                ir_bytes, function_name, module_prefix, inner_node, bs,
                ir_lookup_index
            );
        }
        let own_error_union = try compiled_signature::derive_return_type_indexed(
            ir_lookup_index, ir_bytes, function_name
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::try_unwrap_expr_inst(
            result_id, success_type, operand, called_error_union, own_error_union
        ));
        return result_id;
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled mir: unsupported expression kind: ");
    try message.append_bytes(function_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, expr_node);
    try message.append_bytes(" kind ");
    try message.append_bytes(kind);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

fn lower_expr_into(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, expr_node, bs);
    let id = id_base + insts.len();
    if std::mem::equal_bytes(kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        let var_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, params_spec, var_name, bs, call_arg_type_cache
        );
        try insts.append(compiled_mir::var_expr_inst(id, var_type, var_name));
        return id;
    }
    if std::mem::equal_bytes(kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        try insts.append(compiled_mir::bool_expr_inst(
            id,
            std::mem::equal_bytes(token, "true")
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Int") {
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        try insts.append(compiled_mir::int_expr_inst(id, int_value));
        return id;
    }
    if std::mem::equal_bytes(kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            expr_node,
            bs
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid expression string token"
        );
        try insts.append(compiled_mir::string_expr_inst(
            id,
            token,
            string_index
        ));
        return id;
    }
    if std::mem::equal_bytes(kind, "Prefix") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, expr_node, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, bs
        );
        if std::mem::equal_bytes(op, "neg") {
            let right_kind = try ir_contract::body_node_kind_from(
                ir_bytes, function_name, right_node, bs
            );
            if !std::mem::equal_bytes(right_kind, "Int") {
                return error("compiled mir: unsupported neg operand");
            }
            let int_value = try ir_contract::body_int_value_from(
                ir_bytes, function_name, right_node, bs
            );
            try insts.append(compiled_mir::int_expr_inst(id, 0 - int_value));
            return id;
        }
        if std::mem::equal_bytes(op, "borrow") or
            std::mem::equal_bytes(op, "mut-borrow") {
            return lower_expr_into(
                ir_bytes, function_name, module_prefix, params_spec, right_node,
                string_index, id_base, insts, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        if !std::mem::equal_bytes(op, "not") {
            var message = std::string::String(std::mem::page_allocator());
            try message.append_bytes("compiled mir: unsupported prefix op: ");
            try message.append_bytes(function_name);
            try message.append_bytes(" node ");
            try std::fmt::append_i64(&var message, expr_node);
            try message.append_bytes(" op ");
            try message.append_bytes(op);
            let message_bytes = message.as_bytes();
            return error(message_bytes);
        }
        let operand = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            right_node,
            string_index,
            id_base,
            insts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::prefix_not_expr_inst(result_id, operand));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "Binary") {
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-binary ", function_name, expr_node, bs
        );
        let left_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "left", 0, bs
        );
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "right", 0, bs
        );
        let before_left = insts.len();
        let left = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, left_node,
            string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let right_string_index = string_index + try count_strings_in_insts_from(insts, before_left);
        let right = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, right_node,
            right_string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        // An arithmetic result carries the operands' width, so read it off the lowered left
        // operand rather than assuming the i64 that most of them happen to be.
        let left_llvm = try expr_inst_llvm_type_by_id(insts, left);
        let result_id = id_base + insts.len();
        let binary_inst = try compiled_mir::binary_expr_inst(
            result_id, op, left, right, left_llvm
        );
        try insts.append(binary_inst);
        return result_id;
    }
    if std::mem::equal_bytes(kind, "CastExpr") {
        let type_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "type", 0, bs
        );
        let type_text = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, type_node, bs
        );
        let target_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, module_prefix, type_text
        );
        let value_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, bs
        );
        let value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, value_node, bs
        );
        if std::mem::equal_bytes(value_kind, "Int") {
            let int_value = try ir_contract::body_int_value_from(
                ir_bytes, function_name, value_node, bs
            );
            try insts.append(compiled_mir::typed_int_expr_inst(id, int_value, target_llvm));
            return id;
        }
        // A non-literal integer operand ('cast<u8>(48 + value)') lowers the operand into a
        // preceding temp, then casts that result to the target integer width (trunc/sext/copy
        // in the renderer), matching the local-alias expression path.
        let operand_id = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, value_node,
            string_index, id_base, insts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let source_llvm = try expr_inst_llvm_type_by_id(insts, operand_id);
        let cast_id = id_base + insts.len();
        try insts.append(compiled_mir::int_cast_expr_inst(
            cast_id, operand_id, source_llvm, target_llvm
        ));
        return cast_id;
    }
    if std::mem::equal_bytes(kind, "FieldExpr") {
        return try lower_expr_field(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            expr_node,
            id_base,
            insts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(kind, "IndexExpr") {
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "end", 0, bs
        );
        let end_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, end_node, bs
        );
        let target_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "target", 0, bs
        );
        let index_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "start", 0, bs
        );
        if !std::mem::equal_bytes(end_kind, "Empty") {
            let target_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                target_node,
                string_index,
                id_base,
                insts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let start_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                index_node,
                string_index,
                id_base,
                insts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let end_id = try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                end_node,
                string_index,
                id_base,
                insts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
            let result_id = id_base + insts.len();
            try insts.append(compiled_mir::slice_expr_inst(
                result_id, target_id, start_id, end_id
            ));
            return result_id;
        }
        let target_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, target_node, bs
        );
        if !std::mem::equal_bytes(target_kind, "Var") {
            return error("compiled mir: index target must be a var");
        }
        let target_name = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, target_node, bs
        );
        let index_id = try lower_expr_into(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            index_node,
            string_index,
            id_base,
            insts,
            bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::index_load_expr_inst(
            result_id, target_name, index_id
        ));
        return result_id;
    }
    if std::mem::equal_bytes(kind, "StructLiteralExpr") {
        // A struct-literal expression uses the same field descriptor lowering as
        // statement-level struct literals, then materializes the aggregate as an
        // expression value. This covers multi-field tagged-union payload structs such
        // as VarNode { name, doc } without naming the payload type here (issue 1157 C2).
        let struct_type = try compiled_signature::resolve_struct_literal_type_indexed(
            ir_lookup_index,
            ir_bytes, function_name, module_prefix, expr_node, bs
        );
        // A struct whose ABI is a fixed runtime representation wraps that representation instead of
        // declaring an aggregate, so the literal's value is the wrapped field's value.
        if compiled_mir_lower_struct::struct_literal_is_transparent(struct_type) {
            let wrapped = try compiled_mir_lower_struct::transparent_struct_literal_value(
                ir_bytes, function_name, expr_node, bs
            );
            return try lower_expr_into(
                ir_bytes,
                function_name,
                module_prefix,
                params_spec,
                wrapped,
                string_index,
                id_base,
                insts,
                bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        let shaped_fields = try compiled_mir_lower_struct::lower_struct_fields(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        // Field values outside the shaped set lower into this stream first; this path binds no
        // local aliases, so the resolver renames nothing.
        var no_aliases = std::array::Array<LocalAliasState>(std::mem::page_allocator());
        defer no_aliases.deinit();
        let fields = try resolve_struct_field_exprs(
            ir_bytes, function_name, module_prefix, params_spec, shaped_fields,
            string_index, id_base, insts, &no_aliases, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let struct_id = id_base + insts.len();
        try insts.append(compiled_mir::struct_literal_expr_inst(
            struct_id, struct_type, fields
        ));
        return struct_id;
    }
    if std::mem::equal_bytes(kind, "Call") {
        // A field-mode len() call on a value receiver reads a supported %kizu.owned
        // param/local (Array<T> or std::string::String) through its matching runtime helper.
        // get() returns !T and only appears in let-try position, so it is rejected here.
        let callee_mode = try call_callee_field_expr_mode_cached(
            ir_bytes, function_name, expr_node, bs, call_arg_type_cache
        );
        if callee_mode == 1 {
            return try lower_expr_method_call(
                ir_bytes, function_name, module_prefix, params_spec, expr_node,
                string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        // A namespaced FieldExpr callee whose receiver names a tagged-union type is a
        // single-payload union constructor (Union::Variant(payload), issue 1157 PR-P2).
        // Field-mode callees (.len()) were handled above; enum and free/namespaced function
        // calls fall through to the regular call path below.
        if callee_mode == 2 {
            if try callee_is_namespace_union_ctor_cached(
                ir_bytes, function_name, module_prefix, expr_node, bs,
                ir_lookup_index, canonical_facts, call_arg_type_cache
            ) {
                return try lower_expr_union_ctor_call(
                    ir_bytes, function_name, module_prefix, params_spec, expr_node,
                    string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
                );
            }
        }
        // A call whose argument list contains a nested call (equal_bytes(token_text(...),
        // expected)) or a single-element byte index load (is_line_break(source[index])) lowers
        // each such argument into a preceding expr temp and references it through a Temp call
        // arg, since inline call-arg descriptors cannot carry a computed call result or a
        // checked byte load (issue 1165 / 1162).
        if try call_has_hoisted_arg_cached(
            ir_bytes, function_name, expr_node, bs, call_arg_type_cache
        ) {
            return try lower_expr_call_with_nested_args(
                ir_bytes, function_name, module_prefix, params_spec, expr_node,
                string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
            );
        }
        let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
            ir_lookup_index, canonical_facts, ir_bytes,
            function_name, module_prefix, expr_node, bs, call_arg_type_cache
        );
        let args = try compiled_mir_lower_call::lower_call_args_canonical(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, string_index, bs,
            ir_lookup_index, canonical_facts, &call_info.types,
            call_arg_type_cache
        );
        try insts.append(compiled_mir::call_expr_inst(
            id,
            call_info.return_llvm_type,
            call_info.module_prefix,
            call_info.callee_name,
            args
        ));
        return id;
    }
    // A 'try <expr>' in value/sub-expression position lowers its inner child generically
    // through the same expr path (no inner-kind dispatch), reads the inner's produced
    // error-union LLVM type, and emits a TryUnwrap that unwraps the success value or
    // propagates the failure through this function's own error union (issue 1157 big-bang).
    if std::mem::equal_bytes(kind, "TryExpr") {
        let inner_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, expr_node, "value", 0, bs
        );
        let operand = try lower_expr_into(
            ir_bytes, function_name, module_prefix, params_spec, inner_node,
            string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
        );
        let called_error_union = try expr_inst_llvm_type_by_id(insts, operand);
        var success_type = try expr_inst_try_success_type_by_id(insts, operand);
        if std::mem::len(success_type) == 0 {
            success_type = try try_call_success_type(
                ir_bytes, function_name, module_prefix, inner_node, bs,
                ir_lookup_index
            );
        }
        let own_error_union = try compiled_signature::derive_return_type_indexed(
            ir_lookup_index, ir_bytes, function_name
        );
        let result_id = id_base + insts.len();
        try insts.append(compiled_mir::try_unwrap_expr_inst(
            result_id, success_type, operand, called_error_union, own_error_union
        ));
        return result_id;
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled mir: unsupported expression kind: ");
    try message.append_bytes(function_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, expr_node);
    try message.append_bytes(" kind ");
    try message.append_bytes(kind);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

fn append_namespace_expression_name(
    out: &var std::string::String,
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    node_id: i64,
    bs: i64
) -> !void {
    let nf = ir_index::body_node_line_start_for_sequence(
        ir_lookup_index, ir_bytes, function_name, node_id, bs
    );
    let kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, node_id, nf
    );
    if std::mem::equal_bytes(kind, "Var") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes, function_name, node_id, nf
        );
        if std::mem::len(token) == 0 {
            return error("compiled mir: namespace root token missing");
        }
        try out.append_bytes(token);
        return;
    }
    if !std::mem::equal_bytes(kind, "FieldExpr") {
        return error("compiled mir: namespace receiver must be a qualified name");
    }
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, node_id, nf
    );
    if !std::mem::equal_bytes(mode, "namespace") {
        return error("compiled mir: namespace receiver contains a value field");
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, node_id, "receiver", 0, nf
    );
    try append_namespace_expression_name(
        out, ir_lookup_index, ir_bytes, function_name, receiver, bs
    );
    try out.append_bytes("::");
    try out.append_bytes(try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, node_id, "namespace", nf
    ));
    return;
}

fn namespace_expression_name(
    ir_lookup_index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    node_id: i64,
    bs: i64,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> ![]u8 {
    var spelling = std::string::String(std::mem::page_allocator());
    errdefer spelling.deinit();
    try append_namespace_expression_name(
        &var spelling,
        ir_lookup_index,
        ir_bytes,
        function_name,
        node_id,
        bs
    );
    return call_arg_type_cache.name_store.own(spelling);
}

// callee_is_namespace_union_ctor reports whether a Call's callee is a namespace-mode
// FieldExpr (Union::Variant) whose receiver names a tagged-union type, i.e. a union
// constructor. It is non-erroring on a non-union receiver so enum/function namespaced
// calls fall through to the regular call path (issue 1157 PR-P2).
fn callee_is_namespace_union_ctor_cached(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    call_node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !bool {
    let cf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, call_node, bs);
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, cf
    );
    let callee_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, callee_node, bs);
    let callee_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(callee_kind, "FieldExpr") {
        return false;
    }
    let callee_mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, callee_node, callee_sf
    );
    if !std::mem::equal_bytes(callee_mode, "namespace") {
        return false;
    }
    let target = try compiled_type_resolver::call_target_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if target.found { return false; }
    let builtin = try compiled_type_resolver::call_builtin_indexed(
        ir_lookup_index, ir_bytes, function_name, call_node
    );
    if builtin.found {
        return builtin_contract::kind_from_name(builtin.kind) ==
                builtin_contract::kind_external_shape() and
            builtin_contract::operation_from_name(builtin.operation) ==
                builtin_contract::operation_union_construct();
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, callee_sf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, receiver, bs);
    let receiver_name = try namespace_expression_name(
        ir_lookup_index,
        ir_bytes,
        function_name,
        receiver,
        receiver_sf,
        call_arg_type_cache
    );
    let receiver_type = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, receiver_name
    );
    return try compiled_fact_lookup::is_union_type_indexed(
        ir_lookup_index,
        ir_bytes,
        ir_bytes[0..0],
        receiver_type.canonical_identity
    );
}

// lower_expr_union_ctor_call lowers Union::Variant(payload) into a UnionConstruct that
// stores the discriminant + the single lowered payload value into the union byte buffer
// (issue 1157 PR-P2). The payload's LLVM type comes from the variant fact's payload_kizu,
// so it matches the read side's gep-field-1 + load layout.
fn lower_expr_union_ctor_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    call_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let callee_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "callee", 0, bs
    );
    let variant_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee_node, "namespace", bs
    );
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee_node, "receiver", 0, bs
    );
    let receiver_name = try namespace_expression_name(
        ir_lookup_index,
        ir_bytes,
        function_name,
        receiver,
        bs,
        call_arg_type_cache
    );
    let receiver_type = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, receiver_name
    );
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    if arg_count != 1 {
        return error("compiled mir: union constructor takes one payload argument");
    }
    let arg_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, call_node, "arg", 0, bs
    );
    let payload_value = try lower_expr_into(
        ir_bytes, function_name, module_prefix, params_spec, arg_node,
        string_index, id_base, insts, bs, ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let union_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, ir_bytes[0..0], receiver_type.canonical_identity
    );
    let variant = try compiled_fact_lookup::lookup_union_variant_by_prefix_indexed(
        ir_lookup_index,
        ir_bytes,
        ir_bytes[0..0],
        receiver_type.canonical_identity,
        variant_name
    );
    let payload_type = try compiled_type_lower::kizu_type_to_llvm_indexed(
        ir_lookup_index,
        ir_bytes, variant.declaring_module, variant.payload_kizu
    );
    let id = id_base + insts.len();
    try insts.append(compiled_mir::union_construct_payload_expr_inst(
        id, union_llvm, variant.tag, payload_value, payload_type
    ));
    return id;
}

fn lower_expr_field(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    let nf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, expr_node, bs);
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, nf
    );
    if std::mem::equal_bytes(mode, "namespace") {
        let id = id_base + insts.len();
        let variant_name = try ir_contract::body_field_expr_name_from(
            ir_bytes,
            function_name,
            expr_node,
            "namespace",
            nf
        );
        let receiver = try ir_contract::body_child_sequence_from(
            ir_bytes,
            function_name,
            expr_node,
            "receiver",
            0,
            nf
        );
        let receiver_sf = compiled_mir_types::fn_node_line_start(
            call_arg_type_cache, receiver, bs
        );
        let receiver_name = try namespace_expression_name(
            ir_lookup_index,
            ir_bytes,
            function_name,
            receiver,
            receiver_sf,
            call_arg_type_cache
        );
        let receiver_type = try compiled_type_resolver::resolve_type_indexed(
            ir_lookup_index, ir_bytes, module_prefix, receiver_name
        );
        if compiled_fact_lookup::is_enum_type_indexed(
            ir_lookup_index,
            ir_bytes,
            ir_bytes[0..0],
            receiver_type.canonical_identity
        ) {
            let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix_indexed(
                ir_lookup_index,
                ir_bytes,
                ir_bytes[0..0],
                receiver_type.canonical_identity,
                variant_name
            );
            try insts.append(compiled_mir::enum_tag_expr_inst(id, tag));
            return id;
        }
        // A payload-less tagged-union variant reference builds the union aggregate value, not a bare
        // enum tag (issue 1157 PR-P1, tag-only first form). Resolve the union's LLVM aggregate
        // type and the variant discriminant, then materialize it through a UnionConstruct
        // temp. A variant carrying a payload arrives as a Call (handled in lower_expr_into),
        // never through this bare-FieldExpr path.
        let union_llvm = try compiled_type_lower::kizu_type_to_llvm_indexed(
            ir_lookup_index,
            ir_bytes, ir_bytes[0..0], receiver_type.canonical_identity
        );
        let variant = try compiled_fact_lookup::lookup_union_variant_by_prefix_indexed(
            ir_lookup_index,
            ir_bytes,
            ir_bytes[0..0],
            receiver_type.canonical_identity,
            variant_name
        );
        try insts.append(compiled_mir::union_construct_expr_inst(
            id, union_llvm, variant.tag
        ));
        return id;
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, nf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, receiver_sf
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            receiver,
            receiver_sf
        );
        let field = try compiled_mir_types::resolve_var_receiver_field_expr_indexed_cached(
            ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
            expr_node, nf, receiver_name, bs, call_arg_type_cache
        );
        let id = id_base + insts.len();
        try insts.append(compiled_mir::field_access_expr_inst(
            id,
            field.field_llvm_type,
            receiver_name,
            field.receiver_llvm_type,
            field.field_index
        ));
        return id;
    }
    if !std::mem::equal_bytes(receiver_kind, "FieldExpr") and
        !std::mem::equal_bytes(receiver_kind, "Call") {
        return error("compiled mir: unsupported field expr receiver");
    }
    let receiver_id = try lower_expr_into(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        receiver,
        0,
        id_base,
        insts,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs,
        call_arg_type_cache
    );
    let id = id_base + insts.len();
    try insts.append(compiled_mir::field_access_temp_expr_inst(
        id,
        field.field_llvm_type,
        receiver_id,
        field.receiver_llvm_type,
        field.field_index
    ));
    return id;
}

fn lower_expr_field_with_local_aliases(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    expr_node: i64,
    string_index: i64,
    id_base: i64,
    insts: &var std::array::Array<compiled_mir::MirExprInst>,
    aliases: &std::array::Array<LocalAliasState>,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !i64 {
    // nf tightens this field expression's own structural facts (its field-expr mode, receiver
    // edge, receiver kind/token) to its body-node line via the index; the receiver sorts after
    // it, so a scan from nf reaches the byte-identical facts a scan from bs would. bs is kept
    // for the delegated namespace path, field-type resolution, and lowering recursion.
    let nf = compiled_mir_types::fn_node_line_start(call_arg_type_cache, expr_node, bs);
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes, "body-field-expr ", function_name, expr_node, nf
    );
    if std::mem::equal_bytes(mode, "namespace") {
        return try lower_expr_field(
            ir_bytes, function_name, module_prefix, params_spec, expr_node, id_base, insts, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, expr_node, "receiver", 0, nf
    );
    let receiver_sf = compiled_mir_types::fn_node_line_start(
        call_arg_type_cache, receiver, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, receiver_sf
    );
    if std::mem::equal_bytes(receiver_kind, "Var") {
        let receiver_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            receiver,
            receiver_sf
        );
        let field = try compiled_mir_types::resolve_var_receiver_field_expr_indexed_cached(
            ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
            expr_node, nf, receiver_name, bs, call_arg_type_cache
        );
        let id = id_base + insts.len();
        try insts.append(compiled_mir::field_access_expr_inst(
            id,
            field.field_llvm_type,
            try local_alias_current_name(aliases, receiver_name),
            field.receiver_llvm_type,
            field.field_index
        ));
        return id;
    }
    if !std::mem::equal_bytes(receiver_kind, "FieldExpr") and
        !std::mem::equal_bytes(receiver_kind, "Call") {
        return error("compiled mir: unsupported field expr receiver");
    }
    let receiver_id = try lower_expr_into_local_aliases(
        ir_bytes,
        function_name,
        module_prefix,
        params_spec,
        receiver,
        string_index,
        id_base,
        insts,
        aliases,
        bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index,
        ir_bytes, function_name, module_prefix, params_spec, expr_node, bs,
        call_arg_type_cache
    );
    let id = id_base + insts.len();
    try insts.append(compiled_mir::field_access_temp_expr_inst(
        id,
        field.field_llvm_type,
        receiver_id,
        field.receiver_llvm_type,
        field.field_index
    ));
    return id;
}

// unsupported_lowering_shape reports a statement the MIR lowering has no shape for,
// naming the function and node it sits in. The backend recognises an enumerated set of
// statement shapes rather than a general IR, so this message is what a source written
// outside that set hits; without the location every occurrence costs a native rebuild
// to find.
pub fn unsupported_lowering_shape(
    shape: []u8,
    function_name: []u8,
    node: i64
) -> !MultiIfLowerResult {
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled mir: ");
    try message.append_bytes(shape);
    try message.append_bytes(" not yet supported: ");
    try message.append_bytes(function_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, node);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}
