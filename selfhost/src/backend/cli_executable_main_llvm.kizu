import selfhost::backend::cli_executable_parser_token_llvm;

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_cli_find_next_char_token_function(out);
    try append_cli_skip_braced_body_function(out, ir_bytes);
    try append_cli_main_name_end_function(out, ir_bytes);
    try append_cli_run_main_body_start_function(out, ir_bytes);
    try append_cli_run_void_main_body_start_function(out, ir_bytes);
    try append_cli_test_block_body_start_function(out, ir_bytes);
    try append_cli_test_main_body_start_function(out, ir_bytes);
    try append_cli_test_void_main_body_start_function(out, ir_bytes);
    return;
}

fn append_cli_find_next_char_token_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_find_next_char_token(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i8 %want");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %scan = phi i64 [ %start, %entry ], [ %token_end, %continue ]");
    try append_line(out,
        "  %index = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load_token, label %not_found");
    try append_line(out, "load_token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out,
        "  %matches = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %index, i64 %token_end, i8 %want)");
    try append_line(out, "  br i1 %matches, label %found, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  br label %loop");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %index");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_skip_braced_body_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    let lbrace = try cli_executable_parser_token_llvm::token_byte_value(
        ir_bytes,
        "syntax-lbrace"
    );
    let rbrace = try cli_executable_parser_token_llvm::token_byte_value(
        ir_bytes,
        "syntax-rbrace"
    );
    try append_line(out, "define i64 @kizu_selfhost__cli_skip_braced_body(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %lbrace_start");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %scan = phi i64 [ %lbrace_start, %entry ], [ %token_end, %continue ]");
    try append_line(out, "  %depth = phi i64 [ 0, %entry ], [ %next_depth, %continue ]");
    try append_line(out,
        "  %index = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load_token, label %not_found");
    try append_line(out, "load_token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %index)");
    try append_i8_constant_call_line(out,
        "  %is_open = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %index, i64 %token_end, i8 ",
        lbrace
    );
    try append_line(out, "  br i1 %is_open, label %open_token, label %maybe_close");
    try append_line(out, "open_token:");
    try append_line(out, "  %open_depth = add i64 %depth, 1");
    try append_line(out, "  br label %continue");
    try append_line(out, "maybe_close:");
    try append_i8_constant_call_line(out,
        "  %is_close = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %index, i64 %token_end, i8 ",
        rbrace
    );
    try append_line(out, "  br i1 %is_close, label %close_token, label %other_token");
    try append_line(out, "close_token:");
    try append_line(out, "  %close_depth = sub i64 %depth, 1");
    try append_line(out, "  %done = icmp eq i64 %close_depth, 0");
    try append_line(out, "  br i1 %done, label %found, label %continue_close");
    try append_line(out, "continue_close:");
    try append_line(out, "  br label %continue");
    try append_line(out, "other_token:");
    try append_line(out, "  br label %continue");
    try append_line(out, "continue:");
    try append_line(out,
        "  %next_depth = phi i64 [ %open_depth, %open_token ], [ %close_depth, %continue_close ], [ %depth, %other_token ]");
    try append_line(out, "  br label %loop");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %token_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_name_end_function(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main_name_end(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %find_fn");
    try append_line(out, "find_fn:");
    try append_line(out,
        "  %scan = phi i64 [ 0, %entry ], [ %helper_after, %helper_continue ]");
    try append_line(out,
        "  %fn_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %fn_in_bounds = icmp slt i64 %fn_start, %source_len");
    try append_line(out, "  br i1 %fn_in_bounds, label %load_fn, label %not_found");
    try append_line(out, "load_fn:");
    try append_line(out,
        "  %fn_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %fn_start)");
    try cli_executable_parser_token_llvm::append_token_word_eq_call(
        out,
        ir_bytes,
        "is_fn",
        "fn_start",
        "fn_end",
        "syntax-fn"
    );
    try append_line(out, "  br i1 %is_fn, label %load_name_start, label %not_found");
    try append_line(out, "load_name_start:");
    try append_line(out,
        "  %name_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %fn_end)");
    try append_line(out, "  %name_in_bounds = icmp slt i64 %name_start, %source_len");
    try append_line(out, "  br i1 %name_in_bounds, label %load_name, label %not_found");
    try append_line(out, "load_name:");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %name_start)");
    try cli_executable_parser_token_llvm::append_token_word_eq_call(
        out,
        ir_bytes,
        "is_main",
        "name_start",
        "name_end",
        "value-main"
    );
    try append_line(out, "  br i1 %is_main, label %found, label %skip_helper");
    try append_line(out, "skip_helper:");
    try append_find_next_char_token_call(
        out,
        ir_bytes,
        "helper_lbrace",
        "name_end",
        "syntax-lbrace"
    );
    try append_line(out, "  %helper_has_lbrace = icmp sge i64 %helper_lbrace, 0");
    try append_line(out,
        "  br i1 %helper_has_lbrace, label %skip_helper_body, label %not_found");
    try append_line(out, "skip_helper_body:");
    try append_line(out,
        "  %helper_after = call i64 @kizu_selfhost__cli_skip_braced_body(%kizu.slice.u8 %source, i64 %helper_lbrace)");
    try append_line(out, "  %helper_ok = icmp sge i64 %helper_after, 0");
    try append_line(out, "  br i1 %helper_ok, label %helper_continue, label %not_found");
    try append_line(out, "helper_continue:");
    try append_line(out, "  br label %find_fn");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %name_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_run_main_body_start_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_run_main_body_start(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__cli_main_name_end(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_main = icmp sge i64 %name_end, 0");
    try append_line(out, "  br i1 %has_main, label %check_lparen, label %not_found");
    try append_signature_char_check(out, ir_bytes, "lparen", "name_end", "syntax-lparen", "check_rparen");
    try append_signature_char_check(out, ir_bytes, "rparen", "lparen_end", "syntax-rparen", "check_lbrace");
    try append_signature_char_check(out, ir_bytes, "lbrace", "rparen_end", "syntax-lbrace", "found");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %lbrace_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_run_void_main_body_start_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_run_void_main_body_start(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__cli_main_name_end(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_main = icmp sge i64 %name_end, 0");
    try append_line(out, "  br i1 %has_main, label %check_lparen, label %not_found");
    try append_signature_char_check(out, ir_bytes, "lparen", "name_end", "syntax-lparen", "check_rparen");
    try append_signature_char_check(out, ir_bytes, "rparen", "lparen_end", "syntax-rparen", "check_return_arrow");
    try append_signature_pair_check(
        out,
        ir_bytes,
        "return_arrow",
        "rparen_end",
        "syntax-return-arrow",
        "check_void"
    );
    try append_signature_word_check(
        out,
        ir_bytes,
        "void",
        "return_arrow_end",
        "syntax-void",
        "check_lbrace"
    );
    try append_signature_char_check(out, ir_bytes, "lbrace", "void_end", "syntax-lbrace", "found");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %lbrace_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_test_main_body_start_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_test_main_body_start(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__cli_main_name_end(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_main = icmp sge i64 %name_end, 0");
    try append_line(out, "  br i1 %has_main, label %check_lparen, label %not_found");
    try append_signature_char_check(out, ir_bytes, "lparen", "name_end", "syntax-lparen", "check_rparen");
    try append_signature_char_check(out, ir_bytes, "rparen", "lparen_end", "syntax-rparen", "check_return_arrow");
    try append_signature_pair_check(
        out,
        ir_bytes,
        "return_arrow",
        "rparen_end",
        "syntax-return-arrow",
        "check_bang"
    );
    try append_signature_char_check(out, ir_bytes, "bang", "return_arrow_end", "syntax-bang", "check_void");
    try append_signature_word_check(
        out,
        ir_bytes,
        "void",
        "bang_end",
        "syntax-void",
        "check_lbrace"
    );
    try append_signature_char_check(out, ir_bytes, "lbrace", "void_end", "syntax-lbrace", "found");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %lbrace_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_test_block_body_start_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_test_block_body_start(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %find_test");
    try append_line(out, "find_test:");
    try append_line(out,
        "  %scan = phi i64 [ 0, %entry ], [ %helper_after, %helper_continue ]");
    try append_line(out,
        "  %token_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %token_in_bounds = icmp slt i64 %token_start, %source_len");
    try append_line(out, "  br i1 %token_in_bounds, label %load_token, label %not_found");
    try append_line(out, "load_token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %token_start)");
    try cli_executable_parser_token_llvm::append_token_word_eq_call(
        out,
        ir_bytes,
        "is_test",
        "token_start",
        "token_end",
        "syntax-test"
    );
    try append_line(out, "  br i1 %is_test, label %load_name_start, label %maybe_helper");
    try append_line(out, "maybe_helper:");
    try cli_executable_parser_token_llvm::append_token_word_eq_call(
        out,
        ir_bytes,
        "is_fn",
        "token_start",
        "token_end",
        "syntax-fn"
    );
    try append_line(out, "  br i1 %is_fn, label %skip_helper, label %not_found");
    try append_line(out, "skip_helper:");
    try append_find_next_char_token_call(
        out,
        ir_bytes,
        "helper_lbrace",
        "token_end",
        "syntax-lbrace"
    );
    try append_line(out, "  %helper_has_lbrace = icmp sge i64 %helper_lbrace, 0");
    try append_line(out,
        "  br i1 %helper_has_lbrace, label %skip_helper_body, label %not_found");
    try append_line(out, "skip_helper_body:");
    try append_line(out,
        "  %helper_after = call i64 @kizu_selfhost__cli_skip_braced_body(%kizu.slice.u8 %source, i64 %helper_lbrace)");
    try append_line(out, "  %helper_ok = icmp sge i64 %helper_after, 0");
    try append_line(out, "  br i1 %helper_ok, label %helper_continue, label %not_found");
    try append_line(out, "helper_continue:");
    try append_line(out, "  br label %find_test");
    try append_line(out, "load_name_start:");
    try append_line(out,
        "  %name_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %token_end)");
    try append_line(out, "  %name_in_bounds = icmp slt i64 %name_start, %source_len");
    try append_line(out, "  br i1 %name_in_bounds, label %load_name, label %not_found");
    try append_line(out, "load_name:");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %name_start)");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %name_first_ptr = getelementptr i8, ptr %source_ptr, i64 %name_start");
    try append_line(out, "  %name_first = load i8, ptr %name_first_ptr");
    try append_line(out, "  %name_starts_quote = icmp eq i8 %name_first, 34");
    try append_line(out, "  %name_last_index = sub i64 %name_end, 1");
    try append_line(out, "  %name_last_ptr = getelementptr i8, ptr %source_ptr, i64 %name_last_index");
    try append_line(out, "  %name_last = load i8, ptr %name_last_ptr");
    try append_line(out, "  %name_ends_quote = icmp eq i8 %name_last, 34");
    try append_line(out, "  %name_is_string = and i1 %name_starts_quote, %name_ends_quote");
    try append_line(out, "  br i1 %name_is_string, label %find_lbrace, label %not_found");
    try append_line(out, "find_lbrace:");
    try append_find_next_char_token_call(out, ir_bytes, "lbrace", "name_end", "syntax-lbrace");
    try append_line(out, "  %has_lbrace = icmp sge i64 %lbrace, 0");
    try append_line(out, "  br i1 %has_lbrace, label %found, label %not_found");
    try append_line(out, "found:");
    try append_line(out,
        "  %lbrace_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %lbrace)");
    try append_line(out, "  ret i64 %lbrace_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_test_void_main_body_start_function(
    out: &var std::string::String,
    ir_bytes: []u8
) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_test_void_main_body_start(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %test_block_body = call i64 @kizu_selfhost__cli_test_block_body_start(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_test_block = icmp sge i64 %test_block_body, 0");
    try append_line(out, "  br i1 %has_test_block, label %found_test_block, label %check_fn");
    try append_line(out, "found_test_block:");
    try append_line(out, "  ret i64 %test_block_body");
    try append_line(out, "check_fn:");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__cli_main_name_end(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_main = icmp sge i64 %name_end, 0");
    try append_line(out, "  br i1 %has_main, label %check_lparen, label %not_found");
    try append_signature_char_check(out, ir_bytes, "lparen", "name_end", "syntax-lparen", "check_rparen");
    try append_signature_char_check(out, ir_bytes, "rparen", "lparen_end", "syntax-rparen", "check_return_arrow");
    try append_signature_pair_check(
        out,
        ir_bytes,
        "return_arrow",
        "rparen_end",
        "syntax-return-arrow",
        "check_void"
    );
    try append_signature_word_check(
        out,
        ir_bytes,
        "void",
        "return_arrow_end",
        "syntax-void",
        "check_lbrace"
    );
    try append_signature_char_check(out, ir_bytes, "lbrace", "void_end", "syntax-lbrace", "found");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %lbrace_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_signature_char_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8
) -> !void {
    try append_signature_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_char_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_signature_branch(out, name, ok_label);
    return;
}

fn append_find_next_char_token_call(
    out: &var std::string::String,
    ir_bytes: []u8,
    result_name: []u8,
    start_name: []u8,
    token_key: []u8
) -> !void {
    let byte = try cli_executable_parser_token_llvm::token_byte_value(ir_bytes, token_key);
    try out.append_bytes("  %");
    try out.append_bytes(result_name);
    try out.append_bytes(" = call i64 @kizu_selfhost__cli_find_next_char_token(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(start_name);
    try out.append_bytes(", i8 ");
    try std::fmt::append_i64(out, byte);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_i8_constant_call_line(
    out: &var std::string::String,
    prefix: []u8,
    value: i64
) -> !void {
    try out.append_bytes(prefix);
    try std::fmt::append_i64(out, value);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_signature_pair_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8
) -> !void {
    try append_signature_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_pair_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_signature_branch(out, name, ok_label);
    return;
}

fn append_signature_word_check(
    out: &var std::string::String,
    ir_bytes: []u8,
    name: []u8,
    previous_end: []u8,
    token_key: []u8,
    ok_label: []u8
) -> !void {
    try append_signature_token_load(out, name, previous_end);
    try cli_executable_parser_token_llvm::append_named_token_word_eq_call(
        out,
        ir_bytes,
        name,
        token_key
    );
    try append_signature_branch(out, name, ok_label);
    return;
}

fn append_signature_token_load(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8
) -> !void {
    try out.append_bytes("check_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_start = call i64 @kizu_selfhost__parse_next_semantic_token_index(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(previous_end);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds = icmp slt i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, %source_len");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds, label %load_");
    try out.append_bytes(name);
    try out.append_bytes(", label %not_found");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("load_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_signature_branch(
    out: &var std::string::String,
    name: []u8,
    ok_label: []u8
) -> !void {
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_ok, label %");
    try out.append_bytes(ok_label);
    try out.append_bytes(", label %not_found");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
