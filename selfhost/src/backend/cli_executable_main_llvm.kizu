pub fn append_functions(out: &var std::string::String) -> !void {
    try append_cli_find_next_char_token_function(out);
    try append_cli_skip_braced_body_function(out);
    try append_cli_main_name_end_function(out);
    try append_cli_run_main_body_start_function(out);
    try append_cli_test_main_body_start_function(out);
    return;
}

fn append_cli_find_next_char_token_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_find_next_char_token(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %start,");
    try append_line(out, "  i8 %want");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %scan = phi i64 [ %start, %entry ], [ %token_end, %continue ]");
    try append_line(out,
        "  %index = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load_token, label %not_found");
    try append_line(out, "load_token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out,
        "  %matches = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %index, i64 %token_end, i8 %want)");
    try append_line(out, "  br i1 %matches, label %found, label %continue");
    try append_line(out, "continue:");
    try append_line(out, "  br label %loop");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %index");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_skip_braced_body_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_skip_braced_body(");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %lbrace_start");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %scan = phi i64 [ %lbrace_start, %entry ], [ %token_end, %continue ]");
    try append_line(out, "  %depth = phi i64 [ 0, %entry ], [ %next_depth, %continue ]");
    try append_line(out,
        "  %index = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load_token, label %not_found");
    try append_line(out, "load_token:");
    try append_line(out,
        "  %token_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %index)");
    try append_line(out,
        "  %is_open = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %index, i64 %token_end, i8 123)");
    try append_line(out, "  br i1 %is_open, label %open_token, label %maybe_close");
    try append_line(out, "open_token:");
    try append_line(out, "  %open_depth = add i64 %depth, 1");
    try append_line(out, "  br label %continue");
    try append_line(out, "maybe_close:");
    try append_line(out,
        "  %is_close = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %index, i64 %token_end, i8 125)");
    try append_line(out, "  br i1 %is_close, label %close_token, label %other_token");
    try append_line(out, "close_token:");
    try append_line(out, "  %close_depth = sub i64 %depth, 1");
    try append_line(out, "  %done = icmp eq i64 %close_depth, 0");
    try append_line(out, "  br i1 %done, label %found, label %continue_close");
    try append_line(out, "continue_close:");
    try append_line(out, "  br label %continue");
    try append_line(out, "other_token:");
    try append_line(out, "  br label %continue");
    try append_line(out, "continue:");
    try append_line(out,
        "  %next_depth = phi i64 [ %open_depth, %open_token ], [ %close_depth, %continue_close ], [ %depth, %other_token ]");
    try append_line(out, "  br label %loop");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %token_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_main_name_end_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_main_name_end(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %find_fn");
    try append_line(out, "find_fn:");
    try append_line(out,
        "  %scan = phi i64 [ 0, %entry ], [ %helper_after, %helper_continue ]");
    try append_line(out,
        "  %fn_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %scan)");
    try append_line(out, "  %fn_in_bounds = icmp slt i64 %fn_start, %source_len");
    try append_line(out, "  br i1 %fn_in_bounds, label %load_fn, label %not_found");
    try append_line(out, "load_fn:");
    try append_line(out,
        "  %fn_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %fn_start)");
    try append_line(out,
        "  %is_fn = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %fn_start, i64 %fn_end, i64 2, i8 102, i8 110, i8 0, i8 0, i8 0, i8 0, i8 0)");
    try append_line(out, "  br i1 %is_fn, label %load_name_start, label %not_found");
    try append_line(out, "load_name_start:");
    try append_line(out,
        "  %name_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %fn_end)");
    try append_line(out, "  %name_in_bounds = icmp slt i64 %name_start, %source_len");
    try append_line(out, "  br i1 %name_in_bounds, label %load_name, label %not_found");
    try append_line(out, "load_name:");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %name_start)");
    try append_line(out,
        "  %is_main = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %name_start, i64 %name_end, i64 4, i8 109, i8 97, i8 105, i8 110, i8 0, i8 0, i8 0)");
    try append_line(out, "  br i1 %is_main, label %found, label %skip_helper");
    try append_line(out, "skip_helper:");
    try append_line(out,
        "  %helper_lbrace = call i64 @kizu_selfhost__cli_find_next_char_token(%kizu.slice.u8 %source, i64 %name_end, i8 123)");
    try append_line(out, "  %helper_has_lbrace = icmp sge i64 %helper_lbrace, 0");
    try append_line(out,
        "  br i1 %helper_has_lbrace, label %skip_helper_body, label %not_found");
    try append_line(out, "skip_helper_body:");
    try append_line(out,
        "  %helper_after = call i64 @kizu_selfhost__cli_skip_braced_body(%kizu.slice.u8 %source, i64 %helper_lbrace)");
    try append_line(out, "  %helper_ok = icmp sge i64 %helper_after, 0");
    try append_line(out, "  br i1 %helper_ok, label %helper_continue, label %not_found");
    try append_line(out, "helper_continue:");
    try append_line(out, "  br label %find_fn");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %name_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_run_main_body_start_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_run_main_body_start(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__cli_main_name_end(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_main = icmp sge i64 %name_end, 0");
    try append_line(out, "  br i1 %has_main, label %check_lparen, label %not_found");
    try append_signature_char_check(out, "lparen", "name_end", "40", "check_rparen");
    try append_signature_char_check(out, "rparen", "lparen_end", "41", "check_lbrace");
    try append_signature_char_check(out, "lbrace", "rparen_end", "123", "found");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %lbrace_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_cli_test_main_body_start_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__cli_test_main_body_start(");
    try append_line(out, "  %kizu.slice.u8 %source");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out,
        "  %name_end = call i64 @kizu_selfhost__cli_main_name_end(%kizu.slice.u8 %source)");
    try append_line(out, "  %has_main = icmp sge i64 %name_end, 0");
    try append_line(out, "  br i1 %has_main, label %check_lparen, label %not_found");
    try append_signature_char_check(out, "lparen", "name_end", "40", "check_rparen");
    try append_signature_char_check(out, "rparen", "lparen_end", "41", "check_return_arrow");
    try append_signature_pair_check(out, "return_arrow", "rparen_end", "45", "62", "check_bang");
    try append_signature_char_check(out, "bang", "return_arrow_end", "33", "check_void");
    try append_signature_word_check(
        out,
        "void",
        "bang_end",
        "4",
        "118",
        "111",
        "105",
        "100",
        "0",
        "0",
        "0",
        "check_lbrace"
    );
    try append_signature_char_check(out, "lbrace", "void_end", "123", "found");
    try append_line(out, "found:");
    try append_line(out, "  ret i64 %lbrace_end");
    try append_line(out, "not_found:");
    try append_line(out, "  ret i64 -1");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_signature_char_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    want: []u8,
    ok_label: []u8
) -> !void {
    try append_signature_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_char_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i8 ");
    try out.append_bytes(want);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_signature_branch(out, name, ok_label);
    return;
}

fn append_signature_pair_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    b0: []u8,
    b1: []u8,
    ok_label: []u8
) -> !void {
    try append_signature_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_pair_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i8 ");
    try out.append_bytes(b0);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b1);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_signature_branch(out, name, ok_label);
    return;
}

fn append_signature_word_check(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8,
    len: []u8,
    b0: []u8,
    b1: []u8,
    b2: []u8,
    b3: []u8,
    b4: []u8,
    b5: []u8,
    b6: []u8,
    ok_label: []u8
) -> !void {
    try append_signature_token_load(out, name, previous_end);
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_ok = call i1 @kizu_selfhost__cli_token_word_eq(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_end, i64 ");
    try out.append_bytes(len);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b0);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b1);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b2);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b3);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b4);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b5);
    try out.append_bytes(", i8 ");
    try out.append_bytes(b6);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_signature_branch(out, name, ok_label);
    return;
}

fn append_signature_token_load(
    out: &var std::string::String,
    name: []u8,
    previous_end: []u8
) -> !void {
    try out.append_bytes("check_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_start = call i64 @kizu_selfhost__parse_next_non_ws_index(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(previous_end);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds = icmp slt i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start, %source_len");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_in_bounds, label %load_");
    try out.append_bytes(name);
    try out.append_bytes(", label %not_found");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("load_");
    try out.append_bytes(name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(name);
    try out.append_bytes("_end = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %source, i64 %");
    try out.append_bytes(name);
    try out.append_bytes("_start)");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_signature_branch(
    out: &var std::string::String,
    name: []u8,
    ok_label: []u8
) -> !void {
    try out.append_bytes("  br i1 %");
    try out.append_bytes(name);
    try out.append_bytes("_ok, label %");
    try out.append_bytes(ok_label);
    try out.append_bytes(", label %not_found");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
