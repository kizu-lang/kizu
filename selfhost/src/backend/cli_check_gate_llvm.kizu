pub fn append_functions(out: &var std::string::String) -> !void {
    try append_check_parse_delimiter_error_function(out);
    try append_check_parse_write_expected_eof_function(out);
    return;
}

pub fn append_static_check_gate(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8,
    ok_label: []u8
) -> !void {
    try append_call_i64(out, value_prefix, "missing_index", "parse_missing_expr_index", bytes_name);
    try append_compare_sge_zero(out, value_prefix, "has_missing", "missing_index");
    try append_branch(out, value_prefix, "has_missing", label_prefix, "parse_error",
        label_prefix, "assign_scan");
    try append_label(out, label_prefix, "assign_scan");
    try append_call_i64(out, value_prefix, "missing_assign", "parse_missing_assign_index", bytes_name);
    try append_compare_sge_zero(out, value_prefix, "has_missing_assign", "missing_assign");
    try append_branch(out, value_prefix, "has_missing_assign", label_prefix, "assign_error",
        label_prefix, "delimiter_scan");
    try append_label(out, label_prefix, "delimiter_scan");
    try append_call_i64(out, value_prefix, "delimiter_result", "check_parse_delimiter_error",
        bytes_name);
    try append_compare_sgt_zero(out, value_prefix, "has_delimiter_error", "delimiter_result");
    try append_branch(out, value_prefix, "has_delimiter_error", label_prefix, "delimiter_error",
        label_prefix, "move_scan");
    try append_label(out, label_prefix, "move_scan");
    try append_moved_name_call(out, value_prefix, bytes_name);
    try append_extract_slice_len(out, value_prefix, "moved_name_len", "moved_name");
    try append_compare_sgt_zero(out, value_prefix, "has_moved_name", "moved_name_len");
    try append_branch(out, value_prefix, "has_moved_name", label_prefix, "move_error",
        "fixed", ok_label);
    try append_parse_error_block(out, label_prefix, value_prefix, io_name, bytes_name);
    try append_assign_error_block(out, label_prefix, value_prefix, io_name, bytes_name);
    try append_delimiter_error_block(out, label_prefix, value_prefix, io_name, bytes_name);
    try append_move_error_block(out, label_prefix, value_prefix, io_name, bytes_name);
    return;
}

pub fn append_compiled_undefined_variable_gate(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8,
    ast_name: []u8,
    root_name: []u8,
    ok_label: []u8
) -> !void {
    try append_value_def(out, value_prefix, "undefined_result");
    try out.append_bytes(" = call %kizu.error.i64 ");
    try out.append_bytes("@kizu_selfhost__types_checker_first_hosted_check_undefined_variable_start_ast_node(");
    try out.append_bytes("%kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(", %kizu.kizu.ast.ast %");
    try out.append_bytes(ast_name);
    try out.append_bytes(", %kizu.kizu.ast.node_id %");
    try out.append_bytes(root_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "undefined_ok");
    try out.append_bytes(" = extractvalue %kizu.error.i64 ");
    try append_value_ref(out, value_prefix, "undefined_result");
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_branch_to_fixed(out, value_prefix, "undefined_ok", "check_undefined_scan",
        "check_failed");
    try append_label(out, "fixed", "check_undefined_scan");
    try append_value_def(out, value_prefix, "undefined_start");
    try out.append_bytes(" = extractvalue %kizu.error.i64 ");
    try append_value_ref(out, value_prefix, "undefined_result");
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try append_compare_sge_zero(out, value_prefix, "has_undefined", "undefined_start");
    try append_branch(out, value_prefix, "has_undefined", label_prefix, "undefined_error",
        "fixed", ok_label);
    try append_undefined_variable_error_block(out, label_prefix, value_prefix, io_name, bytes_name);
    return;
}

fn append_parse_error_block(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8
) -> !void {
    try append_label(out, label_prefix, "parse_error");
    try append_call_parse_writer(
        out,
        value_prefix,
        "parse_ok",
        "parse_write_missing_expr",
        io_name,
        bytes_name,
        "missing_index"
    );
    try append_branch_to_fixed(out, value_prefix, "parse_ok", "exit_one", "check_failed");
    return;
}

