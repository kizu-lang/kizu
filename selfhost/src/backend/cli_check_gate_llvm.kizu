pub fn append_static_check_gate(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8,
    ok_label: []u8
) -> !void {
    try append_call_i64(out, value_prefix, "missing_index", "parse_missing_expr_index", bytes_name);
    try append_compare_sge_zero(out, value_prefix, "has_missing", "missing_index");
    try append_branch(out, value_prefix, "has_missing", label_prefix, "parse_error",
        label_prefix, "assign_scan");
    try append_label(out, label_prefix, "assign_scan");
    try append_call_i64(out, value_prefix, "missing_assign", "parse_missing_assign_index", bytes_name);
    try append_compare_sge_zero(out, value_prefix, "has_missing_assign", "missing_assign");
    try append_branch(out, value_prefix, "has_missing_assign", label_prefix, "assign_error",
        label_prefix, "move_scan");
    try append_label(out, label_prefix, "move_scan");
    try append_moved_name_call(out, value_prefix, bytes_name);
    try append_extract_slice_len(out, value_prefix, "moved_name_len", "moved_name");
    try append_compare_sgt_zero(out, value_prefix, "has_moved_name", "moved_name_len");
    try append_branch(out, value_prefix, "has_moved_name", label_prefix, "move_error",
        "fixed", ok_label);
    try append_parse_error_block(out, label_prefix, value_prefix, io_name, bytes_name);
    try append_assign_error_block(out, label_prefix, value_prefix, io_name, bytes_name);
    try append_move_error_block(out, label_prefix, value_prefix, io_name);
    return;
}

fn append_parse_error_block(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8
) -> !void {
    try append_label(out, label_prefix, "parse_error");
    try append_call_parse_writer(
        out,
        value_prefix,
        "parse_ok",
        "parse_write_missing_expr",
        io_name,
        bytes_name,
        "missing_index"
    );
    try append_branch_to_fixed(out, value_prefix, "parse_ok", "exit_one", "check_failed");
    return;
}

fn append_assign_error_block(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8
) -> !void {
    try append_label(out, label_prefix, "assign_error");
    try append_call_parse_writer(
        out,
        value_prefix,
        "assign_ok",
        "parse_write_missing_assign",
        io_name,
        bytes_name,
        "missing_assign"
    );
    try append_branch_to_fixed(out, value_prefix, "assign_ok", "exit_one", "check_failed");
    return;
}

fn append_move_error_block(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8
) -> !void {
    try append_label(out, label_prefix, "move_error");
    try append_global_slice(out, value_prefix, "move_prefix", "text", "move_prefix", "32");
    try append_write_stderr_slice(
        out,
        value_prefix,
        "move_prefix_write",
        io_name,
        value_prefix,
        "move_prefix",
        "text"
    );
    try append_extract_error_ok(out, value_prefix, "move_prefix_ok", "move_prefix_write");
    try append_branch(out, value_prefix, "move_prefix_ok", label_prefix, "move_name",
        "fixed", "check_failed");
    try append_label(out, label_prefix, "move_name");
    try append_write_stderr_value(
        out,
        value_prefix,
        "move_name_write",
        io_name,
        value_prefix,
        "moved_name"
    );
    try append_extract_error_ok(out, value_prefix, "move_name_ok", "move_name_write");
    try append_branch(out, value_prefix, "move_name_ok", label_prefix, "move_suffix",
        "fixed", "check_failed");
    try append_label(out, label_prefix, "move_suffix");
    try append_global_slice(out, value_prefix, "move_suffix", "text", "move_suffix", "11");
    try append_write_stderr_slice(
        out,
        value_prefix,
        "move_suffix_write",
        io_name,
        value_prefix,
        "move_suffix",
        "text"
    );
    try append_extract_error_ok(out, value_prefix, "move_suffix_ok", "move_suffix_write");
    try append_branch_to_fixed(out, value_prefix, "move_suffix_ok", "exit_one", "check_failed");
    return;
}

fn append_call_i64(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    function_name: []u8,
    bytes_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, value_name);
    try out.append_bytes(" = call i64 @kizu_selfhost__");
    try out.append_bytes(function_name);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_compare_sge_zero(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    source_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, value_name);
    try out.append_bytes(" = icmp sge i64 ");
    try append_value_ref(out, value_prefix, source_name);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_compare_sgt_zero(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    source_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, value_name);
    try out.append_bytes(" = icmp sgt i64 ");
    try append_value_ref(out, value_prefix, source_name);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_moved_name_call(
    out: &var std::string::String,
    value_prefix: []u8,
    bytes_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, "moved_name");
    try out.append_bytes(" = call %kizu.slice.u8 @kizu_selfhost__cli_moved_value_name(");
    try out.append_bytes("%kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_extract_slice_len(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    source_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, value_name);
    try out.append_bytes(" = extractvalue %kizu.slice.u8 ");
    try append_value_ref(out, value_prefix, source_name);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_call_parse_writer(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    function_name: []u8,
    io_name: []u8,
    bytes_name: []u8,
    index_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, value_name);
    try out.append_bytes(" = call i1 @kizu_selfhost__");
    try out.append_bytes(function_name);
    try out.append_bytes("(%kizu.owned %");
    try out.append_bytes(io_name);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(", i64 ");
    try append_value_ref(out, value_prefix, index_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_write_stderr_value(
    out: &var std::string::String,
    value_prefix: []u8,
    result_name: []u8,
    io_name: []u8,
    slice_prefix: []u8,
    slice_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, result_name);
    try out.append_bytes(" = call %kizu.error.void @kizu_rt_io_write_stderr(");
    try out.append_bytes("%kizu.owned %");
    try out.append_bytes(io_name);
    try out.append_bytes(", %kizu.slice.u8 ");
    try append_value_ref(out, slice_prefix, slice_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_write_stderr_slice(
    out: &var std::string::String,
    value_prefix: []u8,
    result_name: []u8,
    io_name: []u8,
    slice_prefix: []u8,
    local_name: []u8,
    field_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, result_name);
    try out.append_bytes(" = call %kizu.error.void @kizu_rt_io_write_stderr(");
    try out.append_bytes("%kizu.owned %");
    try out.append_bytes(io_name);
    try out.append_bytes(", %kizu.slice.u8 ");
    try append_slice_ref(out, slice_prefix, local_name, field_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_extract_error_ok(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    source_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, value_name);
    try out.append_bytes(" = extractvalue %kizu.error.void ");
    try append_value_ref(out, value_prefix, source_name);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_branch(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    true_label_prefix: []u8,
    true_label_suffix: []u8,
    false_label_prefix: []u8,
    false_label_suffix: []u8
) -> !void {
    try out.append_bytes("  br i1 ");
    try append_value_ref(out, value_prefix, value_name);
    try out.append_bytes(", label %");
    try append_label_ref(out, true_label_prefix, true_label_suffix);
    try out.append_bytes(", label %");
    try append_label_ref(out, false_label_prefix, false_label_suffix);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_branch_to_fixed(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    true_label: []u8,
    false_label: []u8
) -> !void {
    try out.append_bytes("  br i1 ");
    try append_value_ref(out, value_prefix, value_name);
    try out.append_bytes(", label %");
    try out.append_bytes(true_label);
    try out.append_bytes(", label %");
    try out.append_bytes(false_label);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_label(
    out: &var std::string::String,
    label_prefix: []u8,
    label_suffix: []u8
) -> !void {
    try append_label_ref(out, label_prefix, label_suffix);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_label_ref(
    out: &var std::string::String,
    label_prefix: []u8,
    label_suffix: []u8
) -> !void {
    if std::mem::equal_bytes(label_prefix, "fixed") {
        try out.append_bytes(label_suffix);
        return;
    }
    try out.append_bytes(label_prefix);
    try out.append_bytes("_");
    try out.append_bytes(label_suffix);
    return;
}

fn append_value_def(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8
) -> !void {
    try out.append_bytes("  %");
    try append_value_name(out, value_prefix, value_name);
    return;
}

fn append_value_ref(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8
) -> !void {
    try out.append_bytes("%");
    try append_value_name(out, value_prefix, value_name);
    return;
}

fn append_value_name(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8
) -> !void {
    try out.append_bytes(value_prefix);
    try out.append_bytes("_");
    try out.append_bytes(value_name);
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    value_prefix: []u8,
    local_name: []u8,
    field_name: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  ");
    try append_slice_component(out, value_prefix, local_name, field_name, "ptr");
    try out.append_bytes(" = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_slice_component(out, value_prefix, local_name, field_name, "base");
    try out.append_bytes(" = insertvalue %kizu.slice.u8 poison, ptr ");
    try append_slice_component(out, value_prefix, local_name, field_name, "ptr");
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_slice_ref(out, value_prefix, local_name, field_name);
    try out.append_bytes(" = insertvalue %kizu.slice.u8 ");
    try append_slice_component(out, value_prefix, local_name, field_name, "base");
    try out.append_bytes(", i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_slice_ref(
    out: &var std::string::String,
    value_prefix: []u8,
    local_name: []u8,
    field_name: []u8
) -> !void {
    try append_slice_component(out, value_prefix, local_name, field_name, "slice");
    return;
}

fn append_slice_component(
    out: &var std::string::String,
    value_prefix: []u8,
    local_name: []u8,
    field_name: []u8,
    component: []u8
) -> !void {
    try out.append_bytes("%");
    try out.append_bytes(value_prefix);
    try out.append_bytes("_");
    try out.append_bytes(local_name);
    try out.append_bytes("_");
    try out.append_bytes(field_name);
    try out.append_bytes("_");
    try out.append_bytes(component);
    return;
}
