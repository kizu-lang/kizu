fn append_delimiter_error_block(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8
) -> !void {
    try append_label(out, label_prefix, "delimiter_error");
    try append_value_def(out, value_prefix, "delimiter_code");
    try out.append_bytes(" = srem i64 ");
    try append_value_ref(out, value_prefix, "delimiter_result");
    try out.append_bytes(", 10");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "delimiter_scaled_index");
    try out.append_bytes(" = sdiv i64 ");
    try append_value_ref(out, value_prefix, "delimiter_result");
    try out.append_bytes(", 10");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "delimiter_index");
    try out.append_bytes(" = sub i64 ");
    try append_value_ref(out, value_prefix, "delimiter_scaled_index");
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try append_compare_eq_i64_literal(out, value_prefix, "delimiter_unexpected",
        "delimiter_code", "1");
    try append_branch(out, value_prefix, "delimiter_unexpected", label_prefix,
        "delimiter_unexpected_error", label_prefix, "delimiter_expected_paren_check");
    try append_label(out, label_prefix, "delimiter_expected_paren_check");
    try append_compare_eq_i64_literal(out, value_prefix, "delimiter_expected_paren",
        "delimiter_code", "2");
    try append_branch(out, value_prefix, "delimiter_expected_paren", label_prefix,
        "delimiter_expected_paren_error", label_prefix, "delimiter_expected_brace_check");
    try append_label(out, label_prefix, "delimiter_expected_brace_check");
    try append_compare_eq_i64_literal(out, value_prefix, "delimiter_expected_brace",
        "delimiter_code", "3");
    try append_branch(out, value_prefix, "delimiter_expected_brace", label_prefix,
        "delimiter_expected_brace_error", label_prefix, "delimiter_expected_bracket_error");
    try append_delimiter_unexpected_error_block(out, label_prefix, value_prefix, io_name,
        bytes_name);
    try append_delimiter_expected_error_block(
        out,
        label_prefix,
        value_prefix,
        io_name,
        bytes_name,
        "delimiter_expected_paren_error",
        "delimiter_expected_paren_ok",
        "parse_expected_right_paren",
        "27"
    );
    try append_delimiter_expected_error_block(
        out,
        label_prefix,
        value_prefix,
        io_name,
        bytes_name,
        "delimiter_expected_brace_error",
        "delimiter_expected_brace_ok",
        "parse_expected_right_brace",
        "27"
    );
    try append_delimiter_expected_error_block(
        out,
        label_prefix,
        value_prefix,
        io_name,
        bytes_name,
        "delimiter_expected_bracket_error",
        "delimiter_expected_bracket_ok",
        "parse_expected_right_bracket",
        "29"
    );
    return;
}

fn append_delimiter_unexpected_error_block(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8
) -> !void {
    try append_label(out, label_prefix, "delimiter_unexpected_error");
    try append_global_slice(out, value_prefix, "delimiter_unexpected_prefix", "text",
        "parse_unexpected_token_prefix", "29");
    try append_call_expected_one_token_writer(out, value_prefix, "delimiter_unexpected_ok",
        io_name, bytes_name, "delimiter_index", "delimiter_unexpected_prefix");
    try append_branch_to_fixed(out, value_prefix, "delimiter_unexpected_ok", "exit_one",
        "check_failed");
    return;
}

fn append_delimiter_expected_error_block(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8,
    block_name: []u8,
    result_name: []u8,
    global_name: []u8,
    global_size: []u8
) -> !void {
    try append_label(out, label_prefix, block_name);
    try append_global_slice(out, value_prefix, block_name, "text", global_name, global_size);
    try append_call_expected_eof_writer(out, value_prefix, result_name, block_name, io_name,
        bytes_name);
    try append_branch_to_fixed(out, value_prefix, result_name, "exit_one", "check_failed");
    return;
}

fn append_move_error_block(
    out: &var std::string::String,
    label_prefix: []u8,
    value_prefix: []u8,
    io_name: []u8,
    bytes_name: []u8
) -> !void {
    try append_label(out, label_prefix, "move_error");
    try append_global_slice(out, value_prefix, "move_prefix", "text", "move_prefix", "32");
    try append_write_stderr_slice(
        out,
        value_prefix,
        "move_prefix_write",
        io_name,
        value_prefix,
        "move_prefix",
        "text"
    );
    try append_extract_error_ok(out, value_prefix, "move_prefix_ok", "move_prefix_write");
    try append_branch(out, value_prefix, "move_prefix_ok", label_prefix, "move_name",
        "fixed", "check_failed");
    try append_label(out, label_prefix, "move_name");
    try append_write_stderr_value(
        out,
        value_prefix,
        "move_name_write",
        io_name,
        value_prefix,
        "moved_name"
    );
    try append_extract_error_ok(out, value_prefix, "move_name_ok", "move_name_write");
    try append_branch(out, value_prefix, "move_name_ok", label_prefix, "move_suffix",
        "fixed", "check_failed");
    try append_label(out, label_prefix, "move_suffix");
    try append_global_slice(out, value_prefix, "move_suffix", "text", "move_suffix", "10");
    try append_write_stderr_slice(
        out,
        value_prefix,
        "move_suffix_write",
        io_name,
        value_prefix,
        "move_suffix",
        "text"
    );
    try append_extract_error_ok(out, value_prefix, "move_suffix_ok", "move_suffix_write");
    try append_branch(out, value_prefix, "move_suffix_ok", label_prefix, "move_position",
        "fixed", "check_failed");
    try append_label(out, label_prefix, "move_position");
    try append_value_def(out, value_prefix, "source_ptr");
    try out.append_bytes(" = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "moved_name_ptr");
    try out.append_bytes(" = extractvalue %kizu.slice.u8 ");
    try append_value_ref(out, value_prefix, "moved_name");
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "source_addr");
    try out.append_bytes(" = ptrtoint ptr ");
    try append_value_ref(out, value_prefix, "source_ptr");
    try out.append_bytes(" to i64");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "moved_name_addr");
    try out.append_bytes(" = ptrtoint ptr ");
    try append_value_ref(out, value_prefix, "moved_name_ptr");
    try out.append_bytes(" to i64");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "moved_name_index");
    try out.append_bytes(" = sub i64 ");
    try append_value_ref(out, value_prefix, "moved_name_addr");
    try out.append_bytes(", ");
    try append_value_ref(out, value_prefix, "source_addr");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "move_position_ok");
    try out.append_bytes(" = call i1 @kizu_selfhost__parse_write_position_suffix(");
    try out.append_bytes("%kizu.owned %");
    try out.append_bytes(io_name);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(", i64 ");
    try append_value_ref(out, value_prefix, "moved_name_index");
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_branch_to_fixed(out, value_prefix, "move_position_ok", "exit_one", "check_failed");
    return;
}

