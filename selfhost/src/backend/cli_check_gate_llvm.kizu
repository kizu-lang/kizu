fn append_branch(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    true_label_prefix: []u8,
    true_label_suffix: []u8,
    false_label_prefix: []u8,
    false_label_suffix: []u8
) -> !void {
    try out.append_bytes("  br i1 ");
    try append_value_ref(out, value_prefix, value_name);
    try out.append_bytes(", label %");
    try append_label_ref(out, true_label_prefix, true_label_suffix);
    try out.append_bytes(", label %");
    try append_label_ref(out, false_label_prefix, false_label_suffix);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_branch_to_fixed(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    true_label: []u8,
    false_label: []u8
) -> !void {
    try out.append_bytes("  br i1 ");
    try append_value_ref(out, value_prefix, value_name);
    try out.append_bytes(", label %");
    try out.append_bytes(true_label);
    try out.append_bytes(", label %");
    try out.append_bytes(false_label);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_label(
    out: &var std::string::String,
    label_prefix: []u8,
    label_suffix: []u8
) -> !void {
    try append_label_ref(out, label_prefix, label_suffix);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_label_ref(
    out: &var std::string::String,
    label_prefix: []u8,
    label_suffix: []u8
) -> !void {
    if std::mem::equal_bytes(label_prefix, "fixed") {
        try out.append_bytes(label_suffix);
        return;
    }
    try out.append_bytes(label_prefix);
    try out.append_bytes("_");
    try out.append_bytes(label_suffix);
    return;
}

fn append_value_def(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8
) -> !void {
    try out.append_bytes("  %");
    try append_value_name(out, value_prefix, value_name);
    return;
}

fn append_value_ref(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8
) -> !void {
    try out.append_bytes("%");
    try append_value_name(out, value_prefix, value_name);
    return;
}

fn append_value_name(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8
) -> !void {
    try out.append_bytes(value_prefix);
    try out.append_bytes("_");
    try out.append_bytes(value_name);
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    value_prefix: []u8,
    local_name: []u8,
    field_name: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  ");
    try append_slice_component(out, value_prefix, local_name, field_name, "ptr");
    try out.append_bytes(" = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_slice_component(out, value_prefix, local_name, field_name, "base");
    try out.append_bytes(" = insertvalue %kizu.slice.u8 poison, ptr ");
    try append_slice_component(out, value_prefix, local_name, field_name, "ptr");
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ");
    try append_slice_ref(out, value_prefix, local_name, field_name);
    try out.append_bytes(" = insertvalue %kizu.slice.u8 ");
    try append_slice_component(out, value_prefix, local_name, field_name, "base");
    try out.append_bytes(", i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_slice_ref(
    out: &var std::string::String,
    value_prefix: []u8,
    local_name: []u8,
    field_name: []u8
) -> !void {
    try append_slice_component(out, value_prefix, local_name, field_name, "slice");
    return;
}

fn append_slice_component(
    out: &var std::string::String,
    value_prefix: []u8,
    local_name: []u8,
    field_name: []u8,
    component: []u8
) -> !void {
    try out.append_bytes("%");
    try out.append_bytes(value_prefix);
    try out.append_bytes("_");
    try out.append_bytes(local_name);
    try out.append_bytes("_");
    try out.append_bytes(field_name);
    try out.append_bytes("_");
    try out.append_bytes(component);
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
