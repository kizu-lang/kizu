        "check_failed");
    return;
}

fn append_undefined_name_slice(
    out: &var std::string::String,
    value_prefix: []u8,
    bytes_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, "undefined_source_ptr");
    try out.append_bytes(" = extractvalue %kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "undefined_name_ptr");
    try out.append_bytes(" = getelementptr i8, ptr ");
    try append_value_ref(out, value_prefix, "undefined_source_ptr");
    try out.append_bytes(", i64 ");
    try append_value_ref(out, value_prefix, "undefined_start");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "undefined_name_end");
    try out.append_bytes(" = call i64 @kizu_selfhost__parse_token_end(%kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(", i64 ");
    try append_value_ref(out, value_prefix, "undefined_start");
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "undefined_name_len");
    try out.append_bytes(" = sub i64 ");
    try append_value_ref(out, value_prefix, "undefined_name_end");
    try out.append_bytes(", ");
    try append_value_ref(out, value_prefix, "undefined_start");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "undefined_name_base");
    try out.append_bytes(" = insertvalue %kizu.slice.u8 poison, ptr ");
    try append_value_ref(out, value_prefix, "undefined_name_ptr");
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try append_value_def(out, value_prefix, "undefined_name");
    try out.append_bytes(" = insertvalue %kizu.slice.u8 ");
    try append_value_ref(out, value_prefix, "undefined_name_base");
    try out.append_bytes(", i64 ");
    try append_value_ref(out, value_prefix, "undefined_name_len");
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_check_parse_delimiter_error_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i64 @kizu_selfhost__check_parse_delimiter_error(%kizu.slice.u8 %source) {");
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next_index, %advance ]");
    try append_line(out, "  %paren_depth = phi i64 [ 0, %entry ], [ %next_paren_depth, %advance ]");
    try append_line(out, "  %brace_depth = phi i64 [ 0, %entry ], [ %next_brace_depth, %advance ]");
    try append_line(out, "  %bracket_depth = phi i64 [ 0, %entry ], [ %next_bracket_depth, %advance ]");
    try append_line(out, "  %in_string = phi i1 [ false, %entry ], [ %next_in_string, %advance ]");
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load, label %eof");
    try append_line(out, "load:");
    try append_line(out, "  %byte_ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %byte_ptr");
    try append_line(out, "  %is_quote = icmp eq i8 %byte, 34");
    try append_line(out, "  %string_close = and i1 %in_string, %is_quote");
    try append_line(out, "  %not_in_string = xor i1 %in_string, true");
    try append_line(out, "  %string_open = and i1 %not_in_string, %is_quote");
    try append_line(out, "  %string_stays = and i1 %in_string, %string_close");
    try append_line(out, "  %string_stays_not = xor i1 %string_stays, true");
    try append_line(out, "  %string_after_close = and i1 %in_string, %string_stays_not");
    try append_line(out, "  %next_in_string = or i1 %string_after_close, %string_open");
    try append_line(out, "  %active = and i1 %not_in_string, %string_open");
    try append_line(out, "  %active_not = xor i1 %active, true");
    try append_line(out, "  %parse_active = and i1 %not_in_string, %active_not");
    try append_line(out, "  %is_lparen_byte = icmp eq i8 %byte, 40");
    try append_line(out, "  %is_rparen_byte = icmp eq i8 %byte, 41");
    try append_line(out, "  %is_lbrace_byte = icmp eq i8 %byte, 123");
    try append_line(out, "  %is_rbrace_byte = icmp eq i8 %byte, 125");
    try append_line(out, "  %is_lbracket_byte = icmp eq i8 %byte, 91");
    try append_line(out, "  %is_rbracket_byte = icmp eq i8 %byte, 93");
    try append_line(out, "  %is_rparen = and i1 %parse_active, %is_rparen_byte");
    try append_line(out, "  %is_rbrace = and i1 %parse_active, %is_rbrace_byte");
    try append_line(out, "  %is_rbracket = and i1 %parse_active, %is_rbracket_byte");
    try append_line(out, "  %paren_empty = icmp eq i64 %paren_depth, 0");
    try append_line(out, "  %brace_empty = icmp eq i64 %brace_depth, 0");
    try append_line(out, "  %bracket_empty = icmp eq i64 %bracket_depth, 0");
    try append_line(out, "  %unexpected_paren = and i1 %is_rparen, %paren_empty");
    try append_line(out, "  %unexpected_brace = and i1 %is_rbrace, %brace_empty");
    try append_line(out, "  %unexpected_bracket = and i1 %is_rbracket, %bracket_empty");
    try append_line(out, "  %unexpected_close_1 = or i1 %unexpected_paren, %unexpected_brace");
    try append_line(out, "  %unexpected_close = or i1 %unexpected_close_1, %unexpected_bracket");
    try append_line(out, "  br i1 %unexpected_close, label %unexpected, label %count");
    try append_line(out, "count:");
    try append_line(out, "  %is_lparen = and i1 %parse_active, %is_lparen_byte");
    try append_line(out, "  %is_lbrace = and i1 %parse_active, %is_lbrace_byte");
    try append_line(out, "  %is_lbracket = and i1 %parse_active, %is_lbracket_byte");
    try append_line(out, "  %paren_inc = zext i1 %is_lparen to i64");
    try append_line(out, "  %paren_dec = zext i1 %is_rparen to i64");
    try append_line(out, "  %brace_inc = zext i1 %is_lbrace to i64");
    try append_line(out, "  %brace_dec = zext i1 %is_rbrace to i64");
    try append_line(out, "  %bracket_inc = zext i1 %is_lbracket to i64");
    try append_line(out, "  %bracket_dec = zext i1 %is_rbracket to i64");
    try append_line(out, "  %paren_plus = add i64 %paren_depth, %paren_inc");
    try append_line(out, "  %next_paren_depth = sub i64 %paren_plus, %paren_dec");
    try append_line(out, "  %brace_plus = add i64 %brace_depth, %brace_inc");
    try append_line(out, "  %next_brace_depth = sub i64 %brace_plus, %brace_dec");
    try append_line(out, "  %bracket_plus = add i64 %bracket_depth, %bracket_inc");
    try append_line(out, "  %next_bracket_depth = sub i64 %bracket_plus, %bracket_dec");
    try append_line(out, "  br label %advance");
    try append_line(out, "advance:");
    try append_line(out, "  %next_index = add i64 %index, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "unexpected:");
    try append_line(out, "  %unexpected_index = add i64 %index, 1");
    try append_line(out, "  %unexpected_scaled = mul i64 %unexpected_index, 10");
    try append_line(out, "  %unexpected_packed = add i64 %unexpected_scaled, 1");
    try append_line(out, "  ret i64 %unexpected_packed");
    try append_line(out, "eof:");
    try append_line(out, "  %has_paren = icmp sgt i64 %paren_depth, 0");
    try append_line(out, "  br i1 %has_paren, label %eof_paren, label %eof_check_brace");
    try append_line(out, "eof_check_brace:");
    try append_line(out, "  %has_brace = icmp sgt i64 %brace_depth, 0");
    try append_line(out, "  br i1 %has_brace, label %eof_brace, label %eof_check_bracket");
    try append_line(out, "eof_check_bracket:");
    try append_line(out, "  %has_bracket = icmp sgt i64 %bracket_depth, 0");
    try append_line(out, "  br i1 %has_bracket, label %eof_bracket, label %ok");
    try append_eof_error_return(out, "eof_paren", "2");
    try append_eof_error_return(out, "eof_brace", "3");
    try append_eof_error_return(out, "eof_bracket", "4");
    try append_line(out, "ok:");
    try append_line(out, "  ret i64 0");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_eof_error_return(
    out: &var std::string::String,
    label_name: []u8,
    code: []u8
) -> !void {
    try out.append_bytes(label_name);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label_name);
    try out.append_bytes("_index = add i64 %source_len, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label_name);
    try out.append_bytes("_scaled = mul i64 %");
    try out.append_bytes(label_name);
    try out.append_bytes("_index, 10");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(label_name);
    try out.append_bytes("_packed = add i64 %");
    try out.append_bytes(label_name);
    try out.append_bytes("_scaled, ");
    try out.append_bytes(code);
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret i64 %");
    try out.append_bytes(label_name);
    try out.append_bytes("_packed");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_check_parse_write_expected_eof_function(out: &var std::string::String) -> !void {
    try append_line(out, "define i1 @kizu_selfhost__check_parse_write_expected_eof(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %source,");
    try append_line(out, "  i64 %index,");
    try append_line(out, "  %kizu.slice.u8 %prefix");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out,
        "  %prefix_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %prefix)");
    try append_line(out, "  %prefix_ok = extractvalue %kizu.error.void %prefix_write, 0");
    try append_line(out, "  br i1 %prefix_ok, label %write_position, label %false");
    try append_line(out, "write_position:");
    try append_line(out,
        "  %position_ok = call i1 @kizu_selfhost__parse_write_position_suffix(%kizu.owned %io, %kizu.slice.u8 %source, i64 %index)");
    try append_line(out, "  br i1 %position_ok, label %write_failed, label %false");
    try append_line(out, "write_failed:");
    try append_global_slice(out, "check", "parse_failed", "line", "parse_failed_line", "20");
    try append_line(out,
        "  %failed_write = call %kizu.error.void @kizu_rt_io_write_stderr(%kizu.owned %io, %kizu.slice.u8 %check_parse_failed_line_slice)");
    try append_line(out, "  %failed_ok = extractvalue %kizu.error.void %failed_write, 0");
    try append_line(out, "  br i1 %failed_ok, label %true, label %false");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_call_i64(
    out: &var std::string::String,
    value_prefix: []u8,
    value_name: []u8,
    function_name: []u8,
    bytes_name: []u8
) -> !void {
    try append_value_def(out, value_prefix, value_name);
    try out.append_bytes(" = call i64 @kizu_selfhost__");
    try out.append_bytes(function_name);
    try out.append_bytes("(%kizu.slice.u8 %");
    try out.append_bytes(bytes_name);
    try out.append_bytes(")");
    try out.append_byte(cast<u8>(10));
    return;
}

