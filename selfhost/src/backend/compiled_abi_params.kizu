import selfhost::backend::compiled_type_resolver;
import selfhost::backend::compiled_canonical_facts;
import selfhost::backend::compiled_instance_context;
import selfhost::backend::compiled_util;
import selfhost::backend::ir_index;

// append_params_spec derives the compiled params_spec from signature facts.
// Every parameter is resolved by the same fact-driven type resolver used by
// MIR values; this module owns no nominal or runtime-handle type table.
pub fn append_params_spec(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    var lookup_index = try ir_index::build(ir_bytes);
    defer lookup_index.deinit();
    try append_params_spec_indexed(&lookup_index, out, ir_bytes, function_name);
    return;
}

pub fn append_params_spec_indexed(
    index: &ir_index::IrIndex,
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let space = cast<u8>(32);
    let colon = cast<u8>(58);
    let semicolon = cast<u8>(59);
    let module_prefix = try compiled_type_resolver::function_owner_module_indexed(
        index, ir_bytes, function_name
    );
    var entry_index = ir_index::first_matching_entry(
        index, ir_bytes, prefix, "", function_name
    );
    var emitted = 0;
    while ir_index::entry_matches_query(
        index, ir_bytes, entry_index, prefix, "", function_name
    ) {
        let name_end = ir_index::entry_key_end(index, entry_index);
        let line_end_pos = ir_index::entry_line_end(index, entry_index);
        if name_end < byte_len and ir_bytes[name_end] == space {
            let entry = ir_bytes[name_end..line_end_pos];
            let entry_len = std::mem::len(entry);
            let space1 = compiled_util::find_byte(entry, space, 1);
            let colon1 = compiled_util::find_byte(entry, colon, 0);
            let colon2 = compiled_util::find_byte(entry, colon, colon1 + 1);
            if space1 >= colon1 or colon2 >= entry_len {
                return error("abi mapper: invalid signature param fact");
            }
            let param_name = entry[space1 + 1..colon1];
            let kizu_type = entry[colon2 + 1..entry_len];
            let abi_type = try compiled_type_resolver::resolve_indexed(
                index, ir_bytes, module_prefix, kizu_type
            );
            if emitted > 0 { try out.append_byte(semicolon); }
            try out.append_bytes(abi_type);
            try out.append_byte(space);
            try out.append_bytes(param_name);
            emitted = emitted + 1;
        }
        entry_index = entry_index + 1;
    }
    return;
}

pub fn append_params_spec_instance_indexed(
    index: &ir_index::IrIndex,
    canonical: &compiled_canonical_facts::CanonicalFactTable,
    context: &compiled_instance_context::InstanceContext,
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let prefix = "function-signature-param ";
    let space = cast<u8>(32);
    let colon = cast<u8>(58);
    let semicolon = cast<u8>(59);
    var entry = ir_index::first_matching_entry(
        index, ir_bytes, prefix, "", function_name
    );
    var emitted = 0;
    var param_index = 0;
    while ir_index::entry_matches_query(
        index, ir_bytes, entry, prefix, "", function_name
    ) {
        let name_end = ir_index::entry_key_end(index, entry);
        let line_end = ir_index::entry_line_end(index, entry);
        let value = ir_bytes[name_end..line_end];
        let first_space = compiled_util::find_byte(value, space, 1);
        let first_colon = compiled_util::find_byte(value, colon, 0);
        let second_colon = compiled_util::find_byte(
            value, colon, first_colon + 1
        );
        if first_space >= first_colon or second_colon >= std::mem::len(value) {
            return error("abi mapper: invalid signature param fact");
        }
        let param_name = value[first_space + 1..first_colon];
        let mode = value[first_colon + 1..second_colon];
        let canonical_id = try compiled_instance_context::param_type_id(
            context, param_index
        );
        if std::mem::equal_bytes(mode, "runtime") {
            let abi_type = try compiled_canonical_facts::parsed_canonical_runtime_abi(
                index, canonical, ir_bytes, canonical_id
            );
            if emitted > 0 { try out.append_byte(semicolon); }
            try out.append_bytes(abi_type);
            try out.append_byte(space);
            try out.append_bytes(param_name);
            emitted = emitted + 1;
        } else {
            if !std::mem::equal_bytes(mode, "comptime") {
                return error("abi mapper: invalid parameter mode");
            }
        }
        param_index = param_index + 1;
        entry = entry + 1;
    }
    if param_index != compiled_instance_context::param_len(context) {
        return error("compiled instance signature parameter coverage mismatch");
    }
    return;
}

// gate pins exact canonical, module-local, import-alias, generic owned-handle,
// and nominal struct resolution through one ABI parameter path.
pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let facts = "abi-repr Allocator %kizu.owned
abi-repr Io %kizu.owned
abi-repr []u8 %kizu.slice.u8
abi-repr std::array::Array %kizu.owned
abi-repr std::map::Map %kizu.owned
abi-repr std::atomic::Atomic ptr
abi-repr std::channel::Channel ptr
abi-repr std::string::String %kizu.owned
module-alias selfhost::source::loader::source selfhost::source::
module-alias selfhost::source::loader::std selfhost::wrong::
package-root std present
package-root selfhost present
function-owner-module selfhost::source::loader::demo selfhost::source::loader::
type-llvm std::kizu::lexer::Position %kizu.kizu.lexer.position
type-llvm std::kizu::lexer::Token %kizu.kizu.lexer.token
type-llvm selfhost::source::SourceFile %kizu.selfhost.source.source_file
type-llvm selfhost::source::loader::LocalRecord %kizu.selfhost.source.loader.local_record
type-llvm LocalRecord %wrong.global.local_record
function-signature-param selfhost::source::loader::demo 0 byte:runtime:u8
function-signature-param selfhost::source::loader::demo 1 count:runtime:usize
function-signature-param selfhost::source::loader::demo 2 source:runtime:[]u8
function-signature-param selfhost::source::loader::demo 3 pos:runtime:std::kizu::lexer::Position
function-signature-param selfhost::source::loader::demo 4 tok:runtime:std::kizu::lexer::Token
function-signature-param selfhost::source::loader::demo 5 file:runtime:&source::SourceFile
function-signature-param selfhost::source::loader::demo 6 local:runtime:LocalRecord
function-signature-param selfhost::source::loader::demo 7 values:runtime:&var_std::array::Array<LocalRecord>
function-signature-param selfhost::source::loader::demo 8 table:runtime:std::map::Map<[]u8, LocalRecord>
function-body selfhost::source::loader::demo";

    var spec = std::string::String(allocator);
    try append_params_spec(&var spec, facts, "selfhost::source::loader::demo");
    let expected = "i8 byte;i64 count;%kizu.slice.u8 source;%kizu.kizu.lexer.position pos;%kizu.kizu.lexer.token tok;%kizu.selfhost.source.source_file file;%kizu.selfhost.source.loader.local_record local;%kizu.owned values;%kizu.owned table";
    let spec_bytes = spec.as_bytes();
    std::testing::expect_equal<[]u8>(expected, spec_bytes);

    var lookup = try ir_index::build(facts);
    defer lookup.deinit();
    std::testing::expect_equal<[]u8>(
        "%kizu.kizu.lexer.token",
        try compiled_type_resolver::resolve_indexed(
            &lookup, facts, "selfhost::source::loader::", "std::kizu::lexer::Token"
        )
    );
    std::testing::expect_equal<[]u8>(
        "%kizu.selfhost.source.loader.local_record",
        try compiled_type_resolver::resolve_indexed(
            &lookup, facts, "selfhost::source::loader::", "LocalRecord"
        )
    );
    std::testing::expect_equal<[]u8>(
        "ptr",
        try compiled_type_resolver::resolve_indexed(
            &lookup, facts, "selfhost::source::loader::", "std::atomic::Atomic<i64>"
        )
    );
    std::testing::expect_equal<[]u8>(
        "ptr",
        try compiled_type_resolver::resolve_indexed(
            &lookup, facts, "selfhost::source::loader::", "std::channel::Channel<[]u8>"
        )
    );
    print("abi-params-spec");
    print(expected);
    print("abi-params-count");
    print(9);
    spec.deinit();
    return;
}

pub fn gate_unsupported_type() -> !void {
    let facts = "abi-repr Allocator %kizu.owned";
    var lookup = try ir_index::build(facts);
    defer lookup.deinit();
    let abi = try compiled_type_resolver::resolve_indexed(
        &lookup, facts, "selfhost::backend::", "Unregistered"
    );
    print(abi);
    return;
}

pub fn gate_duplicate_type_fact() -> !void {
    let facts = "type-llvm demo::Record %demo.record
type-llvm demo::Record %demo.record";
    var lookup = try ir_index::build(facts);
    defer lookup.deinit();
    let abi = try compiled_type_resolver::resolve_indexed(
        &lookup, facts, "demo::", "demo::Record"
    );
    print(abi);
    return;
}

pub fn gate_conflicting_type_fact() -> !void {
    let facts = "type-llvm demo::Record %demo.record
type-llvm demo::Record %demo.other";
    var lookup = try ir_index::build(facts);
    defer lookup.deinit();
    let abi = try compiled_type_resolver::resolve_indexed(
        &lookup, facts, "demo::", "demo::Record"
    );
    print(abi);
    return;
}

pub fn gate_invalid_enum_representation() -> !void {
    let facts = "enum-type demo::State i8";
    var lookup = try ir_index::build(facts);
    defer lookup.deinit();
    let abi = try compiled_type_resolver::resolve_indexed(
        &lookup, facts, "demo::", "State"
    );
    print(abi);
    return;
}

pub fn gate_variant_only_enum() -> !void {
    let facts = "enum-variant demo::State Ready 0";
    var lookup = try ir_index::build(facts);
    defer lookup.deinit();
    let abi = try compiled_type_resolver::resolve_indexed(
        &lookup, facts, "demo::", "State"
    );
    print(abi);
    return;
}

// gate_local_union_abi pins a bare local union spelling resolved through its
// function-owner module and exact union facts. No opaque nominal-name special
// case participates.
pub fn gate_local_union_abi() -> !void {
    let allocator = std::mem::page_allocator();
    let facts = "union-type std::kizu::ast::AstData %kizu.kizu.ast.ast_data
union-variant std::kizu::ast::AstData Empty 0 void
function-owner-module std::kizu::ast::ast_add_node std::kizu::ast::
function-signature-param std::kizu::ast::ast_add_node 0 data:runtime:AstData";
    var spec = std::string::String(allocator);
    defer spec.deinit();
    try append_params_spec(
        &var spec, facts, "std::kizu::ast::ast_add_node"
    );
    let bytes = spec.as_bytes();
    print(bytes);
    return;
}
