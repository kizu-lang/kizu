import selfhost::backend::compiled_util;

// kizu_type_to_abi maps a single Kizu parameter type spelling to its LLVM ABI
// type. This is the strict ABI mapper (Agent B, tracker 1069): unlike
// compiled_type_lower::kizu_type_to_llvm it never falls back to a fact lookup,
// so an unsupported type is an explicit error rather than a silently-resolved
// guess. Callers that derive a compiled params_spec from a function signature
// route every parameter type through here.
pub fn kizu_type_to_abi(kizu_type: []u8) -> ![]u8 {
    let type_len = std::mem::len(kizu_type);
    if type_len == 0 {
        return error("abi mapper: empty parameter type");
    }
    // A leading '&' borrow marker carries no ABI difference from its pointee:
    // borrowed values are passed by the same representation, so strip it and map
    // the underlying type.
    if kizu_type[0] == cast<u8>(38) {
        return try kizu_type_to_abi(kizu_type[1..type_len]);
    }
    // A '&var' mutable borrow marker records the 'var' keyword after the '&'. The
    // recorded type token lowers source spaces to underscores, so '&var Array<T>'
    // arrives as '&var_Array<T>'; once the leading '&' is stripped above, the 'var_'
    // marker reaches here. A mutable borrow shares its pointee representation, so strip
    // it and map the underlying type (the formatter's indices: &var
    // std::array::Array<i64>, issue 1165).
    if std::mem::starts_with(kizu_type, "var_") {
        return try kizu_type_to_abi(kizu_type[4..type_len]);
    }
    if std::mem::equal_bytes(kizu_type, "u8") {
        return "i8";
    }
    // usize and i64 share the native word ABI.
    if std::mem::equal_bytes(kizu_type, "usize") {
        return "i64";
    }
    if std::mem::equal_bytes(kizu_type, "i64") {
        return "i64";
    }
    // bool lowers to the i1 ABI. The selfhost::ir::codegen builder
    // build_main_print_program binds a from_codegen_lowering: bool flag, so the
    // codegen compiled closure derives its params_spec through this mapping.
    if std::mem::equal_bytes(kizu_type, "bool") {
        return "i1";
    }
    if std::mem::equal_bytes(kizu_type, "[]u8") {
        return "%kizu.slice.u8";
    }
    if std::mem::equal_bytes(kizu_type, "TokenKind") {
        return "i64";
    }
    if std::mem::equal_bytes(kizu_type, "std::kizu::lexer::TokenKind") {
        return "i64";
    }
    // SourceKind is a selfhost enum, so it shares the native i64 ABI. The
    // selfhost::source closures live inside the source module, so they spell it
    // bare as 'SourceKind'; the loader closures spell it as 'source::SourceKind'
    // through their 'import selfhost::source' alias; the fully qualified form is
    // accepted too so a resolved spelling maps identically.
    if std::mem::equal_bytes(kizu_type, "SourceKind") {
        return "i64";
    }
    if std::mem::equal_bytes(kizu_type, "source::SourceKind") {
        return "i64";
    }
    if std::mem::equal_bytes(kizu_type, "selfhost::source::SourceKind") {
        return "i64";
    }
    // SourceFile is the selfhost::source record struct. Its closures take it by
    // borrow ('&SourceFile'), and the leading '&' is stripped above, so the bare
    // spelling is what reaches here.
    if std::mem::equal_bytes(kizu_type, "SourceFile") {
        return "%kizu.selfhost.source.source_file";
    }
    if std::mem::equal_bytes(kizu_type, "Position") {
        return "%kizu.kizu.lexer.position";
    }
    if std::mem::equal_bytes(kizu_type, "std::kizu::lexer::Position") {
        return "%kizu.kizu.lexer.position";
    }
    if std::mem::equal_bytes(kizu_type, "Token") {
        return "%kizu.kizu.lexer.token";
    }
    if std::mem::equal_bytes(kizu_type, "std::kizu::lexer::Token") {
        return "%kizu.kizu.lexer.token";
    }
    // Ast, NodeId, and ChildRange are the std::kizu::ast value types the
    // selfhost::ast node-count traversal closure passes by value. The closure
    // members spell them fully qualified, so the resolved facts carry the
    // std::kizu::ast:: path; each maps to its existing stage2 LLVM value type so the
    // closure derives its params_spec from signature facts without a handwritten
    // table.
    if std::mem::equal_bytes(kizu_type, "std::kizu::ast::Ast") {
        return "%kizu.kizu.ast.ast";
    }
    if std::mem::equal_bytes(kizu_type, "std::kizu::ast::NodeId") {
        return "%kizu.kizu.ast.node_id";
    }
    if std::mem::equal_bytes(kizu_type, "std::kizu::ast::ChildRange") {
        return "%kizu.kizu.ast.child_range";
    }
    // BinaryOp is the std::kizu::ast operator enum the run codegen tape lowering
    // passes by value (lower_code_binary / code_binary_kind); like every enum it
    // shares the native i64 ABI.
    if std::mem::equal_bytes(kizu_type, "std::kizu::ast::BinaryOp") {
        return "i64";
    }
    // Span is the std::kizu::ast value type the std::kizu::parser span helpers
    // borrow ('&std::kizu::ast::Span'); the leading '&' is stripped above, so the
    // fully qualified spelling reaches here and maps to its stage2 LLVM value type.
    if std::mem::equal_bytes(kizu_type, "std::kizu::ast::Span") {
        return "%kizu.kizu.ast.span";
    }
    // ParseNode is the std::kizu::parser cursor record the postfix predicates pass
    // by value. It is referenced bare inside the parser module, so the resolved
    // fact carries the unqualified 'ParseNode' spelling; it maps to its existing
    // stage2 LLVM value type so the parser closure derives its params_spec from
    // signature facts without a handwritten table.
    if std::mem::equal_bytes(kizu_type, "ParseNode") {
        return "%kizu.kizu.parser.parse_node";
    }
    // Value and Program are the selfhost::ir::codegen record structs the backend
    // program builder / metadata / value-helper closure passes by value or borrow.
    // The closure members reference them bare inside the codegen module, so the
    // resolved facts carry the unqualified spelling (Program arrives as &Program and
    // the leading '&' is stripped above); each maps to its existing stage2 LLVM value
    // type so the closure derives its params_spec from signature facts without a
    // handwritten table.
    if std::mem::equal_bytes(kizu_type, "Value") {
        return "%kizu.selfhost.codegen.value";
    }
    if std::mem::equal_bytes(kizu_type, "Program") {
        return "%kizu.selfhost.codegen.program";
    }
    // std::array::Array<T> is the runtime-owned dynamic-array handle, like
    // std::string::String; its ABI is the %kizu.owned handle regardless of the element
    // type T, so a single prefix rule covers every Array<T> param (the formatter's
    // tokens: &std::array::Array<Token>, issue 1165). The leading '&' borrow marker is
    // already stripped above, and borrowed values share the same representation.
    if std::mem::starts_with(kizu_type, "std::array::Array<") {
        return "%kizu.owned";
    }
    // Allocator is the runtime allocator handle, passed by the %kizu.owned representation
    // like every other runtime-owned handle. The leading-import collector takes it to build
    // its Array<i64> through @kizu_rt_array_new (the formatter's allocator: Allocator,
    // issue 1165). It is referenced bare through the 'Allocator' runtime alias, so the
    // resolved fact carries the unqualified spelling.
    if std::mem::equal_bytes(kizu_type, "Allocator") {
        return "%kizu.owned";
    }
    // std::string::String is the runtime-owned byte-buffer handle, like std::array::Array<T>;
    // its ABI is the %kizu.owned handle, mutated through the @kizu_rt_string_* ABI. The import
    // output helpers take the formatter's accumulator by mutable borrow ('out: &var
    // std::string::String', issue 1165); the leading '&' and 'var_' markers are stripped above,
    // so the bare spelling reaches here.
    if std::mem::equal_bytes(kizu_type, "std::string::String") {
        return "%kizu.owned";
    }
    if std::mem::equal_bytes(kizu_type, "String") {
        return "%kizu.owned";
    }
    return error("abi mapper: unsupported parameter type");
}

// append_params_spec derives the compiled params_spec string for one function
// from its 'function-signature-param' facts and appends it to 'out'. The facts
// are emitted in parameter order, so walking them top-to-bottom preserves the
// signature order. Each entry is rendered as '<abi-type> <name>' joined by ';',
// matching the layout consumed by compiled_signature::find_param_type. Any
// parameter whose Kizu type is unsupported makes the whole derivation an
// explicit error (no fallback).
pub fn append_params_spec(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8
) -> !void {
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let name_len = std::mem::len(function_name);
    let space = cast<u8>(32);
    let colon = cast<u8>(58);
    let semicolon = cast<u8>(59);
    var index = 0;
    var emitted = 0;
    while index + prefix_len + name_len < byte_len {
        if compiled_util::is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let name_start = index + prefix_len;
            let name_end = name_start + name_len;
            if name_end < byte_len and
                std::mem::equal_bytes(ir_bytes[name_start..name_end], function_name) and
                ir_bytes[name_end] == space {
                let line_end_pos = compiled_util::find_line_end(ir_bytes, name_end);
                // entry == ' <index> <name>:runtime:<type>'
                let entry = ir_bytes[name_end..line_end_pos];
                let entry_len = std::mem::len(entry);
                let space1 = compiled_util::find_byte(entry, space, 1);
                let colon1 = compiled_util::find_byte(entry, colon, 0);
                let colon2 = compiled_util::find_byte(entry, colon, colon1 + 1);
                if space1 >= colon1 or colon2 >= entry_len {
                    return error("abi mapper: invalid signature param fact");
                }
                let param_name = entry[space1 + 1..colon1];
                let kizu_type = entry[colon2 + 1..entry_len];
                let abi_type = try kizu_type_to_abi(kizu_type);
                if emitted > 0 {
                    try out.append_byte(semicolon);
                }
                try out.append_bytes(abi_type);
                try out.append_byte(space);
                try out.append_bytes(param_name);
                emitted = emitted + 1;
            }
        }
        index = compiled_util::find_line_end(ir_bytes, index) + 1;
    }
    return;
}

// gate is the compiled_abi_params behavior gate (Agent B, tracker 1069). It
// feeds fake 'function-signature-param' facts through append_params_spec and
// asserts the derived compiled params_spec matches the layout the backend
// consumes: '<abi-type> <name>' entries joined by ';'. Every supported Kizu
// parameter type is exercised (u8, usize, i64, []u8, lexer Position/Token) plus
// a leading-'&' borrow marker, which is stripped before mapping. Facts for an
// unrelated function and a non-param line are interleaved to confirm the parser
// only consumes the requested signature's parameters in order. The facts are an
// owned multi-line string literal (newlines embedded directly) so the parsed
// param-name slices can be copied into 'out' without a borrow escape; the
// trailing 'function-body' line keeps the final param inside the parser's loop
// bound.
pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();

    let facts = "function-signature demo
function-signature-param other 0 ignored:runtime:u8
function-signature-param demo 0 byte:runtime:u8
function-signature-param demo 1 count:runtime:usize
function-signature-param demo 2 offset:runtime:i64
function-signature-param demo 3 source:runtime:[]u8
function-signature-param demo 4 pos:runtime:std::kizu::lexer::Position
function-signature-param demo 5 tok:runtime:std::kizu::lexer::Token
function-signature-param demo 6 ref:runtime:&u8
function-body demo";

    var spec = std::string::String(allocator);
    try append_params_spec(spec, facts, "demo");

    let expected = "i8 byte;i64 count;i64 offset;%kizu.slice.u8 source;%kizu.kizu.lexer.position pos;%kizu.kizu.lexer.token tok;i8 ref";
    let spec_bytes = spec.as_bytes();
    std::testing::expect_equal<[]u8>(expected, spec_bytes);

    // Spot-check the scalar mapper directly, including a borrowed slice.
    std::testing::expect_equal<[]u8>("i8", try kizu_type_to_abi("u8"));
    std::testing::expect_equal<[]u8>("i64", try kizu_type_to_abi("usize"));
    std::testing::expect_equal<[]u8>("i64", try kizu_type_to_abi("i64"));
    std::testing::expect_equal<[]u8>("%kizu.slice.u8", try kizu_type_to_abi("[]u8"));
    std::testing::expect_equal<[]u8>("%kizu.slice.u8", try kizu_type_to_abi("&[]u8"));

    // The loader 'source_file' closure mixes a SourceKind enum (i64 ABI) with
    // scalar and slice params, so derive its compiled params_spec end-to-end to
    // confirm the loader closures no longer need a handwritten table. SourceKind
    // appears via the 'import selfhost::source' alias spelling.
    let loader_facts = "function-signature-param source_file 0 id:runtime:i64
function-signature-param source_file 1 kind:runtime:source::SourceKind
function-signature-param source_file 2 package_name:runtime:[]u8
function-signature-param source_file 3 module_start:runtime:i64
function-signature-param source_file 4 module_end:runtime:i64
function-signature-param source_file 5 path:runtime:[]u8
function-signature-param source_file 6 text:runtime:[]u8
function-body source_file";

    var loader_spec = std::string::String(allocator);
    try append_params_spec(loader_spec, loader_facts, "source_file");

    let loader_expected = "i64 id;i64 kind;%kizu.slice.u8 package_name;i64 module_start;i64 module_end;%kizu.slice.u8 path;%kizu.slice.u8 text";
    let loader_spec_bytes = loader_spec.as_bytes();
    std::testing::expect_equal<[]u8>(loader_expected, loader_spec_bytes);

    // Both SourceKind spellings (aliased and fully qualified) share the i64 ABI.
    std::testing::expect_equal<[]u8>("i64", try kizu_type_to_abi("source::SourceKind"));
    std::testing::expect_equal<[]u8>("i64", try kizu_type_to_abi("selfhost::source::SourceKind"));

    // std::string::String is the runtime-owned %kizu.owned handle, both bare and through a
    // '&var' mutable borrow (the import output helpers' 'out: &var std::string::String',
    // issue 1165). The '&' and 'var_' markers are stripped before mapping.
    std::testing::expect_equal<[]u8>("%kizu.owned", try kizu_type_to_abi("std::string::String"));
    std::testing::expect_equal<[]u8>(
        "%kizu.owned",
        try kizu_type_to_abi("&var_std::string::String")
    );

    spec.deinit();
    loader_spec.deinit();

    print("abi-params-spec");
    print(expected);
    print("abi-params-count");
    print(7);
    print("abi-params-loader-spec");
    print(loader_expected);
    return;
}

// gate_unsupported_type asserts that an unknown Kizu parameter type is an
// explicit error rather than a silently-resolved guess (no fact-lookup
// fallback). The 'try' propagates the mapper's error so RunEntry surfaces it as
// a runtime error to the Go gate.
pub fn gate_unsupported_type() -> !void {
    let abi = try kizu_type_to_abi("f32");
    print(abi);
    return;
}
