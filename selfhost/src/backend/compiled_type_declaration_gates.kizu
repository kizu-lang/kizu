pub fn gate_recursive_union_layout() -> !void {
    let facts = "abi-repr []u8 %kizu.slice.u8
union-type app::Inner %kizu.app.inner
union-variant app::Inner Empty 0 void
union-variant app::Inner Count 1 i64
type-llvm app::Wide %kizu.app.wide
struct-field app::Wide 0 bytes []u8
struct-field app::Wide 1 tail i64
union-type app::Outer %kizu.app.outer
union-variant app::Outer Inner 0 Inner
union-variant app::Outer Wide 1 Wide";
    var wanted = try roots("app::Outer");
    defer wanted.deinit();
    var out = std::string::String(std::mem::page_allocator());
    defer out.deinit();
    try compiled_type_declarations::append_reachable_declarations(
        &var out, facts, &wanted
    );
    let bytes = out.as_bytes();
    print(bytes);
    return;
}

pub fn gate_scalar_abi_layout() -> !void {
    let facts = "union-type app::W8 %kizu.app.w8
union-variant app::W8 Value 0 i8
union-type app::W16 %kizu.app.w16
union-variant app::W16 Value 0 u16
union-type app::W32 %kizu.app.w32
union-variant app::W32 Value 0 i32
union-type app::W64 %kizu.app.w64
union-variant app::W64 Value 0 u64
union-type app::F32 %kizu.app.f32
union-variant app::F32 Value 0 f32
union-type app::F64 %kizu.app.f64
union-variant app::F64 Value 0 f64";
    var index = try ir_index::build(facts);
    defer index.deinit();
    let i8_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "app::", "i8"
    );
    let u16_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "app::", "u16"
    );
    let i32_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "app::", "i32"
    );
    let u64_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "app::", "u64"
    );
    let isize_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "app::", "isize"
    );
    let f32_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "app::", "f32"
    );
    let f64_type = try compiled_type_resolver::resolve_type_indexed(
        &index, facts, "app::", "f64"
    );
    if fixed_abi_contract::from_llvm(i8_type.abi).kind !=
        fixed_abi_contract::FixedAbiKind::Integer8 or
        fixed_abi_contract::from_llvm(u16_type.abi).kind !=
            fixed_abi_contract::FixedAbiKind::Integer16 or
        fixed_abi_contract::from_llvm(i32_type.abi).kind !=
            fixed_abi_contract::FixedAbiKind::Integer32 or
        fixed_abi_contract::from_llvm(u64_type.abi).kind !=
            fixed_abi_contract::FixedAbiKind::Integer64 or
        fixed_abi_contract::from_llvm(isize_type.abi).kind !=
            fixed_abi_contract::FixedAbiKind::Integer64 or
        fixed_abi_contract::from_llvm(f32_type.abi).kind !=
            fixed_abi_contract::FixedAbiKind::Float32 or
        fixed_abi_contract::from_llvm(f64_type.abi).kind !=
            fixed_abi_contract::FixedAbiKind::Float64 {
        return error("compiled scalar ABI mismatch");
    }
    let cap8 = try compiled_type_layout::union_payload_capacity(
        &index, facts, "app::W8"
    );
    let cap16 = try compiled_type_layout::union_payload_capacity(
        &index, facts, "app::W16"
    );
    let cap32 = try compiled_type_layout::union_payload_capacity(
        &index, facts, "app::W32"
    );
    let cap64 = try compiled_type_layout::union_payload_capacity(
        &index, facts, "app::W64"
    );
    let capf32 = try compiled_type_layout::union_payload_capacity(
        &index, facts, "app::F32"
    );
    let capf64 = try compiled_type_layout::union_payload_capacity(
        &index, facts, "app::F64"
    );
    print(cap8);
    print(cap16);
    print(cap32);
    print(cap64);
    print(capf32);
    print(capf64);
    return;
}

pub fn gate_reachable_generic_arguments() -> !void {
    let facts = "abi-repr std::channel::Channel ptr
abi-repr std::array::Array %kizu.owned
abi-repr ptr ptr
nullable-abi-repr ptr ptr
abi-repr []u8 %kizu.slice.u8
type-llvm app::Model %kizu.app.model
struct-field app::Model 0 value i64";
    var wanted = try roots(
        "std::channel::Channel<[]u8>;std::channel::Channel<std::array::Array<app::Model>>;ptr<app::Model>;?ptr<app::Model>"
    );
    defer wanted.deinit();
    var out = std::string::String(std::mem::page_allocator());
    defer out.deinit();
    try compiled_type_declarations::append_reachable_declarations(
        &var out, facts, &wanted
    );
    let bytes = out.as_bytes();
    print(bytes);
    return;
}

// The production indexed path must treat function type parameters as scoped,
// uninstantiated inputs while preserving fixed outer generic ABIs. A concrete
// argument with the same nesting still participates in declaration traversal.
pub fn gate_reachable_function_type_parameters() -> !void {
    let facts = "function-owner-module app::generic::make app::generic::
function-type-parameter app::generic::make 0 T
function-type-parameter app::generic::make 1 K
function-type-parameter app::generic::make 2 V
reachable-type app::generic::make T
reachable-type app::generic::make !T
reachable-type app::generic::make std::channel::Channel<std::array::Array<T>>
reachable-type app::generic::make std::map::Map<K,V>
function-owner-module app::concrete::make app::concrete::
reachable-type app::concrete::make std::channel::Channel<std::array::Array<app::Model>>
abi-repr std::channel::Channel ptr
abi-repr std::array::Array %kizu.owned
abi-repr std::map::Map ptr
type-llvm app::Model %kizu.app.model
struct-field app::Model 0 value i64";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var out = std::string::String(std::mem::page_allocator());
    defer out.deinit();
    try compiled_type_declarations::append_reachable_fact_declarations_indexed(
        &var out, &index, facts
    );
    let bytes = out.as_bytes();
    print(bytes);
    return;
}

// A formal belongs only to its declaring function. The plain function's T
// must reach the normal resolver and fail instead of being globally ignored.
pub fn gate_function_type_parameter_scope() -> !void {
    let facts = "function-owner-module app::generic::make app::generic::
function-type-parameter app::generic::make 0 T
reachable-type app::generic::make T
function-owner-module app::plain::run app::plain::
reachable-type app::plain::run T";
    var index = try ir_index::build(facts);
    defer index.deinit();
    var out = std::string::String(std::mem::page_allocator());
    defer out.deinit();
    try compiled_type_declarations::append_reachable_fact_declarations_indexed(
        &var out, &index, facts
    );
    return;
}

pub fn gate_function_type_parameter_gap() -> !void {
    let facts = "function-owner-module app::generic::make app::generic::
