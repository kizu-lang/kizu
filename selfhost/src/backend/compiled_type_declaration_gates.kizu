import selfhost::backend::compiled_type_declarations;
import selfhost::backend::compiled_type_layout;
import selfhost::backend::compiled_type_resolver;
import selfhost::backend::ir_index;
import selfhost::abi::fixed_abi_contract;

fn roots(values: []u8) -> !std::array::Array<[]u8> {
    var result = std::array::Array<[]u8>(std::mem::page_allocator());
    var start = 0;
    var cursor = 0;
    while cursor <= std::mem::len(values) {
        if cursor == std::mem::len(values) or values[cursor] == cast<u8>(59) {
            try result.append(values[start..cursor]);
            start = cursor + 1;
        }
        cursor = cursor + 1;
    }
    return result;
}

