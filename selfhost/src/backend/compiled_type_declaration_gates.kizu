pub fn gate_non_nominal_shared_abi() -> !void {
    let facts = "abi-repr Box %kizu.owned
type-llvm decoy::Owned %kizu.owned
struct-field decoy::Owned 0 value i64";
    var wanted = try roots("Box");
    defer wanted.deinit();
    var out = std::string::String(std::mem::page_allocator());
    defer out.deinit();
    try compiled_type_declarations::append_reachable_declarations(&var out, facts, &wanted);
    if out.len() != 0 {
        return error("type declaration registry: nonnominal emitted nominal declaration");
    }
    print("exact-nonnominal");
    return;
}

