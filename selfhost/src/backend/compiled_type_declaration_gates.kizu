td::kizu::ast::Span;std::kizu::ast::TokenId;std::kizu::ast::SymbolId;std::kizu::ast::ChildRange;std::kizu::diagnostic::RelatedSpan;std::kizu::diagnostic::Diagnostic");
    defer wanted.deinit();
    var out = std::string::String(std::mem::page_allocator());
    defer out.deinit();
    try compiled_type_declarations::append_reachable_declarations(&var out, facts, &wanted);
    let out_bytes = out.as_bytes();
    print(out_bytes);
    return;
}

pub fn gate_direct_cycle() -> !void {
    let facts = "type-llvm cycle::Node %kizu.cycle.node
struct-field cycle::Node 0 next Node";
    try run_failure_gate(facts, "cycle::Node");
    return;
}

pub fn gate_mutual_cycle() -> !void {
    let facts = "type-llvm cycle::Left %kizu.cycle.left
struct-field cycle::Left 0 right Right
type-llvm cycle::Right %kizu.cycle.right
struct-field cycle::Right 0 left Left";
    try run_failure_gate(facts, "cycle::Left");
    return;
}

pub fn gate_duplicate_field() -> !void {
    let facts = "type-llvm bad::Record %kizu.bad.record
struct-field bad::Record 0 first i64
struct-field bad::Record 0 second bool";
    try run_failure_gate(facts, "bad::Record");
    return;
}

