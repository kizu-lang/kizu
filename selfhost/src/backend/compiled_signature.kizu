import selfhost::backend::compiled_util;
import selfhost::backend::compiled_type_lower;
import selfhost::backend::compiled_type_resolver;
import selfhost::backend::compiled_canonical_facts;
import selfhost::backend::compiled_instance_context;
import selfhost::backend::ir_contract;
import selfhost::backend::ir_index;

pub fn append_params_signature(
    out: &var std::string::String,
    params_spec: []u8
) -> !void {
    let spec_len = std::mem::len(params_spec);
    if spec_len == 0 {
        return;
    }
    try out.append_byte(cast<u8>(10));
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    var param_index = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos >= entry_end {
            return error("compiled function: invalid params_spec");
        }
        let param_type = params_spec[pos..space_pos];
        let param_name = params_spec[space_pos + 1..entry_end];
        if param_index > 0 {
            try out.append_bytes(",");
            try out.append_byte(cast<u8>(10));
        }
        try out.append_bytes("  ");
        try out.append_bytes(param_type);
        try out.append_bytes(" %");
        try out.append_bytes(param_name);
        param_index = param_index + 1;
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    try out.append_byte(cast<u8>(10));
    return;
}

// first_param_name returns the name of the first parameter in a 'type name;...' params_spec.
// Owned-container struct constructors take their allocator as the leading parameter, so the
// fact-driven constructor emitter reads it here to source the @kizu_rt_array_new allocator
// argument without hardcoding a parameter name.
pub fn first_param_name(params_spec: []u8) -> ![]u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    let entry_end = compiled_util::find_byte(params_spec, semicolon, 0);
    let space_pos = compiled_util::find_byte(params_spec, space, 0);
    if space_pos >= entry_end or space_pos >= spec_len {
        return error("compiled function: empty params_spec has no first parameter");
    }
    return params_spec[space_pos + 1..entry_end];
}

pub fn find_param_type(params_spec: []u8, name: []u8) -> ![]u8 {
    let spec_len = std::mem::len(params_spec);
    let semicolon = cast<u8>(59);
    let space = cast<u8>(32);
    var pos = 0;
    while pos < spec_len {
        let entry_end = compiled_util::find_byte(params_spec, semicolon, pos);
        let space_pos = compiled_util::find_byte(params_spec, space, pos);
        if space_pos < entry_end {
            let param_type = params_spec[pos..space_pos];
            let param_name = params_spec[space_pos + 1..entry_end];
            if std::mem::equal_bytes(param_name, name) {
                return param_type;
            }
        }
        if entry_end < spec_len {
            pos = entry_end + 1;
        } else {
            pos = spec_len;
        }
    }
    return error("compiled function: param not found");
}

pub fn find_param_kizu_type(
    ir_bytes: []u8,
    module_prefix: []u8,
    var_name: []u8,
    params_spec: []u8
) -> ![]u8 {
    let _llvm_type = try find_param_type(params_spec, var_name);
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(module_prefix);
    var index = 0;
    while index + prefix_len < byte_len {
        if compiled_util::is_line_start(ir_bytes, index) and
            std::mem::equal_bytes(ir_bytes[index..index + prefix_len], prefix) {
            let after_prefix = index + prefix_len;
            if after_prefix + mp_len < byte_len and
                std::mem::equal_bytes(ir_bytes[after_prefix..after_prefix + mp_len], module_prefix) {
                let kizu_type = try extract_param_kizu_type_from_line(
                    ir_bytes, after_prefix, var_name
                );
                if std::mem::len(kizu_type) > 0 {
                    return kizu_type;
                }
            }
        }
        index = compiled_util::find_line_end(ir_bytes, index) + 1;
    }
    return error("compiled function: param kizu type not found");
}

pub fn find_param_kizu_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    module_prefix: []u8,
    var_name: []u8,
    params_spec: []u8
) -> ![]u8 {
    let _llvm_type = try find_param_type(params_spec, var_name);
    let byte_len = std::mem::len(ir_bytes);
    let prefix = "function-signature-param ";
    let prefix_len = std::mem::len(prefix);
    let mp_len = std::mem::len(module_prefix);
    var entry_index = ir_index::first_entry_with_fact_prefix(index, ir_bytes, prefix);
    while ir_index::entry_key_starts_with(index, ir_bytes, entry_index, prefix) {
        let line_start = ir_index::entry_line_start(index, entry_index);
        let after_prefix = line_start + prefix_len;
        if after_prefix + mp_len < byte_len and
            std::mem::equal_bytes(ir_bytes[after_prefix..after_prefix + mp_len], module_prefix) {
            let kizu_type = try extract_param_kizu_type_from_line(
                ir_bytes, after_prefix, var_name
            );
            if std::mem::len(kizu_type) > 0 {
                return kizu_type;
            }
        }
        entry_index = entry_index + 1;
    }
    return error("compiled function: param kizu type not found");
}

fn extract_param_kizu_type_from_line(
    ir_bytes: []u8,
    fn_start: i64,
    var_name: []u8
) -> ![]u8 {
    let byte_len = std::mem::len(ir_bytes);
    var pos = fn_start;
    while pos < byte_len and ir_bytes[pos] != cast<u8>(32) {
        pos = pos + 1;
    }
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    while pos < byte_len and ir_bytes[pos] >= cast<u8>(48) and ir_bytes[pos] <= cast<u8>(57) {
        pos = pos + 1;
    }
    while pos < byte_len and ir_bytes[pos] == cast<u8>(32) {
        pos = pos + 1;
    }
    let entry_start = pos;
    let line_end_pos = compiled_util::find_line_end(ir_bytes, pos);
    let entry = ir_bytes[entry_start..line_end_pos];
    let colon1 = compiled_util::find_byte(entry, cast<u8>(58), 0);
    let entry_len = std::mem::len(entry);
    if colon1 >= entry_len {
        return ir_bytes[0..0];
    }
    let param_name = entry[0..colon1];
    if !std::mem::equal_bytes(param_name, var_name) {
        return ir_bytes[0..0];
    }
    let colon2 = compiled_util::find_byte(entry, cast<u8>(58), colon1 + 1);
    if colon2 >= entry_len {
        return ir_bytes[0..0];
    }
    return entry[colon2 + 1..entry_len];
}

// resolve_struct_literal_declaration_indexed resolves the DECLARATION a struct literal builds, not
// just the ABI it lowers to. The ABI names a layout; the declaration names the field order that
// layout is indexed by, and a literal writes its fields in source order rather than declared order.
// Callers that have to map one to the other need canonical_identity, which is what the
// 'struct-field' facts are keyed by; the LLVM type alone does not spell it.
pub fn resolve_struct_literal_declaration_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    struct_literal_node: i64,
    bs: i64
) -> !compiled_type_resolver::ResolvedType {
    // nf tightens this struct-literal's own structural facts (its 'type' edge / name token and
    // 'body-struct-literal' detail) to its body-node line via the index; those facts sort
    // at-or-after that line, so a scan from nf is byte-identical to one from bs. The type-name
    // resolution below is index-keyed, so it is unaffected.
    let nf = ir_index::body_node_line_start_for_sequence(
        index, ir_bytes, function_name, struct_literal_node, bs
    );
    let type_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, struct_literal_node, "type", 0, nf
    );
    let type_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, type_node, nf
    );
    if std::mem::len(type_name) > 0 {
        return try compiled_type_resolver::resolve_type_indexed(
            index, ir_bytes, module_prefix, type_name
        );
    }
    let qualified_name = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-struct-literal ", function_name, struct_literal_node, nf
    );
    return try compiled_type_resolver::resolve_type_indexed(
        index, ir_bytes, module_prefix, qualified_name
    );
}

pub fn resolve_struct_literal_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    struct_literal_node: i64,
    bs: i64
) -> ![]u8 {
    let resolved = try resolve_struct_literal_declaration_indexed(
        index, ir_bytes, function_name, module_prefix, struct_literal_node, bs
    );
    return resolved.abi;
}

pub fn resolve_struct_literal_type(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    struct_literal_node: i64,
    bs: i64
) -> ![]u8 {
    var index = try ir_index::build(ir_bytes);
    defer index.deinit();
    return try resolve_struct_literal_type_indexed(
        &index, ir_bytes, function_name, module_prefix, struct_literal_node, bs
    );
}

// derive_callee_llvm_symbol mangles a call target from its (module_prefix, callee_name)
// pieces, where module_prefix + callee_name is the callee's fully-qualified Kizu name. It
// applies the same scheme as append_function_llvm_symbol so a cross-module callee resolves
// to the exact symbol its owning closure emits, whether owned by a selfhost module
// (selfhost::lexer::is_eof -> kizu_selfhost__lexer_is_eof) or the std kizu re-export
// (std::kizu::lexer::tokenize -> kizu_kizu__lexer_tokenize, mangled from the bare
// kizu::lexer path). callee_name carries no '::', so every module separator lives in
// module_prefix (which ends with '::'): the first '::' lowers to '__' and the rest to '_'.
pub fn derive_callee_llvm_symbol(
    out: &var std::string::String,
    module_prefix: []u8,
    callee_name: []u8
) -> !void {
    var prefix = module_prefix;
    if std::mem::starts_with(module_prefix, "std::kizu::") {
        let std_prefix = "std::";
        prefix = module_prefix[std::mem::len(std_prefix)..std::mem::len(module_prefix)];
    }
    try out.append_bytes("kizu_");
    let colon = cast<u8>(58);
    let underscore = cast<u8>(95);
    let prefix_len = std::mem::len(prefix);
    var index = 0;
    var first_separator = true;
    while index < prefix_len {
        let byte = prefix[index];
        if byte == colon and index + 1 < prefix_len and prefix[index + 1] == colon {
            if first_separator {
                try out.append_byte(underscore);
                try out.append_byte(underscore);
                first_separator = false;
            } else {
                try out.append_byte(underscore);
            }
            index = index + 2;
        } else {
            try out.append_byte(byte);
            index = index + 1;
        }
    }
    try out.append_bytes(callee_name);
    return;
}

// append_function_llvm_symbol derives the LLVM symbol for a fully qualified
// Kizu function name and appends it to 'out'. The scheme is 'kizu_' followed by
// the module path with its first '::' lowered to '__' and any remaining '::'
// lowered to '_'. Functions reached through the std re-export 'std::kizu::*' are
// mangled from their bare 'kizu::*' module path, so a leading 'std::' is
// stripped when the qualified name begins with 'std::kizu::'.
//   std::kizu::lexer::first_token -> kizu_kizu__lexer_first_token
//   std::kizu::lexer::next_token  -> kizu_kizu__lexer_next_token
//   std::mem::starts_with         -> kizu_std__mem_starts_with
//   selfhost::source::module_path -> kizu_selfhost__source_module_path
pub fn append_function_llvm_symbol(
    out: &var std::string::String,
    qualified_name: []u8
) -> !void {
    var path = qualified_name;
    if std::mem::starts_with(qualified_name, "std::kizu::") {
        let std_prefix = "std::";
        path = qualified_name[std::mem::len(std_prefix)..std::mem::len(qualified_name)];
    }
    try out.append_bytes("kizu_");
    let colon = cast<u8>(58);
    let underscore = cast<u8>(95);
    let path_len = std::mem::len(path);
    var index = 0;
    var first_separator = true;
    while index < path_len {
        let byte = path[index];
        if byte == colon and index + 1 < path_len and path[index + 1] == colon {
            if first_separator {
                try out.append_byte(underscore);
                try out.append_byte(underscore);
                first_separator = false;
            } else {
                try out.append_byte(underscore);
            }
            index = index + 2;
        } else {
            try out.append_byte(byte);
            index = index + 1;
        }
    }
    return;
}

pub fn extend_locals_spec(
    ir_bytes: []u8,
    current_spec: []u8,
    name: []u8,
    llvm_type: []u8
) -> ![]u8 {
    return current_spec;
}

pub fn derive_return_type(
    ir_bytes: []u8,
    function_name: []u8
) -> ![]u8 {
    var index = try ir_index::build(ir_bytes);
    defer index.deinit();
    return derive_return_type_indexed(&index, ir_bytes, function_name);
}

pub fn derive_return_type_indexed(
    index: &ir_index::IrIndex,
    ir_bytes: []u8,
    function_name: []u8
) -> ![]u8 {
    let function = try compiled_type_resolver::resolve_function_indexed(
        index, ir_bytes, ir_bytes[0..0], function_name
    );
    return try compiled_type_lower::kizu_type_to_llvm_indexed(
        index, ir_bytes, function.owner_module, function.return_spelling
    );
}

pub fn instance_return_canonical_type_id_indexed(
    index: &ir_index::IrIndex,
    canonical: &compiled_canonical_facts::CanonicalFactTable,
    context: &compiled_instance_context::InstanceContext,
    ir_bytes: []u8,
    function_name: []u8
) -> !i64 {
    let result_id = try compiled_instance_context::result_type_id(context);
    let ignored_kind = try compiled_canonical_facts::parsed_canonical_kind(
        canonical, result_id
    );
    return result_id;
}

// gate_llvm_symbol is the append_function_llvm_symbol behavior gate (tracker
// 1112). It pins the qualified-name -> LLVM symbol derivation that the std
// lexer, source, lexer, and loader compiled closures now rely on instead of
// handwritten helper tables: the std re-export 'std::kizu::lexer::*' mangles
// from its bare 'kizu::lexer' module path, while other modules keep their full
// path (including the deeper 'selfhost::source::loader::*' chain). Each derived
// symbol is printed so the Go gate can assert the exact bytes.
pub fn gate_llvm_symbol() -> !void {
    let allocator = std::mem::page_allocator();

    var first_token = std::string::String(allocator);
    try append_function_llvm_symbol(first_token, "std::kizu::lexer::first_token");
    let first_token_bytes = first_token.as_bytes();
    std::testing::expect_equal<[]u8>("kizu_kizu__lexer_first_token", first_token_bytes);

    var next_token = std::string::String(allocator);
    try append_function_llvm_symbol(next_token, "std::kizu::lexer::next_token");
    let next_token_bytes = next_token.as_bytes();
    std::testing::expect_equal<[]u8>("kizu_kizu__lexer_next_token", next_token_bytes);

    var starts_with = std::string::String(allocator);
    try append_function_llvm_symbol(starts_with, "std::mem::starts_with");
    let starts_with_bytes = starts_with.as_bytes();
    std::testing::expect_equal<[]u8>("kizu_std__mem_starts_with", starts_with_bytes);

    var module_path = std::string::String(allocator);
    try append_function_llvm_symbol(module_path, "selfhost::source::module_path");
    let module_path_bytes = module_path.as_bytes();
    std::testing::expect_equal<[]u8>("kizu_selfhost__source_module_path", module_path_bytes);

    var lexer_is_digit = std::string::String(allocator);
    try append_function_llvm_symbol(lexer_is_digit, "selfhost::lexer::is_digit");
    let lexer_is_digit_bytes = lexer_is_digit.as_bytes();
    std::testing::expect_equal<[]u8>("kizu_selfhost__lexer_is_digit", lexer_is_digit_bytes);

    var loader_module_end_for = std::string::String(allocator);
    try append_function_llvm_symbol(loader_module_end_for, "selfhost::source::loader::module_end_for");
    let loader_module_end_for_bytes = loader_module_end_for.as_bytes();
    std::testing::expect_equal<[]u8>("kizu_selfhost__source_loader_module_end_for", loader_module_end_for_bytes);

    print("llvm-symbol");
    print(first_token_bytes);
    print(next_token_bytes);
    print(starts_with_bytes);
    print(module_path_bytes);
    print(lexer_is_digit_bytes);
    print(loader_module_end_for_bytes);

    first_token.deinit();
    next_token.deinit();
    starts_with.deinit();
    module_path.deinit();
    lexer_is_digit.deinit();
    loader_module_end_for.deinit();
    return;
}
