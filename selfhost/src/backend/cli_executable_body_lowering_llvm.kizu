import selfhost::backend::cli_executable_body_lowering_contract;
import selfhost::backend::executable;

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try require_selected_body_lowering(ir_bytes);
    try append_cli_lower_executable_ast_function(
        out,
        "kizu_selfhost__cli_lower_run_executable_ast",
        executable::run_executable_lowering_case_count(),
        false
    );
    try append_cli_lower_executable_ast_function(
        out,
        "kizu_selfhost__cli_lower_test_executable_ast",
        executable::test_executable_lowering_case_count(),
        true
    );
    return;
}

fn require_selected_body_lowering(ir_bytes: []u8) -> !void {
    try cli_executable_body_lowering_contract::require(ir_bytes);
    return;
}

fn append_cli_lower_executable_ast_function(
    out: &var std::string::String,
    llvm_name: []u8,
    count: i64,
    is_test: bool
) -> !void {
    let unsupported = try executable::unsupported_executable_kind_tag();
    try out.append_bytes("define %kizu.selfhost.executable @");
    try out.append_bytes(llvm_name);
    try out.append_bytes("(");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %kizu.selfhost.executable.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ast_kind = extractvalue %kizu.selfhost.executable.ast %ast, 0");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.executable.ast %ast, 1");
    try append_line(out, "  br label %check_case_0");
    try append_case_dispatch(out, count, is_test);
    try append_line(out, "unsupported:");
    try append_executable_return(out, "unsupported", unsupported, "payload");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_case_dispatch(
    out: &var std::string::String,
    count: i64,
    is_test: bool
) -> !void {
    var index = 0;
    while index < count {
        let ast_kind = try lowering_case_ast_kind_tag(index, is_test);
        let result_kind = try lowering_case_result_kind_tag(index, is_test);
        try append_check_label(out, index);
        try append_case_compare(out, index, ast_kind);
        try append_case_branch(out, index, count);
        try append_case_return(out, index, result_kind);
        index = index + 1;
    }
    return;
}

fn append_check_label(out: &var std::string::String, index: i64) -> !void {
    try out.append_bytes("check_case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_case_compare(
    out: &var std::string::String,
    index: i64,
    ast_kind: i64
) -> !void {
    try out.append_bytes("  %case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_match = icmp eq i64 %ast_kind, ");
    try std::fmt::append_i64(out, ast_kind);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_case_branch(out: &var std::string::String, index: i64, count: i64) -> !void {
    try out.append_bytes("  br i1 %case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_match, label %case_");
    try std::fmt::append_i64(out, index);
    if index + 1 < count {
        try out.append_bytes(", label %check_case_");
        try std::fmt::append_i64(out, index + 1);
    } else {
        try out.append_bytes(", label %unsupported");
    }
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_case_return(
    out: &var std::string::String,
    index: i64,
    result_kind: i64
) -> !void {
    try out.append_bytes("case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %kinded_case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable zeroinitializer, i64 ");
    try std::fmt::append_i64(out, result_kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %result_case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable %kinded_case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(", %kizu.slice.u8 %payload, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable %result_case_");
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_executable_return(
    out: &var std::string::String,
    suffix: []u8,
    kind: i64,
    payload: []u8
) -> !void {
    try out.append_bytes("  %kinded_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable zeroinitializer, i64 ");
    try std::fmt::append_i64(out, kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %result_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable %kinded_");
    try out.append_bytes(suffix);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(payload);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable %result_");
    try out.append_bytes(suffix);
    try out.append_byte(cast<u8>(10));
    return;
}

fn lowering_case_ast_kind_tag(index: i64, is_test: bool) -> !i64 {
    if is_test {
        return try executable::test_executable_lowering_case_ast_kind_tag(index);
    }
    return try executable::run_executable_lowering_case_ast_kind_tag(index);
}

fn lowering_case_result_kind_tag(index: i64, is_test: bool) -> !i64 {
    if is_test {
        return try executable::test_executable_lowering_case_result_kind_tag(index);
    }
    return try executable::run_executable_lowering_case_result_kind_tag(index);
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
