import selfhost::backend::ir_contract;

pub fn append_functions(out: &var std::string::String, ir_bytes: []u8) -> !void {
    try require_selected_body_lowering(ir_bytes);
    try append_cli_lower_executable_ast_function(
        out,
        ir_bytes,
        "kizu_selfhost__cli_lower_run_executable_ast",
        "selfhost::backend::executable::lower_run_executable_ast"
    );
    try append_cli_lower_executable_ast_function(
        out,
        ir_bytes,
        "kizu_selfhost__cli_lower_test_executable_ast",
        "selfhost::backend::executable::lower_test_executable_ast"
    );
    return;
}

fn require_selected_body_lowering(ir_bytes: []u8) -> !void {
    let run_function = "selfhost::backend::executable::lower_run_executable_ast";
    let test_function = "selfhost::backend::executable::lower_test_executable_ast";
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-lowering ",
        run_function,
        "checked-run-executable"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-lowering ",
        test_function,
        "checked-test-executable"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-lowering-unsupported ",
        run_function,
        "unsupported_executable"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-lowering-unsupported ",
        test_function,
        "unsupported_executable"
    );
    try require_lowering_cases(ir_bytes, run_function);
    try require_lowering_cases(ir_bytes, test_function);
    return;
}

fn require_lowering_cases(ir_bytes: []u8, function_name: []u8) -> !void {
    let count = try lowering_case_count(ir_bytes, function_name);
    if count < 1 {
        return error("missing selected body lowering cases");
    }

    var index = 0;
    while index < count {
        let ast_kind_name = try lowering_case_ast_kind_name(ir_bytes, function_name, index);
        let result_kind_name = try lowering_case_result_kind_name(ir_bytes, function_name, index);
        let ast_kind = try executable_ast_tag(ir_bytes, ast_kind_name);
        let result_kind = try executable_kind_tag(ir_bytes, result_kind_name);
        if ast_kind < 0 or result_kind < 0 {
            return error("invalid selected body lowering cases");
        }
        index = index + 1;
    }
    return;
}

fn append_cli_lower_executable_ast_function(
    out: &var std::string::String,
    ir_bytes: []u8,
    llvm_name: []u8,
    function_name: []u8
) -> !void {
    let unsupported = try executable_kind_tag(ir_bytes, "Unsupported");
    let count = try lowering_case_count(ir_bytes, function_name);
    try out.append_bytes("define %kizu.selfhost.executable @");
    try out.append_bytes(llvm_name);
    try out.append_bytes("(");
    try out.append_byte(cast<u8>(10));
    try append_line(out, "  %kizu.selfhost.executable.ast %ast");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_line(out, "  %ast_kind = extractvalue %kizu.selfhost.executable.ast %ast, 0");
    try append_line(out, "  %payload = extractvalue %kizu.selfhost.executable.ast %ast, 1");
    try append_line(out, "  br label %check_case_0");
    try append_case_dispatch(out, ir_bytes, function_name, count);
    try append_line(out, "unsupported:");
    try append_executable_return(out, "unsupported", unsupported, "payload");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_case_dispatch(
    out: &var std::string::String,
    ir_bytes: []u8,
    function_name: []u8,
    count: i64
) -> !void {
    var index = 0;
    while index < count {
        let ast_kind_name = try lowering_case_ast_kind_name(ir_bytes, function_name, index);
        let result_kind_name = try lowering_case_result_kind_name(ir_bytes, function_name, index);
        let ast_kind = try executable_ast_tag(ir_bytes, ast_kind_name);
        let result_kind = try executable_kind_tag(ir_bytes, result_kind_name);
        try append_check_label(out, index);
        try append_case_compare(out, index, ast_kind);
        try append_case_branch(out, index, count);
        try append_case_return(out, index, result_kind);
        index = index + 1;
    }
    return;
}

fn append_check_label(out: &var std::string::String, index: i64) -> !void {
    try out.append_bytes("check_case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_case_compare(
    out: &var std::string::String,
    index: i64,
    ast_kind: i64
) -> !void {
    try out.append_bytes("  %case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_match = icmp eq i64 %ast_kind, ");
    try std::fmt::append_i64(out, ast_kind);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_case_branch(out: &var std::string::String, index: i64, count: i64) -> !void {
    try out.append_bytes("  br i1 %case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes("_match, label %case_");
    try std::fmt::append_i64(out, index);
    if index + 1 < count {
        try out.append_bytes(", label %check_case_");
        try std::fmt::append_i64(out, index + 1);
    } else {
        try out.append_bytes(", label %unsupported");
    }
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_case_return(
    out: &var std::string::String,
    index: i64,
    result_kind: i64
) -> !void {
    try out.append_bytes("case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(":");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %kinded_case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable zeroinitializer, i64 ");
    try std::fmt::append_i64(out, result_kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %result_case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable %kinded_case_");
    try std::fmt::append_i64(out, index);
    try out.append_bytes(", %kizu.slice.u8 %payload, 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable %result_case_");
    try std::fmt::append_i64(out, index);
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_executable_return(
    out: &var std::string::String,
    suffix: []u8,
    kind: i64,
    payload: []u8
) -> !void {
    try out.append_bytes("  %kinded_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable zeroinitializer, i64 ");
    try std::fmt::append_i64(out, kind);
    try out.append_bytes(", 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %result_");
    try out.append_bytes(suffix);
    try out.append_bytes(" = insertvalue %kizu.selfhost.executable %kinded_");
    try out.append_bytes(suffix);
    try out.append_bytes(", %kizu.slice.u8 %");
    try out.append_bytes(payload);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  ret %kizu.selfhost.executable %result_");
    try out.append_bytes(suffix);
    try out.append_byte(cast<u8>(10));
    return;
}

fn executable_ast_tag(ir_bytes: []u8, name: []u8) -> !i64 {
    return try ir_contract::named_i64_fact(ir_bytes, "executable-ast-kind ", name);
}

fn executable_kind_tag(ir_bytes: []u8, name: []u8) -> !i64 {
    return try ir_contract::named_i64_fact(ir_bytes, "executable-kind ", name);
}

fn lowering_case_count(ir_bytes: []u8, function_name: []u8) -> !i64 {
    return try ir_contract::named_i64_fact(
        ir_bytes,
        "selected-body-lowering-case-count ",
        function_name
    );
}

fn lowering_case_ast_kind_name(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> ![]u8 borrows ir_bytes {
    return try ir_contract::sequence_fact_value(
        ir_bytes,
        "selected-body-lowering-case-ast ",
        function_name,
        index
    );
}

fn lowering_case_result_kind_name(
    ir_bytes: []u8,
    function_name: []u8,
    index: i64
) -> ![]u8 borrows ir_bytes {
    return try ir_contract::sequence_fact_value(
        ir_bytes,
        "selected-body-lowering-case-result ",
        function_name,
        index
    );
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
