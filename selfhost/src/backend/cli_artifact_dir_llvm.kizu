pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(out, "artifact_root_dir", "6", "target");
    try append_llvm_constant(out, "artifact_selfhost_dir", "15", "target/selfhost");
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_ensure_artifact_dir_function(out);
    return;
}

fn append_ensure_artifact_dir_function(out: &var std::string::String) -> !void {
    try append_line(out, "define %kizu.error.void @kizu_selfhost__ensure_artifact_dir(");
    try append_line(out, "  %kizu.owned %io,");
    try append_line(out, "  %kizu.slice.u8 %leaf");
    try append_line(out, ") {");
    try append_line(out, "entry:");
    try append_global_slice(out, "root", "artifact_root_dir", "6");
    try append_line(out,
        "  %root_mkdir = call %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned %io, %kizu.slice.u8 %root_artifact_root_dir_slice)");
    try append_line(out, "  %root_ok = extractvalue %kizu.error.void %root_mkdir, 0");
    try append_line(out, "  br i1 %root_ok, label %create_selfhost, label %failed");
    try append_line(out, "create_selfhost:");
    try append_global_slice(out, "selfhost", "artifact_selfhost_dir", "15");
    try append_line(out,
        "  %selfhost_mkdir = call %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned %io, %kizu.slice.u8 %selfhost_artifact_selfhost_dir_slice)");
    try append_line(out, "  %selfhost_ok = extractvalue %kizu.error.void %selfhost_mkdir, 0");
    try append_line(out, "  br i1 %selfhost_ok, label %create_leaf, label %failed");
    try append_line(out, "create_leaf:");
    try append_line(out,
        "  %leaf_mkdir = call %kizu.error.void @kizu_rt_fs_create_dir(%kizu.owned %io, %kizu.slice.u8 %leaf)");
    try append_line(out, "  %leaf_ok = extractvalue %kizu.error.void %leaf_mkdir, 0");
    try append_line(out, "  br i1 %leaf_ok, label %ok, label %failed");
    try append_line(out, "ok:");
    try append_line(out,
        "  %ok_result = insertvalue %kizu.error.void zeroinitializer, i1 true, 0");
    try append_line(out, "  ret %kizu.error.void %ok_result");
    try append_line(out, "failed:");
    try append_line(out, "  ret %kizu.error.void zeroinitializer");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_global_slice(
    out: &var std::string::String,
    prefix: []u8,
    global: []u8,
    size: []u8
) -> !void {
    try out.append_bytes("  %");
    try out.append_bytes(prefix);
    try out.append_bytes("_");
    try out.append_bytes(global);
    try out.append_bytes("_ptr = getelementptr inbounds [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8], ptr @.kizu.cli.");
    try out.append_bytes(global);
    try out.append_bytes(", i64 0, i64 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(prefix);
    try out.append_bytes("_");
    try out.append_bytes(global);
    try out.append_bytes("_base = insertvalue %kizu.slice.u8 poison, ptr %");
    try out.append_bytes(prefix);
    try out.append_bytes("_");
    try out.append_bytes(global);
    try out.append_bytes("_ptr, 0");
    try out.append_byte(cast<u8>(10));
    try out.append_bytes("  %");
    try out.append_bytes(prefix);
    try out.append_bytes("_");
    try out.append_bytes(global);
    try out.append_bytes("_slice = insertvalue %kizu.slice.u8 %");
    try out.append_bytes(prefix);
    try out.append_bytes("_");
    try out.append_bytes(global);
    try out.append_bytes("_base, i64 ");
    try out.append_bytes(size);
    try out.append_bytes(", 1");
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
