import selfhost::backend::compiled_fact_lookup;
import selfhost::backend::compiled_mir;
import selfhost::backend::compiled_mir_lower_call;
import selfhost::backend::compiled_mir_types;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_type_lower;
import selfhost::backend::compiled_util;
import selfhost::backend::ir_contract;

pub fn lower_struct_fields(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64
) -> !std::array::Array<compiled_mir::MirStructField> {
    let field_count = try count_struct_fields(ir_bytes, function_name, value_node, bs);
    var fields = std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator());
    var field_index = 0;
    while field_index < field_count {
        let field_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value_node, "field", field_index, bs
        );
        let field_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_node, "value", 0, bs
        );
        let field_value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, field_value, bs
        );
        try fields.append(try lower_struct_field(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            field_value_kind,
            bs
        ));
        field_index = field_index + 1;
    }
    return fields;
}

fn count_struct_fields(
    ir_bytes: []u8,
    function_name: []u8,
    struct_node: i64,
    bs: i64
) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes,
            function_name,
            struct_node,
            "field",
            count,
            bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

fn lower_struct_field(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    field_value_kind: []u8,
    bs: i64
) -> !compiled_mir::MirStructField {
    if std::mem::equal_bytes(field_value_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            field_value,
            bs
        );
        let var_type = try compiled_mir_types::resolve_value_llvm_type(
            ir_bytes, function_name, module_prefix, params_spec, var_name, bs
        );
        return compiled_mir::var_struct_field(field_index, var_type, var_name);
    }
    if std::mem::equal_bytes(field_value_kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            field_value,
            bs
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid string token in struct field"
        );
        return compiled_mir::string_struct_field(field_index, token);
    }
    if std::mem::equal_bytes(field_value_kind, "Int") {
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes,
            function_name,
            field_value,
            bs
        );
        return compiled_mir::int_struct_field(field_index, int_value);
    }
    if std::mem::equal_bytes(field_value_kind, "Prefix") {
        // Only unary negation of an integer literal is supported, lowered to the
        // existing ConstInt field with a negative int_value. This unblocks sentinel
        // structs like PayloadSpan { start: -1, end: -1 } without adding arbitrary
        // expression support in struct field position (tracker 961). It mirrors the
        // neg handling already used by expression lowering.
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, field_value, bs
        );
        if !std::mem::equal_bytes(op, "neg") {
            return error("compiled mir: unsupported prefix op in struct field");
        }
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_value, "right", 0, bs
        );
        let right_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, right_node, bs
        );
        if !std::mem::equal_bytes(right_kind, "Int") {
            return error("compiled mir: unsupported neg operand in struct field");
        }
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes, function_name, right_node, bs
        );
        return compiled_mir::int_struct_field(field_index, 0 - int_value);
    }
    if std::mem::equal_bytes(field_value_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            field_value,
            bs
        );
        return compiled_mir::bool_struct_field(
            field_index,
            std::mem::equal_bytes(token, "true")
        );
    }
    if std::mem::equal_bytes(field_value_kind, "IndexExpr") {
        let start_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_value, "start", 0, bs
        );
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_value, "end", 0, bs
        );
        let start_val = try ir_contract::body_int_value_from(ir_bytes, function_name, start_node, bs);
        let end_val = try ir_contract::body_int_value_from(ir_bytes, function_name, end_node, bs);
        if start_val != 0 or end_val != 0 {
            return error("compiled mir: only [0..0] index expr supported");
        }
        return compiled_mir::empty_slice_struct_field(field_index);
    }
    if std::mem::equal_bytes(field_value_kind, "FieldExpr") {
        return try lower_struct_field_expr(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            bs
        );
    }
    if std::mem::equal_bytes(field_value_kind, "Call") {
        return try lower_struct_field_call(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            bs
        );
    }
    if std::mem::equal_bytes(field_value_kind, "Binary") {
        return try lower_struct_field_computed_binary(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            bs
        );
    }
    if std::mem::equal_bytes(field_value_kind, "StructLiteralExpr") {
        return try lower_struct_field_struct(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            bs
        );
    }
    return error("compiled mir: unsupported struct field value kind");
}

// lower_struct_field_call lowers a direct function call used as a struct field
// value (e.g. LocalTable { first: empty_local(text) }). It reuses the shared
// call-argument lowering so the field carries a resolved callee/module prefix
// plus its lowered args; the renderer emits the call before the insertvalue and
// feeds the result in. String-literal args are rejected because struct fields do
// not yet reserve their own string-global pool, so a literal would collide with
// the .f slots reserved per field (tracker 961). The actual run-AST helpers only
// pass a Var arg, so this stays sufficient to unblock them.
fn lower_struct_field_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64
) -> !compiled_mir::MirStructField {
    let field_callee = try ir_contract::body_call_callee_or_empty_from(
        ir_bytes, function_name, field_value, bs
    );
    // 'Struct { field: std::array::Array<T>(alloc), ... }' /
    // 'Struct { field: std::arena::Arena<T>(alloc), ... }' construct a fresh runtime-owned
    // container directly into a struct field (the std::kizu::ast::Ast constructor seeds its
    // nodes Arena<AstNode> and children Array<NodeId> this way). Both lower to the
    // element-size-generic @kizu_rt_array_new builtin, so the field carries an ArrayNew
    // descriptor instead of a resolved component call.
    if std::mem::starts_with(field_callee, "std::array::Array<") or
        std::mem::starts_with(field_callee, "std::arena::Arena<") {
        return try lower_struct_field_owned_container(
            ir_bytes, function_name, module_prefix, field_index, field_value, field_callee, bs
        );
    }
    // 'Struct { field: <receiver>.<method>(<args>), ... }' is a value-receiver method call in
    // struct-field position (e.g. 'ParseRange { range: ast.finish_children(start), ... }'). It must
    // resolve the cross-module method symbol and prepend the receiver as the first argument, the
    // same way the statement/expression lowerers do; the generic call path below would otherwise
    // emit the literal 'ast.<method>' against the caller's module and drop the receiver.
    if try compiled_mir_types::callee_is_field_mode_method(ir_bytes, function_name, field_value, bs) {
        return try lower_struct_field_method_call(
            ir_bytes, function_name, module_prefix, params_spec, field_index, field_value, bs
        );
    }
    if try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, field_value, bs) {
        return error("compiled mir: error call not supported in struct field");
    }
    let call_type = try compiled_mir_types::lower_call_return_type(
        ir_bytes, function_name, module_prefix, field_value, bs
    );
    let callee_name = try compiled_mir_types::lower_call_callee_name(
        ir_bytes, function_name, module_prefix, field_value, bs
    );
    let callee_module_prefix = try compiled_mir_types::lower_call_module_prefix(
        ir_bytes, function_name, module_prefix, field_value, bs
    );
    let args = try compiled_mir_lower_call::lower_call_args(
        ir_bytes, function_name, module_prefix, params_spec, field_value, 0, bs
    );
    if try compiled_mir_lower_call::count_string_args(&args) > 0 {
        return error("compiled mir: string-literal args unsupported in call-valued struct field");
    }
    return compiled_mir::call_struct_field(
        field_index,
        call_type,
        callee_module_prefix,
        callee_name,
        args
    );
}

// lower_struct_field_owned_container lowers an owned-container constructor used as a struct
// field value (std::array::Array<T>(alloc) / std::arena::Arena<T>(alloc)). The element type is
// stripped off the constructor callee and mapped to its LLVM type so the renderer can derive the
// element-size constant; the sole argument is the allocator value. It mirrors the standalone
// 'var <name> = std::array::Array<T>(alloc)' ArrayNew statement lowering, reusing the same
// element-size-generic @kizu_rt_array_new builtin (no per-type size or symbol is hardcoded).
fn lower_struct_field_owned_container(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    field_index: i64,
    field_value: i64,
    callee: []u8,
    bs: i64
) -> !compiled_mir::MirStructField {
    let callee_len = std::mem::len(callee);
    if callee[callee_len - 1] != cast<u8>(62) {
        return error("compiled mir: malformed owned-container struct field constructor type");
    }
    var prefix_len = std::mem::len("std::array::Array<");
    if std::mem::starts_with(callee, "std::arena::Arena<") {
        prefix_len = std::mem::len("std::arena::Arena<");
    }
    let element_kizu = callee[prefix_len..callee_len - 1];
    let element_llvm = try compiled_type_lower::kizu_type_to_llvm(
        ir_bytes, module_prefix, element_kizu
    );
    let arg_count = try compiled_mir_types::count_call_args(ir_bytes, function_name, field_value, bs);
    if arg_count != 1 {
        return error("compiled mir: owned-container struct field constructor takes exactly the allocator argument");
    }
    let alloc_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_value, "arg", 0, bs
    );
    let alloc_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, alloc_node, bs);
    if std::mem::len(alloc_name) == 0 {
        return error("compiled mir: owned-container struct field allocator must be a value name");
    }
    return compiled_mir::array_new_struct_field(field_index, "%kizu.owned", alloc_name, element_llvm);
}

// lower_struct_field_method_call lowers a value-receiver method call used as a struct field value
// ('Struct { field: <receiver>.<method>(<args>) }'). It resolves the cross-module method symbol and
// receiver through compiled_mir_types::resolve_method_call, prepends the receiver as the first call
// argument (matching the statement/expression method-call lowering), and reuses the shared scalar
// argument lowering for the explicit arguments. The resulting call-valued field renders the
// receiver-carrying call before the insertvalue, so a struct field never emits the literal
// 'ast.<method>' symbol with a dropped receiver. String-literal arguments are rejected because
// struct fields do not reserve their own string-global pool.
fn lower_struct_field_method_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64
) -> !compiled_mir::MirStructField {
    let info = try compiled_mir_types::resolve_method_call(
        ir_bytes, function_name, module_prefix, params_spec, field_value, bs
    );
    let explicit_arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, field_value, bs
    );
    var arg_types = try compiled_mir_types::lower_call_arg_types(
        ir_bytes, info.module_prefix, info.callee_name, explicit_arg_count + 1
    );
    defer arg_types.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::var_call_arg(try arg_types.get(0), info.receiver_name));
    var arg_index = 0;
    while arg_index < explicit_arg_count {
        let arg_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_value, "arg", arg_index, bs
        );
        let arg_type = try arg_types.get(arg_index + 1);
        let scalar_arg = try compiled_mir_lower_call::lower_single_call_arg(
            ir_bytes, function_name, module_prefix, params_spec, arg_type, arg_node, 0, bs
        );
        if scalar_arg.kind == compiled_mir::MirCallArgKind::String {
            return error("compiled mir: string-literal args unsupported in method-call struct field");
        }
        try args.append(scalar_arg);
        arg_index = arg_index + 1;
    }
    return compiled_mir::call_struct_field(
        field_index,
        info.return_llvm_type,
        info.module_prefix,
        info.callee_name,
        args
    );
}

fn lower_struct_field_computed_binary(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64
) -> !compiled_mir::MirStructField {
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, field_value, bs
    );
    if !std::mem::equal_bytes(op, "sub") {
        return error("compiled mir: unsupported computed struct field op");
    }
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_value, "left", 0, bs
    );
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_value, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right, bs);
    if !std::mem::equal_bytes(right_kind, "Var") {
        return error("compiled mir: computed struct field rhs must be Var");
    }
    let right_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, right, bs
    );
    let right_type = try compiled_mir_types::resolve_value_llvm_type(
        ir_bytes, function_name, module_prefix, params_spec, right_name, bs
    );
    if !std::mem::equal_bytes(right_type, "i64") {
        return error("compiled mir: computed struct field rhs must be i64");
    }
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left, bs);
    if !std::mem::equal_bytes(left_kind, "Call") {
        return error("compiled mir: computed struct field lhs must be a call");
    }
    let callee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, left, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "len") {
        return error("compiled mir: computed struct field lhs call must be len");
    }
    let arg_count = try compiled_mir_types::count_call_args(ir_bytes, function_name, left, bs);
    if arg_count != 0 {
        return error("compiled mir: computed struct field len takes no arguments");
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return error("compiled mir: computed struct field len receiver must be a field access");
    }
    let root = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, receiver, "receiver", 0, bs
    );
    let root_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, root, bs);
    if !std::mem::equal_bytes(root_kind, "Var") {
        return error("compiled mir: computed struct field receiver must start with Var");
    }
    let root_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, root, bs
    );
    let field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, receiver, bs
    );
    let element_type = compiled_mir_types::array_value_element_kizu_type_or_empty(
        compiled_mir_types::struct_lookup_kizu_type(field.field_kizu_type)
    );
    if std::mem::len(element_type) == 0 {
        return error("compiled mir: computed struct field len receiver is not an Array");
    }
    return compiled_mir::computed_binary_struct_field(
        field_index,
        "i64",
        root_name,
        field.receiver_llvm_type,
        field.field_index,
        right_name
    );
}

// lower_struct_field_struct lowers a nested struct literal used as a struct field
// value (e.g. LocalTable { first: LocalBinding { name: ..., ... } }). It resolves
// the nested struct's LLVM type and recursively lowers its fields, so the nested
// fields support the same kinds as the outer struct (FieldExpr, Int, Call, even a
// further nested struct literal). The renderer builds the nested struct in its own
// insertvalue chain and feeds the result into the parent (tracker 961).
fn lower_struct_field_struct(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64
) -> !compiled_mir::MirStructField {
    let nested_type = try compiled_signature::resolve_struct_literal_type(
        ir_bytes, function_name, module_prefix, field_value, bs
    );
    let nested_fields = try lower_struct_fields(
        ir_bytes, function_name, module_prefix, params_spec, field_value, bs
    );
    return compiled_mir::struct_literal_struct_field(
        field_index,
        nested_type,
        nested_fields
    );
}

fn lower_struct_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64
) -> !compiled_mir::MirStructField {
    let mode = try ir_contract::sequence_fact_second_value_from(
        ir_bytes,
        "body-field-expr ",
        function_name,
        field_value,
        bs
    );
    if std::mem::equal_bytes(mode, "namespace") {
        let variant_name = try ir_contract::body_field_expr_name_from(
            ir_bytes,
            function_name,
            field_value,
            "namespace",
            bs
        );
        let receiver = try ir_contract::body_child_sequence_from(
            ir_bytes,
            function_name,
            field_value,
            "receiver",
            0,
            bs
        );
        let receiver_token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            receiver,
            bs
        );
        let tag = try compiled_fact_lookup::enum_variant_tag_by_prefix(
            ir_bytes,
            module_prefix,
            receiver_token,
            variant_name
        );
        return compiled_mir::enum_tag_struct_field(field_index, tag);
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes,
        function_name,
        field_value,
        "receiver",
        0,
        bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes,
        function_name,
        receiver,
        bs
    );
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return try lower_nested_struct_field_expr(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            receiver,
            bs
        );
    }
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: field access receiver must be Var");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes,
        function_name,
        receiver,
        bs
    );
    let field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, field_value, bs
    );
    return compiled_mir::field_access_struct_field(
        field_index,
        field.field_llvm_type,
        receiver_name,
        field.receiver_llvm_type,
        field.field_index
    );
}

fn lower_nested_struct_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    receiver: i64,
    bs: i64
) -> !compiled_mir::MirStructField {
    let root_receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, receiver, "receiver", 0, bs
    );
    let root_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, root_receiver, bs);
    if !std::mem::equal_bytes(root_kind, "Var") {
        return error("compiled mir: nested field access receiver must start with Var");
    }
    let root_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, root_receiver, bs
    );
    let first_field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, receiver, bs
    );
    let second_field = try compiled_mir_types::resolve_field_expr(
        ir_bytes, function_name, module_prefix, params_spec, field_value, bs
    );
    return compiled_mir::nested_field_access_struct_field(
        field_index,
        second_field.field_llvm_type,
        root_name,
        first_field.receiver_llvm_type,
        first_field.field_index,
        first_field.field_llvm_type,
        second_field.field_index
    );
}
