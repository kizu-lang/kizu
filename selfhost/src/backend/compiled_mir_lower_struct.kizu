import selfhost::backend::compiled_canonical_facts;
import selfhost::backend::compiled_mir;
import selfhost::backend::compiled_mir_lower_call;
import selfhost::backend::compiled_mir_types;
import selfhost::backend::compiled_signature;
import selfhost::backend::compiled_type_lower;
import selfhost::backend::compiled_type_resolver;
import selfhost::backend::compiled_util;
import selfhost::backend::ir_contract;
import selfhost::backend::ir_index;
import selfhost::ir::builtin_contract;

pub fn lower_struct_fields(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    value_node: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !std::array::Array<compiled_mir::MirStructField> {
    let field_count = try count_struct_fields(ir_bytes, function_name, value_node, bs);
    var fields = std::array::Array<compiled_mir::MirStructField>(std::mem::page_allocator());
    var field_index = 0;
    while field_index < field_count {
        let field_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value_node, "field", field_index, bs
        );
        let field_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_node, "value", 0, bs
        );
        let field_value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, field_value, bs
        );
        try fields.append(try lower_struct_field(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            field_value_kind,
            bs,
            ir_lookup_index,
            canonical_facts,
            call_arg_type_cache
        ));
        field_index = field_index + 1;
    }
    return fields;
}

fn count_struct_fields(
    ir_bytes: []u8,
    function_name: []u8,
    struct_node: i64,
    bs: i64
) -> !i64 {
    var count = 0;
    while true {
        let child = try ir_contract::body_child_sequence_or_minus_one_from(
            ir_bytes,
            function_name,
            struct_node,
            "field",
            count,
            bs
        );
        if child < 0 {
            return count;
        }
        count = count + 1;
    }
    return count;
}

// struct_field_value_kind_is_shaped lists the value kinds lower_struct_field renders through a
// dedicated MirStructField shape. Some of those shapes carry further limits, so callers ask
// struct_field_value_is_shaped rather than this kind gate directly.
fn struct_field_value_kind_is_shaped(kind: []u8) -> bool {
    return std::mem::equal_bytes(kind, "Var") or
        std::mem::equal_bytes(kind, "String") or
        std::mem::equal_bytes(kind, "Int") or
        std::mem::equal_bytes(kind, "Prefix") or
        std::mem::equal_bytes(kind, "Bool") or
        std::mem::equal_bytes(kind, "IndexExpr") or
        std::mem::equal_bytes(kind, "FieldExpr") or
        std::mem::equal_bytes(kind, "Call") or
        std::mem::equal_bytes(kind, "Binary") or
        std::mem::equal_bytes(kind, "StructLiteralExpr");
}

// struct_field_value_is_shaped reports whether lower_struct_field can represent this field value
// with a dedicated MirStructField shape. It is the single source of truth for that question: the
// field lowerer consults it to decide whether to defer to the expression path, and
// struct_literal_needs_expr_value consults it so a caller can pick the statement-level struct form
// or the expression form before lowering anything.
pub fn struct_field_value_is_shaped(
    ir_bytes: []u8,
    function_name: []u8,
    field_value: i64,
    field_value_kind: []u8,
    bs: i64
) -> !bool {
    if !struct_field_value_kind_is_shaped(field_value_kind) {
        return false;
    }
    if std::mem::equal_bytes(field_value_kind, "Call") {
        // The call-valued field shapes reserve no string-global pool of their own -- the '.f' slots
        // belong to the fields -- and they carry no error-union propagation, so a call passing a
        // string literal or raising an error builds in an expression stream instead.
        if try compiled_mir_lower_call::is_error_call(
            ir_bytes, function_name, field_value, bs
        ) {
            return false;
        }
        let has_string_arg = try call_tree_has_string_literal_arg(
            ir_bytes, function_name, field_value, bs
        );
        return !has_string_arg;
    }
    return true;
}

// call_tree_has_string_literal_arg reports whether a call or any nested call argument passes a
// string literal, matching the recursion count_string_args performs over lowered arguments.
fn call_tree_has_string_literal_arg(
    ir_bytes: []u8,
    function_name: []u8,
    call_node: i64,
    bs: i64
) -> !bool {
    let arg_count = try compiled_mir_types::count_call_args(
        ir_bytes, function_name, call_node, bs
    );
    var index = 0;
    while index < arg_count {
        let arg = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, call_node, "arg", index, bs
        );
        let kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, arg, bs
        );
        if std::mem::equal_bytes(kind, "String") {
            return true;
        }
        if std::mem::equal_bytes(kind, "Call") {
            if try call_tree_has_string_literal_arg(
                ir_bytes, function_name, arg, bs
            ) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// struct_literal_needs_expr_value reports whether any field of this literal -- at any nesting
// depth, since a nested literal lowers through the same field shapes -- carries a value the field
// shapes cannot represent. Such a literal has to build inside an expression instruction stream so
// its fields can reference the instructions that produce them.
pub fn struct_literal_needs_expr_value(
    ir_bytes: []u8,
    function_name: []u8,
    value_node: i64,
    bs: i64
) -> !bool {
    let field_count = try count_struct_fields(ir_bytes, function_name, value_node, bs);
    var field_index = 0;
    while field_index < field_count {
        let field_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, value_node, "field", field_index, bs
        );
        let field_value = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_node, "value", 0, bs
        );
        let field_value_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, field_value, bs
        );
        let shaped = try struct_field_value_is_shaped(
            ir_bytes, function_name, field_value, field_value_kind, bs
        );
        if !shaped {
            return true;
        }
        if std::mem::equal_bytes(field_value_kind, "StructLiteralExpr") {
            if try struct_literal_needs_expr_value(
                ir_bytes, function_name, field_value, bs
            ) {
                return true;
            }
        }
        field_index = field_index + 1;
    }
    return false;
}

fn lower_struct_field(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    field_value_kind: []u8,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStructField {
    // A value kind none of the struct-field shapes below represents is not an unsupported
    // construct: it is one the general expression lowerer already handles. The field records its
    // source node and the enclosing expression lowerer emits the instructions and rewrites it into
    // an Expr field, so struct-literal fields inherit every expression kind without this file
    // growing a shape per kind.
    let shaped = try struct_field_value_is_shaped(
        ir_bytes, function_name, field_value, field_value_kind, bs
    );
    if !shaped {
        return compiled_mir::pending_expr_struct_field(field_index, field_value);
    }
    if std::mem::equal_bytes(field_value_kind, "Var") {
        let var_name = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            field_value,
            bs
        );
        let var_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
            ir_lookup_index, ir_bytes, function_name, module_prefix,
            params_spec, var_name, bs, call_arg_type_cache
        );
        return compiled_mir::var_struct_field(field_index, var_type, var_name);
    }
    if std::mem::equal_bytes(field_value_kind, "String") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            field_value,
            bs
        );
        let _payload_len = try compiled_util::string_token_decoded_len(
            token,
            "compiled mir: invalid string token in struct field"
        );
        return compiled_mir::string_struct_field(field_index, token);
    }
    if std::mem::equal_bytes(field_value_kind, "Int") {
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes,
            function_name,
            field_value,
            bs
        );
        return compiled_mir::int_struct_field(field_index, int_value);
    }
    if std::mem::equal_bytes(field_value_kind, "Prefix") {
        // Only unary negation of an integer literal is supported, lowered to the
        // existing ConstInt field with a negative int_value. This unblocks sentinel
        // structs like PayloadSpan { start: -1, end: -1 } without adding arbitrary
        // expression support in struct field position (tracker 961). It mirrors the
        // neg handling already used by expression lowering.
        let op = try ir_contract::sequence_fact_value_from(
            ir_bytes, "body-prefix ", function_name, field_value, bs
        );
        if !std::mem::equal_bytes(op, "neg") {
            return error("compiled mir: unsupported prefix op in struct field");
        }
        let right_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_value, "right", 0, bs
        );
        let right_kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, right_node, bs
        );
        if !std::mem::equal_bytes(right_kind, "Int") {
            return error("compiled mir: unsupported neg operand in struct field");
        }
        let int_value = try ir_contract::body_int_value_from(
            ir_bytes, function_name, right_node, bs
        );
        return compiled_mir::int_struct_field(field_index, 0 - int_value);
    }
    if std::mem::equal_bytes(field_value_kind, "Bool") {
        let token = try ir_contract::body_token_or_empty_from(
            ir_bytes,
            function_name,
            field_value,
            bs
        );
        return compiled_mir::bool_struct_field(
            field_index,
            std::mem::equal_bytes(token, "true")
        );
    }
    if std::mem::equal_bytes(field_value_kind, "IndexExpr") {
        let start_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_value, "start", 0, bs
        );
        let end_node = try ir_contract::body_child_sequence_from(
            ir_bytes, function_name, field_value, "end", 0, bs
        );
        let start_val = try ir_contract::body_int_value_from(ir_bytes, function_name, start_node, bs);
        let end_val = try ir_contract::body_int_value_from(ir_bytes, function_name, end_node, bs);
        if start_val != 0 or end_val != 0 {
            return error("compiled mir: only [0..0] index expr supported");
        }
        return compiled_mir::empty_slice_struct_field(field_index);
    }
    if std::mem::equal_bytes(field_value_kind, "FieldExpr") {
        return try lower_struct_field_expr(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            bs,
            ir_lookup_index,
            call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(field_value_kind, "Call") {
        return try lower_struct_field_call(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            bs,
            ir_lookup_index,
            canonical_facts,
            call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(field_value_kind, "Binary") {
        return try lower_struct_field_computed_binary(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            bs,
            ir_lookup_index,
            call_arg_type_cache
        );
    }
    if std::mem::equal_bytes(field_value_kind, "StructLiteralExpr") {
        return try lower_struct_field_struct(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            bs,
            ir_lookup_index,
            canonical_facts,
            call_arg_type_cache
        );
    }
    var message = std::string::String(std::mem::page_allocator());
    try message.append_bytes("compiled mir: unsupported struct field value kind: ");
    try message.append_bytes(function_name);
    try message.append_bytes(" node ");
    try std::fmt::append_i64(&var message, field_value);
    try message.append_bytes(" kind ");
    try message.append_bytes(field_value_kind);
    let message_bytes = message.as_bytes();
    return error(message_bytes);
}

// lower_struct_field_call lowers a direct function call used as a struct field
// value (e.g. LocalTable { first: empty_local(text) }). It reuses the shared
// call-argument lowering so the field carries a resolved callee/module prefix
// plus its lowered args; the renderer emits the call before the insertvalue and
// feeds the result in. String-literal args are rejected because struct fields do
// not yet reserve their own string-global pool, so a literal would collide with
// the .f slots reserved per field (tracker 961). The actual run-AST helpers only
// pass a Var arg, so this stays sufficient to unblock them.
fn lower_struct_field_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStructField {
    let owned_constructor = try compiled_type_resolver::owned_constructor_indexed(
        ir_lookup_index, ir_bytes, function_name, field_value
    );
    // Exact TypeId-derived owned constructor facts cover source nominal constructors and
    // direct builtins without inspecting the callee spelling.
    if owned_constructor.found {
        return try lower_struct_field_owned_container(
            ir_bytes, function_name, module_prefix, params_spec,
            field_index, field_value, &owned_constructor, bs,
            ir_lookup_index, call_arg_type_cache
        );
    }
    // 'Struct { field: <receiver>.<method>(<args>), ... }' is a value-receiver method call in
    // struct-field position (e.g. 'ParseRange { range: ast.finish_children(start), ... }'). It must
    // resolve the cross-module method symbol and prepend the receiver as the first argument, the
    // same way the statement/expression lowerers do; the generic call path below would otherwise
    // emit the literal 'ast.<method>' against the caller's module and drop the receiver.
    if try compiled_mir_types::callee_is_field_mode_method(ir_bytes, function_name, field_value, bs) {
        return try lower_struct_field_method_call(
            ir_bytes, function_name, module_prefix, params_spec, field_index, field_value, bs,
            ir_lookup_index, canonical_facts, call_arg_type_cache
        );
    }
    if try compiled_mir_lower_call::is_error_call(ir_bytes, function_name, field_value, bs) {
        return error("compiled mir: error call not supported in struct field");
    }
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, field_value, bs, call_arg_type_cache
    );
    let args = try compiled_mir_lower_call::lower_call_args_canonical(
        ir_bytes, function_name, module_prefix, params_spec, field_value, 0, bs,
        ir_lookup_index, canonical_facts, &call_info.types,
        call_arg_type_cache
    );
    if try compiled_mir_lower_call::count_string_args(&args) > 0 {
        return error("compiled mir: string-literal args unsupported in call-valued struct field");
    }
    return compiled_mir::call_struct_field(
        field_index,
        call_info.return_llvm_type,
        call_info.module_prefix,
        call_info.callee_name,
        args
    );
}

// lower_struct_field_owned_container consumes the same resolved descriptor as standalone lets.
fn lower_struct_field_owned_container(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    constructor: &compiled_type_resolver::ResolvedOwnedConstructor,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStructField {
    let constructor_runtime = builtin_contract::owned_container_constructor_runtime(
        constructor.family
    );
    if !constructor_runtime.found {
        return error("compiled mir: unsupported owned struct-field constructor runtime ABI");
    }
    let arg_count = try compiled_mir_types::count_call_args(ir_bytes, function_name, field_value, bs);
    if arg_count != 1 {
        return error("compiled mir: owned-container struct field constructor takes exactly the allocator argument");
    }
    let alloc_node = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_value, "arg", 0, bs
    );
    if !std::mem::equal_bytes(
        try ir_contract::body_node_kind_from(
            ir_bytes, function_name, alloc_node, bs
        ),
        "Var"
    ) {
        return error("compiled mir: owned-container struct field allocator must be a value name");
    }
    let alloc_name = try ir_contract::body_token_or_empty_from(ir_bytes, function_name, alloc_node, bs);
    if std::mem::len(alloc_name) == 0 {
        return error("compiled mir: owned-container struct field allocator must be a value name");
    }
    let allocator_spelling = try compiled_mir_types::resolve_value_kizu_type_indexed_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix,
        params_spec, alloc_name, bs, call_arg_type_cache
    );
    let allocator_type = try compiled_type_resolver::resolve_type_indexed(
        ir_lookup_index, ir_bytes, module_prefix, allocator_spelling
    );
    if !std::mem::equal_bytes(allocator_type.canonical_identity, "Allocator") {
        return error("compiled mir: owned struct-field constructor argument is not an Allocator");
    }
    let allocator_abi = allocator_type.abi;
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    try args.append(compiled_mir::var_call_arg(
        allocator_abi, alloc_name
    ));
    if constructor_runtime.type_size_argument_slot >= 0 {
        if !constructor.type_arguments_concrete or
            std::mem::len(constructor.storage_type.abi) == 0 {
            return error("compiled mir: owned struct-field constructor storage type is not concrete");
        }
        try args.append(try compiled_mir::type_size_call_arg(
            constructor.storage_type.abi
        ));
    }
    return compiled_mir::call_struct_field(
        field_index, constructor.result_type.abi,
        "", constructor_runtime.symbol, args
    );
}

// lower_struct_field_method_call lowers a value-receiver method call used as a struct field value
// ('Struct { field: <receiver>.<method>(<args>) }'). It resolves the cross-module method symbol and
// receiver through compiled_mir_types::resolve_method_call, prepends the receiver as the first call
// argument (matching the statement/expression method-call lowering), and reuses the shared scalar
// argument lowering for the explicit arguments. The resulting call-valued field renders the
// receiver-carrying call before the insertvalue, so a struct field never emits the literal
// 'ast.<method>' symbol with a dropped receiver. String-literal arguments are rejected because
// struct fields do not reserve their own string-global pool.
fn lower_struct_field_method_call(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStructField {
    let info = try compiled_mir_types::resolve_method_call_indexed(
        ir_lookup_index, ir_bytes, function_name, module_prefix,
        params_spec, field_value, bs
    );
    let call_info = try compiled_mir_types::lower_call_info_for_instance_indexed(
        ir_lookup_index, canonical_facts, ir_bytes,
        function_name, module_prefix, field_value, bs, call_arg_type_cache
    );
    var runtime_arg_nodes =
        try compiled_mir_lower_call::canonical_runtime_arg_nodes(
            ir_bytes, function_name, field_value, bs, ir_lookup_index,
            &call_info.types
        );
    defer runtime_arg_nodes.deinit();
    var args = std::array::Array<compiled_mir::MirCallArg>(std::mem::page_allocator());
    let receiver_type =
        try compiled_canonical_facts::parsed_canonical_runtime_abi(
            ir_lookup_index, canonical_facts, ir_bytes, call_info.types.receiver_id
        );
    try args.append(compiled_mir::var_call_arg(receiver_type, info.receiver_name));
    var arg_index = 0;
    while arg_index < runtime_arg_nodes.len() {
        let type_id = try compiled_canonical_facts::parsed_call_runtime_type_id(
            canonical_facts, &call_info.types, arg_index
        );
        let arg_type =
            try compiled_canonical_facts::parsed_canonical_runtime_abi(
                ir_lookup_index, canonical_facts, ir_bytes, type_id
            );
        let scalar_arg =
            try compiled_mir_lower_call::lower_single_call_arg_canonical(
                ir_bytes, function_name, module_prefix, params_spec, arg_type,
                try runtime_arg_nodes.get(arg_index), 0, bs, ir_lookup_index,
                canonical_facts, call_arg_type_cache
            );
        if scalar_arg.kind == compiled_mir::MirCallArgKind::String {
            return error("compiled mir: string-literal args unsupported in method-call struct field");
        }
        try args.append(scalar_arg);
        arg_index = arg_index + 1;
    }
    return compiled_mir::call_struct_field(
        field_index,
        call_info.return_llvm_type,
        call_info.module_prefix,
        call_info.callee_name,
        args
    );
}

fn lower_struct_field_computed_binary(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStructField {
    let op = try ir_contract::sequence_fact_value_from(
        ir_bytes, "body-binary ", function_name, field_value, bs
    );
    let left = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_value, "left", 0, bs
    );
    let right = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, field_value, "right", 0, bs
    );
    let right_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, right, bs);
    let left_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, left, bs);
    let left_is_scalar =
        std::mem::equal_bytes(left_kind, "Var") or
        std::mem::equal_bytes(left_kind, "Int");
    let right_is_scalar =
        std::mem::equal_bytes(right_kind, "Var") or
        std::mem::equal_bytes(right_kind, "Int");
    if left_is_scalar and right_is_scalar {
        if !std::mem::equal_bytes(op, "add") and
            !std::mem::equal_bytes(op, "sub") and
            !std::mem::equal_bytes(op, "mul") and
            !std::mem::equal_bytes(op, "div") and
            !std::mem::equal_bytes(op, "mod") {
            return error("compiled mir: unsupported scalar struct field binary op");
        }
        var left_name = "";
        var left_literal = 0;
        let left_is_literal = std::mem::equal_bytes(left_kind, "Int");
        if left_is_literal {
            left_literal = try ir_contract::body_int_value_from(
                ir_bytes, function_name, left, bs
            );
        } else {
            left_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, left, bs
            );
            let left_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
                ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
                left_name, bs, call_arg_type_cache
            );
            if !std::mem::equal_bytes(left_type, "i64") {
                return error("compiled mir: computed struct field lhs must be i64");
            }
        }
        var right_name = "";
        var right_literal = 0;
        let right_is_literal = std::mem::equal_bytes(right_kind, "Int");
        if right_is_literal {
            right_literal = try ir_contract::body_int_value_from(
                ir_bytes, function_name, right, bs
            );
        } else {
            right_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, right, bs
            );
            let right_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
                ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
                right_name, bs, call_arg_type_cache
            );
            if !std::mem::equal_bytes(right_type, "i64") {
                return error("compiled mir: computed struct field rhs must be i64");
            }
        }
        return compiled_mir::computed_scalar_binary_struct_field(
            field_index, op,
            left_name, left_literal, left_is_literal,
            right_name, right_literal, right_is_literal
        );
    }
    if !std::mem::equal_bytes(op, "sub") {
        return error("compiled mir: unsupported computed struct field op");
    }
    if !std::mem::equal_bytes(right_kind, "Var") {
        return error("compiled mir: computed struct field rhs must be Var");
    }
    let right_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, right, bs
    );
    let right_type = try compiled_mir_types::resolve_value_llvm_type_indexed_cached(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        right_name, bs, call_arg_type_cache
    );
    if !std::mem::equal_bytes(right_type, "i64") {
        return error("compiled mir: computed struct field rhs must be i64");
    }
    if !std::mem::equal_bytes(left_kind, "Call") {
        return error("compiled mir: computed struct field lhs must be a call");
    }
    let callee = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, left, "callee", 0, bs
    );
    let method_name = try ir_contract::body_field_expr_name_from(
        ir_bytes, function_name, callee, "field", bs
    );
    if !std::mem::equal_bytes(method_name, "len") {
        return error("compiled mir: computed struct field lhs call must be len");
    }
    let arg_count = try compiled_mir_types::count_call_args(ir_bytes, function_name, left, bs);
    if arg_count != 0 {
        return error("compiled mir: computed struct field len takes no arguments");
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, callee, "receiver", 0, bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes, function_name, receiver, bs
    );
    if !std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return error("compiled mir: computed struct field len receiver must be a field access");
    }
    let root = try ir_contract::body_child_sequence_from(
        ir_bytes, function_name, receiver, "receiver", 0, bs
    );
    let root_kind = try ir_contract::body_node_kind_from(ir_bytes, function_name, root, bs);
    if !std::mem::equal_bytes(root_kind, "Var") {
        return error("compiled mir: computed struct field receiver must start with Var");
    }
    let root_name = try ir_contract::body_token_or_empty_from(
        ir_bytes, function_name, root, bs
    );
    let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        receiver, bs, call_arg_type_cache
    );
    let element_type = compiled_mir_types::array_value_element_kizu_type_or_empty(
        compiled_mir_types::struct_lookup_kizu_type(field.field_kizu_type)
    );
    if std::mem::len(element_type) == 0 {
        return error("compiled mir: computed struct field len receiver is not an Array");
    }
    return compiled_mir::computed_binary_struct_field(
        field_index,
        "i64",
        root_name,
        field.receiver_llvm_type,
        field.field_index,
        right_name
    );
}

// lower_struct_field_struct lowers a nested struct literal used as a struct field
// value (e.g. LocalTable { first: LocalBinding { name: ..., ... } }). It resolves
// the nested struct's LLVM type and recursively lowers its fields, so the nested
// fields support the same kinds as the outer struct (FieldExpr, Int, Call, even a
// further nested struct literal). The renderer builds the nested struct in its own
// insertvalue chain and feeds the result into the parent (tracker 961).
fn lower_struct_field_struct(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    canonical_facts: &compiled_canonical_facts::CanonicalFactTable,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStructField {
    let nested_type = try compiled_signature::resolve_struct_literal_type_indexed(
        ir_lookup_index, ir_bytes, function_name, module_prefix, field_value, bs
    );
    let nested_fields = try lower_struct_fields(
        ir_bytes, function_name, module_prefix, params_spec, field_value, bs,
        ir_lookup_index, canonical_facts, call_arg_type_cache
    );
    return compiled_mir::struct_literal_struct_field(
        field_index,
        nested_type,
        nested_fields
    );
}

fn lower_struct_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStructField {
    // An enum variant in field position is a constant tag; the shared reading resolves it whether
    // the enum is named bare ('MirStorageCodec::None') or module-qualified.
    let variant = try compiled_mir_types::namespace_enum_variant(
        ir_lookup_index, ir_bytes, function_name, module_prefix, field_value, bs,
        call_arg_type_cache
    );
    if variant.found {
        return compiled_mir::enum_tag_struct_field(field_index, variant.tag);
    }
    let receiver = try ir_contract::body_child_sequence_from(
        ir_bytes,
        function_name,
        field_value,
        "receiver",
        0,
        bs
    );
    let receiver_kind = try ir_contract::body_node_kind_from(
        ir_bytes,
        function_name,
        receiver,
        bs
    );
    if std::mem::equal_bytes(receiver_kind, "FieldExpr") {
        return try lower_nested_struct_field_expr(
            ir_bytes,
            function_name,
            module_prefix,
            params_spec,
            field_index,
            field_value,
            receiver,
            bs,
            ir_lookup_index,
            call_arg_type_cache
        );
    }
    if !std::mem::equal_bytes(receiver_kind, "Var") {
        return error("compiled mir: field access receiver must be Var");
    }
    let receiver_name = try ir_contract::body_token_or_empty_from(
        ir_bytes,
        function_name,
        receiver,
        bs
    );
    let field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        field_value, bs, call_arg_type_cache
    );
    return try compiled_mir::field_access_struct_field(
        field_index,
        field.field_llvm_type,
        receiver_name,
        field.receiver_llvm_type,
        field.field_index
    );
}

// lower_nested_struct_field_expr lowers a struct-literal field read through a '.'-chain of any
// depth ('executable_function.body.statement.expr.argument.payload'). It walks from the outermost
// FieldExpr down to the Var root, recording each hop's aggregate type and field index, then emits
// the steps root-first so the renderer can chain the extractions.
fn lower_nested_struct_field_expr(
    ir_bytes: []u8,
    function_name: []u8,
    module_prefix: []u8,
    params_spec: []u8,
    field_index: i64,
    field_value: i64,
    receiver: i64,
    bs: i64,
    ir_lookup_index: &ir_index::IrIndex,
    call_arg_type_cache: &var compiled_mir_types::CallArgTypeCache
) -> !compiled_mir::MirStructField {
    var reversed = std::array::Array<compiled_mir::MirFieldStep>(
        std::mem::page_allocator()
    );
    defer reversed.deinit();
    let value_field = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
        ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
        field_value, bs, call_arg_type_cache
    );
    let result_llvm = value_field.field_llvm_type;
    try reversed.append(compiled_mir::field_step(
        value_field.receiver_llvm_type, value_field.field_index
    ));
    var current = receiver;
    var root_name = ir_bytes[0..0];
    var walking = true;
    while walking {
        let kind = try ir_contract::body_node_kind_from(
            ir_bytes, function_name, current, bs
        );
        if std::mem::equal_bytes(kind, "Var") {
            root_name = try ir_contract::body_token_or_empty_from(
                ir_bytes, function_name, current, bs
            );
            walking = false;
        } else {
            if !std::mem::equal_bytes(kind, "FieldExpr") {
                var message = std::string::String(std::mem::page_allocator());
                try message.append_bytes(
                    "compiled mir: nested field access receiver must start with Var: "
                );
                try message.append_bytes(function_name);
                try message.append_bytes(" node ");
                try std::fmt::append_i64(&var message, current);
                try message.append_bytes(" kind ");
                try message.append_bytes(kind);
                let message_bytes = message.as_bytes();
                return error(message_bytes);
            }
            let hop = try compiled_mir_types::resolve_field_expr_indexed_with_cache(
                ir_lookup_index, ir_bytes, function_name, module_prefix, params_spec,
                current, bs, call_arg_type_cache
            );
            try reversed.append(compiled_mir::field_step(
                hop.receiver_llvm_type, hop.field_index
            ));
            current = try ir_contract::body_child_sequence_from(
                ir_bytes, function_name, current, "receiver", 0, bs
            );
        }
    }
    var steps = std::array::Array<compiled_mir::MirFieldStep>(
        std::mem::page_allocator()
    );
    var index = reversed.len();
    while index > 0 {
        index = index - 1;
        let step = try reversed.at(index);
        try steps.append(compiled_mir::field_step(step.source_type, step.field_index));
    }
    return compiled_mir::field_access_path_struct_field(
        field_index, result_llvm, root_name, steps
    );
}
