import selfhost::backend::ir_contract;

pub fn require_executable_body_parsing(ir_bytes: []u8) -> !void {
    try require_run_parser_body_shape(ir_bytes);
    try require_test_parser_body_shape(ir_bytes);
    try require_parser_source_tokens(ir_bytes);
    return;
}

pub fn unsupported_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::unsupported_executable_ast",
        0
    );
}

pub fn run_print_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        0
    );
}

pub fn run_return_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        0
    );
}

pub fn test_ok_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        0
    );
}

pub fn test_failure_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        1
    );
}

fn executable_ast_result_kind_name(
    ir_bytes: []u8,
    function_name: []u8,
    ordinal: i64
) -> ![]u8 borrows ir_bytes {
    let struct_literal = try ir_contract::body_struct_literal_of_type(
        ir_bytes,
        function_name,
        "data::ExecutableAst",
        ordinal
    );
    let kind_value = try ir_contract::body_struct_field_value(
        ir_bytes,
        function_name,
        struct_literal,
        "kind"
    );
    return try ir_contract::body_field_expr_name(
        ir_bytes,
        function_name,
        kind_value,
        "namespace"
    );
}

fn require_run_parser_body_shape(ir_bytes: []u8) -> !void {
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        "parse_run_program_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_program_ast",
        "parse_run_fn_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        "parse_run_block_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "parse_run_print_stmt_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "parse_run_return_stmt_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        "is_empty_node"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        "parse_run_print_call_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_call_ast",
        "run_string_literal_payload"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        "run_payload_from_literal"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        "is_supported_run_print_payload"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        "Program",
        "parse_run_program_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        "Block",
        "parse_run_block_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "ExprStmt",
        "parse_run_print_stmt_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "Return",
        "parse_run_return_stmt_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        "Call",
        "parse_run_print_call_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        "String",
        "run_payload_from_literal"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        "_",
        "unsupported_executable_ast"
    );
    return;
}

fn require_test_parser_body_shape(ir_bytes: []u8) -> !void {
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "parse_test_program_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_program_ast",
        "parse_test_fn_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "parse_test_block_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "is_void_return_type"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "parse_test_expect_statement_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "is_empty_return"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "parse_expect_stmt_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "parse_expect_call_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        "expect_bool_value"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value",
        "bool_value_as_i64"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "Program",
        "parse_test_program_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "Block",
        "parse_test_block_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "ExprStmt",
        "parse_expect_stmt_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "Call",
        "parse_expect_call_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value",
        "Bool",
        "bool_value_as_i64"
    );
    return;
}

fn require_parser_body_call(ir_bytes: []u8, function_name: []u8, callee: []u8) -> !void {
    try ir_contract::require_body_call(ir_bytes, function_name, callee);
    return;
}

fn require_match_arm_dispatch(
    ir_bytes: []u8,
    function_name: []u8,
    pattern: []u8,
    callee: []u8
) -> !void {
    let arm = try find_match_arm_with_pattern(ir_bytes, function_name, pattern);
    let body = try ir_contract::body_child_sequence(ir_bytes, function_name, arm, "body", 0);
    if try match_arm_body_calls(ir_bytes, function_name, body, callee) {
        return;
    }
    return error("missing IR artifact fact");
}

fn find_match_arm_with_pattern(
    ir_bytes: []u8,
    function_name: []u8,
    pattern: []u8
) -> !i64 {
    return try ir_contract::body_parent_with_child_token(
        ir_bytes,
        function_name,
        "pattern",
        0,
        pattern
    );
}

fn match_arm_body_calls(
    ir_bytes: []u8,
    function_name: []u8,
    body: i64,
    callee: []u8
) -> !bool {
    let body_kind = try ir_contract::body_node_kind(ir_bytes, function_name, body);
    if std::mem::equal_bytes(body_kind, "ExprStmt") {
        let expr = try ir_contract::body_child_sequence(ir_bytes, function_name, body, "expr", 0);
        return try expression_calls(ir_bytes, function_name, expr, callee);
    }
    return try expression_calls(ir_bytes, function_name, body, callee);
}

fn expression_calls(
    ir_bytes: []u8,
    function_name: []u8,
    expression: i64,
    callee: []u8
) -> !bool {
    let expression_kind = try ir_contract::body_node_kind(ir_bytes, function_name, expression);
    if std::mem::equal_bytes(expression_kind, "Call") {
        return try call_matches(ir_bytes, function_name, expression, callee);
    }
    if std::mem::equal_bytes(expression_kind, "TryExpr") {
        let value = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            expression,
            "value",
            0
        );
        return try expression_calls(ir_bytes, function_name, value, callee);
    }
    return false;
}

fn call_matches(ir_bytes: []u8, function_name: []u8, call: i64, callee: []u8) -> !bool {
    let actual = try ir_contract::body_call_callee_or_empty(ir_bytes, function_name, call);
    return std::mem::equal_bytes(actual, callee);
}

fn require_parser_source_tokens(ir_bytes: []u8) -> !void {
    try require_parser_source_token(ir_bytes, "syntax-fn", "fn");
    try require_parser_source_token(ir_bytes, "syntax-test", "test");
    try require_parser_source_token(ir_bytes, "syntax-return", "return");
    try require_parser_source_token(ir_bytes, "syntax-void", "void");
    try require_parser_source_token(ir_bytes, "value-main", "main");
    try require_parser_source_token(ir_bytes, "run-print-callee", "print");
    try require_parser_source_token(ir_bytes, "expect-callee-root", "std");
    try require_parser_source_token(ir_bytes, "expect-callee-module", "testing");
    try require_parser_source_token(ir_bytes, "expect-callee-function", "expect");
    try require_parser_source_token(ir_bytes, "literal-true", "true");
    try require_parser_source_token(ir_bytes, "literal-false", "false");
    return;
}

fn require_parser_source_token(ir_bytes: []u8, key: []u8, value: []u8) -> !void {
    try ir_contract::require_named_fact(
        ir_bytes,
        "executable-parser-token ",
        key,
        value
    );
    return;
}
