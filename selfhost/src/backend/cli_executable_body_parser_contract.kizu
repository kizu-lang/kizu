import selfhost::backend::ir_contract;

pub fn require_executable_body_parsing(ir_bytes: []u8) -> !void {
    try require_run_parser_body_shape(ir_bytes);
    try require_test_parser_body_shape(ir_bytes);
    try require_run_payload_byte_contract(ir_bytes);
    try require_test_expect_value_contract(ir_bytes);
    try require_parser_source_tokens(ir_bytes);
    return;
}

pub fn run_literal_quote_byte(ir_bytes: []u8) -> !i64 {
    let function_name = "selfhost::backend::executable::run_payload_from_literal";
    let start_quote = try literal_boundary_quote_byte(ir_bytes, function_name, 0);
    let end_quote = try literal_boundary_quote_byte(ir_bytes, function_name, 1);
    if start_quote != end_quote {
        return error("invalid executable parser payload contract");
    }
    let forbidden_quote = try run_payload_forbidden_byte(ir_bytes);
    if start_quote != forbidden_quote {
        return error("invalid executable parser payload contract");
    }
    return start_quote;
}

pub fn run_literal_min_length(ir_bytes: []u8) -> !i64 {
    return try binary_right_i64_value_for_left_var(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        "lt",
        "length"
    );
}

pub fn run_literal_start_quote_offset(ir_bytes: []u8) -> !i64 {
    let function_name = "selfhost::backend::executable::run_payload_from_literal";
    let index = try literal_boundary_index_expr(ir_bytes, function_name, 0);
    return try index_start_i64_value(ir_bytes, function_name, index);
}

pub fn run_literal_end_quote_offset_from_end(ir_bytes: []u8) -> !i64 {
    let function_name = "selfhost::backend::executable::run_payload_from_literal";
    let index = try literal_boundary_index_expr(ir_bytes, function_name, 1);
    let start = try ir_contract::body_child_sequence(ir_bytes, function_name, index, "start", 0);
    return try length_minus_i64_value(ir_bytes, function_name, start);
}

pub fn run_literal_payload_start_offset(ir_bytes: []u8) -> !i64 {
    let function_name = "selfhost::backend::executable::run_payload_from_literal";
    let index = try run_literal_payload_index_expr(ir_bytes, function_name);
    return try index_start_i64_value(ir_bytes, function_name, index);
}

pub fn run_literal_payload_end_margin(ir_bytes: []u8) -> !i64 {
    let function_name = "selfhost::backend::executable::run_payload_from_literal";
    let index = try run_literal_payload_index_expr(ir_bytes, function_name);
    let end = try ir_contract::body_child_sequence(ir_bytes, function_name, index, "end", 0);
    return try length_minus_i64_value(ir_bytes, function_name, end);
}

pub fn run_literal_payload_delimiter_width(ir_bytes: []u8) -> !i64 {
    let start_offset = try run_literal_payload_start_offset(ir_bytes);
    let end_margin = try run_literal_payload_end_margin(ir_bytes);
    return start_offset + end_margin;
}

pub fn run_payload_min_byte(ir_bytes: []u8) -> !i64 {
    return try payload_guard_byte_constant(ir_bytes, "lt");
}

pub fn run_payload_max_byte(ir_bytes: []u8) -> !i64 {
    return try payload_guard_byte_constant(ir_bytes, "gt");
}

pub fn run_payload_forbidden_byte(ir_bytes: []u8) -> !i64 {
    return try payload_guard_byte_constant(ir_bytes, "eq");
}

pub fn test_expect_true_value(ir_bytes: []u8) -> !i64 {
    return try bool_value_return_value(ir_bytes, true);
}

pub fn test_expect_false_value(ir_bytes: []u8) -> !i64 {
    return try bool_value_return_value(ir_bytes, false);
}

pub fn test_expect_unsupported_value(ir_bytes: []u8) -> !i64 {
    let function_name = "selfhost::backend::executable::expect_bool_value";
    let arm = try find_match_arm_with_pattern(ir_bytes, function_name, "_");
    let body = try ir_contract::body_child_sequence(ir_bytes, function_name, arm, "body", 0);
    return try match_arm_i64_value(ir_bytes, function_name, body);
}

pub fn unsupported_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::unsupported_executable_ast",
        0
    );
}

pub fn run_print_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        0
    );
}

pub fn run_return_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        0
    );
}

pub fn test_ok_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        0
    );
}

pub fn test_failure_ast_kind_name(ir_bytes: []u8) -> ![]u8 borrows ir_bytes {
    return try executable_ast_result_kind_name(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        1
    );
}

fn executable_ast_result_kind_name(
    ir_bytes: []u8,
    function_name: []u8,
    ordinal: i64
) -> ![]u8 borrows ir_bytes {
    let struct_literal = try ir_contract::body_struct_literal_of_type(
        ir_bytes,
        function_name,
        "data::ExecutableAst",
        ordinal
    );
    let kind_value = try ir_contract::body_struct_field_value(
        ir_bytes,
        function_name,
        struct_literal,
        "kind"
    );
    return try ir_contract::body_field_expr_name(
        ir_bytes,
        function_name,
        kind_value,
        "namespace"
    );
}

fn require_run_payload_byte_contract(ir_bytes: []u8) -> !void {
    let quote = try run_literal_quote_byte(ir_bytes);
    let min_length = try run_literal_min_length(ir_bytes);
    let start_quote_offset = try run_literal_start_quote_offset(ir_bytes);
    let end_quote_margin = try run_literal_end_quote_offset_from_end(ir_bytes);
    let payload_start_offset = try run_literal_payload_start_offset(ir_bytes);
    let payload_end_margin = try run_literal_payload_end_margin(ir_bytes);
    let payload_delimiter_width = try run_literal_payload_delimiter_width(ir_bytes);
    let min = try run_payload_min_byte(ir_bytes);
    let max = try run_payload_max_byte(ir_bytes);
    let forbidden = try run_payload_forbidden_byte(ir_bytes);
    if min_length < 1 or start_quote_offset < 0 or end_quote_margin < 1 {
        return error("invalid executable parser payload contract");
    }
    if payload_start_offset < 1 or payload_end_margin < 1 {
        return error("invalid executable parser payload contract");
    }
    if start_quote_offset >= payload_start_offset or end_quote_margin != payload_end_margin {
        return error("invalid executable parser payload contract");
    }
    if min_length != payload_delimiter_width {
        return error("invalid executable parser payload contract");
    }
    if min > max or forbidden < min or forbidden > max or quote != forbidden {
        return error("invalid executable parser payload contract");
    }
    return;
}

fn require_test_expect_value_contract(ir_bytes: []u8) -> !void {
    let true_value = try test_expect_true_value(ir_bytes);
    let false_value = try test_expect_false_value(ir_bytes);
    let unsupported = try test_expect_unsupported_value(ir_bytes);
    if true_value == false_value or unsupported == true_value or unsupported == false_value {
        return error("invalid executable parser expect contract");
    }
    return;
}

fn bool_value_return_value(ir_bytes: []u8, value: bool) -> !i64 {
    let function_name = "selfhost::backend::executable::bool_value_as_i64";
    let if_sequence = try bool_value_if_sequence(ir_bytes, function_name);
    if value {
        let then_block = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            if_sequence,
            "then",
            0
        );
        let statement = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            then_block,
            "statement",
            0
        );
        return try return_i64_value(ir_bytes, function_name, statement);
    }
    return try bool_value_fallback_return_value(ir_bytes, function_name, if_sequence);
}

fn bool_value_if_sequence(ir_bytes: []u8, function_name: []u8) -> !i64 {
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    while sequence < count {
        let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
        if std::mem::equal_bytes(kind, "If") {
            let condition = try ir_contract::body_child_sequence(
                ir_bytes,
                function_name,
                sequence,
                "condition",
                0
            );
            if try node_token_matches(ir_bytes, function_name, condition, "Var", "value") {
                return sequence;
            }
        }
        sequence = sequence + 1;
    }
    return error("missing IR artifact fact");
}

fn bool_value_fallback_return_value(
    ir_bytes: []u8,
    function_name: []u8,
    if_sequence: i64
) -> !i64 {
    let root = 0;
    var ordinal = 0;
    while ordinal < 8 {
        let statement = try ir_contract::body_child_sequence_or_minus_one(
            ir_bytes,
            function_name,
            root,
            "statement",
            ordinal
        );
        if statement < 0 {
            return error("missing IR artifact fact");
        }
        if statement != if_sequence {
            let kind = try ir_contract::body_node_kind(ir_bytes, function_name, statement);
            if std::mem::equal_bytes(kind, "Return") {
                return try return_i64_value(ir_bytes, function_name, statement);
            }
        }
        ordinal = ordinal + 1;
    }
    return error("missing IR artifact fact");
}

fn return_i64_value(ir_bytes: []u8, function_name: []u8, sequence: i64) -> !i64 {
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if !std::mem::equal_bytes(kind, "Return") {
        return error("invalid executable parser payload contract");
    }
    let value = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        sequence,
        "value",
        0
    );
    return try expression_i64_value(ir_bytes, function_name, value);
}

fn match_arm_i64_value(ir_bytes: []u8, function_name: []u8, sequence: i64) -> !i64 {
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if std::mem::equal_bytes(kind, "ExprStmt") {
        let expr = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            sequence,
            "expr",
            0
        );
        return try expression_i64_value(ir_bytes, function_name, expr);
    }
    return try expression_i64_value(ir_bytes, function_name, sequence);
}

fn expression_i64_value(ir_bytes: []u8, function_name: []u8, sequence: i64) -> !i64 {
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if std::mem::equal_bytes(kind, "Int") {
        return try ir_contract::body_int_value(ir_bytes, function_name, sequence);
    }
    if std::mem::equal_bytes(kind, "Prefix") {
        let op = try ir_contract::sequence_fact_value(
            ir_bytes,
            "body-prefix ",
            function_name,
            sequence
        );
        if std::mem::equal_bytes(op, "neg") {
            let right = try ir_contract::body_child_sequence(
                ir_bytes,
                function_name,
                sequence,
                "right",
                0
            );
            let value = try expression_i64_value(ir_bytes, function_name, right);
            return 0 - value;
        }
    }
    return error("invalid executable parser payload contract");
}

fn require_run_parser_body_shape(ir_bytes: []u8) -> !void {
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        "parse_run_program_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_program_ast",
        "parse_run_fn_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        "parse_run_block_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "parse_run_print_stmt_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "parse_run_return_stmt_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        "is_empty_node"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        "parse_run_print_call_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_call_ast",
        "run_string_literal_payload"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        "run_payload_from_literal"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        "is_supported_run_print_payload"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        "Program",
        "parse_run_program_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        "Block",
        "parse_run_block_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "ExprStmt",
        "parse_run_print_stmt_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "Return",
        "parse_run_return_stmt_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        "Call",
        "parse_run_print_call_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        "String",
        "run_payload_from_literal"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        "_",
        "unsupported_executable_ast"
    );
    return;
}

fn payload_guard_byte_constant(ir_bytes: []u8, op: []u8) -> !i64 {
    let function_name = "selfhost::backend::executable::is_supported_run_print_payload";
    return try binary_right_cast_u8_int_value_for_left_var(
        ir_bytes,
        function_name,
        op,
        "byte"
    );
}

fn binary_right_cast_u8_int_value_for_left_var(
    ir_bytes: []u8,
    function_name: []u8,
    op: []u8,
    variable: []u8
) -> !i64 {
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    while sequence < count {
        if try binary_op_matches(ir_bytes, function_name, sequence, op) {
            let left = try ir_contract::body_child_sequence(
                ir_bytes,
                function_name,
                sequence,
                "left",
                0
            );
            if try node_token_matches(ir_bytes, function_name, left, "Var", variable) {
                let right = try ir_contract::body_child_sequence(
                    ir_bytes,
                    function_name,
                    sequence,
                    "right",
                    0
                );
                return try cast_u8_int_value(ir_bytes, function_name, right);
            }
        }
        sequence = sequence + 1;
    }
    return error("missing IR artifact fact");
}

fn binary_right_i64_value_for_left_var(
    ir_bytes: []u8,
    function_name: []u8,
    op: []u8,
    variable: []u8
) -> !i64 {
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    while sequence < count {
        if try binary_op_matches(ir_bytes, function_name, sequence, op) {
            let left = try ir_contract::body_child_sequence(
                ir_bytes,
                function_name,
                sequence,
                "left",
                0
            );
            if try node_token_matches(ir_bytes, function_name, left, "Var", variable) {
                let right = try ir_contract::body_child_sequence(
                    ir_bytes,
                    function_name,
                    sequence,
                    "right",
                    0
                );
                return try expression_i64_value(ir_bytes, function_name, right);
            }
        }
        sequence = sequence + 1;
    }
    return error("missing IR artifact fact");
}

fn literal_boundary_quote_binary(
    ir_bytes: []u8,
    function_name: []u8,
    ordinal: i64
) -> !i64 {
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    var matched = 0;
    while sequence < count {
        if try binary_op_matches(ir_bytes, function_name, sequence, "not-eq") {
            let left = try ir_contract::body_child_sequence(
                ir_bytes,
                function_name,
                sequence,
                "left",
                0
            );
            if try index_target_matches(ir_bytes, function_name, left, "literal") {
                if matched == ordinal {
                    return sequence;
                }
                matched = matched + 1;
            }
        }
        sequence = sequence + 1;
    }
    return error("missing IR artifact fact");
}

fn literal_boundary_quote_byte(
    ir_bytes: []u8,
    function_name: []u8,
    ordinal: i64
) -> !i64 {
    let binary = try literal_boundary_quote_binary(ir_bytes, function_name, ordinal);
    let right = try ir_contract::body_child_sequence(ir_bytes, function_name, binary, "right", 0);
    return try cast_u8_int_value(ir_bytes, function_name, right);
}

fn literal_boundary_index_expr(
    ir_bytes: []u8,
    function_name: []u8,
    ordinal: i64
) -> !i64 {
    let binary = try literal_boundary_quote_binary(ir_bytes, function_name, ordinal);
    return try ir_contract::body_child_sequence(ir_bytes, function_name, binary, "left", 0);
}

fn run_literal_payload_index_expr(ir_bytes: []u8, function_name: []u8) -> !i64 {
    let value = try let_value_with_name(ir_bytes, function_name, "payload");
    if !(try index_target_matches(ir_bytes, function_name, value, "literal")) {
        return error("invalid executable parser payload contract");
    }
    return value;
}

fn let_value_with_name(ir_bytes: []u8, function_name: []u8, name: []u8) -> !i64 {
    let count = try ir_contract::body_node_count(ir_bytes, function_name);
    var sequence = 0;
    while sequence < count {
        let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
        if std::mem::equal_bytes(kind, "Let") {
            let actual = try ir_contract::sequence_fact_value(
                ir_bytes,
                "body-let ",
                function_name,
                sequence
            );
            if std::mem::equal_bytes(actual, name) {
                return try ir_contract::body_child_sequence(
                    ir_bytes,
                    function_name,
                    sequence,
                    "value",
                    0
                );
            }
        }
        sequence = sequence + 1;
    }
    return error("missing IR artifact fact");
}

fn index_start_i64_value(ir_bytes: []u8, function_name: []u8, sequence: i64) -> !i64 {
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if !std::mem::equal_bytes(kind, "IndexExpr") {
        return error("invalid executable parser payload contract");
    }
    let start = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        sequence,
        "start",
        0
    );
    return try expression_i64_value(ir_bytes, function_name, start);
}

fn length_minus_i64_value(ir_bytes: []u8, function_name: []u8, sequence: i64) -> !i64 {
    if !(try binary_op_matches(ir_bytes, function_name, sequence, "sub")) {
        return error("invalid executable parser payload contract");
    }
    let left = try ir_contract::body_child_sequence(ir_bytes, function_name, sequence, "left", 0);
    if !(try node_token_matches(ir_bytes, function_name, left, "Var", "length")) {
        return error("invalid executable parser payload contract");
    }
    let right = try ir_contract::body_child_sequence(ir_bytes, function_name, sequence, "right", 0);
    return try expression_i64_value(ir_bytes, function_name, right);
}

fn binary_op_matches(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    op: []u8
) -> !bool {
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if !std::mem::equal_bytes(kind, "Binary") {
        return false;
    }
    let actual = try ir_contract::sequence_fact_value(
        ir_bytes,
        "body-binary ",
        function_name,
        sequence
    );
    return std::mem::equal_bytes(actual, op);
}

fn index_target_matches(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    variable: []u8
) -> !bool {
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if !std::mem::equal_bytes(kind, "IndexExpr") {
        return false;
    }
    let target = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        sequence,
        "target",
        0
    );
    return try node_token_matches(ir_bytes, function_name, target, "Var", variable);
}

fn cast_u8_int_value(ir_bytes: []u8, function_name: []u8, sequence: i64) -> !i64 {
    let kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if !std::mem::equal_bytes(kind, "CastExpr") {
        return error("invalid executable parser payload contract");
    }
    let type_node = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        sequence,
        "type",
        0
    );
    if !(try node_token_matches(ir_bytes, function_name, type_node, "TypeName", "u8")) {
        return error("invalid executable parser payload contract");
    }
    let value = try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        sequence,
        "value",
        0
    );
    return try ir_contract::body_int_value(ir_bytes, function_name, value);
}

fn node_token_matches(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    kind: []u8,
    token: []u8
) -> !bool {
    let actual_kind = try ir_contract::body_node_kind(ir_bytes, function_name, sequence);
    if !std::mem::equal_bytes(actual_kind, kind) {
        return false;
    }
    let actual = try ir_contract::body_token_or_empty(ir_bytes, function_name, sequence);
    return std::mem::equal_bytes(actual, token);
}

fn require_test_parser_body_shape(ir_bytes: []u8) -> !void {
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "parse_test_program_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_program_ast",
        "parse_test_fn_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "parse_test_block_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "is_void_return_type"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "parse_test_expect_statement_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "is_empty_return"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "parse_expect_stmt_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "parse_expect_call_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        "expect_bool_value"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value",
        "bool_value_as_i64"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "Program",
        "parse_test_program_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "Block",
        "parse_test_block_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "ExprStmt",
        "parse_expect_stmt_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "Call",
        "parse_expect_call_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value",
        "Bool",
        "bool_value_as_i64"
    );
    return;
}

fn require_parser_body_call(ir_bytes: []u8, function_name: []u8, callee: []u8) -> !void {
    try ir_contract::require_body_call(ir_bytes, function_name, callee);
    return;
}

fn require_match_arm_dispatch(
    ir_bytes: []u8,
    function_name: []u8,
    pattern: []u8,
    callee: []u8
) -> !void {
    let arm = try find_match_arm_with_pattern(ir_bytes, function_name, pattern);
    let body = try ir_contract::body_child_sequence(ir_bytes, function_name, arm, "body", 0);
    if try match_arm_body_calls(ir_bytes, function_name, body, callee) {
        return;
    }
    return error("missing IR artifact fact");
}

fn find_match_arm_with_pattern(
    ir_bytes: []u8,
    function_name: []u8,
    pattern: []u8
) -> !i64 {
    return try ir_contract::body_parent_with_child_token(
        ir_bytes,
        function_name,
        "pattern",
        0,
        pattern
    );
}

fn match_arm_body_calls(
    ir_bytes: []u8,
    function_name: []u8,
    body: i64,
    callee: []u8
) -> !bool {
    let body_kind = try ir_contract::body_node_kind(ir_bytes, function_name, body);
    if std::mem::equal_bytes(body_kind, "ExprStmt") {
        let expr = try ir_contract::body_child_sequence(ir_bytes, function_name, body, "expr", 0);
        return try expression_calls(ir_bytes, function_name, expr, callee);
    }
    return try expression_calls(ir_bytes, function_name, body, callee);
}

fn expression_calls(
    ir_bytes: []u8,
    function_name: []u8,
    expression: i64,
    callee: []u8
) -> !bool {
    let expression_kind = try ir_contract::body_node_kind(ir_bytes, function_name, expression);
    if std::mem::equal_bytes(expression_kind, "Call") {
        return try call_matches(ir_bytes, function_name, expression, callee);
    }
    if std::mem::equal_bytes(expression_kind, "TryExpr") {
        let value = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            expression,
            "value",
            0
        );
        return try expression_calls(ir_bytes, function_name, value, callee);
    }
    return false;
}

fn call_matches(ir_bytes: []u8, function_name: []u8, call: i64, callee: []u8) -> !bool {
    let actual = try ir_contract::body_call_callee_or_empty(ir_bytes, function_name, call);
    return std::mem::equal_bytes(actual, callee);
}

fn require_parser_source_tokens(ir_bytes: []u8) -> !void {
    try require_parser_source_token(ir_bytes, "syntax-fn", "fn");
    try require_parser_source_token(ir_bytes, "syntax-test", "test");
    try require_parser_source_token(ir_bytes, "syntax-lparen", "(");
    try require_parser_source_token(ir_bytes, "syntax-rparen", ")");
    try require_parser_source_token(ir_bytes, "syntax-lbrace", "{");
    try require_parser_source_token(ir_bytes, "syntax-rbrace", "}");
    try require_parser_source_token(ir_bytes, "syntax-semicolon", ";");
    try require_parser_source_token(ir_bytes, "syntax-colon-pair", "::");
    try require_parser_source_token(ir_bytes, "syntax-return-arrow", "->");
    try require_parser_source_token(ir_bytes, "syntax-bang", "!");
    try require_parser_source_token(ir_bytes, "syntax-return", "return");
    try require_parser_source_token(ir_bytes, "syntax-void", "void");
    try require_parser_source_token(ir_bytes, "value-main", "main");
    try require_parser_source_token(ir_bytes, "run-print-callee", "print");
    try require_parser_source_token(ir_bytes, "expect-callee-root", "std");
    try require_parser_source_token(ir_bytes, "expect-callee-module", "testing");
    try require_parser_source_token(ir_bytes, "expect-callee-function", "expect");
    try require_parser_source_token(ir_bytes, "literal-true", "true");
    try require_parser_source_token(ir_bytes, "literal-false", "false");
    return;
}

fn require_parser_source_token(ir_bytes: []u8, key: []u8, value: []u8) -> !void {
    try ir_contract::require_named_fact(
        ir_bytes,
        "executable-parser-token ",
        key,
        value
    );
    return;
}
