import selfhost::backend::ir_contract;

pub fn require_selected_body_parsing(ir_bytes: []u8) -> !void {
    try ir_contract::require_fact(
        ir_bytes,
        "executable-selected-body-parsing checked-ast-body-parsing-v1"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-parsing ",
        "selfhost::backend::executable::parse_run_executable_ast",
        "checked-run-ast"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-parsing ",
        "selfhost::backend::executable::parse_test_executable_ast",
        "checked-test-ast"
    );
    try require_run_parser_body_shape(ir_bytes);
    try require_test_parser_body_shape(ir_bytes);
    return;
}

fn require_run_parser_body_shape(ir_bytes: []u8) -> !void {
    let parse_run_program = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast",
        parse_run_program,
        "parse_run_program_ast"
    );

    let parse_run_fn = try loop_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_program_ast",
        1,
        2,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_program_ast",
        parse_run_fn,
        "parse_run_fn_ast"
    );

    let parse_run_block = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        2,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast",
        parse_run_block,
        "parse_run_block_ast"
    );

    let parse_run_print = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        3,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        parse_run_print,
        "parse_run_print_stmt_ast"
    );

    let parse_run_return = try return_match_arm_expr(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        3,
        1
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast",
        parse_run_return,
        "parse_run_return_stmt_ast"
    );

    let is_empty = try function_if_condition_prefix_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast",
        is_empty,
        "is_empty_node"
    );

    let parse_run_print_call = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast",
        parse_run_print_call,
        "parse_run_print_call_ast"
    );

    let run_string_literal = try function_statement_value(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_call_ast",
        2
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_call_ast",
        run_string_literal,
        "run_string_literal_payload"
    );

    let run_payload = try return_match_arm_expr(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload",
        run_payload,
        "run_payload_from_literal"
    );

    let is_supported = try function_if_condition_prefix_call(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        4
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal",
        is_supported,
        "is_supported_run_print_payload"
    );
    return;
}

fn require_test_parser_body_shape(ir_bytes: []u8) -> !void {
    let parse_test_program = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        parse_test_program,
        "parse_test_program_ast"
    );

    let parse_test_fn = try loop_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_program_ast",
        1,
        2,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_program_ast",
        parse_test_fn,
        "parse_test_fn_ast"
    );

    let parse_test_block = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        2,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        parse_test_block,
        "parse_test_block_ast"
    );

    let is_void = try function_if_condition_right_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        is_void,
        "is_void_return_type"
    );

    let parse_single_statement_expect = try if_then_return_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        0,
        1
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        parse_single_statement_expect,
        "parse_test_expect_statement_ast"
    );

    let is_empty_return = try function_if_condition_prefix_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        4
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        is_empty_return,
        "is_empty_return"
    );

    let parse_two_statement_expect = try return_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        5
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        parse_two_statement_expect,
        "parse_test_expect_statement_ast"
    );

    let parse_expect_stmt = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        parse_expect_stmt,
        "parse_expect_stmt_ast"
    );

    let parse_expect_call = try return_match_arm_try_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        parse_expect_call,
        "parse_expect_call_ast"
    );

    let expect_bool = try function_statement_value(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        2
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        expect_bool,
        "expect_bool_value"
    );

    let bool_value = try return_match_arm_expr(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value",
        1,
        0
    );
    try require_body_call(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value",
        bool_value,
        "bool_value_as_i64"
    );
    return;
}

fn function_statement_sequence(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    return try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        0,
        "statement",
        statement_index
    );
}

fn child_sequence(
    ir_bytes: []u8,
    function_name: []u8,
    parent_sequence: i64,
    edge: []u8,
    ordinal: i64
) -> !i64 {
    return try ir_contract::body_child_sequence(
        ir_bytes,
        function_name,
        parent_sequence,
        edge,
        ordinal
    );
}

fn function_statement_value(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    let statement = try function_statement_sequence(ir_bytes, function_name, statement_index);
    return try child_sequence(ir_bytes, function_name, statement, "value", 0);
}

fn return_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    return try function_statement_value(ir_bytes, function_name, statement_index);
}

fn return_match_arm_expr(
    ir_bytes: []u8,
    function_name: []u8,
    return_statement_index: i64,
    arm_index: i64
) -> !i64 {
    let match_sequence = try return_call(ir_bytes, function_name, return_statement_index);
    return try match_arm_expr(ir_bytes, function_name, match_sequence, arm_index);
}

fn return_match_arm_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    return_statement_index: i64,
    arm_index: i64
) -> !i64 {
    let expr = try return_match_arm_expr(ir_bytes, function_name, return_statement_index, arm_index);
    return try child_sequence(ir_bytes, function_name, expr, "value", 0);
}

fn loop_match_arm_try_call(
    ir_bytes: []u8,
    function_name: []u8,
    loop_statement_index: i64,
    loop_body_statement_index: i64,
    arm_index: i64
) -> !i64 {
    let loop_sequence = try function_statement_sequence(ir_bytes, function_name, loop_statement_index);
    let loop_body = try child_sequence(ir_bytes, function_name, loop_sequence, "body", 0);
    let let_sequence = try child_sequence(
        ir_bytes,
        function_name,
        loop_body,
        "statement",
        loop_body_statement_index
    );
    let match_sequence = try child_sequence(ir_bytes, function_name, let_sequence, "value", 0);
    let expr = try match_arm_expr(ir_bytes, function_name, match_sequence, arm_index);
    return try child_sequence(ir_bytes, function_name, expr, "value", 0);
}

fn match_arm_expr(
    ir_bytes: []u8,
    function_name: []u8,
    match_sequence: i64,
    arm_index: i64
) -> !i64 {
    let arm = try child_sequence(ir_bytes, function_name, match_sequence, "arm", arm_index);
    let body = try child_sequence(ir_bytes, function_name, arm, "body", 0);
    return try child_sequence(ir_bytes, function_name, body, "expr", 0);
}

fn function_if_condition_right_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    let if_sequence = try function_statement_sequence(ir_bytes, function_name, statement_index);
    let condition = try child_sequence(ir_bytes, function_name, if_sequence, "condition", 0);
    return try child_sequence(ir_bytes, function_name, condition, "right", 0);
}

fn function_if_condition_prefix_call(
    ir_bytes: []u8,
    function_name: []u8,
    statement_index: i64
) -> !i64 {
    let if_sequence = try function_statement_sequence(ir_bytes, function_name, statement_index);
    let prefix = try child_sequence(ir_bytes, function_name, if_sequence, "condition", 0);
    return try child_sequence(ir_bytes, function_name, prefix, "right", 0);
}

fn if_then_return_call(
    ir_bytes: []u8,
    function_name: []u8,
    if_statement_index: i64,
    then_statement_index: i64
) -> !i64 {
    let if_sequence = try function_statement_sequence(ir_bytes, function_name, if_statement_index);
    let then_block = try child_sequence(ir_bytes, function_name, if_sequence, "then", 0);
    let return_sequence = try child_sequence(
        ir_bytes,
        function_name,
        then_block,
        "statement",
        then_statement_index
    );
    return try child_sequence(ir_bytes, function_name, return_sequence, "value", 0);
}

fn require_body_call(
    ir_bytes: []u8,
    function_name: []u8,
    sequence: i64,
    callee: []u8
) -> !void {
    try ir_contract::require_sequence_fact(ir_bytes, "body-call ", function_name, sequence, callee);
    return;
}
