import selfhost::backend::ir_contract;

pub fn require_selected_body_parsing(ir_bytes: []u8) -> !void {
    try ir_contract::require_fact(
        ir_bytes,
        "executable-selected-body-parsing checked-ast-body-parsing-v1"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-parsing ",
        "selfhost::backend::executable::parse_run_executable_ast",
        "checked-run-ast"
    );
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-parsing ",
        "selfhost::backend::executable::parse_test_executable_ast",
        "checked-test-ast"
    );
    try require_run_parser_body_shape(ir_bytes);
    try require_test_parser_body_shape(ir_bytes);
    return;
}

fn require_run_parser_body_shape(ir_bytes: []u8) -> !void {
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_executable_ast#parse_run_program_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_program_ast#parse_run_fn_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_fn_ast#parse_run_block_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast#parse_run_print_stmt_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_block_ast#parse_run_return_stmt_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_return_stmt_ast#is_empty_node"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_stmt_ast#parse_run_print_call_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_run_print_call_ast#run_string_literal_payload"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::run_string_literal_payload#run_payload_from_literal"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::run_payload_from_literal#is_supported_run_print_payload"
    );
    return;
}

fn require_test_parser_body_shape(ir_bytes: []u8) -> !void {
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast#parse_test_program_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_program_ast#parse_test_fn_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast#parse_test_block_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast#is_void_return_type"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast#parse_test_expect_statement_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast#is_empty_return"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast#parse_expect_stmt_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast#parse_expect_call_ast"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast#expect_bool_value"
    );
    try require_selected_body_parsing_call(
        ir_bytes,
        "selfhost::backend::executable::expect_bool_value#bool_value_as_i64"
    );
    return;
}

fn require_selected_body_parsing_call(ir_bytes: []u8, key: []u8) -> !void {
    try ir_contract::require_named_fact(
        ir_bytes,
        "selected-body-parsing-call ",
        key,
        "checked-call"
    );
    return;
}
