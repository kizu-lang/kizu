import selfhost::backend::ir_contract;

pub fn require_executable_body_parsing(ir_bytes: []u8) -> !void {
    try require_test_parser_body_shape(ir_bytes);
    return;
}

fn require_test_parser_body_shape(ir_bytes: []u8) -> !void {
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "parse_test_program_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_program_ast",
        "parse_test_fn_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "parse_test_block_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "is_void_return_type"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "parse_test_expect_statement_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_block_ast",
        "is_empty_return"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "parse_expect_stmt_ast"
    );
    try require_parser_body_call(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "parse_expect_call_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "Program",
        "parse_test_program_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_executable_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "Block",
        "parse_test_block_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_fn_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "ExprStmt",
        "parse_expect_stmt_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_test_expect_statement_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "Call",
        "parse_expect_call_ast"
    );
    try require_match_arm_dispatch(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_stmt_ast",
        "_",
        "unsupported_executable_ast"
    );
    try require_match_arm_pattern(
        ir_bytes,
        "selfhost::backend::executable::parse_expect_call_ast",
        "Bool"
    );
    return;
}

fn require_parser_body_call(ir_bytes: []u8, function_name: []u8, callee: []u8) -> !void {
    try ir_contract::require_body_call(ir_bytes, function_name, callee);
    return;
}

fn require_match_arm_dispatch(
    ir_bytes: []u8,
    function_name: []u8,
    pattern: []u8,
    callee: []u8
) -> !void {
    let arm = try find_match_arm_with_pattern(ir_bytes, function_name, pattern);
    let body = try ir_contract::body_child_sequence(ir_bytes, function_name, arm, "body", 0);
    if try match_arm_body_calls(ir_bytes, function_name, body, callee) {
        return;
    }
    return error("missing IR artifact fact");
}

fn require_match_arm_pattern(
    ir_bytes: []u8,
    function_name: []u8,
    pattern: []u8
) -> !void {
    let arm = try find_match_arm_with_pattern(ir_bytes, function_name, pattern);
    if arm >= 0 {
        return;
    }
    return error("missing IR artifact fact");
}

fn find_match_arm_with_pattern(
    ir_bytes: []u8,
    function_name: []u8,
    pattern: []u8
) -> !i64 {
    return try ir_contract::body_parent_with_child_token(
        ir_bytes,
        function_name,
        "pattern",
        0,
        pattern
    );
}

fn match_arm_body_calls(
    ir_bytes: []u8,
    function_name: []u8,
    body: i64,
    callee: []u8
) -> !bool {
    let body_kind = try ir_contract::body_node_kind(ir_bytes, function_name, body);
    if std::mem::equal_bytes(body_kind, "ExprStmt") {
        let expr = try ir_contract::body_child_sequence(ir_bytes, function_name, body, "expr", 0);
        return try expression_calls(ir_bytes, function_name, expr, callee);
    }
    return try expression_calls(ir_bytes, function_name, body, callee);
}

fn expression_calls(
    ir_bytes: []u8,
    function_name: []u8,
    expression: i64,
    callee: []u8
) -> !bool {
    let expression_kind = try ir_contract::body_node_kind(ir_bytes, function_name, expression);
    if std::mem::equal_bytes(expression_kind, "Call") {
        return try call_matches(ir_bytes, function_name, expression, callee);
    }
    if std::mem::equal_bytes(expression_kind, "TryExpr") {
        let value = try ir_contract::body_child_sequence(
            ir_bytes,
            function_name,
            expression,
            "value",
            0
        );
        return try expression_calls(ir_bytes, function_name, value, callee);
    }
    return false;
}

fn call_matches(ir_bytes: []u8, function_name: []u8, call: i64, callee: []u8) -> !bool {
    let actual = try ir_contract::body_call_callee_or_empty(ir_bytes, function_name, call);
    return std::mem::equal_bytes(actual, callee);
}
