import selfhost::backend::mir_env;

// mir_env_loop is the loop half of the construction in mir_env.kizu: the phis a loop header opens
// for the names its body assigns, the back edges that close them, and the exit phis a break makes
// necessary. It is a port of internal/ir/control.go's pushLoop / findLoop / lowerLoopBranch /
// createLoopPhis / finishLoopPhis / finishLoopExitPhis, which together are that file's whole loop
// story -- thirty lines of lowerWhileStmt, for every loop shape there is.
//
// It is a separate file from mir_env.kizu because it is a separate question: mir_env answers what
// a name denotes, this answers what a phi takes on each edge into a header or an exit.
//
// The only divergence from the reference is the one the arena forces: a loop is an id into tables
// that never shrink rather than a *loopContext, so pop_loop marks the row closed instead of
// truncating a slice. control.go does the same thing by other means -- it pops l.loops and then
// goes on reading loop.continueEdges through the pointer lowerWhileStmt still holds.

fn loop_matches_label(space: &mir_env::EnvSpace, index: i64, label: []u8) -> !bool {
    let open = try space.loop_open.get(index);
    if open != 1 {
        return false;
    }
    if std::mem::len(label) == 0 {
        return true;
    }
    let row_label = try space.loop_label.get(index);
    return std::mem::equal_bytes(row_label, label);
}

// push_loop records where this loop's break and continue jump to. control.go: pushLoop.
pub fn push_loop(
    space: &var mir_env::EnvSpace,
    label: []u8,
    break_to: []u8,
    continue_to: []u8
) -> !i64 {
    let loop_id = space.loop_label.len();
    try space.loop_label.append(label);
    try space.loop_break_to.append(break_to);
    try space.loop_continue_to.append(continue_to);
    try space.loop_open.append(1);
    return loop_id;
}

pub fn pop_loop(space: &var mir_env::EnvSpace, loop_id: i64) -> !void {
    if loop_id < 0 {
        return error("mir env: closing an unknown loop");
    }
    if loop_id >= space.loop_open.len() {
        return error("mir env: closing an unknown loop");
    }
    let open = try space.loop_open.get(loop_id);
    if open != 1 {
        return error("mir env: closing a loop that is not open");
    }
    try space.loop_open.set(loop_id, 0);
    return;
}

// find_loop resolves an unlabeled or labeled branch to the innermost open loop that matches.
// The innermost open loop is the LAST matching row, so this scans forward and keeps the last
// hit; see live_binding for why it does not count down.
// control.go: findLoop.
pub fn find_loop(space: &mir_env::EnvSpace, label: []u8) -> !i64 {
    var found = -1;
    var index = 0;
    let rows = space.loop_open.len();
    while index < rows {
        let matched = try loop_matches_label(space, index, label);
        if matched {
            found = index;
        }
        index = index + 1;
    }
    return found;
}

pub fn loop_break_target(space: &mir_env::EnvSpace, loop_id: i64) -> ![]u8 {
    return space.loop_break_to.get(loop_id);
}

pub fn loop_continue_target(space: &mir_env::EnvSpace, loop_id: i64) -> ![]u8 {
    return space.loop_continue_to.get(loop_id);
}

// record_loop_edge is the half of control.go's lowerLoopBranch that this construction owns: a
// break or continue leaves the block it is in with the environment it has, and both facts have to
// survive until the header and exit phis are closed. Emitting the jump and any deferred cleanups
// stays with the caller. The env is SNAPSHOT here, not referenced: the body goes on rebinding.
pub fn record_loop_edge(
    space: &var mir_env::EnvSpace,
    loop_id: i64,
    is_break: bool,
    block: []u8,
    env: i64
) -> !i64 {
    if loop_id < 0 {
        return error("mir env: loop branch with no enclosing loop");
    }
    if loop_id >= space.loop_open.len() {
        return error("mir env: loop branch with no enclosing loop");
    }
    let snapshot = try mir_env::copy_env(space, env);
    let edge = space.edge_loop.len();
    try space.edge_loop.append(loop_id);
    if is_break {
        try space.edge_break.append(1);
    } else {
        try space.edge_break.append(0);
    }
    try space.edge_block.append(block);
    try space.edge_env.append(snapshot);
    return edge;
}

fn edge_matches(
    space: &mir_env::EnvSpace,
    index: i64,
    loop_id: i64,
    want_break: i64
) -> !bool {
    let owner = try space.edge_loop.get(index);
    if owner != loop_id {
        return false;
    }
    let kind = try space.edge_break.get(index);
    return kind == want_break;
}

// add_edge_incomings gives a phi one incoming per matching break or continue edge that carries
// the name, and reports how many it added. control.go does this inline in both finish functions.
fn add_edge_incomings(
    space: &var mir_env::EnvSpace,
    phi: i64,
    name: []u8,
    loop_id: i64,
    want_break: i64
) -> !i64 {
    var index = 0;
    var added = 0;
    let rows = space.edge_loop.len();
    while index < rows {
        let matched = try edge_matches(space, index, loop_id, want_break);
        if matched {
            let edge_env = try space.edge_env.get(index);
            let carried = try mir_env::has_name(space, edge_env, name);
            if carried {
                let value = try mir_env::value_of(space, edge_env, name);
                let block = try space.edge_block.get(index);
                try mir_env::add_incoming(space, phi, block, &value);
                added = added + 1;
            }
        }
        index = index + 1;
    }
    return added;
}

fn count_edge_incomings(
    space: &mir_env::EnvSpace,
    name: []u8,
    loop_id: i64,
    want_break: i64
) -> !i64 {
    var index = 0;
    var found = 0;
    let rows = space.edge_loop.len();
    while index < rows {
        let matched = try edge_matches(space, index, loop_id, want_break);
        if matched {
            let edge_env = try space.edge_env.get(index);
            let carried = try mir_env::has_name(space, edge_env, name);
            if carried {
                found = found + 1;
            }
        }
        index = index + 1;
    }
    return found;
}

// group_phi_for is the header phi this group opened for a name, or -1. create_loop_phis uses it to
// keep a name given twice to one phi; it is public because a caller that RENDERS the group -- the
// generic while lowering in compiled_mir_lower.kizu, which turns each header phi into a
// MirCarriedScalar -- has to read the same phi back by name.
pub fn group_phi_for(space: &mir_env::EnvSpace, group: i64, name: []u8) -> !i64 {
    var index = 0;
    let rows = space.group_owner.len();
    while index < rows {
        let owner = try space.group_owner.get(index);
        if owner == group {
            let row_name = try space.group_name.get(index);
            if std::mem::equal_bytes(row_name, name) {
                return space.group_phi.get(index);
            }
        }
        index = index + 1;
    }
    return -1;
}

// create_loop_phis opens one header phi per assigned name that is live in the preheader, seeded
// from the preheader's value, and rebinds the name to the phi for the whole of the body.
// control.go: createLoopPhis.
//
// `assigned` is the caller's list of names the body assigns -- control.go computes it with
// assignedNames, an AST walk that belongs to whatever calls this, not to the environment. It is a
// list rather than a set because Kizu has no set; a name given twice opens one phi, which is what
// makes the caller's walk free to be sloppy.
pub fn create_loop_phis(
    space: &var mir_env::EnvSpace,
    header_block: []u8,
    preheader_block: []u8,
    env: i64,
    assigned: &std::array::Array<[]u8>
) -> !i64 {
    let group = space.group_header.len();
    try space.group_header.append(header_block);
    var index = 0;
    let names = assigned.len();
    while index < names {
        let name = try assigned.get(index);
        let live = try mir_env::has_name(space, env, name);
        if live {
            let already = try group_phi_for(space, group, name);
            if already < 0 {
                let value = try mir_env::value_of(space, env, name);
                let phi = try mir_env::add_phi(space, header_block, value.value_type, "loop");
                try mir_env::add_incoming(space, phi, preheader_block, &value);
                let carried = try mir_env::phi_value(space, phi);
                try mir_env::assign(space, env, name, &carried);
                try space.group_owner.append(group);
                try space.group_name.append(name);
                try space.group_phi.append(phi);
            }
        }
        index = index + 1;
    }
    return group;
}

// finish_loop_phis closes the header phis with the body's fallthrough edge and one incoming per
// continue edge, then leaves every carried name denoting its header phi. control.go:
// finishLoopPhis. body_env is -1 when the body ended with a terminator and there is no
// fallthrough, which is control.go's empty bodyEnd.
//
// One divergence: control.go writes `value := bodyEnv[name]` and appends the incoming whether or
// not the name is there, so a name lost on that path becomes a zero Value in the phi. A carried
// name cannot be missing -- create_loop_phis bound it in the same environment the body ran in --
// so its absence is a defect in the caller, and this refuses instead of emitting a nameless edge.
pub fn finish_loop_phis(
    space: &var mir_env::EnvSpace,
    group: i64,
    env: i64,
    body_end_block: []u8,
    body_env: i64,
    loop_id: i64
) -> !void {
    var index = 0;
    let rows = space.group_owner.len();
    while index < rows {
        let owner = try space.group_owner.get(index);
        if owner == group {
            let name = try space.group_name.get(index);
            let phi = try space.group_phi.get(index);
            if body_env >= 0 {
                let carried = try mir_env::has_name(space, body_env, name);
                if !carried {
                    return error("mir env: a loop-carried name is unbound on the latch edge");
                }
                let value = try mir_env::value_of(space, body_env, name);
                try mir_env::add_incoming(space, phi, body_end_block, &value);
            }
            let _added = try add_edge_incomings(space, phi, name, loop_id, 0);
            let carried = try mir_env::phi_value(space, phi);
            try mir_env::assign(space, env, name, &carried);
        }
        index = index + 1;
    }
    return;
}

// finish_loop_exit_phis merges the condition-false exit with the break edges. A name no break
// edge carries leaves the loop as its header phi and needs no exit phi, which is control.go's
// `if len(incoming) == 1 { continue }`; a loop with no break edges at all is that case for every
// name, so the reference's separate early return is not needed here.
// control.go: finishLoopExitPhis.
pub fn finish_loop_exit_phis(
    space: &var mir_env::EnvSpace,
    group: i64,
    exit_block: []u8,
    header_block: []u8,
    loop_id: i64,
    env: i64
) -> !void {
    var index = 0;
    let rows = space.group_owner.len();
    while index < rows {
        let owner = try space.group_owner.get(index);
        if owner == group {
            let name = try space.group_name.get(index);
            let header_phi = try space.group_phi.get(index);
            let breaks = try count_edge_incomings(space, name, loop_id, 1);
            if breaks > 0 {
                let carried = try mir_env::phi_value(space, header_phi);
                let exit_phi = try mir_env::add_phi(
                    space, exit_block, carried.value_type, "exit"
                );
                try mir_env::add_incoming(space, exit_phi, header_block, &carried);
                let _added = try add_edge_incomings(space, exit_phi, name, loop_id, 1);
                let left = try mir_env::phi_value(space, exit_phi);
                try mir_env::assign(space, env, name, &left);
            }
        }
        index = index + 1;
    }
    return;
}
