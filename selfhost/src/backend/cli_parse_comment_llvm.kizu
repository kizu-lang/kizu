pub fn append_globals(out: &var std::string::String) -> !void {
    try append_llvm_constant(
        out,
        "fmt_unsupported_comment",
        "58",
        "error: fmt does not support non-leading line comments yet\0A"
    );
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_parse_leading_comment_prefix_end_function(out);
    try append_parse_has_unsupported_line_comment_function(out);
    return;
}

fn append_parse_leading_comment_prefix_end_function(out: &var std::string::String) -> !void {
    try append_line(
        out,
        "define i64 @kizu_selfhost__parse_leading_comment_prefix_end(%kizu.slice.u8 %source) {"
    );
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %line");
    try append_line(out, "line:");
    try append_line(
        out,
        "  %index = phi i64 [ 0, %entry ], [ %blank_next, %blank_line ], [ %comment_next, %comment_done ]"
    );
    try append_line(
        out,
        "  %seen = phi i1 [ false, %entry ], [ %seen, %blank_line ], [ true, %comment_done ]"
    );
    try append_line(out, "  br label %space_loop");
    try append_line(out, "space_loop:");
    try append_line(
        out,
        "  %cursor = phi i64 [ %index, %line ], [ %space_next, %space_advance ]"
    );
    try append_line(out, "  %cursor_ok = icmp slt i64 %cursor, %source_len");
    try append_line(out, "  br i1 %cursor_ok, label %space_load, label %eof");
    try append_line(out, "space_load:");
    try append_line(out, "  %cursor_ptr = getelementptr i8, ptr %source_ptr, i64 %cursor");
    try append_line(out, "  %byte = load i8, ptr %cursor_ptr");
    try append_line(out, "  %is_space = icmp eq i8 %byte, 32");
    try append_line(out, "  %is_tab = icmp eq i8 %byte, 9");
    try append_line(out, "  %is_horizontal = or i1 %is_space, %is_tab");
    try append_line(
        out,
        "  br i1 %is_horizontal, label %space_advance, label %after_spaces"
    );
    try append_line(out, "space_advance:");
    try append_line(out, "  %space_next = add i64 %cursor, 1");
    try append_line(out, "  br label %space_loop");
    try append_line(out, "after_spaces:");
    try append_line(out, "  %is_lf = icmp eq i8 %byte, 10");
    try append_line(out, "  br i1 %is_lf, label %blank_line, label %maybe_slash");
    try append_line(out, "blank_line:");
    try append_line(out, "  %blank_next = add i64 %cursor, 1");
    try append_line(out, "  br label %line");
    try append_line(out, "maybe_slash:");
    try append_line(out, "  %is_slash = icmp eq i8 %byte, 47");
    try append_line(out, "  br i1 %is_slash, label %maybe_second, label %done");
    try append_line(out, "maybe_second:");
    try append_line(out, "  %second_index = add i64 %cursor, 1");
    try append_line(out, "  %second_ok = icmp slt i64 %second_index, %source_len");
    try append_line(out, "  br i1 %second_ok, label %load_second, label %done");
    try append_line(out, "load_second:");
    try append_line(out, "  %second_ptr = getelementptr i8, ptr %source_ptr, i64 %second_index");
    try append_line(out, "  %second = load i8, ptr %second_ptr");
    try append_line(out, "  %is_second_slash = icmp eq i8 %second, 47");
    try append_line(out, "  br i1 %is_second_slash, label %comment_loop, label %done");
    try append_line(out, "comment_loop:");
    try append_line(
        out,
        "  %comment_index = phi i64 [ %second_index, %load_second ], [ %comment_advance_index, %comment_advance ]"
    );
    try append_line(out, "  %comment_ok = icmp slt i64 %comment_index, %source_len");
    try append_line(
        out,
        "  br i1 %comment_ok, label %comment_load, label %comment_done_eof"
    );
    try append_line(out, "comment_load:");
    try append_line(out, "  %comment_ptr = getelementptr i8, ptr %source_ptr, i64 %comment_index");
    try append_line(out, "  %comment_byte = load i8, ptr %comment_ptr");
    try append_line(out, "  %comment_is_lf = icmp eq i8 %comment_byte, 10");
    try append_line(
        out,
        "  br i1 %comment_is_lf, label %comment_done_lf, label %comment_advance"
    );
    try append_line(out, "comment_advance:");
    try append_line(out, "  %comment_advance_index = add i64 %comment_index, 1");
    try append_line(out, "  br label %comment_loop");
    try append_line(out, "comment_done_lf:");
    try append_line(out, "  %comment_next_lf = add i64 %comment_index, 1");
    try append_line(out, "  br label %comment_done");
    try append_line(out, "comment_done_eof:");
    try append_line(out, "  br label %comment_done");
    try append_line(out, "comment_done:");
    try append_line(
        out,
        "  %comment_next = phi i64 [ %comment_next_lf, %comment_done_lf ], [ %source_len, %comment_done_eof ]"
    );
    try append_line(out, "  br label %line");
    try append_line(out, "eof:");
    try append_line(out, "  br i1 %seen, label %return_len, label %return_zero");
    try append_line(out, "done:");
    try append_line(out, "  br i1 %seen, label %return_index, label %return_zero");
    try append_line(out, "return_len:");
    try append_line(out, "  ret i64 %source_len");
    try append_line(out, "return_index:");
    try append_line(out, "  ret i64 %index");
    try append_line(out, "return_zero:");
    try append_line(out, "  ret i64 0");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_parse_has_unsupported_line_comment_function(out: &var std::string::String) -> !void {
    try append_line(
        out,
        "define i1 @kizu_selfhost__parse_has_unsupported_line_comment(%kizu.slice.u8 %source) {"
    );
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %loop");
    try append_line(out, "loop:");
    try append_line(out, "  %index = phi i64 [ 0, %entry ], [ %next_index, %advance ]");
    try append_line(
        out,
        "  %in_string = phi i1 [ false, %entry ], [ %next_in_string, %advance ]"
    );
    try append_line(out, "  %in_bounds = icmp slt i64 %index, %source_len");
    try append_line(out, "  br i1 %in_bounds, label %load, label %false");
    try append_line(out, "load:");
    try append_line(out, "  %byte_ptr = getelementptr i8, ptr %source_ptr, i64 %index");
    try append_line(out, "  %byte = load i8, ptr %byte_ptr");
    try append_line(out, "  br i1 %in_string, label %string_byte, label %normal_byte");
    try append_line(out, "normal_byte:");
    try append_line(out, "  %is_quote = icmp eq i8 %byte, 34");
    try append_line(out, "  br i1 %is_quote, label %open_string, label %maybe_slash");
    try append_line(out, "open_string:");
    try append_line(out, "  %open_next = add i64 %index, 1");
    try append_line(out, "  br label %advance");
    try append_line(out, "maybe_slash:");
    try append_line(out, "  %is_slash = icmp eq i8 %byte, 47");
    try append_line(out, "  br i1 %is_slash, label %check_second, label %normal_advance");
    try append_line(out, "check_second:");
    try append_line(out, "  %second_index = add i64 %index, 1");
    try append_line(out, "  %second_ok = icmp slt i64 %second_index, %source_len");
    try append_line(out, "  br i1 %second_ok, label %load_second, label %normal_advance");
    try append_line(out, "load_second:");
    try append_line(out, "  %second_ptr = getelementptr i8, ptr %source_ptr, i64 %second_index");
    try append_line(out, "  %second = load i8, ptr %second_ptr");
    try append_line(out, "  %is_second_slash = icmp eq i8 %second, 47");
    try append_line(
        out,
        "  br i1 %is_second_slash, label %comment_prefix_loop, label %normal_advance"
    );
    try append_line(out, "comment_prefix_loop:");
    try append_line(
        out,
        "  %prefix_index = phi i64 [ %index, %load_second ], [ %prefix_previous, %prefix_continue ]"
    );
    try append_line(out, "  %prefix_at_start = icmp eq i64 %prefix_index, 0");
    try append_line(out, "  br i1 %prefix_at_start, label %full_line_comment, label %prefix_load");
    try append_line(out, "prefix_load:");
    try append_line(out, "  %prefix_previous = sub i64 %prefix_index, 1");
    try append_line(out, "  %prefix_ptr = getelementptr i8, ptr %source_ptr, i64 %prefix_previous");
    try append_line(out, "  %prefix_byte = load i8, ptr %prefix_ptr");
    try append_line(out, "  %prefix_lf = icmp eq i8 %prefix_byte, 10");
    try append_line(out, "  %prefix_cr = icmp eq i8 %prefix_byte, 13");
    try append_line(out, "  %prefix_break = or i1 %prefix_lf, %prefix_cr");
    try append_line(out, "  br i1 %prefix_break, label %full_line_comment, label %prefix_space");
    try append_line(out, "prefix_space:");
    try append_line(out, "  %prefix_is_space = icmp eq i8 %prefix_byte, 32");
    try append_line(out, "  %prefix_is_tab = icmp eq i8 %prefix_byte, 9");
    try append_line(out, "  %prefix_horizontal = or i1 %prefix_is_space, %prefix_is_tab");
    try append_line(out, "  br i1 %prefix_horizontal, label %prefix_continue, label %true");
    try append_line(out, "prefix_continue:");
    try append_line(out, "  br label %comment_prefix_loop");
    try append_line(out, "full_line_comment:");
    try append_line(
        out,
        "  %comment_end = call i64 @kizu_selfhost__parse_skip_comment_or_self(%kizu.slice.u8 %source, i64 %index)"
    );
    try append_line(out, "  br label %advance");
    try append_line(out, "normal_advance:");
    try append_line(out, "  %normal_next = add i64 %index, 1");
    try append_line(out, "  br label %advance");
    try append_line(out, "string_byte:");
    try append_line(out, "  %is_escape = icmp eq i8 %byte, 92");
    try append_line(out, "  %escape_next_candidate = add i64 %index, 1");
    try append_line(out, "  %escape_ok = icmp slt i64 %escape_next_candidate, %source_len");
    try append_line(out, "  %do_escape = and i1 %is_escape, %escape_ok");
    try append_line(out, "  br i1 %do_escape, label %escape_advance, label %maybe_close");
    try append_line(out, "escape_advance:");
    try append_line(out, "  %escape_next = add i64 %index, 2");
    try append_line(out, "  br label %advance");
    try append_line(out, "maybe_close:");
    try append_line(out, "  %is_close_quote = icmp eq i8 %byte, 34");
    try append_line(out, "  br i1 %is_close_quote, label %close_string, label %string_advance");
    try append_line(out, "close_string:");
    try append_line(out, "  %close_next = add i64 %index, 1");
    try append_line(out, "  br label %advance");
    try append_line(out, "string_advance:");
    try append_line(out, "  %string_next = add i64 %index, 1");
    try append_line(out, "  br label %advance");
    try append_line(out, "advance:");
    try append_line(
        out,
        "  %next_index = phi i64 [ %open_next, %open_string ], [ %normal_next, %normal_advance ], [ %comment_end, %full_line_comment ], [ %escape_next, %escape_advance ], [ %close_next, %close_string ], [ %string_next, %string_advance ]"
    );
    try append_line(
        out,
        "  %next_in_string = phi i1 [ true, %open_string ], [ false, %normal_advance ], [ false, %full_line_comment ], [ true, %escape_advance ], [ false, %close_string ], [ true, %string_advance ]"
    );
    try append_line(out, "  br label %loop");
    try append_line(out, "true:");
    try append_line(out, "  ret i1 true");
    try append_line(out, "false:");
    try append_line(out, "  ret i1 false");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_llvm_constant(
    out: &var std::string::String,
    name: []u8,
    size: []u8,
    text: []u8
) -> !void {
    try out.append_bytes("@.kizu.cli.");
    try out.append_bytes(name);
    try out.append_bytes(" = private unnamed_addr constant [");
    try out.append_bytes(size);
    try out.append_bytes(" x i8] c");
    try out.append_byte(cast<u8>(34));
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(34));
    try out.append_byte(cast<u8>(10));
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
