pub fn append_globals(out: &var std::string::String) -> !void {
    return;
}

pub fn append_functions(out: &var std::string::String) -> !void {
    try append_parse_leading_comment_prefix_end_function(out);
    return;
}

fn append_parse_leading_comment_prefix_end_function(out: &var std::string::String) -> !void {
    try append_line(
        out,
        "define i64 @kizu_selfhost__parse_leading_comment_prefix_end(%kizu.slice.u8 %source) {"
    );
    try append_line(out, "entry:");
    try append_line(out, "  %source_ptr = extractvalue %kizu.slice.u8 %source, 0");
    try append_line(out, "  %source_len = extractvalue %kizu.slice.u8 %source, 1");
    try append_line(out, "  br label %line");
    try append_line(out, "line:");
    try append_line(
        out,
        "  %index = phi i64 [ 0, %entry ], [ %blank_next, %blank_line ], [ %comment_next, %comment_done ]"
    );
    try append_line(
        out,
        "  %seen = phi i1 [ false, %entry ], [ %seen, %blank_line ], [ true, %comment_done ]"
    );
    try append_line(out, "  br label %space_loop");
    try append_line(out, "space_loop:");
    try append_line(
        out,
        "  %cursor = phi i64 [ %index, %line ], [ %space_next, %space_advance ]"
    );
    try append_line(out, "  %cursor_ok = icmp slt i64 %cursor, %source_len");
    try append_line(out, "  br i1 %cursor_ok, label %space_load, label %eof");
    try append_line(out, "space_load:");
    try append_line(out, "  %cursor_ptr = getelementptr i8, ptr %source_ptr, i64 %cursor");
    try append_line(out, "  %byte = load i8, ptr %cursor_ptr");
    try append_line(out, "  %is_space = icmp eq i8 %byte, 32");
    try append_line(out, "  %is_tab = icmp eq i8 %byte, 9");
    try append_line(out, "  %is_horizontal = or i1 %is_space, %is_tab");
    try append_line(
        out,
        "  br i1 %is_horizontal, label %space_advance, label %after_spaces"
    );
    try append_line(out, "space_advance:");
    try append_line(out, "  %space_next = add i64 %cursor, 1");
    try append_line(out, "  br label %space_loop");
    try append_line(out, "after_spaces:");
    try append_line(out, "  %is_lf = icmp eq i8 %byte, 10");
    try append_line(out, "  br i1 %is_lf, label %blank_line, label %maybe_slash");
    try append_line(out, "blank_line:");
    try append_line(out, "  %blank_next = add i64 %cursor, 1");
    try append_line(out, "  br label %line");
    try append_line(out, "maybe_slash:");
    try append_line(out, "  %is_slash = icmp eq i8 %byte, 47");
    try append_line(out, "  br i1 %is_slash, label %maybe_second, label %done");
    try append_line(out, "maybe_second:");
    try append_line(out, "  %second_index = add i64 %cursor, 1");
    try append_line(out, "  %second_ok = icmp slt i64 %second_index, %source_len");
    try append_line(out, "  br i1 %second_ok, label %load_second, label %done");
    try append_line(out, "load_second:");
    try append_line(out, "  %second_ptr = getelementptr i8, ptr %source_ptr, i64 %second_index");
    try append_line(out, "  %second = load i8, ptr %second_ptr");
    try append_line(out, "  %is_second_slash = icmp eq i8 %second, 47");
    try append_line(out, "  br i1 %is_second_slash, label %comment_loop, label %done");
    try append_line(out, "comment_loop:");
    try append_line(
        out,
        "  %comment_index = phi i64 [ %second_index, %load_second ], [ %comment_advance_index, %comment_advance ]"
    );
    try append_line(out, "  %comment_ok = icmp slt i64 %comment_index, %source_len");
    try append_line(
        out,
        "  br i1 %comment_ok, label %comment_load, label %comment_done_eof"
    );
    try append_line(out, "comment_load:");
    try append_line(out, "  %comment_ptr = getelementptr i8, ptr %source_ptr, i64 %comment_index");
    try append_line(out, "  %comment_byte = load i8, ptr %comment_ptr");
    try append_line(out, "  %comment_is_lf = icmp eq i8 %comment_byte, 10");
    try append_line(
        out,
        "  br i1 %comment_is_lf, label %comment_done_lf, label %comment_advance"
    );
    try append_line(out, "comment_advance:");
    try append_line(out, "  %comment_advance_index = add i64 %comment_index, 1");
    try append_line(out, "  br label %comment_loop");
    try append_line(out, "comment_done_lf:");
    try append_line(out, "  %comment_next_lf = add i64 %comment_index, 1");
    try append_line(out, "  br label %comment_done");
    try append_line(out, "comment_done_eof:");
    try append_line(out, "  br label %comment_done");
    try append_line(out, "comment_done:");
    try append_line(
        out,
        "  %comment_next = phi i64 [ %comment_next_lf, %comment_done_lf ], [ %source_len, %comment_done_eof ]"
    );
    try append_line(out, "  br label %line");
    try append_line(out, "eof:");
    try append_line(out, "  br i1 %seen, label %return_len, label %return_zero");
    try append_line(out, "done:");
    try append_line(out, "  br i1 %seen, label %return_index, label %return_zero");
    try append_line(out, "return_len:");
    try append_line(out, "  ret i64 %source_len");
    try append_line(out, "return_index:");
    try append_line(out, "  ret i64 %index");
    try append_line(out, "return_zero:");
    try append_line(out, "  ret i64 0");
    try append_line(out, "}");
    try append_line(out, "");
    return;
}

fn append_line(out: &var std::string::String, text: []u8) -> !void {
    try out.append_bytes(text);
    try out.append_byte(cast<u8>(10));
    return;
}
