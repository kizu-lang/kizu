// Module: component tests for the self-host compiler pipeline boundary.

import selfhost::compiler;

// compiler_component_test checks the self-host compile pipeline summary.
pub fn compiler_component_test() -> !void {
    let report = try compiler::compile_source(
        "fn main() -> void { return void; }",
        "llvm"
    );

    try std::testing::expect(report.status == compiler::CompileStatus::Pass);
    try std::testing::expect(report.backend_emitted);
    try std::testing::expect_equal_i64(1, report.function_count);
    try std::testing::expect_equal_i64(1, report.ir_function_count);
    try std::testing::expect(report.token_count > 0);
    try std::testing::expect_equal_bytes("", report.diagnostic);
    return void;
}
