// Module: component tests for the self-host compiler pipeline boundary.

import selfhost::compiler;
import selfhost::token;

// compiler_component_test checks the self-host compile pipeline summary.
pub fn compiler_component_test() -> !void {
    let frontend = try compiler::lex_and_parse_source(
        "import selfhost::lexer; fn main() -> void { return void; }"
    );
    let report = try compiler::compile_source(
        "fn main() -> void { return void; }",
        "llvm"
    );
    let check = try compiler::check_source("fn main() -> void { return void; }");
    let build = try compiler::build_source(
        "fn main() -> void { return void; }",
        "aarch64-apple-darwin"
    );
    let package = try compiler::compile_selfhost_package_check();
    let io = std::io::blocking();
    let file_package = try compiler::compile_selfhost_package_from_files(io);

    try std::testing::expect(frontend.first_kind == token::TokenKind::Import);
    try std::testing::expect(frontend.eof_kind == token::TokenKind::Eof);
    try std::testing::expect_equal_i64(1, frontend.import_count);
    try std::testing::expect_equal_i64(1, frontend.function_count);
    try std::testing::expect_equal_i64(1, frontend.return_count);
    try std::testing::expect(report.status == compiler::CompileStatus::Pass);
    try std::testing::expect(report.backend_emitted);
    try std::testing::expect(check.status == compiler::CompileStatus::Pass);
    try std::testing::expect_equal_bytes("check", check.command);
    try std::testing::expect_equal_bytes("llvm", check.target);
    try std::testing::expect(build.status == compiler::CompileStatus::Pass);
    try std::testing::expect_equal_bytes("build", build.command);
    try std::testing::expect_equal_bytes("aarch64-apple-darwin", build.target);
    try std::testing::expect(build.backend_emitted);
    try std::testing::expect_equal_i64(1, report.function_count);
    try std::testing::expect_equal_i64(1, report.ir_function_count);
    try std::testing::expect(report.token_count > 0);
    try std::testing::expect_equal_bytes("", report.diagnostic);
    try std::testing::expect(package.status == compiler::CompileStatus::Pass);
    try std::testing::expect(package.root_found);
    try std::testing::expect(package.backend_emitted);
    try std::testing::expect_equal_i64(13, package.module_count);
    try std::testing::expect_equal_i64(13, package.compiled_module_count);
    try std::testing::expect(package.function_count > report.function_count);
    try std::testing::expect(package.import_count > 0);
    try std::testing::expect_equal_bytes("", package.diagnostic);
    try expect_file_package(file_package, package);
    return void;
}

// expect_file_package checks real filesystem-backed selfhost compilation facts.
fn expect_file_package(
    file_package: compiler::PackageReport,
    package: compiler::PackageReport
) -> !void {
    try std::testing::expect(file_package.status == compiler::CompileStatus::Pass);
    try std::testing::expect(file_package.root_found);
    try std::testing::expect(file_package.backend_emitted);
    try std::testing::expect_equal_i64(13, file_package.module_count);
    try std::testing::expect_equal_i64(13, file_package.compiled_module_count);
    try std::testing::expect(file_package.function_count >= package.function_count);
    try std::testing::expect(file_package.token_count >= package.token_count);
    try std::testing::expect_equal_i64(package.ir_function_count, file_package.ir_function_count);
    try std::testing::expect_equal_bytes("", file_package.diagnostic);
    return void;
}
