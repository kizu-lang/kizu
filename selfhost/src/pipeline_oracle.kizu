import selfhost::backend;
import selfhost::ir;
import selfhost::ownership;
import selfhost::resolver;
import selfhost::source;
import selfhost::types;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var files = try source::load_selfhost_sources(allocator, io, "selfhost");
    let resolved = try resolver::resolve_sources(allocator, files);
    let resolved_modules = resolved.modules;
    let resolved_symbols = resolved.symbols;
    let resolved_diagnostics = resolved.diagnostics;
    let typed = try types::check_sources(allocator, files, resolved);
    let typed_modules = typed.modules;
    let typed_symbols = typed.symbols;
    let typed_functions = typed.functions;
    let typed_nodes = typed.typed_nodes;
    let typed_diagnostics = typed.diagnostics;
    let checked = try ownership::check_package(allocator, files, typed);
    let checked_diagnostics = checked.diagnostics;
    let checked_source_id = checked.module.source_id;
    let owned = ownership::summary_of(checked);
    let owned_resources = owned.resources;
    let owned_nodes = owned.checked_nodes;
    let owned_borrows = owned.borrows;
    let owned_errors = owned.errors;
    let lowered = ir::lower(checked);
    let lowered_blocks = lowered.blocks;
    let lowered_entries = lowered.entry_points;
    let artifact = try ir::emit_checked_artifacts(allocator, io, checked);
    let artifact_ir_path = artifact.ir_path;
    let artifact_manifest_path = artifact.manifest_path;
    let artifact_bytes = artifact.bytes;
    let artifact_manifest_bytes = artifact.manifest_bytes;
    let built = try backend::consume_ir_artifact(io, artifact.ir_path);
    let built_artifacts = built.artifacts;
    let llvm = try backend::emit_llvm_artifact(
        allocator,
        io,
        artifact.ir_path,
        artifact.manifest_path
    );
    std::testing::expect(resolved_modules > 0);
    std::testing::expect(resolved_symbols > 0);
    std::testing::expect(0 == resolved_diagnostics);
    std::testing::expect(typed_modules > 0);
    std::testing::expect(typed_symbols > 0);
    std::testing::expect(typed_functions > 0);
    std::testing::expect(typed_nodes > 0);
    std::testing::expect(0 == typed_diagnostics);
    std::testing::expect(0 == checked_diagnostics);
    std::testing::expect(checked_source_id > 0);
    std::testing::expect(owned_resources > 0);
    std::testing::expect(owned_nodes > 0);
    std::testing::expect(owned_borrows > 0);
    std::testing::expect(0 == owned_errors);
    std::testing::expect(lowered_blocks > 0);
    std::testing::expect(1 == lowered_entries);
    std::testing::expect(artifact_bytes > 0);
    std::testing::expect(artifact_manifest_bytes > 0);
    std::testing::expect(built_artifacts > 0);
    std::testing::expect(llvm.bytes > 0);
    std::testing::expect(llvm.metadata_bytes > 0);
    std::testing::expect(llvm.storage_bytes > 0);
    std::testing::expect(llvm.storage_metadata_bytes > 0);
    std::testing::expect(llvm.host_bytes > 0);
    std::testing::expect(llvm.host_metadata_bytes > 0);
    print("resolver-modules");
    print(resolved_modules);
    print("resolver-production-symbols");
    print(resolved_symbols);
    print("resolver-production-diagnostics");
    print(resolved_diagnostics);
    print("type-modules");
    print(typed_modules);
    print("type-production-symbols");
    print(typed_symbols);
    print("type-production-functions");
    print(typed_functions);
    print("type-production-typed-nodes");
    print(typed_nodes);
    print("type-production-diagnostics");
    print(typed_diagnostics);
    print("ownership-production-resources");
    print(owned_resources);
    print("ownership-production-checked-nodes");
    print(owned_nodes);
    print("ownership-production-borrows");
    print(owned_borrows);
    print("ownership-production-errors");
    print(owned_errors);
    print("ir-handoff-blocks");
    print(lowered_blocks);
    print("ir-handoff-entry-points");
    print(lowered_entries);
    print("ir-handoff-diagnostics");
    print(0);
    print("ir-artifact-path");
    print(artifact_ir_path);
    print("ir-manifest-path");
    print(artifact_manifest_path);
    print("ir-artifact-bytes");
    print(artifact_bytes);
    print("ir-manifest-bytes");
    print(artifact_manifest_bytes);
    print("backend-artifact-bytes");
    print(built_artifacts);
    print("llvm-artifact-path");
    print(llvm.ll_path);
    print("llvm-metadata-path");
    print(llvm.metadata_path);
    print("runtime-storage-path");
    print(llvm.storage_path);
    print("runtime-storage-metadata-path");
    print(llvm.storage_metadata_path);
    print("host-capability-path");
    print(llvm.host_path);
    print("host-capability-metadata-path");
    print(llvm.host_metadata_path);
    print("llvm-artifact-bytes");
    print(llvm.bytes);
    print("llvm-metadata-bytes");
    print(llvm.metadata_bytes);
    print("runtime-storage-bytes");
    print(llvm.storage_bytes);
    print("runtime-storage-metadata-bytes");
    print(llvm.storage_metadata_bytes);
    print("host-capability-bytes");
    print(llvm.host_bytes);
    print("host-capability-metadata-bytes");
    print(llvm.host_metadata_bytes);
    files.deinit();
    return;
}
