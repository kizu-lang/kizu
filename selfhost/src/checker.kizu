pub fn check_entry(parsed: i64) -> bool {
    return parsed >= 100;
}

pub fn known_type(name: []const u8) -> bool {
    if name == "Allocator" {
        return true;
    }
    if name == "Function" {
        return true;
    }
    if name == "Io" {
        return true;
    }
    if name == "LocalBuffer" {
        return true;
    }
    if name == "Partition" {
        return true;
    }
    if name == "Queue" {
        return true;
    }
    if name == "TaskGroup" {
        return true;
    }
    if name == "[]const u8" {
        return true;
    }
    if name == "bool" {
        return true;
    }
    if name == "f32" {
        return true;
    }
    if name == "f64" {
        return true;
    }
    if name == "i16" {
        return true;
    }
    if name == "i32" {
        return true;
    }
    if name == "i64" {
        return true;
    }
    if name == "i8" {
        return true;
    }
    if name == "isize" {
        return true;
    }
    if name == "std::fs::Metadata" {
        return true;
    }
    if name == "std::string::String" {
        return true;
    }
    if name == "u16" {
        return true;
    }
    if name == "u32" {
        return true;
    }
    if name == "u64" {
        return true;
    }
    if name == "u8" {
        return true;
    }
    if name == "usize" {
        return true;
    }
    if name == "void" {
        return true;
    }
    return false;
}

