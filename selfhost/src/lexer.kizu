pub struct LexerSummary {
    pub tokens: i64,
    pub bytes: i64,
    pub lines: i64,
    pub diagnostics: i64,
}

pub fn summarize(source: []u8) -> LexerSummary {
    var current = std::kizu::lexer::first_token(source);
    var count = 1;
    var diagnostics = 0;
    if is_invalid_token(source, current) {
        diagnostics = diagnostics + 1;
    }
    while !is_eof(current) {
        current = std::kizu::lexer::next_token(source, current);
        count = count + 1;
        if is_invalid_token(source, current) {
            diagnostics = diagnostics + 1;
        }
    }
    return LexerSummary {
        tokens: count,
        bytes: std::mem::len(source),
        lines: current.line,
        diagnostics: diagnostics
    };
}

pub fn tokenize(
    allocator: Allocator,
    source: []u8
) -> !std::array::Array<std::kizu::lexer::Token> {
    return std::kizu::lexer::tokenize(allocator, source);
}

pub fn invalid_token(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    let primary = std::kizu::diagnostic::file_span(0, path, byte_start, byte_end, 1, 1);
    return std::kizu::diagnostic::Diagnostic(allocator, primary, "invalid token");
}

pub fn is_fn(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Fn => true,
        _ => false,
    };
}

pub fn is_eof(token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Eof => true,
        _ => false,
    };
}

pub fn token_text(source: []u8, token: std::kizu::lexer::Token) -> []u8 {
    return source[token.start..token.end];
}

pub fn is_invalid_token(source: []u8, token: std::kizu::lexer::Token) -> bool {
    return match token.kind {
        Ident => !is_valid_identifier(token_text(source, token)),
        _ => false,
    };
}

pub fn invalid_token_display() -> []u8 {
    return "ILLEGAL";
}

fn is_valid_identifier(text: []u8) -> bool {
    let length = std::mem::len(text);
    if length == 0 {
        return false;
    }
    if !is_identifier_start(text[0]) {
        return false;
    }
    var index = 1;
    while index < length {
        if !is_identifier_continue(text[index]) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn is_identifier_start(byte: u8) -> bool {
    return is_alpha(byte) or byte == cast<u8>(95);
}

fn is_identifier_continue(byte: u8) -> bool {
    return is_identifier_start(byte) or is_digit(byte);
}

fn is_alpha(byte: u8) -> bool {
    return (byte >= cast<u8>(65) and byte <= cast<u8>(90)) or
        (byte >= cast<u8>(97) and byte <= cast<u8>(122));
}

fn is_digit(byte: u8) -> bool {
    return byte >= cast<u8>(48) and byte <= cast<u8>(57);
}
