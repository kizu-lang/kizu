// Module: lexer boundary for the future self-host compiler frontend.

import selfhost::token;

// token_literal returns the Go-compatible literal spelling for one token.
fn token_literal(
    source: []const u8,
    kind: token::TokenKind,
    start: i64,
    end: i64
) -> ![]const u8 {
    if kind == token::TokenKind::Eof {
        return "";
    }
    if kind == token::TokenKind::String {
        return try std::mem::slice(source, start + 1, end - 1);
    }
    return try std::mem::slice(source, start, end);
}

// make_token builds a source-positioned token value.
fn make_token(
    source: []const u8,
    kind: token::TokenKind,
    start: i64,
    end: i64,
    line: i64,
    column: i64
) -> !token::Token {
    return token::Token {
        kind: kind,
        literal: try token_literal(source, kind, start, end),
        start: start,
        end: end,
        line: line,
        column: column,
    };
}

// advance_line returns the line after consuming a source range.
fn advance_line(source: []const u8, start: i64, end: i64, line: i64) -> !i64 {
    var next = line;
    var index = start;

    while index < end {
        let byte = try std::mem::byte_at(source, index);
        if byte == cast<u8>(10) {
            next = next + 1;
        }
        index = index + 1;
    }
    return next;
}

// advance_column returns the column after consuming a source range.
fn advance_column(source: []const u8, start: i64, end: i64, column: i64) -> !i64 {
    var next = column;
    var index = start;

    while index < end {
        let byte = try std::mem::byte_at(source, index);
        if byte == cast<u8>(10) {
            next = 1;
        } else {
            next = next + 1;
        }
        index = index + 1;
    }
    return next;
}

// is_ascii_space reports whether a byte is insignificant whitespace.
fn is_ascii_space(byte: u8) -> bool {
    if byte == cast<u8>(32) {
        return true;
    }
    if byte == cast<u8>(10) {
        return true;
    }
    if byte == cast<u8>(9) {
        return true;
    }
    return byte == cast<u8>(13);
}

// is_ascii_digit reports whether a byte is an ASCII decimal digit.
fn is_ascii_digit(byte: u8) -> bool {
    if byte >= cast<u8>(48) {
        return byte <= cast<u8>(57);
    }
    return false;
}

// is_ascii_alpha reports whether a byte is an ASCII letter.
fn is_ascii_alpha(byte: u8) -> bool {
    if byte >= cast<u8>(65) {
        if byte <= cast<u8>(90) {
            return true;
        }
    }
    if byte >= cast<u8>(97) {
        return byte <= cast<u8>(122);
    }
    return false;
}

// is_ident_start reports whether a byte can start an identifier.
fn is_ident_start(byte: u8) -> bool {
    if is_ascii_alpha(byte) {
        return true;
    }
    return byte == cast<u8>(95);
}

// is_ident_continue reports whether a byte can continue an identifier.
fn is_ident_continue(byte: u8) -> bool {
    if is_ident_start(byte) {
        return true;
    }
    return is_ascii_digit(byte);
}

// keyword_control_kind classifies control-flow and binding keywords.
fn keyword_control_kind(text: []const u8) -> token::TokenKind {
    if std::mem::equal_bytes(text, "fn") {
        return token::TokenKind::Fn;
    }
    if std::mem::equal_bytes(text, "import") {
        return token::TokenKind::Import;
    }
    if std::mem::equal_bytes(text, "pub") {
        return token::TokenKind::Public;
    }
    if std::mem::equal_bytes(text, "let") {
        return token::TokenKind::Let;
    }
    if std::mem::equal_bytes(text, "var") {
        return token::TokenKind::Var;
    }
    if std::mem::equal_bytes(text, "return") {
        return token::TokenKind::Return;
    }
    if std::mem::equal_bytes(text, "if") {
        return token::TokenKind::If;
    }
    if std::mem::equal_bytes(text, "else") {
        return token::TokenKind::Else;
    }
    if std::mem::equal_bytes(text, "while") {
        return token::TokenKind::While;
    }
    if std::mem::equal_bytes(text, "break") {
        return token::TokenKind::Break;
    }
    if std::mem::equal_bytes(text, "continue") {
        return token::TokenKind::Continue;
    }
    return token::TokenKind::Ident;
}

// keyword_decl_kind classifies type and implementation keywords.
fn keyword_decl_kind(text: []const u8) -> token::TokenKind {
    if std::mem::equal_bytes(text, "match") {
        return token::TokenKind::Match;
    }
    if std::mem::equal_bytes(text, "struct") {
        return token::TokenKind::Struct;
    }
    if std::mem::equal_bytes(text, "enum") {
        return token::TokenKind::Enum;
    }
    if std::mem::equal_bytes(text, "union") {
        return token::TokenKind::Union;
    }
    if std::mem::equal_bytes(text, "contract") {
        return token::TokenKind::Contract;
    }
    if std::mem::equal_bytes(text, "satisfy") {
        return token::TokenKind::Satisfy;
    }
    if std::mem::equal_bytes(text, "for") {
        return token::TokenKind::For;
    }
    if std::mem::equal_bytes(text, "impl") {
        return token::TokenKind::Impl;
    }
    return token::TokenKind::Ident;
}

// keyword_value_kind classifies literal and modifier keywords.
fn keyword_value_kind(text: []const u8) -> token::TokenKind {
    if std::mem::equal_bytes(text, "true") {
        return token::TokenKind::True;
    }
    if std::mem::equal_bytes(text, "false") {
        return token::TokenKind::False;
    }
    if std::mem::equal_bytes(text, "mut") {
        return token::TokenKind::Mut;
    }
    if std::mem::equal_bytes(text, "unsafe") {
        return token::TokenKind::Unsafe;
    }
    if std::mem::equal_bytes(text, "extern") {
        return token::TokenKind::Extern;
    }
    if std::mem::equal_bytes(text, "comptime") {
        return token::TokenKind::Comptime;
    }
    if std::mem::equal_bytes(text, "try") {
        return token::TokenKind::Try;
    }
    return token::TokenKind::Ident;
}

// keyword_kind classifies identifier text that is reserved by the language.
fn keyword_kind(text: []const u8) -> token::TokenKind {
    let control = keyword_control_kind(text);
    if control != token::TokenKind::Ident {
        return control;
    }
    let decl = keyword_decl_kind(text);
    if decl != token::TokenKind::Ident {
        return decl;
    }
    return keyword_value_kind(text);
}

// single_char_kind classifies one-byte punctuation and operator tokens.
fn single_char_kind(byte: u8) -> token::TokenKind {
    if byte == cast<u8>(61) {
        return token::TokenKind::Assign;
    }
    if byte == cast<u8>(43) {
        return token::TokenKind::Plus;
    }
    if byte == cast<u8>(45) {
        return token::TokenKind::Minus;
    }
    if byte == cast<u8>(33) {
        return token::TokenKind::Bang;
    }
    if byte == cast<u8>(63) {
        return token::TokenKind::Question;
    }
    if byte == cast<u8>(38) {
        return token::TokenKind::Amp;
    }
    if byte == cast<u8>(42) {
        return token::TokenKind::Asterisk;
    }
    if byte == cast<u8>(47) {
        return token::TokenKind::Slash;
    }
    if byte == cast<u8>(37) {
        return token::TokenKind::Percent;
    }
    if byte == cast<u8>(60) {
        return token::TokenKind::LT;
    }
    if byte == cast<u8>(62) {
        return token::TokenKind::GT;
    }
    if byte == cast<u8>(46) {
        return token::TokenKind::Dot;
    }
    if byte == cast<u8>(40) {
        return token::TokenKind::LParen;
    }
    if byte == cast<u8>(41) {
        return token::TokenKind::RParen;
    }
    if byte == cast<u8>(123) {
        return token::TokenKind::LBrace;
    }
    if byte == cast<u8>(125) {
        return token::TokenKind::RBrace;
    }
    if byte == cast<u8>(59) {
        return token::TokenKind::Semicolon;
    }
    if byte == cast<u8>(44) {
        return token::TokenKind::Comma;
    }
    if byte == cast<u8>(58) {
        return token::TokenKind::Colon;
    }
    if byte == cast<u8>(124) {
        return token::TokenKind::Pipe;
    }
    if byte == cast<u8>(91) {
        return token::TokenKind::LBracket;
    }
    if byte == cast<u8>(93) {
        return token::TokenKind::RBracket;
    }
    return token::TokenKind::Illegal;
}

// two_char_kind classifies compound tokens from adjacent bytes.
fn two_char_kind(first: u8, second: u8) -> token::TokenKind {
    if first == cast<u8>(61) {
        if second == cast<u8>(61) {
            return token::TokenKind::Eq;
        }
        if second == cast<u8>(62) {
            return token::TokenKind::FatArrow;
        }
    }
    if first == cast<u8>(33) {
        if second == cast<u8>(61) {
            return token::TokenKind::NotEq;
        }
    }
    if first == cast<u8>(60) {
        if second == cast<u8>(61) {
            return token::TokenKind::LTE;
        }
    }
    if first == cast<u8>(62) {
        if second == cast<u8>(61) {
            return token::TokenKind::GTE;
        }
    }
    if first == cast<u8>(45) {
        if second == cast<u8>(62) {
            return token::TokenKind::Arrow;
        }
    }
    if first == cast<u8>(46) {
        if second == cast<u8>(46) {
            return token::TokenKind::Range;
        }
    }
    if first == cast<u8>(58) {
        if second == cast<u8>(58) {
            return token::TokenKind::DoubleColon;
        }
    }
    return token::TokenKind::Illegal;
}

// has_compound_kind reports whether two bytes make a compound token.
fn has_compound_kind(first: u8, second: u8) -> bool {
    return two_char_kind(first, second) != token::TokenKind::Illegal;
}

// lex_identifier appends one identifier-like token and returns the next index.
fn lex_identifier(
    source: []const u8,
    tokens: &mut std::array::Array<token::Token>,
    start: i64,
    line: i64,
    column: i64
) -> !i64 {
    let length = std::mem::len(source);
    var end = start + 1;
    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if is_ident_continue(byte) {
            end = end + 1;
        } else {
            break;
        }
    }
    let text = try std::mem::slice(source, start, end);
    try tokens.append(try make_token(source, keyword_kind(text), start, end, line, column));
    return end;
}

// lex_number appends one integer token and returns the next index.
fn lex_number(
    source: []const u8,
    tokens: &mut std::array::Array<token::Token>,
    start: i64,
    line: i64,
    column: i64
) -> !i64 {
    let length = std::mem::len(source);
    var end = start + 1;
    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if is_ascii_digit(byte) {
            end = end + 1;
        } else {
            break;
        }
    }
    try tokens.append(try make_token(
        source,
        token::TokenKind::Number,
        start,
        end,
        line,
        column
    ));
    return end;
}

// lex_string appends one string token and returns the next index.
fn lex_string(
    source: []const u8,
    tokens: &mut std::array::Array<token::Token>,
    start: i64,
    line: i64,
    column: i64
) -> !i64 {
    let length = std::mem::len(source);
    var end = start + 1;
    while end < length {
        let byte = try std::mem::byte_at(source, end);
        end = end + 1;
        if byte == cast<u8>(34) {
            try tokens.append(try make_token(
                source,
                token::TokenKind::String,
                start,
                end,
                line,
                column
            ));
            return end;
        }
    }
    try tokens.append(try make_token(
        source,
        token::TokenKind::Illegal,
        start,
        end,
        line,
        column
    ));
    return end;
}

// skip_line_comment returns the index after one line comment.
fn skip_line_comment(source: []const u8, start: i64) -> !i64 {
    let length = std::mem::len(source);
    var end = start + 2;
    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if byte == cast<u8>(10) {
            return end + 1;
        }
        end = end + 1;
    }
    return end;
}

// lex_symbol appends one symbol token or skips one comment.
fn lex_symbol(
    source: []const u8,
    tokens: &mut std::array::Array<token::Token>,
    start: i64,
    line: i64,
    column: i64
) -> !i64 {
    let length = std::mem::len(source);
    let first = try std::mem::byte_at(source, start);
    if start + 1 < length {
        let second = try std::mem::byte_at(source, start + 1);
        if first == cast<u8>(47) {
            if second == cast<u8>(47) {
                return try skip_line_comment(source, start);
            }
        }
        if has_compound_kind(first, second) {
            let kind = two_char_kind(first, second);
            try tokens.append(try make_token(source, kind, start, start + 2, line, column));
            return start + 2;
        }
    }
    try tokens.append(try make_token(
        source,
        single_char_kind(first),
        start,
        start + 1,
        line,
        column
    ));
    return start + 1;
}

// lex returns an owned token stream for the given source buffer.
pub fn lex(source: []const u8) -> !std::array::Array<token::Token> {
    let allocator = std::mem::page_allocator();
    var tokens = std::array::Array<token::Token>(allocator);
    let length = std::mem::len(source);
    var index = 0;
    var line = 1;
    var column = 1;

    while index < length {
        let start = index;
        let start_line = line;
        let start_column = column;
        let byte = try std::mem::byte_at(source, index);
        if is_ascii_space(byte) {
            index = index + 1;
        } else {
            if is_ident_start(byte) {
                index = try lex_identifier(source, tokens, index, start_line, start_column);
            } else {
                if is_ascii_digit(byte) {
                    index = try lex_number(source, tokens, index, start_line, start_column);
                } else {
                    if byte == cast<u8>(34) {
                        index = try lex_string(source, tokens, index, start_line, start_column);
                    } else {
                        index = try lex_symbol(source, tokens, index, start_line, start_column);
                    }
                }
            }
        }
        column = try advance_column(source, start, index, column);
        line = try advance_line(source, start, index, line);
    }

    try tokens.append(try make_token(
        source,
        token::TokenKind::Eof,
        length,
        length,
        line,
        column
    ));
    return tokens;
}

// eof_token builds the terminal token for a source buffer.
pub fn eof_token(source: []const u8) -> token::Token {
    let source_len = std::mem::len(source);
    return token::Token {
        kind: token::TokenKind::Eof,
        literal: "",
        start: source_len,
        end: source_len,
        line: 1,
        column: source_len + 1,
    };
}

// source_len exposes the byte-count dependency used by the lexer scanner.
pub fn source_len(source: []const u8) -> i64 {
    return std::mem::len(source);
}

// ready exposes the lexer module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
