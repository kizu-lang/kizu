// Module: lexer boundary for the future self-host compiler frontend.

import selfhost::token;

// lex returns an owned token stream for the given source buffer.
pub fn lex(source: []const u8) -> !std::array::Array<token::Token> {
    let allocator = std::mem::page_allocator();
    let tokens = std::array::Array<token::Token>(allocator);
    let source_len = std::mem::len(source);
    if source_len < 0 {
        return error("invalid source length");
    }
    return tokens;
}

// source_len exposes the byte-count dependency used by the lexer scanner.
pub fn source_len(source: []const u8) -> i64 {
    return std::mem::len(source);
}

// ready exposes the lexer module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
