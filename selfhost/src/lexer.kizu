import selfhost::token;

pub struct LexerSummary {
    pub tokens: i64;
}

pub fn summarize(source: []const u8) -> LexerSummary {
    let eof = token::eof();
    let base = token::span_len(eof);
    if std::mem::len(source) == 0 {
        return LexerSummary {
            tokens: base + 1
        };
    }
    return LexerSummary {
        tokens: base + 2
    };
}
