import selfhost::ownership;
import selfhost::ownership::data;
import selfhost::ownership::diagnostic;
import selfhost::ownership::state;
import selfhost::resolver;
import selfhost::source;
import selfhost::types;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();
    let io = std::io::blocking();
    var states = std::map::Map<[]u8, data::OwnershipState>(allocator);
    var kinds = std::map::Map<[]u8, data::ResourceKind>(allocator);
    var files = try source::load_selfhost_sources(allocator, io, "selfhost");

    try state::declare_resource(states, kinds, "value", data::ResourceKind::Value);
    try state::declare_resource(states, kinds, "tokens", data::ResourceKind::Array);
    try state::declare_resource(states, kinds, "symbols", data::ResourceKind::Map);
    try state::declare_resource(states, kinds, "buffer", data::ResourceKind::String);
    try state::declare_resource(states, kinds, "arena", data::ResourceKind::Arena);
    try state::declare_resource(states, kinds, "node", data::ResourceKind::Handle);
    try state::declare_resource(
        states,
        kinds,
        "slice",
        data::ResourceKind::BorrowedView
    );

    try state::shared_borrow(states, "tokens");
    try state::release_borrow(states, "tokens");
    try state::mut_borrow(states, "symbols");
    try state::release_borrow(states, "symbols");
    try state::move_value(states, "node");
    try state::deinit_resource(states, "buffer");
    try state::deinit_resource(states, "arena");

    try expect_resources(states, kinds);
    try expect_diagnostics(allocator);

    let summary = state::summarize(states, 2, 4);
    let resolved = try resolver::resolve_sources(allocator, files);
    let typed = try types::check_sources(allocator, files, resolved);
    let checked = try ownership::check_package(allocator, files, typed);
    let production = ownership::summary_of(checked);
    std::testing::expect_equal<i64>(7, summary.resources);
    std::testing::expect_equal<i64>(7, summary.checked_nodes);
    std::testing::expect_equal<i64>(2, summary.borrows);
    std::testing::expect_equal<i64>(4, summary.errors);
    std::testing::expect_equal<i64>(0, checked.diagnostics);
    std::testing::expect(checked.module.source_id > 0);
    std::testing::expect(production.resources > 0);
    std::testing::expect(production.checked_nodes > 0);
    std::testing::expect(production.borrows > 0);
    std::testing::expect_equal<i64>(0, production.errors);

    files.deinit();
    states.deinit();
    kinds.deinit();

    print("ownership-production-resources");
    print(production.resources);
    print("ownership-production-checked-nodes");
    print(production.checked_nodes);
    print("ownership-production-borrows");
    print(production.borrows);
    print("ownership-production-errors");
    print(production.errors);
    print("ownership-resources");
    print(summary.resources);
    print("ownership-borrows");
    print(summary.borrows);
    print("ownership-errors");
    print(summary.errors);
    return;
}

fn expect_resources(
    states: &std::map::Map<[]u8, data::OwnershipState>,
    kinds: &std::map::Map<[]u8, data::ResourceKind>
) -> !void {
    let tokens = try state::kind_of(kinds, "tokens");
    std::testing::expect(tokens == data::ResourceKind::Array);
    let symbols = try state::kind_of(kinds, "symbols");
    std::testing::expect(symbols == data::ResourceKind::Map);
    let buffer = try state::kind_of(kinds, "buffer");
    std::testing::expect(buffer == data::ResourceKind::String);
    let arena = try state::kind_of(kinds, "arena");
    std::testing::expect(arena == data::ResourceKind::Arena);
    let node_kind = try state::kind_of(kinds, "node");
    std::testing::expect(node_kind == data::ResourceKind::Handle);
    let slice = try state::kind_of(kinds, "slice");
    std::testing::expect(slice == data::ResourceKind::BorrowedView);

    let tokens_state = try state::state_of(states, "tokens");
    std::testing::expect(tokens_state == data::OwnershipState::Available);
    let symbols_state = try state::state_of(states, "symbols");
    std::testing::expect(symbols_state == data::OwnershipState::Available);
    let node = try state::state_of(states, "node");
    std::testing::expect(node == data::OwnershipState::Moved);
    let buffer_state = try state::state_of(states, "buffer");
    std::testing::expect(buffer_state == data::OwnershipState::Deinitialized);
    let arena_state = try state::state_of(states, "arena");
    std::testing::expect(arena_state == data::OwnershipState::Deinitialized);
    return;
}

fn expect_diagnostics(allocator: Allocator) -> !void {
    var moved = diagnostic::use_after_move(allocator, "selfhost/src/ownership.kizu", 5, 9);
    try expect_diagnostic(moved, "use after move", 5, 9);

    var alias = diagnostic::mutable_alias(allocator, "selfhost/src/ownership.kizu", 11, 18);
    try expect_diagnostic(alias, "mutable alias", 11, 18);

    var dangling = diagnostic::dangling_borrow(allocator, "selfhost/src/ownership.kizu", 20, 29);
    try expect_diagnostic(dangling, "dangling borrow", 20, 29);

    var deinit = diagnostic::deinit_while_borrowed(
        allocator,
        "selfhost/src/ownership.kizu",
        31,
        43
    );
    try expect_diagnostic(deinit, "deinit while borrowed", 31, 43);
    return;
}

fn expect_diagnostic(
    diagnostic: std::kizu::diagnostic::Diagnostic,
    message: []u8,
    byte_start: i64,
    byte_end: i64
) -> !void {
    std::testing::expect_equal<[]u8>(message, diagnostic.message);
    std::testing::expect_equal<i64>(byte_start, diagnostic.primary.byte_start);
    std::testing::expect_equal<i64>(byte_end, diagnostic.primary.byte_end);
    diagnostic.deinit();
    return;
}
