// Module: component tests for self-host cache contract boundaries.

import selfhost::cache_contract;

// cache_component_test checks deterministic rebuild reason facts.
pub fn cache_component_test() -> !void {
    let previous = cache_contract::input(
        "0.3", "native", "llvm", "debug", "file", "m1", "g1", "aaa", "p1", "std1"
    );
    let same = cache_contract::input(
        "0.3", "native", "llvm", "debug", "file", "m1", "g1", "aaa", "p1", "std1"
    );
    let changed_source = cache_contract::input(
        "0.3", "native", "llvm", "debug", "file", "m1", "g1", "bbb", "p1", "std1"
    );
    let previous_package = cache_contract::input(
        "0.3", "native", "llvm", "debug", "package", "m1", "g1", "aaa", "p1", "std1"
    );
    let changed_private = cache_contract::input(
        "0.3", "native", "llvm", "debug", "package", "m1", "g1", "bbb", "p1", "std1"
    );
    let changed_manifest = cache_contract::input(
        "0.3", "native", "llvm", "debug", "file", "m2", "g1", "aaa", "p1", "std1"
    );
    let changed_graph = cache_contract::input(
        "0.3", "native", "llvm", "debug", "file", "m1", "g2", "aaa", "p1", "std1"
    );
    let changed_std = cache_contract::input(
        "0.3", "native", "llvm", "debug", "file", "m1", "g1", "aaa", "p1", "std2"
    );
    let no_op = cache_contract::rebuild_reason(&previous, &same);
    let source = cache_contract::rebuild_reason(&previous, &changed_source);
    let private = cache_contract::rebuild_reason(&previous_package, &changed_private);
    let manifest = cache_contract::rebuild_reason(&previous, &changed_manifest);
    let graph = cache_contract::rebuild_reason(&previous, &changed_graph);
    let std = cache_contract::rebuild_reason(&previous, &changed_std);

    try std::testing::expect(no_op.must_rebuild == false);
    try std::testing::expect(no_op.reason == cache_contract::RebuildReason::None);
    try std::testing::expect(source.must_rebuild);
    try std::testing::expect(source.reason == cache_contract::RebuildReason::SourceChanged);
    try std::testing::expect(private.reason == cache_contract::RebuildReason::SourceOnlyChanged);
    try std::testing::expect(manifest.reason == cache_contract::RebuildReason::ManifestChanged);
    try std::testing::expect(graph.reason == cache_contract::RebuildReason::ModuleGraphChanged);
    try std::testing::expect(std.must_rebuild);
    try std::testing::expect(std.reason == cache_contract::RebuildReason::StdChanged);
    try std::testing::expect_equal_bytes("cache hit", cache_contract::reason_name(no_op.reason));
    return void;
}
