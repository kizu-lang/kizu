// Module: component tests for self-host cache contract boundaries.

import selfhost::cache_contract;

// cache_component_test checks deterministic rebuild reason facts.
pub fn cache_component_test() -> !void {
    let previous = cache_contract::input("0.3", "native", "llvm", "debug", "aaa", "std1");
    let same = cache_contract::input("0.3", "native", "llvm", "debug", "aaa", "std1");
    let changed_source = cache_contract::input("0.3", "native", "llvm", "debug", "bbb", "std1");
    let changed_std = cache_contract::input("0.3", "native", "llvm", "debug", "aaa", "std2");
    let no_op = cache_contract::rebuild_reason(&previous, &same);
    let source = cache_contract::rebuild_reason(&previous, &changed_source);
    let std = cache_contract::rebuild_reason(&previous, &changed_std);

    try std::testing::expect(no_op.must_rebuild == false);
    try std::testing::expect(no_op.reason == cache_contract::RebuildReason::None);
    try std::testing::expect(source.must_rebuild);
    try std::testing::expect(source.reason == cache_contract::RebuildReason::SourceChanged);
    try std::testing::expect(std.must_rebuild);
    try std::testing::expect(std.reason == cache_contract::RebuildReason::StdChanged);
    return void;
}
