import selfhost::checker;

pub struct Module {
    pub score: i64,
    pub functions: i64,
    pub declarations: i64,
    pub braces: i64
}

pub fn lower_entry(checked: checker::CheckedModule) -> Module {
    if checked.valid {
        return Module {
            score: checked.score,
            functions: checked.functions,
            declarations: checked.declarations,
            braces: checked.braces
        };
    }
    return Module {
        score: 0,
        functions: checked.functions,
        declarations: checked.declarations,
        braces: checked.braces
    };
}
