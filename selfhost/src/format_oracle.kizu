import selfhost::parser::format;

pub fn gate() -> !void {
    let allocator = std::mem::page_allocator();

    var expected_main = std::string::String(allocator);
    try expected_main.append_bytes("fn main() {");
    try expected_main.append_byte(cast<u8>(10));
    try expected_main.append_bytes("    print(1);");
    try expected_main.append_byte(cast<u8>(10));
    try expected_main.append_bytes("}");
    let expected_main_bytes = expected_main.as_bytes();
    var formatted_main = try format::format_source(allocator, "fn main(){print(1);}");
    let actual_main = formatted_main.as_bytes();
    std::testing::expect_equal<[]u8>(expected_main_bytes, actual_main);
    formatted_main.deinit();
    expected_main.deinit();

    var expected_point = std::string::String(allocator);
    try expected_point.append_bytes("import std::fmt;");
    try expected_point.append_byte(cast<u8>(10));
    try expected_point.append_byte(cast<u8>(10));
    try expected_point.append_bytes("struct Point {");
    try expected_point.append_byte(cast<u8>(10));
    try expected_point.append_bytes("    x: i64, y: i64");
    try expected_point.append_byte(cast<u8>(10));
    try expected_point.append_bytes("}");
    let expected_point_bytes = expected_point.as_bytes();
    var formatted_point = try format::format_source(
        allocator,
        "import std::fmt; struct Point{x:i64,y:i64,}"
    );
    let actual_point = formatted_point.as_bytes();
    std::testing::expect_equal<[]u8>(expected_point_bytes, actual_point);
    formatted_point.deinit();
    expected_point.deinit();

    var expected_add = std::string::String(allocator);
    try expected_add.append_bytes("fn add(a: i64, b: i64) -> i64 {");
    try expected_add.append_byte(cast<u8>(10));
    try expected_add.append_bytes("    return a + b;");
    try expected_add.append_byte(cast<u8>(10));
    try expected_add.append_bytes("}");
    let expected_add_bytes = expected_add.as_bytes();
    var formatted_add = try format::format_source(
        allocator,
        "fn add(a:i64,b:i64,)->i64{return a+b;}"
    );
    let actual_add = formatted_add.as_bytes();
    std::testing::expect_equal<[]u8>(expected_add_bytes, actual_add);
    formatted_add.deinit();
    expected_add.deinit();

    var expected_pub = std::string::String(allocator);
    try expected_pub.append_bytes("pub fn id(x: i64) -> i64 {");
    try expected_pub.append_byte(cast<u8>(10));
    try expected_pub.append_bytes("    return x;");
    try expected_pub.append_byte(cast<u8>(10));
    try expected_pub.append_bytes("}");
    let expected_pub_bytes = expected_pub.as_bytes();
    var formatted_pub = try format::format_source(
        allocator,
        "pub fn id(x:i64)->i64{return x;}"
    );
    let actual_pub = formatted_pub.as_bytes();
    std::testing::expect_equal<[]u8>(expected_pub_bytes, actual_pub);
    formatted_pub.deinit();
    expected_pub.deinit();

    var expected_comment = std::string::String(allocator);
    try expected_comment.append_bytes("// keep this comment");
    try expected_comment.append_byte(cast<u8>(10));
    try expected_comment.append_bytes("fn main() {");
    try expected_comment.append_byte(cast<u8>(10));
    try expected_comment.append_bytes("    print(1);");
    try expected_comment.append_byte(cast<u8>(10));
    try expected_comment.append_bytes("}");
    let expected_comment_bytes = expected_comment.as_bytes();
    var formatted_comment = try format::format_source(
        allocator,
        "// keep this comment
fn main(){print(1);}"
    );
    let actual_comment = formatted_comment.as_bytes();
    std::testing::expect_equal<[]u8>(expected_comment_bytes, actual_comment);
    formatted_comment.deinit();
    expected_comment.deinit();

    var expected_block_comment = std::string::String(allocator);
    try expected_block_comment.append_bytes("fn main() {");
    try expected_block_comment.append_byte(cast<u8>(10));
    try expected_block_comment.append_bytes("    // keep this comment");
    try expected_block_comment.append_byte(cast<u8>(10));
    try expected_block_comment.append_bytes("    print(1);");
    try expected_block_comment.append_byte(cast<u8>(10));
    try expected_block_comment.append_bytes("}");
    let expected_block_comment_bytes = expected_block_comment.as_bytes();
    var formatted_block_comment = try format::format_source(
        allocator,
        "fn main(){
    // keep this comment
    print(1);
}"
    );
    let actual_block_comment = formatted_block_comment.as_bytes();
    std::testing::expect_equal<[]u8>(
        expected_block_comment_bytes,
        actual_block_comment
    );
    formatted_block_comment.deinit();
    expected_block_comment.deinit();

    var expected_inline_comment = std::string::String(allocator);
    try expected_inline_comment.append_bytes("fn main() {");
    try expected_inline_comment.append_byte(cast<u8>(10));
    try expected_inline_comment.append_bytes("    // keep this comment");
    try expected_inline_comment.append_byte(cast<u8>(10));
    try expected_inline_comment.append_bytes("    print(1);");
    try expected_inline_comment.append_byte(cast<u8>(10));
    try expected_inline_comment.append_bytes("}");
    let expected_inline_comment_bytes = expected_inline_comment.as_bytes();
    var formatted_inline_comment = try format::format_source(
        allocator,
        "fn main() { // keep this comment
    print(1);
}"
    );
    let actual_inline_comment = formatted_inline_comment.as_bytes();
    std::testing::expect_equal<[]u8>(
        expected_inline_comment_bytes,
        actual_inline_comment
    );
    formatted_inline_comment.deinit();
    expected_inline_comment.deinit();

    var expected_enum = std::string::String(allocator);
    try expected_enum.append_bytes("enum Color {");
    try expected_enum.append_byte(cast<u8>(10));
    try expected_enum.append_bytes("    Red, Green,");
    try expected_enum.append_byte(cast<u8>(10));
    try expected_enum.append_bytes("}");
    let expected_enum_bytes = expected_enum.as_bytes();
    var formatted_enum = try format::format_source(
        allocator,
        "enum Color{Red,Green}"
    );
    let actual_enum = formatted_enum.as_bytes();
    std::testing::expect_equal<[]u8>(expected_enum_bytes, actual_enum);
    formatted_enum.deinit();
    expected_enum.deinit();

    var expected_enum_comment = std::string::String(allocator);
    try expected_enum_comment.append_bytes("enum Color {");
    try expected_enum_comment.append_byte(cast<u8>(10));
    try expected_enum_comment.append_bytes("    Red,");
    try expected_enum_comment.append_byte(cast<u8>(10));
    try expected_enum_comment.append_bytes("    // primary");
    try expected_enum_comment.append_byte(cast<u8>(10));
    try expected_enum_comment.append_bytes("}");
    let expected_enum_comment_bytes = expected_enum_comment.as_bytes();
    var formatted_enum_comment = try format::format_source(
        allocator,
        "enum Color{
    Red
    // primary
}"
    );
    let actual_enum_comment = formatted_enum_comment.as_bytes();
    std::testing::expect_equal<[]u8>(
        expected_enum_comment_bytes,
        actual_enum_comment
    );
    formatted_enum_comment.deinit();
    expected_enum_comment.deinit();

    var expected_top_comment_before = std::string::String(allocator);
    try expected_top_comment_before.append_bytes("fn main() {");
    try expected_top_comment_before.append_byte(cast<u8>(10));
    try expected_top_comment_before.append_bytes("    return;");
    try expected_top_comment_before.append_byte(cast<u8>(10));
    try expected_top_comment_before.append_bytes("}");
    try expected_top_comment_before.append_byte(cast<u8>(10));
    try expected_top_comment_before.append_byte(cast<u8>(10));
    try expected_top_comment_before.append_bytes("// color choices");
    try expected_top_comment_before.append_byte(cast<u8>(10));
    try expected_top_comment_before.append_bytes("enum Color {");
    try expected_top_comment_before.append_byte(cast<u8>(10));
    try expected_top_comment_before.append_bytes("    Red,");
    try expected_top_comment_before.append_byte(cast<u8>(10));
    try expected_top_comment_before.append_bytes("}");
    let expected_top_comment_before_bytes = expected_top_comment_before.as_bytes();
    var formatted_top_comment_before = try format::format_source(
        allocator,
        "fn main(){return;}

// color choices
enum Color{Red}"
    );
    let actual_top_comment_before = formatted_top_comment_before.as_bytes();
    std::testing::expect_equal<[]u8>(
        expected_top_comment_before_bytes,
        actual_top_comment_before
    );
    formatted_top_comment_before.deinit();
    expected_top_comment_before.deinit();

    var expected_top_comment_after = std::string::String(allocator);
    try expected_top_comment_after.append_bytes("fn main() {");
    try expected_top_comment_after.append_byte(cast<u8>(10));
    try expected_top_comment_after.append_bytes("    return;");
    try expected_top_comment_after.append_byte(cast<u8>(10));
    try expected_top_comment_after.append_bytes("}");
    try expected_top_comment_after.append_byte(cast<u8>(10));
    try expected_top_comment_after.append_bytes("// color choices");
    try expected_top_comment_after.append_byte(cast<u8>(10));
    try expected_top_comment_after.append_byte(cast<u8>(10));
    try expected_top_comment_after.append_bytes("enum Color {");
    try expected_top_comment_after.append_byte(cast<u8>(10));
    try expected_top_comment_after.append_bytes("    Red,");
    try expected_top_comment_after.append_byte(cast<u8>(10));
    try expected_top_comment_after.append_bytes("}");
    let expected_top_comment_after_bytes = expected_top_comment_after.as_bytes();
    var formatted_top_comment_after = try format::format_source(
        allocator,
        "fn main(){return;}
// color choices

enum Color{Red}"
    );
    let actual_top_comment_after = formatted_top_comment_after.as_bytes();
    std::testing::expect_equal<[]u8>(
        expected_top_comment_after_bytes,
        actual_top_comment_after
    );
    formatted_top_comment_after.deinit();
    expected_top_comment_after.deinit();

    var expected_imports = std::string::String(allocator);
    try expected_imports.append_bytes("import selfhost;");
    try expected_imports.append_byte(cast<u8>(10));
    try expected_imports.append_bytes("import selfhost::lexer;");
    try expected_imports.append_byte(cast<u8>(10));
    try expected_imports.append_bytes("import selfhost::parser;");
    try expected_imports.append_byte(cast<u8>(10));
    try expected_imports.append_byte(cast<u8>(10));
    try expected_imports.append_bytes("fn main() {");
    try expected_imports.append_byte(cast<u8>(10));
    try expected_imports.append_bytes("    return;");
    try expected_imports.append_byte(cast<u8>(10));
    try expected_imports.append_bytes("}");
    let expected_imports_bytes = expected_imports.as_bytes();
    var formatted_imports = try format::format_source(
        allocator,
        "import selfhost::parser;
import selfhost;
import selfhost::lexer;
fn main(){return;}"
    );
    let actual_imports = formatted_imports.as_bytes();
    std::testing::expect_equal<[]u8>(expected_imports_bytes, actual_imports);
    formatted_imports.deinit();
    expected_imports.deinit();

    print("format-cases");
    print(12);
    return;
}
