import selfhost::ast;
import selfhost::parser;
import selfhost::source;

pub enum BindingKind {
    Module,
    Function,
    TypeName,
    Local,
}

pub struct ResolveSummary {
    pub modules: i64,
    pub symbols: i64,
    pub diagnostics: i64,
}

pub struct DuplicateDeclarationSummary {
    pub found: bool,
    pub start: i64,
    pub end: i64,
}

pub fn resolve(tree: ast::AstSummary) -> ResolveSummary {
    return ResolveSummary {
        modules: 1,
        symbols: tree.nodes,
        diagnostics: 0
    };
}

pub fn resolve_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>
) -> !ResolveSummary {
    var symbols = std::map::Map<[]u8, BindingKind>(allocator);
    var visibility = std::map::Map<[]u8, bool>(allocator);
    var modules = 0;
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if source::is_source_code(file.kind) {
            var module = try qualified_module_name(allocator, file);
            let module_key = module.as_bytes();
            try symbols.insert(module_key, BindingKind::Module);
            try visibility.insert(module_key, true);
            module.deinit();
            try resolve_source_declarations(allocator, file, symbols, visibility);
            modules = modules + 1;
        }
        index = index + 1;
    }
    let summary = ResolveSummary {
        modules: modules,
        symbols: symbols.len(),
        diagnostics: 0
    };
    symbols.deinit();
    visibility.deinit();
    return summary;
}

pub fn first_duplicate_declaration(
    allocator: Allocator,
    path: []u8,
    text: []u8
) -> !DuplicateDeclarationSummary {
    let parsed = try parser::parse_checked_file(allocator, path, text);
    let summary = try first_duplicate_declaration_node(allocator, text, parsed.ast, parsed.root);
    parsed.deinit();
    return summary;
}

pub fn declare(
    symbols: &var std::map::Map<[]u8, BindingKind>,
    visibility: &var std::map::Map<[]u8, bool>,
    name: &[]u8,
    kind: BindingKind,
    public: bool
) -> !void {
    if symbols.contains(name) {
        return error("duplicate symbol");
    }
    try symbols.insert(name, kind);
    try visibility.insert(name, public);
    return;
}

pub fn resolve_kind(
    symbols: &std::map::Map<[]u8, BindingKind>,
    name: &[]u8
) -> !BindingKind {
    return symbols.get(name);
}

pub fn is_public(
    visibility: &std::map::Map<[]u8, bool>,
    name: &[]u8
) -> !bool {
    return visibility.get(name);
}

pub fn summarize(
    symbols: &std::map::Map<[]u8, BindingKind>,
    diagnostics: i64
) -> ResolveSummary {
    return ResolveSummary {
        modules: 1,
        symbols: symbols.len(),
        diagnostics: diagnostics
    };
}

pub fn missing_symbol(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "missing symbol");
}

pub fn duplicate_symbol(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    previous_start: i64,
    previous_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    var report = make_diagnostic(allocator, path, byte_start, byte_end, "duplicate symbol");
    let previous = make_span(path, previous_start, previous_end);
    try report.add_related(previous, "previous declaration");
    return report;
}

pub fn private_access(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    declaration_start: i64,
    declaration_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    var report = make_diagnostic(allocator, path, byte_start, byte_end, "private access");
    let declaration = make_span(path, declaration_start, declaration_end);
    try report.add_related(declaration, "private declaration");
    return report;
}

pub fn import_cycle(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    edge_start: i64,
    edge_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    var report = make_diagnostic(allocator, path, byte_start, byte_end, "import cycle");
    let edge = make_span(path, edge_start, edge_end);
    try report.add_related(edge, "cycle edge");
    return report;
}

fn make_diagnostic(
    allocator: Allocator,
    path: []u8,
    byte_start: i64,
    byte_end: i64,
    message: []u8
) -> std::kizu::diagnostic::Diagnostic {
    let primary = make_span(path, byte_start, byte_end);
    return std::kizu::diagnostic::Diagnostic(allocator, primary, message);
}

fn make_span(
    path: []u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::FileSpan {
    return std::kizu::diagnostic::file_span(0, path, byte_start, byte_end, 1, byte_start + 1);
}

fn qualified_module_name(
    allocator: Allocator,
    file: &source::SourceFile
) -> !std::string::String {
    var name = std::string::String(allocator);
    if file.kind == source::SourceKind::Std {
        try name.append_bytes("std::");
    } else {
        try name.append_bytes("selfhost::");
    }
    try source::append_module_path(name, file);
    return name;
}

fn resolve_source_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    symbols: &var std::map::Map<[]u8, BindingKind>,
    visibility: &var std::map::Map<[]u8, bool>
) -> !void {
    let parsed = try parser::parse_checked_file(allocator, file.path, file.text);
    try resolve_ast_root_declarations(allocator, file, parsed.ast, parsed.root, symbols, visibility);
    parsed.deinit();
    return;
}

fn resolve_ast_root_declarations(
    allocator: Allocator,
    file: &source::SourceFile,
    ast_tree: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    symbols: &var std::map::Map<[]u8, BindingKind>,
    visibility: &var std::map::Map<[]u8, bool>
) -> !void {
    let node = ast_tree.get(node_id);
    match node.data {
        Program(program) => try resolve_ast_declaration_range(
            allocator,
            file,
            ast_tree,
            program.declarations,
            symbols,
            visibility
        ),
        _ => return;,
    }
    return;
}

fn first_duplicate_declaration_node(
    allocator: Allocator,
    text: []u8,
    ast_tree: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> !DuplicateDeclarationSummary {
    let node = ast_tree.get(node_id);
    return match node.data {
        Program(program) => try first_duplicate_declaration_range(
            allocator,
            text,
            ast_tree,
            program.declarations
        ),
        _ => duplicate_declaration_summary(false, 0, 0),
    };
}

fn first_duplicate_declaration_range(
    allocator: Allocator,
    text: []u8,
    ast_tree: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange
) -> !DuplicateDeclarationSummary {
    var names = std::map::Map<[]u8, bool>(allocator);
    var result = duplicate_declaration_summary(false, 0, 0);
    var index = 0;
    while index < declarations.len and !result.found {
        let child = try ast_tree.child_at(declarations, index);
        let span = declaration_name_span(ast_tree, child);
        if span.found {
            let name = text[span.start..span.end];
            if names.contains(name) {
                result = span;
            } else {
                try names.insert(name, true);
            }
        }
        index = index + 1;
    }
    names.deinit();
    return result;
}

fn declaration_name_span(
    ast_tree: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> DuplicateDeclarationSummary {
    let node = ast_tree.get(node_id);
    return match node.data {
        FnDecl(fn_decl) => node_name_span(ast_tree, fn_decl.name),
        StructDecl(struct_decl) => node_name_span(ast_tree, struct_decl.name),
        EnumDecl(enum_decl) => node_name_span(ast_tree, enum_decl.name),
        UnionDecl(union_decl) => node_name_span(ast_tree, union_decl.name),
        _ => duplicate_declaration_summary(false, 0, 0),
    };
}

fn node_name_span(
    ast_tree: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> DuplicateDeclarationSummary {
    let node = ast_tree.get(node_id);
    return duplicate_declaration_summary(true, node.span.start, node.span.end);
}

fn duplicate_declaration_summary(found: bool, start: i64, end: i64) -> DuplicateDeclarationSummary {
    return DuplicateDeclarationSummary {
        found: found,
        start: start,
        end: end
    };
}

fn resolve_ast_declaration_range(
    allocator: Allocator,
    file: &source::SourceFile,
    ast_tree: std::kizu::ast::Ast,
    declarations: std::kizu::ast::ChildRange,
    symbols: &var std::map::Map<[]u8, BindingKind>,
    visibility: &var std::map::Map<[]u8, bool>
) -> !void {
    var index = 0;
    while index < declarations.len {
        let child = try ast_tree.child_at(declarations, index);
        try resolve_ast_declaration(allocator, file, ast_tree, child, symbols, visibility);
        index = index + 1;
    }
    return;
}

fn resolve_ast_declaration(
    allocator: Allocator,
    file: &source::SourceFile,
    ast_tree: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId,
    symbols: &var std::map::Map<[]u8, BindingKind>,
    visibility: &var std::map::Map<[]u8, bool>
) -> !void {
    let node = ast_tree.get(node_id);
    match node.data {
        FnDecl(fn_decl) => try declare_ast_symbol(
            allocator,
            file,
            ast_tree,
            fn_decl.name,
            BindingKind::Function,
            fn_decl.public,
            symbols,
            visibility
        ),
        StructDecl(struct_decl) => try declare_ast_symbol(
            allocator,
            file,
            ast_tree,
            struct_decl.name,
            BindingKind::TypeName,
            struct_decl.public,
            symbols,
            visibility
        ),
        EnumDecl(enum_decl) => try declare_ast_symbol(
            allocator,
            file,
            ast_tree,
            enum_decl.name,
            BindingKind::TypeName,
            enum_decl.public,
            symbols,
            visibility
        ),
        UnionDecl(union_decl) => try declare_ast_symbol(
            allocator,
            file,
            ast_tree,
            union_decl.name,
            BindingKind::TypeName,
            union_decl.public,
            symbols,
            visibility
        ),
        _ => return;,
    }
    return;
}

fn declare_ast_symbol(
    allocator: Allocator,
    file: &source::SourceFile,
    ast_tree: std::kizu::ast::Ast,
    name: std::kizu::ast::NodeId,
    kind: BindingKind,
    public: bool,
    symbols: &var std::map::Map<[]u8, BindingKind>,
    visibility: &var std::map::Map<[]u8, bool>
) -> !void {
    var qualified = try qualified_module_name(allocator, file);
    try qualified.append_bytes("::");
    try qualified.append_bytes(ast_node_text(file, ast_tree, name));
    let key = qualified.as_bytes();
    try symbols.insert(key, kind);
    try visibility.insert(key, public);
    qualified.deinit();
    return;
}

fn ast_node_text(
    file: &source::SourceFile,
    ast_tree: std::kizu::ast::Ast,
    node_id: std::kizu::ast::NodeId
) -> []u8 {
    let node = ast_tree.get(node_id);
    let span = &node.span;
    return file.text[span.start..span.end];
}
