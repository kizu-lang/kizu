import selfhost::ast;
import selfhost::diagnostic;

pub struct ResolveSummary {
    pub symbols: i64;
    pub diagnostics: i64;
}

pub fn resolve(tree: ast::AstSummary) -> ResolveSummary {
    return ResolveSummary {
        symbols: tree.nodes,
        diagnostics: 0
    };
}

pub fn missing_symbol(path: []const u8) -> diagnostic::Diagnostic {
    let primary = diagnostic::file_span(path, 0, 1);
    return diagnostic::Diagnostic(primary, "missing symbol");
}
