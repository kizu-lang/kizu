import selfhost::ast;
import selfhost::lexer;
import selfhost::source;

pub enum BindingKind {
    Module,
    Function,
    TypeName,
    Local,
}

pub struct ResolveSummary {
    pub modules: i64,
    pub symbols: i64,
    pub diagnostics: i64,
}

pub fn resolve(tree: ast::AstSummary) -> ResolveSummary {
    return ResolveSummary {
        modules: 1,
        symbols: tree.nodes,
        diagnostics: 0
    };
}

pub fn resolve_sources(
    allocator: Allocator,
    files: &std::array::Array<source::SourceFile>
) -> !ResolveSummary {
    var symbols = std::map::Map<[]const u8, BindingKind>(allocator);
    var visibility = std::map::Map<[]const u8, bool>(allocator);
    var modules = 0;
    var index = 0;
    while index < files.len() {
        let file = try files.at(index);
        if file.kind != source::SourceKind::User {
            var module = try qualified_module_name(allocator, file);
            let module_key = module.as_bytes();
            try symbols.insert(module_key, BindingKind::Module);
            try visibility.insert(module_key, true);
            module.deinit();
            var tokens = try lexer::tokenize(allocator, file.text);
            var token_index = 0;
            var depth = 0;
            var public = false;
            while token_index < tokens.len() {
                let token = try tokens.get(token_index);
                let text = token_text(file.text, token);
                var handled = false;
                if std::mem::equal_bytes(text, "{") {
                    depth = depth + 1;
                    handled = true;
                }
                if !handled and std::mem::equal_bytes(text, "}") {
                    depth = depth - 1;
                    handled = true;
                }
                if !handled and depth == 0 and std::mem::equal_bytes(text, "pub") {
                    public = true;
                    handled = true;
                }
                if !handled and depth == 0 and is_top_level_declaration(text) {
                    if token_index + 1 < tokens.len() {
                        let name = try tokens.get(token_index + 1);
                        let name_text = token_text(file.text, name);
                        if !std::mem::equal_bytes(name_text, "") {
                            var qualified = try qualified_module_name(allocator, file);
                            try qualified.append_bytes("::");
                            try qualified.append_bytes(name_text);
                            let key = qualified.as_bytes();
                            try symbols.insert(key, binding_kind(text));
                            try visibility.insert(key, public);
                            qualified.deinit();
                        }
                    }
                    public = false;
                }
                token_index = token_index + 1;
            }
            tokens.deinit();
            modules = modules + 1;
        }
        index = index + 1;
    }
    let summary = ResolveSummary {
        modules: modules,
        symbols: symbols.len(),
        diagnostics: 0
    };
    symbols.deinit();
    visibility.deinit();
    return summary;
}

pub fn declare(
    symbols: &mut std::map::Map<[]const u8, BindingKind>,
    visibility: &mut std::map::Map<[]const u8, bool>,
    name: &[]const u8,
    kind: BindingKind,
    public: bool
) -> !void {
    if symbols.contains(name) {
        return error("duplicate symbol");
    }
    try symbols.insert(name, kind);
    try visibility.insert(name, public);
    return;
}

pub fn resolve_kind(
    symbols: &std::map::Map<[]const u8, BindingKind>,
    name: &[]const u8
) -> !BindingKind {
    return symbols.get(name);
}

pub fn is_public(
    visibility: &std::map::Map<[]const u8, bool>,
    name: &[]const u8
) -> !bool {
    return visibility.get(name);
}

pub fn summarize(
    symbols: &std::map::Map<[]const u8, BindingKind>,
    diagnostics: i64
) -> ResolveSummary {
    return ResolveSummary {
        modules: 1,
        symbols: symbols.len(),
        diagnostics: diagnostics
    };
}

pub fn missing_symbol(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::Diagnostic {
    return make_diagnostic(allocator, path, byte_start, byte_end, "missing symbol");
}

pub fn duplicate_symbol(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64,
    previous_start: i64,
    previous_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    var report = make_diagnostic(allocator, path, byte_start, byte_end, "duplicate symbol");
    let previous = make_span(path, previous_start, previous_end);
    try report.add_related(previous, "previous declaration");
    return report;
}

pub fn private_access(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64,
    declaration_start: i64,
    declaration_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    var report = make_diagnostic(allocator, path, byte_start, byte_end, "private access");
    let declaration = make_span(path, declaration_start, declaration_end);
    try report.add_related(declaration, "private declaration");
    return report;
}

pub fn import_cycle(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64,
    edge_start: i64,
    edge_end: i64
) -> !std::kizu::diagnostic::Diagnostic {
    var report = make_diagnostic(allocator, path, byte_start, byte_end, "import cycle");
    let edge = make_span(path, edge_start, edge_end);
    try report.add_related(edge, "cycle edge");
    return report;
}

fn make_diagnostic(
    allocator: Allocator,
    path: []const u8,
    byte_start: i64,
    byte_end: i64,
    message: []const u8
) -> std::kizu::diagnostic::Diagnostic {
    let primary = make_span(path, byte_start, byte_end);
    return std::kizu::diagnostic::Diagnostic(allocator, primary, message);
}

fn make_span(
    path: []const u8,
    byte_start: i64,
    byte_end: i64
) -> std::kizu::diagnostic::FileSpan {
    return std::kizu::diagnostic::file_span(0, path, byte_start, byte_end, 1, byte_start + 1);
}

fn qualified_module_name(
    allocator: Allocator,
    file: &source::SourceFile
) -> !std::string::String {
    var name = std::string::String(allocator);
    if file.kind == source::SourceKind::Std {
        try name.append_bytes("std::");
    } else {
        try name.append_bytes("selfhost::");
    }
    try name.append_bytes(file.module);
    return name;
}

fn token_text(
    source_text: []const u8,
    token: std::kizu::lexer::Token
) -> []const u8 {
    return source_text[token.start..token.end];
}

fn is_top_level_declaration(text: []const u8) -> bool {
    return std::mem::equal_bytes(text, "fn") or
        std::mem::equal_bytes(text, "struct") or
        std::mem::equal_bytes(text, "enum") or
        std::mem::equal_bytes(text, "union");
}

fn binding_kind(text: []const u8) -> BindingKind {
    if std::mem::equal_bytes(text, "fn") {
        return BindingKind::Function;
    }
    return BindingKind::TypeName;
}
