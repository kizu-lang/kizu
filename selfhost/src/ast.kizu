pub struct AstSummary {
    pub root: std::kizu::ast::NodeId;
    pub nodes: i64;
    pub tokens: i64;
    pub declarations: i64;
    pub diagnostics: i64;
}

pub fn summarize(
    root: std::kizu::ast::NodeId,
    tokens: i64,
    declarations: i64,
    diagnostics: i64
) -> AstSummary {
    return AstSummary {
        root: root,
        nodes: declarations,
        tokens: tokens,
        declarations: declarations,
        diagnostics: diagnostics
    };
}
