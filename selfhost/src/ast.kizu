// Module: AST node boundary for the future self-host compiler frontend.

pub enum NodeKind {
    Empty
    Import
    Function
    Struct
    Enum
    Union
    Contract
    Impl
    Satisfy
    Block
    Let
    Assign
    Return
    If
    While
    For
    Break
    Continue
    Match
    Unsafe
    ComptimeIf
    ExprStmt
    Ident
    Int
    String
    Bool
    IfExpr
    ComptimeExpr
    Prefix
    Binary
    Call
    TypeApply
    Cast
    Try
    ArenaNew
    StructLiteral
    FieldAccess
    Deref
}

pub struct Node {
    pub kind: NodeKind;
}

pub struct Span {
    pub start: i64;
    pub end: i64;
    pub line: i64;
    pub column: i64;
}

pub struct ImportDecl {
    pub path: []const u8;
    pub span: Span;
}

pub struct Param {
    pub name: []const u8;
    pub type_name: []const u8;
    pub borrow: bool;
    pub mut_borrow: bool;
    pub is_comptime: bool;
}

pub struct FunctionDecl {
    pub name: []const u8;
    pub param_count: i64;
    pub return_type: []const u8;
    pub is_unsafe: bool;
    pub extern_abi: []const u8;
    pub is_public: bool;
    pub span: Span;
}

pub struct Field {
    pub name: []const u8;
    pub type_name: []const u8;
    pub borrow: bool;
    pub mut_borrow: bool;
    pub is_public: bool;
    pub span: Span;
}

pub struct StructDecl {
    pub name: []const u8;
    pub field_count: i64;
    pub is_public: bool;
    pub span: Span;
}

pub struct EnumDecl {
    pub name: []const u8;
    pub tag_count: i64;
    pub is_public: bool;
    pub span: Span;
}

pub struct UnionVariant {
    pub name: []const u8;
    pub payload: []const u8;
}

pub struct UnionDecl {
    pub name: []const u8;
    pub variant_count: i64;
    pub is_public: bool;
    pub span: Span;
}

pub struct ContractDecl {
    pub name: []const u8;
    pub method_count: i64;
    pub is_public: bool;
    pub span: Span;
}

pub struct ImplDecl {
    pub type_name: []const u8;
    pub method_count: i64;
}

pub struct SatisfyDecl {
    pub contract_name: []const u8;
    pub type_name: []const u8;
}

pub struct DeclSnapshot {
    pub kind: NodeKind;
    pub name: []const u8;
    pub span: Span;
}

pub struct BlockStmt {
    pub statement_count: i64;
}

pub struct LetStmt {
    pub mutable: bool;
    pub name: []const u8;
}

pub struct AssignStmt {
    pub has_target: bool;
    pub has_value: bool;
}

pub struct ReturnStmt {
    pub has_value: bool;
    pub span: Span;
}

pub struct IfStmt {
    pub has_alternative: bool;
}

pub struct WhileStmt {
    pub label: []const u8;
}

pub struct ForStmt {
    pub label: []const u8;
    pub name: []const u8;
}

pub struct BreakStmt {
    pub label: []const u8;
}

pub struct ContinueStmt {
    pub label: []const u8;
}

pub struct MatchStmt {
    pub arm_count: i64;
}

pub struct MatchArm {
    pub tag: []const u8;
    pub binding: []const u8;
}

pub struct UnsafeStmt {
    pub statement_count: i64;
}

pub struct ComptimeIfStmt {
    pub has_alternative: bool;
}

pub struct ExprStmt {
    pub has_expression: bool;
}

pub struct IdentExpr {
    pub name: []const u8;
}

pub struct IntExpr {
    pub value: []const u8;
}

pub struct StringExpr {
    pub value: []const u8;
}

pub struct BoolExpr {
    pub value: bool;
}

pub struct IfExpr {
    pub has_alternative: bool;
}

pub struct ComptimeExpr {
    pub has_expression: bool;
}

pub struct PrefixExpr {
    pub operator: []const u8;
}

pub struct BinaryExpr {
    pub operator: []const u8;
}

pub struct CallExpr {
    pub arg_count: i64;
}

pub struct TypeApplyExpr {
    pub type_arg: []const u8;
}

pub struct CastExpr {
    pub target_type: []const u8;
}

pub struct TryExpr {
    pub has_value: bool;
}

pub struct ArenaNewExpr {
    pub type_name: []const u8;
}

pub struct StructLiteralExpr {
    pub type_name: []const u8;
    pub field_count: i64;
    pub span: Span;
}

pub struct FieldValue {
    pub name: []const u8;
    pub span: Span;
}

pub struct FieldExpr {
    pub name: []const u8;
    pub namespace: bool;
    pub span: Span;
}

pub struct DerefExpr {
    pub has_receiver: bool;
}

pub struct ParseSummary {
    pub function_count: i64;
    pub import_count: i64;
    pub struct_count: i64;
    pub enum_count: i64;
    pub union_count: i64;
    pub return_count: i64;
}

// ready exposes the AST module to package-level resolution checks.
pub fn ready() -> bool {
    return true;
}
