import selfhost::token;

pub struct NodeId {
    pub raw: i64;
}

pub struct AstSummary {
    pub root: NodeId;
    pub nodes: i64;
    pub tokens: i64;
}

pub fn empty(tokens: i64) -> AstSummary {
    return AstSummary {
        root: NodeId { raw: 0 },
        nodes: 1,
        tokens: tokens
    };
}

pub fn token_node(token_value: token::Token) -> AstSummary {
    return AstSummary {
        root: NodeId { raw: token::span_len(token_value) },
        nodes: 1,
        tokens: 1
    };
}
