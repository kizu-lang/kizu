import selfhost::semantic;
import selfhost::source;

fn gate_source(text: []u8) -> source::SourceFile {
    return source::SourceFile {
        id: 41,
        kind: source::SourceKind::User,
        package_name: "app",
        module_start: 0,
        module_end: 4,
        path: "case.kizu",
        text: text
    };
}

pub fn ready_and_owned_parse_lifetime_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(gate_source("fn main() -> void {}"));
    let checked = try semantic::check_loaded_sources(allocator, &files);
    std::testing::expect(semantic::ready(&checked));
    let parsed_sources = &checked.parsed;
    let parsed_results = &parsed_sources.parsed;
    let source_indexes = &parsed_sources.source_indexes;
    std::testing::expect_equal<i64>(1, parsed_results.len());
    std::testing::expect_equal<i64>(1, source_indexes.len());
    let parsed = try parsed_results.at(0);
    std::testing::expect_equal<i64>(0, parsed.root_span_start());
    let source_index = try source_indexes.get(0);
    std::testing::expect_equal<i64>(0, source_index);
    std::testing::expect_equal<[]u8>("main", checked.package.entry_function.name);
    try semantic::deinit_checked_sources(checked);
    print("semantic-ready");
    return;
}

pub fn parse_failure_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(gate_source("fn main( -> void {}"));
    let checked = try semantic::check_loaded_sources(allocator, &files);
    try semantic::deinit_checked_sources(checked);
    return;
}

pub fn type_diagnostic_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(gate_source("fn main() -> i64 { return true; }"));
    let checked = try semantic::check_loaded_sources(allocator, &files);
    std::testing::expect(!semantic::ready(&checked));
    std::testing::expect(checked.package.diagnostics > 0);
    try semantic::deinit_checked_sources(checked);
    print("semantic-type-diagnostic");
    return;
}

pub fn ownership_diagnostic_gate() -> !void {
    let allocator = std::mem::page_allocator();
    var files = std::array::Array<source::SourceFile>(allocator);
    defer files.deinit();
    try files.append(gate_source(
        "struct Holder { values: std::array::Array<i64>, }
impl Holder {
    fn deinit(self: Holder) -> void { self.values.deinit(); }
}
fn take(holder: Holder) -> void {}
fn main() -> void {
    let allocator = std::mem::page_allocator();
    let values = std::array::Array<i64>(allocator);
    let holder = Holder { values: values };
    take(holder);
    holder.deinit();
}"
    ));
    let checked = try semantic::check_loaded_sources(allocator, &files);
    std::testing::expect(!semantic::ready(&checked));
    std::testing::expect(checked.package.diagnostics > 0);
    try semantic::deinit_checked_sources(checked);
    print("semantic-ownership-diagnostic");
    return;
}
