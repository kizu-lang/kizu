// Module: parser component tests for the future self-host compiler frontend.

import selfhost::ast;
import selfhost::lexer;
import selfhost::parser;
import selfhost::token;

// parser_summary_test checks the lexer-to-parser package component boundary.
pub fn parser_summary_test() -> !void {
    let tokens = try lexer::lex("import a::b;\nstruct U {}\nfn f() { if true { return; } }");
    let summary = try parser::parse_tokens(tokens);
    let decl_count = try parser::declaration_count(tokens);
    let decls = try parser::parse_declarations(tokens);
    let first_start = try parser::first_declaration_start(tokens);
    let details = try parser::parse_detail_summary(tokens);

    try std::testing::expect_equal_i64(1, summary.import_count);
    try std::testing::expect_equal_i64(1, summary.struct_count);
    try std::testing::expect_equal_i64(1, summary.function_count);
    try std::testing::expect_equal_i64(1, summary.return_count);
    try std::testing::expect_equal_i64(3, decl_count);
    try std::testing::expect_equal_i64(3, decls.len());
    try std::testing::expect_equal_i64(0, first_start);
    try std::testing::expect_equal_i64(1, details.control_count);
    try std::testing::expect(details.expression_count > 0);
    ast::ready();
    token::ready();
    return void;
}
