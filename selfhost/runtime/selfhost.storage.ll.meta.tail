linked-llvm target/selfhost/selfhost.ll
output target/selfhost/selfhost.storage.ll
storage-backend selfhost-runtime-ll
allocator-boundary explicit
external @kizu_rt_alloc
external @kizu_rt_free
go-stdprim-storage none
interpreter-storage none
reachable array token-list
reachable array ast-child-list
array-storage copy-element-byte-buffer
array-at returns-stored-element
array-set in-place-element-overwrite
array-deinit releases-element-buffer
array-invalid-element-diagnostic invalid array element
array-oob-diagnostic array index out of bounds
reachable string diagnostic-buffer
reachable string path-buffer
string-storage byte-buffer
string-as-bytes returns-stored-bytes
string-deinit releases-byte-buffer
string-invalid-slice-diagnostic invalid slice
reachable map resolver-symbol-table
reachable map type-symbol-table
reachable map ownership-state-table
map-storage string-key-i64-two-entry
map-key-ownership copies-key-bytes
map-missing-key-diagnostic Map.get key not found
map-capacity-diagnostic map capacity exceeded
reachable diagnostic compiler-failure-buffer
reachable arena ast-node-storage
reachable handle ast-node-id
arena-storage ast-node-inline-two-slot
arena-get returns-stored-payload
arena-deinit releases-inline-payload-storage
arena-payload-constraints ast-node-copy-scalar-view
arena-allocator-boundary explicit
arena-handle-provenance checked
arena-invalid-handle-diagnostic invalid arena handle
reachable box i64-owned-indirection
box-storage single-payload-byte-buffer
box-borrow returns-stored-payload
box-deinit releases-payload-buffer
box-invalid-diagnostic invalid box
abi-record summary-i64-slice
abi-error-union summary-success-failure
abi-call direct-record-roundtrip
deferred tagged-union-payload issue-495
validation go test ./cmd/kizu -run TestSelfhostBackendArtifactGate
