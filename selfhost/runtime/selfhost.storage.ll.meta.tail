linked-llvm target/selfhost/selfhost.ll
output target/selfhost/selfhost.storage.ll
storage-backend selfhost-runtime-ll
allocator-boundary explicit
external @kizu_rt_alloc
external @kizu_rt_free
go-stdprim-storage none
interpreter-storage none
reachable array token-list
reachable array ast-child-list
reachable string diagnostic-buffer
reachable string path-buffer
reachable map resolver-symbol-table
reachable map type-symbol-table
reachable map ownership-state-table
reachable diagnostic compiler-failure-buffer
deferred box-arena-handle issue-496
validation go test ./cmd/kizu -run TestSelfhostBackendArtifactGate
