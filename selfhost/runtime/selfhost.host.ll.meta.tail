linked-llvm target/selfhost/selfhost.ll
output target/selfhost/selfhost.host.ll
host-implementation selfhost/runtime/selfhost.hosted.c
host-smoke reads selfhost/kizu.toml
host-smoke reads selfhost/src
host-smoke writes target/selfhost/host-smoke.status
host-capabilities selfhost-host-v0
allocator-boundary explicit
io-boundary explicit
filesystem-boundary explicit
process-boundary explicit
stdout-boundary explicit
stderr-boundary explicit
exit-boundary explicit
external @kizu_host_page_allocator
external @kizu_host_io_blocking
external @kizu_host_alloc
external @kizu_host_free
external @kizu_host_fs_exists
external @kizu_host_fs_metadata
external @kizu_host_fs_read_dir
external @kizu_host_fs_read_file
external @kizu_host_fs_write_file
external @kizu_host_fs_create_dir
external @kizu_host_fs_rename
external @kizu_host_io_write_stdout
external @kizu_host_io_write_stderr
external @kizu_host_process_arg_count
external @kizu_host_process_arg
external @kizu_host_process_env
external @kizu_host_process_exit_code
external @kizu_host_process_exit
external @kizu_host_trap
go-stdprim-host none
interpreter-host none
linker-process deferred issue-459
validation go test ./cmd/kizu -run TestSelfhostBackendArtifactGate
