// namespace_display_name returns selected namespace-qualified callees.
fn namespace_display_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let callee = try tokens.at(index);
    let module = try namespace_module_name(tokens, index);

    let stdlib = stdlib_namespace_display_name(module, callee.literal);
    if !std::mem::equal_bytes(stdlib, "") {
        return stdlib;
    }
    let user = user_namespace_display_name(module, callee.literal);
    if !std::mem::equal_bytes(user, "") {
        return user;
    }
    return callee.literal;
}

// stdlib_namespace_display_name returns selected stdlib qualified callees.
fn stdlib_namespace_display_name(module: []const u8, callee: []const u8) -> []const u8 {
    if std::mem::equal_bytes(module, "io") {
        return io_display_name(callee);
    }
    if std::mem::equal_bytes(module, "atomic") {
        return atomic_display_name(callee);
    }
    if std::mem::equal_bytes(module, "channel") {
        return channel_display_name(callee);
    }
    if std::mem::equal_bytes(module, "sync") {
        return sync_display_name(callee);
    }
    if std::mem::equal_bytes(module, "fs") {
        if std::mem::equal_bytes(callee, "read_file") {
            return "std::fs::read_file";
        }
    }
    if std::mem::equal_bytes(module, "mem") {
        return mem_display_name(callee);
    }
    if std::mem::equal_bytes(module, "path") {
        return path_display_name(callee);
    }
    if std::mem::equal_bytes(module, "string") {
        if std::mem::equal_bytes(callee, "String") {
            return "std::string::String";
        }
    }
    if std::mem::equal_bytes(module, "task") {
        return task_namespace_display_name(callee);
    }
    if std::mem::equal_bytes(module, "process") {
        return process_display_name(callee);
    }
    if std::mem::equal_bytes(module, "thread") {
        if std::mem::equal_bytes(callee, "scoped") {
            return "std::thread::scoped";
        }
    }
    if std::mem::equal_bytes(module, "testing") {
        return testing_display_name(callee);
    }
    return "";
}

