// concurrency_method_display_name returns selected concurrency method spellings.
fn concurrency_method_display_name(receiver: []const u8, method: []const u8) -> []const u8 {
    if std::mem::equal_bytes(receiver, "stop") {
        if std::mem::equal_bytes(method, "load") {
            return "stop.load";
        }
        if std::mem::equal_bytes(method, "store") {
            return "stop.store";
        }
    }
    if std::mem::equal_bytes(receiver, "ch") {
        if std::mem::equal_bytes(method, "send") {
            return "ch.send";
        }
        if std::mem::equal_bytes(method, "close") {
            return "ch.close";
        }
        if std::mem::equal_bytes(method, "recv") {
            return "ch.recv";
        }
    }
    if std::mem::equal_bytes(receiver, "channel") {
        if std::mem::equal_bytes(method, "send") {
            return "channel.send";
        }
    }
    let task = task_method_display_name(receiver, method);
    if !std::mem::equal_bytes(task, method) {
        return task;
    }
    return sync_method_display_name(receiver, method);
}

