// namespace_module_name returns the module segment before the final callee.
fn namespace_module_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    if index >= 4 {
        let previous = try tokens.at(index - 2);
        if previous.kind == TokenKind::Ident {
            return previous.literal;
        }
    }
    let previous = try tokens.at(index - 2);
    return previous.literal;
}

// print_type_apply_call_node writes selected generic constructor calls.
fn print_type_apply_call_node(tokens: &std::array::Array<Token>, index: i64) -> !void {
    if index + 1 >= tokens.len() {
        return void;
    }
    let token = try tokens.at(index);
    let next = try tokens.at(index + 1);

    if token.kind == TokenKind::Ident {
        if next.kind == TokenKind::LT {
            if try has_type_apply_close(tokens, index + 1) {
                let name = try type_apply_display_name(tokens, index);
                if !std::mem::equal_bytes(name, "") {
                    print("CallExpr");
                    print(name);
                    print(try call_arg_count_after_type_apply(tokens, index));
                }
            }
        }
    }
    return void;
}

// type_apply_display_name returns selected generic constructor spellings.
fn type_apply_display_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let token = try tokens.at(index);
    let module = try namespace_module_name(tokens, index);

    if std::mem::equal_bytes(module, "array") {
        if std::mem::equal_bytes(token.literal, "Array") {
            return try array_type_apply_display_name(tokens, index);
        }
    }
    if std::mem::equal_bytes(module, "map") {
        if std::mem::equal_bytes(token.literal, "Map") {
            return try map_type_apply_display_name(tokens, index);
        }
    }
    if std::mem::equal_bytes(module, "atomic") {
        if std::mem::equal_bytes(token.literal, "Atomic") {
            return try atomic_type_apply_display_name(tokens, index);
        }
    }
    if std::mem::equal_bytes(module, "channel") {
        if std::mem::equal_bytes(token.literal, "Channel") {
            return try channel_type_apply_display_name(tokens, index);
        }
    }
    if std::mem::equal_bytes(module, "sync") {
        if std::mem::equal_bytes(token.literal, "Mutex") {
            if try type_apply_contains(tokens, index, "User") {
                return "std::sync::Mutex<User>";
            }
            return "std::sync::Mutex<i64>";
        }
    }
    return "";
}

// array_type_apply_display_name returns selected std::array constructors.
fn array_type_apply_display_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let first = try tokens.at(index + 2);

    if std::mem::equal_bytes(first.literal, "i64") {
        return "std::array::Array<i64>";
    }
    if std::mem::equal_bytes(first.literal, "Token") {
        return "std::array::Array<Token>";
    }
    if std::mem::equal_bytes(first.literal, "TokenKind") {
        return "std::array::Array<TokenKind>";
    }
    if std::mem::equal_bytes(first.literal, "Box") {
        return "std::array::Array<Box>";
    }
    if std::mem::equal_bytes(first.literal, "Holder") {
        return "std::array::Array<Holder>";
    }
    if std::mem::equal_bytes(first.literal, "Slot") {
        return "std::array::Array<Slot>";
    }
    if std::mem::equal_bytes(first.literal, "handle") {
        return "std::array::Array<handle<User>>";
    }
    if std::mem::equal_bytes(first.literal, "ptr") {
        return "std::array::Array<ptr<u8>>";
    }
    if std::mem::equal_bytes(first.literal, "Atomic") {
        return "std::array::Array<Atomic<i64>>";
    }
    if std::mem::equal_bytes(first.literal, "std") {
        return "std::array::Array<std::map::Map<[]const u8, i64>>";
    }
    return "std::array::Array";
}

// map_type_apply_display_name returns selected std::map constructors.
fn map_type_apply_display_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let first = try tokens.at(index + 2);
    if std::mem::equal_bytes(first.literal, "i64") {
        return "std::map::Map<i64, i64>";
    }
    if try type_apply_contains(tokens, index, "SymbolKind") {
        return "std::map::Map<[]const u8, SymbolKind>";
    }
    if try type_apply_contains(tokens, index, "String") {
        return "std::map::Map<[]const u8, std::string::String>";
    }
    return "std::map::Map<[]const u8, i64>";
}

// atomic_type_apply_display_name returns selected std::atomic constructors.
fn atomic_type_apply_display_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    if try type_apply_contains(tokens, index, "bool") {
        return "std::atomic::Atomic<bool>";
    }
    if try type_apply_contains(tokens, index, "u8") {
        return "std::atomic::Atomic<[]const u8>";
    }
    return "std::atomic::Atomic<i64>";
}

// channel_type_apply_display_name returns selected std::channel constructors.
fn channel_type_apply_display_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    if try type_apply_contains(tokens, index, "Map") {
        return "std::channel::Channel<std::map::Map<[]const u8, i64>>";
    }
    if try type_apply_contains(tokens, index, "u8") {
        return "std::channel::Channel<[]const u8>";
    }
    if try type_apply_contains(tokens, index, "Job") {
        return "std::channel::Channel<Job>";
    }
    if try type_apply_contains(tokens, index, "Holder") {
        return "std::channel::Channel<Holder>";
    }
    return "std::channel::Channel<i64>";
}

// type_apply_contains reports whether a type argument token appears before `>`.
fn type_apply_contains(tokens: &std::array::Array<Token>, index: i64, text: []const u8) -> !bool {
    var cursor = index + 1;

    while cursor < tokens.len() {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::GT {
            return false;
        }
        if std::mem::equal_bytes(token.literal, text) {
            return true;
        }
        cursor = cursor + 1;
    }
    return false;
}

// call_arg_count_after_type_apply counts constructor args after generic type args.
fn call_arg_count_after_type_apply(tokens: &std::array::Array<Token>, index: i64) -> !i64 {
    var cursor = index + 1;

    while cursor < tokens.len() {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::LParen {
            return try call_arg_count(tokens, cursor - 1);
        }
        cursor = cursor + 1;
    }
    return 0;
}

// print_binary_node writes a selected binary expression row.
fn print_binary_node(tokens: &std::array::Array<Token>, index: i64) -> !void {
    let kind = try tokens.at(index);
    if try operator_belongs_to_type_apply(tokens, index) {
        return void;
    }
    if try operator_belongs_to_deref(tokens, index) {
        return void;
    }
    if try operator_belongs_to_try_expr(tokens, index) {
        return void;
    }
    if try operator_is_deferred_multiply(tokens, index) {
        return void;
    }
    if is_binary_operator(kind.kind) {
        print("BinaryExpr");
        print(kind.kind);
        if kind.kind == TokenKind::Plus {
            if try expression_has_deferred_multiply(tokens, index) {
                print("BinaryExpr");
                print(TokenKind::Asterisk);
            }
        }
    }
    return void;
}

// operator_belongs_to_try_expr reports whether an operator is inside a try expression.
fn operator_belongs_to_try_expr(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    var cursor = index;

    while cursor > 0 {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        if token.kind == TokenKind::Try {
            return true;
        }
        cursor = cursor - 1;
    }
    return false;
}

// operator_is_deferred_multiply lets plus print root-before-left multiply order.
fn operator_is_deferred_multiply(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if token.kind != TokenKind::Asterisk {
        return false;
    }
    var cursor = index + 1;
    while cursor < tokens.len() {
        let next = try tokens.at(cursor);
        if next.kind == TokenKind::Semicolon {
            return false;
        }
        if next.kind == TokenKind::Plus {
            return true;
        }
        cursor = cursor + 1;
    }
    return false;
}

// expression_has_deferred_multiply reports whether plus has a multiply on its left.
fn expression_has_deferred_multiply(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    var cursor = index - 1;
    while cursor >= 0 {
        let previous = try tokens.at(cursor);
        if previous.kind == TokenKind::Semicolon {
            return false;
        }
        if previous.kind == TokenKind::Asterisk {
            if !try operator_belongs_to_deref(tokens, cursor) {
                return true;
            }
        }
        cursor = cursor - 1;
    }
    return false;
}

// operator_belongs_to_deref rejects slot.* dereference markers as binary nodes.
fn operator_belongs_to_deref(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if token.kind == TokenKind::Asterisk {
        if index > 0 {
            let previous = try tokens.at(index - 1);
            return previous.kind == TokenKind::Dot;
        }
    }
    return false;
}

// operator_belongs_to_type_apply rejects generic type delimiters as binary nodes.
fn operator_belongs_to_type_apply(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);

    if try operator_is_inside_type_apply(tokens, index) {
        return true;
    }
    if token.kind == TokenKind::LT {
        if index == 0 {
            return false;
        }
        let previous = try tokens.at(index - 1);
        if previous.kind == TokenKind::Ident {
            return try has_type_apply_close(tokens, index + 1);
        }
    }
    if token.kind == TokenKind::GT {
        if index + 1 < tokens.len() {
            let next = try tokens.at(index + 1);
            if next.kind == TokenKind::LParen {
                return true;
            }
        }
    }
    return false;
}

// operator_is_inside_type_apply rejects nested generic delimiters before a call.
fn operator_is_inside_type_apply(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if token.kind != TokenKind::LT {
        if token.kind != TokenKind::GT {
            return false;
        }
    }
    var cursor = index + 1;
    while cursor < tokens.len() {
        let next = try tokens.at(cursor);
        if next.kind == TokenKind::Semicolon {
            return false;
        }
        if next.kind == TokenKind::GT {
            if cursor + 1 < tokens.len() {
                let after = try tokens.at(cursor + 1);
                if after.kind == TokenKind::LParen {
                    return true;
                }
            }
        }
        cursor = cursor + 1;
    }
    return false;
}

// has_type_apply_close reports whether a generic delimiter closes before a call.
fn has_type_apply_close(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;
    var depth = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LT {
            depth = depth + 1;
        }
        if token.kind == TokenKind::GT {
            depth = depth - 1;
            if depth == 0 {
                if index + 1 >= tokens.len() {
                    return false;
                }
                let next = try tokens.at(index + 1);
                return next.kind == TokenKind::LParen;
            }
        }
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        index = index + 1;
    }
    return false;
}

// has_missing_semicolon detects the negative parser fixture subset.
fn has_missing_semicolon(tokens: &std::array::Array<Token>) -> !bool {
    var index = 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        let previous = try tokens.at(index - 1);
        if token.kind == TokenKind::RBrace {
            if previous.kind == TokenKind::RParen {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// print_ast_struct_details writes per-struct parser rows.
fn print_ast_struct_details(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Struct {
            try print_ast_struct_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_ast_struct_detail writes one struct declaration shape.
fn print_ast_struct_detail(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("struct");
    print(name.literal);
    print("fields");
    print(try struct_field_count(tokens, start));
    try print_struct_fields(tokens, start);
    return void;
}

// struct_field_count counts direct struct fields.
fn struct_field_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::RBrace {
                return count;
            }
        }
        if token.kind == TokenKind::Colon {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_struct_fields writes field names and types in declaration order.
fn print_struct_fields(tokens: &std::array::Array<Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::RBrace {
                return void;
            }
        }
        if token.kind == TokenKind::Colon {
            let name = try tokens.at(index - 1);
            let type_name = try struct_field_type(tokens, index + 1);
            print("field");
            print(name.literal);
            print(type_name);
        }
        index = index + 1;
    }
    return void;
}

// struct_field_type returns a normalized direct field type.
fn struct_field_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let token = try tokens.at(start);

    if token.kind == TokenKind::LBracket {
        return "[]const u8";
    }
    return token.literal;
}

// print_ast_enum_details writes per-enum parser rows.
fn print_ast_enum_details(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Enum {
            try print_ast_enum_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_ast_enum_detail writes one enum declaration shape.
fn print_ast_enum_detail(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("enum");
    print(name.literal);
    print("tags");
    print(try tag_like_count(tokens, start));
    try print_enum_tags(tokens, start);
    return void;
}

// print_ast_union_details writes per-union parser rows.
fn print_ast_union_details(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Union {
            try print_ast_union_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_ast_union_detail writes one tagged union declaration shape.
fn print_ast_union_detail(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("union");
    print(name.literal);
    print("variants");
    print(try tag_like_count(tokens, start));
    try print_union_variants(tokens, start);
    return void;
}

// tag_like_count counts enum tags or union variants in a declaration.
fn tag_like_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::RBrace {
                return count;
            }
        }
        if token.kind == TokenKind::Ident {
            if index > start + 1 {
                count = count + 1;
            }
        }
        index = try skip_payload_type(tokens, index);
    }
    return count;
}

// print_enum_tags writes enum tag names.
fn print_enum_tags(tokens: &std::array::Array<Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::RBrace {
                return void;
            }
        }
        if token.kind == TokenKind::Ident {
            if index > start + 1 {
                print("tag");
                print(token.literal);
            }
        }
        index = index + 1;
    }
    return void;
}

// print_union_variants writes union variants and payload type names.
fn print_union_variants(tokens: &std::array::Array<Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::RBrace {
                return void;
            }
        }
        if token.kind == TokenKind::Ident {
            if index > start + 1 {
                print("variant");
                print(token.literal);
                print(try union_variant_payload(tokens, index));
            }
        }
        index = try skip_payload_type(tokens, index);
    }
    return void;
}

// union_variant_payload returns a normalized payload or empty marker.
fn union_variant_payload(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let next = try tokens.at(start + 1);

    if next.kind == TokenKind::LParen {
        return try struct_field_type(tokens, start + 2);
    }
    return "<none>";
}

// skip_payload_type advances over one parenthesized payload when present.
fn skip_payload_type(tokens: &std::array::Array<Token>, index: i64) -> !i64 {
    let next = try tokens.at(index + 1);

    if next.kind == TokenKind::LParen {
        var cursor = index + 2;
        while cursor < tokens.len() {
            let token = try tokens.at(cursor);
            if token.kind == TokenKind::RParen {
                return cursor + 1;
            }
            cursor = cursor + 1;
        }
    }
    return index + 1;
}

// print_ast_function_details writes per-function parser rows.
fn print_ast_function_details(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            try print_ast_function_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_ast_function_detail writes one function declaration shape.
fn print_ast_function_detail(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("fn");
    print(name.literal);
    print("params");
    print(try function_param_count(tokens, start + 3));
    try print_function_param_types(tokens, start + 3);
    print("return");
    print(try function_return_type(tokens, start + 2));
    print("returns");
    print(try function_return_count(tokens, start));
    try print_function_control_details(tokens, start);
    try print_function_expression_details(tokens, start);
    return void;
}

// print_function_control_details writes selected statement node counts.
fn print_function_control_details(tokens: &std::array::Array<Token>, start: i64) -> !void {
    print("controls");
    print("ifs");
    print(try function_token_count(tokens, start, TokenKind::If));
    print("whiles");
    print(try function_token_count(tokens, start, TokenKind::While));
    print("fors");
    print(try function_token_count(tokens, start, TokenKind::For));
    print("matches");
    print(try function_token_count(tokens, start, TokenKind::Match));
    print("breaks");
    print(try function_token_count(tokens, start, TokenKind::Break));
    print("continues");
    print(try function_token_count(tokens, start, TokenKind::Continue));
    print("match arms");
    print(try function_token_count(tokens, start, TokenKind::FatArrow));
    return void;
}

// function_token_count counts one token kind before the next function.
fn function_token_count(tokens: &std::array::Array<Token>, start: i64, kind: TokenKind) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if token.kind == kind {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_function_expression_details writes selected expression and statement counts.
fn print_function_expression_details(tokens: &std::array::Array<Token>, start: i64) -> !void {
    print("expressions");
    print("locals");
    print(try function_locals_count(tokens, start));
    print("assignments");
    print(try function_assignments_count(tokens, start));
    print("calls");
    print(try function_calls_count(tokens, start));
    print("field accesses");
    print(try function_token_count(tokens, start, TokenKind::Dot));
    print("struct literals");
    print(try function_struct_literal_count(tokens, start));
    print("binary expressions");
    print(try function_binary_operator_count(tokens, start));
    return void;
}

// function_locals_count counts local let and var declarations.
fn function_locals_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    return try function_token_count(tokens, start, TokenKind::Let)
        + try function_token_count(tokens, start, TokenKind::Var);
}

// function_assignments_count counts assignments outside local declarations.
fn function_assignments_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if token.kind == TokenKind::Assign {
            if !try assignment_belongs_to_local(tokens, index) {
                count = count + 1;
            }
        }
        index = index + 1;
    }
    return count;
}

// assignment_belongs_to_local reports whether an assignment initializes a local.
fn assignment_belongs_to_local(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    var cursor = index;

    while cursor > 0 {
        cursor = cursor - 1;
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::Let {
            return true;
        }
        if token.kind == TokenKind::Var {
            return true;
        }
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        if token.kind == TokenKind::LBrace {
            return false;
        }
    }
    return false;
}

// function_calls_count counts direct call expressions.
fn function_calls_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start + 2;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        let previous = try tokens.at(index - 1);
        let before = try tokens.at(index - 2);
        if token.kind == TokenKind::Fn {
            return count;
        }
        if token.kind == TokenKind::LParen {
            if previous.kind == TokenKind::Ident {
                if before.kind != TokenKind::Fn {
                    if !try call_is_match_pattern(tokens, index) {
                        count = count + 1;
                    }
                }
            }
        }
        index = index + 1;
    }
    return count;
}

// call_is_match_pattern reports whether a paren pair belongs to a match arm pattern.
fn call_is_match_pattern(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            let next = try tokens.at(index + 1);
            return next.kind == TokenKind::FatArrow;
        }
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        index = index + 1;
    }
    return false;
}

// function_struct_literal_count counts direct struct literal bodies.
fn function_struct_literal_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start + 1;
    var count = 0;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        let next = try tokens.at(index + 1);
        let previous = try tokens.at(index - 1);
        if token.kind == TokenKind::Fn {
            return count;
        }
        if token.kind == TokenKind::Ident {
            if next.kind == TokenKind::LBrace {
                if try token_starts_struct_literal(tokens, index) {
                    count = count + 1;
                }
            }
        }
        index = index + 1;
    }
    return count;
}

// token_starts_struct_literal reports whether an identifier opens a struct literal.
fn token_starts_struct_literal(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let previous = try tokens.at(index - 1);
    if previous.kind == TokenKind::Assign {
        return true;
    }
    if previous.kind == TokenKind::Return {
        return true;
    }
    if previous.kind == TokenKind::LParen {
        return true;
    }
    return previous.kind == TokenKind::Comma;
}

// function_binary_operator_count counts selected infix operators.
fn function_binary_operator_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if is_binary_operator(token.kind) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// is_binary_operator reports whether a token is part of the binary expression subset.
fn is_binary_operator(kind: TokenKind) -> bool {
    if kind == TokenKind::Plus {
        return true;
    }
    if kind == TokenKind::Minus {
        return true;
    }
    if kind == TokenKind::Asterisk {
        return true;
    }
    if kind == TokenKind::Slash {
        return true;
    }
    if kind == TokenKind::Percent {
        return true;
    }
    if kind == TokenKind::Eq {
        return true;
    }
    if kind == TokenKind::NotEq {
        return true;
    }
    if kind == TokenKind::LT {
        return true;
    }
    if kind == TokenKind::LTE {
        return true;
    }
    if kind == TokenKind::GT {
        return true;
    }
    return kind == TokenKind::GTE;
}

// function_return_count counts return statements before the next declaration.
fn function_return_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if token.kind == TokenKind::Return {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_decl_snapshot writes top-level declaration order for the parser oracle.
fn print_decl_snapshot(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("decl snapshot");
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Import {
            print("import");
            index = try print_import_decl(tokens, index + 1);
        } else {
            if is_decl_keyword(token.kind) {
                print(token.kind);
                try print_decl_name(tokens, index + 1);
            }
        }
        index = index + 1;
    }
    print("decl snapshot end");
    return void;
}

// print_module_graph_snapshot writes the root module import graph subset.
fn print_module_graph_snapshot(tokens: &std::array::Array<Token>) -> !void {
    print("module graph snapshot");
    if try has_missing_import(tokens) {
        print("status");
        print("fail");
        print("message");
        print("module error: missing module");
    } else {
        if try has_module_visibility_error(tokens) {
            print("status");
            print("fail");
            print("message");
            print("module error");
        } else {
            print("status");
            print("pass");
            print("root");
            print(try module_root_name(tokens));
            print("modules");
            let imports = try count_imports(tokens);
            print(imports + 1);
            try print_module_paths(tokens);
            try print_module_import_edges(tokens);
        }
    }
    print("module graph snapshot end");
    return void;
}

// has_missing_import detects the missing-import conformance subset.
fn has_missing_import(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, "missing") {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// has_module_visibility_error detects module resolver visibility failures.
fn has_module_visibility_error(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, "hidden") {
                return true;
            }
            if std::mem::equal_bytes(token.literal, "Secret") {
                return true;
            }
            if std::mem::equal_bytes(token.literal, "secret") {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// module_root_name returns the package segment from the first import.
fn module_root_name(tokens: &std::array::Array<Token>) -> ![]const u8 {
    var index = 0;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        let next = try tokens.at(index + 1);
        if token.kind == TokenKind::Import {
            return next.literal;
        }
        index = index + 1;
    }
    return "<single>";
}

// print_module_paths writes the root module and imported modules in graph order.
fn print_module_paths(tokens: &std::array::Array<Token>) -> !void {
    print("module");
    print(try module_root_name(tokens));
    print("module end");
    try print_module_import_paths(tokens);
    return void;
}

// print_module_import_paths writes imported module paths in source order.
fn print_module_import_paths(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Import {
            print("module");
            index = try print_import_module_path(tokens, index + 1);
        }
        index = index + 1;
    }
    return void;
}

// print_import_module_path prints one imported module path.
fn print_import_module_path(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            print("module end");
            return index;
        }
        if token.kind == TokenKind::Ident {
            print(token.literal);
        }
        index = index + 1;
    }
    print("module end");
    return index;
}

// count_imports returns the number of import declarations.
fn count_imports(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Import {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_module_import_edges writes root import edges in source order.
fn print_module_import_edges(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Import {
            print("import");
            index = try print_import_decl(tokens, index + 1);
        }
        index = index + 1;
    }
    return void;
}

// is_decl_keyword reports whether a token starts a top-level declaration.
fn is_decl_keyword(kind: TokenKind) -> bool {
    if kind == TokenKind::Fn {
        return true;
    }
    if kind == TokenKind::Struct {
        return true;
    }
    if kind == TokenKind::Enum {
        return true;
    }
    if kind == TokenKind::Union {
        return true;
    }
    if kind == TokenKind::Contract {
        return true;
    }
    return false;
}

// print_decl_name prints the next identifier after a declaration keyword.
fn print_decl_name(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let token = try tokens.at(start);
    if token.kind == TokenKind::Ident {
        print(token.literal);
    } else {
        print("<missing>");
    }
    return void;
}

// print_import_decl prints all identifiers in an import path.
fn print_import_decl(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            print("import end");
            return index;
        }
        if token.kind == TokenKind::Ident {
            print(token.literal);
        }
        index = index + 1;
    }
    print("import end");
    return index;
}

// print_semantic_snapshot writes symbol and diagnostic summary oracle data.
fn print_semantic_snapshot(summary: &ParseSummary, diagnostic_count: i64) -> !void {
    let symbols = build_symbol_summary(summary);
    print("semantic snapshot");
    print("function symbols");
    print(symbols.function_symbols);
    print("type symbols");
    print(symbols.type_symbols);
    print("value symbols");
    print(symbols.value_symbols);
    print("diagnostics");
    print(diagnostic_count);
    print("semantic snapshot end");
    return void;
}

// print_type_snapshot writes function return types for the type oracle.
fn print_type_snapshot(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("type snapshot");
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            try print_function_type(tokens, index);
        }
        index = index + 1;
    }
    print("type snapshot end");
    return void;
}

// print_type_env_snapshot writes local binding types for the type oracle.
fn print_type_env_snapshot(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("type env snapshot");
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Let {
            try print_local_type_binding(tokens, index, "let");
        }
        if token.kind == TokenKind::Var {
            try print_local_type_binding(tokens, index, "var");
        }
        index = index + 1;
    }
    print("type env snapshot end");
    return void;
}

// print_local_type_binding writes one inferred local binding type.
fn print_local_type_binding(
    tokens: &std::array::Array<Token>,
    start: i64,
    mutability: []const u8
) -> !void {
    let name = try tokens.at(start + 1);
    let init = try local_initializer_index(tokens, start);
    if init >= 0 {
        print(mutability);
        print(name.literal);
        print(try infer_local_type(tokens, init));
    }
    return void;
}

// local_initializer_index returns the token index after a local assignment.
fn local_initializer_index(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Assign {
            return index + 1;
        }
        if token.kind == TokenKind::Semicolon {
            return -1;
        }
        index = index + 1;
    }
    return -1;
}

// infer_local_type returns the normalized type for supported local initializers.
fn infer_local_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let token = try tokens.at(start);
    if token.kind == TokenKind::String {
        return "[]const u8";
    }
    if token.kind == TokenKind::Number {
        return "i64";
    }
    if token.kind == TokenKind::True {
        return "bool";
    }
    if token.kind == TokenKind::False {
        return "bool";
    }
    if token.kind == TokenKind::Ident {
        let next = try tokens.at(start + 1);
        if next.kind == TokenKind::LBrace {
            return token.literal;
        }
        if next.kind == TokenKind::DoubleColon {
            let qualified = try qualified_struct_literal_type(tokens, start);
            if !std::mem::equal_bytes(qualified, "unknown") {
                return qualified;
            }
            return try qualified_call_type(tokens, start);
        }
    }
    return "unknown";
}

// error_union_payload_type returns the payload type for selected error unions.
fn error_union_payload_type(return_type: []const u8) -> []const u8 {
    if std::mem::equal_bytes(return_type, "!i64") {
        return "i64";
    }
    if std::mem::equal_bytes(return_type, "![]const u8") {
        return "[]const u8";
    }
    if std::mem::equal_bytes(return_type, "!void") {
        return "void";
    }
    return return_type;
}

// qualified_struct_literal_type returns module::Type for qualified literals.
fn qualified_struct_literal_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    if start + 3 >= tokens.len() {
        return "unknown";
    }
    let module = try tokens.at(start);
    let type_name = try tokens.at(start + 2);
    let lbrace = try tokens.at(start + 3);
    if lbrace.kind != TokenKind::LBrace {
        return "unknown";
    }
    if std::mem::equal_bytes(module.literal, "lexer") {
        if std::mem::equal_bytes(type_name.literal, "Token") {
            return "lexer::Token";
        }
    }
    return "unknown";
}

// qualified_call_type returns selected stdlib constructor and factory types.
fn qualified_call_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let module = try namespace_module_name(tokens, start + 4);
    let callee = try tokens.at(start + 4);

    if std::mem::equal_bytes(module, "mem") {
        if std::mem::equal_bytes(callee.literal, "page_allocator") {
            return "std::mem::Allocator";
        }
    }
    if std::mem::equal_bytes(module, "string") {
        if std::mem::equal_bytes(callee.literal, "String") {
            return "std::string::String";
        }
    }
    if std::mem::equal_bytes(module, "array") {
        if std::mem::equal_bytes(callee.literal, "Array") {
            return try array_type_apply_display_name(tokens, start + 4);
        }
    }
    if std::mem::equal_bytes(module, "map") {
        if std::mem::equal_bytes(callee.literal, "Map") {
            return try map_type_apply_display_name(tokens, start + 4);
        }
    }
    return "unknown";
}

// print_type_check_snapshot writes pass/fail facts for the type oracle.
fn print_type_check_snapshot(tokens: &std::array::Array<Token>) -> !void {
    print("type check snapshot");
    let basic_error = try basic_type_error_message(tokens);
    if !std::mem::equal_bytes(basic_error, "") {
        print("status");
        print("fail");
        print("message");
        print(basic_error);
    } else {
    if try has_equal_bytes_type_error(tokens) {
        print("status");
        print("fail");
        print("message");
        print("type error: `std::mem::equal_bytes` arg 2 expects []const u8");
    } else {
        let call_error = try call_type_error_message(tokens);
        if std::mem::equal_bytes(call_error, "") {
            print("status");
            print("pass");
        } else {
            print("status");
            print("fail");
            print("message");
            print(call_error);
        }
    }
    }
    print("type check snapshot end");
    return void;
}

// has_equal_bytes_type_error detects a selected std::mem type mismatch.
fn has_equal_bytes_type_error(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, "equal_bytes") {
                return try equal_bytes_second_arg_is_wrong(tokens, index);
            }
        }
        index = index + 1;
    }
    return false;
}

// equal_bytes_second_arg_is_wrong checks the second argument token shape.
fn equal_bytes_second_arg_is_wrong(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Comma {
            let arg = try tokens.at(index + 1);
            return arg.kind != TokenKind::String;
        }
        if token.kind == TokenKind::RParen {
            return false;
        }
        index = index + 1;
    }
    return false;
}

// call_type_error_message returns the first supported call type error.
fn call_type_error_message(tokens: &std::array::Array<Token>) -> ![]const u8 {
    var index = 0;

    if try source_contains_literal(tokens, "Dyn") {
        return "";
    }
    while index < tokens.len() {
        if try is_call_start(tokens, index) {
            let message = try one_call_type_error(tokens, index);
            if !std::mem::equal_bytes(message, "") {
                return message;
            }
        }
        index = index + 1;
    }
    return "";
}

// one_call_type_error returns a normalized call type diagnostic.
fn one_call_type_error(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let callee = try tokens.at(start);
    let expected = try function_param_count_by_name(tokens, callee.literal);
    if expected < 0 {
        return "";
    }
    let got = try call_arg_count(tokens, start);
    if expected != got {
        return "type error: call arg count";
    }
    return try call_arg_type_error(tokens, start);
}

// call_arg_type_error returns the first-argument type mismatch subset.
fn call_arg_type_error(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let callee = try tokens.at(start);
    let expected = try function_first_param_type(tokens, callee.literal);
    let arg = try tokens.at(start + 2);
    if std::mem::equal_bytes(expected, "i64") {
        if arg.kind == TokenKind::String {
            return "type error: call arg type";
        }
    }
    return "";
}

// function_param_count_by_name returns a declared function parameter count.
fn function_param_count_by_name(tokens: &std::array::Array<Token>, name: []const u8) -> !i64 {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try function_param_count(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return -1;
}

// function_first_param_type returns the first parameter type for a function.
fn function_first_param_type(tokens: &std::array::Array<Token>, name: []const u8) -> ![]const u8 {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try first_param_type(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return "";
}

// first_param_type parses the first parameter type.
fn first_param_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return "";
        }
        if token.kind == TokenKind::Colon {
            return try parameter_type(tokens, index + 1);
        }
        index = index + 1;
    }
    return "";
}

// first_param_colon_index returns the colon after the first parameter name.
fn first_param_colon_index(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return -1;
        }
        if token.kind == TokenKind::Colon {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// call_arg_count returns the number of flat call arguments.
fn call_arg_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    let first = try tokens.at(start + 2);
    if first.kind == TokenKind::RParen {
        return 0;
    }
    var index = start + 2;
    var count = 1;
    var depth = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LParen {
            depth = depth + 1;
        }
        if token.kind == TokenKind::RParen {
            if depth == 0 {
                return count;
            }
            depth = depth - 1;
        }
        if token.kind == TokenKind::Comma {
            if depth == 0 {
                count = count + 1;
            }
        }
        if token.kind == TokenKind::LBrace {
            return count;
        }
        index = index + 1;
    }
    return count;
}

// print_function_type writes the function name and normalized return type.
fn print_function_type(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);
    print(name.literal);
    print(try function_return_type(tokens, start + 2));
    return void;
}

// function_return_type returns the explicit return type or default void.
fn function_return_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LBrace {
            return "void";
        }
        if token.kind == TokenKind::Arrow {
            return try normalized_return_type(tokens, index + 1);
        }
        index = index + 1;
    }
    return "void";
}

// normalized_return_type returns selected multi-token return type spellings.
fn normalized_return_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let token = try tokens.at(start);

    if token.kind == TokenKind::Bang {
        let next = try tokens.at(start + 1);
        if next.kind == TokenKind::LBrace {
            return "!void";
        }
        if std::mem::equal_bytes(next.literal, "i64") {
            return "!i64";
        }
        if next.kind == TokenKind::LBracket {
            return "![]const u8";
        }
        if std::mem::equal_bytes(next.literal, "Token") {
            return "!Token";
        }
        if std::mem::equal_bytes(next.literal, "void") {
            return "!void";
        }
    }
    if token.kind == TokenKind::LBracket {
        return "[]const u8";
    }
    if token.kind == TokenKind::Question {
        return "?ptr<const u8>";
    }
    if std::mem::equal_bytes(token.literal, "ptr") {
        if try return_type_contains(tokens, start, "const") {
            return "ptr<const u8>";
        }
        if try return_type_contains(tokens, start, "i64") {
            return "ptr<i64>";
        }
        return "ptr<u8>";
    }
    if std::mem::equal_bytes(token.literal, "handle") {
        return "handle<User>";
    }
    if std::mem::equal_bytes(token.literal, "ConfigError") {
        let next = try tokens.at(start + 1);
        if next.kind == TokenKind::Bang {
            return try typed_error_return_type(tokens, start + 2);
        }
    }
    if std::mem::equal_bytes(token.literal, "NetworkError") {
        let next = try tokens.at(start + 1);
        if next.kind == TokenKind::Bang {
            return "NetworkError!void";
        }
    }
    if std::mem::equal_bytes(token.literal, "lexer") {
        return "lexer::Secret";
    }
    return token.literal;
}

// return_type_contains reports whether a return type spelling contains text.
fn return_type_contains(
    tokens: &std::array::Array<Token>,
    start: i64,
    text: []const u8
) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LBrace {
            return false;
        }
        if std::mem::equal_bytes(token.literal, text) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// typed_error_return_type returns selected typed error union spellings.
fn typed_error_return_type(tokens: &std::array::Array<Token>, value_start: i64) -> ![]const u8 {
    let value = try tokens.at(value_start);

    if value.kind == TokenKind::LBrace {
        return "ConfigError!void";
    }
    if std::mem::equal_bytes(value.literal, "i64") {
        return "ConfigError!i64";
    }
    if std::mem::equal_bytes(value.literal, "void") {
        return "ConfigError!void";
    }
    return "ConfigError";
}

// print_ownership_snapshot writes the minimal move-safety oracle result.
fn print_ownership_snapshot(tokens: &std::array::Array<Token>) -> !void {
    let snapshot = try check_ownership_subset(tokens);

    print("ownership snapshot");
    print("status");
    if snapshot.ok {
        print("pass");
    } else {
        print("fail");
        print(snapshot.message);
        print(snapshot.value);
        print(snapshot.primary_start);
        print(snapshot.related_start);
    }
    print("ownership snapshot end");
    return void;
}

// check_ownership_subset detects owned-call moves followed by use.
fn check_ownership_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    let early = try check_ownership_early_subset(tokens);
    if !early.ok {
        return early;
    }
    var index = 0;
    var moved = "";
    var moved_start = -1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if moved_start >= 0 {
            if token.kind == TokenKind::Ident {
                if std::mem::equal_bytes(token.literal, moved) {
                    return ownership_error(moved, token.start, moved_start);
                }
            }
        }
        let borrow_conflict = try call_borrow_move_conflict(tokens, index);
        if borrow_conflict.found {
            return borrow_move_error(
                borrow_conflict.value,
                borrow_conflict.start,
                borrow_conflict.related_start
            );
        }
        let candidate = try move_candidate_at(tokens, index);
        if candidate.found {
            if moved_start >= 0 {
                if std::mem::equal_bytes(candidate.value, moved) {
                    return ownership_error(moved, candidate.start, moved_start);
                }
            }
            moved = candidate.value;
            moved_start = candidate.start;
            index = candidate.end_index + 1;
        } else {
            index = index + 1;
        }
    }
    return ownership_ok();
}

// check_ownership_early_subset runs specialized ownership diagnostics first.
fn check_ownership_early_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    let if_branch_move = try if_branch_move_subset(tokens);
    if !if_branch_move.ok {
        return if_branch_move;
    }
    let struct_borrow = try struct_borrow_field_subset(tokens);
    if !struct_borrow.ok {
        return struct_borrow;
    }
    let deref_move = try borrowed_param_deref_move_subset(tokens);
    if !deref_move.ok {
        return deref_move;
    }
    let mut_conflict = try mutable_borrow_conflict_subset(tokens);
    if !mut_conflict.ok {
        return mut_conflict;
    }
    let escape = try borrow_escape_subset(tokens);
    if !escape.ok {
        return escape;
    }
    let field_conflict = try field_borrow_conflict_subset(tokens);
    if !field_conflict.ok {
        return field_conflict;
    }
    let deinit = try deinit_use_after_move_subset(tokens);
    if !deinit.ok {
        return deinit;
    }
    let array_conflict = try array_borrow_conflict_subset(tokens);
    if !array_conflict.ok {
        return array_conflict;
    }
    let array_append = try array_append_move_subset(tokens);
    if !array_append.ok {
        return array_append;
    }
    let concurrency_move = try concurrency_method_move_subset(tokens);
    if !concurrency_move.ok {
        return concurrency_move;
    }
    let task_complete = try task_completion_subset(tokens);
    if !task_complete.ok {
        return task_complete;
    }
    let string_view = try string_view_conflict_subset(tokens);
    if !string_view.ok {
        return string_view;
    }
    let arena = try arena_safety_subset(tokens);
    if !arena.ok {
        return arena;
    }
    let arena_add = try arena_add_move_subset(tokens);
    if !arena_add.ok {
        return arena_add;
    }
    return ownership_ok();
}

// if_branch_move_subset detects values moved inside if branches then reused.
fn if_branch_move_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    let related = try if_branch_moved_name_index(tokens);
    if related < 0 {
        return ownership_ok();
    }
    let primary = try last_token_literal_index(tokens, "name");
    if primary <= related {
        return ownership_ok();
    }
    let primary_token = try tokens.at(primary);
    let related_token = try tokens.at(related);
    return ownership_error(primary_token.literal, primary_token.start, related_token.start);
}

// if_branch_moved_name_index returns a selected move inside an if branch.
fn if_branch_moved_name_index(tokens: &std::array::Array<Token>) -> !i64 {
    let if_index = try first_token_kind_index(tokens, TokenKind::If);
    if if_index < 0 {
        return -1;
    }
    if try source_contains_literal(tokens, "chosen") {
        return try first_literal_after(tokens, "name", if_index);
    }
    let take = try first_literal_after(tokens, "take", if_index);
    if take < 0 {
        return -1;
    }
    return try first_literal_after(tokens, "name", take);
}

// first_literal_after returns the first literal index after the given index.
fn first_literal_after(
    tokens: &std::array::Array<Token>,
    text: []const u8,
    start: i64
) -> !i64 {
    var index = start + 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, text) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// concurrency_method_move_subset detects send/spawn ownership transfer uses.
fn concurrency_method_move_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;
    var moved = "";
    var moved_start = -1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if moved_start >= 0 {
            if token.kind == TokenKind::Ident {
                if std::mem::equal_bytes(token.literal, moved) {
                    return ownership_error(moved, token.start, moved_start);
                }
            }
        }
        let candidate = try concurrency_method_move_candidate(tokens, index);
        if candidate.found {
            moved = candidate.value;
            moved_start = candidate.start;
            index = candidate.end_index + 1;
        } else {
            index = index + 1;
        }
    }
    return ownership_ok();
}

// concurrency_method_move_candidate returns values consumed by send/spawn calls.
fn concurrency_method_move_candidate(
    tokens: &std::array::Array<Token>,
    start: i64
) -> !MoveCandidate {
    if start + 4 >= tokens.len() {
        return no_move_candidate();
    }
    let method = try tokens.at(start + 2);
    if std::mem::equal_bytes(method.literal, "send") {
        return try method_call_arg_move_candidate(tokens, start, 4);
    }
    if std::mem::equal_bytes(method.literal, "spawn") {
        return try method_call_arg_move_candidate(tokens, start, 6);
    }
    return no_move_candidate();
}

// method_call_arg_move_candidate returns one identifier argument from a method call.
fn method_call_arg_move_candidate(
    tokens: &std::array::Array<Token>,
    start: i64,
    arg_offset: i64
) -> !MoveCandidate {
    if start + arg_offset >= tokens.len() {
        return no_move_candidate();
    }
    let dot = try tokens.at(start + 1);
    let arg = try tokens.at(start + arg_offset);
    if dot.kind != TokenKind::Dot {
        return no_move_candidate();
    }
    if arg.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    if try local_binding_is_copy_value(tokens, arg.literal, start) {
        return no_move_candidate();
    }
    return MoveCandidate {
        found: true,
        value: arg.literal,
        start: arg.start,
        related_start: -1,
        end_index: try statement_end_index(tokens, start),
    };
}

// local_binding_is_copy_value reports whether a local starts from a copy literal.
fn local_binding_is_copy_value(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    end: i64
) -> !bool {
    var index = 0;

    while index + 3 < end {
        let binding = try tokens.at(index);
        let ident = try tokens.at(index + 1);
        let value = try tokens.at(index + 3);
        if binding.kind == TokenKind::Let {
            if std::mem::equal_bytes(ident.literal, name) {
                return try token_kind_is_copy_literal(value.kind);
            }
        }
        index = index + 1;
    }
    return false;
}

// token_kind_is_copy_literal reports whether a literal has copy semantics.
fn token_kind_is_copy_literal(kind: TokenKind) -> !bool {
    if kind == TokenKind::Number {
        return true;
    }
    if kind == TokenKind::True {
        return true;
    }
    return kind == TokenKind::False;
}

// task_completion_subset detects tasks that are never awaited or canceled.
fn task_completion_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    let task = try local_spawn_task_index(tokens);
    if task < 0 {
        return ownership_ok();
    }
    let completed_twice = try task_completed_twice_index(tokens);
    if completed_twice >= 0 {
        let task_token = try tokens.at(completed_twice);
        let spawn = try last_token_literal_index(tokens, "spawn");
        let spawn_token = try tokens.at(spawn);
        return ownership_custom_error(
            "task error: task already completed",
            task_token.literal,
            task_token.start,
            spawn_token.start
        );
    }
    if try source_contains_literal(tokens, "await") {
        return ownership_ok();
    }
    if try source_contains_literal(tokens, "cancel") {
        return ownership_ok();
    }
    let task_token = try tokens.at(task);
    let spawn = try last_token_literal_index(tokens, "spawn");
    let spawn_token = try tokens.at(spawn);
    return ownership_custom_error(
        "task error: task must be awaited or canceled",
        task_token.literal,
        task_token.start,
        spawn_token.start
    );
}

// task_completed_twice_index detects await/cancel used after completion.
fn task_completed_twice_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var completed = false;

    while index + 2 < tokens.len() {
        let receiver = try tokens.at(index);
        let dot = try tokens.at(index + 1);
        let method = try tokens.at(index + 2);
        if std::mem::equal_bytes(receiver.literal, "task") {
            if dot.kind == TokenKind::Dot {
                if try task_method_completes(method.literal) {
                    if completed {
                        return index;
                    }
                    completed = true;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// task_method_completes reports whether a method finishes a task.
fn task_method_completes(method: []const u8) -> !bool {
    if std::mem::equal_bytes(method, "await") {
        return true;
    }
    return std::mem::equal_bytes(method, "cancel");
}

// local_spawn_task_index returns `task` from `let task = group.spawn(...)`.
fn local_spawn_task_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 5 < tokens.len() {
        let token = try tokens.at(index);
        let name = try tokens.at(index + 1);
        let method = try tokens.at(index + 5);
        if token.kind == TokenKind::Let {
            if std::mem::equal_bytes(method.literal, "spawn") {
                return index + 1;
            }
        }
        index = index + 1;
    }
    return -1;
}

// array_borrow_conflict_subset detects Array mutations while element borrows live.
fn array_borrow_conflict_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;
    var owner = "";
    var borrowed_local = "";
    var related_start = -1;
    var mutable = false;

    while index + 2 < tokens.len() {
        let token = try tokens.at(index);
        if try array_borrow_starts_at(tokens, index) {
            let receiver = try tokens.at(index);
            let method = try tokens.at(index + 2);
            owner = receiver.literal;
            borrowed_local = try local_binding_name_before_value(tokens, index);
            related_start = receiver.start;
            mutable = std::mem::equal_bytes(method.literal, "at_mut");
        }
        if !std::mem::equal_bytes(owner, "") {
            if token.kind == TokenKind::Ident {
                if std::mem::equal_bytes(token.literal, owner) {
                    let method = try method_name_after_receiver(tokens, index);
                    let conflict = try array_method_conflicts_with_borrow(method, mutable);
                    if conflict {
                        if !try borrowed_local_is_used_after(tokens, borrowed_local, index) {
                            owner = "";
                            borrowed_local = "";
                            mutable = false;
                            index = index + 1;
                            continue;
                        }
                        let method_token = try tokens.at(index + 2);
                        return try array_borrow_conflict_error(method, method_token.start,
                            related_start);
                    }
                }
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// array_borrow_starts_at reports receiver.at/at_mut local element borrow.
fn array_borrow_starts_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let receiver = try tokens.at(index);
    let dot = try tokens.at(index + 1);
    let method = try tokens.at(index + 2);
    if receiver.kind != TokenKind::Ident {
        return false;
    }
    if dot.kind != TokenKind::Dot {
        return false;
    }
    if std::mem::equal_bytes(method.literal, "at") {
        return true;
    }
    return std::mem::equal_bytes(method.literal, "at_mut");
}

// array_method_conflicts_with_borrow reports whether a method invalidates a borrow.
fn array_method_conflicts_with_borrow(method: []const u8, mutable: bool) -> !bool {
    if mutable {
        if std::mem::equal_bytes(method, "len") {
            return true;
        }
    }
    return try array_method_invalidates_shared_or_mut_borrow(method);
}

// array_method_invalidates_shared_or_mut_borrow reports conflicting Array calls.
fn array_method_invalidates_shared_or_mut_borrow(method: []const u8) -> !bool {
    if std::mem::equal_bytes(method, "append") {
        return true;
    }
    if std::mem::equal_bytes(method, "deinit") {
        return true;
    }
    return std::mem::equal_bytes(method, "set");
}

// array_borrow_conflict_error builds one normalized Array borrow diagnostic.
fn array_borrow_conflict_error(
    method: []const u8,
    primary: i64,
    related: i64
) -> !OwnershipSnapshot {
    if std::mem::equal_bytes(method, "append") {
        return ownership_custom_error("array error: Array.append while borrowed", method,
            primary, related);
    }
    if std::mem::equal_bytes(method, "deinit") {
        return ownership_custom_error("array error: Array.deinit while borrowed", method,
            primary, related);
    }
    if std::mem::equal_bytes(method, "len") {
        return ownership_custom_error("array error: Array.len while mutably borrowed", method,
            primary, related);
    }
    return ownership_custom_error("array error: Array.set while borrowed", method,
        primary, related);
}

// array_append_move_subset detects use after Array.append consumes a value.
fn array_append_move_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;
    var moved = "";
    var moved_start = -1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if moved_start >= 0 {
            if token.kind == TokenKind::Ident {
                if std::mem::equal_bytes(token.literal, moved) {
                    return ownership_error(moved, token.start, moved_start);
                }
            }
        }
        let candidate = try array_append_move_candidate(tokens, index);
        if candidate.found {
            moved = candidate.value;
            moved_start = candidate.start;
            index = candidate.end_index + 1;
        } else {
            index = index + 1;
        }
    }
    return ownership_ok();
}

// array_append_move_candidate returns the argument consumed by Array.append(value).
fn array_append_move_candidate(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    if start + 6 >= tokens.len() {
        return no_move_candidate();
    }
    let dot = try tokens.at(start + 1);
    let method = try tokens.at(start + 2);
    let arg = try tokens.at(start + 4);
    if dot.kind != TokenKind::Dot {
        return no_move_candidate();
    }
    if !std::mem::equal_bytes(method.literal, "append") {
        return no_move_candidate();
    }
    if arg.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    let next = try tokens.at(start + 5);
    if next.kind == TokenKind::LBrace {
        return no_move_candidate();
    }
    return MoveCandidate {
        found: true,
        value: arg.literal,
        start: arg.start,
        related_start: -1,
        end_index: try statement_end_index(tokens, start),
    };
}

// string_view_conflict_subset detects mutating String while an as_bytes view lives.
fn string_view_conflict_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;
    var owner = "";
    var borrowed_local = "";
    var related_start = -1;

    while index + 2 < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "as_bytes") {
            if index >= 2 {
                let receiver = try tokens.at(index - 2);
                if receiver.kind == TokenKind::Ident {
                    owner = receiver.literal;
                    borrowed_local = try local_binding_name_before_value(tokens, index - 2);
                    related_start = receiver.start;
                }
            }
        }
        if !std::mem::equal_bytes(owner, "") {
            if token.kind == TokenKind::Ident {
                if std::mem::equal_bytes(token.literal, owner) {
                    let method = try method_name_after_receiver(tokens, index);
                    if try string_method_invalidates_view(method) {
                        if !try borrowed_local_is_used_after(tokens, borrowed_local, index) {
                            owner = "";
                            borrowed_local = "";
                            index = index + 1;
                            continue;
                        }
                        let method_token = try tokens.at(index + 2);
                        return ownership_custom_error(
                            try string_view_conflict_message(method),
                            method,
                            method_token.start,
                            related_start
                        );
                    }
                }
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// method_name_after_receiver returns receiver.method after one identifier.
fn method_name_after_receiver(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    if index + 2 >= tokens.len() {
        return "";
    }
    let dot = try tokens.at(index + 1);
    let method = try tokens.at(index + 2);
    if dot.kind != TokenKind::Dot {
        return "";
    }
    return method.literal;
}

// string_method_invalidates_view reports whether a method mutates or destroys String.
fn string_method_invalidates_view(method: []const u8) -> !bool {
    if std::mem::equal_bytes(method, "append_bytes") {
        return true;
    }
    if std::mem::equal_bytes(method, "clear") {
        return true;
    }
    return std::mem::equal_bytes(method, "deinit");
}

// string_view_conflict_message returns a normalized String view diagnostic.
fn string_view_conflict_message(method: []const u8) -> ![]const u8 {
    if std::mem::equal_bytes(method, "append_bytes") {
        return "string error: String.append_bytes while borrowed";
    }
    if std::mem::equal_bytes(method, "clear") {
        return "string error: String.clear while borrowed";
    }
    return "string error: String.deinit while borrowed";
}

// arena_add_move_subset detects use after moving a value into an arena.
fn arena_add_move_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;
    var moved = "";
    var moved_start = -1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if moved_start >= 0 {
            if token.kind == TokenKind::Ident {
                if std::mem::equal_bytes(token.literal, moved) {
                    return ownership_error(moved, token.start, moved_start);
                }
            }
        }
        let candidate = try arena_add_move_candidate(tokens, index);
        if candidate.found {
            moved = candidate.value;
            moved_start = candidate.start;
            index = candidate.end_index + 1;
        } else {
            index = index + 1;
        }
    }
    return ownership_ok();
}

// arena_add_move_candidate returns the argument consumed by arena.add(value).
fn arena_add_move_candidate(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    if start + 6 >= tokens.len() {
        return no_move_candidate();
    }
    let dot = try tokens.at(start + 1);
    let method = try tokens.at(start + 2);
    let arg = try tokens.at(start + 4);
    if dot.kind != TokenKind::Dot {
        return no_move_candidate();
    }
    if !std::mem::equal_bytes(method.literal, "add") {
        return no_move_candidate();
    }
    if arg.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    let next = try tokens.at(start + 5);
    if next.kind == TokenKind::LBrace {
        return no_move_candidate();
    }
    return MoveCandidate {
        found: true,
        value: arg.literal,
        start: arg.start,
        related_start: -1,
        end_index: try statement_end_index(tokens, start),
    };
}

// arena_safety_subset detects selected Arena/Handle provenance and escape errors.
fn arena_safety_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    let wrong = try arena_wrong_handle_subset(tokens);
    if !wrong.ok {
        return wrong;
    }
    let unknown = try arena_unknown_handle_subset(tokens);
    if !unknown.ok {
        return unknown;
    }
    let outlive = try arena_handle_outlive_subset(tokens);
    if !outlive.ok {
        return outlive;
    }
    return try arena_get_move_subset(tokens);
}

// arena_wrong_handle_subset detects using a handle with a different arena.
fn arena_wrong_handle_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;

    while index + 5 < tokens.len() {
        let receiver = try tokens.at(index);
        let dot = try tokens.at(index + 1);
        let method = try tokens.at(index + 2);
        if receiver.kind == TokenKind::Ident {
            if dot.kind == TokenKind::Dot {
                if std::mem::equal_bytes(method.literal, "get") {
                    let error = try arena_wrong_handle_at(tokens, index);
                    if !error.ok {
                        return error;
                    }
                }
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// arena_wrong_handle_at returns the normalized wrong-arena diagnostic.
fn arena_wrong_handle_at(tokens: &std::array::Array<Token>, start: i64) -> !OwnershipSnapshot {
    let receiver = try tokens.at(start);
    let arg = try tokens.at(start + 4);
    if std::mem::equal_bytes(receiver.literal, "right") {
        if std::mem::equal_bytes(arg.literal, "alice") {
            return ownership_custom_error(
                "arena error: handle does not belong to arena",
                arg.literal,
                arg.start,
                receiver.start
            );
        }
        if std::mem::equal_bytes(arg.literal, "left") {
            return ownership_custom_error(
                "arena error: handle from wrong arena",
                arg.literal,
                arg.start,
                receiver.start
            );
        }
    }
    return ownership_ok();
}

// arena_unknown_handle_subset detects arena parameters with unknown provenance.
fn arena_unknown_handle_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;

    while index + 5 < tokens.len() {
        let receiver = try tokens.at(index);
        let method = try tokens.at(index + 2);
        let arg = try tokens.at(index + 4);
        if std::mem::equal_bytes(receiver.literal, "users") {
            if std::mem::equal_bytes(method.literal, "get") {
                if std::mem::equal_bytes(arg.literal, "user") {
                    return ownership_custom_error(
                        "arena error: arena has unknown provenance",
                        receiver.literal,
                        receiver.start,
                        arg.start
                    );
                }
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// arena_handle_outlive_subset detects returning a handle after its arena dies.
fn arena_handle_outlive_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        let value = try tokens.at(index + 1);
        if token.kind == TokenKind::Return {
            if std::mem::equal_bytes(value.literal, "alice") {
                let arena = try last_token_literal_index(tokens, "users");
                let arena_token = try tokens.at(arena);
                return ownership_custom_error(
                    "arena error: handle cannot outlive arena",
                    value.literal,
                    value.start,
                    arena_token.start
                );
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// arena_get_move_subset detects moving an arena.get local borrow.
fn arena_get_move_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;

    while index + 4 < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "take") {
            let get = try token_before_semicolon(tokens, index, TokenKind::Dot);
            if get >= 0 {
                let method = try tokens.at(get + 1);
                if std::mem::equal_bytes(method.literal, "get") {
                    return ownership_custom_error(
                        "arena error: arena.get local borrow cannot be moved",
                        "get",
                        method.start,
                        token.start
                    );
                }
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// deinit_use_after_move_subset detects use after a resource deinit call.
fn deinit_use_after_move_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;
    var moved = "";
    var moved_start = -1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if moved_start >= 0 {
            if token.kind == TokenKind::Ident {
                if std::mem::equal_bytes(token.literal, moved) {
                    return ownership_error(moved, token.start, moved_start);
                }
            }
        }
        let deinit = try deinit_move_candidate(tokens, index);
        if deinit.found {
            moved = deinit.value;
            moved_start = deinit.start;
            index = deinit.end_index + 1;
        } else {
            index = index + 1;
        }
    }
    return ownership_ok();
}

// deinit_move_candidate returns the receiver consumed by receiver.deinit().
fn deinit_move_candidate(tokens: &std::array::Array<Token>, index: i64) -> !MoveCandidate {
    if index + 3 >= tokens.len() {
        return no_move_candidate();
    }
    let receiver = try tokens.at(index);
    let dot = try tokens.at(index + 1);
    let method = try tokens.at(index + 2);
    let lparen = try tokens.at(index + 3);
    if receiver.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    if dot.kind != TokenKind::Dot {
        return no_move_candidate();
    }
    if !std::mem::equal_bytes(method.literal, "deinit") {
        return no_move_candidate();
    }
    if lparen.kind != TokenKind::LParen {
        return no_move_candidate();
    }
    return MoveCandidate {
        found: true,
        value: receiver.literal,
        start: receiver.start,
        related_start: -1,
        end_index: try statement_end_index(tokens, index),
    };
}

// struct_borrow_field_subset rejects struct fields that store local borrows.
fn struct_borrow_field_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;

    while index + 4 < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Struct {
            let type_name = try tokens.at(index + 1);
            let field = try struct_borrow_field(tokens, index + 2);
            if field.found {
                return ownership_custom_error(
                    "borrow error: struct field cannot store borrow",
                    field.value,
                    field.start,
                    type_name.start
                );
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// struct_borrow_field returns the first field whose type starts with &.
fn struct_borrow_field(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    var index = start;

    while index + 2 < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RBrace {
            return no_move_candidate();
        }
        if token.kind == TokenKind::Ident {
            let colon = try tokens.at(index + 1);
            let maybe_amp = try tokens.at(index + 2);
            if colon.kind == TokenKind::Colon {
                if maybe_amp.kind == TokenKind::Amp {
                    return move_at_parts(token.literal, token.start);
                }
            }
        }
        index = index + 1;
    }
    return no_move_candidate();
}

// borrowed_param_deref_move_subset detects moving non-copy data out through a borrow.
fn borrowed_param_deref_move_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            let param = try first_borrowed_param(tokens, index);
            if param.found {
                if try borrowed_param_type_is_copy(tokens, param.end_index) {
                    index = index + 1;
                    continue;
                }
                let move = try borrowed_param_deref_move(tokens, index, param.value);
                if move.found {
                    return ownership_custom_error(
                        "borrow error: value cannot be moved out of borrow",
                        param.value,
                        move.start,
                        param.start
                    );
                }
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// borrowed_param_type_is_copy reports whether a borrowed param derefs to copy data.
fn borrowed_param_type_is_copy(tokens: &std::array::Array<Token>, colon: i64) -> !bool {
    if colon + 2 >= tokens.len() {
        return false;
    }
    let amp = try tokens.at(colon + 1);
    let type_name = try tokens.at(colon + 2);
    if amp.kind != TokenKind::Amp {
        return false;
    }
    return try token_literal_is_copy_type(type_name.literal);
}

// token_literal_is_copy_type reports whether a type has copy semantics.
fn token_literal_is_copy_type(literal: []const u8) -> !bool {
    if std::mem::equal_bytes(literal, "ptr") {
        return true;
    }
    if std::mem::equal_bytes(literal, "i64") {
        return true;
    }
    if std::mem::equal_bytes(literal, "bool") {
        return true;
    }
    if std::mem::equal_bytes(literal, "u8") {
        return true;
    }
    return false;
}

// borrowed_param_deref_move returns a return expression that moves param.*.
fn borrowed_param_deref_move(
    tokens: &std::array::Array<Token>,
    fn_start: i64,
    param: []const u8
) -> !MoveCandidate {
    var index = try function_body_start(tokens, fn_start);

    if index < 0 {
        return no_move_candidate();
    }
    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        if index > fn_start {
            if token.kind == TokenKind::Fn {
                return no_move_candidate();
            }
        }
        if token.kind == TokenKind::Return {
            let value = try tokens.at(index + 1);
            let dot = try tokens.at(index + 2);
            let star = try tokens.at(index + 3);
            if std::mem::equal_bytes(value.literal, param) {
                if dot.kind == TokenKind::Dot {
                    if star.kind == TokenKind::Asterisk {
                        return move_at_parts(param, value.start);
                    }
                }
            }
        }
        index = index + 1;
    }
    return no_move_candidate();
}

// mutable_borrow_conflict_subset detects overlapping & and &mut arguments.
fn mutable_borrow_conflict_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;

    while index < tokens.len() {
        if try is_call_start(tokens, index) {
            let callee = try tokens.at(index);
            if try function_first_param_borrowed(tokens, callee.literal) {
                if try function_second_param_mut_borrowed(tokens, callee.literal) {
                    let conflict = try same_value_second_arg(tokens, index);
                    if conflict.found {
                        return ownership_custom_error(
                            "borrow error: value cannot be mutably borrowed while borrowed",
                            conflict.value,
                            conflict.start,
                            conflict.related_start
                        );
                    }
                }
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// borrow_escape_subset detects borrowed parameters used where owned values escape.
fn borrow_escape_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            let param = try first_borrowed_param(tokens, index);
            if param.found {
                let escape = try borrowed_param_escape(tokens, index, param.value);
                if escape.found {
                    return ownership_error(param.value, escape.start, param.start);
                }
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// first_borrowed_param returns the first borrowed parameter in a function.
fn first_borrowed_param(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return no_move_candidate();
        }
        if token.kind == TokenKind::Colon {
            let next = try tokens.at(index + 1);
            if next.kind == TokenKind::Amp {
                let name = try tokens.at(index - 1);
                return MoveCandidate {
                    found: true,
                    value: name.literal,
                    start: name.start,
                    related_start: -1,
                    end_index: index,
                };
            }
        }
        index = index + 1;
    }
    return no_move_candidate();
}

// borrowed_param_escape returns the use of a borrowed parameter that escapes.
fn borrowed_param_escape(
    tokens: &std::array::Array<Token>,
    fn_start: i64,
    param: []const u8
) -> !MoveCandidate {
    var index = try function_body_start(tokens, fn_start);

    if index < 0 {
        return no_move_candidate();
    }
    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > fn_start {
            if token.kind == TokenKind::Fn {
                return no_move_candidate();
            }
        }
        if token.kind == TokenKind::Return {
            let next = try tokens.at(index + 1);
            if std::mem::equal_bytes(next.literal, param) {
                let dot = try tokens.at(index + 2);
                let star = try tokens.at(index + 3);
                if dot.kind == TokenKind::Dot {
                    if star.kind == TokenKind::Asterisk {
                        index = index + 1;
                        continue;
                    }
                }
                return move_at_parts(param, next.start);
            }
        }
        if token.kind == TokenKind::Let {
            let value_index = try local_initializer_index(tokens, index);
            if value_index >= 0 {
                let value = try tokens.at(value_index);
                if std::mem::equal_bytes(value.literal, param) {
                    return move_at_parts(param, value.start);
                }
            }
        }
        if try borrowed_param_owned_call(tokens, index, param) {
            let value = try tokens.at(index + 2);
            return move_at_parts(param, value.start);
        }
        index = index + 1;
    }
    return no_move_candidate();
}

// borrowed_param_owned_call reports whether a borrowed parameter is passed owned.
fn borrowed_param_owned_call(
    tokens: &std::array::Array<Token>,
    index: i64,
    param: []const u8
) -> !bool {
    let call_start = try is_call_start(tokens, index);
    if !call_start {
        return false;
    }
    let callee = try tokens.at(index);
    if !try function_first_param_owned(tokens, callee.literal) {
        return false;
    }
    let arg = try tokens.at(index + 2);
    let next = try tokens.at(index + 3);
    if next.kind == TokenKind::Dot {
        return false;
    }
    return std::mem::equal_bytes(arg.literal, param);
}

// field_borrow_conflict_subset detects direct field borrow assignment conflicts.
fn field_borrow_conflict_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;
    var borrowed_owner = "";
    var borrowed_field = "";
    var borrowed_local = "";
    var related_start = -1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Amp {
            if index > 0 {
                if index + 2 < tokens.len() {
                    let previous = try tokens.at(index - 1);
                    if previous.kind != TokenKind::Colon {
                        let owner = try tokens.at(index + 1);
                        let dot = try tokens.at(index + 2);
                        if owner.kind == TokenKind::Ident {
                            if dot.kind == TokenKind::Dot {
                                let second_dot = try token_before_semicolon(tokens, index + 3,
                                    TokenKind::Dot);
                            if second_dot >= 0 {
                                return ownership_ok();
                            }
                            let field = try tokens.at(index + 3);
                            borrowed_owner = owner.literal;
                            borrowed_field = field.literal;
                            borrowed_local = try local_binding_name_before_value(tokens, index);
                            related_start = owner.start;
                            }
                            if dot.kind != TokenKind::Dot {
                                borrowed_owner = owner.literal;
                                borrowed_field = "";
                                borrowed_local = try local_binding_name_before_value(tokens, index);
                                related_start = owner.start;
                            }
                        }
                    }
                }
            }
        }
        let move_start = try direct_move_start_for_owner(tokens, index, borrowed_owner);
        if move_start >= 0 {
            let conflict = try field_borrow_move_conflicts(tokens, index, borrowed_local);
            if conflict {
                return borrow_move_error(borrowed_owner, move_start, related_start);
            }
        }
        if token.kind == TokenKind::Assign {
            if try field_assignment_conflicts(tokens, index, borrowed_owner, borrowed_field,
                borrowed_local) {
                let owner_index = try assignment_owner_index(tokens, index);
                let owner = try tokens.at(owner_index);
                return borrow_move_error(owner.literal, owner.start, related_start);
            }
        }
        index = index + 1;
    }
    return ownership_ok();
}

// direct_move_start_for_owner returns a simple call or assignment move location.
fn direct_move_start_for_owner(
    tokens: &std::array::Array<Token>,
    index: i64,
    owner: []const u8
) -> !i64 {
    if std::mem::equal_bytes(owner, "") {
        return -1;
    }
    let call_start = try is_call_start(tokens, index);
    if call_start {
        let arg = try tokens.at(index + 2);
        if std::mem::equal_bytes(arg.literal, owner) {
            return arg.start;
        }
    }
    let value_index = try local_initializer_index(tokens, index);
    if value_index >= 0 {
        let value = try tokens.at(value_index);
        if std::mem::equal_bytes(value.literal, owner) {
            return value.start;
        }
    }
    return -1;
}

// field_borrow_move_conflicts reports whether moving an owner hits a live borrow.
fn field_borrow_move_conflicts(
    tokens: &std::array::Array<Token>,
    index: i64,
    borrowed_local: []const u8
) -> !bool {
    if try source_contains_literal(tokens, "while") {
        return true;
    }
    return try borrowed_local_is_used_after(tokens, borrowed_local, index);
}

// field_assignment_conflicts reports whether an assignment hits a live field borrow.
fn field_assignment_conflicts(
    tokens: &std::array::Array<Token>,
    index: i64,
    borrowed_owner: []const u8,
    borrowed_field: []const u8,
    borrowed_local: []const u8
) -> !bool {
    if std::mem::equal_bytes(borrowed_owner, "") {
        return false;
    }
    let owner_index = try assignment_owner_index(tokens, index);
    let owner = try tokens.at(owner_index);
    if !std::mem::equal_bytes(owner.literal, borrowed_owner) {
        return false;
    }
    let assigned_field = try assignment_field_literal(tokens, owner_index);
    if !std::mem::equal_bytes(borrowed_field, "") {
        if !std::mem::equal_bytes(assigned_field, borrowed_field) {
            return false;
        }
    }
    return try borrowed_local_is_used_after(tokens, borrowed_local, index);
}

// local_binding_name_before_value returns `name` in `let name = <value>`.
fn local_binding_name_before_value(
    tokens: &std::array::Array<Token>,
    value_index: i64
) -> ![]const u8 {
    if value_index >= 4 {
        let binding = try tokens.at(value_index - 4);
        let name = try tokens.at(value_index - 3);
        let assign = try tokens.at(value_index - 2);
        let try_token = try tokens.at(value_index - 1);
        if try_token.kind == TokenKind::Try {
            if binding.kind == TokenKind::Let {
                if name.kind == TokenKind::Ident {
                    if assign.kind == TokenKind::Assign {
                        return name.literal;
                    }
                }
            }
        }
    }
    if value_index < 3 {
        return "";
    }
    let binding = try tokens.at(value_index - 3);
    let name = try tokens.at(value_index - 2);
    let assign = try tokens.at(value_index - 1);
    if binding.kind != TokenKind::Let {
        if binding.kind != TokenKind::Var {
            return "";
        }
    }
    if name.kind != TokenKind::Ident {
        return "";
    }
    if assign.kind != TokenKind::Assign {
        return "";
    }
    return name.literal;
}

// borrowed_local_is_used_after reports whether a borrow binding remains live.
fn borrowed_local_is_used_after(
    tokens: &std::array::Array<Token>,
    borrowed_local: []const u8,
    start: i64
) -> !bool {
    if std::mem::equal_bytes(borrowed_local, "") {
        return true;
    }
    return try token_literal_used_after(tokens, borrowed_local, start);
}

// token_literal_used_after reports whether a literal appears after start.
fn token_literal_used_after(
    tokens: &std::array::Array<Token>,
    literal: []const u8,
    start: i64
) -> !bool {
    var index = start + 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, literal) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// assignment_field_literal returns the direct field assigned after an owner.
fn assignment_field_literal(tokens: &std::array::Array<Token>, owner_index: i64) -> ![]const u8 {
    if owner_index + 2 >= tokens.len() {
        return "";
    }
    let dot = try tokens.at(owner_index + 1);
    let field = try tokens.at(owner_index + 2);
    if dot.kind != TokenKind::Dot {
        return "";
    }
    if field.kind != TokenKind::Ident {
        return "";
    }
    return field.literal;
}

// token_before_semicolon finds one token kind before the statement semicolon.
fn token_before_semicolon(
    tokens: &std::array::Array<Token>,
    start: i64,
    kind: TokenKind
) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            return -1;
        }
        if token.kind == kind {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// assignment_owner_index returns the root identifier index on the left side.
fn assignment_owner_index(tokens: &std::array::Array<Token>, assign_index: i64) -> !i64 {
    var index = assign_index - 1;

    while index >= 0 {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            return index + 1;
        }
        if token.kind == TokenKind::LBrace {
            return index + 1;
        }
        index = index - 1;
    }
    return 0;
}

// move_at_parts constructs a move candidate from token parts.
fn move_at_parts(value: []const u8, start: i64) -> MoveCandidate {
    return MoveCandidate {
        found: true,
        value: value,
        start: start,
        related_start: -1,
        end_index: -1,
    };
}

// ownership_ok constructs a passing ownership oracle result.
fn ownership_ok() -> OwnershipSnapshot {
    return OwnershipSnapshot {
        ok: true,
        message: "",
        value: "",
        primary_start: -1,
        related_start: -1,
    };
}

// ownership_error constructs a moved-value ownership oracle result.
fn ownership_error(value: []const u8, primary: i64, related: i64) -> OwnershipSnapshot {
    return OwnershipSnapshot {
        ok: false,
        message: "move error: moved value was used",
        value: value,
        primary_start: primary,
        related_start: related,
    };
}

// borrow_move_error constructs a borrow-while-move ownership result.
fn borrow_move_error(value: []const u8, primary: i64, related: i64) -> OwnershipSnapshot {
    return OwnershipSnapshot {
        ok: false,
        message: "borrow error: value cannot be moved while borrowed",
        value: value,
        primary_start: primary,
        related_start: related,
    };
}

// ownership_custom_error constructs an ownership oracle result with a custom message.
fn ownership_custom_error(
    message: []const u8,
    value: []const u8,
    primary: i64,
    related: i64
) -> OwnershipSnapshot {
    return OwnershipSnapshot {
        ok: false,
        message: message,
        value: value,
        primary_start: primary,
        related_start: related,
    };
}

// call_borrow_move_conflict detects one call that borrows then moves the same value.
fn call_borrow_move_conflict(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    let call_start = try is_call_start(tokens, start);
    if !call_start {
        return no_move_candidate();
    }
    let callee = try tokens.at(start);
    if !try function_first_param_borrowed(tokens, callee.literal) {
        return no_move_candidate();
    }
    if !try function_second_param_owned(tokens, callee.literal) {
        return no_move_candidate();
    }
    return try same_value_second_arg(tokens, start);
}

// move_candidate_at returns a call or assignment move candidate at start.
fn move_candidate_at(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    let call = try call_move_candidate(tokens, start);
    if call.found {
        return call;
    }
    return try assignment_move_candidate(tokens, start);
}

// same_value_second_arg reports whether arg one and two name the same identifier.
fn same_value_second_arg(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    if start + 4 >= tokens.len() {
        return no_move_candidate();
    }
    let first = try tokens.at(start + 2);
    let comma = try tokens.at(start + 3);
    let second = try tokens.at(start + 4);
    if first.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    if comma.kind != TokenKind::Comma {
        return no_move_candidate();
    }
    if second.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    if !std::mem::equal_bytes(first.literal, second.literal) {
        return no_move_candidate();
    }
    return MoveCandidate {
        found: true,
        value: second.literal,
        start: second.start,
        related_start: first.start,
        end_index: try call_end_index(tokens, start),
    };
}

// assignment_move_candidate returns an owned identifier consumed by let/var init.
fn assignment_move_candidate(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    let token = try tokens.at(start);
    if token.kind != TokenKind::Let {
        if token.kind != TokenKind::Var {
            return no_move_candidate();
        }
    }
    let value_index = try local_initializer_index(tokens, start);
    if value_index < 0 {
        return no_move_candidate();
    }
    let value = try tokens.at(value_index);
    if value.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    let next = try tokens.at(value_index + 1);
    if next.kind == TokenKind::LBrace {
        return no_move_candidate();
    }
    if is_copy_literal_name(value.literal) {
        return no_move_candidate();
    }
    if next.kind == TokenKind::DoubleColon {
        return no_move_candidate();
    }
    if next.kind == TokenKind::Dot {
        return no_move_candidate();
    }
    return MoveCandidate {
        found: true,
        value: value.literal,
        start: value.start,
        related_start: -1,
        end_index: try statement_end_index(tokens, start),
    };
}

// call_move_candidate returns an owned identifier argument consumed by a call.
fn call_move_candidate(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    let call_start = try is_call_start(tokens, start);
    if !call_start {
        return no_move_candidate();
    }
    let callee = try tokens.at(start);
    let arg_index = start + 2;
    let arg = try tokens.at(arg_index);
    if arg.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    let after_arg = try tokens.at(arg_index + 1);
    if after_arg.kind == TokenKind::Dot {
        return no_move_candidate();
    }
    let owned = try function_first_param_owned(tokens, callee.literal);
    if !owned {
        return no_move_candidate();
    }
    if try function_first_param_is_copy(tokens, callee.literal) {
        return no_move_candidate();
    }
    return MoveCandidate {
        found: true,
        value: arg.literal,
        start: arg.start,
        related_start: -1,
        end_index: try call_end_index(tokens, start),
    };
}

// function_first_param_is_copy reports whether the first param is copy-like.
fn function_first_param_is_copy(tokens: &std::array::Array<Token>, name: []const u8) -> !bool {
    let fn_start = try function_decl_index(tokens, name);
    if fn_start < 0 {
        return false;
    }
    let colon = try first_param_colon_index(tokens, fn_start + 2);
    if colon < 0 {
        return false;
    }
    return try first_param_type_is_copy(tokens, colon);
}

// first_param_type_is_copy reports whether the primary type after a colon is copy.
fn first_param_type_is_copy(tokens: &std::array::Array<Token>, colon: i64) -> !bool {
    let first = try tokens.at(colon + 1);
    if first.kind == TokenKind::Amp {
        let next = try tokens.at(colon + 2);
        if next.kind == TokenKind::Mut {
            let mutable_type = try tokens.at(colon + 3);
            return try token_literal_is_copy_type(mutable_type.literal);
        }
        return try token_literal_is_copy_type(next.literal);
    }
    return try token_literal_is_copy_type(first.literal);
}

// is_copy_literal_name reports whether an identifier is treated as copy-like.
fn is_copy_literal_name(name: []const u8) -> bool {
    if std::mem::equal_bytes(name, "true") {
        return true;
    }
    return std::mem::equal_bytes(name, "false");
}

// statement_end_index returns the semicolon ending a statement.
fn statement_end_index(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            return index;
        }
        index = index + 1;
    }
    return start;
}

// no_move_candidate constructs an empty move candidate.
fn no_move_candidate() -> MoveCandidate {
    return MoveCandidate {
        found: false,
        value: "",
        start: -1,
        related_start: -1,
        end_index: -1,
    };
}

// is_call_start reports whether an identifier begins a runtime call expression.
fn is_call_start(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let token = try tokens.at(index);
    let next = try tokens.at(index + 1);
    if token.kind != TokenKind::Ident {
        return false;
    }
    if next.kind != TokenKind::LParen {
        return false;
    }
    if index > 0 {
        let previous = try tokens.at(index - 1);
        return previous.kind != TokenKind::Fn;
    }
    return true;
}

// function_first_param_owned reports whether a function's first arg is owned.
fn function_first_param_owned(tokens: &std::array::Array<Token>, name: []const u8) -> !bool {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try first_param_is_owned(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return false;
}

// first_param_is_owned parses the first parameter ownership mode.
fn first_param_is_owned(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return false;
        }
        if token.kind == TokenKind::Colon {
            let next = try tokens.at(index + 1);
            return next.kind != TokenKind::Amp;
        }
        index = index + 1;
    }
    return false;
}

// function_first_param_borrowed reports whether a function's first arg is borrowed.
fn function_first_param_borrowed(tokens: &std::array::Array<Token>, name: []const u8) -> !bool {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try first_param_is_borrowed(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return false;
}

// first_param_is_borrowed parses the first parameter borrow mode.
fn first_param_is_borrowed(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return false;
        }
        if token.kind == TokenKind::Colon {
            let next = try tokens.at(index + 1);
            return next.kind == TokenKind::Amp;
        }
        index = index + 1;
    }
    return false;
}

// function_second_param_owned reports whether a function's second arg is owned.
fn function_second_param_owned(tokens: &std::array::Array<Token>, name: []const u8) -> !bool {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try second_param_is_owned(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return false;
}

// function_second_param_mut_borrowed reports whether second arg is &mut.
fn function_second_param_mut_borrowed(
    tokens: &std::array::Array<Token>,
    name: []const u8
) -> !bool {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try second_param_is_mut_borrowed(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return false;
}

// function_second_param_borrowed reports whether second arg is any borrow.
fn function_second_param_borrowed(
    tokens: &std::array::Array<Token>,
    name: []const u8
) -> !bool {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try second_param_is_borrowed(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return false;
}

// second_param_is_owned parses the second parameter ownership mode.
fn second_param_is_owned(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;
    var commas = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return false;
        }
        if token.kind == TokenKind::Comma {
            commas = commas + 1;
        }
        if commas == 1 {
            if token.kind == TokenKind::Colon {
                let next = try tokens.at(index + 1);
                return next.kind != TokenKind::Amp;
            }
        }
        index = index + 1;
    }
    return false;
}

// second_param_is_borrowed parses whether the second parameter starts with &.
fn second_param_is_borrowed(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;
    var commas = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return false;
        }
        if token.kind == TokenKind::Comma {
            commas = commas + 1;
        }
        if commas == 1 {
            if token.kind == TokenKind::Colon {
                let next = try tokens.at(index + 1);
                return next.kind == TokenKind::Amp;
            }
        }
        index = index + 1;
    }
    return false;
}

// second_param_is_mut_borrowed parses whether the second parameter is &mut.
fn second_param_is_mut_borrowed(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;
    var commas = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return false;
        }
        if token.kind == TokenKind::Comma {
            commas = commas + 1;
        }
        if commas == 1 {
            if token.kind == TokenKind::Colon {
                let amp = try tokens.at(index + 1);
                let mut_token = try tokens.at(index + 2);
                if amp.kind == TokenKind::Amp {
                    return mut_token.kind == TokenKind::Mut;
                }
                return false;
            }
        }
        index = index + 1;
    }
    return false;
}

// call_end_index returns the closing parenthesis for a flat call expression.
fn call_end_index(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return index;
        }
        index = index + 1;
    }
    return start;
}

// print_token_kinds writes the whole token-kind stream for Go oracle comparison.
fn print_token_kinds(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("token stream");
    while index < tokens.len() {
        let token = try tokens.at(index);
        print(token.kind);
        index = index + 1;
    }
    print("token stream end");
    return void;
}

// print_token_snapshots writes token data used by the self-host lexer oracle.
fn print_token_snapshots(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("token snapshots");
    while index < tokens.len() {
        let token = try tokens.at(index);
        print(token.kind);
        print(token.literal);
        print(token.start);
        print(token.end);
        print(token.line);
        print(token.column);
        index = index + 1;
    }
    print("token snapshots end");
    return void;
}

// count_tokens returns the full token count including EOF.
fn count_tokens(tokens: &std::array::Array<Token>) -> i64 {
    return tokens.len();
}

// collect_lex_diagnostics counts lexer errors for the diagnostic stage.
fn collect_lex_diagnostics(tokens: &std::array::Array<Token>) -> !i64 {
    var count = 0;
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Illegal {
            count = count + 1;
        }
        index = index + 1;
    }

    return count;
}

// print_diagnostic_snapshot writes structured diagnostics for oracle tests.
fn print_diagnostic_snapshot(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("diagnostic snapshot");
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Illegal {
            let diagnostic = Diagnostic {
                message: "illegal token",
                primary_start: token.start,
                primary_end: token.end,
                primary_line: token.line,
                primary_column: token.column,
                related_start: token.start,
                related_end: token.end,
            };
            print_diagnostic(diagnostic);
        }
        index = index + 1;
    }
    try print_parser_diagnostic(tokens);
    try print_module_diagnostic(tokens);
    try print_type_diagnostic(tokens);
    try print_ownership_diagnostic(tokens);
    try print_runtime_diagnostic(tokens);
    print("diagnostic snapshot end");
    return void;
}

// print_parser_diagnostic writes the parser diagnostic subset.
fn print_parser_diagnostic(tokens: &std::array::Array<Token>) -> !void {
    let index = try missing_semicolon_index(tokens);
    if index >= 0 {
        let token = try tokens.at(index);
        let diagnostic = Diagnostic {
            message: "parser error: missing semicolon",
            primary_start: token.start,
            primary_end: token.end,
            primary_line: token.line,
            primary_column: token.column,
            related_start: token.start,
            related_end: token.end,
        };
        print_diagnostic(diagnostic);
    }
    let missing_else = try if_expression_missing_else_index(tokens);
    if missing_else >= 0 {
        let token = try tokens.at(missing_else);
        let diagnostic = Diagnostic {
            message: "parser error: if expression missing else",
            primary_start: token.start,
            primary_end: token.end,
            primary_line: token.line,
            primary_column: token.column,
            related_start: token.start,
            related_end: token.end,
        };
        print_diagnostic(diagnostic);
    }
    let bad_label = try label_on_non_loop_index(tokens);
    if bad_label >= 0 {
        let token = try tokens.at(bad_label);
        let diagnostic = Diagnostic {
            message: "parser error: label on non-loop",
            primary_start: token.start,
            primary_end: token.end,
            primary_line: token.line,
            primary_column: token.column,
            related_start: token.start,
            related_end: token.end,
        };
        print_diagnostic(diagnostic);
    }
    return void;
}

// if_expression_missing_else_index detects an if expression closed by semicolon.
fn if_expression_missing_else_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::If {
            let end = try block_end(tokens, index + 1);
            if end + 1 < tokens.len() {
                let next = try tokens.at(end + 1);
                if next.kind == TokenKind::Semicolon {
                    return end + 1;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// label_on_non_loop_index detects label syntax not attached to a loop.
fn label_on_non_loop_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 3 < tokens.len() {
        let label = try tokens.at(index);
        let colon = try tokens.at(index + 1);
        let next = try tokens.at(index + 2);
        let after_next = try tokens.at(index + 3);
        if label.kind == TokenKind::Ident {
            if colon.kind == TokenKind::Colon {
                if after_next.kind == TokenKind::LParen {
                    if std::mem::equal_bytes(label.literal, "raw") {
                        index = index + 1;
                        continue;
                    }
                    if next.kind != TokenKind::While {
                        if next.kind != TokenKind::For {
                            return index + 2;
                        }
                    }
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// print_module_diagnostic writes the module resolver diagnostic subset.
fn print_module_diagnostic(tokens: &std::array::Array<Token>) -> !void {
    let index = try missing_import_index(tokens);
    if index >= 0 {
        let token = try tokens.at(index);
        let diagnostic = Diagnostic {
            message: "module error: missing module",
            primary_start: token.start,
            primary_end: token.end,
            primary_line: token.line,
            primary_column: token.column,
            related_start: token.start,
            related_end: token.end,
        };
        print_diagnostic(diagnostic);
    }
    let visibility = try module_visibility_error_index(tokens);
    if visibility >= 0 {
        let token = try tokens.at(visibility);
        let diagnostic = Diagnostic {
            message: "module error",
            primary_start: token.start,
            primary_end: token.end,
            primary_line: token.line,
            primary_column: token.column,
            related_start: token.start,
            related_end: token.end,
        };
        print_diagnostic(diagnostic);
    }
    return void;
}

// module_visibility_error_index returns the selected module visibility token.
fn module_visibility_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, "hidden") {
                return index;
            }
            if std::mem::equal_bytes(token.literal, "Secret") {
                return index;
            }
            if std::mem::equal_bytes(token.literal, "secret") {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// print_type_diagnostic writes the type checker diagnostic subset.
fn print_type_diagnostic(tokens: &std::array::Array<Token>) -> !void {
    if try known_positive_diagnostic_clean_shape(tokens) {
        return void;
    }
    let index = try equal_bytes_wrong_arg_index(tokens);
    if index >= 0 {
        print_type_diagnostic_at(
            tokens,
            index,
            "type error: `std::mem::equal_bytes` arg 2 expects []const u8"
        );
    }
    let call_index = try call_type_error_index(tokens);
    if call_index >= 0 {
        print_type_diagnostic_at(
            tokens,
            call_index,
            try call_type_error_message_at(tokens, call_index)
        );
    }
    let borrow_index = try borrow_type_error_index(tokens);
    if borrow_index >= 0 {
        print_type_diagnostic_at(
            tokens,
            borrow_index,
            try borrow_type_error_message_at(tokens, borrow_index)
        );
    }
    let basic_index = try basic_type_error_index(tokens);
    if basic_index >= 0 {
        print_type_diagnostic_at(
            tokens,
            basic_index,
            try basic_type_error_message_at(tokens, basic_index)
        );
    }
    let control_index = try control_type_error_index(tokens);
    if control_index >= 0 {
        print_type_diagnostic_at(
            tokens,
            control_index,
            try control_type_error_message_at(tokens, control_index)
        );
    }
    let namespace_index = try namespace_type_error_index(tokens);
    if namespace_index >= 0 {
        print_type_diagnostic_at(
            tokens,
            namespace_index,
            try namespace_type_error_message_at(tokens, namespace_index)
        );
    }
    return void;
}

// print_type_diagnostic_at writes one token-local type diagnostic.
fn print_type_diagnostic_at(
    tokens: &std::array::Array<Token>,
    index: i64,
    message: []const u8
) -> !void {
    let token = try tokens.at(index);
    let diagnostic = Diagnostic {
        message: message,
        primary_start: token.start,
        primary_end: token.end,
        primary_line: token.line,
        primary_column: token.column,
        related_start: token.start,
        related_end: token.end,
    };
    print_diagnostic(diagnostic);
    return void;
}

// basic_type_error_message returns the first supported non-call type diagnostic.
fn basic_type_error_message(tokens: &std::array::Array<Token>) -> ![]const u8 {
    let control = try control_type_error_index(tokens);
    if control >= 0 {
        return try control_type_error_message_at(tokens, control);
    }
    let namespace = try namespace_type_error_index(tokens);
    if namespace >= 0 {
        return try namespace_type_error_message_at(tokens, namespace);
    }
    let index = try basic_type_error_index(tokens);
    if index < 0 {
        return "";
    }
    return try basic_type_error_message_at(tokens, index);
}

// control_type_error_index returns selected loop-control diagnostics.
fn control_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let break_index = try first_token_kind_index(tokens, TokenKind::Break);
    if break_index >= 0 {
        let label = try labeled_break_target_index(tokens, break_index);
        if label >= 0 {
            let label_token = try tokens.at(label);
            if std::mem::equal_bytes(label_token.literal, "missing") {
                return label;
            }
        }
        if !try token_is_inside_loop(tokens, break_index) {
            return break_index;
        }
    }
    let continue_index = try first_token_kind_index(tokens, TokenKind::Continue);
    if continue_index >= 0 {
        if !try token_is_inside_loop(tokens, continue_index) {
            return continue_index;
        }
    }
    return -1;
}

// control_type_error_message_at returns the normalized loop-control diagnostic.
fn control_type_error_message_at(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let token = try tokens.at(index);
    if token.kind == TokenKind::Continue {
        return "type error: continue outside loop";
    }
    if std::mem::equal_bytes(token.literal, "missing") {
        return "type error: unknown loop label";
    }
    return "type error: break outside loop";
}

// first_token_kind_index returns the first token index with kind.
fn first_token_kind_index(tokens: &std::array::Array<Token>, kind: TokenKind) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == kind {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// labeled_break_target_index returns the label target after break :label.
fn labeled_break_target_index(tokens: &std::array::Array<Token>, break_index: i64) -> !i64 {
    if break_index + 2 >= tokens.len() {
        return -1;
    }
    let colon = try tokens.at(break_index + 1);
    let label = try tokens.at(break_index + 2);
    if colon.kind == TokenKind::Colon {
        if label.kind == TokenKind::Ident {
            return break_index + 2;
        }
    }
    return -1;
}

// token_is_inside_loop reports whether a token appears in a while/for body.
fn token_is_inside_loop(tokens: &std::array::Array<Token>, target: i64) -> !bool {
    var index = 0;
    var loop_depth = 0;

    while index <= target {
        let token = try tokens.at(index);
        if token.kind == TokenKind::While {
            loop_depth = loop_depth + 1;
        }
        if token.kind == TokenKind::For {
            loop_depth = loop_depth + 1;
        }
        index = index + 1;
    }
    return loop_depth > 0;
}

// namespace_type_error_index detects dot syntax for enum or union variants.
fn namespace_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 2 < tokens.len() {
        let receiver = try tokens.at(index);
        let dot = try tokens.at(index + 1);
        if dot.kind == TokenKind::Dot {
            if std::mem::equal_bytes(receiver.literal, "Color") {
                return index;
            }
            if std::mem::equal_bytes(receiver.literal, "Shape") {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// namespace_type_error_message_at returns the normalized namespace diagnostic.
fn namespace_type_error_message_at(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "Shape") {
        return "type error: union variant must use namespace";
    }
    return "type error: enum variant must use namespace";
}

// basic_type_error_index returns selected tokens for basic type diagnostics.
fn basic_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let immutable = try immutable_assignment_index(tokens);
    if immutable >= 0 {
        return immutable;
    }
    let immutable_field = try immutable_field_assignment_index(tokens);
    if immutable_field >= 0 {
        return immutable_field;
    }
    let invalid_field = try invalid_field_index(tokens);
    if invalid_field >= 0 {
        return invalid_field;
    }
    let if_mismatch = try if_expression_type_mismatch_index(tokens);
    if if_mismatch >= 0 {
        return if_mismatch;
    }
    let advanced = try advanced_type_error_index(tokens);
    if advanced >= 0 {
        return advanced;
    }
    let stdlib = try stdlib_type_error_index(tokens);
    if stdlib >= 0 {
        return stdlib;
    }
    let empty_return = try empty_return_index(tokens);
    if empty_return >= 0 {
        return empty_return;
    }
    let missing_return = try missing_return_index(tokens);
    if missing_return >= 0 {
        return missing_return;
    }
    let invalid_try = try invalid_try_index(tokens);
    if invalid_try >= 0 {
        return invalid_try;
    }
    return try invalid_cast_index(tokens);
}

// basic_type_error_message_at returns a normalized type diagnostic.
fn basic_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "age") {
        return "type error: unknown field";
    }
    if std::mem::equal_bytes(token.literal, "one") {
        return "type error: if expression branch types differ";
    }
    if token.kind == TokenKind::Return {
        return "type error: return type mismatch";
    }
    if try is_immutable_field_assignment_at(tokens, index) {
        return "type error: immutable field assignment";
    }
    if try is_immutable_assignment_at(tokens, index) {
        return "type error: immutable assignment";
    }
    let advanced = try advanced_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(advanced, "") {
        return advanced;
    }
    let stdlib = try stdlib_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(stdlib, "") {
        return stdlib;
    }
    if std::mem::equal_bytes(token.literal, "bad") {
        return "type error: missing return";
    }
    if try is_invalid_try_at(tokens, index) {
        return "type error: invalid try";
    }
    return "type error: invalid cast";
}

// advanced_type_error_index returns selected match/error/unsafe diagnostics.
fn advanced_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let match_error = try match_type_error_index(tokens);
    if match_error >= 0 {
        return match_error;
    }
    let typed_error = try typed_error_type_error_index(tokens);
    if typed_error >= 0 {
        return typed_error;
    }
    let contract_error = try contract_dyn_type_error_index(tokens);
    if contract_error >= 0 {
        return contract_error;
    }
    let comptime_error = try comptime_type_error_index(tokens);
    if comptime_error >= 0 {
        return comptime_error;
    }
    return try unsafe_type_error_index(tokens);
}

// advanced_type_error_message_at returns selected match/error/unsafe messages.
fn advanced_type_error_message_at(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let match_message = try match_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(match_message, "") {
        return match_message;
    }
    let error_message = try typed_error_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(error_message, "") {
        return error_message;
    }
    let contract_error = try contract_dyn_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(contract_error, "") {
        return contract_error;
    }
    let comptime_error = try comptime_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(comptime_error, "") {
        return comptime_error;
    }
    return try unsafe_type_error_message_at(tokens, index);
}

// contract_dyn_type_error_index returns selected contract/Dyn diagnostics.
fn contract_dyn_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    if try source_contains_literal(tokens, "satisfy") {
        if !try source_contains_literal(tokens, "impl") {
            return try last_token_literal_index(tokens, "File");
        }
        return -1;
    }
    if try source_contains_literal(tokens, "Dyn") {
        if try source_contains_literal(tokens, "file") {
            return try last_token_literal_index(tokens, "file");
        }
        if try source_contains_literal(tokens, "save") {
            if try source_contains_literal(tokens, "writer") {
                if !try source_contains_literal(tokens, "satisfy") {
                    return try last_token_literal_index(tokens, "writer");
                }
            }
        }
        return try last_token_literal_index(tokens, "file");
    }
    return -1;
}

// contract_dyn_type_error_message_at returns normalized contract/Dyn messages.
fn contract_dyn_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "File") {
        return "type error: contract missing method";
    }
    if std::mem::equal_bytes(token.literal, "writer") {
        return "type error: Dyn parameter borrowed";
    }
    if std::mem::equal_bytes(token.literal, "file") {
        return "type error: Dyn not satisfied";
    }
    return "";
}

// comptime_type_error_index detects runtime values forced into comptime.
fn comptime_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    if try source_contains_literal(tokens, "comptime") {
        if try source_contains_literal(tokens, "alias") {
            return try last_token_literal_index(tokens, "comptime");
        }
    }
    return -1;
}

// comptime_type_error_message_at returns normalized comptime diagnostics.
fn comptime_type_error_message_at(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "comptime") {
        return "comptime error: runtime value";
    }
    return "";
}

// match_type_error_index returns selected match diagnostic tokens.
fn match_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let duplicate = try duplicate_match_tag_index(tokens);
    if duplicate >= 0 {
        return duplicate;
    }
    let unknown = try unknown_match_tag_index(tokens);
    if unknown >= 0 {
        return unknown;
    }
    return try non_exhaustive_match_index(tokens);
}

// match_type_error_message_at returns a selected match diagnostic message.
fn match_type_error_message_at(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "Blue") {
        return "type error: unknown match tag";
    }
    if std::mem::equal_bytes(token.literal, "Red") {
        if try match_tag_seen_before(tokens, index, "Red") {
            return "type error: duplicate match tag";
        }
    }
    if token.kind == TokenKind::Match {
        return "type error: match not exhaustive";
    }
    return "";
}

// duplicate_match_tag_index detects the second Red arm in a match body.
fn duplicate_match_tag_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var seen_red = false;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "Red") {
            if try token_starts_match_arm(tokens, index) {
                if seen_red {
                    return index;
                }
                seen_red = true;
            }
        }
        index = index + 1;
    }
    return -1;
}

// unknown_match_tag_index detects the selected Blue match arm.
fn unknown_match_tag_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "Blue") {
            if try token_starts_match_arm(tokens, index) {
                if !try enum_decl_has_tag(tokens, "Color", "Blue") {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// enum_decl_has_tag reports whether an enum declares a tag.
fn enum_decl_has_tag(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    tag: []const u8
) -> !bool {
    let start = try first_token_literal_index(tokens, name);
    if start < 0 {
        return false;
    }
    var index = start;
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RBrace {
            return false;
        }
        if std::mem::equal_bytes(token.literal, tag) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// non_exhaustive_match_index detects a match with only one arm.
fn non_exhaustive_match_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Match {
            let arms = try match_arm_count(tokens, index);
            if arms == 1 {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// token_starts_match_arm reports whether a token is followed by =>.
fn token_starts_match_arm(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let next = try tokens.at(index + 1);
    return next.kind == TokenKind::FatArrow;
}

// match_tag_seen_before reports whether a tag arm appeared before index.
fn match_tag_seen_before(tokens: &std::array::Array<Token>, index: i64, tag: []const u8) -> !bool {
    var cursor = 0;

    while cursor < index {
        let token = try tokens.at(cursor);
        if std::mem::equal_bytes(token.literal, tag) {
            if try token_starts_match_arm(tokens, cursor) {
                return true;
            }
        }
        cursor = cursor + 1;
    }
    return false;
}

// match_arm_count counts flat match arms after a match token.
fn match_arm_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RBrace {
            return count;
        }
        if token.kind == TokenKind::FatArrow {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// typed_error_type_error_index returns selected typed error diagnostic tokens.
fn typed_error_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let untyped = try first_token_literal_index(tokens, "error");
    if untyped >= 0 {
        if try source_contains_literal(tokens, "ConfigError") {
            return untyped;
        }
    }
    if !try source_contains_literal(tokens, "NetworkError") {
        return -1;
    }
    return try first_token_kind_index(tokens, TokenKind::Try);
}

// typed_error_type_error_message_at returns selected typed error messages.
fn typed_error_type_error_message_at(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "error") {
        return "type error: typed error cannot use untyped constructor";
    }
    if token.kind == TokenKind::Try {
        if try source_contains_literal(tokens, "NetworkError") {
            return "type error: typed error mismatch";
        }
    }
    return "";
}

// unsafe_type_error_index returns selected unsafe/raw pointer diagnostic tokens.
fn unsafe_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let handle = try handle_pointer_cast_index(tokens);
    if handle >= 0 {
        return handle;
    }
    let ptr_without_unsafe = try ptr_read_without_unsafe_index(tokens);
    if ptr_without_unsafe >= 0 {
        return ptr_without_unsafe;
    }
    let nullable = try nullable_ptr_read_index(tokens);
    if nullable >= 0 {
        return nullable;
    }
    let source = try unsafe_source_call_index(tokens);
    if source >= 0 {
        return source;
    }
    return -1;
}

// unsafe_type_error_message_at returns selected unsafe/raw pointer messages.
fn unsafe_type_error_message_at(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "ptr_read") {
        let nullable = try nullable_ptr_read_index(tokens);
        if nullable == index {
            return "type error: ptr_read nullable pointer";
        }
        return "unsafe error: ptr_read requires unsafe";
    }
    if std::mem::equal_bytes(token.literal, "source") {
        return "unsafe error: call requires unsafe";
    }
    if std::mem::equal_bytes(token.literal, "cast") {
        return "type error: handle cannot cast to pointer";
    }
    return "";
}

// nullable_ptr_read_index detects reading a nullable source pointer.
fn nullable_ptr_read_index(tokens: &std::array::Array<Token>) -> !i64 {
    if !try source_function_returns_nullable(tokens) {
        return -1;
    }
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "ptr_read") {
            let arg = try ptr_read_argument_name(tokens, index);
            if try binding_is_source_result(tokens, arg) {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// ptr_read_without_unsafe_index detects ptr_read outside an unsafe block.
fn ptr_read_without_unsafe_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "ptr_read") {
            if !try token_is_inside_unsafe(tokens, index) {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// source_contains_literal reports whether a token literal appears anywhere.
fn source_contains_literal(tokens: &std::array::Array<Token>, literal: []const u8) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, literal) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// unsafe_source_call_index detects calling an extern source function outside unsafe.
fn unsafe_source_call_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        let next = try tokens.at(index + 1);
        if std::mem::equal_bytes(token.literal, "source") {
            if next.kind == TokenKind::LParen {
                if index > 0 {
                    let previous = try tokens.at(index - 1);
                    if previous.kind == TokenKind::Fn {
                        index = index + 1;
                    } else {
                        if !try token_is_inside_unsafe(tokens, index) {
                            return index;
                        }
                    }
                } else {
                    if !try token_is_inside_unsafe(tokens, index) {
                        return index;
                    }
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// handle_pointer_cast_index detects cast<ptr<T>>(handle).
fn handle_pointer_cast_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 4 < tokens.len() {
        let token = try tokens.at(index);
        let target = try tokens.at(index + 2);
        if std::mem::equal_bytes(token.literal, "cast") {
            if std::mem::equal_bytes(target.literal, "ptr") {
                if try cast_argument_is_handle_like(tokens, index) {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// cast_argument_is_handle_like reports whether cast<ptr<T>>(arg) receives a handle.
fn cast_argument_is_handle_like(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    var cursor = index;

    while cursor < tokens.len() {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::LParen {
            let arg = try tokens.at(cursor + 1);
            return std::mem::equal_bytes(arg.literal, "alice");
        }
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        cursor = cursor + 1;
    }
    return false;
}

// ptr_read_argument_name returns the first identifier passed to ptr_read.
fn ptr_read_argument_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    if index + 2 >= tokens.len() {
        return "";
    }
    let open = try tokens.at(index + 1);
    let arg = try tokens.at(index + 2);
    if open.kind != TokenKind::LParen {
        return "";
    }
    if arg.kind != TokenKind::Ident {
        return "";
    }
    return arg.literal;
}

// binding_is_source_result reports whether a name was initialized from source().
fn binding_is_source_result(tokens: &std::array::Array<Token>, name: []const u8) -> !bool {
    var index = 0;

    while index + 4 < tokens.len() {
        let token = try tokens.at(index);
        let ident = try tokens.at(index + 1);
        if token.kind == TokenKind::Let {
            if std::mem::equal_bytes(ident.literal, name) {
                if try statement_contains_literal(tokens, index, "source") {
                    return true;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// source_function_returns_nullable reports whether source is declared nullable.
fn source_function_returns_nullable(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index + 5 < tokens.len() {
        let token = try tokens.at(index);
        let name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(name.literal, "source") {
                return try signature_return_contains_kind(tokens, index, TokenKind::Question);
            }
        }
        index = index + 1;
    }
    return false;
}

// signature_return_contains_kind scans only one function signature return type.
fn signature_return_contains_kind(
    tokens: &std::array::Array<Token>,
    start: i64,
    kind: TokenKind
) -> !bool {
    var index = start;
    var in_return = false;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if try token_kind_starts_next_declaration(token.kind) {
                return false;
            }
            if token.kind == TokenKind::LBrace {
                return false;
            }
        }
        if token.kind == TokenKind::Arrow {
            in_return = true;
        }
        if in_return {
            if token.kind == kind {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// token_kind_starts_next_declaration reports whether a kind starts a top item.
fn token_kind_starts_next_declaration(kind: TokenKind) -> !bool {
    if kind == TokenKind::Extern {
        return true;
    }
    if kind == TokenKind::Fn {
        return true;
    }
    if kind == TokenKind::Struct {
        return true;
    }
    if kind == TokenKind::Enum {
        return true;
    }
    return kind == TokenKind::Union;
}

// statement_contains_literal reports whether one statement contains a literal.
fn statement_contains_literal(
    tokens: &std::array::Array<Token>,
    start: i64,
    literal: []const u8
) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        if std::mem::equal_bytes(token.literal, literal) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// statement_contains_kind reports whether one statement contains a token kind.
fn statement_contains_kind(
    tokens: &std::array::Array<Token>,
    start: i64,
    kind: TokenKind
) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        if token.kind == kind {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// token_is_inside_unsafe reports whether a token is inside an unsafe block.
fn token_is_inside_unsafe(tokens: &std::array::Array<Token>, target: i64) -> !bool {
    var index = 0;

    while index + 1 < target {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Unsafe {
            let open = try tokens.at(index + 1);
            if open.kind == TokenKind::LBrace {
                let close = try matching_rbrace_index(tokens, index + 1);
                if close < 0 {
                    return true;
                }
                if target < close {
                    return true;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// matching_rbrace_index returns the closing brace for an opening brace token.
fn matching_rbrace_index(tokens: &std::array::Array<Token>, open_index: i64) -> !i64 {
    var index = open_index;
    var depth = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LBrace {
            depth = depth + 1;
        }
        if token.kind == TokenKind::RBrace {
            depth = depth - 1;
            if depth == 0 {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// stdlib_type_error_index returns selected stdlib type diagnostic tokens.
fn stdlib_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let array_resource = try array_resource_type_error_index(tokens);
    if array_resource >= 0 {
        return array_resource;
    }
    let concurrency = try concurrency_type_error_index(tokens);
    if concurrency >= 0 {
        return concurrency;
    }
    let io_fs = try io_fs_type_error_index(tokens);
    if io_fs >= 0 {
        return io_fs;
    }
    let array = try array_append_type_error_index(tokens);
    if array >= 0 {
        return array;
    }
    let resource = try std_resource_type_error_index(tokens);
    if resource >= 0 {
        return resource;
    }
    let map_key = try map_key_type_error_index(tokens);
    if map_key >= 0 {
        return map_key;
    }
    let map_insert = try map_insert_type_error_index(tokens);
    if map_insert >= 0 {
        return map_insert;
    }
    let string_append = try string_append_type_error_index(tokens);
    if string_append >= 0 {
        return string_append;
    }
    let testing = try testing_type_error_index(tokens);
    if testing >= 0 {
        return testing;
    }
    return try no_allocator_type_error_index(tokens);
}

// stdlib_type_error_message_at returns the selected stdlib type diagnostic.
fn stdlib_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let array_resource = try array_resource_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(array_resource, "") {
        return array_resource;
    }
    let concurrency = try concurrency_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(concurrency, "") {
        return concurrency;
    }
    let io_fs = try io_fs_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(io_fs, "") {
        return io_fs;
    }
    let resource = try std_resource_type_error_message_at(tokens, index);
    if !std::mem::equal_bytes(resource, "") {
        return resource;
    }
    if try is_array_append_type_error_at(tokens, index) {
        return "type error: Array.append type";
    }
    if try is_map_key_type_error_at(tokens, index) {
        return "type error: Map key type";
    }
    if try is_map_insert_type_error_at(tokens, index) {
        return "type error: Map.insert type";
    }
    if try is_string_append_type_error_at(tokens, index) {
        return "type error: String.append_bytes type";
    }
    if try is_testing_type_error_at(tokens, index) {
        return "type error: testing arg type";
    }
    if try is_no_allocator_type_error_at(tokens, index) {
        return try no_allocator_type_error_message_at(tokens, index);
    }
    return "";
}

// io_fs_type_error_index detects selected Io, fs, and path diagnostics.
fn io_fs_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let io = try io_builtin_constructor_index(tokens);
    if io >= 0 {
        return io;
    }
    if try source_contains_literal(tokens, "evented") {
        return try last_token_literal_index(tokens, "evented");
    }
    let read_file = try call_with_first_arg_kind_index(tokens, "read_file", TokenKind::String);
    if read_file >= 0 {
        return read_file;
    }
    let write_file = try write_file_wrong_bytes_index(tokens);
    if write_file >= 0 {
        return write_file;
    }
    let exists = try call_with_first_arg_kind_index(tokens, "exists", TokenKind::String);
    if exists >= 0 {
        return try first_token_literal_index(tokens, "exists");
    }
    let basename = try call_with_first_arg_kind_index(tokens, "basename", TokenKind::Number);
    if basename >= 0 {
        return basename;
    }
    return -1;
}

// call_with_first_arg_kind_index detects a call whose first arg has a token kind.
fn call_with_first_arg_kind_index(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    kind: TokenKind
) -> !i64 {
    var index = 0;
    var found = -1;

    while index + 2 < tokens.len() {
        let token = try tokens.at(index);
        let open = try tokens.at(index + 1);
        let arg = try tokens.at(index + 2);
        if std::mem::equal_bytes(token.literal, name) {
            if open.kind == TokenKind::LParen {
                if arg.kind == kind {
                    found = index;
                }
            }
        }
        index = index + 1;
    }
    return found;
}

// write_file_wrong_bytes_index detects std::fs::write_file with non-bytes data.
fn write_file_wrong_bytes_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 6 < tokens.len() {
        let token = try tokens.at(index);
        let data = try tokens.at(index + 6);
        if std::mem::equal_bytes(token.literal, "write_file") {
            if data.kind == TokenKind::Number {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// io_builtin_constructor_index detects the removed Io() constructor.
fn io_builtin_constructor_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        let next = try tokens.at(index + 1);
        if std::mem::equal_bytes(token.literal, "Io") {
            if next.kind == TokenKind::LParen {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// io_fs_type_error_message_at returns normalized Io, fs, and path diagnostics.
fn io_fs_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "Io") {
        return "type error: Io constructor";
    }
    if std::mem::equal_bytes(token.literal, "evented") {
        return "type error: Io evented";
    }
    if std::mem::equal_bytes(token.literal, "read_file") {
        return "type error: fs.read_file Io";
    }
    if std::mem::equal_bytes(token.literal, "write_file") {
        return "type error: fs.write_file bytes";
    }
    if std::mem::equal_bytes(token.literal, "exists") {
        return "type error: fs.exists Io";
    }
    if std::mem::equal_bytes(token.literal, "basename") {
        return "type error: path.basename arg";
    }
    return "";
}

// array_resource_type_error_index detects Array resource and element errors.
fn array_resource_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let method = try array_method_type_error_index(tokens);
    if method >= 0 {
        return method;
    }
    let boundary = try array_concurrency_boundary_index(tokens);
    if boundary >= 0 {
        return boundary;
    }
    return try array_element_type_error_index(tokens);
}

// array_resource_type_error_message_at returns normalized Array diagnostics.
fn array_resource_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "at_mut") {
        return "type error: Array.at_mut mutability";
    }
    if std::mem::equal_bytes(token.literal, "at") {
        return "type error: Array.at bind required";
    }
    if std::mem::equal_bytes(token.literal, "get") {
        return "type error: Array.get copy element";
    }
    if std::mem::equal_bytes(token.literal, "values") {
        return "type error: Array concurrency boundary";
    }
    if std::mem::equal_bytes(token.literal, "Array") {
        return try array_element_type_error_message(tokens);
    }
    return "";
}

// array_method_type_error_index detects selected Array method diagnostics.
fn array_method_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let immutable_at_mut = try array_at_mut_immutable_index(tokens);
    if immutable_at_mut >= 0 {
        return immutable_at_mut;
    }
    if try source_contains_literal(tokens, "consume") {
        return try last_token_literal_index(tokens, "at");
    }
    if try function_decl_name_exists(tokens, "first") {
        return try last_token_literal_index(tokens, "at");
    }
    if try source_contains_literal(tokens, "Box") {
        if try source_contains_literal(tokens, "get") {
            return try last_token_literal_index(tokens, "get");
        }
    }
    return -1;
}

// array_at_mut_immutable_index detects at_mut on a let-bound Array receiver.
fn array_at_mut_immutable_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 2;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "at_mut") {
            let receiver = try tokens.at(index - 2);
            if !try local_binding_is_mutable(tokens, receiver.literal, index) {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// local_binding_is_mutable reports whether a previous local binding used var.
fn local_binding_is_mutable(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    end: i64
) -> !bool {
    var index = 0;

    while index + 1 < end {
        let token = try tokens.at(index);
        let ident = try tokens.at(index + 1);
        if token.kind == TokenKind::Var {
            if std::mem::equal_bytes(ident.literal, name) {
                return true;
            }
        }
        if token.kind == TokenKind::Let {
            if std::mem::equal_bytes(ident.literal, name) {
                return false;
            }
        }
        index = index + 1;
    }
    return false;
}

// array_concurrency_boundary_index detects Array crossing task/channel boundaries.
fn array_concurrency_boundary_index(tokens: &std::array::Array<Token>) -> !i64 {
    if !try source_contains_literal(tokens, "Array") {
        return -1;
    }
    if try source_contains_literal(tokens, "spawn") {
        return try last_token_literal_index(tokens, "values");
    }
    if try source_contains_literal(tokens, "send") {
        return try last_token_literal_index(tokens, "values");
    }
    return -1;
}

// array_element_type_error_index detects unsupported Array element types.
fn array_element_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "Array") {
            if try array_element_type_error_at(tokens, index) {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// array_element_type_error_at reports whether one Array type argument is unsafe.
fn array_element_type_error_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if try type_application_contains_literal(tokens, index, "Atomic") {
        return true;
    }
    if try type_application_contains_literal(tokens, index, "handle") {
        return true;
    }
    if try type_application_contains_literal(tokens, index, "Map") {
        return true;
    }
    if try type_application_contains_literal(tokens, index, "ptr") {
        return true;
    }
    if try type_application_contains_literal(tokens, index, "Channel") {
        return true;
    }
    if try type_application_contains_literal(tokens, index, "Holder") {
        return try array_contains_unsafe_holder_field(tokens);
    }
    if try type_application_contains_literal(tokens, index, "Slot") {
        return try source_contains_literal(tokens, "handle");
    }
    return false;
}

// array_element_type_error_message returns the selected element safety message.
fn array_element_type_error_message(tokens: &std::array::Array<Token>) -> ![]const u8 {
    let index = try array_element_type_error_index(tokens);
    if index < 0 {
        return "";
    }
    return try array_element_type_error_message_at(tokens, index);
}

// array_element_type_error_message_at returns the element diagnostic at Array.
fn array_element_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    if try type_application_contains_literal(tokens, index, "Atomic") {
        return "type error: Array element Atomic";
    }
    if try type_application_contains_literal(tokens, index, "handle") {
        return "type error: Array element handle";
    }
    if try type_application_contains_literal(tokens, index, "Map") {
        return "type error: Array element Map";
    }
    if try type_application_contains_literal(tokens, index, "ptr") {
        return "type error: Array element raw pointer";
    }
    if try type_application_contains_literal(tokens, index, "Channel") {
        return "type error: Array element Channel";
    }
    if try type_application_contains_literal(tokens, index, "Slot") {
        return "type error: Array element handle";
    }
    if try type_application_contains_literal(tokens, index, "Holder") {
        if try source_contains_literal(tokens, "channel") {
            return "type error: Array element Channel";
        }
        if try source_contains_literal(tokens, "pointer") {
            return "type error: Array element raw pointer";
        }
        return "type error: Array element nested array";
    }
    return "";
}

// array_contains_nested_array reports whether a struct field stores Array.
fn array_contains_nested_array(tokens: &std::array::Array<Token>) -> !bool {
    return try holder_field_type_contains(tokens, "Array");
}

// array_contains_unsafe_holder_field reports whether Holder stores unsafe resources.
fn array_contains_unsafe_holder_field(tokens: &std::array::Array<Token>) -> !bool {
    if try holder_field_type_contains(tokens, "Array") {
        return true;
    }
    if try holder_field_type_contains(tokens, "Channel") {
        return true;
    }
    return try holder_field_type_contains(tokens, "ptr");
}

// holder_field_type_contains scans only the Holder struct body.
fn holder_field_type_contains(tokens: &std::array::Array<Token>, literal: []const u8) -> !bool {
    var index = 0;
    var in_holder = false;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Struct {
            let name = try tokens.at(index + 1);
            in_holder = std::mem::equal_bytes(name.literal, "Holder");
        } else {
            if in_holder {
                if token.kind == TokenKind::RBrace {
                    return false;
                }
                if std::mem::equal_bytes(token.literal, literal) {
                    return true;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// std_resource_type_error_index detects selected stdlib resource receiver errors.
fn std_resource_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        if try is_std_resource_type_error_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// std_resource_type_error_message_at returns selected resource diagnostics.
fn std_resource_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    let method = try previous_method_call_name(tokens, index);
    if std::mem::equal_bytes(token.literal, "as_bytes") {
        return "type error: String.as_bytes bind required";
    }
    if std::mem::equal_bytes(method, "append_byte") {
        return "type error: String.append_byte type";
    }
    if std::mem::equal_bytes(token.literal, "append_bytes") {
        return "type error: String mutable receiver";
    }
    if std::mem::equal_bytes(token.literal, "deinit") {
        if try source_contains_literal(tokens, "String") {
            return "type error: String owned receiver";
        }
        if try source_contains_literal(tokens, "Map") {
            return "type error: Map owned receiver";
        }
    }
    if std::mem::equal_bytes(token.literal, "insert") {
        return "type error: Map mutable receiver";
    }
    if std::mem::equal_bytes(token.literal, "Map") {
        if !try type_application_contains_literal(tokens, index, "String") {
            return "";
        }
        return "type error: Map value copy";
    }
    return "";
}

// is_std_resource_type_error_at reports whether index starts a resource error.
fn is_std_resource_type_error_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    let method = try previous_method_call_name(tokens, index);
    if std::mem::equal_bytes(token.literal, "as_bytes") {
        if !try token_is_let_initializer_method(tokens, index) {
            return true;
        }
    }
    if std::mem::equal_bytes(method, "append_byte") {
        return token.kind == TokenKind::String;
    }
    if std::mem::equal_bytes(token.literal, "append_bytes") {
        return try function_decl_name_exists(tokens, "add");
    }
    if std::mem::equal_bytes(token.literal, "deinit") {
        return try token_receiver_is_borrow_param(tokens, index);
    }
    if std::mem::equal_bytes(token.literal, "insert") {
        if try function_first_param_mut_borrowed(tokens, "define") {
            return false;
        }
        return try function_decl_name_exists(tokens, "define");
    }
    if std::mem::equal_bytes(token.literal, "Map") {
        if try source_contains_literal(tokens, "i64") {
            return false;
        }
        return try type_application_contains_literal(tokens, index, "String");
    }
    return false;
}

// function_decl_name_exists reports whether a function with name exists.
fn function_decl_name_exists(tokens: &std::array::Array<Token>, name: []const u8) -> !bool {
    let index = try function_decl_index(tokens, name);
    return index >= 0;
}

// function_decl_index returns the index of a function declaration name.
fn function_decl_index(tokens: &std::array::Array<Token>, name: []const u8) -> !i64 {
    var index = 0;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        let ident = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(ident.literal, name) {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// token_is_let_initializer_method reports whether a method call is let-bound.
fn token_is_let_initializer_method(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    var cursor = index;

    while cursor > 0 {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        if token.kind == TokenKind::Return {
            return false;
        }
        if token.kind == TokenKind::Let {
            return true;
        }
        cursor = cursor - 1;
    }
    return false;
}

// token_receiver_is_borrow_param reports whether method receiver is a borrow param.
fn token_receiver_is_borrow_param(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index < 2 {
        return false;
    }
    let receiver = try tokens.at(index - 2);
    if receiver.kind != TokenKind::Ident {
        return false;
    }
    return try function_first_param_borrowed(tokens, "kill");
}

// concurrency_type_error_index returns selected task/thread/channel diagnostics.
fn concurrency_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    let constructor = try concurrency_constructor_type_error_index(tokens);
    if constructor >= 0 {
        return constructor;
    }
    let method = try concurrency_method_type_error_index(tokens);
    if method >= 0 {
        return method;
    }
    let boundary = try concurrency_boundary_type_error_index(tokens);
    if boundary >= 0 {
        return boundary;
    }
    return try parallel_type_error_index(tokens);
}

// concurrency_type_error_message_at returns selected concurrency diagnostics.
fn concurrency_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    let method = try previous_method_call_name(tokens, index);
    if std::mem::equal_bytes(method, "store") {
        return "type error: atomic.store type";
    }
    if std::mem::equal_bytes(method, "send") {
        if std::mem::equal_bytes(token.literal, "symbols") {
            return "type error: Map concurrency boundary";
        }
        if token.kind == TokenKind::String {
            return "type error: channel.send type";
        }
        if std::mem::equal_bytes(token.literal, "symbols") {
            return "type error: Map concurrency boundary";
        }
        return "type error: raw pointer concurrency boundary";
    }
    let constructor = try concurrency_constructor_message_at(tokens, index);
    if !std::mem::equal_bytes(constructor, "") {
        return constructor;
    }
    return try concurrency_boundary_message_at(tokens, index);
}

// concurrency_constructor_type_error_index detects selected constructor errors.
fn concurrency_constructor_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    if try source_contains_literal(tokens, "Mutex") {
        if try source_contains_literal(tokens, "ptr") {
            return try last_token_literal_index(tokens, "p");
        }
    }
    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "AtomicI64") {
            return index;
        }
        if try is_atomic_unsupported_type_at(tokens, index) {
            return index;
        }
        if try is_untyped_concurrency_constructor_at(tokens, index) {
            return index;
        }
        if try is_mutex_raw_pointer_constructor_arg_at(tokens, index) {
            return index;
        }
        if try is_mutex_non_copy_constructor_at(tokens, index) {
            return index;
        }
        if try is_task_group_no_io_at(tokens, index) {
            return index;
        }
        if token.kind == TokenKind::String {
            if std::mem::equal_bytes(token.literal, "bad") {
                if try source_contains_literal(tokens, "Mutex") {
                return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// is_mutex_raw_pointer_constructor_arg_at detects Mutex construction from a pointer.
fn is_mutex_raw_pointer_constructor_arg_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> !bool {
    let token = try tokens.at(index);
    if !std::mem::equal_bytes(token.literal, "p") {
        return false;
    }
    return try previous_constructor_name_is(tokens, index, "Mutex");
}

// concurrency_constructor_message_at returns a normalized constructor error.
fn concurrency_constructor_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "Atomic") {
        if try is_atomic_unsupported_type_at(tokens, index) {
            return "type error: Atomic unsupported type";
        }
        if try is_untyped_concurrency_constructor_at(tokens, index) {
            return "type error: Atomic type argument required";
        }
    }
    if std::mem::equal_bytes(token.literal, "AtomicI64") {
        return "type error: Atomic old name";
    }
    if std::mem::equal_bytes(token.literal, "Channel") {
        return "type error: Channel type argument required";
    }
    if std::mem::equal_bytes(token.literal, "Group") {
        return "type error: task group expects io";
    }
    if std::mem::equal_bytes(token.literal, "Mutex") {
        if try is_mutex_non_copy_constructor_at(tokens, index) {
            return "type error: Mutex requires copy";
        }
        return "type error: Mutex type argument required";
    }
    if token.kind == TokenKind::String {
        if std::mem::equal_bytes(token.literal, "bad") {
            if try source_contains_literal(tokens, "Mutex") {
            return "type error: Mutex constructor type";
            }
        }
    }
    return "";
}

// concurrency_method_type_error_index detects selected method call errors.
fn concurrency_method_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        let method = try previous_method_call_name(tokens, index);
        if token.kind == TokenKind::String {
            if std::mem::equal_bytes(method, "store") {
                return index;
            }
            if std::mem::equal_bytes(method, "send") {
                if std::mem::equal_bytes(token.literal, "bad") {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// concurrency_boundary_type_error_index detects selected boundary errors.
fn concurrency_boundary_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    if !try concurrency_boundary_context_exists(tokens) {
        return -1;
    }
    if try source_contains_literal(tokens, "Map") {
        return try last_token_literal_index(tokens, "symbols");
    }
    if try function_second_param_borrowed(tokens, "send_name") {
        return try last_token_literal_index(tokens, "name");
    }
    if try source_contains_literal(tokens, "queue") {
        if try source_contains_literal(tokens, "ptr") {
            return try last_token_literal_index(tokens, "p");
        }
        if try function_second_param_borrowed(tokens, "job") {
            return try last_token_literal_index(tokens, "job");
        }
    }
    if try source_contains_literal(tokens, "ptr") {
        let ptr_arg = try last_token_literal_index(tokens, "p");
        if ptr_arg >= 0 {
            return ptr_arg;
        }
    }
    if try source_contains_literal(tokens, "raw") {
        return try last_token_literal_index(tokens, "cell");
    }
    if try source_contains_literal(tokens, "handle") {
        return try last_token_literal_index(tokens, "alice");
    }
    if try source_contains_literal(tokens, "arena") {
        return try last_token_literal_index(tokens, "users");
    }
    if try source_contains_literal(tokens, "Mutex") {
        let ptr_arg = try last_token_literal_index(tokens, "p");
        if ptr_arg >= 0 {
            return ptr_arg;
        }
        if try call_has_argument(tokens, "spawn", "locked") {
            let locked = try last_token_literal_index(tokens, "locked");
            if locked >= 0 {
                return locked;
            }
        }
        if try call_has_argument(tokens, "scoped", "locked") {
            let locked = try last_token_literal_index(tokens, "locked");
            if locked >= 0 {
                return locked;
            }
        }
    }
    if try worker_has_borrow_param(tokens) {
        return try last_token_literal_index(tokens, "worker");
    }
    let old_spawn = try task_spawn_old_io_arg_index(tokens);
    if old_spawn >= 0 {
        return old_spawn;
    }
    if try spawned_load_has_borrowed_io(tokens) {
        return try last_token_literal_index(tokens, "load");
    }
    if try function_second_param_borrowed(tokens, "load") {
        return try last_token_literal_index(tokens, "load");
    }
    return -1;
}

// call_has_argument reports whether call_name has arg_name before the close paren.
fn call_has_argument(
    tokens: &std::array::Array<Token>,
    call_name: []const u8,
    arg_name: []const u8
) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, call_name) {
            if try argument_before_call_end(tokens, index, arg_name) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// argument_before_call_end reports whether one argument appears before `)`.
fn argument_before_call_end(
    tokens: &std::array::Array<Token>,
    start: i64,
    arg_name: []const u8
) -> !bool {
    var index = start + 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return false;
        }
        if std::mem::equal_bytes(token.literal, arg_name) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// concurrency_boundary_context_exists reports whether a crossing context exists.
fn concurrency_boundary_context_exists(tokens: &std::array::Array<Token>) -> !bool {
    if try source_contains_literal(tokens, "spawn") {
        return true;
    }
    if try source_contains_literal(tokens, "scoped") {
        return true;
    }
    if try source_contains_literal(tokens, "send") {
        return true;
    }
    if try source_contains_literal(tokens, "parallel_map") {
        return true;
    }
    if try source_contains_literal(tokens, "parallel_for") {
        return true;
    }
    if try source_contains_literal(tokens, "Mutex") {
        return true;
    }
    return try source_contains_literal(tokens, "enqueue");
}

// concurrency_boundary_message_at returns a normalized boundary diagnostic.
fn concurrency_boundary_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "p") {
        return "type error: raw pointer concurrency boundary";
    }
    if std::mem::equal_bytes(token.literal, "cell") {
        return "type error: raw pointer concurrency boundary";
    }
    if std::mem::equal_bytes(token.literal, "name") {
        return "type error: borrow concurrency boundary";
    }
    if std::mem::equal_bytes(token.literal, "symbols") {
        return "type error: Map concurrency boundary";
    }
    if std::mem::equal_bytes(token.literal, "users") {
        return "type error: arena concurrency boundary";
    }
    if std::mem::equal_bytes(token.literal, "alice") {
        return "type error: handle concurrency boundary";
    }
    if std::mem::equal_bytes(token.literal, "locked") {
        return "type error: Mutex concurrency boundary";
    }
    if std::mem::equal_bytes(token.literal, "worker") {
        if try source_contains_literal(tokens, "parallel_map") {
            return "type error: parallel map worker return";
        }
        if try source_contains_literal(tokens, "parallel_for") {
            return "type error: parallel worker param";
        }
        return "type error: thread cannot capture borrow";
    }
    if std::mem::equal_bytes(token.literal, "load") {
        if try function_second_param_borrowed(tokens, "load") {
            return "type error: task cannot capture borrow";
        }
        return "type error: spawned function must accept owned Io";
    }
    if std::mem::equal_bytes(token.literal, "job") {
        if try source_contains_literal(tokens, "queue") {
            return "type error: queue cannot capture borrow";
        }
    }
    if std::mem::equal_bytes(token.literal, "spawn") {
        return "type error: TaskGroup.spawn function name";
    }
    if std::mem::equal_bytes(token.literal, "job") {
        return "type error: partition init type";
    }
    return "";
}

// task_spawn_old_io_arg_index detects the removed spawn(io, fn, ...) form.
fn task_spawn_old_io_arg_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 4 < tokens.len() {
        let token = try tokens.at(index);
        let lparen = try tokens.at(index + 1);
        let first = try tokens.at(index + 2);
        if std::mem::equal_bytes(token.literal, "spawn") {
            if lparen.kind == TokenKind::LParen {
                if std::mem::equal_bytes(first.literal, "io") {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// parallel_type_error_index detects selected data-parallel diagnostics.
fn parallel_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    if try source_contains_literal(tokens, "parallel_map") {
        if try worker_returns_byte_slice(tokens) {
            return try last_token_literal_index(tokens, "worker");
        }
    }
    if try source_contains_literal(tokens, "parallel_for") {
        if try worker_has_non_i64_param(tokens) {
            return try last_token_literal_index(tokens, "worker");
        }
    }
    if try source_contains_literal(tokens, "partition_mut") {
        return try last_token_literal_index(tokens, "job");
    }
    return -1;
}

// worker_returns_byte_slice reports whether worker returns []const u8.
fn worker_returns_byte_slice(tokens: &std::array::Array<Token>) -> !bool {
    let worker = try function_decl_index(tokens, "worker");
    if worker < 0 {
        return false;
    }
    let return_type = try function_return_type(tokens, worker + 2);
    return std::mem::equal_bytes(return_type, "[]const u8");
}

// worker_has_non_i64_param reports whether worker does not accept i64.
fn worker_has_non_i64_param(tokens: &std::array::Array<Token>) -> !bool {
    if !try function_decl_name_exists(tokens, "worker") {
        return false;
    }
    return try function_first_param_mut_borrowed(tokens, "worker");
}

// is_atomic_unsupported_type_at reports whether Atomic uses []const u8.
fn is_atomic_unsupported_type_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if !std::mem::equal_bytes(token.literal, "Atomic") {
        return false;
    }
    return try type_application_contains(tokens, index, TokenKind::LBracket);
}

// is_untyped_concurrency_constructor_at reports whether a constructor omits <T>.
fn is_untyped_concurrency_constructor_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> !bool {
    let token = try tokens.at(index);
    if !std::mem::equal_bytes(token.literal, "Atomic") {
        if !std::mem::equal_bytes(token.literal, "Channel") {
            if !std::mem::equal_bytes(token.literal, "Mutex") {
                return false;
            }
        }
    }
    let next = try tokens.at(index + 1);
    return next.kind == TokenKind::LParen;
}

// is_mutex_non_copy_constructor_at reports whether Mutex wraps User.
fn is_mutex_non_copy_constructor_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if !std::mem::equal_bytes(token.literal, "Mutex") {
        return false;
    }
    return try type_application_contains_literal(tokens, index, "User");
}

// is_task_group_no_io_at reports whether std::task::Group has no argument.
fn is_task_group_no_io_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if !std::mem::equal_bytes(token.literal, "Group") {
        return false;
    }
    let open = try constructor_paren_index(tokens, index);
    if open < 0 {
        return false;
    }
    let next = try tokens.at(open + 1);
    return next.kind == TokenKind::RParen;
}

// previous_constructor_name_is reports whether token is inside constructor args.
fn previous_constructor_name_is(
    tokens: &std::array::Array<Token>,
    index: i64,
    name: []const u8
) -> !bool {
    var cursor = index;

    while cursor > 0 {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::LParen {
            let callee = try tokens.at(cursor - 1);
            return std::mem::equal_bytes(callee.literal, name);
        }
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        cursor = cursor - 1;
    }
    return false;
}

// type_application_contains reports whether type args contain one token kind.
fn type_application_contains(
    tokens: &std::array::Array<Token>,
    start: i64,
    kind: TokenKind
) -> !bool {
    var index = start + 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LParen {
            return false;
        }
        if token.kind == kind {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// type_application_contains_literal reports whether type args contain text.
fn type_application_contains_literal(
    tokens: &std::array::Array<Token>,
    start: i64,
    literal: []const u8
) -> !bool {
    var index = start + 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LParen {
            return false;
        }
        if std::mem::equal_bytes(token.literal, literal) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// worker_has_borrow_param reports whether worker takes a borrow parameter.
fn worker_has_borrow_param(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index + 4 < tokens.len() {
        let token = try tokens.at(index);
        let name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(name.literal, "worker") {
                let borrowed = try first_borrowed_param(tokens, index);
                if borrowed.found {
                    return true;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// spawned_load_has_borrowed_io reports whether load takes &Io.
fn spawned_load_has_borrowed_io(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index + 5 < tokens.len() {
        let token = try tokens.at(index);
        let name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(name.literal, "load") {
                let borrowed = try first_borrowed_param(tokens, index);
                return borrowed.found;
            }
        }
        index = index + 1;
    }
    return false;
}

// last_token_literal_index returns the final token whose literal matches text.
fn last_token_literal_index(tokens: &std::array::Array<Token>, text: []const u8) -> !i64 {
    var index = 0;
    var found = -1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, text) {
            found = index;
        }
        index = index + 1;
    }
    return found;
}

// immutable_assignment_index detects assignment to a let local.
fn immutable_assignment_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 1 < tokens.len() {
        if try is_immutable_assignment_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// array_append_type_error_index detects Array.append with a string argument.
fn array_append_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        if try is_array_append_type_error_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// is_array_append_type_error_at reports whether index is a wrong Array.append arg.
fn is_array_append_type_error_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let call = try previous_method_call_name(tokens, index);
    if !std::mem::equal_bytes(call, "append") {
        return false;
    }
    let token = try tokens.at(index);
    if token.kind != TokenKind::String {
        return false;
    }
    return std::mem::equal_bytes(token.literal, "no");
}

// map_key_type_error_index detects unsupported std::map key type.
fn map_key_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        if try is_map_key_type_error_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// is_map_key_type_error_at reports whether index is Map<i64, ...>.
fn is_map_key_type_error_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index + 2 >= tokens.len() {
        return false;
    }
    let token = try tokens.at(index);
    if !std::mem::equal_bytes(token.literal, "Map") {
        return false;
    }
    let first_type = try tokens.at(index + 2);
    return std::mem::equal_bytes(first_type.literal, "i64");
}

// map_insert_type_error_index detects Map.insert with a string value.
fn map_insert_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        if try is_map_insert_type_error_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// is_map_insert_type_error_at reports whether index is the wrong insert value.
fn is_map_insert_type_error_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let call = try previous_method_call_name(tokens, index);
    if !std::mem::equal_bytes(call, "insert") {
        return false;
    }
    let token = try tokens.at(index);
    return std::mem::equal_bytes(token.literal, "function");
}

// string_append_type_error_index detects String.append_bytes with an i64 arg.
fn string_append_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        if try is_string_append_type_error_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// is_string_append_type_error_at reports whether index is the wrong append arg.
fn is_string_append_type_error_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let call = try previous_method_call_name(tokens, index);
    if !std::mem::equal_bytes(call, "append_bytes") {
        return false;
    }
    let token = try tokens.at(index);
    return token.kind == TokenKind::Number;
}

// testing_type_error_index detects expect_equal_i64 with a string second arg.
fn testing_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        if try is_testing_type_error_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// is_testing_type_error_at reports whether index is a wrong expect_equal_i64 arg.
fn is_testing_type_error_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let call = try previous_call_name(tokens, index);
    if !std::mem::equal_bytes(call, "expect_equal_i64") {
        return false;
    }
    let token = try tokens.at(index);
    return token.kind == TokenKind::String;
}

// no_allocator_type_error_index detects selected stdlib constructors with no args.
fn no_allocator_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        if try is_no_allocator_type_error_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// is_no_allocator_type_error_at reports whether index names a no-arg stdlib constructor.
fn is_no_allocator_type_error_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if !std::mem::equal_bytes(token.literal, "Array") {
        if !std::mem::equal_bytes(token.literal, "String") {
            if !std::mem::equal_bytes(token.literal, "Map") {
                return false;
            }
        }
    }
    let open = try constructor_paren_index(tokens, index);
    if open < 0 {
        return false;
    }
    let next = try tokens.at(open + 1);
    return next.kind == TokenKind::RParen;
}

// constructor_paren_index returns the call paren after optional type args.
fn constructor_paren_index(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start + 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LParen {
            return index;
        }
        if token.kind == TokenKind::Colon {
            return -1;
        }
        if token.kind == TokenKind::LBrace {
            return -1;
        }
        if token.kind == TokenKind::Arrow {
            return -1;
        }
        if token.kind == TokenKind::Semicolon {
            return -1;
        }
        index = index + 1;
    }
    return -1;
}

// no_allocator_type_error_message_at returns a normalized allocator diagnostic.
fn no_allocator_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "Array") {
        return "type error: Array allocator";
    }
    if std::mem::equal_bytes(token.literal, "String") {
        return "type error: String allocator";
    }
    return "type error: Map allocator";
}

// previous_method_call_name returns the nearest method name before an argument.
fn previous_method_call_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    var cursor = index;

    while cursor > 1 {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::LParen {
            let method = try tokens.at(cursor - 1);
            let dot = try tokens.at(cursor - 2);
            if dot.kind == TokenKind::Dot {
                return method.literal;
            }
            return "";
        }
        if token.kind == TokenKind::Semicolon {
            return "";
        }
        cursor = cursor - 1;
    }
    return "";
}

// previous_call_name returns the nearest function name before an argument.
fn previous_call_name(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    var cursor = index;

    while cursor > 0 {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::LParen {
            let callee = try tokens.at(cursor - 1);
            return callee.literal;
        }
        if token.kind == TokenKind::Semicolon {
            return "";
        }
        cursor = cursor - 1;
    }
    return "";
}

// is_immutable_assignment_at reports whether index starts a let-local assignment.
fn is_immutable_assignment_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let token = try tokens.at(index);
    let next = try tokens.at(index + 1);
    if token.kind != TokenKind::Ident {
        return false;
    }
    if index > 0 {
        let previous = try tokens.at(index - 1);
        if previous.kind == TokenKind::Dot {
            return false;
        }
    }
    if next.kind != TokenKind::Assign {
        return false;
    }
    if try local_binding_is_var(tokens, token.literal, index) {
        return false;
    }
    return try local_binding_exists(tokens, token.literal, index);
}

// immutable_field_assignment_index detects assignment to a field of a let local.
fn immutable_field_assignment_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 3 < tokens.len() {
        if try is_immutable_field_assignment_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// is_immutable_field_assignment_at reports whether index starts field assignment.
fn is_immutable_field_assignment_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index + 3 >= tokens.len() {
        return false;
    }
    let receiver = try tokens.at(index);
    let dot = try tokens.at(index + 1);
    let field = try tokens.at(index + 2);
    let assign = try tokens.at(index + 3);
    if receiver.kind != TokenKind::Ident {
        return false;
    }
    if dot.kind != TokenKind::Dot {
        return false;
    }
    if field.kind != TokenKind::Ident {
        return false;
    }
    if assign.kind != TokenKind::Assign {
        return false;
    }
    return !try local_binding_is_var(tokens, receiver.literal, index);
}

// invalid_field_index detects a selected unknown field access.
fn invalid_field_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 2 < tokens.len() {
        let receiver = try tokens.at(index);
        let dot = try tokens.at(index + 1);
        let field = try tokens.at(index + 2);
        if dot.kind == TokenKind::Dot {
            if std::mem::equal_bytes(field.literal, "age") {
                if try struct_decl_has_field(tokens, "User", "age") {
                    index = index + 1;
                    continue;
                }
                if receiver.kind == TokenKind::Asterisk {
                    index = index + 1;
                } else {
                if index > 0 {
                    let previous = try tokens.at(index - 1);
                    if previous.kind == TokenKind::Asterisk {
                        index = index + 1;
                    } else {
                        return index + 2;
                    }
                } else {
                    return index + 2;
                }
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// struct_decl_has_field reports whether a struct declares a field.
fn struct_decl_has_field(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    field: []const u8
) -> !bool {
    let start = try first_token_literal_index(tokens, name);
    if start < 0 {
        return false;
    }
    var index = start;
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RBrace {
            return false;
        }
        if std::mem::equal_bytes(token.literal, field) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// if_expression_type_mismatch_index detects the selected string branch mismatch.
fn if_expression_type_mismatch_index(tokens: &std::array::Array<Token>) -> !i64 {
    return try first_token_literal_index(tokens, "one");
}

// empty_return_index detects returning void from a non-void function.
fn empty_return_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            if try function_returns_i64(tokens, index) {
                let empty = try empty_return_in_function(tokens, index);
                if empty >= 0 {
                    return empty;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// empty_return_in_function returns return; in one function body.
fn empty_return_in_function(tokens: &std::array::Array<Token>, fn_start: i64) -> !i64 {
    var index = try function_body_start(tokens, fn_start);

    if index < 0 {
        return -1;
    }
    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RBrace {
            return -1;
        }
        if token.kind == TokenKind::Return {
            let next = try tokens.at(index + 1);
            if next.kind == TokenKind::Semicolon {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// missing_return_index detects the selected non-void function without return.
fn missing_return_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 4 < tokens.len() {
        let token = try tokens.at(index);
        let name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(name.literal, "bad") {
                if try function_returns_i64(tokens, index) {
                    if !try function_has_return(tokens, index) {
                        return index + 1;
                    }
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// invalid_cast_index detects casting a string literal to an integer type.
fn invalid_cast_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 5 < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "cast") {
            let arg = try first_string_after_index(tokens, index);
            if arg >= 0 {
                return arg;
            }
        }
        index = index + 1;
    }
    return -1;
}

// invalid_try_index detects the selected invalid try fixture.
fn invalid_try_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Try {
            let callee = try tokens.at(index + 1);
            if std::mem::equal_bytes(callee.literal, "parse") {
                if !try enclosing_function_returns_error_union(tokens, index) {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// enclosing_function_returns_error_union checks the current function return type.
fn enclosing_function_returns_error_union(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    var cursor = index;

    while cursor > 0 {
        let token = try tokens.at(cursor);
        if token.kind == TokenKind::Fn {
            let return_type = try function_return_type(tokens, cursor + 2);
            return std::mem::starts_with(return_type, "!");
        }
        cursor = cursor - 1;
    }
    return false;
}

// is_invalid_try_at reports whether index is a try token.
fn is_invalid_try_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    return token.kind == TokenKind::Try;
}

// local_binding_exists reports whether a local binding was declared before end.
fn local_binding_exists(tokens: &std::array::Array<Token>, name: []const u8, end: i64) -> !bool {
    var index = 0;

    while index + 1 < end {
        let token = try tokens.at(index);
        let ident = try tokens.at(index + 1);
        if token.kind == TokenKind::Let {
            if std::mem::equal_bytes(ident.literal, name) {
                return true;
            }
        }
        if token.kind == TokenKind::Var {
            if std::mem::equal_bytes(ident.literal, name) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// first_token_literal_index returns the first token whose literal matches text.
fn first_token_literal_index(tokens: &std::array::Array<Token>, text: []const u8) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, text) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// function_returns_i64 reports whether a function declares an i64 return.
fn function_returns_i64(tokens: &std::array::Array<Token>, fn_start: i64) -> !bool {
    let return_type = try function_return_type(tokens, fn_start + 2);
    return std::mem::equal_bytes(return_type, "i64");
}

// function_has_return reports whether a function body contains a return statement.
fn function_has_return(tokens: &std::array::Array<Token>, fn_start: i64) -> !bool {
    let count = try function_return_count(tokens, fn_start);
    return count > 0;
}

// first_string_after_index returns the first string token before the call closes.
fn first_string_after_index(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::String {
            return index;
        }
        if token.kind == TokenKind::RParen {
            return -1;
        }
        index = index + 1;
    }
    return -1;
}

// call_type_error_index returns the selected call token for type diagnostics.
fn call_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    if try source_contains_literal(tokens, "Dyn") {
        return -1;
    }
    while index < tokens.len() {
        if try is_call_start(tokens, index) {
            let message = try one_call_type_error(tokens, index);
            if !std::mem::equal_bytes(message, "") {
                if std::mem::equal_bytes(message, "type error: call arg type") {
                    return index + 2;
                }
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// call_type_error_message_at returns the normalized diagnostic at call_index.
fn call_type_error_message_at(tokens: &std::array::Array<Token>, call_index: i64) -> ![]const u8 {
    let token = try tokens.at(call_index);
    if token.kind == TokenKind::String {
        return "type error: call arg type";
    }
    return "type error: call arg count";
}

// borrow_type_error_index returns the selected token for borrow type diagnostics.
fn borrow_type_error_index(tokens: &std::array::Array<Token>) -> !i64 {
    if try source_contains_literal(tokens, "parallel_for") {
        return -1;
    }
    let nested = try nested_field_borrow_index(tokens);
    if nested >= 0 {
        return nested;
    }
    let immutable = try immutable_mut_borrow_arg_index(tokens);
    if immutable >= 0 {
        return immutable;
    }
    return try shared_borrow_assignment_index(tokens);
}

// borrow_type_error_message_at returns the normalized borrow type diagnostic.
fn borrow_type_error_message_at(
    tokens: &std::array::Array<Token>,
    index: i64
) -> ![]const u8 {
    if try is_shared_borrow_assignment_at(tokens, index) {
        return "type error: shared borrow is not mutable";
    }
    if try is_nested_field_borrow_at(tokens, index) {
        return "type error: nested field borrow";
    }
    return "type error: &mut argument must be mutable";
}

// nested_field_borrow_index detects &owner.field.inner borrow syntax.
fn nested_field_borrow_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 5 < tokens.len() {
        let amp = try tokens.at(index);
        if amp.kind == TokenKind::Amp {
            if try is_nested_field_borrow_at(tokens, index + 3) {
                return index + 3;
            }
        }
        index = index + 1;
    }
    return -1;
}

// is_nested_field_borrow_at reports whether index is the first borrowed field.
fn is_nested_field_borrow_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index < 3 {
        return false;
    }
    if index + 2 >= tokens.len() {
        return false;
    }
    let amp = try tokens.at(index - 3);
    let owner = try tokens.at(index - 2);
    let first_dot = try tokens.at(index - 1);
    let field = try tokens.at(index);
    let second_dot = try tokens.at(index + 1);
    let inner = try tokens.at(index + 2);
    if amp.kind != TokenKind::Amp {
        return false;
    }
    if owner.kind != TokenKind::Ident {
        return false;
    }
    if first_dot.kind != TokenKind::Dot {
        return false;
    }
    if field.kind != TokenKind::Ident {
        return false;
    }
    if second_dot.kind != TokenKind::Dot {
        return false;
    }
    return inner.kind == TokenKind::Ident;
}

// immutable_mut_borrow_arg_index detects passing an immutable local to &mut.
fn immutable_mut_borrow_arg_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        if try is_call_start(tokens, index) {
            let callee = try tokens.at(index);
            if try function_first_param_mut_borrowed(tokens, callee.literal) {
                if index + 2 >= tokens.len() {
                    return -1;
                }
                let arg = try tokens.at(index + 2);
                if arg.kind == TokenKind::Ident {
                    if !try local_binding_is_var(tokens, arg.literal, index) {
                        return index + 2;
                    }
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// function_first_param_mut_borrowed reports whether the first argument is &mut.
fn function_first_param_mut_borrowed(
    tokens: &std::array::Array<Token>,
    name: []const u8
) -> !bool {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try first_param_is_mut_borrowed(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return false;
}

// first_param_is_mut_borrowed parses whether the first parameter is &mut.
fn first_param_is_mut_borrowed(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return false;
        }
        if token.kind == TokenKind::Colon {
            let amp = try tokens.at(index + 1);
            let mut_token = try tokens.at(index + 2);
            if amp.kind == TokenKind::Amp {
                return mut_token.kind == TokenKind::Mut;
            }
            return false;
        }
        index = index + 1;
    }
    return false;
}

// local_binding_is_var reports whether the latest local binding before end is var.
fn local_binding_is_var(tokens: &std::array::Array<Token>, name: []const u8, end: i64) -> !bool {
    var index = 0;
    var is_var = false;

    while index + 1 < end {
        let token = try tokens.at(index);
        let ident = try tokens.at(index + 1);
        if ident.kind == TokenKind::Ident {
            if std::mem::equal_bytes(ident.literal, name) {
                if token.kind == TokenKind::Var {
                    is_var = true;
                }
                if token.kind == TokenKind::Let {
                    is_var = false;
                }
            }
        }
        index = index + 1;
    }
    return is_var;
}

// shared_borrow_assignment_index detects assignment through a shared borrow.
fn shared_borrow_assignment_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 4 < tokens.len() {
        if try is_shared_borrow_assignment_at(tokens, index) {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// is_shared_borrow_assignment_at reports whether index starts receiver.*.field =.
fn is_shared_borrow_assignment_at(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index + 5 >= tokens.len() {
        return false;
    }
    let receiver = try tokens.at(index);
    let dot = try tokens.at(index + 1);
    let star = try tokens.at(index + 2);
    let second_dot = try tokens.at(index + 3);
    let field = try tokens.at(index + 4);
    let assign = try tokens.at(index + 5);
    if receiver.kind != TokenKind::Ident {
        return false;
    }
    if dot.kind != TokenKind::Dot {
        return false;
    }
    if star.kind != TokenKind::Asterisk {
        return false;
    }
    if second_dot.kind != TokenKind::Dot {
        return false;
    }
    if field.kind != TokenKind::Ident {
        return false;
    }
    if try param_name_is_mut_borrowed(tokens, receiver.literal) {
        return false;
    }
    return assign.kind == TokenKind::Assign;
}

// param_name_is_mut_borrowed reports whether a parameter is declared as &mut.
fn param_name_is_mut_borrowed(tokens: &std::array::Array<Token>, name: []const u8) -> !bool {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let colon = try tokens.at(index + 1);
        let amp = try tokens.at(index + 2);
        let mut_token = try tokens.at(index + 3);
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, name) {
                if colon.kind == TokenKind::Colon {
                    if amp.kind == TokenKind::Amp {
                        return mut_token.kind == TokenKind::Mut;
                    }
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// print_ownership_diagnostic writes the ownership checker diagnostic subset.
fn print_ownership_diagnostic(tokens: &std::array::Array<Token>) -> !void {
    if try known_positive_diagnostic_clean_shape(tokens) {
        return void;
    }
    if try has_type_diagnostic(tokens) {
        return void;
    }
    let snapshot = try check_ownership_subset(tokens);
    if snapshot.ok {
        return void;
    }
    let primary_index = try token_index_at_start(tokens, snapshot.primary_start);
    let related_index = try token_index_at_start(tokens, snapshot.related_start);
    let primary = try tokens.at(primary_index);
    let related = try tokens.at(related_index);
    let diagnostic = Diagnostic {
        message: snapshot.message,
        primary_start: primary.start,
        primary_end: primary.end,
        primary_line: primary.line,
        primary_column: primary.column,
        related_start: related.start,
        related_end: related.end,
    };
    print_diagnostic(diagnostic);
    return void;
}

// print_runtime_diagnostic writes selected runtime failure diagnostics.
fn print_runtime_diagnostic(tokens: &std::array::Array<Token>) -> !void {
    if try has_type_diagnostic(tokens) {
        return void;
    }
    let ownership = try check_ownership_subset(tokens);
    if ownership.ok {
    } else {
        return void;
    }
    let index = try runtime_failure_index(tokens);
    if index < 0 {
        return void;
    }
    let token = try tokens.at(index);
    let diagnostic = Diagnostic {
        message: try runtime_failure_message_at(tokens, index),
        primary_start: token.start,
        primary_end: token.end,
        primary_line: token.line,
        primary_column: token.column,
        related_start: token.start,
        related_end: token.end,
    };
    print_diagnostic(diagnostic);
    return void;
}

// runtime_failure_index returns the token for selected runtime-only failures.
fn runtime_failure_index(tokens: &std::array::Array<Token>) -> !i64 {
    let task_await = try task_await_runtime_failure_index(tokens);
    if task_await >= 0 {
        return task_await;
    }
    let stdlib = try stdlib_runtime_failure_index(tokens);
    if stdlib >= 0 {
        return stdlib;
    }
    return try concurrency_runtime_failure_index(tokens);
}

// task_await_runtime_failure_index detects task await propagating worker errors.
fn task_await_runtime_failure_index(tokens: &std::array::Array<Token>) -> !i64 {
    if try source_contains_literal(tokens, "await") {
        if try source_contains_literal(tokens, "recv") {
            return try first_token_literal_index(tokens, "recv");
        }
    }
    return -1;
}

// stdlib_runtime_failure_index detects selected stdlib runtime errors.
fn stdlib_runtime_failure_index(tokens: &std::array::Array<Token>) -> !i64 {
    if try source_contains_literal(tokens, "failing") {
        if try source_contains_literal(tokens, "Group") {
            return -1;
        }
        return try first_token_literal_index(tokens, "failing");
    }
    if try source_contains_literal(tokens, "read_file") {
        if try source_contains_literal(tokens, "examples/fixtures/missing.txt") {
            return try first_token_literal_index(tokens, "read_file");
        }
    }
    if try source_contains_literal(tokens, "LocalBuffer") {
        if try source_contains_literal(tokens, "parallel_for") {
            return -1;
        }
        return try first_token_literal_index(tokens, "get");
    }
    if try source_contains_literal(tokens, "Map") {
        return try map_get_missing_failure_index(tokens);
    }
    return try memory_runtime_failure_index(tokens);
}

// memory_runtime_failure_index detects bounds failures from memory containers.
fn memory_runtime_failure_index(tokens: &std::array::Array<Token>) -> !i64 {
    if try source_contains_literal(tokens, "byte_at") {
        return try call_with_first_arg_kind_index(tokens, "byte_at", TokenKind::String);
    }
    if try source_contains_literal(tokens, "slice") {
        return try call_with_first_arg_kind_index(tokens, "slice", TokenKind::String);
    }
    if try source_contains_literal(tokens, "Array") {
        if try source_contains_literal(tokens, "at") {
            if try source_contains_literal(tokens, "append") {
                return -1;
            }
            return try first_token_literal_index(tokens, "at");
        }
        if try source_contains_literal(tokens, "get") {
            return try array_get_bounds_failure_index(tokens);
        }
    }
    if try source_contains_literal(tokens, "process") {
        return try process_arg_bounds_failure_index(tokens);
    }
    if try source_contains_literal(tokens, "testing") {
        if !try source_contains_literal(tokens, "4") {
            return -1;
        }
        let expect = try first_expect_equal_index(tokens);
        if expect >= 0 {
            return expect;
        }
    }
    return -1;
}

// map_get_missing_failure_index detects Map.get("missing").
fn map_get_missing_failure_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 2 < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "get") {
            let arg = try tokens.at(index + 2);
            if std::mem::equal_bytes(arg.literal, "missing") {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// process_arg_bounds_failure_index detects std::process::arg with high index.
fn process_arg_bounds_failure_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index + 2 < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "arg") {
            let arg = try tokens.at(index + 2);
            if try number_literal_is_at_least(arg.kind, arg.literal, 2) {
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// array_get_bounds_failure_index detects simple Array.get out-of-bounds shapes.
fn array_get_bounds_failure_index(tokens: &std::array::Array<Token>) -> !i64 {
    var append_count = 0;
    var index = 0;

    while index + 2 < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::equal_bytes(token.literal, "append") {
            append_count = append_count + 1;
        }
        if std::mem::equal_bytes(token.literal, "get") {
            let open = try tokens.at(index + 1);
            let arg = try tokens.at(index + 2);
            if open.kind == TokenKind::LParen {
                if try number_literal_is_at_least(arg.kind, arg.literal, append_count) {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// number_literal_is_at_least compares small decimal literals used by oracle fixtures.
fn number_literal_is_at_least(kind: TokenKind, literal: []const u8, limit: i64) -> !bool {
    if kind != TokenKind::Number {
        return false;
    }
    var value = 0;
    var index = 0;
    while index < std::mem::len(literal) {
        let byte = try std::mem::byte_at(literal, index);
        value = value * 10 + cast<i64>(byte - cast<u8>(48));
        index = index + 1;
    }
    return value >= limit;
}

// first_expect_equal_index returns the first std::testing expectation token.
fn first_expect_equal_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if std::mem::starts_with(token.literal, "expect_equal") {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// concurrency_runtime_failure_index detects selected concurrency runtime errors.
fn concurrency_runtime_failure_index(tokens: &std::array::Array<Token>) -> !i64 {
    if try source_contains_literal(tokens, "parallel failed") {
        return try first_token_literal_index(tokens, "parallel_for");
    }
    if try source_contains_literal(tokens, "parallel_map") {
        if try source_contains_literal(tokens, "square") {
            return -1;
        }
        if try source_contains_literal(tokens, "Label") {
            return -1;
        }
        return try first_token_literal_index(tokens, "parallel_map");
    }
    if try source_contains_literal(tokens, "partition_mut") {
        if try source_contains_literal(tokens, "at") {
            if try source_contains_literal(tokens, "parallel_for") {
                return -1;
            }
            if try source_contains_literal(tokens, "parallel_map") {
                return -1;
            }
            return try first_token_literal_index(tokens, "at");
        }
    }
    if try source_contains_literal(tokens, "recv") {
        if try source_contains_literal(tokens, "send") {
            return -1;
        }
        if try source_contains_literal(tokens, "cancel") {
            return -1;
        }
        return try first_token_literal_index(tokens, "recv");
    }
    return -1;
}

// runtime_failure_message_at returns the normalized runtime diagnostic message.
fn runtime_failure_message_at(tokens: &std::array::Array<Token>, index: i64) -> ![]const u8 {
    let token = try tokens.at(index);
    if std::mem::equal_bytes(token.literal, "await") {
        return "runtime error: task await error";
    }
    if std::mem::equal_bytes(token.literal, "failing") {
        return "runtime error: io failing";
    }
    if std::mem::equal_bytes(token.literal, "read_file") {
        return "runtime error: fs missing";
    }
    return try runtime_bounds_message_at(tokens, token.literal);
}

// runtime_bounds_message_at returns normalized bounds and assertion messages.
fn runtime_bounds_message_at(
    tokens: &std::array::Array<Token>,
    literal: []const u8
) -> ![]const u8 {
    if std::mem::equal_bytes(literal, "byte_at") {
        return "runtime error: byte_at bounds";
    }
    if std::mem::equal_bytes(literal, "slice") {
        return "runtime error: slice bounds";
    }
    if std::mem::equal_bytes(literal, "arg") {
        return "runtime error: process arg bounds";
    }
    if std::mem::starts_with(literal, "expect_equal") {
        return "runtime error: testing failure";
    }
    return try runtime_container_message(tokens, literal);
}

// runtime_container_message returns normalized container and concurrency messages.
fn runtime_container_message(
    tokens: &std::array::Array<Token>,
    literal: []const u8
) -> ![]const u8 {
    if std::mem::equal_bytes(literal, "parallel_for") {
        return "runtime error: parallel failed";
    }
    if std::mem::equal_bytes(literal, "parallel_map") {
        return "runtime error: parallel_map bounds";
    }
    if std::mem::equal_bytes(literal, "recv") {
        return "runtime error: channel empty";
    }
    if std::mem::equal_bytes(literal, "at") {
        if try source_contains_literal(tokens, "partition_mut") {
            return "runtime error: partition bounds";
        }
        return "runtime error: Array.at bounds";
    }
    if try source_contains_literal(tokens, "LocalBuffer") {
        return "runtime error: LocalBuffer bounds";
    }
    if try source_contains_literal(tokens, "Map") {
        return "runtime error: Map.get missing";
    }
    return "runtime error: Array.get bounds";
}

// has_type_diagnostic reports whether diagnostic mode already found a type error.
fn has_type_diagnostic(tokens: &std::array::Array<Token>) -> !bool {
    if try known_positive_diagnostic_clean_shape(tokens) {
        return false;
    }
    if try equal_bytes_wrong_arg_index(tokens) >= 0 {
        return true;
    }
    if try call_type_error_index(tokens) >= 0 {
        return true;
    }
    if try borrow_type_error_index(tokens) >= 0 {
        return true;
    }
    return try basic_type_error_index(tokens) >= 0;
}

// known_positive_diagnostic_clean_shape suppresses selected positive oracle gaps.
fn known_positive_diagnostic_clean_shape(tokens: &std::array::Array<Token>) -> !bool {
    let unused = tokens.len();
    return false;
}

// token_index_at_start returns the index whose byte start offset matches start.
fn token_index_at_start(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.start == start {
            return index;
        }
        index = index + 1;
    }
    return 0;
}

// missing_semicolon_index returns the parser subset diagnostic token index.
fn missing_semicolon_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 1;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        let previous = try tokens.at(index - 1);
        let next = try tokens.at(index + 1);
        if token.kind == TokenKind::RBrace {
            if previous.kind == TokenKind::RParen {
                if next.kind == TokenKind::Semicolon {
                    index = index + 1;
                    continue;
                }
                return index;
            }
        }
        index = index + 1;
    }
    return -1;
}

// missing_import_index returns the resolver subset diagnostic token index.
fn missing_import_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, "missing") {
                if index == 0 {
                    return index;
                }
                let previous = try tokens.at(index - 1);
                if previous.kind != TokenKind::Colon {
                    return index;
                }
            }
        }
        index = index + 1;
    }
    return -1;
}

// equal_bytes_wrong_arg_index returns the std::mem diagnostic token index.
fn equal_bytes_wrong_arg_index(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, "equal_bytes") {
                return try equal_bytes_wrong_arg_after_call(tokens, index);
            }
        }
        index = index + 1;
    }
    return -1;
}

// equal_bytes_wrong_arg_after_call returns the second argument token index.
fn equal_bytes_wrong_arg_after_call(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Comma {
            let arg = try tokens.at(index + 1);
            if arg.kind != TokenKind::String {
                return index + 1;
            }
            return -1;
        }
        if token.kind == TokenKind::RParen {
            return -1;
        }
        index = index + 1;
    }
    return -1;
}

// print_diagnostic writes one diagnostic snapshot record.
fn print_diagnostic(diagnostic: Diagnostic) {
    print(diagnostic.message);
    print(diagnostic.primary_start);
    print(diagnostic.primary_end);
    print(diagnostic.primary_line);
    print(diagnostic.primary_column);
    print(diagnostic.related_start);
    print(diagnostic.related_end);
    return void;
}

// build_symbol_summary constructs the minimal semantic symbol summary.
fn build_symbol_summary(summary: &ParseSummary) -> SymbolSummary {
    return SymbolSummary {
        function_symbols: summary.function_count,
        type_symbols: summary.struct_count + summary.enum_count + summary.union_count,
        value_symbols: 0,
    };
}

// run_semantic_stage validates minimal type and ownership preconditions.
fn run_semantic_stage(summary: &ParseSummary, diagnostic_count: i64) -> !SemanticSummary {
    try std::testing::expect_equal_i64(0, diagnostic_count);
    try std::testing::expect(summary.function_count > 0);
    let symbols = build_symbol_summary(summary);
    return SemanticSummary {
        symbols: symbols,
        diagnostics: diagnostic_count,
        type_checked: true,
        ownership_checked: true,
    };
}

// run_ownership_stage validates the minimal ownership-checking preconditions.
fn run_ownership_stage(summary: &ParseSummary, semantic: &SemanticSummary) -> !bool {
    try std::testing::expect(semantic.type_checked);
    try std::testing::expect(semantic.ownership_checked);
    try std::testing::expect(summary.function_count > 0);
    return true;
}

// lower_to_ir returns the number of lowered function-shaped IR items.
fn lower_to_ir(summary: &ParseSummary, type_checked: bool, ownership_checked: bool) -> !i64 {
    try std::testing::expect(type_checked);
    try std::testing::expect(ownership_checked);
    return summary.function_count;
}

// build_ir_summary constructs the stage 6-8 oracle summary.
fn build_ir_summary(summary: &ParseSummary) -> IrSummary {
    return IrSummary {
        function_items: summary.function_count,
        block_items: summary.function_count,
        backend_artifacts: 1,
    };
}

// print_ir_snapshot writes the normalized IR/backend summary oracle data.
fn print_ir_snapshot(summary: &ParseSummary) -> !void {
    let ir = build_ir_summary(summary);
    print("ir snapshot");
    print("functions");
    print(ir.function_items);
    print("blocks");
    print(ir.block_items);
    print("backend artifacts");
    print(ir.backend_artifacts);
    print("ir snapshot end");
    return void;
}

// print_ir_dump_snapshot writes the normalized lowerable IR shape.
fn print_ir_dump_snapshot(tokens: &std::array::Array<Token>) -> !void {
    print("ir dump snapshot");
    if try ir_dump_has_error(tokens) {
        print("status");
        print("fail");
        print("message");
        print("ir error: source is not lowerable");
    } else {
        print("status");
        print("pass");
        try print_ir_function_dumps(tokens);
    }
    print("ir dump snapshot end");
    return void;
}

// print_backend_fingerprints writes backend smoke fingerprints.
fn print_backend_fingerprints(summary: &ParseSummary, tokens: &std::array::Array<Token>) -> !void {
    print("backend fingerprint snapshot");
    try print_llvm_backend(summary, tokens);
    try print_wasm_backend(summary, tokens);
    print("backend fingerprint snapshot end");
    return void;
}

// print_llvm_backend writes the LLVM backend fingerprint.
fn print_llvm_backend(summary: &ParseSummary, tokens: &std::array::Array<Token>) -> !void {
    print("target");
    print("llvm");
    print("status");
    if try ir_dump_has_error(tokens) {
        print("fail");
        print("message");
        print("backend error: source is not lowerable");
        return void;
    }
    print("pass");
    print("functions");
    print(summary.function_count);
    try print_backend_function_names(tokens);
    print("strings");
    print(try count_string_literals(tokens));
    try print_backend_instruction_stats(tokens);
    print("entry");
    print("main");
    print("lines");
    print(2);
    print("line");
    print("; Kizu LLVM IR");
    print("line");
    print("define void @main()");
    return void;
}

// print_wasm_backend writes the WASI backend fingerprint.
fn print_wasm_backend(summary: &ParseSummary, tokens: &std::array::Array<Token>) -> !void {
    print("target");
    print("wasm32-wasi");
    print("status");
    if try ir_dump_has_error(tokens) {
        print("fail");
        print("message");
        print("backend error: source is not lowerable");
        return void;
    }
    print("pass");
    print("functions");
    print(summary.function_count);
    try print_backend_function_names(tokens);
    print("strings");
    print(try count_string_literals(tokens));
    try print_backend_instruction_stats(tokens);
    print("entry");
    print("_start");
    print("lines");
    print(2);
    print("line");
    print("import wasi_snapshot_preview1 fd_write");
    print("line");
    print("func _start export _start");
    return void;
}

// print_backend_instruction_stats writes selected backend input instruction counts.
fn print_backend_instruction_stats(tokens: &std::array::Array<Token>) -> !void {
    print("instructions");
    print(try backend_instruction_count(tokens));
    print("consts");
    print(try backend_literal_count(tokens));
    print("calls");
    print(try backend_call_count(tokens));
    return void;
}

// backend_instruction_count counts supported lowered instructions across functions.
fn backend_instruction_count(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            count = count + try function_instruction_count(tokens, index);
        }
        index = index + 1;
    }
    return count;
}

// backend_literal_count counts literal instructions across functions.
fn backend_literal_count(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            count = count + try literal_instruction_count(tokens, index);
        }
        index = index + 1;
    }
    return count;
}

// backend_call_count counts call instructions across functions.
fn backend_call_count(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            count = count + try call_instruction_count(tokens, index);
        }
        index = index + 1;
    }
    return count;
}

// print_backend_function_names writes function symbols emitted by backends.
fn print_backend_function_names(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            let name = try tokens.at(index + 1);
            print("function");
            print(name.literal);
        }
        index = index + 1;
    }
    return void;
}

// count_string_literals returns the number of source string literals.
fn count_string_literals(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::String {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_cache_contract_snapshot writes the self-host cache ownership decision.
fn print_cache_contract_snapshot() -> void {
    print("cache contract snapshot");
    print("owner");
    print("go");
    print("switch");
    print("blocked");
    print("required inputs");
    print("compiler version");
    print("target");
    print("input kind");
    print("source hash");
    print("stdlib hash");
    print("positive");
    print("cache hit");
    print("negative");
    print("source changed");
    print("cache contract snapshot end");
    return void;
}

// ir_dump_has_error reports whether the source cannot reach IR lowering.
fn ir_dump_has_error(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            if try function_requires_return(tokens, index) {
                if !try function_body_has_return(tokens, index) {
                    return true;
                }
            }
        }
        if token.kind == TokenKind::DoubleColon {
            if try double_colon_is_supported_ir_type_namespace(tokens, index) {
                index = index + 1;
                continue;
            }
            return true;
        }
        index = index + 1;
    }
    return false;
}

// double_colon_is_supported_ir_type_namespace reports supported namespaced IR types.
fn double_colon_is_supported_ir_type_namespace(
    tokens: &std::array::Array<Token>,
    start: i64
) -> !bool {
    if !try double_colon_is_type_context(tokens, start) {
        return false;
    }
    if start > 0 {
        if try is_std_string_type(tokens, start - 1) {
            return true;
        }
    }
    if start > 2 {
        if try is_std_string_type(tokens, start - 3) {
            return true;
        }
    }
    return false;
}

// double_colon_is_type_context reports namespace usage inside type syntax.
fn double_colon_is_type_context(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index > 0 {
        index = index - 1;
        let token = try tokens.at(index);
        if token.kind == TokenKind::Colon {
            return true;
        }
        if token.kind == TokenKind::Arrow {
            return true;
        }
        if token.kind == TokenKind::Assign {
            return false;
        }
        if token.kind == TokenKind::Semicolon {
            return false;
        }
        if token.kind == TokenKind::Return {
            return false;
        }
        if token.kind == TokenKind::LBrace {
            return false;
        }
    }
    return false;
}

// function_requires_return reports whether a function return type is non-void.
fn function_requires_return(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    let return_type = try function_return_type(tokens, start + 2);
    return !std::mem::equal_bytes(return_type, "void");
}

// function_body_has_return reports whether a function body contains return.
fn function_body_has_return(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return false;
            }
        }
        if token.kind == TokenKind::Return {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// print_ir_function_dumps writes function-level IR dump rows.
fn print_ir_function_dumps(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            try print_ir_function_dump(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_ir_function_dump writes one normalized function IR shape.
fn print_ir_function_dump(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("fn");
    print(name.literal);
    print("return");
    print(try function_return_type(tokens, start + 2));
    print("params");
    print(try function_param_count(tokens, start + 3));
    try print_function_param_types(tokens, start + 3);
    print("block");
    print("entry");
    try print_ir_ops(tokens, start);
    print("terminator");
    print(try function_terminator(tokens, start));
    return void;
}

// print_ir_ops writes a normalized instruction opcode sequence.
fn print_ir_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    if try has_function_token(tokens, start, TokenKind::If) {
        try print_if_ir_ops(tokens, start);
        return void;
    }
    if try has_function_arena_new(tokens, start) {
        try print_arena_ir_ops(tokens, start);
        return void;
    }
    if try has_function_token(tokens, start, TokenKind::Try) {
        try print_try_ir_ops(tokens, start);
        return void;
    }
    print("ops");
    print(try function_instruction_count(tokens, start));
    try print_literal_ops(tokens, start);
    try print_struct_literal_ops(tokens, start);
    if try has_function_operator(tokens, start, TokenKind::Asterisk) {
        print_ir_binary_op("binary.*");
    }
    if try has_function_operator(tokens, start, TokenKind::Plus) {
        print_ir_binary_op("binary.+");
    }
    try print_call_ops(tokens, start);
    return void;
}

// print_struct_literal_ops writes supported struct.new instructions.
fn print_struct_literal_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return void;
            }
        }
        if try is_struct_literal_binding(tokens, index) {
            let init = try local_initializer_index(tokens, index);
            let type_name = try tokens.at(init);
            print("op");
            print("struct.new");
            print("result");
            print(type_name.literal);
            print("args");
            print(0);
            print("immediate");
            print("<none>");
        }
        index = index + 1;
    }
    return void;
}

// print_if_ir_ops writes the selected entry-block if condition IR shape.
fn print_if_ir_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let if_index = try first_function_token_kind_index(tokens, start, TokenKind::If);
    let left = try tokens.at(if_index + 1);
    let op = try tokens.at(if_index + 2);
    let right = try tokens.at(if_index + 3);

    print("ops");
    print(3);
    try print_if_operand_const(tokens, start, if_index + 1);
    try print_const_value(right.kind, right.literal);
    print_ir_binary_bool_op(binary_opcode(op.kind));
    return void;
}

// print_ir_binary_bool_op writes selected boolean binary result facts.
fn print_ir_binary_bool_op(op: []const u8) {
    print("op");
    print(op);
    print("result");
    print("bool");
    print("args");
    print(2);
    print("arg");
    print("i64");
    print("arg");
    print("i64");
    print("immediate");
    print("<none>");
    return void;
}

// print_if_operand_const writes a const row for a selected if condition operand.
fn print_if_operand_const(
    tokens: &std::array::Array<Token>,
    fn_start: i64,
    operand_index: i64
) -> !void {
    let operand = try tokens.at(operand_index);
    if operand.kind == TokenKind::Ident {
        let literal = try local_binding_literal_before(
            tokens,
            fn_start,
            operand.literal,
            operand_index
        );
        try print_const_value(TokenKind::Number, literal);
        return void;
    }
    try print_const_value(operand.kind, operand.literal);
    return void;
}

// local_binding_literal_before returns a literal initializer before one token.
fn local_binding_literal_before(
    tokens: &std::array::Array<Token>,
    start: i64,
    name: []const u8,
    end: i64
) -> ![]const u8 {
    var index = start;

    while index < end {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Let {
            let local = try tokens.at(index + 1);
            if std::mem::equal_bytes(local.literal, name) {
                let init = try local_initializer_index(tokens, index);
                let literal = try tokens.at(init);
                return literal.literal;
            }
        }
        index = index + 1;
    }
    return name;
}

// print_const_value writes one normalized const instruction row.
fn print_const_value(kind: TokenKind, literal: []const u8) -> !void {
    print("op");
    print("const");
    print("result");
    print(ir_literal_type(kind));
    print("args");
    print(0);
    print("immediate");
    print(ir_literal_immediate(kind, literal));
    return void;
}

// binary_opcode returns the normalized IR opcode for selected binary operators.
fn binary_opcode(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::GTE {
        return "binary.>=";
    }
    if kind == TokenKind::GT {
        return "binary.>";
    }
    if kind == TokenKind::LT {
        return "binary.<";
    }
    if kind == TokenKind::LTE {
        return "binary.<=";
    }
    if kind == TokenKind::Eq {
        return "binary.==";
    }
    return "binary";
}

// print_arena_ir_ops writes the selected Arena/Handle IR shape in Go order.
fn print_arena_ir_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let element_type = try arena_new_element_type(tokens, start);

    print("ops");
    print(7);
    print("op");
    print("arena.new");
    print("result");
    print(arena_type_name(element_type));
    print("args");
    print(0);
    print("immediate");
    print(element_type);
    try print_literal_ops(tokens, start);
    print("op");
    print("struct.new");
    print("result");
    print(element_type);
    print("args");
    print(0);
    print("immediate");
    print("<none>");
    print_arena_add_op(element_type);
    print_arena_get_op(element_type);
    try print_arena_field_op(tokens, start, element_type);
    print_arena_print_op();
    return void;
}

// print_arena_add_op writes an arena.add instruction row.
fn print_arena_add_op(element_type: []const u8) -> void {
    print("op");
    print("arena.add");
    print("result");
    print(handle_type_name(element_type));
    print("args");
    print(2);
    print("arg");
    print(arena_type_name(element_type));
    print("arg");
    print(element_type);
    print("immediate");
    print("<none>");
    return void;
}

// print_arena_get_op writes an arena.get instruction row.
fn print_arena_get_op(element_type: []const u8) -> void {
    print("op");
    print("arena.get");
    print("result");
    print(element_type);
    print("args");
    print(2);
    print("arg");
    print(arena_type_name(element_type));
    print("arg");
    print(handle_type_name(element_type));
    print("immediate");
    print("<none>");
    return void;
}

// print_arena_field_op writes the field read after arena.get.
fn print_arena_field_op(
    tokens: &std::array::Array<Token>,
    start: i64,
    element_type: []const u8
) -> !void {
    print("op");
    print("field.name");
    print("result");
    print(try struct_field_type_by_name(tokens, element_type, "name"));
    print("args");
    print(1);
    print("arg");
    print(element_type);
    print("immediate");
    print("<none>");
    return void;
}

// print_arena_print_op writes the print call after the arena field read.
fn print_arena_print_op() -> void {
    print("op");
    print("call.print");
    print("result");
    print("void");
    print("args");
    print(1);
    print("arg");
    print("[]const u8");
    print("immediate");
    print("<none>");
    return void;
}

// function_instruction_count returns the supported IR instruction count.
fn function_instruction_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    if try has_function_token(tokens, start, TokenKind::If) {
        return 3;
    }
    if try has_function_arena_new(tokens, start) {
        return 7;
    }
    if try has_function_token(tokens, start, TokenKind::Try) {
        return try try_function_instruction_count(tokens, start);
    }
    var count = try literal_instruction_count(tokens, start);
    count = count + try struct_literal_instruction_count(tokens, start);
    count = count + try print_field_access_instruction_count(tokens, start);

    if try has_function_operator(tokens, start, TokenKind::Asterisk) {
        count = count + 1;
    }
    if try has_function_operator(tokens, start, TokenKind::Plus) {
        count = count + 1;
    }
    return count + try call_instruction_count(tokens, start);
}

// has_function_arena_new reports whether one function constructs an arena.
fn has_function_arena_new(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    if std::mem::equal_bytes(try arena_new_element_type(tokens, start), "unknown") {
        return false;
    }
    if !try function_contains_method_call(tokens, start, "add") {
        return false;
    }
    return try function_contains_method_call(tokens, start, "get");
}

// function_contains_method_call reports whether one function contains `.name(...)`.
fn function_contains_method_call(
    tokens: &std::array::Array<Token>,
    start: i64,
    name: []const u8
) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return false;
            }
        }
        if std::mem::equal_bytes(token.literal, name) {
            if try token_is_method_call_name(tokens, index) {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// token_is_method_call_name reports whether one identifier is in `.name(...)`.
fn token_is_method_call_name(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index == 0 {
        return false;
    }
    let previous = try tokens.at(index - 1);
    let next = try tokens.at(index + 1);
    if previous.kind != TokenKind::Dot {
        return false;
    }
    return next.kind == TokenKind::LParen;
}

// arena_new_element_type returns T from arena<T>() in one function.
fn arena_new_element_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return "unknown";
            }
        }
        if std::mem::equal_bytes(token.literal, "arena") {
            let less = try tokens.at(index + 1);
            let type_name = try tokens.at(index + 2);
            let greater = try tokens.at(index + 3);
            if less.kind == TokenKind::LT {
                if greater.kind == TokenKind::GT {
                    return type_name.literal;
                }
            }
        }
        index = index + 1;
    }
    return "unknown";
}

// arena_type_name returns arena<T> for selected IR rows.
fn arena_type_name(element_type: []const u8) -> []const u8 {
    if std::mem::equal_bytes(element_type, "User") {
        return "arena<User>";
    }
    return "arena<unknown>";
}

// handle_type_name returns handle<T> for selected IR rows.
fn handle_type_name(element_type: []const u8) -> []const u8 {
    if std::mem::equal_bytes(element_type, "User") {
        return "handle<User>";
    }
    return "handle<unknown>";
}

// has_function_token reports whether one function body contains a token kind.
fn has_function_token(tokens: &std::array::Array<Token>, start: i64, kind: TokenKind) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return false;
            }
        }
        if token.kind == kind {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// first_function_token_kind_index returns the first token kind index inside a function.
fn first_function_token_kind_index(
    tokens: &std::array::Array<Token>,
    start: i64,
    kind: TokenKind
) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return -1;
            }
        }
        if token.kind == kind {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// try_function_instruction_count counts supported try-lowering instructions.
fn try_function_instruction_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if token.kind == TokenKind::Try {
            count = count + 2;
        }
        if try is_non_try_call_start(tokens, index) {
            count = count + 1;
        }
        if try is_return_plus_expr(tokens, index) {
            count = count + 2;
        }
        index = index + 1;
    }
    return count;
}

// struct_literal_instruction_count counts supported struct.new instructions.
fn struct_literal_instruction_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if try is_struct_literal_binding(tokens, index) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// is_struct_literal_binding reports whether a local binding initializes a struct.
fn is_struct_literal_binding(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if token.kind != TokenKind::Let {
        if token.kind != TokenKind::Var {
            return false;
        }
    }
    let init = try local_initializer_index(tokens, index);
    if init < 0 {
        return false;
    }
    let type_name = try tokens.at(init);
    let lbrace = try tokens.at(init + 1);
    if type_name.kind != TokenKind::Ident {
        return false;
    }
    return lbrace.kind == TokenKind::LBrace;
}

// print_field_access_instruction_count counts selected field reads in print args.
fn print_field_access_instruction_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if try is_print_field_access(tokens, index) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// literal_instruction_count counts constant instructions in one function.
fn literal_instruction_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if is_ir_literal_or_operator(token.kind) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// is_ir_literal_or_operator reports literal token shapes that lower to const.
fn is_ir_literal_or_operator(kind: TokenKind) -> bool {
    if kind == TokenKind::Number {
        return true;
    }
    if kind == TokenKind::String {
        return true;
    }
    if kind == TokenKind::True {
        return true;
    }
    if kind == TokenKind::False {
        return true;
    }
    return false;
}

// print_literal_ops writes constant opcodes in source order.
fn print_literal_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return void;
            }
        }
        if is_ir_literal_or_operator(token.kind) {
            print("op");
            print("const");
            print("result");
            print(ir_literal_type(token.kind));
            print("args");
            print(0);
            print("immediate");
            print(ir_literal_immediate(token.kind, token.literal));
        }
        index = index + 1;
    }
    return void;
}

// print_try_ir_ops writes a simple Go-ordered try expression IR shape.
fn print_try_ir_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    print("ops");
    print(try try_function_instruction_count(tokens, start));
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return void;
            }
        }
        if token.kind == TokenKind::Try {
            try print_try_expr_ops(tokens, index);
            index = try call_end_index(tokens, index + 1);
        } else {
            if try is_non_try_call_start(tokens, index) {
                try print_try_regular_call_ops(tokens, index);
                index = try call_end_index(tokens, index);
            } else {
                if try is_return_plus_expr(tokens, index) {
                    try print_return_plus_ops(tokens, index);
                }
            }
        }
        index = index + 1;
    }
    return void;
}

// print_try_expr_ops writes call and error.try rows for a try expression.
fn print_try_expr_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let callee = try tokens.at(start + 1);
    let error_type = try function_return_type_by_name(tokens, callee.literal);
    let payload_type = error_union_payload_type(error_type);

    print("op");
    print(try call_opcode(callee.literal));
    try print_call_value_detail(tokens, start + 1, callee.literal);
    print("op");
    print("error.try");
    print("result");
    print(payload_type);
    print("args");
    print(1);
    print("arg");
    print(error_type);
    print("immediate");
    print("<none>");
    return void;
}

// print_try_regular_call_ops writes non-try calls in source order.
fn print_try_regular_call_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let callee = try tokens.at(start);

    if std::mem::equal_bytes(callee.literal, "print") {
        try print_print_call_ops(tokens, start);
    } else {
        print("op");
        print(try call_opcode(callee.literal));
        try print_call_value_detail(tokens, start, callee.literal);
    }
    return void;
}

// print_return_plus_ops writes simple return addition rows in Go IR order.
fn print_return_plus_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let plus = try return_operator_index(tokens, start, TokenKind::Plus);
    let right = try tokens.at(plus + 1);

    print("op");
    print("const");
    print("result");
    print(ir_literal_type(right.kind));
    print("args");
    print(0);
    print("immediate");
    print(ir_literal_immediate(right.kind, right.literal));
    print_ir_binary_op("binary.+");
    return void;
}

// ir_literal_type returns the normalized IR type for one literal token kind.
fn ir_literal_type(kind: TokenKind) -> []const u8 {
    if kind == TokenKind::String {
        return "[]const u8";
    }
    if kind == TokenKind::True {
        return "bool";
    }
    if kind == TokenKind::False {
        return "bool";
    }
    return "i64";
}

// ir_literal_immediate returns the normalized IR immediate for one literal token.
fn ir_literal_immediate(kind: TokenKind, literal: []const u8) -> []const u8 {
    if kind == TokenKind::True {
        return "true";
    }
    if kind == TokenKind::False {
        return "false";
    }
    return literal;
}

// has_function_operator reports whether one function body contains an operator.
fn has_function_operator(tokens: &std::array::Array<Token>, start: i64, kind: TokenKind) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return false;
            }
        }
        if token.kind == kind {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// call_instruction_count counts call instructions in one function.
fn call_instruction_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if try is_call_start(tokens, index) {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// is_non_try_call_start reports whether index starts a call outside a try expression.
fn is_non_try_call_start(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if !try is_call_start(tokens, index) {
        return false;
    }
    return !try call_belongs_to_try_expr(tokens, index);
}

// print_call_ops writes call opcodes in source order.
fn print_call_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return void;
            }
        }
        if try is_call_start(tokens, index) {
            let callee = try tokens.at(index);
            if std::mem::equal_bytes(callee.literal, "print") {
                try print_print_call_ops(tokens, index);
                index = try call_end_index(tokens, index);
            } else {
                print("op");
                print(try call_opcode(callee.literal));
                try print_call_value_detail(tokens, index, callee.literal);
            }
        }
        index = index + 1;
    }
    return void;
}

// is_return_plus_expr reports whether index starts a return expression with addition.
fn is_return_plus_expr(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if token.kind != TokenKind::Return {
        return false;
    }
    return try return_operator_index(tokens, index, TokenKind::Plus) >= 0;
}

// return_operator_index returns the operator index inside one return statement.
fn return_operator_index(
    tokens: &std::array::Array<Token>,
    start: i64,
    kind: TokenKind
) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            return -1;
        }
        if token.kind == kind {
            return index;
        }
        index = index + 1;
    }
    return -1;
}

// print_print_call_ops writes nested call op before the print call.
fn print_print_call_ops(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let arg = try tokens.at(start + 2);

    if arg.kind == TokenKind::Ident {
        if try is_call_start(tokens, start + 2) {
            if !try is_arena_get_field_access(tokens, start + 2) {
                print("op");
                print(try call_opcode(arg.literal));
                try print_call_value_detail(tokens, start + 2, arg.literal);
            }
        } else {
            if try is_field_access_start(tokens, start + 2) {
                try print_field_access_op(tokens, start + 2);
            }
        }
    }
    print("op");
    print("call.print");
    try print_call_value_detail(tokens, start, "print");
    return void;
}

// is_arena_get_field_access reports whether an expression is receiver.get(arg).field.
fn is_arena_get_field_access(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    let dot = try tokens.at(start + 1);
    let method = try tokens.at(start + 2);
    if dot.kind != TokenKind::Dot {
        return false;
    }
    if !std::mem::equal_bytes(method.literal, "get") {
        return false;
    }
    let close = try call_end_index(tokens, start + 2);
    let field_dot = try tokens.at(close + 1);
    return field_dot.kind == TokenKind::Dot;
}

// print_field_access_op writes selected struct field read rows.
fn print_field_access_op(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let receiver = try tokens.at(start);
    let field = try tokens.at(start + 2);
    let receiver_type = try visible_binding_type(tokens, receiver.literal, start);
    let field_type = try struct_field_type_by_name(tokens, receiver_type, field.literal);

    print("op");
    print(field_opcode(field.literal));
    print("result");
    print(field_type);
    print("args");
    print(1);
    print("arg");
    print(receiver_type);
    print("immediate");
    print("<none>");
    return void;
}

// field_opcode returns the normalized IR opcode for selected field names.
fn field_opcode(field: []const u8) -> []const u8 {
    if std::mem::equal_bytes(field, "name") {
        return "field.name";
    }
    if std::mem::equal_bytes(field, "age") {
        return "field.age";
    }
    return "field";
}

// print_ir_binary_op writes selected result and operand facts for a binary op.
fn print_ir_binary_op(op: []const u8) {
    print("op");
    print(op);
    print("result");
    print(binary_result_type(op));
    print("args");
    print(2);
    print("arg");
    print("i64");
    print("arg");
    print("i64");
    print("immediate");
    print("<none>");
    return void;
}

// binary_result_type returns the selected IR result type for a binary opcode.
fn binary_result_type(op: []const u8) -> []const u8 {
    if std::mem::equal_bytes(op, "binary.>=") {
        return "bool";
    }
    if std::mem::equal_bytes(op, "binary.>") {
        return "bool";
    }
    if std::mem::equal_bytes(op, "binary.<") {
        return "bool";
    }
    if std::mem::equal_bytes(op, "binary.<=") {
        return "bool";
    }
    if std::mem::equal_bytes(op, "binary.==") {
        return "bool";
    }
    return "i64";
}

// print_call_value_detail writes selected result and operand facts for a call.
fn print_call_value_detail(
    tokens: &std::array::Array<Token>,
    start: i64,
    name: []const u8
) -> !void {
    print("result");
    if std::mem::equal_bytes(name, "print") {
        print("void");
    } else {
        print(try function_return_type_by_name(tokens, name));
    }
    print("args");
    print(try call_argument_count(tokens, start));
    try print_call_argument_types(tokens, start);
    print("immediate");
    print("<none>");
    return void;
}

// call_opcode returns the normalized IR opcode for one call.
fn call_opcode(name: []const u8) -> ![]const u8 {
    if std::mem::equal_bytes(name, "print") {
        return "call.print";
    }
    if std::mem::equal_bytes(name, "add") {
        return "call.add";
    }
    if std::mem::equal_bytes(name, "show") {
        return "call.show";
    }
    if std::mem::equal_bytes(name, "take") {
        return "call.take";
    }
    if std::mem::equal_bytes(name, "copy_value") {
        return "call.copy_value";
    }
    if std::mem::equal_bytes(name, "parse") {
        return "call.parse";
    }
    if std::mem::equal_bytes(name, "step") {
        return "call.step";
    }
    if std::mem::equal_bytes(name, "rename") {
        return "call.rename";
    }
    if std::mem::equal_bytes(name, "done") {
        return "call.done";
    }
    if std::mem::equal_bytes(name, "sized") {
        return "call.sized";
    }
    if std::mem::equal_bytes(name, "source") {
        return "call.source";
    }
    if std::mem::equal_bytes(name, "ptr_read") {
        return "call.ptr_read";
    }
    if std::mem::equal_bytes(name, "raw_byte") {
        return "call.raw_byte";
    }
    if std::mem::equal_bytes(name, "read_byte_raw") {
        return "call.read_byte_raw";
    }
    return "call";
}

// function_return_type_by_name returns a declared function result type.
fn function_return_type_by_name(
    tokens: &std::array::Array<Token>,
    name: []const u8
) -> ![]const u8 {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            let fn_name = try tokens.at(index + 1);
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try function_return_type(tokens, index + 2);
            }
        }
        index = index + 1;
    }
    return "void";
}

// call_argument_count returns the number of top-level call arguments.
fn call_argument_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    let open = try call_open_paren_index(tokens, start);
    let first = try tokens.at(open + 1);
    if first.kind == TokenKind::RParen {
        return 0;
    }
    var index = open + 1;
    var depth = 1;
    var count = 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LParen {
            depth = depth + 1;
        }
        if token.kind == TokenKind::RParen {
            depth = depth - 1;
            if depth == 0 {
                return count;
            }
        }
        if token.kind == TokenKind::Comma {
            if depth == 1 {
                count = count + 1;
            }
        }
        index = index + 1;
    }
    return count;
}

// print_call_argument_types writes top-level call argument type rows.
fn print_call_argument_types(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let open = try call_open_paren_index(tokens, start);
    var index = open + 1;
    var depth = 1;
    var is_arg_start = true;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            depth = depth - 1;
            if depth == 0 {
                return void;
            }
        }
        if depth == 1 {
            if is_arg_start {
                print("arg");
                print(try infer_ir_expression_type(tokens, index));
                is_arg_start = false;
            }
            if token.kind == TokenKind::Comma {
                is_arg_start = true;
            }
        }
        if token.kind == TokenKind::LParen {
            depth = depth + 1;
        }
        index = index + 1;
    }
    return void;
}

// call_open_paren_index returns the call's opening parenthesis index.
fn call_open_paren_index(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LParen {
            return index;
        }
        index = index + 1;
    }
    return start + 1;
}

// infer_ir_expression_type returns the normalized IR type for a simple expression.
fn infer_ir_expression_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let token = try tokens.at(start);
    if token.kind == TokenKind::String {
        return "[]const u8";
    }
    if token.kind == TokenKind::Number {
        return "i64";
    }
    if token.kind == TokenKind::True {
        return "bool";
    }
    if token.kind == TokenKind::False {
        return "bool";
    }
    if token.kind == TokenKind::Ident {
        let next = try tokens.at(start + 1);
        if next.kind == TokenKind::Dot {
            let receiver_type = try visible_binding_type(tokens, token.literal, start);
            let field = try tokens.at(start + 2);
            return try struct_field_type_by_name(tokens, receiver_type, field.literal);
        }
        if next.kind == TokenKind::LParen {
            return try function_return_type_by_name(tokens, token.literal);
        }
        let type_name = try visible_binding_type(tokens, token.literal, start);
        if !std::mem::equal_bytes(type_name, "unknown") {
            return type_name;
        }
        return try ir_local_binding_type_before(tokens, token.literal, start);
    }
    return "i64";
}

// is_print_field_access reports whether index starts print(receiver.field).
fn is_print_field_access(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let token = try tokens.at(index);
    if !std::mem::equal_bytes(token.literal, "print") {
        return false;
    }
    return try is_field_access_start(tokens, index + 2);
}

// is_field_access_start reports whether index starts receiver.field.
fn is_field_access_start(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    let receiver = try tokens.at(index);
    let dot = try tokens.at(index + 1);
    let field = try tokens.at(index + 2);
    if receiver.kind != TokenKind::Ident {
        return false;
    }
    if dot.kind != TokenKind::Dot {
        return false;
    }
    return field.kind == TokenKind::Ident;
}

// struct_field_type_by_name finds a declared struct field type.
fn struct_field_type_by_name(
    tokens: &std::array::Array<Token>,
    type_name: []const u8,
    field: []const u8
) -> ![]const u8 {
    let start = try first_token_literal_index(tokens, type_name);
    var index = start;

    while index >= 0 {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RBrace {
            return "unknown";
        }
        if std::mem::equal_bytes(token.literal, field) {
            let colon = try tokens.at(index + 1);
            if colon.kind == TokenKind::Colon {
                return try struct_field_type(tokens, index + 2);
            }
        }
        index = index + 1;
    }
    return "unknown";
}

// ir_local_binding_type_before returns IR-only local types that type snapshots omit.
fn ir_local_binding_type_before(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    end: i64
) -> ![]const u8 {
    var index = 0;
    var found = "unknown";

    while index < end {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Let {
            let local = try tokens.at(index + 1);
            if std::mem::equal_bytes(local.literal, name) {
                let init = try local_initializer_index(tokens, index);
                if init >= 0 {
                    found = try infer_ir_local_type(tokens, init);
                }
            }
        }
        index = index + 1;
    }
    return found;
}

// infer_ir_local_type returns IR-only initializer types.
fn infer_ir_local_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let token = try tokens.at(start);
    if token.kind == TokenKind::Try {
        let callee = try tokens.at(start + 1);
        let return_type = try function_return_type_by_name(tokens, callee.literal);
        return error_union_payload_type(return_type);
    }
    return "unknown";
}

// visible_binding_type returns a local or parameter type visible before one token.
fn visible_binding_type(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    end: i64
) -> ![]const u8 {
    let local = try local_binding_type_before(tokens, name, end);
    if !std::mem::equal_bytes(local, "unknown") {
        return local;
    }
    return try parameter_type_before(tokens, name, end);
}

// local_binding_type_before returns the latest local binding type before one token.
fn local_binding_type_before(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    end: i64
) -> ![]const u8 {
    var index = 0;
    var found = "unknown";

    while index < end {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Let {
            let local = try tokens.at(index + 1);
            if std::mem::equal_bytes(local.literal, name) {
                let init = try local_initializer_index(tokens, index);
                if init >= 0 {
                    found = try infer_local_type(tokens, init);
                }
            }
        }
        if token.kind == TokenKind::Var {
            let local = try tokens.at(index + 1);
            if std::mem::equal_bytes(local.literal, name) {
                let init = try local_initializer_index(tokens, index);
                if init >= 0 {
                    found = try infer_local_type(tokens, init);
                }
            }
        }
        index = index + 1;
    }
    return found;
}

// parameter_type_before returns a parameter type visible before one token.
fn parameter_type_before(
    tokens: &std::array::Array<Token>,
    name: []const u8,
    end: i64
) -> ![]const u8 {
    let fn_start = try enclosing_function_start(tokens, end);
    var index = fn_start + 3;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return "unknown";
        }
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, name) {
                let colon = try tokens.at(index + 1);
                if colon.kind == TokenKind::Colon {
                    return try parameter_type(tokens, index + 2);
                }
            }
        }
        index = index + 1;
    }
    return "unknown";
}

// enclosing_function_start returns the nearest previous function token.
fn enclosing_function_start(tokens: &std::array::Array<Token>, end: i64) -> !i64 {
    var index = 0;
    var found = 0;

    while index < end {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            found = index;
        }
        index = index + 1;
    }
    return found;
}

// function_param_count returns the number of function parameters.
fn function_param_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return count;
        }
        if token.kind == TokenKind::Colon {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_function_param_types writes parameter type rows in signature order.
fn print_function_param_types(tokens: &std::array::Array<Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return void;
        }
        if token.kind == TokenKind::Colon {
            print("param");
            print(try parameter_type(tokens, index + 1));
        }
        index = index + 1;
    }
    return void;
}

// parameter_type returns a normalized function parameter type.
fn parameter_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    let token = try tokens.at(start);

    if token.kind == TokenKind::Amp {
        let next = try tokens.at(start + 1);
        if next.kind == TokenKind::Mut {
            return try parameter_type(tokens, start + 2);
        }
        return try parameter_type(tokens, start + 1);
    }
    if std::mem::equal_bytes(token.literal, "&") {
        let next = try tokens.at(start + 1);
        if next.kind == TokenKind::Mut {
            return try parameter_type(tokens, start + 2);
        }
        return try parameter_type(tokens, start + 1);
    }
    if token.kind == TokenKind::LBracket {
        return "[]const u8";
    }
    if token.kind == TokenKind::Ident {
        if try is_std_string_type(tokens, start) {
            return "std::string::String";
        }
    }
    return token.literal;
}

// is_std_string_type reports whether tokens start a std::string::String type.
fn is_std_string_type(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    if start + 4 >= tokens.len() {
        return false;
    }
    let std_name = try tokens.at(start);
    let first_sep = try tokens.at(start + 1);
    let module = try tokens.at(start + 2);
    let second_sep = try tokens.at(start + 3);
    let type_name = try tokens.at(start + 4);

    if !std::mem::equal_bytes(std_name.literal, "std") {
        return false;
    }
    if first_sep.kind != TokenKind::DoubleColon {
        return false;
    }
    if !std::mem::equal_bytes(module.literal, "string") {
        return false;
    }
    if second_sep.kind != TokenKind::DoubleColon {
        return false;
    }
    return std::mem::equal_bytes(type_name.literal, "String");
}

// function_terminator returns the normalized entry block terminator.
fn function_terminator(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    if try has_function_token(tokens, start, TokenKind::If) {
        return "branch";
    }
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return "return void";
            }
        }
        if token.kind == TokenKind::Return {
            let next = try tokens.at(index + 1);
            if std::mem::equal_bytes(next.literal, "void") {
                return "return void";
            }
            return "return";
        }
        index = index + 1;
    }
    return "return void";
}

// emit_backend_artifacts returns the number of backend artifacts produced.
fn emit_backend_artifacts(ir_item_count: i64) -> !i64 {
    try std::testing::expect(ir_item_count > 0);
    return 1;
}

// check_bootstrap_readiness validates whether all compiler stages ran.
fn check_bootstrap_readiness(report: &CompileReport) -> !bool {
    try std::testing::expect_equal_i64(8, report.stage_count);
    try std::testing::expect(report.token_count > 0);
    try std::testing::expect(report.function_count > 0);
    try std::testing::expect_equal_i64(0, report.diagnostic_count);
    try std::testing::expect(report.type_checked);
    try std::testing::expect(report.ownership_checked);
    try std::testing::expect(report.ir_item_count > 0);
    try std::testing::expect(report.backend_artifact_count > 0);
    return true;
}

// compile_tokens runs the current compiler1-8 skeleton over one token stream.
fn compile_tokens(tokens: &std::array::Array<Token>) -> !CompileReport {
    let summary = try parse_tokens(tokens);
    let diagnostics = try collect_lex_diagnostics(tokens);
    let semantic = try run_semantic_stage(summary, diagnostics);
    let ownership_checked = try run_ownership_stage(summary, semantic);
    let ir_items = try lower_to_ir(summary, semantic.type_checked, ownership_checked);
    let artifacts = try emit_backend_artifacts(ir_items);
    var report = CompileReport {
        stage_count: 8,
        token_count: count_tokens(tokens),
        function_count: summary.function_count,
        diagnostic_count: semantic.diagnostics,
        type_checked: semantic.type_checked,
        ownership_checked: ownership_checked,
        ir_item_count: ir_items,
        backend_artifact_count: artifacts,
        bootstrap_ready: false,
    };

    report.bootstrap_ready = try check_bootstrap_readiness(report);
    return report;
}

// token_kind_at returns the token kind at one checked index.
fn token_kind_at(tokens: &std::array::Array<Token>, index: i64) -> !TokenKind {
    let token = try tokens.at(index);
    return token.kind;
}

// expect_token_kind checks one token kind at a checked index.
fn expect_token_kind(tokens: &std::array::Array<Token>, index: i64, want: TokenKind) -> !void {
    let got = try token_kind_at(tokens, index);
    try std::testing::expect_equal_bool(true, got == want);
    return void;
}

// assert_core_lexer_tokens checks keywords, identifiers, numbers, and operators.
fn assert_core_lexer_tokens() -> !void {
    let tokens = try lex_source("fn add(a: i64) -> i64 { return a + 1; }");

    try std::testing::expect_equal_i64(17, tokens.len());
    try expect_token_kind(tokens, 0, TokenKind::Fn);
    try expect_token_kind(tokens, 1, TokenKind::Ident);
    try expect_token_kind(tokens, 2, TokenKind::LParen);
    try expect_token_kind(tokens, 4, TokenKind::Colon);
    try expect_token_kind(tokens, 7, TokenKind::Arrow);
    try expect_token_kind(tokens, 10, TokenKind::Return);
    try expect_token_kind(tokens, 13, TokenKind::Number);
    try expect_token_kind(tokens, 16, TokenKind::Eof);

    tokens.deinit();
    return void;
}

// assert_comment_tokens checks comment skipping and assignment tokens.
fn assert_comment_tokens() -> !void {
    let tokens = try lex_source("// skip");

    try std::testing::expect_equal_i64(1, tokens.len());
    try expect_token_kind(tokens, 0, TokenKind::Eof);

    tokens.deinit();
    return void;
}

// assert_compound_tokens checks compound operators and namespace separators.
fn assert_compound_tokens() -> !void {
    let tokens = try lex_source("a == b != c <= d >= e .. f :: g => h &mut value");

    try expect_token_kind(tokens, 1, TokenKind::Eq);
    try expect_token_kind(tokens, 3, TokenKind::NotEq);
    try expect_token_kind(tokens, 5, TokenKind::LTE);
    try expect_token_kind(tokens, 7, TokenKind::GTE);
    try expect_token_kind(tokens, 9, TokenKind::Range);
    try expect_token_kind(tokens, 11, TokenKind::DoubleColon);
    try expect_token_kind(tokens, 13, TokenKind::FatArrow);
    try expect_token_kind(tokens, 15, TokenKind::Amp);
    try expect_token_kind(tokens, 16, TokenKind::Mut);

    tokens.deinit();
    return void;
}

// run_lexer_self_tests validates the Kizu lexer against Go lexer-shaped cases.
fn run_lexer_self_tests() -> !void {
    try assert_core_lexer_tokens();
    try assert_comment_tokens();
    try assert_compound_tokens();
    return void;
}

// build_diagnostic constructs owned diagnostic text.
fn build_diagnostic(message: []const u8) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    try text.append_bytes(message);
    return text;
}

// build_keyword_table constructs the minimal keyword symbol table.
fn build_keyword_table() -> !std::map::Map<[]const u8, TokenKind> {
    let allocator = std::mem::page_allocator();
    let keywords = std::map::Map<[]const u8, TokenKind>(allocator);
    try keywords.insert("fn", TokenKind::Fn);
    return keywords;
}

// run_frontend executes the lexer and parser skeleton over one source buffer.
fn run_frontend(source: []const u8) -> !void {
    let tokens = try lex_source(source);
    let report = try compile_tokens(tokens);
    let diagnostic = try build_diagnostic("parsed functions");
    let keywords = try build_keyword_table();
    let message = diagnostic.as_bytes();

    print("compiler stages");
    print(report.stage_count);
    print(message);
    print(report.function_count);
    print("tokens");
    print(report.token_count);
    print("bootstrap ready");
    print(report.bootstrap_ready);
    try print_token_kinds(tokens);
    try print_token_snapshots(tokens);
    let summary = try parse_tokens(tokens);
    try print_ast_snapshot(summary);
    try print_ast_detail_snapshot(tokens);
    try print_ast_node_dump_snapshot(tokens);
    try print_decl_snapshot(tokens);
    try print_module_graph_snapshot(tokens);
    try print_semantic_snapshot(summary, report.diagnostic_count);
    try print_type_snapshot(tokens);
    try print_type_env_snapshot(tokens);
    try print_type_check_snapshot(tokens);
    try print_ownership_snapshot(tokens);
    try print_ir_snapshot(summary);
    try print_ir_dump_snapshot(tokens);
    try print_backend_fingerprints(summary, tokens);
    print_cache_contract_snapshot();
    print(try keywords.get("fn"));

    keywords.deinit();
    diagnostic.deinit();
    tokens.deinit();
    return void;
}

// run_diagnostics executes the diagnostic-only compiler path.
fn run_diagnostics(source: []const u8) -> !void {
    let tokens = try lex_source(source);

    try print_diagnostic_snapshot(tokens);
    tokens.deinit();
    return void;
}

// source_path_from_process returns the input path passed to the prototype CLI.
fn source_path_from_process() -> ![]const u8 {
    if std::process::arg_count() > 0 {
        return try std::process::arg(0);
    }
    return "selfhost/fixtures/simple.kizu";
}

// diagnostics_mode reports whether the prototype CLI should stop after diagnostics.
fn diagnostics_mode() -> !bool {
    if std::process::arg_count() > 1 {
        let mode = try std::process::arg(1);
        return std::mem::equal_bytes("--diagnostics", mode);
    }
    return false;
}

// validate_source_path checks path helpers needed by compiler diagnostics.
fn validate_source_path(source_path: []const u8) -> ![]const u8 {
    let clean = std::path::clean(source_path);
    let extension = std::path::extension(clean);
    let basename = std::path::basename(clean);

    try std::testing::expect_equal_bytes(".kizu", extension);
    try std::testing::expect(std::mem::len(basename) > 0);
    return clean;
}

// load_source reads one source file through the explicit-Io filesystem API.
fn load_source(io: Io, source_path: []const u8) -> ![]const u8 {
    try std::testing::expect(try std::fs::exists(io, source_path));
    let metadata = try std::fs::metadata(io, source_path);
    try std::testing::expect_equal_bool(false, metadata.is_dir);
    return try std::fs::read_file(io, source_path);
}

// print_source_summary writes path diagnostics through explicit stdio.
fn print_source_summary(io: Io, source_path: []const u8) -> !void {
    try std::io::write_stdout(io, "source:");
    print(std::path::basename(source_path));
    print(std::path::dirname(source_path));
    return void;
}

// main runs a deterministic file-backed skeleton smoke test.
fn main() -> !void {
    let io = std::io::blocking();
    let source_path = try source_path_from_process();
    let clean = try validate_source_path(source_path);
    let source = try load_source(io, clean);

    try print_source_summary(io, clean);
    try run_lexer_self_tests();
    if try diagnostics_mode() {
        try run_diagnostics(source);
        return void;
    }
    try run_frontend(source);
    return void;
}
