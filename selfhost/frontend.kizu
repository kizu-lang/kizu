// Module: Self-host frontend skeleton for validating v0.2 stdlib shape.

enum TokenKind {
    Illegal
    Eof
    Ident
    Number
    String
    Assign
    Plus
    Minus
    Bang
    Question
    Amp
    Asterisk
    Slash
    Percent
    Eq
    FatArrow
    NotEq
    LT
    LTE
    GT
    GTE
    Arrow
    Dot
    Range
    DoubleColon
    Comma
    Colon
    Semicolon
    Pipe
    LParen
    RParen
    LBrace
    RBrace
    LBracket
    RBracket
    Import
    Public
    Fn
    Let
    Var
    Return
    If
    Else
    While
    Break
    Continue
    Match
    Struct
    Enum
    Union
    Contract
    Satisfy
    For
    Impl
    True
    False
    Mut
    Unsafe
    Extern
    Comptime
    Try
}

struct Token {
    kind: TokenKind;
    literal: []const u8;
    start: i64;
    end: i64;
    line: i64;
    column: i64;
}

struct ParseSummary {
    function_count: i64;
    import_count: i64;
    struct_count: i64;
    enum_count: i64;
    union_count: i64;
    return_count: i64;
}

struct SymbolSummary {
    function_symbols: i64;
    type_symbols: i64;
    value_symbols: i64;
}

struct Diagnostic {
    message: []const u8;
    primary_start: i64;
    primary_end: i64;
    primary_line: i64;
    primary_column: i64;
    related_start: i64;
    related_end: i64;
}

struct SemanticSummary {
    symbols: SymbolSummary;
    diagnostics: i64;
    type_checked: bool;
    ownership_checked: bool;
}

struct IrSummary {
    function_items: i64;
    block_items: i64;
    backend_artifacts: i64;
}

struct OwnershipSnapshot {
    ok: bool;
    message: []const u8;
    value: []const u8;
    primary_start: i64;
    related_start: i64;
}

struct MoveCandidate {
    found: bool;
    value: []const u8;
    start: i64;
    end_index: i64;
}

struct CompileReport {
    stage_count: i64;
    token_count: i64;
    function_count: i64;
    diagnostic_count: i64;
    type_checked: bool;
    ownership_checked: bool;
    ir_item_count: i64;
    backend_artifact_count: i64;
    bootstrap_ready: bool;
}

// token_literal returns the Go-compatible literal spelling for one token.
fn token_literal(source: []const u8, kind: TokenKind, start: i64, end: i64) -> ![]const u8 {
    if kind == TokenKind::Eof {
        return "";
    }
    if kind == TokenKind::String {
        return try std::mem::slice(source, start + 1, end - 1);
    }
    return try std::mem::slice(source, start, end);
}

// token_line returns the one-based source line for a byte offset.
fn token_line(source: []const u8, start: i64) -> !i64 {
    var line = 1;
    var index = 0;
    while index < start {
        let byte = try std::mem::byte_at(source, index);
        if byte == cast<u8>(10) {
            line = line + 1;
        }
        index = index + 1;
    }
    return line;
}

// token_column returns the one-based source column for a byte offset.
fn token_column(source: []const u8, start: i64) -> !i64 {
    var column = 1;
    var index = 0;
    while index < start {
        let byte = try std::mem::byte_at(source, index);
        if byte == cast<u8>(10) {
            column = 1;
        } else {
            column = column + 1;
        }
        index = index + 1;
    }
    return column;
}

// make_token builds a source-positioned token value.
fn make_token(source: []const u8, kind: TokenKind, start: i64, end: i64) -> !Token {
    return Token {
        kind: kind,
        literal: try token_literal(source, kind, start, end),
        start: start,
        end: end,
        line: try token_line(source, start),
        column: try token_column(source, start),
    };
}

// is_ascii_space reports whether a byte is insignificant whitespace.
fn is_ascii_space(byte: u8) -> bool {
    if byte == cast<u8>(32) {
        return true;
    }
    if byte == cast<u8>(10) {
        return true;
    }
    if byte == cast<u8>(9) {
        return true;
    }
    return byte == cast<u8>(13);
}

// is_ascii_digit reports whether a byte is an ASCII decimal digit.
fn is_ascii_digit(byte: u8) -> bool {
    if byte >= cast<u8>(48) {
        return byte <= cast<u8>(57);
    }
    return false;
}

// is_ascii_alpha reports whether a byte is an ASCII letter.
fn is_ascii_alpha(byte: u8) -> bool {
    if byte >= cast<u8>(65) {
        if byte <= cast<u8>(90) {
            return true;
        }
    }
    if byte >= cast<u8>(97) {
        return byte <= cast<u8>(122);
    }
    return false;
}

// is_ident_start reports whether a byte can start an identifier.
fn is_ident_start(byte: u8) -> bool {
    if is_ascii_alpha(byte) {
        return true;
    }
    return byte == cast<u8>(95);
}

// is_ident_continue reports whether a byte can continue an identifier.
fn is_ident_continue(byte: u8) -> bool {
    if is_ident_start(byte) {
        return true;
    }
    return is_ascii_digit(byte);
}

// keyword_control_kind classifies control-flow and binding keywords.
fn keyword_control_kind(text: []const u8) -> TokenKind {
    if std::mem::equal_bytes(text, "fn") {
        return TokenKind::Fn;
    }
    if std::mem::equal_bytes(text, "import") {
        return TokenKind::Import;
    }
    if std::mem::equal_bytes(text, "pub") {
        return TokenKind::Public;
    }
    if std::mem::equal_bytes(text, "let") {
        return TokenKind::Let;
    }
    if std::mem::equal_bytes(text, "var") {
        return TokenKind::Var;
    }
    if std::mem::equal_bytes(text, "return") {
        return TokenKind::Return;
    }
    if std::mem::equal_bytes(text, "if") {
        return TokenKind::If;
    }
    if std::mem::equal_bytes(text, "else") {
        return TokenKind::Else;
    }
    if std::mem::equal_bytes(text, "while") {
        return TokenKind::While;
    }
    if std::mem::equal_bytes(text, "break") {
        return TokenKind::Break;
    }
    if std::mem::equal_bytes(text, "continue") {
        return TokenKind::Continue;
    }
    return TokenKind::Ident;
}

// keyword_decl_kind classifies type and implementation keywords.
fn keyword_decl_kind(text: []const u8) -> TokenKind {
    if std::mem::equal_bytes(text, "match") {
        return TokenKind::Match;
    }
    if std::mem::equal_bytes(text, "struct") {
        return TokenKind::Struct;
    }
    if std::mem::equal_bytes(text, "enum") {
        return TokenKind::Enum;
    }
    if std::mem::equal_bytes(text, "union") {
        return TokenKind::Union;
    }
    if std::mem::equal_bytes(text, "contract") {
        return TokenKind::Contract;
    }
    if std::mem::equal_bytes(text, "satisfy") {
        return TokenKind::Satisfy;
    }
    if std::mem::equal_bytes(text, "for") {
        return TokenKind::For;
    }
    if std::mem::equal_bytes(text, "impl") {
        return TokenKind::Impl;
    }
    return TokenKind::Ident;
}

// keyword_value_kind classifies literal and modifier keywords.
fn keyword_value_kind(text: []const u8) -> TokenKind {
    if std::mem::equal_bytes(text, "true") {
        return TokenKind::True;
    }
    if std::mem::equal_bytes(text, "false") {
        return TokenKind::False;
    }
    if std::mem::equal_bytes(text, "mut") {
        return TokenKind::Mut;
    }
    if std::mem::equal_bytes(text, "unsafe") {
        return TokenKind::Unsafe;
    }
    if std::mem::equal_bytes(text, "extern") {
        return TokenKind::Extern;
    }
    if std::mem::equal_bytes(text, "comptime") {
        return TokenKind::Comptime;
    }
    if std::mem::equal_bytes(text, "try") {
        return TokenKind::Try;
    }
    return TokenKind::Ident;
}

// keyword_kind classifies identifier text that is reserved by the language.
fn keyword_kind(text: []const u8) -> TokenKind {
    let control = keyword_control_kind(text);
    if control != TokenKind::Ident {
        return control;
    }
    let decl = keyword_decl_kind(text);
    if decl != TokenKind::Ident {
        return decl;
    }
    return keyword_value_kind(text);
}

// single_char_kind classifies one-byte punctuation and operator tokens.
fn single_char_kind(byte: u8) -> TokenKind {
    if byte == cast<u8>(61) {
        return TokenKind::Assign;
    }
    if byte == cast<u8>(43) {
        return TokenKind::Plus;
    }
    if byte == cast<u8>(45) {
        return TokenKind::Minus;
    }
    if byte == cast<u8>(33) {
        return TokenKind::Bang;
    }
    if byte == cast<u8>(63) {
        return TokenKind::Question;
    }
    if byte == cast<u8>(38) {
        return TokenKind::Amp;
    }
    if byte == cast<u8>(42) {
        return TokenKind::Asterisk;
    }
    if byte == cast<u8>(47) {
        return TokenKind::Slash;
    }
    if byte == cast<u8>(37) {
        return TokenKind::Percent;
    }
    if byte == cast<u8>(60) {
        return TokenKind::LT;
    }
    if byte == cast<u8>(62) {
        return TokenKind::GT;
    }
    if byte == cast<u8>(46) {
        return TokenKind::Dot;
    }
    if byte == cast<u8>(40) {
        return TokenKind::LParen;
    }
    if byte == cast<u8>(41) {
        return TokenKind::RParen;
    }
    if byte == cast<u8>(123) {
        return TokenKind::LBrace;
    }
    if byte == cast<u8>(125) {
        return TokenKind::RBrace;
    }
    if byte == cast<u8>(59) {
        return TokenKind::Semicolon;
    }
    if byte == cast<u8>(44) {
        return TokenKind::Comma;
    }
    if byte == cast<u8>(58) {
        return TokenKind::Colon;
    }
    if byte == cast<u8>(124) {
        return TokenKind::Pipe;
    }
    if byte == cast<u8>(91) {
        return TokenKind::LBracket;
    }
    if byte == cast<u8>(93) {
        return TokenKind::RBracket;
    }
    return TokenKind::Illegal;
}

// two_char_kind classifies compound tokens from adjacent bytes.
fn two_char_kind(first: u8, second: u8) -> TokenKind {
    if first == cast<u8>(61) {
        if second == cast<u8>(61) {
            return TokenKind::Eq;
        }
        if second == cast<u8>(62) {
            return TokenKind::FatArrow;
        }
    }
    if first == cast<u8>(33) {
        if second == cast<u8>(61) {
            return TokenKind::NotEq;
        }
    }
    if first == cast<u8>(60) {
        if second == cast<u8>(61) {
            return TokenKind::LTE;
        }
    }
    if first == cast<u8>(62) {
        if second == cast<u8>(61) {
            return TokenKind::GTE;
        }
    }
    if first == cast<u8>(45) {
        if second == cast<u8>(62) {
            return TokenKind::Arrow;
        }
    }
    if first == cast<u8>(46) {
        if second == cast<u8>(46) {
            return TokenKind::Range;
        }
    }
    if first == cast<u8>(58) {
        if second == cast<u8>(58) {
            return TokenKind::DoubleColon;
        }
    }
    return TokenKind::Illegal;
}

// has_compound_kind reports whether two bytes make a compound token.
fn has_compound_kind(first: u8, second: u8) -> bool {
    return two_char_kind(first, second) != TokenKind::Illegal;
}

// lex_identifier appends one identifier-like token and returns the next index.
fn lex_identifier(source: []const u8, tokens: &mut std::array::Array<Token>, start: i64) -> !i64 {
    let length = std::mem::len(source);
    var end = start + 1;
    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if is_ident_continue(byte) {
            end = end + 1;
        } else {
            break;
        }
    }
    let text = try std::mem::slice(source, start, end);
    try tokens.append(try make_token(source, keyword_kind(text), start, end));
    return end;
}

// lex_number appends one integer token and returns the next index.
fn lex_number(source: []const u8, tokens: &mut std::array::Array<Token>, start: i64) -> !i64 {
    let length = std::mem::len(source);
    var end = start + 1;
    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if is_ascii_digit(byte) {
            end = end + 1;
        } else {
            break;
        }
    }
    try tokens.append(try make_token(source, TokenKind::Number, start, end));
    return end;
}

// lex_string appends one string token and returns the next index.
fn lex_string(source: []const u8, tokens: &mut std::array::Array<Token>, start: i64) -> !i64 {
    let length = std::mem::len(source);
    var end = start + 1;
    while end < length {
        let byte = try std::mem::byte_at(source, end);
        end = end + 1;
        if byte == cast<u8>(34) {
            try tokens.append(try make_token(source, TokenKind::String, start, end));
            return end;
        }
    }
    try tokens.append(try make_token(source, TokenKind::Illegal, start, end));
    return end;
}

// skip_line_comment returns the index after one line comment.
fn skip_line_comment(source: []const u8, start: i64) -> !i64 {
    let length = std::mem::len(source);
    var end = start + 2;
    while end < length {
        let byte = try std::mem::byte_at(source, end);
        if byte == cast<u8>(10) {
            return end + 1;
        }
        end = end + 1;
    }
    return end;
}

// lex_symbol appends one symbol token or skips one comment.
fn lex_symbol(source: []const u8, tokens: &mut std::array::Array<Token>, start: i64) -> !i64 {
    let length = std::mem::len(source);
    let first = try std::mem::byte_at(source, start);
    if start + 1 < length {
        let second = try std::mem::byte_at(source, start + 1);
        if first == cast<u8>(47) {
            if second == cast<u8>(47) {
                return try skip_line_comment(source, start);
            }
        }
        if has_compound_kind(first, second) {
            let kind = two_char_kind(first, second);
            try tokens.append(try make_token(source, kind, start, start + 2));
            return start + 2;
        }
    }
    try tokens.append(try make_token(source, single_char_kind(first), start, start + 1));
    return start + 1;
}

// lex_source scans source bytes into an owned token array.
fn lex_source(source: []const u8) -> !std::array::Array<Token> {
    let allocator = std::mem::page_allocator();
    var tokens = std::array::Array<Token>(allocator);
    let length = std::mem::len(source);
    var index = 0;

    while index < length {
        let byte = try std::mem::byte_at(source, index);
        if is_ascii_space(byte) {
            index = index + 1;
        } else {
            if is_ident_start(byte) {
                index = try lex_identifier(source, tokens, index);
            } else {
                if is_ascii_digit(byte) {
                    index = try lex_number(source, tokens, index);
                } else {
                    if byte == cast<u8>(34) {
                        index = try lex_string(source, tokens, index);
                    } else {
                        index = try lex_symbol(source, tokens, index);
                    }
                }
            }
        }
    }

    try tokens.append(try make_token(source, TokenKind::Eof, length, length));
    return tokens;
}

// parse_tokens returns the minimal parser summary used by this skeleton.
fn parse_tokens(tokens: &std::array::Array<Token>) -> !ParseSummary {
    var functions = 0;
    var imports = 0;
    var structs = 0;
    var enums = 0;
    var unions = 0;
    var returns = 0;
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            functions = functions + 1;
        }
        if token.kind == TokenKind::Import {
            imports = imports + 1;
        }
        if token.kind == TokenKind::Struct {
            structs = structs + 1;
        }
        if token.kind == TokenKind::Enum {
            enums = enums + 1;
        }
        if token.kind == TokenKind::Union {
            unions = unions + 1;
        }
        if token.kind == TokenKind::Return {
            returns = returns + 1;
        }
        index = index + 1;
    }

    return ParseSummary {
        function_count: functions,
        import_count: imports,
        struct_count: structs,
        enum_count: enums,
        union_count: unions,
        return_count: returns,
    };
}

// print_ast_snapshot writes the normalized parser snapshot used by the oracle.
fn print_ast_snapshot(summary: &ParseSummary) -> !void {
    print("ast snapshot");
    print("functions");
    print(summary.function_count);
    print("imports");
    print(summary.import_count);
    print("structs");
    print(summary.struct_count);
    print("enums");
    print(summary.enum_count);
    print("unions");
    print(summary.union_count);
    print("returns");
    print(summary.return_count);
    print("ast snapshot end");
    return void;
}

// print_ast_detail_snapshot writes function-shaped parser details.
fn print_ast_detail_snapshot(tokens: &std::array::Array<Token>) -> !void {
    print("ast detail snapshot");
    if try has_missing_semicolon(tokens) {
        print("status");
        print("fail");
        print("message");
        print("parser error: missing semicolon");
    } else {
        print("status");
        print("pass");
        try print_ast_function_details(tokens);
    }
    print("ast detail snapshot end");
    return void;
}

// has_missing_semicolon detects the negative parser fixture subset.
fn has_missing_semicolon(tokens: &std::array::Array<Token>) -> !bool {
    var index = 1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        let previous = try tokens.at(index - 1);
        if token.kind == TokenKind::RBrace {
            if previous.kind == TokenKind::RParen {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// print_ast_function_details writes per-function parser rows.
fn print_ast_function_details(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            try print_ast_function_detail(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_ast_function_detail writes one function declaration shape.
fn print_ast_function_detail(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("fn");
    print(name.literal);
    print("params");
    print(try function_param_count(tokens, start + 3));
    try print_function_param_types(tokens, start + 3);
    print("return");
    print(try function_return_type(tokens, start + 2));
    print("returns");
    print(try function_return_count(tokens, start));
    return void;
}

// function_return_count counts return statements before the next declaration.
fn function_return_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return count;
            }
        }
        if token.kind == TokenKind::Return {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_decl_snapshot writes top-level declaration order for the parser oracle.
fn print_decl_snapshot(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("decl snapshot");
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Import {
            print("import");
            index = try print_import_decl(tokens, index + 1);
        } else {
            if is_decl_keyword(token.kind) {
                print(token.kind);
                try print_decl_name(tokens, index + 1);
            }
        }
        index = index + 1;
    }
    print("decl snapshot end");
    return void;
}

// print_module_graph_snapshot writes the root module import graph subset.
fn print_module_graph_snapshot(tokens: &std::array::Array<Token>) -> !void {
    print("module graph snapshot");
    if try has_missing_import(tokens) {
        print("status");
        print("fail");
        print("message");
        print("module error: missing module");
    } else {
        print("status");
        print("pass");
        print("root");
        print(try module_root_name(tokens));
        print("modules");
        let imports = try count_imports(tokens);
        print(imports + 1);
        try print_module_import_edges(tokens);
    }
    print("module graph snapshot end");
    return void;
}

// has_missing_import detects the missing-import conformance subset.
fn has_missing_import(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Ident {
            if std::mem::equal_bytes(token.literal, "missing") {
                return true;
            }
        }
        index = index + 1;
    }
    return false;
}

// module_root_name returns the package segment from the first import.
fn module_root_name(tokens: &std::array::Array<Token>) -> ![]const u8 {
    var index = 0;

    while index + 1 < tokens.len() {
        let token = try tokens.at(index);
        let next = try tokens.at(index + 1);
        if token.kind == TokenKind::Import {
            return next.literal;
        }
        index = index + 1;
    }
    return "<single>";
}

// count_imports returns the number of import declarations.
fn count_imports(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Import {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_module_import_edges writes root import edges in source order.
fn print_module_import_edges(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Import {
            print("import");
            index = try print_import_decl(tokens, index + 1);
        }
        index = index + 1;
    }
    return void;
}

// is_decl_keyword reports whether a token starts a top-level declaration.
fn is_decl_keyword(kind: TokenKind) -> bool {
    if kind == TokenKind::Fn {
        return true;
    }
    if kind == TokenKind::Struct {
        return true;
    }
    if kind == TokenKind::Enum {
        return true;
    }
    if kind == TokenKind::Union {
        return true;
    }
    if kind == TokenKind::Contract {
        return true;
    }
    return false;
}

// print_decl_name prints the next identifier after a declaration keyword.
fn print_decl_name(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let token = try tokens.at(start);
    if token.kind == TokenKind::Ident {
        print(token.literal);
    } else {
        print("<missing>");
    }
    return void;
}

// print_import_decl prints all identifiers in an import path.
fn print_import_decl(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Semicolon {
            print("import end");
            return index;
        }
        if token.kind == TokenKind::Ident {
            print(token.literal);
        }
        index = index + 1;
    }
    print("import end");
    return index;
}

// print_semantic_snapshot writes symbol and diagnostic summary oracle data.
fn print_semantic_snapshot(summary: &ParseSummary, diagnostic_count: i64) -> !void {
    let symbols = build_symbol_summary(summary);
    print("semantic snapshot");
    print("function symbols");
    print(symbols.function_symbols);
    print("type symbols");
    print(symbols.type_symbols);
    print("value symbols");
    print(symbols.value_symbols);
    print("diagnostics");
    print(diagnostic_count);
    print("semantic snapshot end");
    return void;
}

// print_type_snapshot writes function return types for the type oracle.
fn print_type_snapshot(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("type snapshot");
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            try print_function_type(tokens, index);
        }
        index = index + 1;
    }
    print("type snapshot end");
    return void;
}

// print_function_type writes the function name and normalized return type.
fn print_function_type(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);
    print(name.literal);
    print(try function_return_type(tokens, start + 2));
    return void;
}

// function_return_type returns the explicit return type or default void.
fn function_return_type(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::LBrace {
            return "void";
        }
        if token.kind == TokenKind::Arrow {
            let next = try tokens.at(index + 1);
            return next.literal;
        }
        index = index + 1;
    }
    return "void";
}

// print_ownership_snapshot writes the minimal move-safety oracle result.
fn print_ownership_snapshot(tokens: &std::array::Array<Token>) -> !void {
    let snapshot = try check_ownership_subset(tokens);

    print("ownership snapshot");
    print("status");
    if snapshot.ok {
        print("pass");
    } else {
        print("fail");
        print(snapshot.message);
        print(snapshot.value);
        print(snapshot.primary_start);
        print(snapshot.related_start);
    }
    print("ownership snapshot end");
    return void;
}

// check_ownership_subset detects owned-call moves followed by use.
fn check_ownership_subset(tokens: &std::array::Array<Token>) -> !OwnershipSnapshot {
    var index = 0;
    var moved = "";
    var moved_start = -1;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if moved_start >= 0 {
            if token.kind == TokenKind::Ident {
                if std::mem::equal_bytes(token.literal, moved) {
                    return ownership_error(moved, token.start, moved_start);
                }
            }
        }
        let candidate = try call_move_candidate(tokens, index);
        if candidate.found {
            moved = candidate.value;
            moved_start = candidate.start;
            index = candidate.end_index + 1;
        } else {
            index = index + 1;
        }
    }
    return ownership_ok();
}

// ownership_ok constructs a passing ownership oracle result.
fn ownership_ok() -> OwnershipSnapshot {
    return OwnershipSnapshot {
        ok: true,
        message: "",
        value: "",
        primary_start: -1,
        related_start: -1,
    };
}

// ownership_error constructs a moved-value ownership oracle result.
fn ownership_error(value: []const u8, primary: i64, related: i64) -> OwnershipSnapshot {
    return OwnershipSnapshot {
        ok: false,
        message: "move error: moved value was used",
        value: value,
        primary_start: primary,
        related_start: related,
    };
}

// call_move_candidate returns an owned identifier argument consumed by a call.
fn call_move_candidate(tokens: &std::array::Array<Token>, start: i64) -> !MoveCandidate {
    let call_start = try is_call_start(tokens, start);
    if !call_start {
        return no_move_candidate();
    }
    let callee = try tokens.at(start);
    let arg_index = start + 2;
    let arg = try tokens.at(arg_index);
    if arg.kind != TokenKind::Ident {
        return no_move_candidate();
    }
    let owned = try function_first_param_owned(tokens, callee.literal);
    if !owned {
        return no_move_candidate();
    }
    return MoveCandidate {
        found: true,
        value: arg.literal,
        start: arg.start,
        end_index: try call_end_index(tokens, start),
    };
}

// no_move_candidate constructs an empty move candidate.
fn no_move_candidate() -> MoveCandidate {
    return MoveCandidate {
        found: false,
        value: "",
        start: -1,
        end_index: -1,
    };
}

// is_call_start reports whether an identifier begins a runtime call expression.
fn is_call_start(tokens: &std::array::Array<Token>, index: i64) -> !bool {
    if index + 1 >= tokens.len() {
        return false;
    }
    let token = try tokens.at(index);
    let next = try tokens.at(index + 1);
    if token.kind != TokenKind::Ident {
        return false;
    }
    if next.kind != TokenKind::LParen {
        return false;
    }
    if index > 0 {
        let previous = try tokens.at(index - 1);
        return previous.kind != TokenKind::Fn;
    }
    return true;
}

// function_first_param_owned reports whether a function's first arg is owned.
fn function_first_param_owned(tokens: &std::array::Array<Token>, name: []const u8) -> !bool {
    var index = 0;

    while index + 3 < tokens.len() {
        let token = try tokens.at(index);
        let fn_name = try tokens.at(index + 1);
        if token.kind == TokenKind::Fn {
            if std::mem::equal_bytes(fn_name.literal, name) {
                return try first_param_is_owned(tokens, index + 3);
            }
        }
        index = index + 1;
    }
    return false;
}

// first_param_is_owned parses the first parameter ownership mode.
fn first_param_is_owned(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return false;
        }
        if token.kind == TokenKind::Colon {
            let next = try tokens.at(index + 1);
            return next.kind != TokenKind::Amp;
        }
        index = index + 1;
    }
    return false;
}

// call_end_index returns the closing parenthesis for a flat call expression.
fn call_end_index(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return index;
        }
        index = index + 1;
    }
    return start;
}

// print_token_kinds writes the whole token-kind stream for Go oracle comparison.
fn print_token_kinds(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("token stream");
    while index < tokens.len() {
        let token = try tokens.at(index);
        print(token.kind);
        index = index + 1;
    }
    print("token stream end");
    return void;
}

// print_token_snapshots writes token data used by the self-host lexer oracle.
fn print_token_snapshots(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("token snapshots");
    while index < tokens.len() {
        let token = try tokens.at(index);
        print(token.kind);
        print(token.literal);
        print(token.start);
        print(token.end);
        print(token.line);
        print(token.column);
        index = index + 1;
    }
    print("token snapshots end");
    return void;
}

// count_tokens returns the full token count including EOF.
fn count_tokens(tokens: &std::array::Array<Token>) -> i64 {
    return tokens.len();
}

// collect_lex_diagnostics counts lexer errors for the diagnostic stage.
fn collect_lex_diagnostics(tokens: &std::array::Array<Token>) -> !i64 {
    var count = 0;
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Illegal {
            count = count + 1;
        }
        index = index + 1;
    }

    return count;
}

// print_diagnostic_snapshot writes structured lexer diagnostics for oracle tests.
fn print_diagnostic_snapshot(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    print("diagnostic snapshot");
    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Illegal {
            let diagnostic = Diagnostic {
                message: "illegal token",
                primary_start: token.start,
                primary_end: token.end,
                primary_line: token.line,
                primary_column: token.column,
                related_start: token.start,
                related_end: token.end,
            };
            print(diagnostic.message);
            print(diagnostic.primary_start);
            print(diagnostic.primary_end);
            print(diagnostic.primary_line);
            print(diagnostic.primary_column);
            print(diagnostic.related_start);
            print(diagnostic.related_end);
        }
        index = index + 1;
    }
    print("diagnostic snapshot end");
    return void;
}

// build_symbol_summary constructs the minimal semantic symbol summary.
fn build_symbol_summary(summary: &ParseSummary) -> SymbolSummary {
    return SymbolSummary {
        function_symbols: summary.function_count,
        type_symbols: summary.struct_count + summary.enum_count + summary.union_count,
        value_symbols: 0,
    };
}

// run_semantic_stage validates minimal type and ownership preconditions.
fn run_semantic_stage(summary: &ParseSummary, diagnostic_count: i64) -> !SemanticSummary {
    try std::testing::expect_equal_i64(0, diagnostic_count);
    try std::testing::expect(summary.function_count > 0);
    let symbols = build_symbol_summary(summary);
    return SemanticSummary {
        symbols: symbols,
        diagnostics: diagnostic_count,
        type_checked: true,
        ownership_checked: true,
    };
}

// run_ownership_stage validates the minimal ownership-checking preconditions.
fn run_ownership_stage(summary: &ParseSummary, semantic: &SemanticSummary) -> !bool {
    try std::testing::expect(semantic.type_checked);
    try std::testing::expect(semantic.ownership_checked);
    try std::testing::expect(summary.function_count > 0);
    return true;
}

// lower_to_ir returns the number of lowered function-shaped IR items.
fn lower_to_ir(summary: &ParseSummary, type_checked: bool, ownership_checked: bool) -> !i64 {
    try std::testing::expect(type_checked);
    try std::testing::expect(ownership_checked);
    return summary.function_count;
}

// build_ir_summary constructs the stage 6-8 oracle summary.
fn build_ir_summary(summary: &ParseSummary) -> IrSummary {
    return IrSummary {
        function_items: summary.function_count,
        block_items: summary.function_count,
        backend_artifacts: 1,
    };
}

// print_ir_snapshot writes the normalized IR/backend summary oracle data.
fn print_ir_snapshot(summary: &ParseSummary) -> !void {
    let ir = build_ir_summary(summary);
    print("ir snapshot");
    print("functions");
    print(ir.function_items);
    print("blocks");
    print(ir.block_items);
    print("backend artifacts");
    print(ir.backend_artifacts);
    print("ir snapshot end");
    return void;
}

// print_ir_dump_snapshot writes the normalized lowerable IR shape.
fn print_ir_dump_snapshot(tokens: &std::array::Array<Token>) -> !void {
    print("ir dump snapshot");
    if try ir_dump_has_error(tokens) {
        print("status");
        print("fail");
        print("message");
        print("ir error: source is not lowerable");
    } else {
        print("status");
        print("pass");
        try print_ir_function_dumps(tokens);
    }
    print("ir dump snapshot end");
    return void;
}

// print_backend_fingerprints writes backend smoke fingerprints.
fn print_backend_fingerprints(summary: &ParseSummary, tokens: &std::array::Array<Token>) -> !void {
    print("backend fingerprint snapshot");
    try print_llvm_backend(summary, tokens);
    try print_wasm_backend(summary, tokens);
    print("backend fingerprint snapshot end");
    return void;
}

// print_llvm_backend writes the LLVM backend fingerprint.
fn print_llvm_backend(summary: &ParseSummary, tokens: &std::array::Array<Token>) -> !void {
    print("target");
    print("llvm");
    print("status");
    if try ir_dump_has_error(tokens) {
        print("fail");
        print("message");
        print("backend error: source is not lowerable");
        return void;
    }
    print("pass");
    print("functions");
    print(summary.function_count);
    print("strings");
    print(try count_string_literals(tokens));
    print("entry");
    print("main");
    return void;
}

// print_wasm_backend writes the WASI backend fingerprint.
fn print_wasm_backend(summary: &ParseSummary, tokens: &std::array::Array<Token>) -> !void {
    print("target");
    print("wasm32-wasi");
    print("status");
    if try ir_dump_has_error(tokens) {
        print("fail");
        print("message");
        print("backend error: source is not lowerable");
        return void;
    }
    print("pass");
    print("functions");
    print(summary.function_count);
    print("strings");
    print(try count_string_literals(tokens));
    print("entry");
    print("_start");
    return void;
}

// count_string_literals returns the number of source string literals.
fn count_string_literals(tokens: &std::array::Array<Token>) -> !i64 {
    var index = 0;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::String {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_cache_contract_snapshot writes the self-host cache ownership decision.
fn print_cache_contract_snapshot() -> void {
    print("cache contract snapshot");
    print("owner");
    print("go");
    print("switch");
    print("blocked");
    print("required inputs");
    print("compiler version");
    print("target");
    print("input kind");
    print("source hash");
    print("stdlib hash");
    print("positive");
    print("cache hit");
    print("negative");
    print("source changed");
    print("cache contract snapshot end");
    return void;
}

// ir_dump_has_error reports whether the source cannot reach IR lowering.
fn ir_dump_has_error(tokens: &std::array::Array<Token>) -> !bool {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            if try function_requires_return(tokens, index) {
                if !try function_body_has_return(tokens, index) {
                    return true;
                }
            }
        }
        index = index + 1;
    }
    return false;
}

// function_requires_return reports whether a function return type is non-void.
fn function_requires_return(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    let return_type = try function_return_type(tokens, start + 2);
    return !std::mem::equal_bytes(return_type, "void");
}

// function_body_has_return reports whether a function body contains return.
fn function_body_has_return(tokens: &std::array::Array<Token>, start: i64) -> !bool {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return false;
            }
        }
        if token.kind == TokenKind::Return {
            return true;
        }
        index = index + 1;
    }
    return false;
}

// print_ir_function_dumps writes function-level IR dump rows.
fn print_ir_function_dumps(tokens: &std::array::Array<Token>) -> !void {
    var index = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::Fn {
            try print_ir_function_dump(tokens, index);
        }
        index = index + 1;
    }
    return void;
}

// print_ir_function_dump writes one normalized function IR shape.
fn print_ir_function_dump(tokens: &std::array::Array<Token>, start: i64) -> !void {
    let name = try tokens.at(start + 1);

    print("fn");
    print(name.literal);
    print("return");
    print(try function_return_type(tokens, start + 2));
    print("params");
    print(try function_param_count(tokens, start + 3));
    try print_function_param_types(tokens, start + 3);
    print("block");
    print("entry");
    print("terminator");
    print(try function_terminator(tokens, start));
    return void;
}

// function_param_count returns the number of function parameters.
fn function_param_count(tokens: &std::array::Array<Token>, start: i64) -> !i64 {
    var index = start;
    var count = 0;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return count;
        }
        if token.kind == TokenKind::Colon {
            count = count + 1;
        }
        index = index + 1;
    }
    return count;
}

// print_function_param_types writes parameter type rows in signature order.
fn print_function_param_types(tokens: &std::array::Array<Token>, start: i64) -> !void {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if token.kind == TokenKind::RParen {
            return void;
        }
        if token.kind == TokenKind::Colon {
            let next = try tokens.at(index + 1);
            print("param");
            print(next.literal);
        }
        index = index + 1;
    }
    return void;
}

// function_terminator returns the normalized entry block terminator.
fn function_terminator(tokens: &std::array::Array<Token>, start: i64) -> ![]const u8 {
    var index = start;

    while index < tokens.len() {
        let token = try tokens.at(index);
        if index > start {
            if token.kind == TokenKind::Fn {
                return "return void";
            }
        }
        if token.kind == TokenKind::Return {
            let next = try tokens.at(index + 1);
            if std::mem::equal_bytes(next.literal, "void") {
                return "return void";
            }
            return "return";
        }
        index = index + 1;
    }
    return "return void";
}

// emit_backend_artifacts returns the number of backend artifacts produced.
fn emit_backend_artifacts(ir_item_count: i64) -> !i64 {
    try std::testing::expect(ir_item_count > 0);
    return 1;
}

// check_bootstrap_readiness validates whether all compiler stages ran.
fn check_bootstrap_readiness(report: &CompileReport) -> !bool {
    try std::testing::expect_equal_i64(8, report.stage_count);
    try std::testing::expect(report.token_count > 0);
    try std::testing::expect(report.function_count > 0);
    try std::testing::expect_equal_i64(0, report.diagnostic_count);
    try std::testing::expect(report.type_checked);
    try std::testing::expect(report.ownership_checked);
    try std::testing::expect(report.ir_item_count > 0);
    try std::testing::expect(report.backend_artifact_count > 0);
    return true;
}

// compile_tokens runs the current compiler1-8 skeleton over one token stream.
fn compile_tokens(tokens: &std::array::Array<Token>) -> !CompileReport {
    let summary = try parse_tokens(tokens);
    let diagnostics = try collect_lex_diagnostics(tokens);
    let semantic = try run_semantic_stage(summary, diagnostics);
    let ownership_checked = try run_ownership_stage(summary, semantic);
    let ir_items = try lower_to_ir(summary, semantic.type_checked, ownership_checked);
    let artifacts = try emit_backend_artifacts(ir_items);
    var report = CompileReport {
        stage_count: 8,
        token_count: count_tokens(tokens),
        function_count: summary.function_count,
        diagnostic_count: semantic.diagnostics,
        type_checked: semantic.type_checked,
        ownership_checked: ownership_checked,
        ir_item_count: ir_items,
        backend_artifact_count: artifacts,
        bootstrap_ready: false,
    };

    report.bootstrap_ready = try check_bootstrap_readiness(report);
    return report;
}

// token_kind_at returns the token kind at one checked index.
fn token_kind_at(tokens: &std::array::Array<Token>, index: i64) -> !TokenKind {
    let token = try tokens.at(index);
    return token.kind;
}

// expect_token_kind checks one token kind at a checked index.
fn expect_token_kind(tokens: &std::array::Array<Token>, index: i64, want: TokenKind) -> !void {
    let got = try token_kind_at(tokens, index);
    try std::testing::expect_equal_bool(true, got == want);
    return void;
}

// assert_core_lexer_tokens checks keywords, identifiers, numbers, and operators.
fn assert_core_lexer_tokens() -> !void {
    let tokens = try lex_source("fn add(a: i64) -> i64 { return a + 1; }");

    try std::testing::expect_equal_i64(17, tokens.len());
    try expect_token_kind(tokens, 0, TokenKind::Fn);
    try expect_token_kind(tokens, 1, TokenKind::Ident);
    try expect_token_kind(tokens, 2, TokenKind::LParen);
    try expect_token_kind(tokens, 4, TokenKind::Colon);
    try expect_token_kind(tokens, 7, TokenKind::Arrow);
    try expect_token_kind(tokens, 10, TokenKind::Return);
    try expect_token_kind(tokens, 13, TokenKind::Number);
    try expect_token_kind(tokens, 16, TokenKind::Eof);

    tokens.deinit();
    return void;
}

// assert_comment_tokens checks comment skipping and assignment tokens.
fn assert_comment_tokens() -> !void {
    let tokens = try lex_source("// skip");

    try std::testing::expect_equal_i64(1, tokens.len());
    try expect_token_kind(tokens, 0, TokenKind::Eof);

    tokens.deinit();
    return void;
}

// assert_compound_tokens checks compound operators and namespace separators.
fn assert_compound_tokens() -> !void {
    let tokens = try lex_source("a == b != c <= d >= e .. f :: g => h &mut value");

    try expect_token_kind(tokens, 1, TokenKind::Eq);
    try expect_token_kind(tokens, 3, TokenKind::NotEq);
    try expect_token_kind(tokens, 5, TokenKind::LTE);
    try expect_token_kind(tokens, 7, TokenKind::GTE);
    try expect_token_kind(tokens, 9, TokenKind::Range);
    try expect_token_kind(tokens, 11, TokenKind::DoubleColon);
    try expect_token_kind(tokens, 13, TokenKind::FatArrow);
    try expect_token_kind(tokens, 15, TokenKind::Amp);
    try expect_token_kind(tokens, 16, TokenKind::Mut);

    tokens.deinit();
    return void;
}

// run_lexer_self_tests validates the Kizu lexer against Go lexer-shaped cases.
fn run_lexer_self_tests() -> !void {
    try assert_core_lexer_tokens();
    try assert_comment_tokens();
    try assert_compound_tokens();
    return void;
}

// build_diagnostic constructs owned diagnostic text.
fn build_diagnostic(message: []const u8) -> !std::string::String {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);
    try text.append_bytes(message);
    return text;
}

// build_keyword_table constructs the minimal keyword symbol table.
fn build_keyword_table() -> !std::map::Map<[]const u8, TokenKind> {
    let allocator = std::mem::page_allocator();
    let keywords = std::map::Map<[]const u8, TokenKind>(allocator);
    try keywords.insert("fn", TokenKind::Fn);
    return keywords;
}

// run_frontend executes the lexer and parser skeleton over one source buffer.
fn run_frontend(source: []const u8) -> !void {
    let tokens = try lex_source(source);
    let report = try compile_tokens(tokens);
    let diagnostic = try build_diagnostic("parsed functions");
    let keywords = try build_keyword_table();
    let message = diagnostic.as_bytes();

    print("compiler stages");
    print(report.stage_count);
    print(message);
    print(report.function_count);
    print("tokens");
    print(report.token_count);
    print("bootstrap ready");
    print(report.bootstrap_ready);
    try print_token_kinds(tokens);
    try print_token_snapshots(tokens);
    let summary = try parse_tokens(tokens);
    try print_ast_snapshot(summary);
    try print_ast_detail_snapshot(tokens);
    try print_decl_snapshot(tokens);
    try print_module_graph_snapshot(tokens);
    try print_semantic_snapshot(summary, report.diagnostic_count);
    try print_type_snapshot(tokens);
    try print_ownership_snapshot(tokens);
    try print_ir_snapshot(summary);
    try print_ir_dump_snapshot(tokens);
    try print_backend_fingerprints(summary, tokens);
    print_cache_contract_snapshot();
    print(try keywords.get("fn"));

    keywords.deinit();
    diagnostic.deinit();
    tokens.deinit();
    return void;
}

// run_diagnostics executes the diagnostic-only compiler path.
fn run_diagnostics(source: []const u8) -> !void {
    let tokens = try lex_source(source);

    try print_diagnostic_snapshot(tokens);
    tokens.deinit();
    return void;
}

// source_path_from_process returns the input path passed to the prototype CLI.
fn source_path_from_process() -> ![]const u8 {
    if std::process::arg_count() > 0 {
        return try std::process::arg(0);
    }
    return "selfhost/fixtures/simple.kizu";
}

// diagnostics_mode reports whether the prototype CLI should stop after diagnostics.
fn diagnostics_mode() -> !bool {
    if std::process::arg_count() > 1 {
        let mode = try std::process::arg(1);
        return std::mem::equal_bytes("--diagnostics", mode);
    }
    return false;
}

// validate_source_path checks path helpers needed by compiler diagnostics.
fn validate_source_path(source_path: []const u8) -> ![]const u8 {
    let clean = std::path::clean(source_path);
    let extension = std::path::extension(clean);
    let basename = std::path::basename(clean);

    try std::testing::expect_equal_bytes(".kizu", extension);
    try std::testing::expect(std::mem::len(basename) > 0);
    return clean;
}

// load_source reads one source file through the explicit-Io filesystem API.
fn load_source(io: Io, source_path: []const u8) -> ![]const u8 {
    try std::testing::expect(try std::fs::exists(io, source_path));
    let metadata = try std::fs::metadata(io, source_path);
    try std::testing::expect_equal_bool(false, metadata.is_dir);
    return try std::fs::read_file(io, source_path);
}

// print_source_summary writes path diagnostics through explicit stdio.
fn print_source_summary(io: Io, source_path: []const u8) -> !void {
    try std::io::write_stdout(io, "source:");
    print(std::path::basename(source_path));
    print(std::path::dirname(source_path));
    return void;
}

// main runs a deterministic file-backed skeleton smoke test.
fn main() -> !void {
    let io = std::io::blocking();
    let source_path = try source_path_from_process();
    let clean = try validate_source_path(source_path);
    let source = try load_source(io, clean);

    try print_source_summary(io, clean);
    try run_lexer_self_tests();
    if try diagnostics_mode() {
        try run_diagnostics(source);
        return void;
    }
    try run_frontend(source);
    return void;
}
