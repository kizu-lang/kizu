struct Pair {
    left: i64,
    right: i64,
}

struct Offset {
    base: i64,
}

impl Pair {
    fn score(self: Pair, amount: i64) -> i64 {
        return self.left + self.right + amount;
    }
}

impl Offset {
    fn score(self: Offset, amount: i64) -> i64 {
        return self.base - amount;
    }
}

fn main() {
    let pair = Pair { left: 10, right: 20 };
    let offset = Offset { base: 50 };
    print(pair.score(7));
    print(offset.score(8));
}
