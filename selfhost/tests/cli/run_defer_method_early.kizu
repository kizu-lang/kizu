struct Trace {
    label: []u8,
}

impl Trace {
    fn deinit(self: Trace) -> void {
        print(self.label);
    }
}

fn run() -> i64 {
    let a = Trace { label: "a" };
    defer a.deinit();
    let b = Trace { label: "b" };
    defer b.deinit();

    if true {
        let c = Trace { label: "c" };
        defer c.deinit();
        return 9;
    }

    return 0;
}

fn main() {
    print(run());
}
