struct Point {
    x: i64,
    y: i64,
}

struct Label {
    ok: bool,
    name: []u8,
}

struct Box {
    point: Point,
    label: Label,
}

struct Wrap {
    box: Box,
    extra: i64,
}

fn shift(point: Point, amount: i64) -> Point {
    return Point { x: point.x + amount, y: point.y + amount };
}

fn pass(wrap: Wrap) -> Wrap {
    return wrap;
}

fn main() {
    var wrap = Wrap {
        box: Box {
            point: Point { x: 1, y: 2 },
            label: Label { ok: true, name: "deep" },
        },
        extra: 5,
    };
    let next = Box {
        point: Point { x: 11, y: 12 },
        label: Label { ok: false, name: "alt" },
    };
    wrap.box = next;
    print(wrap.box.label.name);
    print(wrap.box.point.x + wrap.box.point.y + wrap.extra);
    let out = pass(wrap);
    print(out.box.label.ok);
    print(out.box.point.y);
}
