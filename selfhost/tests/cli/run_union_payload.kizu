union Shape {
    Point,
    Circle(i64),
    Label([]u8),
}

fn main() {
    let circle = Shape::Circle(10);
    match circle {
        Point => print("point"),
        Circle(radius) => print(radius),
        Label(text) => print(text),
    }
    let label = Shape::Label("name");
    match label {
        Point => print("point"),
        Circle(radius) => print(radius),
        Label(text) => print(text),
    }
    let point = Shape::Point;
    match point {
        Point => print("point"),
        _ => print("other"),
    }
}
