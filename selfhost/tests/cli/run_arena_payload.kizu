struct Payload {
    active: bool,
    label: []u8,
}

fn main() {
    let allocator = std::mem::page_allocator();
    let payloads = std::arena::Arena<Payload>(allocator);
    let first = payloads.add(Payload { active: true, label: "alpha" });
    print(payloads.get(first).active);
    print(payloads.get(first).label);
    payloads.deinit();
}
