fn main() {
    let name = "kizu";
    if std::mem::equal_bytes(name, "kizu") {
        print("same");
    } else {
        print("diff");
    }
    if std::mem::equal_bytes(name, "ki") {
        print("bad-len");
    } else {
        print("len-diff");
    }
    if std::mem::equal_bytes(name, "kiza") {
        print("bad-byte");
    } else {
        print("byte-diff");
    }
}
