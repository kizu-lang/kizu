fn main() -> !void {
    let allocator = std::mem::page_allocator();
    let first_result = std::mem::Box<i64>(allocator, 7);
    let first = try first_result;
    let second_result = std::mem::Box<i64>(allocator, 11);
    let second = try second_result;
    let a = first.borrow();
    let b = second.borrow();
    print(a.*);
    print(a.* + b.*);
    second.deinit();
    first.deinit();
    return;
}
