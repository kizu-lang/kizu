enum Kind { A, B }

fn check_eq(v: Kind) -> bool {
    return v == Kind::A;
}

fn check_ne(v: Kind) -> bool {
    return v != Kind::A;
}

fn main() -> void {
    if check_eq(Kind::A) { print(1); } else { print(0); }
    if check_eq(Kind::B) { print(1); } else { print(0); }
    if check_ne(Kind::A) { print(1); } else { print(0); }
    if check_ne(Kind::B) { print(1); } else { print(0); }
}
