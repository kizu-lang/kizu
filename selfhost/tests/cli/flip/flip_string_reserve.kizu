fn main() -> !void {
    var s = std::string::String(std::mem::page_allocator());
    try s.append_bytes("hello");
    // reserve is a capacity hint: it must never change length or bytes.
    try s.reserve(64);
    print(s.len());
    let head = s.as_bytes();
    print(head);
    try s.append_bytes("world");
    try s.reserve(0);
    print(s.len());
    let full = s.as_bytes();
    print(full);
    return;
}
