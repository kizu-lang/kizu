fn main() -> !void {
    let bytes = "  lexer token  ";

    // std::mem::len over a str literal and a []u8 slice.
    print(std::mem::len(bytes));

    // std::mem::trim_ascii trims ASCII whitespace from both ends; no-op,
    // leading-only, and trailing-only shapes confirm the head/tail scans.
    let trimmed = std::mem::trim_ascii(bytes);
    print(trimmed);
    print(std::mem::len(trimmed));
    print(std::mem::trim_ascii("nospace"));
    print(std::mem::trim_ascii("  lead"));
    print(std::mem::trim_ascii("trail  "));
    print(std::mem::len(std::mem::trim_ascii("     ")));

    // std::mem::starts_with: matching prefix, mismatch, exact, and a prefix
    // longer than the bytes (false), plus the empty-prefix true case.
    print(std::mem::starts_with(trimmed, "lex"));
    print(std::mem::starts_with(trimmed, "xyz"));
    print(std::mem::starts_with("lexer", "lexer"));
    print(std::mem::starts_with("ab", "abc"));
    print(std::mem::starts_with("abc", ""));

    // std::mem::slice: const bounds, variable bounds, full span, and a nested
    // sub-slice of a slice.
    let head = try std::mem::slice(trimmed, 0, 5);
    print(head);
    let start = 6;
    let end = std::mem::len(trimmed);
    let tail = try std::mem::slice(trimmed, start, end);
    print(tail);
    let inner = try std::mem::slice(tail, 0, 5);
    print(inner);

    // std::mem::byte_at: const index, variable index, and arithmetic on the
    // extracted byte (cast<i64> mirrors the example/run shape).
    let first = try std::mem::byte_at(head, 0);
    print(cast<i64>(first));
    let i = 4;
    let last = try std::mem::byte_at(head, i);
    print(cast<i64>(last));
    return;
}
