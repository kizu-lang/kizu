fn id(s: std::string::String) -> std::string::String {
    return s;
}

fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var source = std::string::String(allocator);
    try source.append_bytes("owned param");
    var result = id(source);
    let bytes = result.as_bytes();
    print(bytes);
    result.deinit();
    return;
}
