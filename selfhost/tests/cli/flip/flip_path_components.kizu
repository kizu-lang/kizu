fn main() -> !void {
    // std::path::basename returns the final slash-separated element. Cases cover
    // the empty path ("."), the bare root ("/"), a trailing-slash path, a single
    // element, leading/collapsed slashes, all-slashes ("/"), and an absolute path.
    print(std::path::basename(""));
    print(std::path::basename("/"));
    print(std::path::basename("a/b/"));
    print(std::path::basename("a"));
    print(std::path::basename("//a"));
    print(std::path::basename("///"));
    print(std::path::basename("a//b"));
    print(std::path::basename("/abs/path"));

    // std::path::dirname returns all but the final element. Cases cover empty
    // ("."), root ("/"), trailing slash, a single element ("."), the slash-at-0
    // root ("/"), a nested absolute path, collapsed leading slashes, and the
    // example path.
    print(std::path::dirname(""));
    print(std::path::dirname("/"));
    print(std::path::dirname("a/b/"));
    print(std::path::dirname("a"));
    print(std::path::dirname("/a"));
    print(std::path::dirname("/a/b"));
    print(std::path::dirname("//a"));
    print(std::path::dirname("a//b"));
    print(std::path::dirname("examples/fixtures/config.txt"));

    // std::path::extension returns the final extension, empty when none. Cases
    // cover empty, root, trailing slash (no extension), a multi-dot name (last
    // extension only), a dotfile (whole name is the extension), no dot, a dot in
    // a directory component (no file extension), and a trailing dot.
    print(std::path::extension(""));
    print(std::path::extension("/"));
    print(std::path::extension("a/b/"));
    print(std::path::extension("archive.tar.gz"));
    print(std::path::extension(".profile"));
    print(std::path::extension("noext"));
    print(std::path::extension("dir.d/file"));
    print(std::path::extension("a."));
    return;
}
