fn main() -> !void {
    var xs = std::array::Array<i64>(std::mem::page_allocator());
    try xs.append(10);
    try xs.append(20);
    try xs.append(30);
    try xs.set(0, 99);
    let i = 1;
    let v = 50;
    try xs.set(i, v);
    try xs.set(2, i + v + 7);
    let a = try xs.get(0);
    let b = try xs.get(1);
    let c = try xs.get(2);
    print(a);
    print(b);
    print(c);
    return;
}
