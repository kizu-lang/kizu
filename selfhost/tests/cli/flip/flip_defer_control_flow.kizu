struct Marker {
    label: []u8,
}

impl Marker {
    fn deinit(self: Marker) -> void {
        print(self.label);
    }
}

fn branch(flag: bool) {
    let marker = Marker { label: "branch-clean" };
    defer marker.deinit();
    if flag {
        return;
    }
    print("branch-body");
}

fn main() {
    branch(false);
    let outer = Marker { label: "outer-clean" };
    defer outer.deinit();
    outer_loop: while true {
        let loop_marker = Marker { label: "loop-clean" };
        defer loop_marker.deinit();
        while true {
            let inner = Marker { label: "inner-clean" };
            defer inner.deinit();
            print("loop-body");
            break :outer_loop;
        }
    }
    print("after-loop");
}
