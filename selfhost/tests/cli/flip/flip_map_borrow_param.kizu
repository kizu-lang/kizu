fn define(symbols: &var std::map::Map<[]u8, i64>) -> !void {
    try symbols.insert("count", 2);
    return;
}

fn lookup(symbols: &std::map::Map<[]u8, i64>) -> !i64 {
    return try symbols.get("count");
}

fn main() -> !void {
    var symbols = std::map::Map<[]u8, i64>(std::mem::page_allocator());
    try define(symbols);
    print(try lookup(&symbols));
    print(symbols.contains("count"));
    print(symbols.len());
    symbols.deinit();
    return;
}
