fn main() -> !void {
    let seen = std::map::Map<[]u8, bool>(std::mem::page_allocator());
    try seen.insert("alpha", true);
    try seen.insert("beta", false);
    print(try seen.get("alpha"));
    print(try seen.get("beta"));
    print(seen.contains("alpha"));
    print(seen.contains("gamma"));
    print(seen.len());
    let v = try seen.get("alpha");
    if v {
        print(111);
    }
    let w = try seen.get("beta");
    if w {
        print(222);
    }
    if !w {
        print(333);
    }
    seen.deinit();
    return;
}
