enum SymbolKind {
    Function,
    Variable,
    Type,
}

fn main() -> !void {
    let symbols = std::map::Map<[]u8, SymbolKind>(std::mem::page_allocator());
    try symbols.insert("main", SymbolKind::Function);
    try symbols.insert("count", SymbolKind::Variable);

    let found = try symbols.get("count");
    print(found);
    let rank = match found {
        Function => 1,
        Variable => 2,
        Type => 3,
    };
    print(rank);
    print(try symbols.get("main"));
    print(symbols.contains("missing"));
    symbols.deinit();
    return;
}
