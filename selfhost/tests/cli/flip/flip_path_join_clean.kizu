fn main() -> !void {
    let allocator = std::mem::page_allocator();

    var source = try std::path::join(allocator, "examples", "fixtures/config.txt");
    let source_bytes = source.as_bytes();
    print(source_bytes);

    var absolute = try std::path::join(allocator, "/a", "../b/");
    let absolute_bytes = absolute.as_bytes();
    print(absolute_bytes);

    var cleaned = try std::path::clean(allocator, "a//./b/../c/");
    let cleaned_bytes = cleaned.as_bytes();
    print(cleaned_bytes);

    var parent = try std::path::clean(allocator, "../a/..");
    let parent_bytes = parent.as_bytes();
    print(parent_bytes);

    source.deinit();
    absolute.deinit();
    cleaned.deinit();
    parent.deinit();
    return;
}
