fn main() -> !void {
    var s = std::string::String(std::mem::page_allocator());
    try s.append_bytes("hello");
    let full = s.len();
    try s.truncate(full);
    print(s.len());
    let capacity = s.capacity();
    try s.truncate(3);
    let prefix = s.as_bytes();
    print(prefix);
    print(s.len());
    print(s.capacity() == capacity);
    try s.truncate(0);
    print(s.len());
    try s.append_bytes("abcdef");
    let middle = s.len() - 2;
    try s.truncate(middle);
    let middle_slice = s.as_bytes();
    print(middle_slice);
    print(s.len());
    return;
}
