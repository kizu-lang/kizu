fn main() {
    let b = "lexer token";
    let high = b[6..];
    print(high);
    let low = b[..5];
    print(low);
    let n = 3;
    let m = 9;
    let high_var = b[n..];
    print(high_var);
    let low_var = b[..m];
    print(low_var);
    let high_zero = b[0..];
    print(high_zero);
    let closed = b[2..7];
    print(closed);
}
