fn main() -> !void {
    var text = std::string::String(std::mem::page_allocator());
    try text.append_bytes("hi");
    print(text.len());
    text.clear();
    print(text.len());
    try text.append_bytes("world");
    let bytes = text.as_bytes();
    print(bytes);
    print(text.len());
    text.clear();
    print(text.len());
    text.deinit();
    return;
}
