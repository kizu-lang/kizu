fn set(s: &var []u8) {
    s.* = "world";
}

fn replace(s: &var []u8, v: []u8) {
    s.* = v;
}

fn read_back(s: &var []u8) -> []u8 {
    return s.*;
}

fn main() {
    var b = "hello";
    print(b);
    set(&var b);
    print(b);
    set(b);
    print(b);
    replace(&var b, "kizu");
    print(b);
    let cur = read_back(&var b);
    print(cur);
    b = "tail";
    print(b);
}
