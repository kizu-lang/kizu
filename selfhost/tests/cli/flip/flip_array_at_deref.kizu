fn main() -> !void {
    var xs = std::array::Array<i64>(std::mem::page_allocator());
    try xs.append(10);
    try xs.append(20);
    try xs.append(30);
    let i = 1;
    let a = try xs.at(0);
    let b = try xs.at(i);
    let c = try xs.at(i + 1);
    print(a.*);
    print(b.* + c.*);
    print(a.* + b.* + c.*);
    return;
}
