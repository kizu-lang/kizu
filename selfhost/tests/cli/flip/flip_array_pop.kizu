fn main() -> !void {
    var xs = std::array::Array<i64>(std::mem::page_allocator());
    try xs.append(10);
    try xs.append(20);
    try xs.append(30);
    let first = try xs.pop();
    let len_after_first = xs.len();
    let second = try xs.pop();
    try xs.append(first + second);
    let third = try xs.pop();
    let len_after_third = xs.len();
    let fourth = try xs.pop();
    print(first);
    print(len_after_first);
    print(second + fourth);
    print(third);
    print(len_after_third);
    return;
}
