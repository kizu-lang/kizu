fn main() -> !void {
    let allocator = std::mem::page_allocator();
    var text = std::string::String(allocator);

    try std::fmt::append_bytes_literal(text, "line
	tab\slash");
    try text.append_byte(cast<u8>(32));
    try std::fmt::append_bytes_literal(
        text,
        \\quote " mark
    );

    let bytes = text.as_bytes();
    print(bytes);
    return;
}
