fn main() -> !void {
    let io = std::io::blocking();
    let dir = "/tmp/kizu_flip_fs_basics_probe";
    // Idempotent create: only create the probe directory when it is absent so the
    // gate's baseline and flip runs (the same fixture executed consecutively) never
    // collide on os.Mkdir, and so the temp path under /tmp leaves the working tree
    // untouched.
    let existed = try std::fs::exists(io, dir);
    if !existed {
        try std::fs::create_dir(io, dir);
    }
    // exists: the probe directory is present after the guarded create; a sibling
    // path is absent.
    print(try std::fs::exists(io, dir));
    print(try std::fs::exists(io, "/tmp/kizu_flip_fs_basics_absent"));
    // metadata: the directory reports is_dir = true.
    let dinfo = try std::fs::metadata(io, dir);
    print(dinfo.is_dir);
    // metadata on a committed regular file (the gate runs from the repo root):
    // is_dir = false plus a size. Parity compares the baseline vs flip runs of the
    // same file, so the byte count agrees deterministically.
    let finfo = try std::fs::metadata(io, "go.mod");
    print(finfo.is_dir);
    print(finfo.size);
    return;
}
