fn main() {
    let age = 30;
    let admin = false;
    if age >= 20 and age < 130 {
        print("and-ok");
    }
    if (age < 20 and admin) or age == 30 {
        print("or-ok");
    }
    if !admin {
        print("not-ok");
    }
    let x = 0;
    if x != 0 and 100 / x > 0 {
        print("unexpected");
    } else {
        print("guarded");
    }
}
