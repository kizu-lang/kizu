union Shape {
    Point,
    Circle(i64),
    Label([]u8),
}

fn pick(kind: i64) -> Shape {
    if kind == 1 {
        return Shape::Circle(7);
    }
    if kind == 2 {
        return Shape::Label("ring");
    }
    return Shape::Point;
}

fn describe(shape: &Shape) -> void {
    match shape {
        Point => print("point"),
        Circle(radius) => print(radius),
        Label(text) => print(text),
    }
}

fn main() {
    let circle = pick(1);
    let label = pick(2);
    describe(circle);
    describe(label);
    let point = pick(0);
    match point {
        Point => print("point"),
        _ => print("other"),
    }
}
