enum Pair {
    X,
    Y,
}

fn classify(a: Pair, b: Pair) -> i64 {
    return match a {
        X => match b {
            X => 1,
            Y => 2,
        },
        Y => 3,
    };
}

fn main() {
    print(classify(Pair::X, Pair::X));
    print(classify(Pair::X, Pair::Y));
    print(classify(Pair::Y, Pair::X));
}
