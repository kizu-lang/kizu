fn main() -> !void {
    var xs = std::array::Array<i64>(std::mem::page_allocator());
    try xs.append(10);
    try xs.append(20);
    try xs.append(30);
    var i = 0;
    var total = 0;
    while i < 3 {
        let v = try xs.get(i);
        total = total + v;
        i = i + 1;
    }
    print(total);
    xs.deinit();
    return;
}
