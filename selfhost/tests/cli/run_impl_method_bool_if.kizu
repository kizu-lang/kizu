struct Gauge {
    value: i64,
}

impl Gauge {
    fn over(self: Gauge, limit: i64) -> bool {
        return self.value > limit;
    }
}

fn main() {
    let gauge = Gauge { value: 20 };
    if gauge.over(10) {
        print("high");
    } else {
        print("low");
    }
    if gauge.over(50) {
        print("high");
    } else {
        print("low");
    }
}
