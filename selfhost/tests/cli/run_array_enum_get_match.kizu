enum Color {
    Red,
    Green,
    Blue,
}

fn main() -> !void {
    var palette = std::array::Array<Color>(std::mem::page_allocator());
    try palette.append(Color::Green);
    let c = try palette.get(0);
    let rank = match c {
        Red => 1,
        Green => 2,
        Blue => 3,
    };
    print(rank);
    palette.deinit();
    return;
}
