fn equal(left: i64, right: i64) -> bool {
    return left == right;
}

fn different(left: i64, right: i64) -> bool {
    return left != right;
}

fn main() {
    let same = equal(5, 5);
    print(same);
    print(different(5, 5));
    if different(5, 4) {
        print("diff");
    } else {
        print("same");
    }
}
