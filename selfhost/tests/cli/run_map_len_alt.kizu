fn main() -> !void {
    var table = std::map::Map<[]u8, i64>(std::mem::page_allocator());
    print(table.len());
    try table.insert("first", 10);
    let after_first = table.len();
    try table.insert("second", 20);
    if table.len() == after_first + 1 {
        print(table.len() + 40);
    } else {
        print(0);
    }
    return;
}
