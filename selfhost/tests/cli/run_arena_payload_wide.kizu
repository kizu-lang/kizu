struct PayloadWide {
    label: []u8,
    extra: []u8,
}

fn main() {
    let allocator = std::mem::page_allocator();
    let payloads = std::arena::Arena<PayloadWide>(allocator);
    let first = payloads.add(PayloadWide { label: "omega", extra: "delta" });
    print(payloads.get(first).label);
    print(payloads.get(first).extra);
    payloads.deinit();
}
