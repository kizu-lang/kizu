enum Color {
    Red,
    Green,
    Blue,
}

fn main() -> !void {
    var palette = std::array::Array<Color>(std::mem::page_allocator());
    try palette.append(Color::Blue);
    try palette.append(Color::Red);
    try palette.append(Color::Green);
    let a = try palette.get(0);
    print(a);
    let b = try palette.get(1);
    print(b);
    let c = try palette.get(2);
    print(c);
    palette.deinit();
    return;
}
