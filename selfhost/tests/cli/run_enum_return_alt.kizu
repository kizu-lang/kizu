enum Verdict {
    Pending,
    Success,
    Retry,
}

fn decide(code: i64) -> Verdict {
    if code == 1 {
        return Verdict::Success;
    }
    if code == 2 {
        return Verdict::Retry;
    }
    return Verdict::Pending;
}

fn main() {
    let first = decide(2);
    match first {
        Pending => print("pending"),
        Success => print("success"),
        Retry => print("retry"),
    }

    let second = decide(1);
    match second {
        Pending => print("pending"),
        Success => print("success"),
        _ => print("other"),
    }
}
