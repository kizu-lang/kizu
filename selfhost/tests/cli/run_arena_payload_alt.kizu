struct PayloadAlt {
    label: []u8,
    code: i64,
}

fn main() {
    let allocator = std::mem::page_allocator();
    let payloads = std::arena::Arena<PayloadAlt>(allocator);
    let first = payloads.add(PayloadAlt { label: "zulu", code: 42 });
    print(payloads.get(first).label);
    print(payloads.get(first).code);
    payloads.deinit();
}
