struct Inner {
    value: i64,
}

struct Outer {
    inner: Inner,
    label: []u8,
}

fn double(n: i64) -> i64 {
    return n * 2;
}

fn main() {
    let outer = Outer {
        inner: Inner { value: 21 },
        label: "deep",
    };
    print(double(outer.inner.value));
    print(outer.label);
}
