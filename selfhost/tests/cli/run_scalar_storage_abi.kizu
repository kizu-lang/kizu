fn main() -> !void {
    let allocator = std::mem::page_allocator();

    var bytes = std::array::Array<u8>(allocator);
    try bytes.append(65);
    try bytes.append(66);
    std::testing::expect_equal<i64>(2, bytes.len());
    std::testing::expect_equal<i64>(65, cast<i64>(try bytes.get(0)));
    std::testing::expect_equal<i64>(66, cast<i64>(try bytes.get(1)));
    try bytes.set(0, 67);
    std::testing::expect_equal<i64>(67, cast<i64>(try bytes.get(0)));
    std::testing::expect_equal<i64>(66, cast<i64>(bytes.get_or_panic(1)));
    std::testing::expect_equal<i64>(66, cast<i64>(try bytes.pop()));

    var signed_values = std::array::Array<i32>(allocator);
    try signed_values.append(-7);
    try signed_values.set(0, -9);
    std::testing::expect_equal<i64>(-9, cast<i64>(try signed_values.get(0)));
    std::testing::expect_equal<i64>(-9, cast<i64>(signed_values.get_or_panic(0)));
    std::testing::expect_equal<i64>(-9, cast<i64>(try signed_values.pop()));

    let byte_channel = std::channel::Channel<u8>();
    byte_channel.send(255);
    std::testing::expect_equal<i64>(255, cast<i64>(byte_channel.recv()));

    let signed_channel = std::channel::Channel<i32>();
    signed_channel.send(-1);
    std::testing::expect_equal<i64>(-1, cast<i64>(signed_channel.recv()));

    signed_values.deinit();
    bytes.deinit();
    return;
}
