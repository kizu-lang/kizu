struct Pair {
    left: i64,
    right: i64,
}

struct Label {
    ok: bool,
    name: []u8,
}

fn add_pair(pair: Pair, extra: i64) -> i64 {
    return pair.left + pair.right + extra;
}

fn score(label: Label, extra: i64) -> i64 {
    if label.ok {
        print(label.name);
        return extra + 1;
    }
    return extra;
}

fn main() {
    let first = Pair { left: 2, right: 5 };
    print(add_pair(first, 3));
    print(score(Label { ok: true, name: "ready" }, 4));
}
