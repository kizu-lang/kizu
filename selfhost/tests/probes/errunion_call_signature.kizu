// errunion_call_signature -- a `-> !i64` function whose whole body is `return g(x);`
// with g returning a bare i64. The signature the definition emits and the one its call
// sites emit must be the same, and the declaration is what settles it.
// site: lower_call_return_function; the emitter took its return type from the call it
// was lowering instead of from the declaration.
// history: this probe does NOT discriminate by value. At bfb7ba74 the staged module
// carries `define i64 @..._wrapped_double` against `call %kizu.error.i64 @..._wrapped_double`
// and LLVM reads it anyway; the wrapper's value cannot reach the driver, because an
// error union has no i64 ABI and an i64 function cannot unwrap one. What the probe
// buys is the pair being IN the staged module, where a signature scan can see it.
// probe-calls: probe_errunion_call_signature(6)
// probe-reach: wrapped_double(6)

pub fn plain_double(a: i64) -> i64 {
    return a * 2;
}

pub fn wrapped_double(a: i64) -> !i64 {
    return plain_double(a);
}

pub fn probe_errunion_call_signature(a: i64) -> i64 {
    return a * 10 + 7;
}

fn main() -> !void {
    try wrapped_double(6);
    print(probe_errunion_call_signature(6));
    return;
}
