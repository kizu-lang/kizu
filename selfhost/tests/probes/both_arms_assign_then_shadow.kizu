// both_arms_assign_then_shadow -- both arms assign the enclosing var, then shadow it.
// site: two-predecessor join carry.
// history: 225aec97 answered 5001 7001; the Go path answers 5011 7101.
// probe-calls: probe_both_arms_assign_then_shadow(1); probe_both_arms_assign_then_shadow(0)

pub fn probe_both_arms_assign_then_shadow(limit: i64) -> i64 {
    var total = 0;
    var j = 1;
    if limit > 0 {
        j = j + 10;
        var j = 5;
        total = total + j;
    } else {
        j = j + 100;
        var j = 7;
        total = total + j;
    }
    return total * 1000 + j;
}

fn main() -> void {
    print(probe_both_arms_assign_then_shadow(1));
    print(probe_both_arms_assign_then_shadow(0));
    return;
}
