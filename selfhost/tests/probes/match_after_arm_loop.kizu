// match_after_arm_loop -- a match statement reading a scalar an arm's loop carried.
// site: lower_multi_match_statement.
// history: HEAD answered 20 where the Go path answers 420, until 225aec97.
// probe-calls: probe_match_after_arm_loop(1); probe_match_after_arm_loop(0)

pub enum Kind {
    Low,
    High,
}

pub fn probe_match_after_arm_loop(limit: i64) -> i64 {
    var total = 0;
    var j = 20;
    if limit > 0 {
        var j = 0;
        while j < 4 {
            total = total + 1;
            j = j + 1;
        }
    }
    let k = Kind::High;
    return match k {
        Low => total * 10 + j,
        High => total * 100 + j,
    };
}

fn main() -> void {
    print(probe_match_after_arm_loop(1));
    print(probe_match_after_arm_loop(0));
    return;
}
