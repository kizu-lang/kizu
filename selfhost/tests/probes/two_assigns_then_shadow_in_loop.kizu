// two_assigns_then_shadow_in_loop -- two assignments then a shadow, in a loop body.
// site: loop body scope.
// history: refused at 225aec97.
// probe-calls: probe_two_assigns_then_shadow_in_loop(3); probe_two_assigns_then_shadow_in_loop(0)

pub fn probe_two_assigns_then_shadow_in_loop(limit: i64) -> i64 {
    var total = 0;
    var j = 1;
    var i = 0;
    while i < limit {
        j = j + 10;
        j = j + 1;
        var j = 5;
        total = total + j;
        i = i + 1;
    }
    return total * 1000 + j;
}

fn main() -> void {
    print(probe_two_assigns_then_shadow_in_loop(3));
    print(probe_two_assigns_then_shadow_in_loop(0));
    return;
}
