pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn make_pair(a: i64) -> !Pair {
    return Pair { left: a, right: a + 1 };
}

pub fn probe_errunion_struct_return(a: i64) -> i64 {
    return a * 10 + 5;
}

fn main() -> !void {
    try make_pair(4);
    print(probe_errunion_struct_return(4));
    return;
