// clatch_guard_alias -- a continue-latch loop's guard reads a var an if arm ahead of
// the loop reassigned.
// site: lower_multi_while_continue_latch guard lowering.
// history: bfb7ba74 staged 207 202 where the Go path answers 707 202. Closed at a5d61350.
// probe-calls: probe_clatch_guard_alias(1); probe_clatch_guard_alias(0)

pub fn probe_clatch_guard_alias(limit: i64) -> i64 {
    var bound = 2;
    if limit > 0 {
        bound = bound + 5;
    }
    var scan = 0;
    while scan < bound {
        if scan < 20 {
            scan = scan + 1;
            continue;
        }
        return 1;
    }
    return scan * 100 + bound;
}

fn main() -> void {
    print(probe_clatch_guard_alias(1));
    print(probe_clatch_guard_alias(0));
    return;
}
