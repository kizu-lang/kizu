// bm_shadow -- the same branch-merge latch under a shadowed name.
// site: find_induction_init scope.
// history: refused ("loop-carried scalar has no latch value") at 225aec97.
// probe-calls: probe_bm_shadow(1)

pub fn probe_bm_shadow(limit: i64) -> i64 {
    var total = 0;
    var index = 20;
    if limit > 0 {
        var index = 0;
        while index < 6 {
            total = total + 1;
            if total > 3 {
                index = 6;
            } else {
                index = index + 1;
            }
        }
    }
    return total * 1000 + index;
}

fn main() -> void {
    print(probe_bm_shadow(1));
    return;
}
