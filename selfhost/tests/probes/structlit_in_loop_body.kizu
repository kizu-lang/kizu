// structlit_in_loop_body -- a struct-literal field inside a counted loop body reads
// the carried scalar.
// site: lower_struct_fields inside the body block.
// history: control -- correct before and after 225aec97.
// probe-calls: probe_structlit_in_loop_body(3); probe_structlit_in_loop_body(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn probe_structlit_in_loop_body(limit: i64) -> i64 {
    var acc = 1;
    var i = 0;
    while i < limit {
        let p = Pair { left: acc, right: 2 };
        acc = p.left + p.right;
        i = i + 1;
    }
    return acc * 100 + i;
}

fn main() -> void {
    print(probe_structlit_in_loop_body(3));
    print(probe_structlit_in_loop_body(0));
    return;
}
