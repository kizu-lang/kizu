// while_seed_computed -- a plain while loop's induction seed is an expression over a
// var an if arm reassigned, so it lowers through the expression path rather than the
// compact seed loop_seed_alias covers.
// site: lower_multi_while_statement computed seed (init_result_id).
// history: a5d61350 staged 310 310 where the Go path answers 209 310. Closed at 34f0d258.
// probe-calls: probe_while_seed_computed(1); probe_while_seed_computed(0)

pub fn probe_while_seed_computed(limit: i64) -> i64 {
    var base = 0;
    if limit > 0 {
        base = base + 2;
    }
    var i = base + 1;
    var total = 0;
    while i < 8 {
        total = total + 1;
        i = i + 3;
    }
    return total * 100 + i;
}

fn main() -> void {
    print(probe_while_seed_computed(1));
    print(probe_while_seed_computed(0));
    return;
}
