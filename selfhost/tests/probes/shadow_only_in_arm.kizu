// shadow_only_in_arm -- an arm shadows a name and never assigns the enclosing one.
// site: arm join carry.
// history: control -- correct at 225aec97 and after.
// probe-calls: probe_shadow_only_in_arm(1); probe_shadow_only_in_arm(0)

pub fn probe_shadow_only_in_arm(limit: i64) -> i64 {
    var total = 0;
    var j = 1;
    if limit > 0 {
        var j = 5;
        total = total + j;
    }
    return total * 1000 + j;
}

fn main() -> void {
    print(probe_shadow_only_in_arm(1));
    print(probe_shadow_only_in_arm(0));
    return;
}
