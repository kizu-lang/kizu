// bm_top -- a branch-merge latch at the top level: the loop's exit arm assigns the
// induction variable.
// site: lower_multi_while_statement latch merge.
// history: 225aec97 answered 4003; the Go path answers 4006. Closed after 225aec97.
// probe-calls: probe_bm_top(1)

pub fn probe_bm_top(limit: i64) -> i64 {
    var total = 0;
    var index = 0;
    while index < 6 {
        total = total + 1;
        if total > 3 {
            index = 6;
        } else {
            index = index + 1;
        }
    }
    return total * 1000 + index;
}

fn main() -> void {
    print(probe_bm_top(1));
    return;
}
