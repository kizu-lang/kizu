// sp_promote_nested -- the same claim, one block deeper.
// site: single-predecessor join carry.
// history: HEAD emitted invalid LLVM until 225aec97.
// probe-calls: probe_sp_promote_nested(0)

pub fn probe_sp_promote_nested(limit: i64) -> i64 {
    var total = 0;
    var j = 0;
    if limit > 0 {
        return -1;
    } else {
        if limit < 0 {
            return -2;
        } else {
            while j < 4 {
                total = total + 1;
                j = j + 1;
            }
        }
    }
    while j < 9 {
        total = total + 10;
        j = j + 1;
    }
    return total * 100 + j;
}

fn main() -> void {
    print(probe_sp_promote_nested(0));
    return;
}
