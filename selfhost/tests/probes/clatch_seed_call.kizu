// clatch_seed_call -- a continue-latch loop's seed is a call whose argument names a
// var an if arm reassigned. A call spells its arguments inside the instruction, so a
// rename after the fact cannot reach this one.
// site: lower_multi_while_continue_latch hoisted seed call.
// history: bfb7ba74 staged 1002 1000 where the Go path answers 902 1000. Closed at a5d61350.
// probe-calls: probe_clatch_seed_call(1); probe_clatch_seed_call(0)

pub fn seed_of(a: i64) -> i64 {
    return a + 1;
}

pub fn probe_clatch_seed_call(limit: i64) -> i64 {
    var base = 0;
    if limit > 0 {
        base = base + 2;
    }
    var scan = seed_of(base);
    while scan < 8 {
        if scan < 20 {
            scan = scan + 3;
            continue;
        }
        return 1;
    }
    return scan * 100 + base;
}

fn main() -> void {
    print(probe_clatch_seed_call(1));
    print(probe_clatch_seed_call(0));
    return;
}
