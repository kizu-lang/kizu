// while_guard_field_read -- a plain while loop's guard reads a field of a struct var
// an if arm rebound. The read carries a struct type into the guard, which is the case
// a rename that assumed i64 could not carry back out.
// site: lower_multi_while_statement guard lowering.
// history: a5d61350 staged 307 303 where the Go path answers 707 303. Closed at 34f0d258.
// probe-calls: probe_while_guard_field_read(1); probe_while_guard_field_read(0)

pub struct Limits {
    pub lo: i64,
    pub hi: i64,
}

pub fn probe_while_guard_field_read(limit: i64) -> i64 {
    var caps = Limits { lo: 0, hi: 3 };
    if limit > 0 {
        caps = Limits { lo: 0, hi: 7 };
    }
    var i = 0;
    var total = 0;
    while i < caps.hi {
        total = total + 1;
        i = i + 1;
    }
    return total * 100 + caps.hi;
}

fn main() -> void {
    print(probe_while_guard_field_read(1));
    print(probe_while_guard_field_read(0));
    return;
}
