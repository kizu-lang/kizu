// assign_then_shadow_in_arm -- an arm assigns an enclosing var, then shadows it.
// site: arm join carry.
// history: 225aec97 answered 5001 1; the Go path answers 5011 1.
// probe-calls: probe_assign_then_shadow_in_arm(1); probe_assign_then_shadow_in_arm(0)

pub fn probe_assign_then_shadow_in_arm(limit: i64) -> i64 {
    var total = 0;
    var j = 1;
    if limit > 0 {
        j = j + 10;
        var j = 5;
        total = total + j;
    }
    return total * 1000 + j;
}

fn main() -> void {
    print(probe_assign_then_shadow_in_arm(1));
    print(probe_assign_then_shadow_in_arm(0));
    return;
}
