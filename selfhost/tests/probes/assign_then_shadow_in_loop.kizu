pub fn probe_assign_then_shadow_in_loop(limit: i64) -> i64 {
    var total = 0;
    var j = 1;
    var i = 0;
    while i < limit {
        j = j + 10;
        var j = 5;
        total = total + j;
        i = i + 1;
    }
    return total * 1000 + j;
}

fn main() -> void {
    print(probe_assign_then_shadow_in_loop(3));
    print(probe_assign_then_shadow_in_loop(0));
