// structlit_return_arm -- a struct literal whose field reads a scalar a returning arm
// wrote: the struct-field seam crossed with the latch-guard seam.
// site: lower_struct_fields plus loop_body_path_terminates.
// history: hunt9 q3.
// probe-calls: probe_structlit_return_arm(4); probe_structlit_return_arm(1)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn probe_structlit_return_arm(limit: i64) -> i64 {
    var acc = 1;
    var i = 0;
    while i < limit {
        if i > 1 {
            acc = acc + 5;
            let p = Pair { left: acc, right: 2 };
            return p.left * 10 + p.right;
        }
        i = i + 1;
    }
    return acc * 100 + i;
}

fn main() -> void {
    print(probe_structlit_return_arm(4));
    print(probe_structlit_return_arm(1));
    return;
}
