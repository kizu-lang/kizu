// while_secondary_seed -- a plain while loop's secondary counter is seeded from a var
// an if arm reassigned.
// site: lower_multi_while_statement secondary_init_var.
// history: a5d61350 staged 1005 1005 where the Go path answers 1305 1005. Closed at 34f0d258.
// probe-calls: probe_while_secondary_seed(1); probe_while_secondary_seed(0)

pub fn probe_while_secondary_seed(limit: i64) -> i64 {
    var base = 0;
    if limit > 0 {
        base = base + 3;
    }
    var mark = base;
    var i = 0;
    while i < 5 {
        mark = mark + 2;
        i = i + 1;
    }
    return mark * 100 + i;
}

fn main() -> void {
    print(probe_while_secondary_seed(1));
    print(probe_while_secondary_seed(0));
    return;
}
