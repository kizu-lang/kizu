// leading_decrement_claim -- a leading-decrement loop whose counter name an arm's loop
// head already claimed. The body ends in an if, because a trailing assign would make
// the loop a trailing-latch loop instead.
// site: lower_multi_while_leading_decrement claim registry.
// history: 225aec97 emitted a module LLVM rejects (multiple definition of local
// value named 'cursor'). Closed at a8d6ffbd.
// probe-calls: probe_leading_decrement_claim(1); probe_leading_decrement_claim(0)

pub fn probe_leading_decrement_claim(limit: i64) -> i64 {
    var total = 0;
    var cursor = 0;
    if limit > 0 {
        while cursor < 3 {
            total = total + 2;
            cursor = cursor + 1;
        }
    }
    cursor = cursor + 3;
    while cursor > 0 {
        cursor = cursor - 1;
        if cursor > 0 {
            total = total + 100;
        }
    }
    return total * 100 + cursor;
}

fn main() -> void {
    print(probe_leading_decrement_claim(1));
    print(probe_leading_decrement_claim(0));
    return;
}
