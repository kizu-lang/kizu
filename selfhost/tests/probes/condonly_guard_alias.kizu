// condonly_guard_alias -- a condition-only while whose guard calls a function with a
// var an if arm ahead of the loop reassigned. A call spells its argument inside the
// instruction, so a rename after the fact cannot reach it. The body is an if, because
// a bare return there is a body statement this lowering refuses.
// site: lower_multi_while_condition_only guard lowering.
// history: a5d61350 staged 501 500 where the Go path answers 5001 500. Closed at 34f0d258.
// probe-calls: probe_condonly_guard_alias(1); probe_condonly_guard_alias(0)

pub fn cap_of(a: i64) -> i64 {
    return a + 4;
}

pub fn probe_condonly_guard_alias(limit: i64) -> i64 {
    var flag = 0;
    if limit > 0 {
        flag = flag + 1;
    }
    var total = 5;
    while cap_of(flag) > 4 {
        if flag > 0 {
            return total * 1000 + flag;
        }
    }
    return total * 100 + flag;
}

fn main() -> void {
    print(probe_condonly_guard_alias(1));
    print(probe_condonly_guard_alias(0));
    return;
}
