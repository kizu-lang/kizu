// shadow_and_return -- an arm that shadows a name and returns.
// site: an if whose then block returns keeps its else arm.
// history: refused at 225aec97.
// probe-calls: probe_shadow_and_return(3); probe_shadow_and_return(0)

pub fn probe_shadow_and_return(limit: i64) -> i64 {
    var total = 0;
    var j = 1;
    var i = 0;
    while i < limit {
        if i > 5 {
            j = j + 7;
            return j * 3;
        }
        j = j + 10;
        var j = 5;
        total = total + j;
        i = i + 1;
    }
    return total * 1000 + j;
}

fn main() -> void {
    print(probe_shadow_and_return(3));
    print(probe_shadow_and_return(0));
    return;
}
