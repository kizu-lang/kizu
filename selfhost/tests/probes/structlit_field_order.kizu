// probe-calls: probe_structlit_field_order()

pub struct Triple {
    pub a: i64,
    pub b: i64,
    pub c: i64,
}

pub fn probe_structlit_field_order() -> i64 {
    let t = Triple { c: 3, a: 1, b: 2 };
    return t.a * 100 + t.b * 10 + t.c;
}

fn main() -> void {
    print(probe_structlit_field_order());
    return;
}
