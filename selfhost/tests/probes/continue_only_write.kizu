// continue_only_write -- the ONLY write of the carried scalar sits in an arm that
// continues, so no merge name exists and the latch resolves to the head name.
// site: the loop-carried latch refusal 225aec97 replaced with a reaching-write test.
// history: hunt9 q3.
// probe-calls: probe_continue_only_write(5); probe_continue_only_write(1)

pub fn probe_continue_only_write(limit: i64) -> i64 {
    var acc = 1;
    var i = 0;
    while i < limit {
        if i > 1 {
            acc = acc + 5;
            i = i + 1;
            continue;
        }
        i = i + 1;
    }
    return acc * 100 + i;
}

fn main() -> void {
    print(probe_continue_only_write(5));
    print(probe_continue_only_write(1));
    return;
}
