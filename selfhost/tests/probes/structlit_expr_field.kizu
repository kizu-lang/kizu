// structlit_expr_field -- the same field, expression-valued, so it routes through
// the generic let-expression path that does consult aliases.
// site: lower_multi_let_statement_named generic expression branch.
// history: wrong answer until 225aec97; control for structlit_if_merge.
// probe-calls: probe_structlit_expr_field(1); probe_structlit_expr_field(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn probe_structlit_expr_field(limit: i64) -> i64 {
    var base = 3;
    if limit > 0 {
        base = base + 4;
    } else {
        base = base + 9;
    }
    let p = Pair { left: base + 0, right: 1 };
    return p.left;
}

fn main() -> void {
    print(probe_structlit_expr_field(1));
    print(probe_structlit_expr_field(0));
    return;
}
