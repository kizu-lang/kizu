// structlit_sibling_arm -- a struct literal in an if arm reading a name only the
// other arm's block binds.
// site: lower_struct_fields alias map; the field must not name a register the arm
// does not dominate.
// history: hunt9 q3.
// probe-calls: probe_structlit_sibling_arm(1); probe_structlit_sibling_arm(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn probe_structlit_sibling_arm(limit: i64) -> i64 {
    var base = 3;
    var out = 0;
    if limit > 0 {
        base = base + 4;
        out = base * 2;
    } else {
        let p = Pair { left: base, right: 1 };
        out = p.left * 10 + p.right;
    }
    return out * 100 + base;
}

fn main() -> void {
    print(probe_structlit_sibling_arm(1));
    print(probe_structlit_sibling_arm(0));
    return;
}
