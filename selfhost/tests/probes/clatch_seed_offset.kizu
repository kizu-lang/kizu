// clatch_seed_offset -- the same continue-latch seed written as base-plus-offset, the
// second of the seed's two spellings.
// site: lower_multi_while_continue_latch seed copy / offset name.
// history: bfb7ba74 staged 1002 1000 where the Go path answers 902 1000. Closed at a5d61350.
// probe-calls: probe_clatch_seed_offset(1); probe_clatch_seed_offset(0)

pub fn probe_clatch_seed_offset(limit: i64) -> i64 {
    var base = 0;
    if limit > 0 {
        base = base + 2;
    }
    var scan = base + 1;
    while scan < 8 {
        if scan < 20 {
            scan = scan + 3;
            continue;
        }
        return 1;
    }
    return scan * 100 + base;
}

fn main() -> void {
    print(probe_clatch_seed_offset(1));
    print(probe_clatch_seed_offset(0));
    return;
}
