// structlit_shadow_and_merge -- a struct literal after an if arm that ran a loop over
// a shadowed name and merged a scalar.
// site: lower_struct_fields where both the merge and the shadow reach the literal.
// history: hunt9 q3; the shadowed name and the merged name are two different values.
// probe-calls: probe_structlit_shadow_and_merge(1); probe_structlit_shadow_and_merge(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn probe_structlit_shadow_and_merge(limit: i64) -> i64 {
    var total = 0;
    var j = 20;
    if limit > 0 {
        var j = 0;
        while j < 4 {
            total = total + 1;
            j = j + 1;
        }
        total = total + 100;
    } else {
        total = total + 7;
    }
    let p = Pair { left: total, right: j };
    return p.left * 1000 + p.right;
}

fn main() -> void {
    print(probe_structlit_shadow_and_merge(1));
    print(probe_structlit_shadow_and_merge(0));
    return;
}
