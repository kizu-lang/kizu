// sp_promote_head -- a loop-head phi name claimed inside an if arm.
// site: the arm's claim is about the function's SSA namespace, not the arm's values;
// publishing the value with the claim seeds a phi from a block the join does not
// dominate, publishing neither lets a later loop bind the name twice.
// history: HEAD emitted invalid LLVM (multiple definition of %j) until 225aec97.
// probe-calls: probe_sp_promote_head(0)

pub fn probe_sp_promote_head(limit: i64) -> i64 {
    var total = 0;
    var j = 0;
    if limit > 0 {
        return -1;
    } else {
        while j < 4 {
            total = total + 1;
            j = j + 1;
        }
    }
    while j < 9 {
        total = total + 10;
        j = j + 1;
    }
    return total * 100 + j;
}

fn main() -> void {
    print(probe_sp_promote_head(0));
    return;
}
