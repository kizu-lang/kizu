// structlit_arm_expr_field -- an if-then `return` whose struct literal has a field that
// needs an instruction stream.
// site: the if-then-return struct literal position.
// history: refused at ed6ba43e and still refused here -- the shape is a live limitation
// of the stage backend, not a closed defect. The call-valued form of the same field is
// accepted at both commits, so nothing in this position discriminates 225aec97.
// probe-calls: probe_structlit_arm_expr_field(4); probe_structlit_arm_expr_field(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn shape_of(a: i64) -> Pair {
    if a > 0 {
        return Pair { left: a * 2 + 1, right: a };
    }
    return Pair { left: 0, right: 0 };
}

pub fn probe_structlit_arm_expr_field(a: i64) -> i64 {
    let p = shape_of(a);
    return p.left * 10 + p.right;
}

fn main() -> void {
    print(probe_structlit_arm_expr_field(4));
    print(probe_structlit_arm_expr_field(0));
    return;
}
