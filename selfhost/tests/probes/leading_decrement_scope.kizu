// leading_decrement_scope -- a leading-decrement loop nested in a loop body, so its
// counter is declared in the block the loop sits in and not at the function root.
// site: lower_multi_while_leading_decrement find_induction_init scope.
// history: refused at a8d6ffbd (missing IR artifact fact: body_child_sequence_from).
// Closed at 67d543f2.
// probe-calls: probe_leading_decrement_scope(3); probe_leading_decrement_scope(0)

pub fn probe_leading_decrement_scope(a: i64) -> i64 {
    var total = 0;
    var i = 0;
    while i < 2 {
        var cursor = a;
        while cursor > 0 {
            cursor = cursor - 1;
            if cursor > 0 {
                total = total + 2;
            }
        }
        i = i + 1;
    }
    return total * 100 + i;
}

fn main() -> void {
    print(probe_leading_decrement_scope(3));
    print(probe_leading_decrement_scope(0));
    return;
}
