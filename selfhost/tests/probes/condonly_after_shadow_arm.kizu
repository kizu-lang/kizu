// condonly_after_shadow_arm -- a condition-only while after an arm that shadowed the
// name its condition reads.
// site: lower_multi_while_condition_only.
// history: HEAD answered 20 where the Go path answers 4020, until 225aec97.
// probe-calls: probe_condonly_after_shadow_arm(1); probe_condonly_after_shadow_arm(0)

pub fn probe_condonly_after_shadow_arm(limit: i64) -> i64 {
    var total = 0;
    var j = 20;
    if limit > 0 {
        var j = 0;
        while j < 4 {
            total = total + 1;
            j = j + 1;
        }
    }
    while j > 5 {
        return total * 1000 + j;
    }
    return total * 100 + j;
}

fn main() -> void {
    print(probe_condonly_after_shadow_arm(1));
    print(probe_condonly_after_shadow_arm(0));
    return;
}
