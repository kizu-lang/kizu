// return_structlit_if_merge -- return-position struct literal whose field reads an
// if-merged var.
// site: lower_return_struct_literal.
// history: control -- correct before and after 225aec97.
// probe-calls: probe_return_structlit_if_merge(1); probe_return_structlit_if_merge(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn make_pair(a: i64, b: i64) -> Pair {
    return Pair { left: a, right: b };
}

pub fn probe_return_structlit_if_merge(limit: i64) -> i64 {
    var base = 3;
    if limit > 0 {
        base = base + 4;
    } else {
        base = base + 9;
    }
    let p = make_pair(base, 1);
    return p.left;
}

fn main() -> void {
    print(probe_return_structlit_if_merge(1));
    print(probe_return_structlit_if_merge(0));
    return;
}
