// loop_seed_alias -- a plain while loop's induction seed and carried seed name a local
// an if arm ahead of the loop reassigned.
// site: lower_multi_while_statement induction_init_var / carried_init_var.
// history: a5d61350 staged 1508 1508 where the Go path answers 1108 1508. Closed at 34f0d258.
// probe-calls: probe_loop_seed_alias(1); probe_loop_seed_alias(0)

pub fn probe_loop_seed_alias(limit: i64) -> i64 {
    var base = 1;
    if limit > 0 {
        base = base + 4;
    }
    var i = base;
    var total = base;
    while i < 8 {
        total = total + 2;
        i = i + 1;
    }
    return total * 100 + i;
}

fn main() -> void {
    print(probe_loop_seed_alias(1));
    print(probe_loop_seed_alias(0));
    return;
}
