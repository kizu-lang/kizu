// secondary_after_arm_claim -- a later loop binds a name an earlier arm claimed.
// site: arm claim registry.
// history: HEAD emitted invalid LLVM until 225aec97.
// probe-calls: probe_secondary_after_arm_claim(2); probe_secondary_after_arm_claim(0)

pub fn probe_secondary_after_arm_claim(limit: i64) -> i64 {
    var total = 0;
    var k = 0;
    if limit > 0 {
        var k = 0;
        while k < 3 {
            total = total + 1;
            k = k + 1;
        }
    }
    var i = 0;
    while i < limit {
        total = total + 2;
        k = k + 4;
        i = i + 1;
    }
    return total * 1000 + k;
}

fn main() -> void {
    print(probe_secondary_after_arm_claim(2));
    print(probe_secondary_after_arm_claim(0));
    return;
}
