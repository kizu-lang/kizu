// continue_carried_arm -- a carried scalar written before a continue nested in an if.
// site: continue latch edge.
// history: latchprobe.
// probe-calls: probe_continue_carried_arm(6)

pub fn bump(a: i64) -> i64 {
    return a + 1;
}

pub fn is_even(a: i64) -> bool {
    return a - (a / 2) * 2 == 0;
}

pub fn probe_continue_carried_arm(limit: i64) -> i64 {
    var i = 0;
    var total = 0;
    var going = true;
    while going {
        let next = bump(i);
        going = next < limit;
        if is_even(i) {
            total = total + 7;
            i = next;
            continue;
        }
        total = total + 1;
        i = next;
    }
    return total * 100 + i;
}

fn main() -> void {
    print(probe_continue_carried_arm(6));
    return;
}
