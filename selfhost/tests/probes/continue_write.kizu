// continue_write -- a carried scalar written in an arm that continues.
// site: loop_body_path_terminates; a continue reaches the latch through the back edge,
// so pruning its write is the one prune that hides a real dropped write.
// history: hunt9 q1, the continue-latch class 225aec97 closed.
// probe-calls: probe_continue_write(4); probe_continue_write(1)

pub fn probe_continue_write(limit: i64) -> i64 {
    var acc = 1;
    var i = 0;
    while i < limit {
        i = i + 1;
        if i > 1 {
            acc = acc + 5;
            continue;
        }
        acc = acc + 1;
    }
    return acc * 100 + i;
}

fn main() -> void {
    print(probe_continue_write(4));
    print(probe_continue_write(1));
    return;
}
