// bm_var_bound -- a branch-merge latch whose bound is a variable.
// site: lower_multi_while_statement latch merge.
// history: 225aec97 answered 4003 2002; the Go path answers 4006 2002.
// probe-calls: probe_bm_var_bound(6); probe_bm_var_bound(2)

pub fn probe_bm_var_bound(limit: i64) -> i64 {
    var total = 0;
    var index = 0;
    while index < limit {
        total = total + 1;
        if total > 3 {
            index = limit;
        } else {
            index = index + 1;
        }
    }
    return total * 1000 + index;
}

fn main() -> void {
    print(probe_bm_var_bound(6));
    print(probe_bm_var_bound(2));
    return;
}
