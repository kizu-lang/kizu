// structlit_loop_exit -- a struct-literal field reads a loop-carried scalar's exit
// value.
// site: lower_struct_fields on the loop-exit edge.
// history: control -- correct before and after 225aec97.
// probe-calls: probe_structlit_loop_exit(3); probe_structlit_loop_exit(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn probe_structlit_loop_exit(limit: i64) -> i64 {
    var acc = 0;
    var i = 0;
    while i < limit {
        acc = acc + 5;
        i = i + 1;
    }
    let p = Pair { left: acc, right: i };
    return p.left * 100 + p.right;
}

fn main() -> void {
    print(probe_structlit_loop_exit(3));
    print(probe_structlit_loop_exit(0));
    return;
}
