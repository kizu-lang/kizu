// nested_shadow_arm_merge -- an arm shadows a name, merges a scalar, and a nested arm
// does it again.
// site: single-predecessor join carry.
// history: HEAD answered 5020 20 20 where the Go path answers 5120 120 20, until 225aec97.
// probe-calls: probe_nested_shadow_arm_merge(2); probe_nested_shadow_arm_merge(1); probe_nested_shadow_arm_merge(0)

pub fn probe_nested_shadow_arm_merge(limit: i64) -> i64 {
    var total = 0;
    var j = 20;
    if limit > 0 {
        if limit > 1 {
            var j = 5;
            total = total + j;
        }
        j = j + 100;
    }
    return total * 1000 + j;
}

fn main() -> void {
    print(probe_nested_shadow_arm_merge(2));
    print(probe_nested_shadow_arm_merge(1));
    print(probe_nested_shadow_arm_merge(0));
    return;
}
