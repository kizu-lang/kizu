// bm_header_exit -- a branch-merge loop whose exit leaves from the header edge.
// site: loop exit phi predecessors.
// history: control -- correct at 225aec97 and after.
// probe-calls: probe_bm_header_exit(1)

pub fn probe_bm_header_exit(limit: i64) -> i64 {
    var total = 0;
    var index = 0;
    while index < 3 {
        total = total + 1;
        if total > 90 {
            index = 3;
        } else {
            index = index + 1;
        }
    }
    return total * 1000 + index;
}

fn main() -> void {
    print(probe_bm_header_exit(1));
    return;
}
