// bm_two_loops -- two branch-merge latches in one function.
// site: lower_multi_while_statement latch merge, twice.
// history: 225aec97 answered 54008; the Go path answers 54011.
// probe-calls: probe_bm_two_loops(1)

pub fn probe_bm_two_loops(limit: i64) -> i64 {
    var total = 0;
    var index = 0;
    while index < 6 {
        total = total + 1;
        if total > 3 {
            index = 6;
        } else {
            index = index + 1;
        }
    }
    var second = 0;
    while second < 5 {
        total = total + 10;
        if total > 100 {
            second = 5;
        } else {
            second = second + 1;
        }
    }
    return total * 1000 + index + second;
}

fn main() -> void {
    print(probe_bm_two_loops(1));
    return;
}
