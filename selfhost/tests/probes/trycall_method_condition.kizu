// trycall_method_condition -- an if condition that is `try <receiver>.<method>(args)`.
// Only the free-function shape of a try-call condition was lowered; a field-mode callee
// needs the method path to claim it and the condition bound ahead of the if.
// site: try-call if condition, field-mode callee.
// history: refused at 225aec97 (positive try-call condition must be a free
// function). Closed at a8d6ffbd.
// probe-calls: probe_trycall_method_condition(20)
// probe-reach: weigh_gauge(20); weigh_gauge(4)

pub struct Gauge {
    pub value: i64,
}

impl Gauge {
    fn over(self: Gauge, limit: i64) -> !bool {
        return self.value > limit;
    }
}

pub fn weigh_gauge(a: i64) -> !i64 {
    let gauge = Gauge { value: a };
    var total = 1;
    if try gauge.over(10) {
        total = total + 40;
    }
    return total;
}

pub fn probe_trycall_method_condition(a: i64) -> i64 {
    return a * 10 + 8;
}

fn main() -> !void {
    try weigh_gauge(20);
    try weigh_gauge(4);
    print(probe_trycall_method_condition(20));
    return;
}
