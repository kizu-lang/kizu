// renamed_continue_write -- the same continue-latch write under a different local
// name, to separate the shape from the spelling.
// site: loop_body_path_terminates.
// history: hunt9.
// probe-calls: probe_renamed_continue_write(3); probe_renamed_continue_write(0)

pub fn is_even(a: i64) -> bool {
    return a - (a / 2) * 2 == 0;
}

pub fn probe_renamed_continue_write(limit: i64) -> i64 {
    var total = 0;
    if limit > 0 {
        var j = 0;
        while j < limit {
            total = total + 100;
            j = j + 1;
        }
    }
    var j = 0;
    var i = 0;
    while i < 6 {
        i = i + 1;
        if is_even(i) {
            continue;
        }
        j = j + 5;
    }
    return total * 100000 + j;
}

fn main() -> void {
    print(probe_renamed_continue_write(3));
    print(probe_renamed_continue_write(0));
    return;
}
