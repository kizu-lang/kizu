// structlit_after_shadow_arm -- a struct-literal field reads a name an if arm's
// loop head shadowed.
// site: lower_struct_fields alias lookup across the arm join.
// history: emitted a module the LLVM verifier rejected ("does not dominate all uses")
// until 225aec97.
// probe-calls: probe_structlit_after_shadow_arm(1); probe_structlit_after_shadow_arm(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn probe_structlit_after_shadow_arm(limit: i64) -> i64 {
    var total = 0;
    var j = 20;
    if limit > 0 {
        var j = 0;
        while j < 4 {
            total = total + 1;
            j = j + 1;
        }
    }
    let p = Pair { left: total, right: j };
    return p.left * 1000 + p.right;
}

fn main() -> void {
    print(probe_structlit_after_shadow_arm(1));
    print(probe_structlit_after_shadow_arm(0));
    return;
}
