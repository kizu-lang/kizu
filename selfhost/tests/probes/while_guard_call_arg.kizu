// while_guard_call_arg -- a plain while loop's guard calls a function with a var an if
// arm reassigned. A call spells its argument inside the instruction, so a rename after
// the fact cannot reach it.
// site: lower_multi_while_statement guard lowering.
// history: a5d61350 staged 504 501 where the Go path answers 804 501. Closed at 34f0d258.
// probe-calls: probe_while_guard_call_arg(1); probe_while_guard_call_arg(0)

pub fn cap_of(a: i64) -> i64 {
    return a + 4;
}

pub fn probe_while_guard_call_arg(limit: i64) -> i64 {
    var base = 1;
    if limit > 0 {
        base = base + 3;
    }
    var i = 0;
    var total = 0;
    while i < cap_of(base) {
        total = total + 1;
        i = i + 1;
    }
    return total * 100 + base;
}

fn main() -> void {
    print(probe_while_guard_call_arg(1));
    print(probe_while_guard_call_arg(0));
    return;
}
