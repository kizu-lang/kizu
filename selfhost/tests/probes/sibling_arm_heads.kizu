// sibling_arm_heads -- two sibling arms each running a loop that claims the same
// head name.
// site: arm claim registry.
// history: HEAD emitted invalid LLVM (multiple definition of %total) until 225aec97.
// probe-calls: probe_sibling_arm_heads(1); probe_sibling_arm_heads(0)

pub fn probe_sibling_arm_heads(limit: i64) -> i64 {
    var total = 0;
    var j = 0;
    if limit > 0 {
        while j < 2 {
            total = total + 1;
            j = j + 1;
        }
    } else {
        while j < 5 {
            total = total + 10;
            j = j + 1;
        }
    }
    while j < 9 {
        total = total + 100;
        j = j + 1;
    }
    return total * 100 + j;
}

fn main() -> void {
    print(probe_sibling_arm_heads(1));
    print(probe_sibling_arm_heads(0));
    return;
}
