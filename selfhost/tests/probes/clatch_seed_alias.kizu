// clatch_seed_alias -- a continue-latch loop's induction seed names a var an if arm
// ahead of the loop reassigned. The step overshoots the bound so the exit value
// depends on where the counter started.
// site: lower_multi_while_continue_latch induction seed.
// history: bfb7ba74 staged 902 900 where the Go path answers 802 900. Closed at a5d61350.
// probe-calls: probe_clatch_seed_alias(1); probe_clatch_seed_alias(0)

pub fn probe_clatch_seed_alias(limit: i64) -> i64 {
    var base = 0;
    if limit > 0 {
        base = base + 2;
    }
    var scan = base;
    while scan < 8 {
        if scan < 20 {
            scan = scan + 3;
            continue;
        }
        return 1;
    }
    return scan * 100 + base;
}

fn main() -> void {
    print(probe_clatch_seed_alias(1));
    print(probe_clatch_seed_alias(0));
    return;
}
