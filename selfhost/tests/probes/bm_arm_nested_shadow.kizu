// bm_arm_nested_shadow -- a branch-merge latch whose arm nests a shadowing block.
// site: find_induction_init scope.
// history: refused at 225aec97.
// probe-calls: probe_bm_arm_nested_shadow(1); probe_bm_arm_nested_shadow(0)

pub fn probe_bm_arm_nested_shadow(limit: i64) -> i64 {
    var total = 0;
    var index = 20;
    if limit > 0 {
        var index = 0;
        while index < 6 {
            total = total + 1;
            if total > 3 {
                index = 6;
            } else {
                index = index + 1;
            }
        }
        total = total + index;
    }
    return total * 1000 + index;
}

fn main() -> void {
    print(probe_bm_arm_nested_shadow(1));
    print(probe_bm_arm_nested_shadow(0));
    return;
}
