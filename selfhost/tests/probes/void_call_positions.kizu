// void_call_positions -- `return g(x);` with g returning void, from an if arm and from
// after a loop, plus a void call as a loop-body statement.
// site: append_call_return_value at the arm and loop positions.
// history: a5d61350 emitted a module LLVM rejects (instructions returning void
// cannot have a name). Closed at 34f0d258.
// probe-calls: probe_void_call_positions(1); probe_void_call_positions(0)

pub fn touch(a: i64) -> void {
    return;
}

pub fn relay_arm(a: i64) -> void {
    if a > 0 {
        return touch(a);
    }
    return;
}

pub fn relay_loop(a: i64) -> void {
    var i = 0;
    while i < 2 {
        touch(i);
        i = i + 1;
    }
    return touch(i);
}

pub fn probe_void_call_positions(a: i64) -> i64 {
    relay_arm(a);
    relay_loop(a);
    return a * 10 + 3;
}

fn main() -> void {
    print(probe_void_call_positions(1));
    print(probe_void_call_positions(0));
    return;
}
