// structlit_if_merge -- a struct-literal field reads a var an if/else merged.
// site: lower_multi_let_statement_named StructLiteralExpr branch; lower_struct_fields
// took locals_spec and never saw aliases, so the field spelled the pre-merge name.
// history: wrong answer (3 3 for 7 12) until 225aec97.
// probe-calls: probe_structlit_if_merge(1); probe_structlit_if_merge(0)

pub struct Pair {
    pub left: i64,
    pub right: i64,
}

pub fn probe_structlit_if_merge(limit: i64) -> i64 {
    var base = 3;
    if limit > 0 {
        base = base + 4;
    } else {
        base = base + 9;
    }
    let p = Pair { left: base, right: 1 };
    return p.left;
}

fn main() -> void {
    print(probe_structlit_if_merge(1));
    print(probe_structlit_if_merge(0));
    return;
}
