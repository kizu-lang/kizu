// probe-calls: probe_continue_latch_alias(1); probe_continue_latch_alias(0)

pub fn probe_continue_latch_alias(limit: i64) -> i64 {
    var total = 5;
    if limit > 0 {
        total = total + 30;
    }
    var scan = 0;
    while scan < 9 {
        if scan < 4 {
            scan = scan + 1;
            continue;
        }
        return total * 100 + scan;
    }
    return total;
}

fn main() -> void {
    print(probe_continue_latch_alias(1));
    print(probe_continue_latch_alias(0));
    return;
}
