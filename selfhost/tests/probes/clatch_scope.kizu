// clatch_scope -- a continue-latch loop whose counter is declared in the arm the loop
// sits in, not at the function root.
// site: lower_multi_while_continue_latch find_induction_init scope.
// history: refused at a8d6ffbd (missing IR artifact fact: body_child_sequence_from).
// Closed at 67d543f2.
// probe-calls: probe_clatch_scope(3); probe_clatch_scope(0)

pub fn probe_clatch_scope(a: i64) -> i64 {
    var total = 7;
    if a > 0 {
        var scan = 0;
        while scan < 5 {
            if scan < 4 {
                scan = scan + 1;
                continue;
            }
            return total + scan * 10;
        }
    }
    return total * 100 + a;
}

fn main() -> void {
    print(probe_clatch_scope(3));
    print(probe_clatch_scope(0));
    return;
}
