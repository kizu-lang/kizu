{
  "name": "kizu",
  "displayName": "Kizu",
  "description": "Kizu language support for Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "kizu-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kizu-lang/kizu.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:kizu",
    "onCommand:kizu.restartLanguageServer",
    "onCommand:kizu.runFile",
    "onCommand:kizu.testFile"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kizu",
        "aliases": [
          "Kizu",
          "kizu"
        ],
        "extensions": [
          ".kizu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kizu",
        "scopeName": "source.kizu",
        "path": "./syntaxes/kizu.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kizu",
        "path": "./snippets/kizu.code-snippets"
      }
    ],
    "configuration": {
      "title": "Kizu",
      "properties": {
        "kizu.lsp.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to the kizu-lsp executable. Leave empty to use kizu-lsp from PATH."
        },
        "kizu.cli.path": {
          "type": "string",
          "default": "kizu",
          "scope": "machine-overridable",
          "description": "Path to the kizu executable used by Kizu: Run File and Kizu: Test File."
        }
      }
    },
    "commands": [
      {
        "command": "kizu.restartLanguageServer",
        "title": "Kizu: Restart Language Server"
      },
      {
        "command": "kizu.runFile",
        "title": "Kizu: Run File"
      },
      {
        "command": "kizu.testFile",
        "title": "Kizu: Test File"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.4.5"
  }
}
