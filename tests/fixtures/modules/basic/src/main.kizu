import app::lexer;
import app::parser::ast;
import app::token;

pub struct Parser {
    pub current: lexer::Token,
    pub node: ast::Node,
    pub scanned: token::Token,
}

pub fn current_token(parser: Parser) -> lexer::Token {
    let token = parser.current;
    return token;
}

pub fn scanned_token(parser: Parser) -> token::Token {
    let token = parser.scanned;
    return token;
}

pub fn main() -> void {
    return;
}
