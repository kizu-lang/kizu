test "Wycheproof's 2048-bit PKCS #1 v1.5 keys sign to the signatures Wycheproof lists" {
    let allocator = mem::page_allocator();
    // rsa_pkcs1_2048_sig_gen_test tcId 81
    testing::expect(try rsa_signs(allocator, crypto::Hash::Sha256, "", wycheproof_key_0_n(), "010001", wycheproof_key_0_p(), wycheproof_key_0_q(), wycheproof_key_0_dp(), wycheproof_key_0_dq(), wycheproof_key_0_qinv(), "", wycheproof_key_0_sig_81()));
    // rsa_pkcs1_2048_sig_gen_test tcId 89
    testing::expect(try rsa_signs(allocator, crypto::Hash::Sha384, "", wycheproof_key_1_n(), "010001", wycheproof_key_1_p(), wycheproof_key_1_q(), wycheproof_key_1_dp(), wycheproof_key_1_dq(), wycheproof_key_1_qinv(), "", wycheproof_key_1_sig_89()));
    // rsa_pkcs1_2048_sig_gen_test tcId 97
    testing::expect(try rsa_signs(allocator, crypto::Hash::Sha512, "", wycheproof_key_2_n(), "010001", wycheproof_key_2_p(), wycheproof_key_2_q(), wycheproof_key_2_dp(), wycheproof_key_2_dq(), wycheproof_key_2_qinv(), "", wycheproof_key_2_sig_97()));
}

test "a PSS SHA-512 signature with a 64-byte salt is the one OpenSSL verified" {
    let allocator = mem::page_allocator();
    // No published PSS vector has a salt as long as a SHA-512 digest, so
    // this signature is std::crypto's own over the message below under
    // the SHA-512 key of rsa_pkcs1_2048_sig_gen_test, with the SHA-512 of
    // "salt" as the salt. OpenSSL 3.0.14 (node's crypto.verify, saltLength
    // 64) verified it, and refused it over another message and with one
    // bit changed.
    testing::expect(try rsa_signs(allocator, crypto::Hash::Sha512, pss_sha512_salt(), wycheproof_key_2_n(), "010001", wycheproof_key_2_p(), wycheproof_key_2_q(), wycheproof_key_2_dp(), wycheproof_key_2_dq(), wycheproof_key_2_qinv(), pss_sha512_message(), pss_sha512_signature()));
}

test "NIST's 3072-bit PSS key signs to the signatures NIST lists with their salts" {
    let allocator = mem::page_allocator();
    // SigGenPSS_186-3.txt, mod = 3072, SHAAlg = SHA256, message 1
    testing::expect(try rsa_signs(allocator, crypto::Hash::Sha256, "3e07ade72a3f52530f53135a5d7d93217435ba001ea55a8f5d5d1304684874bc", nist_pss_3072_n(), "1415a7", nist_pss_3072_p(), nist_pss_3072_q(), nist_pss_3072_dp(), nist_pss_3072_dq(), nist_pss_3072_qinv(), nist_pss_3072_sha256_0_msg(), nist_pss_3072_sha256_0_sig()));
    // SigGenPSS_186-3.txt, mod = 3072, SHAAlg = SHA384, message 1
    testing::expect(try rsa_signs(allocator, crypto::Hash::Sha384, nist_pss_3072_sha384_0_salt(), nist_pss_3072_n(), "1415a7", nist_pss_3072_p(), nist_pss_3072_q(), nist_pss_3072_dp(), nist_pss_3072_dq(), nist_pss_3072_qinv(), nist_pss_3072_sha384_0_msg(), nist_pss_3072_sha384_0_sig()));
}

