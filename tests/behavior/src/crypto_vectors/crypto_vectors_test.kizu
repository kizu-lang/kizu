    // tcId 238: using PKCS#1 encryption padding: 0002ff...00<hash> (InvalidPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha512, false, rsa_modulus_4(), "010001", "313233343030", pkcs1_2048_sha512_sig_238()));
    // tcId 243: PKCS#1 padding too short: 000001ff... (ShortPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha512, false, rsa_modulus_4(), "010001", "313233343030", pkcs1_2048_sha512_sig_243()));
    // tcId 244: the signature is not reduced (SignatureMalleability)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha512, false, rsa_modulus_4(), "010001", "313233343030", pkcs1_2048_sha512_sig_244()));
    // tcId 247: the signature is empty (InvalidSignature)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha512, false, rsa_modulus_4(), "010001", "313233343030", ""));
