    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha512, false, rsa_modulus_5(), "03", "38343432", pkcs1_2048_sha512_sig_259()));
}

test "Wycheproof's 3072-bit PKCS #1 v1.5 SHA-256 signatures verify as Wycheproof says" {
    let allocator = mem::page_allocator();
    // tcId 1: no comment ()
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "", pkcs1_3072_sha256_sig_1()));
    // tcId 9: length of digestInfo uses long form encoding (BerEncodedPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_9()));
    // tcId 11: length of digestInfo uses 50 instead of 49 (InvalidAsnInPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_11()));
    // tcId 24: appending 0's to digestInfo (ModifiedPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_24()));
    // tcId 216: The algorithm encoded in the padding is MD5 instead of SHA-256. (WrongHash)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_216()));
    // tcId 237: The message is not hashed. (NoHash)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_237()));
    // tcId 239: using PKCS#1 encryption padding: 0002ff...00<hash> (InvalidPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_239()));
    // tcId 244: PKCS#1 padding too short: 000001ff... (ShortPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_244()));
    // tcId 245: the signature is not reduced (SignatureMalleability)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_245()));
    // tcId 248: the signature is empty (InvalidSignature)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", ""));
    // tcId 256: RSASSA-PSS signature (WrongPrimitive)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_6(), "010001", "313233343030", pkcs1_3072_sha256_sig_256()));
    // tcId 259: small signature (SmallSignature, SmallPublicKey)
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_7(), "03", "34333630", pkcs1_3072_sha256_sig_259()));
}

test "Wycheproof's 2048-bit PSS SHA-256 signatures verify as Wycheproof says" {
    let allocator = mem::page_allocator();
    // tcId 1: valid signature (Normal)
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, true, rsa_modulus_0(), "010001", "", pss_2048_sha256_sig_1()));
    // tcId 8: special case for hash (SpecialCaseHash)
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, true, rsa_modulus_0(), "010001", "343236343739373234", pss_2048_sha256_sig_8()));
    // tcId 62: first byte of m_hash modified (ModifiedSignature)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, true, rsa_modulus_0(), "010001", "313233343030", pss_2048_sha256_sig_62()));
    // tcId 73: salt is all 0 (ModifiedSignature)
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, true, rsa_modulus_0(), "010001", "313233343030", pss_2048_sha256_sig_73()));
    // tcId 108: PKCS #1 v1.5 signature with SHA-256 (WrongPrimitive)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, true, rsa_modulus_0(), "010001", "313233343030", pss_2048_sha256_sig_108()));
}

