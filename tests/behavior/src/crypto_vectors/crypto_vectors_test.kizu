import std::crypto;
import std::mem;
import std::string;
import std::testing;

// Signatures made and judged by other implementations, so that std::crypto
// is held to what they say and not only to signatures it made itself.
//
// The verification cases are Project Wycheproof's (C2SP/wycheproof,
// testvectors_v1 at commit 65ca494727a52944c204441c860b039e6786b99b):
// ecdsa_secp256r1_sha256_p1363_test, ecdsa_secp384r1_sha384_p1363_test,
// rsa_signature_2048_sha{256,384,512}_test, rsa_signature_3072_sha256_test, and
// rsa_pss_{2048_sha256_mgf1_32,2048_sha384_mgf1_48,3072_sha256_mgf1_32,
// 4096_sha512_mgf1_64}_test. From each file comes the first case of every
// verdict and flag set it has (acceptable ones left out); the comment above
// each names its tcId. Every case of those files gives the verdict
// Wycheproof lists.
//
// The PKCS #1 v1.5 signing cases are rsa_pkcs1_2048_sig_gen_test's, the
// first valid one per hash; the key's parts are the ones its
// privateKeyPkcs8 holds. The PSS ones are NIST CAVP's FIPS 186-3
// SigGenPSS_186-3.txt, mod = 3072, the first message of the two hashes whose
// salt is as long as the digest. NIST lists n, e and d; p and q are
// recovered from them (NIST SP 800-56B, Appendix C), which a signature
// equal to NIST's S confirms.

fn bytes_of_hex_lines(allocator: Allocator, hex: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var high = -1;
    for 0..mem::len(hex) |index| {
        let byte = cast<i64>(hex[index]);
        var value = -1;
        if byte >= 48 and byte <= 57 {
            value = byte - 48;
        } else if byte >= 97 and byte <= 102 {
            value = byte - 87;
        }
        if value < 0 {
            continue;
        }
        if high < 0 {
            high = value;
        } else {
            try out.append_byte(allocator, cast<u8>(high * 16 + value));
            high = -1;
        }
    }
    return move out;
}

fn ecdsa_verifies(allocator: Allocator, wide: bool, key_hex: []u8, message_hex: []u8, signature_hex: []u8) -> mem::Error!bool {
    let key = try bytes_of_hex_lines(allocator, key_hex);
    defer key.deinit(allocator);
    let message = try bytes_of_hex_lines(allocator, message_hex);
    defer message.deinit(allocator);
    let signature = try bytes_of_hex_lines(allocator, signature_hex);
    defer signature.deinit(allocator);
    let key_bytes = key.as_bytes();
    let message_bytes = message.as_bytes();
    let signature_bytes = signature.as_bytes();
    if wide {
        var long = [48]u8{};
        let long_view = long.as_mut_bytes();
        crypto::sha384(message_bytes, long_view);
        let long_digest = long.as_bytes();
        return crypto::ecdsa_p384_verify(key_bytes, long_digest, signature_bytes);
    }
    var short = [32]u8{};
    let short_view = short.as_mut_bytes();
    crypto::sha256(message_bytes, short_view);
    let short_digest = short.as_bytes();
    return crypto::ecdsa_p256_verify(key_bytes, short_digest, signature_bytes);
}

// rsa_verifies checks a signature over a message under `hash`, with PSS
// when `pss` is set and PKCS #1 v1.5 otherwise.
fn rsa_verifies(
    allocator: Allocator,
    hash: crypto::Hash,
    pss: bool,
    modulus_hex: []u8,
    exponent_hex: []u8,
    message_hex: []u8,
    signature_hex: []u8
) -> mem::Error!bool {
    let modulus = try bytes_of_hex_lines(allocator, modulus_hex);
    defer modulus.deinit(allocator);
    let exponent = try bytes_of_hex_lines(allocator, exponent_hex);
    defer exponent.deinit(allocator);
    let message = try bytes_of_hex_lines(allocator, message_hex);
    defer message.deinit(allocator);
    let signature = try bytes_of_hex_lines(allocator, signature_hex);
    defer signature.deinit(allocator);
    var digest_buffer = [64]u8{};
    let digest = digest_buffer.as_mut_bytes();
    let message_bytes = message.as_bytes();
    crypto::digest_of(hash, message_bytes, digest);
    let digest_view = digest[0..crypto::digest_length(hash)];
    let n = modulus.as_bytes();
    let e = exponent.as_bytes();
    let s = signature.as_bytes();
    if pss {
        return crypto::rsa_pss_verify(hash, n, e, digest_view, s);
    }
    return crypto::rsa_pkcs1_verify(hash, n, e, digest_view, s);
}

// rsa_signs signs a message with the key the parts spell, with PSS and that
// salt when there is one and PKCS #1 v1.5 otherwise, and reports whether
// the signature is `want`.
fn rsa_signs(
    allocator: Allocator,
    hash: crypto::Hash,
    salt_hex: []u8,
    n_hex: []u8,
    e_hex: []u8,
    p_hex: []u8,
    q_hex: []u8,
    dp_hex: []u8,
    dq_hex: []u8,
    qinv_hex: []u8,
    message_hex: []u8,
    want_hex: []u8
) -> crypto::Failure!bool {
    let n = try bytes_of_hex_lines(allocator, n_hex);
    defer n.deinit(allocator);
    let e = try bytes_of_hex_lines(allocator, e_hex);
    defer e.deinit(allocator);
    let p = try bytes_of_hex_lines(allocator, p_hex);
    defer p.deinit(allocator);
    let q = try bytes_of_hex_lines(allocator, q_hex);
    defer q.deinit(allocator);
    let dp = try bytes_of_hex_lines(allocator, dp_hex);
    defer dp.deinit(allocator);
    let dq = try bytes_of_hex_lines(allocator, dq_hex);
    defer dq.deinit(allocator);
    let qinv = try bytes_of_hex_lines(allocator, qinv_hex);
    defer qinv.deinit(allocator);
    let salt = try bytes_of_hex_lines(allocator, salt_hex);
    defer salt.deinit(allocator);
    let message = try bytes_of_hex_lines(allocator, message_hex);
    defer message.deinit(allocator);
    let want = try bytes_of_hex_lines(allocator, want_hex);
    defer want.deinit(allocator);
    let n_bytes = n.as_bytes();
    let e_bytes = e.as_bytes();
    let p_bytes = p.as_bytes();
    let q_bytes = q.as_bytes();
    let dp_bytes = dp.as_bytes();
    let dq_bytes = dq.as_bytes();
    let qinv_bytes = qinv.as_bytes();
    let key = crypto::RsaPrivateKey {
        modulus: n_bytes,
        public_exponent: e_bytes,
        prime1: p_bytes,
        prime2: q_bytes,
        exponent1: dp_bytes,
        exponent2: dq_bytes,
        coefficient: qinv_bytes,
    };
    var digest_buffer = [64]u8{};
    let digest = digest_buffer.as_mut_bytes();
    let message_bytes = message.as_bytes();
    crypto::digest_of(hash, message_bytes, digest);
    let digest_view = digest[0..crypto::digest_length(hash)];
    var signature = [512]u8{};
    let out = signature.as_mut_bytes();
    let salt_bytes = salt.as_bytes();
    if mem::len(salt_bytes) > 0 {
        try crypto::rsa_pss_sign(hash, &key, digest_view, salt_bytes, out);
    } else {
        try crypto::rsa_pkcs1_sign(hash, &key, digest_view, out);
    }
    let made = signature.as_bytes();
    let want_bytes = want.as_bytes();
    return mem::equal_bytes(made[0..mem::len(n_bytes)], want_bytes);
}

test "Wycheproof's P-256 with SHA-256 signatures verify as Wycheproof says" {
    let allocator = mem::page_allocator();
    // tcId 1: signature malleability (ValidSignature)
    testing::expect(try ecdsa_verifies(allocator, false, p256_key_0(), "313233343030", p256_sig_1()));
    // tcId 2: replaced r by r + n (RangeCheck)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_0(), "313233343030", p256_sig_2()));
    // tcId 4: replaced r by n - r (ModifiedInteger)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_0(), "313233343030", p256_sig_4()));
    // tcId 5: replaced r by r + 2**256 (IntegerOverflow)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_0(), "313233343030", p256_sig_5()));
    // tcId 11: Signature with special case values r=0 and s=0 (InvalidSignature)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_0(), "313233343030", p256_sig_11()));
    // tcId 60: Edge case for Shamir multiplication (EdgeCaseShamirMultiplication)
    testing::expect(try ecdsa_verifies(allocator, false, p256_key_0(), "3639383139", p256_sig_60()));
    // tcId 61: special case hash (SpecialCaseHash)
    testing::expect(try ecdsa_verifies(allocator, false, p256_key_0(), "343236343739373234", p256_sig_61()));
    // tcId 115: k*G has a large x-coordinate (ArithmeticError)
    testing::expect(try ecdsa_verifies(allocator, false, p256_key_1(), "313233343030", p256_sig_115()));
    // tcId 116: r too large (ArithmeticError)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_1(), "313233343030", p256_sig_116()));
    // tcId 120: small r and s (SmallRandS, ArithmeticError)
    testing::expect(try ecdsa_verifies(allocator, false, p256_key_2(), "313233343030", p256_sig_120()));
    // tcId 121: incorrect size of signature (SmallRandS, ArithmeticError, SignatureSize)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_2(), "313233343030", "0501"));
    // tcId 145: incorrect size of signature (ArithmeticError, SignatureSize)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_3(), "313233343030", "9c44febf31c3594f839ed28247c2b06b"));
    // tcId 154: edge case modular inverse (ModularInverse, ArithmeticError)
    testing::expect(try ecdsa_verifies(allocator, false, p256_key_4(), "313233343030", p256_sig_154()));
    // tcId 169: point at infinity during verify (PointDuplication, ArithmeticError)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_5(), "313233343030", p256_sig_169()));
    // tcId 204: point duplication during verification (PointDuplication)
    testing::expect(try ecdsa_verifies(allocator, false, p256_key_6(), "313233343030", p256_sig_204()));
    // tcId 205: duplication bug (PointDuplication)
    testing::expect(!try ecdsa_verifies(allocator, false, p256_key_7(), "313233343030", p256_sig_205()));
    // tcId 229: x-coordinate of the public key has many trailing 0's (EdgeCasePublicKey)
    testing::expect(try ecdsa_verifies(allocator, false, p256_key_8(), "4d657373616765", p256_sig_229()));
}

test "Wycheproof's P-384 with SHA-384 signatures verify as Wycheproof says" {
    let allocator = mem::page_allocator();
    // tcId 1: signature malleability (ValidSignature)
    testing::expect(try ecdsa_verifies(allocator, true, p384_key_0(), "313233343030", p384_sig_1()));
    // tcId 2: replaced r by r + n (RangeCheck)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_0(), "313233343030", p384_sig_2()));
    // tcId 4: replaced r by n - r (ModifiedInteger)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_0(), "313233343030", p384_sig_4()));
    // tcId 5: replaced r by r + 2**384 (IntegerOverflow)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_0(), "313233343030", p384_sig_5()));
    // tcId 11: Signature with special case values r=0 and s=0 (InvalidSignature)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_0(), "313233343030", p384_sig_11()));
    // tcId 60: Edge case for Shamir multiplication (EdgeCaseShamirMultiplication)
    testing::expect(try ecdsa_verifies(allocator, true, p384_key_0(), "3133323237", p384_sig_60()));
    // tcId 61: special case hash (SpecialCaseHash)
    testing::expect(try ecdsa_verifies(allocator, true, p384_key_0(), "31373530353531383135", p384_sig_61()));
    // tcId 147: k*G has a large x-coordinate (ArithmeticError)
    testing::expect(try ecdsa_verifies(allocator, true, p384_key_1(), "313233343030", p384_sig_147()));
    // tcId 148: r too large (ArithmeticError)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_1(), "313233343030", p384_sig_148()));
    // tcId 152: small r and s (SmallRandS, ArithmeticError)
    testing::expect(try ecdsa_verifies(allocator, true, p384_key_2(), "313233343030", p384_sig_152()));
    // tcId 153: incorrect size of signature (SmallRandS, ArithmeticError, SignatureSize)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_2(), "313233343030", "0201"));
    // tcId 173: incorrect size of signature (ArithmeticError, SignatureSize)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_3(), "313233343030", "9c44febf31c3594d839ed28247c2b06b"));
    // tcId 182: edge case modular inverse (ModularInverse, ArithmeticError)
    testing::expect(try ecdsa_verifies(allocator, true, p384_key_4(), "313233343030", p384_sig_182()));
    // tcId 197: point at infinity during verify (PointDuplication, ArithmeticError)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_5(), "313233343030", p384_sig_197()));
    // tcId 228: point duplication during verification (PointDuplication)
    testing::expect(try ecdsa_verifies(allocator, true, p384_key_6(), "313233343030", p384_sig_228()));
    // tcId 229: duplication bug (PointDuplication)
    testing::expect(!try ecdsa_verifies(allocator, true, p384_key_7(), "313233343030", p384_sig_229()));
    // tcId 253: x-coordinate of the public key is large (EdgeCasePublicKey)
    testing::expect(try ecdsa_verifies(allocator, true, p384_key_8(), "4d657373616765", p384_sig_253()));
}

test "Wycheproof's 2048-bit PKCS #1 v1.5 SHA-256 signatures verify as Wycheproof says" {
    let allocator = mem::page_allocator();
    // tcId 1: no comment ()
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "", pkcs1_2048_sha256_sig_1()));
    // tcId 9: length of digestInfo uses long form encoding (BerEncodedPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_9()));
    // tcId 11: length of digestInfo uses 50 instead of 49 (InvalidAsnInPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_11()));
    // tcId 24: appending 0's to digestInfo (ModifiedPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_24()));
    // tcId 215: The algorithm encoded in the padding is MD5 instead of SHA-256. (WrongHash)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_215()));
    // tcId 236: The message is not hashed. (NoHash)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_236()));
    // tcId 238: using PKCS#1 encryption padding: 0002ff...00<hash> (InvalidPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_238()));
    // tcId 243: PKCS#1 padding too short: 000001ff... (ShortPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_243()));
    // tcId 244: the signature is not reduced (SignatureMalleability)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_244()));
    // tcId 247: the signature is empty (InvalidSignature)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", ""));
    // tcId 255: RSASSA-PSS signature (WrongPrimitive)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_0(), "010001", "313233343030", pkcs1_2048_sha256_sig_255()));
    // tcId 258: small signature (SmallSignature, SmallPublicKey)
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_1(), "03", "33363730", pkcs1_2048_sha256_sig_258()));
    // tcId 259: signature is close to n (EdgeCaseSignature, SmallPublicKey)
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, false, rsa_modulus_2(), "03", "32353934", pkcs1_2048_sha256_sig_259()));
}

test "Wycheproof's 2048-bit PKCS #1 v1.5 SHA-384 signatures verify as Wycheproof says" {
    let allocator = mem::page_allocator();
    // tcId 1: no comment ()
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "", pkcs1_2048_sha384_sig_1()));
    // tcId 9: length of digestInfo uses long form encoding (BerEncodedPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_9()));
    // tcId 11: length of digestInfo uses 66 instead of 65 (InvalidAsnInPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_11()));
    // tcId 24: appending 0's to digestInfo (ModifiedPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_24()));
    // tcId 216: The algorithm encoded in the padding is MD5 instead of SHA-384. (WrongHash)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_216()));
    // tcId 236: The message is not hashed. (NoHash)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_236()));
    // tcId 238: using PKCS#1 encryption padding: 0002ff...00<hash> (InvalidPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_238()));
    // tcId 243: PKCS#1 padding too short: 000001ff... (ShortPadding)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_243()));
    // tcId 244: the signature is not reduced (SignatureMalleability)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_244()));
    // tcId 247: the signature is empty (InvalidSignature)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", ""));
    // tcId 255: RSASSA-PSS signature (WrongPrimitive)
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, rsa_modulus_3(), "010001", "313233343030", pkcs1_2048_sha384_sig_255()));
}

test "Wycheproof's 2048-bit PKCS #1 v1.5 SHA-512 signatures verify as Wycheproof says" {
    let allocator = mem::page_allocator();
    // tcId 1: no comment ()
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha512, false, rsa_modulus_4(), "010001", "", pkcs1_2048_sha512_sig_1()));
    // tcId 9: length of digestInfo uses long form encoding (BerEncodedPadding)
