import std::fmt;
import std::io;
import std::mem;
import std::net;
import std::string;
import std::testing;

// std::net's contract: an address is text until a call resolves it, a
// listener on port 0 can say which port it got, a read answers with how many
// bytes it appended, and a read of a peer that closed answers 0.

fn loopback(allocator: Allocator, port: i64) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, "127.0.0.1:");
    try fmt::append_i64(allocator, &var out, port);
    return move out;
}

test "parse_address splits host from port" {
    let parsed = try net::parse_address("127.0.0.1:8080");
    testing::expect_equal<[]u8>("127.0.0.1", parsed.host);
    testing::expect_equal<i64>(8080, parsed.port);
}

test "parse_address reads a bracketed IPv6 host" {
    let parsed = try net::parse_address("[::1]:443");
    testing::expect_equal<[]u8>("::1", parsed.host);
    testing::expect_equal<i64>(443, parsed.port);
}

test "parse_address keeps an empty host, which means every interface" {
    let parsed = try net::parse_address(":9000");
    testing::expect_equal<i64>(0, mem::len(parsed.host));
    testing::expect_equal<i64>(9000, parsed.port);
}

test "parse_address refuses an address without a port" {
    if net::parse_address("127.0.0.1") |_| {
        testing::fail("an address with no port was accepted");
    } else |err| {
        testing::expect(err == net::Error::InvalidAddress);
    }
}

test "parse_address refuses a port above the 16-bit range" {
    if net::parse_address("127.0.0.1:70000") |_| {
        testing::fail("a port above 65535 was accepted");
    } else |err| {
        testing::expect(err == net::Error::InvalidAddress);
    }
}

test "a listener on port 0 reports the port the host chose" {
    let handle = io::blocking();
    var listener = try net::tcp_listen(handle, "127.0.0.1:0");
    defer listener.deinit();
    let port = try listener.local_port();
    testing::expect(port > 0);
    testing::expect(port <= 65535);
}

test "a stream carries bytes both ways and reports end of stream" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var listener = try net::tcp_listen(handle, "127.0.0.1:0");
    defer listener.deinit();
    let port = try listener.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    // Closing the client is what the server reads as end of stream, so this
    // one is released by name below rather than at the end of the frame.
    errdefer client.deinit();
    try client.write_all(handle, "request");

    var served = try listener.accept(handle);
    defer served.deinit();
    var asked = string::new(allocator);
    defer asked.deinit(allocator);
    let read = try served.read_into(handle, allocator, &var asked, 64);
    testing::expect_equal<i64>(7, read);
    let asked_bytes = asked.as_bytes();
    testing::expect_equal<[]u8>("request", asked_bytes);

    try served.write_all(handle, "answer");
    var answer = string::new(allocator);
    defer answer.deinit(allocator);
    let back = try client.read_into(handle, allocator, &var answer, 64);
    testing::expect_equal<i64>(6, back);
    let answer_bytes = answer.as_bytes();
    testing::expect_equal<[]u8>("answer", answer_bytes);

    // Closing the client is what the server sees as end of stream.
    client.deinit();
    var trailing = string::new(allocator);
    defer trailing.deinit(allocator);
    let eof = try served.read_into(handle, allocator, &var trailing, 64);
    testing::expect_equal<i64>(0, eof);
}

test "read_into refuses a ceiling of zero" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var listener = try net::tcp_listen(handle, "127.0.0.1:0");
    defer listener.deinit();
    let port = try listener.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();
    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    if client.read_into(handle, allocator, &var out, 0) |_| {
        testing::fail("a read of zero bytes was accepted");
    } else |err| {
        testing::expect(err == net::Error::InvalidLength);
    }
}

test "failing io refuses every net call without touching the host" {
    let handle = testing::failing_io();
    if net::tcp_listen(handle, "127.0.0.1:0") |_| {
        testing::fail("failing io accepted a listen");
    } else |err| {
        testing::expect(err == net::Error::IoFailing);
    }
}
