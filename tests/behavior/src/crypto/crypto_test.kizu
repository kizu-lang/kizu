        "54a59b9f22b0b80880d8427e548b7c23abd873486e1f035dce9cd697e85175033caa88e6d57bc35efae0b5afd3145f31");
    try expect_repeated(allocator, 111,
        "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2",
        "3c37955051cb5c3026f94d551d5b5e2ac38d572ae4e07172085fed81f8466b8f90dc23a8ffcdea0b8d8e58e8fdacc80a");
    try expect_repeated(allocator, 112,
        "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca",
        "187d4e07cb306103c69967bf544d0dfbe9042577599c73c330abc0cb64c61236d5ed565ee19119d8c31779a38f791fcd");
    try expect_repeated(allocator, 113,
        "55ddd8ac210a6e18ba1ee055af84c966e0dbff091c43580ae1be703bdb85da31acf6948cf5bd90c55a20e5450f22fb89bd8d0085e39f85a86cc46abbca75e24d",
        "1d6bed01626682961b50da078a6b1da707c1da0c8a0a3226f159235bd45ed724a0622fa6f39fd70007a6c72a5cda43ae");
    try expect_repeated(allocator, 127,
        "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502",
        "9bd06b1763c2cf7aef40e795dc65bc96d59c41b537f3ad72ebdefd485476b5717c1aeb37c327fe9c1831b12b9efd08ae");
    try expect_repeated(allocator, 128,
        "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321",
        "edb12730a366098b3b2beac75a3bef1b0969b15c48e2163c23d96994f8d1bef760c7e27f3c464d3829f56c0d53808b0b");
    try expect_repeated(allocator, 129,
        "4f681e0bd53cda4b5a2041cc8a06f2eabde44fb16c951fbd5b87702f07aeab611565b19c47fde30587177ebb852e3971bbd8d3fd30da18d71037dfbd98420429",
        "39b6f5a7b0e781dbc419f72e49b30eaac10f2c98c4403bc610da31067fd1b48f324138c8615d2b496d08d73d5e865326");
    try expect_repeated(allocator, 255,
        "d8b5a659e365f704ab114ae7079a8da24fb9997b3052a4a63b37d654652bad6fbdd2b52d737e20a9d5ac3c5831d6afdd32ff737a3dd95269d2793bc2aa850aab",
        "c4f7cca9698ddde4fb9947aebd9da1bda11e9413958d1a5d26f32fbec24bf34cb95f7c7eb84445cbaf84a63d3c705aa6");
    try expect_repeated(allocator, 256,
        "6a9169eb662f136d87374070e8828b3e615a7eca32a89446e9225b02832709be095e635c824a2bb70213ba2ea0ababac0809827843992c851903b7ac0c136699",
        "ee89d91a5f594f72052c561e5c2458280439eaa77cc1352e27893931c6d9ce5d869fb8a024358c460adc1af9f4fe5b4a");
}

test "one million bytes go through the 128-byte blocks the long way" {
    let allocator = mem::page_allocator();
    try expect_repeated(allocator, 1000000,
        "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b",
        "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985");
}

fn bytes_of_hex_lines(allocator: Allocator, hex: []u8) -> mem::Error!string::String {
    var digits = string::new(allocator);
    defer digits.deinit(allocator);
    for 0..mem::len(hex) |index| {
        let byte = hex[index];
        if (byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102) {
            try digits.append_byte(allocator, byte);
        }
    }
    let view = digits.as_bytes();
    return bytes_of_hex(allocator, view);
}

fn rsa_message() -> []u8 {
    return "The quick brown fox jumps over the lazy dog";
}

// rsa_verifies checks a signature over `message` under `hash`, with PSS
// when `pss` is set and PKCS #1 v1.5 otherwise.
fn rsa_verifies(
    allocator: Allocator,
    hash: crypto::Hash,
    pss: bool,
    modulus_hex: []u8,
    exponent_hex: []u8,
    message: []u8,
    signature_hex: []u8
) -> mem::Error!bool {
    let modulus = try bytes_of_hex_lines(allocator, modulus_hex);
    defer modulus.deinit(allocator);
    let exponent = try bytes_of_hex_lines(allocator, exponent_hex);
    defer exponent.deinit(allocator);
    let signature = try bytes_of_hex_lines(allocator, signature_hex);
    defer signature.deinit(allocator);
    var digest_buffer = [64]u8{};
    let digest = digest_buffer.as_mut_bytes();
    crypto::digest_of(hash, message, digest);
    let digest_view = digest[0..crypto::digest_length(hash)];
    let n = modulus.as_bytes();
    let e = exponent.as_bytes();
    let s = signature.as_bytes();
    if pss {
        return crypto::rsa_pss_verify(hash, n, e, digest_view, s);
    }
    return crypto::rsa_pkcs1_verify(hash, n, e, digest_view, s);
}

test "the 2048-bit key's PKCS #1 v1.5 and PSS signatures verify under each hash" {
    let allocator = mem::page_allocator();
    let n = rsa_2048_modulus();
    let message = rsa_message();
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, false, n, "010001", message, rsa_2048_pkcs1_sha256()));
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha384, false, n, "010001", message, rsa_2048_pkcs1_sha384()));
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha512, false, n, "010001", message, rsa_2048_pkcs1_sha512()));
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, true, n, "010001", message, rsa_2048_pss_sha256()));
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha384, true, n, "010001", message, rsa_2048_pss_sha384()));
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha512, true, n, "010001", message, rsa_2048_pss_sha512()));
}

test "the 4096-bit key's signatures verify, and leading zeros on the key do not matter" {
    let allocator = mem::page_allocator();
    let n = rsa_4096_modulus();
    let message = rsa_message();
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, false, n, "010001", message, rsa_4096_pkcs1_sha256()));
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, true, n, "010001", message, rsa_4096_pss_sha256()));
    let padded = try string::from_bytes(allocator, "0000");
    defer padded.deinit(allocator);
    try padded.append_bytes(allocator, n);
    let padded_view = padded.as_bytes();
    testing::expect(try rsa_verifies(allocator, crypto::Hash::Sha256, false, padded_view, "00010001", message, rsa_4096_pkcs1_sha256()));
}

test "a changed signature, another message, or the other scheme is an invalid RSA signature" {
    let allocator = mem::page_allocator();
    let n = rsa_2048_modulus();
    let message = rsa_message();
    var changed = try string::from_bytes(allocator, rsa_2048_pkcs1_sha256());
    defer changed.deinit(allocator);
    let flipped = changed.as_mut_bytes();
    flipped[40] = if flipped[40] == 48 { cast<u8>(49) } else { cast<u8>(48) };
    let changed_view = changed.as_bytes();
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, n, "010001", message, changed_view));
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, n, "010001", "The quick brown fox jumps over the lazy cog", rsa_2048_pkcs1_sha256()));
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, true, n, "010001", message, rsa_2048_pkcs1_sha256()));
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, n, "010001", message, rsa_2048_pss_sha256()));
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha384, false, n, "010001", message, rsa_2048_pkcs1_sha256()));
}

test "a signature not below the modulus, a short one, an even modulus, or an even exponent is invalid" {
    let allocator = mem::page_allocator();
    let n = rsa_2048_modulus();
    let message = rsa_message();
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, n, "010001", message, n));
    let short = rsa_2048_pkcs1_sha256();
    let short_view = short[0..mem::len(short) - 2];
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, n, "010001", message, short_view));
    var even = try string::from_bytes(allocator, n);
    defer even.deinit(allocator);
    let even_bytes = even.as_mut_bytes();
    let last = mem::len(n) - 1;
    even_bytes[last] = if even_bytes[last] == 52 { cast<u8>(53) } else { cast<u8>(52) };
    let even_view = even.as_bytes();
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, even_view, "010001", message, rsa_2048_pkcs1_sha256()));
    testing::expect(!try rsa_verifies(allocator, crypto::Hash::Sha256, false, n, "010000", message, rsa_2048_pkcs1_sha256()));
}

// rsa_2048_modulus and rsa_4096_modulus are the moduli of two keys
// generated for these tests, exponent 65537; the signatures below were
// made with them over the digests of "The quick brown fox jumps over
// the lazy dog".
