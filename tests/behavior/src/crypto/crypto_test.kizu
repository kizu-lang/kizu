import std::crypto;
import std::io;
import std::mem;
import std::string;
import std::testing;

// The digests and tags here are the published ones: FIPS 180-4 gives the
// SHA-256 examples, RFC 4231 the HMAC-SHA-256 cases. The padding boundaries
// and the long message are the places an implementation goes wrong on its
// own, so they are held to the digests a reference implementation gives.

fn hex_of(allocator: Allocator, bytes: []u8) -> mem::Error!string::String {
    let digits = "0123456789abcdef";
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    for 0..mem::len(bytes) |index| {
        let value = cast<i64>(bytes[index]);
        try out.append_byte(allocator, digits[value >> 4]);
        try out.append_byte(allocator, digits[value & 15]);
    }
    return move out;
}

fn repeated(allocator: Allocator, byte: u8, count: i64) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    for 0..count |_| {
        try out.append_byte(allocator, byte);
    }
    return move out;
}

fn expect_sha256(allocator: Allocator, input: []u8, want: []u8) -> mem::Error!void {
    var digest = [32]u8{};
    let view = digest.as_mut_bytes();
    crypto::sha256(input, view);
    let bytes = digest.as_bytes();
    let hex = try hex_of(allocator, bytes);
    defer hex.deinit(allocator);
    let got = hex.as_bytes();
    testing::expect_equal<[]u8>(want, got);
    return;
}

fn expect_hmac(allocator: Allocator, key: []u8, message: []u8, want: []u8) -> mem::Error!void {
    var tag = [32]u8{};
    let view = tag.as_mut_bytes();
    crypto::hmac_sha256(key, message, view);
    let bytes = tag.as_bytes();
    let hex = try hex_of(allocator, bytes);
    defer hex.deinit(allocator);
    let got = hex.as_bytes();
    testing::expect_equal<[]u8>(want, got[0..mem::len(want)]);
    return;
}

fn sequence(allocator: Allocator, from: i64, to: i64) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var value = from;
    while value <= to {
        try out.append_byte(allocator, cast<u8>(value));
        value = value + 1;
    }
    return move out;
}

fn expect_extract(
    allocator: Allocator,
    salt: []u8,
    keying_material: []u8,
    key: &var []u8,
    want: []u8
) -> mem::Error!void {
    crypto::hkdf_extract(salt, keying_material, key);
    let hex = try hex_of(allocator, key);
    defer hex.deinit(allocator);
    let got = hex.as_bytes();
    testing::expect_equal<[]u8>(want, got);
    return;
}

fn expect_expand(
    allocator: Allocator,
    key: []u8,
    info: []u8,
    out: &var []u8,
    want: []u8
) -> mem::Error!void {
    crypto::hkdf_expand(key, info, out);
    let hex = try hex_of(allocator, out);
    defer hex.deinit(allocator);
    let got = hex.as_bytes();
    testing::expect_equal<[]u8>(want, got);
    return;
}

fn bytes_of_hex(allocator: Allocator, hex: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var at = 0;
    while at + 1 < mem::len(hex) {
        let high = hex_value(hex[at]);
        let low = hex_value(hex[at + 1]);
        try out.append_byte(allocator, cast<u8>(high * 16 + low));
        at = at + 2;
    }
    return move out;
}

fn hex_value(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return value - 87;
    }
    return value - 48;
}

fn expect_gcm(allocator: Allocator, key: []u8, nonce: []u8, aad: []u8, plain: []u8, want: []u8) -> crypto::Failure!void {
    var sealed = string::new(allocator);
    defer sealed.deinit(allocator);
    try crypto::aes_gcm_seal(allocator, key, nonce, aad, plain, &var sealed);
    let sealed_bytes = sealed.as_bytes();
    let hex = try hex_of(allocator, sealed_bytes);
    defer hex.deinit(allocator);
    let got = hex.as_bytes();
    testing::expect_equal<[]u8>(want, got);
    var opened = string::new(allocator);
    defer opened.deinit(allocator);
    try crypto::aes_gcm_open(allocator, key, nonce, aad, sealed_bytes, &var opened);
    let opened_bytes = opened.as_bytes();
    testing::expect_equal<[]u8>(plain, opened_bytes);
    return;
}

fn expect_gcm_refused(allocator: Allocator, key: []u8, nonce: []u8, aad: []u8, sealed: []u8) -> void {
    var out = string::new(allocator);
    defer out.deinit(allocator);
    if crypto::aes_gcm_open(allocator, key, nonce, aad, sealed, &var out) {
        testing::fail("a forged message was opened");
    } else |err| {
        testing::expect(err == crypto::Error::AuthenticationFailed);
    }
    testing::expect_equal<i64>(0, out.len());
    return;
}

fn expect_refused(allocator: Allocator, key: []u8, nonce: []u8, aad: []u8, sealed: []u8) -> void {
    var out = string::new(allocator);
    defer out.deinit(allocator);
    if crypto::chacha20_poly1305_open(allocator, key, nonce, aad, sealed, &var out) {
        testing::fail("a forged message was opened");
    } else |err| {
        testing::expect(err == crypto::Error::AuthenticationFailed);
    }
    testing::expect_equal<i64>(0, out.len());
    return;
}

fn expect_repeated_sha256(allocator: Allocator, count: i64, want: []u8) -> mem::Error!void {
    let input = try repeated(allocator, 97, count);
    defer input.deinit(allocator);
    let bytes = input.as_bytes();
    return expect_sha256(allocator, bytes, want);
}

test "the FIPS 180-4 examples digest as the standard says" {
    let allocator = mem::page_allocator();
    try expect_sha256(allocator, "",
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
    try expect_sha256(allocator, "abc",
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    try expect_sha256(allocator, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq",
        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
}

test "a message ending at each padding boundary is padded right" {
    let allocator = mem::page_allocator();
    // 55 bytes leave room for the 1 bit and the length in one block; 56
    // do not, and need a second; 64 fill a block exactly.
    try expect_repeated_sha256(allocator, 55,
        "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318");
    try expect_repeated_sha256(allocator, 56,
        "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a");
    try expect_repeated_sha256(allocator, 63,
        "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34");
    try expect_repeated_sha256(allocator, 64,
        "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb");
    try expect_repeated_sha256(allocator, 65,
        "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0");
    try expect_repeated_sha256(allocator, 119,
        "31eba51c313a5c08226adf18d4a359cfdfd8d2e816b13f4af952f7ea6584dcfb");
    try expect_repeated_sha256(allocator, 120,
        "2f3d335432c70b580af0e8e1b3674a7c020d683aa5f73aaaedfdc55af904c21c");
}

test "one million bytes go through the blocks the long way" {
    let allocator = mem::page_allocator();
    try expect_repeated_sha256(allocator, 1000000,
        "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0");
}

test "the RFC 4231 cases tag as the RFC says" {
    let allocator = mem::page_allocator();
    let key1 = try repeated(allocator, 11, 20);
    defer key1.deinit(allocator);
    let key1_bytes = key1.as_bytes();
    try expect_hmac(allocator, key1_bytes, "Hi There",
        "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7");
    try expect_hmac(allocator, "Jefe", "what do ya want for nothing?",
        "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
    let key3 = try repeated(allocator, 170, 20);
    defer key3.deinit(allocator);
    let data3 = try repeated(allocator, 221, 50);
    defer data3.deinit(allocator);
    let key3_bytes = key3.as_bytes();
    let data3_bytes = data3.as_bytes();
    try expect_hmac(allocator, key3_bytes, data3_bytes,
        "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe");
    var key4 = string::new(allocator);
    defer key4.deinit(allocator);
    for 1..26 |value| {
        try key4.append_byte(allocator, cast<u8>(value));
    }
    let data4 = try repeated(allocator, 205, 50);
    defer data4.deinit(allocator);
    let key4_bytes = key4.as_bytes();
    let data4_bytes = data4.as_bytes();
    try expect_hmac(allocator, key4_bytes, data4_bytes,
        "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b");
    // Case 5 is compared on its first 128 bits, as the RFC lists it.
    let key5 = try repeated(allocator, 12, 20);
    defer key5.deinit(allocator);
    let key5_bytes = key5.as_bytes();
    try expect_hmac(allocator, key5_bytes, "Test With Truncation",
        "a3b6167473100ee06e0c796c2955552b");
}

test "a key longer than a block is hashed first" {
    let allocator = mem::page_allocator();
    let key = try repeated(allocator, 170, 131);
    defer key.deinit(allocator);
    let key_bytes = key.as_bytes();
    try expect_hmac(allocator, key_bytes, "Test Using Larger Than Block-Size Key - Hash Key First",
        "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54");
    try expect_hmac(allocator, key_bytes,
        "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.",
        "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2");
}

test "a key of no bytes and a key of one block are taken as they are" {
    let allocator = mem::page_allocator();
    try expect_hmac(allocator, "", "",
        "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad");
    let key = try repeated(allocator, 107, 64);
    defer key.deinit(allocator);
    let key_bytes = key.as_bytes();
    try expect_hmac(allocator, key_bytes, "exactly one block of key",
        "baa93ea4ccc7062ed6870c5e7937dbd35ad7791df4e29df9addeb429ff491acf");
}

test "the RFC 5869 cases extract and expand as the RFC says" {
    let allocator = mem::page_allocator();
    // A.1: a short salt, a short info, 42 bytes out.
    let salt1 = try sequence(allocator, 0, 12);
    defer salt1.deinit(allocator);
    let ikm1 = try repeated(allocator, 11, 22);
    defer ikm1.deinit(allocator);
    let info1 = try sequence(allocator, 240, 249);
    defer info1.deinit(allocator);
    let salt1_bytes = salt1.as_bytes();
    let ikm1_bytes = ikm1.as_bytes();
    let info1_bytes = info1.as_bytes();
    var key1 = [32]u8{};
    let key1_view = key1.as_mut_bytes();
    try expect_extract(allocator, salt1_bytes, ikm1_bytes, key1_view,
        "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");
    let key1_bytes = key1.as_bytes();
    var out1 = [42]u8{};
    let out1_view = out1.as_mut_bytes();
    try expect_expand(allocator, key1_bytes, info1_bytes, out1_view,
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865");
    // A.2: everything longer than a block, 82 bytes out across three blocks.
    let salt2 = try sequence(allocator, 96, 175);
    defer salt2.deinit(allocator);
    let ikm2 = try sequence(allocator, 0, 79);
    defer ikm2.deinit(allocator);
    let info2 = try sequence(allocator, 176, 255);
    defer info2.deinit(allocator);
    let salt2_bytes = salt2.as_bytes();
    let ikm2_bytes = ikm2.as_bytes();
    let info2_bytes = info2.as_bytes();
    var key2 = [32]u8{};
    let key2_view = key2.as_mut_bytes();
    try expect_extract(allocator, salt2_bytes, ikm2_bytes, key2_view,
        "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244");
    let key2_bytes = key2.as_bytes();
    var out2 = [82]u8{};
    let out2_view = out2.as_mut_bytes();
    try expect_expand(allocator, key2_bytes, info2_bytes, out2_view,
        "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87");
    // A.3: no salt and no info.
    var key3 = [32]u8{};
    let key3_view = key3.as_mut_bytes();
    try expect_extract(allocator, "", ikm1_bytes, key3_view,
        "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04");
    let key3_bytes = key3.as_bytes();
    var out3 = [42]u8{};
    let out3_view = out3.as_mut_bytes();
    try expect_expand(allocator, key3_bytes, "", out3_view,
        "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8");
}

test "an expansion is the same bytes however long it is cut" {
    let allocator = mem::page_allocator();
    var key = [32]u8{};
    let key_view = key.as_mut_bytes();
    crypto::hkdf_extract("salt", "a shared secret", key_view);
    let key_bytes = key.as_bytes();
    var short = [16]u8{};
    let short_view = short.as_mut_bytes();
    crypto::hkdf_expand(key_bytes, "kizu example key", short_view);
    var long = [64]u8{};
    let long_view = long.as_mut_bytes();
    crypto::hkdf_expand(key_bytes, "kizu example key", long_view);
    let short_bytes = short.as_bytes();
    let long_bytes = long.as_bytes();
    testing::expect_equal<[]u8>(short_bytes, long_bytes[0..16]);
    let long_hex = try hex_of(allocator, long_bytes);
    defer long_hex.deinit(allocator);
    let got = long_hex.as_bytes();
    testing::expect_equal<[]u8>(
        "9127d0ef281429e318a1b5c710d884a49e3c97bbd4c30d7cc4f63f6112789f646539bb2d7dbe4821604c31d1349cd91f5208ac9be0c9e06fcd2bc929cf4ceaff",
        got);
}

test "a constant-time comparison answers what a plain one does" {
    testing::expect(crypto::equal_constant_time("", ""));
    testing::expect(crypto::equal_constant_time("secret", "secret"));
    testing::expect(!crypto::equal_constant_time("secret", "secreT"));
    testing::expect(!crypto::equal_constant_time("Secret", "secret"));
    testing::expect(!crypto::equal_constant_time("secret", "secret!"));
    testing::expect(!crypto::equal_constant_time("secret", ""));
}

fn all_zero(bytes: []u8) -> bool {
    for 0..mem::len(bytes) |index| {
        if bytes[index] != 0 {
            return false;
        }
    }
    return true;
}

test "a draw has the length asked for and two draws differ" {
    let allocator = mem::page_allocator();
    let io = io::blocking();
    let first = try crypto::random_bytes(io, allocator, 32);
    defer first.deinit(allocator);
    let second = try crypto::random_bytes(io, allocator, 32);
    defer second.deinit(allocator);
    testing::expect_equal<i64>(32, first.len());
    testing::expect_equal<i64>(32, second.len());
    let first_bytes = first.as_bytes();
    let second_bytes = second.as_bytes();
    testing::expect(!mem::equal_bytes(first_bytes, second_bytes));
}

test "a long draw is filled to the end" {
    let allocator = mem::page_allocator();
    // Longer than any one chunk a host answers, so the tail is drawn too.
    let long = try crypto::random_bytes(io::blocking(), allocator, 100000);
    defer long.deinit(allocator);
    testing::expect_equal<i64>(100000, long.len());
    let bytes = long.as_bytes();
    testing::expect(!all_zero(bytes[99000..100000]));
}

test "a draw of nothing is an empty string" {
    let allocator = mem::page_allocator();
    let none = try crypto::random_bytes(io::blocking(), allocator, 0);
    defer none.deinit(allocator);
    testing::expect_equal<i64>(0, none.len());
}

test "random_into appends after what the buffer held" {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try out.append_bytes(allocator, "nonce:");
    try crypto::random_into(io::blocking(), allocator, &var out, 12);
    testing::expect_equal<i64>(18, out.len());
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>("nonce:", bytes[0..6]);
}

test "a failing io draws nothing and leaves the buffer as it was" {
    let allocator = mem::page_allocator();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    try out.append_bytes(allocator, "kept");
    if crypto::random_into(testing::failing_io(), allocator, &var out, 8) {
        testing::fail("a failing io drew bytes");
    } else |err| {
        testing::expect(err == crypto::Error::IoFailing);
    }
    let bytes = out.as_bytes();
    testing::expect_equal<[]u8>("kept", bytes);
}

test "the RFC 8439 message seals to the ciphertext and tag the RFC lists" {
    let allocator = mem::page_allocator();
    let key = try sequence(allocator, 128, 159);
    defer key.deinit(allocator);
    let nonce = try bytes_of_hex(allocator, "070000004041424344454647");
    defer nonce.deinit(allocator);
    let aad = try bytes_of_hex(allocator, "50515253c0c1c2c3c4c5c6c7");
    defer aad.deinit(allocator);
    let plain = try bytes_of_hex(allocator, "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e");
    defer plain.deinit(allocator);
    let key_bytes = key.as_bytes();
    let nonce_bytes = nonce.as_bytes();
    let aad_bytes = aad.as_bytes();
    let plain_bytes = plain.as_bytes();
    var sealed = string::new(allocator);
    defer sealed.deinit(allocator);
    try crypto::chacha20_poly1305_seal(allocator, key_bytes, nonce_bytes, aad_bytes, plain_bytes, &var sealed);
    let sealed_bytes = sealed.as_bytes();
    let hex = try hex_of(allocator, sealed_bytes);
    defer hex.deinit(allocator);
    let got = hex.as_bytes();
    testing::expect_equal<[]u8>(
        "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691",
        got);
    var opened = string::new(allocator);
    defer opened.deinit(allocator);
    try crypto::chacha20_poly1305_open(allocator, key_bytes, nonce_bytes, aad_bytes, sealed_bytes, &var opened);
    let opened_bytes = opened.as_bytes();
    testing::expect_equal<[]u8>(plain_bytes, opened_bytes);
}

test "the RFC 8439 appendix message opens to its plain text" {
    let allocator = mem::page_allocator();
    let key = try bytes_of_hex(allocator, "1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0");
    defer key.deinit(allocator);
    let aad = try bytes_of_hex(allocator, "f33388860000000000004e91");
    defer aad.deinit(allocator);
    let sealed = try bytes_of_hex(allocator, "");
    defer sealed.deinit(allocator);
    let plain = try bytes_of_hex(allocator, "");
    defer plain.deinit(allocator);
    let key_bytes = key.as_bytes();
    let nonce = try bytes_of_hex(allocator, "000000000102030405060708");
    defer nonce.deinit(allocator);
    let nonce_bytes = nonce.as_bytes();
    let aad_bytes = aad.as_bytes();
    let sealed_bytes = sealed.as_bytes();
    var opened = string::new(allocator);
    defer opened.deinit(allocator);
    try crypto::chacha20_poly1305_open(allocator, key_bytes, nonce_bytes, aad_bytes, sealed_bytes, &var opened);
    let plain_bytes = plain.as_bytes();
    let opened_bytes = opened.as_bytes();
    testing::expect_equal<[]u8>(plain_bytes, opened_bytes);
    testing::expect_equal<i64>(265, opened.len());
}

test "a message changed anywhere is refused and yields no bytes" {
    let allocator = mem::page_allocator();
    let key = try sequence(allocator, 128, 159);
    defer key.deinit(allocator);
    let key_bytes = key.as_bytes();
    let nonce = "twelve bytes";
    var sealed = string::new(allocator);
    defer sealed.deinit(allocator);
    try crypto::chacha20_poly1305_seal(allocator, key_bytes, nonce, "header", "a message", &var sealed);
    testing::expect_equal<i64>(9 + 16, sealed.len());
    // One bit of the text, one bit of the tag, another header, another
    // nonce, a tag cut short: each is a different message.
    var text_changed = string::new(allocator);
    defer text_changed.deinit(allocator);
    try text_changed.append_string(allocator, &sealed);
    let text_view = text_changed.as_mut_bytes();
    text_view[3] = text_view[3] ^ 128;
    let text_bytes = text_changed.as_bytes();
    expect_refused(allocator, key_bytes, nonce, "header", text_bytes);
    var tag_changed = string::new(allocator);
    defer tag_changed.deinit(allocator);
    try tag_changed.append_string(allocator, &sealed);
    let tag_view = tag_changed.as_mut_bytes();
    tag_view[24] = tag_view[24] ^ 1;
    let tag_bytes = tag_changed.as_bytes();
    expect_refused(allocator, key_bytes, nonce, "header", tag_bytes);
    let sealed_bytes = sealed.as_bytes();
    expect_refused(allocator, key_bytes, nonce, "Header", sealed_bytes);
    expect_refused(allocator, key_bytes, "twelve Bytes", "header", sealed_bytes);
    expect_refused(allocator, key_bytes, nonce, "header", sealed_bytes[0..20]);
    expect_refused(allocator, key_bytes, nonce, "header", "");
}

test "an empty message seals to a tag alone and opens to nothing" {
    let allocator = mem::page_allocator();
    let key = try sequence(allocator, 0, 31);
    defer key.deinit(allocator);
    let key_bytes = key.as_bytes();
    var sealed = string::new(allocator);
    defer sealed.deinit(allocator);
    try crypto::chacha20_poly1305_seal(allocator, key_bytes, "twelve bytes", "", "", &var sealed);
    testing::expect_equal<i64>(16, sealed.len());
    var opened = string::new(allocator);
    defer opened.deinit(allocator);
    let sealed_bytes = sealed.as_bytes();
    try crypto::chacha20_poly1305_open(allocator, key_bytes, "twelve bytes", "", sealed_bytes, &var opened);
    testing::expect_equal<i64>(0, opened.len());
}

test "a long message crosses many blocks and comes back whole" {
    let allocator = mem::page_allocator();
    let key = try sequence(allocator, 0, 31);
    defer key.deinit(allocator);
    let key_bytes = key.as_bytes();
    var text = string::new(allocator);
    defer text.deinit(allocator);
    for 0..5000 |index| {
        try text.append_byte(allocator, cast<u8>(index % 251));
    }
    let text_bytes = text.as_bytes();
    var sealed = string::new(allocator);
    defer sealed.deinit(allocator);
    try sealed.append_bytes(allocator, "kept:");
    try crypto::chacha20_poly1305_seal(allocator, key_bytes, "twelve bytes", "aad", text_bytes, &var sealed);
    testing::expect_equal<i64>(5 + 5000 + 16, sealed.len());
    let sealed_bytes = sealed.as_bytes();
    var opened = string::new(allocator);
    defer opened.deinit(allocator);
    try crypto::chacha20_poly1305_open(allocator, key_bytes, "twelve bytes", "aad", sealed_bytes[5..sealed.len()], &var opened);
    let opened_bytes = opened.as_bytes();
    testing::expect_equal<[]u8>(text_bytes, opened_bytes);
}

test "the GCM specification cases seal and open under AES-128 and AES-256" {
    let allocator = mem::page_allocator();
    let zero16 = try repeated(allocator, 0, 16);
    defer zero16.deinit(allocator);
    let zero32 = try repeated(allocator, 0, 32);
    defer zero32.deinit(allocator);
    let zero12 = try repeated(allocator, 0, 12);
    defer zero12.deinit(allocator);
    let zero16_bytes = zero16.as_bytes();
    let zero32_bytes = zero32.as_bytes();
    let zero12_bytes = zero12.as_bytes();
    // Cases 1, 2, 13, 14: the zero key, no data or one zero block.
    try expect_gcm(allocator, zero16_bytes, zero12_bytes, "", "",
        "58e2fccefa7e3061367f1d57a4e7455a");
    try expect_gcm(allocator, zero16_bytes, zero12_bytes, "", zero16_bytes,
        "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf");
    try expect_gcm(allocator, zero32_bytes, zero12_bytes, "", "",
        "530f8afbc74536b9a963b4f1c4cb738b");
    try expect_gcm(allocator, zero32_bytes, zero12_bytes, "", zero16_bytes,
        "cea7403d4d606b6e074ec5d3baf39d18d0d1c8a799996bf0265b98b5d48ab919");
    // Cases 3, 4, 15, 16: four blocks, then 60 bytes with associated data.
    let key = try bytes_of_hex(allocator, "feffe9928665731c6d6a8f9467308308");
    defer key.deinit(allocator);
    let key256 = try bytes_of_hex(allocator, "feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308");
    defer key256.deinit(allocator);
    let nonce = try bytes_of_hex(allocator, "cafebabefacedbaddecaf888");
    defer nonce.deinit(allocator);
    let plain = try bytes_of_hex(allocator, "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39");
    defer plain.deinit(allocator);
    let aad = try bytes_of_hex(allocator, "feedfacedeadbeeffeedfacedeadbeefabaddad2");
    defer aad.deinit(allocator);
    let key_bytes = key.as_bytes();
    let key256_bytes = key256.as_bytes();
    let nonce_bytes = nonce.as_bytes();
    let plain_bytes = plain.as_bytes();
    let aad_bytes = aad.as_bytes();
    try expect_gcm(allocator, key_bytes, nonce_bytes, "", plain_bytes,
        "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091cc15abcc191161501aabab46b8fbac85");
    try expect_gcm(allocator, key_bytes, nonce_bytes, aad_bytes, plain_bytes[0..60],
        "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47");
    try expect_gcm(allocator, key256_bytes, nonce_bytes, "", plain_bytes,
        "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662eb9f796c8d356fc31a8433884b696f4f");
    try expect_gcm(allocator, key256_bytes, nonce_bytes, aad_bytes, plain_bytes[0..60],
        "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f66276fc6ece0f4e1768cddf8853bb2d551b");
}

test "an AES-GCM message changed anywhere is refused and yields no bytes" {
    let allocator = mem::page_allocator();
    let key = "an example key!!";
    let nonce = "twelve bytes";
    var sealed = string::new(allocator);
    defer sealed.deinit(allocator);
    try crypto::aes_gcm_seal(allocator, key, nonce, "header", "a message", &var sealed);
    testing::expect_equal<i64>(9 + 16, sealed.len());
    var text_changed = string::new(allocator);
    defer text_changed.deinit(allocator);
    try text_changed.append_string(allocator, &sealed);
    let text_view = text_changed.as_mut_bytes();
    text_view[3] = text_view[3] ^ 128;
    let text_bytes = text_changed.as_bytes();
    expect_gcm_refused(allocator, key, nonce, "header", text_bytes);
    var tag_changed = string::new(allocator);
    defer tag_changed.deinit(allocator);
    try tag_changed.append_string(allocator, &sealed);
    let tag_view = tag_changed.as_mut_bytes();
    tag_view[24] = tag_view[24] ^ 1;
    let tag_bytes = tag_changed.as_bytes();
    expect_gcm_refused(allocator, key, nonce, "header", tag_bytes);
    let sealed_bytes = sealed.as_bytes();
    expect_gcm_refused(allocator, key, nonce, "Header", sealed_bytes);
    expect_gcm_refused(allocator, key, "twelve Bytes", "header", sealed_bytes);
    expect_gcm_refused(allocator, key, nonce, "header", sealed_bytes[0..20]);
    expect_gcm_refused(allocator, key, nonce, "header", "");
}

test "a long AES-GCM message crosses many counter blocks and comes back whole" {
    let allocator = mem::page_allocator();
    let key = try sequence(allocator, 0, 31);
    defer key.deinit(allocator);
    let key_bytes = key.as_bytes();
    var text = string::new(allocator);
    defer text.deinit(allocator);
    for 0..5000 |index| {
        try text.append_byte(allocator, cast<u8>(index % 251));
    }
    let text_bytes = text.as_bytes();
    var sealed = string::new(allocator);
    defer sealed.deinit(allocator);
    try sealed.append_bytes(allocator, "kept:");
    try crypto::aes_gcm_seal(allocator, key_bytes, "twelve bytes", "aad", text_bytes, &var sealed);
    testing::expect_equal<i64>(5 + 5000 + 16, sealed.len());
    let sealed_bytes = sealed.as_bytes();
    var opened = string::new(allocator);
    defer opened.deinit(allocator);
    try crypto::aes_gcm_open(allocator, key_bytes, "twelve bytes", "aad", sealed_bytes[5..sealed.len()], &var opened);
    let opened_bytes = opened.as_bytes();
    testing::expect_equal<[]u8>(text_bytes, opened_bytes);
}
