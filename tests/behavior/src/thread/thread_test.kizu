import std::array;
import std::io;
import std::mem;
import std::testing;
import std::thread;

// A pool round's contract as the caller sees it: every element lands in
// exactly one chunk, a chunk is `chunk` elements except the last, the index
// counts chunks, and every chunk has run by the time `each` returns.
//
// That the chunks run at the same time is not visible from here: a worker has
// nothing to report through except its own chunk. It is what the timing in
// `examples/thread_each.kizu`'s comment is about.

error Failure = thread::Error or mem::Error;

struct Sample {
    value: f64,
    chunk: i64,
    size: i64,
    flag: u8,
}

// Writes into every element which chunk it was in and how long that chunk was.
fn stamp(part: &var []i64, index: i64) -> Failure!void {
    let size = mem::count<i64>(part);
    for 0..size |i| {
        part[i] = part[i] + index * 1000 + size * 1000000;
    }
    return;
}

fn stamp_sample(part: &var []Sample, index: i64) -> Failure!void {
    let size = mem::count<Sample>(part);
    for 0..size |i| {
        let old = part[i];
        part[i] = Sample { value: old.value * 2.0, chunk: index, size: size, flag: old.flag };
    }
    return;
}

fn count_up(values: &var array::Array<i64>, allocator: Allocator, n: i64) -> mem::Error!void {
    for 0..n |i| {
        try values.append(allocator, i);
    }
    return;
}

fn check_stamps(pool: &var thread::Pool, allocator: Allocator, n: i64, chunk: i64) -> Failure!void {
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, n);
    let cells = values.as_mut_slice();
    try thread::each<i64, Failure>(pool, cells, chunk, stamp);
    for 0..n |i| {
        let index = i / chunk;
        var size = chunk;
        if (index + 1) * chunk > n {
            size = n - index * chunk;
        }
        testing::expect_equal<i64>(i + index * 1000 + size * 1000000, values.get_or_panic(i));
    }
    return;
}

test "every element lands in exactly one chunk" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    try check_stamps(&var pool, allocator, 100, 7);
}

test "a chunk wider than the slice is the whole slice" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    try check_stamps(&var pool, allocator, 5, 64);
}

test "a pool of one thread is the caller alone" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 1);
    defer pool.deinit(allocator);
    try check_stamps(&var pool, allocator, 30, 4);
}

test "one pool runs round after round" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 3);
    defer pool.deinit(allocator);
    for 0..50 |round| {
        try check_stamps(&var pool, allocator, 40 + round, 3);
    }
}

test "an empty slice runs no chunk" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 2);
    defer pool.deinit(allocator);
    try check_stamps(&var pool, allocator, 0, 3);
}

test "chunks are cut by the element's own size" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var samples = array::new<Sample>(allocator);
    defer samples.deinit(allocator);
    for 0..10 |i| {
        try samples.append(allocator, Sample { value: cast<f64>(i), chunk: -1, size: 0, flag: 7 });
    }
    let cells = samples.as_mut_slice();
    try thread::each<Sample, Failure>(&var pool, cells, 4, stamp_sample);
    for 0..10 |i| {
        let sample = samples.get_or_panic(i);
        testing::expect_equal<i64>(i / 4, sample.chunk);
        testing::expect(sample.value == cast<f64>(i) * 2.0);
        testing::expect_equal<u8>(7, sample.flag);
    }
    testing::expect_equal<i64>(2, samples.get_or_panic(9).size);
}

// Keeps what the element held, and adds which lane it was in and where.
fn mark_lane(lane: &var []i64, index: i64) -> Failure!void {
    for 0..mem::count<i64>(lane) |j| {
        lane[j] = lane[j] * 1000000 + index * 1000 + j;
    }
    return;
}

// Fills a nx * ny * nz grid, x fastest, with each element's own offset, runs
// one lane round along the axis `length` and `stride` name, and checks every
// element came back to its own place marked with its lane and position.
fn check_lanes(
    pool: &var thread::Pool,
    allocator: Allocator,
    n: i64,
    length: i64,
    stride: i64
) -> Failure!void {
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, n);
    let cells = values.as_mut_slice();
    try thread::each_lane<i64, Failure>(pool, allocator, cells, length, stride, mark_lane);
    for 0..n |offset| {
        let block = offset / (length * stride);
        let within = offset % (length * stride);
        let lane = block * stride + within % stride;
        let position = within / stride;
        testing::expect_equal<i64>(
            offset * 1000000 + lane * 1000 + position, values.get_or_panic(offset));
    }
    return;
}

test "lanes along each axis of a grid come back in place" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    // A 4 x 3 x 5 grid, x fastest: rows, then columns, then the slowest axis.
    try check_lanes(&var pool, allocator, 60, 4, 1);
    try check_lanes(&var pool, allocator, 60, 3, 4);
    try check_lanes(&var pool, allocator, 60, 5, 12);
}

test "more threads than there is work, round after round" {
    // Threads that arrive after the work is gone, or that the OS has put
    // aside, must neither take the next round's items nor hold a round up.
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 16);
    defer pool.deinit(allocator);
    for 0..100 |round| {
        try check_lanes(&var pool, allocator, 24, 6, 4);
        try check_stamps(&var pool, allocator, 3 + round % 5, 1);
    }
}

test "a pool of one thread runs lanes alone" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 1);
    defer pool.deinit(allocator);
    try check_lanes(&var pool, allocator, 24, 6, 4);
}

// Fails on the chunk numbered `bad`, after writing 1 into it; every other
// chunk writes 1 too.
fn fail_on(part: &var []i64, index: i64) -> Failure!void {
    for 0..mem::count<i64>(part) |i| {
        part[i] = 1;
    }
    if index == part[0] * 3 {
        return mem::Error::OutOfMemory;
    }
    return;
}

fn fails(pool: &var thread::Pool, cells: &var []i64) -> bool {
    thread::each<i64, Failure>(pool, cells, 1, fail_on) catch return true;
    return false;
}

fn lane_fails(pool: &var thread::Pool, allocator: Allocator, cells: &var []i64) -> bool {
    thread::each_lane<i64, Failure>(pool, allocator, cells, 2, 4, fail_on) catch return true;
    return false;
}

test "a worker's failure is the round's result" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, 64);
    // Chunk 3 fails. Chunks already running finish and what they wrote
    // stays; the round reports the failure instead of returning normally.
    let cells = values.as_mut_slice();
    testing::expect(fails(&var pool, cells));
    testing::expect_equal<i64>(1, values.get_or_panic(3));
    // A lane that fails is still copied back.
    let lanes = values.as_mut_slice();
    testing::expect(lane_fails(&var pool, allocator, lanes));
    testing::expect_equal<i64>(1, values.get_or_panic(3));
}

test "the pool runs rounds after a failure" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    for 0..20 |round| {
        var values = array::new<i64>(allocator);
        defer values.deinit(allocator);
        try count_up(&var values, allocator, 32);
        let cells = values.as_mut_slice();
        testing::expect(fails(&var pool, cells));
        try check_stamps(&var pool, allocator, 40 + round, 3);
    }
}

// A thread's own state: a scratch run it owns, and how many lanes it took.
struct Reverser {
    scratch: array::Array<i64>,
    lanes: i64,
}

fn (self: Reverser) deinit(allocator: Allocator) -> void {
    self.scratch.deinit(allocator);
    return;
}

// Reverses a lane through the state's scratch run, which the thread keeps
// from lane to lane.
fn reverse_lane(state: &var Reverser, lane: &var []i64, index: i64) -> Failure!void {
    let n = mem::count<i64>(lane);
    let scratch = state.scratch.as_mut_slice();
    for 0..n |i| {
        scratch[i] = lane[n - 1 - i];
    }
    for 0..n |i| {
        lane[i] = scratch[i];
    }
    state.lanes = state.lanes + 1;
    return;
}

fn reversers(allocator: Allocator, threads: i64, n: i64) -> mem::Error!array::Array<Reverser> {
    var states = array::new<Reverser>(allocator);
    errdefer states.deinit(allocator);
    for 0..threads |_t| {
        var scratch = array::new<i64>(allocator);
        errdefer scratch.deinit(allocator);
        try count_up(&var scratch, allocator, n);
        try states.append(allocator, Reverser { scratch: move scratch, lanes: 0 });
    }
    return move states;
}

fn fail_in_state(state: &var i64, part: &var []i64, index: i64) -> Failure!void {
    state.* = state.* + 1;
    if index == 3 {
        return thread::Error::SpawnFailed;
    }
    return;
}

fn fails_with_states(
    pool: &var thread::Pool,
    cells: &var []i64,
    states: &var array::Array<i64>
) -> bool {
    thread::each_with<i64, i64, Failure>(pool, cells, 1, states, fail_in_state) catch return true;
    return false;
}

test "each_lane_with hands every lane its thread's own state" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var states = try reversers(allocator, pool.threads(), 5);
    defer states.deinit(allocator);
    for 0..20 |_round| {
        var values = array::new<i64>(allocator);
        defer values.deinit(allocator);
        try count_up(&var values, allocator, 5 * 6);
        let cells = values.as_mut_slice();
        // Six columns of five, 6 apart: column c is c, c + 6, ..., c + 24.
        try thread::each_lane_with<i64, Reverser, Failure>(
            &var pool, allocator, cells, 5, 6, &var states, reverse_lane);
        for 0..30 |i| {
            let row = i / 6;
            let column = i % 6;
            testing::expect(values.get_or_panic(i) == (4 - row) * 6 + column);
        }
    }
    var lanes = 0;
    for 0..states.len() |i| {
        if states.at(i) |state| {
            lanes = lanes + state.lanes;
        }
    }
    testing::expect(lanes == 20 * 6);
}

test "each_with returns a worker's failure and keeps the states' writes" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 3);
    defer pool.deinit(allocator);
    var states = array::new<i64>(allocator);
    defer states.deinit(allocator);
    for 0..pool.threads() |_t| {
        try states.append(allocator, 0);
    }
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, 12);
    let cells = values.as_mut_slice();
    testing::expect(fails_with_states(&var pool, cells, &var states));
    var calls = 0;
    for 0..states.len() |i| {
        calls = calls + states.get_or_panic(i);
    }
    testing::expect(calls >= 1 and calls <= 12);
}

test "the processor count is at least one" {
    testing::expect(thread::cpu_count(io::blocking()) >= 1);
}

struct SharedWeights {
    weights: []i64,
    bias: i64,
    chunk: i64,
}

struct SharedOwned {
    values: array::Array<i64>,
    offset: i64,
    chunk: i64,
}

fn (self: SharedOwned) deinit(allocator: Allocator) -> void {
    self.values.deinit(allocator);
    return;
}

fn apply_shared_weights(ctx: &SharedWeights, part: &var []i64, index: i64) -> Failure!void {
    let base = index * ctx.chunk;
    for 0..mem::count<i64>(part) |i| {
        part[i] = ctx.weights[base + i] * 3 + ctx.bias;
    }
    return;
}

fn apply_shared_owned(ctx: &SharedOwned, part: &var []i64, index: i64) -> Failure!void {
    let values = ctx.values.as_slice();
    let base = index * ctx.chunk;
    for 0..mem::count<i64>(part) |i| {
        part[i] = values[base + i] + ctx.offset;
    }
    return;
}

fn apply_shared_slice_with_state(
    weights: &[]i64,
    calls: &var i64,
    part: &var []i64,
    index: i64
) -> Failure!void {
    calls.* = calls.* + 1;
    let base = index * 5;
    for 0..mem::count<i64>(part) |i| {
        part[i] = part[i] + weights[base + i];
    }
    return;
}

fn apply_shared_scalar(scale: &f32, part: &var []f32, _index: i64) -> Failure!void {
    for 0..mem::count<f32>(part) |i| {
        part[i] = part[i] * scale.*;
    }
    return;
}

fn apply_shared_lane(delta: &i64, lane: &var []i64, index: i64) -> Failure!void {
    for 0..mem::count<i64>(lane) |i| {
        lane[i] = lane[i] + delta.* + index * 100;
    }
    return;
}

fn apply_shared_lane_with_state(
    ctx: &SharedWeights,
    state: &var Reverser,
    lane: &var []i64,
    _index: i64
) -> Failure!void {
    let n = mem::count<i64>(lane);
    let scratch = state.scratch.as_mut_slice();
    for 0..n |i| {
        scratch[i] = lane[n - 1 - i] + ctx.weights[i] + ctx.bias;
    }
    for 0..n |i| {
        lane[i] = scratch[i];
    }
    state.lanes = state.lanes + 1;
    return;
}

fn fail_shared_on(bad: &i64, part: &var []i64, index: i64) -> Failure!void {
    for 0..mem::count<i64>(part) |i| {
        part[i] = 1;
    }
    if index == bad.* {
        return mem::Error::OutOfMemory;
    }
    return;
}

fn shared_fails(pool: &var thread::Pool, cells: &var []i64, bad: &i64) -> bool {
    thread::each_shared<i64, i64, Failure>(pool, cells, 1, bad, fail_shared_on) catch return true;
    return false;
}

test "each_shared passes a read-only view-carrying context to every chunk" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var weights = array::new<i64>(allocator);
    defer weights.deinit(allocator);
    try count_up(&var weights, allocator, 35);
    var out = array::new<i64>(allocator);
    defer out.deinit(allocator);
    for 0..35 |_| {
        try out.append(allocator, 0);
    }
    let w_view = weights.as_slice();
    let ctx = SharedWeights { weights: w_view, bias: 7, chunk: 6 };
    let cells = out.as_mut_slice();
    try thread::each_shared<i64, SharedWeights, Failure>(&var pool, cells, 6, &ctx, apply_shared_weights);
    for 0..35 |i| {
        testing::expect_equal<i64>(i * 3 + 7, out.get_or_panic(i));
    }
}

test "each_shared borrows an owning context without copying its storage" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var src = array::new<i64>(allocator);
    errdefer src.deinit(allocator);
    try count_up(&var src, allocator, 20);
    let owned = SharedOwned { values: move src, offset: 100, chunk: 4 };
    defer owned.deinit(allocator);
    var out = array::new<i64>(allocator);
    defer out.deinit(allocator);
    for 0..20 |_| {
        try out.append(allocator, 0);
    }
    let cells = out.as_mut_slice();
    try thread::each_shared<i64, SharedOwned, Failure>(&var pool, cells, 4, &owned, apply_shared_owned);
    for 0..20 |i| {
        testing::expect_equal<i64>(i + 100, out.get_or_panic(i));
    }
}

test "each_with_shared combines a shared slice context and per-thread state" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var weights = array::new<i64>(allocator);
    defer weights.deinit(allocator);
    try count_up(&var weights, allocator, 23);
    var out = array::new<i64>(allocator);
    defer out.deinit(allocator);
    for 0..23 |i| {
        try out.append(allocator, i * 10);
    }
    var states = array::new<i64>(allocator);
    defer states.deinit(allocator);
    for 0..pool.threads() |_| {
        try states.append(allocator, 0);
    }
    let w_view = weights.as_slice();
    let cells = out.as_mut_slice();
    try thread::each_with_shared<i64, []i64, i64, Failure>(
        &var pool, cells, 5, &w_view, &var states, apply_shared_slice_with_state);
    for 0..23 |i| {
        testing::expect_equal<i64>(i * 11, out.get_or_panic(i));
    }
    var calls = 0;
    for 0..states.len() |i| {
        calls = calls + states.get_or_panic(i);
    }
    testing::expect_equal<i64>(5, calls);
}

test "each_shared supports scalar float context and one-thread pool" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 1);
    defer pool.deinit(allocator);
    var values = array::new<f32>(allocator);
    defer values.deinit(allocator);
    for 0..12 |i| {
        try values.append(allocator, cast<f32>(i));
    }
    let scale: f32 = 2.5;
    let cells = values.as_mut_slice();
    try thread::each_shared<f32, f32, Failure>(&var pool, cells, 4, &scale, apply_shared_scalar);
    for 0..12 |i| {
        testing::expect(values.get_or_panic(i) == cast<f32>(i) * 2.5);
    }
}

test "each_lane_shared and each_lane_with_shared work across strided lanes" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, 12);
    let delta: i64 = 1000;
    let cells = values.as_mut_slice();
    try thread::each_lane_shared<i64, i64, Failure>(&var pool, allocator, cells, 3, 4, &delta, apply_shared_lane);
    for 0..12 |offset| {
        let lane = offset % 4;
        testing::expect_equal<i64>(offset + 1000 + lane * 100, values.get_or_panic(offset));
    }

    var w = array::new<i64>(allocator);
    defer w.deinit(allocator);
    try count_up(&var w, allocator, 5);
    let w_view = w.as_slice();
    let ctx = SharedWeights { weights: w_view, bias: 10, chunk: 1 };
    var states = try reversers(allocator, pool.threads(), 5);
    defer states.deinit(allocator);
    var grid = array::new<i64>(allocator);
    defer grid.deinit(allocator);
    try count_up(&var grid, allocator, 30);
    let grid_cells = grid.as_mut_slice();
    try thread::each_lane_with_shared<i64, SharedWeights, Reverser, Failure>(
        &var pool, allocator, grid_cells, 5, 6, &ctx, &var states, apply_shared_lane_with_state);
    for 0..30 |i| {
        let row = i / 6;
        let col = i % 6;
        testing::expect_equal<i64>((4 - row) * 6 + col + row + 10, grid.get_or_panic(i));
    }
    var lanes = 0;
    for 0..states.len() |i| {
        if states.at(i) |state| {
            lanes = lanes + state.lanes;
        }
    }
    testing::expect_equal<i64>(6, lanes);
}

test "each_shared returns a worker failure and stays reusable" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, 16);
    let bad: i64 = 5;
    let cells = values.as_mut_slice();
    testing::expect(shared_fails(&var pool, cells, &bad));
    testing::expect_equal<i64>(1, values.get_or_panic(5));
    try check_stamps(&var pool, allocator, 20, 4);
}
