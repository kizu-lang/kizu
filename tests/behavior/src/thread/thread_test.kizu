import std::array;
import std::io;
import std::mem;
import std::testing;
import std::thread;

// A pool round's contract as the caller sees it: every element lands in
// exactly one chunk, a chunk is `chunk` elements except the last, the index
// counts chunks, and every chunk has run by the time `each` returns.
//
// That the chunks run at the same time is not visible from here: a worker has
// nothing to report through except its own chunk. It is what the timing in
// `examples/thread_each.kizu`'s comment is about.

error Failure = thread::Error or mem::Error;

struct Sample {
    value: f64,
    chunk: i64,
    size: i64,
    flag: u8,
}

// Writes into every element which chunk it was in and how long that chunk was.
fn stamp(part: &var []i64, index: i64) -> Failure!void {
    let size = mem::count<i64>(part);
    for 0..size |i| {
        part[i] = part[i] + index * 1000 + size * 1000000;
    }
    return;
}

fn stamp_sample(part: &var []Sample, index: i64) -> Failure!void {
    let size = mem::count<Sample>(part);
    for 0..size |i| {
        let old = part[i];
        part[i] = Sample { value: old.value * 2.0, chunk: index, size: size, flag: old.flag };
    }
    return;
}

fn count_up(values: &var array::Array<i64>, allocator: Allocator, n: i64) -> mem::Error!void {
    for 0..n |i| {
        try values.append(allocator, i);
    }
    return;
}

fn check_stamps(pool: &var thread::Pool, allocator: Allocator, n: i64, chunk: i64) -> Failure!void {
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, n);
    let cells = values.as_mut_slice();
    try thread::each<i64, Failure>(pool, cells, chunk, stamp);
    for 0..n |i| {
        let index = i / chunk;
        var size = chunk;
        if (index + 1) * chunk > n {
            size = n - index * chunk;
        }
        testing::expect_equal<i64>(i + index * 1000 + size * 1000000, values.get_or_panic(i));
    }
    return;
}

test "every element lands in exactly one chunk" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    try check_stamps(&var pool, allocator, 100, 7);
}

test "a chunk wider than the slice is the whole slice" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    try check_stamps(&var pool, allocator, 5, 64);
}

test "a pool of one thread is the caller alone" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 1);
    defer pool.deinit(allocator);
    try check_stamps(&var pool, allocator, 30, 4);
}

test "one pool runs round after round" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 3);
    defer pool.deinit(allocator);
    for 0..50 |round| {
        try check_stamps(&var pool, allocator, 40 + round, 3);
    }
}

test "an empty slice runs no chunk" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 2);
    defer pool.deinit(allocator);
    try check_stamps(&var pool, allocator, 0, 3);
}

test "chunks are cut by the element's own size" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var samples = array::new<Sample>(allocator);
    defer samples.deinit(allocator);
    for 0..10 |i| {
        try samples.append(allocator, Sample { value: cast<f64>(i), chunk: -1, size: 0, flag: 7 });
    }
    let cells = samples.as_mut_slice();
    try thread::each<Sample, Failure>(&var pool, cells, 4, stamp_sample);
    for 0..10 |i| {
        let sample = samples.get_or_panic(i);
        testing::expect_equal<i64>(i / 4, sample.chunk);
        testing::expect(sample.value == cast<f64>(i) * 2.0);
        testing::expect_equal<u8>(7, sample.flag);
    }
    testing::expect_equal<i64>(2, samples.get_or_panic(9).size);
}

// Keeps what the element held, and adds which lane it was in and where.
fn mark_lane(lane: &var []i64, index: i64) -> Failure!void {
    for 0..mem::count<i64>(lane) |j| {
        lane[j] = lane[j] * 1000000 + index * 1000 + j;
    }
    return;
}

// Fills a nx * ny * nz grid, x fastest, with each element's own offset, runs
// one lane round along the axis `length` and `stride` name, and checks every
// element came back to its own place marked with its lane and position.
fn check_lanes(
    pool: &var thread::Pool,
    allocator: Allocator,
    n: i64,
    length: i64,
    stride: i64
) -> Failure!void {
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, n);
    let cells = values.as_mut_slice();
    try thread::each_lane<i64, Failure>(pool, allocator, cells, length, stride, mark_lane);
    for 0..n |offset| {
        let block = offset / (length * stride);
        let within = offset % (length * stride);
        let lane = block * stride + within % stride;
        let position = within / stride;
        testing::expect_equal<i64>(
            offset * 1000000 + lane * 1000 + position, values.get_or_panic(offset));
    }
    return;
}

test "lanes along each axis of a grid come back in place" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    // A 4 x 3 x 5 grid, x fastest: rows, then columns, then the slowest axis.
    try check_lanes(&var pool, allocator, 60, 4, 1);
    try check_lanes(&var pool, allocator, 60, 3, 4);
    try check_lanes(&var pool, allocator, 60, 5, 12);
}

test "more threads than there is work, round after round" {
    // Threads that arrive after the work is gone, or that the OS has put
    // aside, must neither take the next round's items nor hold a round up.
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 16);
    defer pool.deinit(allocator);
    for 0..100 |round| {
        try check_lanes(&var pool, allocator, 24, 6, 4);
        try check_stamps(&var pool, allocator, 3 + round % 5, 1);
    }
}

test "a pool of one thread runs lanes alone" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 1);
    defer pool.deinit(allocator);
    try check_lanes(&var pool, allocator, 24, 6, 4);
}

// Fails on the chunk numbered `bad`, after writing 1 into it; every other
// chunk writes 1 too.
fn fail_on(part: &var []i64, index: i64) -> Failure!void {
    for 0..mem::count<i64>(part) |i| {
        part[i] = 1;
    }
    if index == part[0] * 3 {
        return mem::Error::OutOfMemory;
    }
    return;
}

fn fails(pool: &var thread::Pool, cells: &var []i64) -> bool {
    thread::each<i64, Failure>(pool, cells, 1, fail_on) catch return true;
    return false;
}

fn lane_fails(pool: &var thread::Pool, allocator: Allocator, cells: &var []i64) -> bool {
    thread::each_lane<i64, Failure>(pool, allocator, cells, 2, 4, fail_on) catch return true;
    return false;
}

test "a worker's failure is the round's result" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    var values = array::new<i64>(allocator);
    defer values.deinit(allocator);
    try count_up(&var values, allocator, 64);
    // Chunk 3 fails. Chunks already running finish and what they wrote
    // stays; the round reports the failure instead of returning normally.
    let cells = values.as_mut_slice();
    testing::expect(fails(&var pool, cells));
    testing::expect_equal<i64>(1, values.get_or_panic(3));
    // A lane that fails is still copied back.
    let lanes = values.as_mut_slice();
    testing::expect(lane_fails(&var pool, allocator, lanes));
    testing::expect_equal<i64>(1, values.get_or_panic(3));
}

test "the pool runs rounds after a failure" {
    let allocator = mem::page_allocator();
    var pool = try thread::init(io::blocking(), allocator, 4);
    defer pool.deinit(allocator);
    for 0..20 |round| {
        var values = array::new<i64>(allocator);
        defer values.deinit(allocator);
        try count_up(&var values, allocator, 32);
        let cells = values.as_mut_slice();
        testing::expect(fails(&var pool, cells));
        try check_stamps(&var pool, allocator, 40 + round, 3);
    }
}

test "the processor count is at least one" {
    testing::expect(thread::cpu_count(io::blocking()) >= 1);
}
