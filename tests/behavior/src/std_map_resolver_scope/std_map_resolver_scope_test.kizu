import std::map;
import std::mem;
import std::string;
import std::testing;

pub enum BindingKind {
    Function,
    Local,
    TypeName,
}

struct Scope {
    pub symbols: map::Map<[]u8, BindingKind>
}

fn (self: &var Scope) declare(
    name: []u8,
    kind: BindingKind
) -> !void {
    try self.symbols.insert(name, kind);
    return;
}

fn (self: &Scope) resolve(name: []u8) -> ?BindingKind {
    return self.symbols.get(name);
}

fn (self: &Scope) len() -> i64 {
    return self.symbols.len();
}

fn (self: &Scope) contains(name: []u8) -> bool {
    return self.symbols.contains(name);
}

test "std map resolver scope" {
    let allocator = mem::page_allocator();
    var scope = Scope {
        symbols: map::new<[]u8, BindingKind>(allocator)
    };
    defer scope.deinit(allocator);
    var owned_name = string::new(allocator);
    defer owned_name.deinit(allocator);

    try owned_name.append_bytes(allocator, "node");
    let node_name = owned_name.as_bytes();
    try scope.declare(node_name, BindingKind::Local);

    try scope.declare("parse_expr", BindingKind::Function);

    testing::expect_equal<i64>(2, scope.len());
    testing::expect(scope.contains("node"));
    testing::expect(!scope.contains("missing"));

    let local = scope.resolve("node") orelse BindingKind::TypeName;
    testing::expect(local == BindingKind::Local);

    let function = scope.resolve("parse_expr") orelse BindingKind::TypeName;
    testing::expect(function == BindingKind::Function);

}
