// transcript appends the handshake messages named, in order.
fn transcript(allocator: Allocator, through_finished: bool) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    let client = try bytes_of_hex(allocator, client_hello());
    defer client.deinit(allocator);
    try out.append_string(allocator, &client);
    let server = try bytes_of_hex(allocator, server_hello());
    defer server.deinit(allocator);
    try out.append_string(allocator, &server);
    if !through_finished {
        return move out;
    }
    let extensions = try bytes_of_hex(allocator, encrypted_extensions());
    defer extensions.deinit(allocator);
    try out.append_string(allocator, &extensions);
    let cert = try bytes_of_hex(allocator, certificate());
    defer cert.deinit(allocator);
    try out.append_string(allocator, &cert);
    let verify = try bytes_of_hex(allocator, certificate_verify());
    defer verify.deinit(allocator);
    try out.append_string(allocator, &verify);
    let finished = try bytes_of_hex(allocator, server_finished());
    defer finished.deinit(allocator);
    try out.append_string(allocator, &finished);
    return move out;
}

fn expect_derived(allocator: Allocator, secret: []u8, label: []u8, hash: []u8, want: []u8) -> mem::Error!void {
    var out = [32]u8{};
    let view = out.as_mut_bytes();
    tls::derive_secret(secret, label, hash, view);
    let bytes = out.as_bytes();
    try expect_hex(allocator, want, bytes);
    return;
}

fn expect_traffic_key(allocator: Allocator, secret: []u8, want_key: []u8, want_iv: []u8) -> mem::Error!void {
    var key = [16]u8{};
    var iv = [12]u8{};
    let key_view = key.as_mut_bytes();
    let iv_view = iv.as_mut_bytes();
    tls::traffic_key(secret, key_view, iv_view);
    let key_bytes = key.as_bytes();
    let iv_bytes = iv.as_bytes();
    try expect_hex(allocator, want_key, key_bytes);
    try expect_hex(allocator, want_iv, iv_bytes);
    return;
}

fn expect_finished(allocator: Allocator, secret: []u8, hash: []u8, want: []u8) -> mem::Error!void {
    var out = [32]u8{};
    let view = out.as_mut_bytes();
    tls::finished_verify_data(secret, hash, view);
    let bytes = out.as_bytes();
    try expect_hex(allocator, want, bytes);
    return;
}

test "the RFC 8448 secrets derive from the key exchange and the transcript" {
    let allocator = mem::page_allocator();
    var early = [32]u8{};
    let early_view = early.as_mut_bytes();
    tls::early_secret(early_view);
    let early_bytes = early.as_bytes();
    try expect_hex(allocator, early_secret(), early_bytes);

    let client_key = try bytes_of_hex(allocator, client_private());
    defer client_key.deinit(allocator);
    let server_key = try bytes_of_hex(allocator, server_public());
    defer server_key.deinit(allocator);
    let scalar = client_key.as_bytes();
    let point = server_key.as_bytes();
    var shared = [32]u8{};
    let shared_view = shared.as_mut_bytes();
    try crypto::x25519(scalar, point, shared_view);
    let shared_bytes = shared.as_bytes();
    var handshake = [32]u8{};
    let handshake_view = handshake.as_mut_bytes();
    tls::handshake_secret(early_bytes, shared_bytes, handshake_view);
    let handshake_bytes = handshake.as_bytes();
    try expect_hex(allocator, handshake_secret(), handshake_bytes);

    let hello = try transcript(allocator, false);
    defer hello.deinit(allocator);
    let hello_bytes = hello.as_bytes();
    var hash = [32]u8{};
    let hash_view = hash.as_mut_bytes();
    tls::transcript_hash(hello_bytes, hash_view);
    let hash_bytes = hash.as_bytes();
    try expect_hex(allocator, transcript_hash_sh(), hash_bytes);
    try expect_derived(allocator, handshake_bytes, "c hs traffic", hash_bytes, client_hs_traffic());
    try expect_derived(allocator, handshake_bytes, "s hs traffic", hash_bytes, server_hs_traffic());

    var master = [32]u8{};
    let master_view = master.as_mut_bytes();
    tls::master_secret(handshake_bytes, master_view);
    let master_bytes = master.as_bytes();
    try expect_hex(allocator, master_secret(), master_bytes);

    let whole = try transcript(allocator, true);
    defer whole.deinit(allocator);
    let whole_bytes = whole.as_bytes();
    var finished_hash = [32]u8{};
    let finished_hash_view = finished_hash.as_mut_bytes();
    tls::transcript_hash(whole_bytes, finished_hash_view);
    let finished_hash_bytes = finished_hash.as_bytes();
    try expect_hex(allocator, transcript_hash_fin(), finished_hash_bytes);
    try expect_derived(allocator, master_bytes, "c ap traffic", finished_hash_bytes, client_ap_traffic());
    try expect_derived(allocator, master_bytes, "s ap traffic", finished_hash_bytes, server_ap_traffic());
}

test "the RFC 8448 traffic keys and Finished values come from their secrets" {
    let allocator = mem::page_allocator();
    let server_hs = try bytes_of_hex(allocator, server_hs_traffic());
    defer server_hs.deinit(allocator);
    let client_hs = try bytes_of_hex(allocator, client_hs_traffic());
    defer client_hs.deinit(allocator);
    let server_ap = try bytes_of_hex(allocator, server_ap_traffic());
    defer server_ap.deinit(allocator);
    let client_ap = try bytes_of_hex(allocator, client_ap_traffic());
    defer client_ap.deinit(allocator);
    let server_hs_bytes = server_hs.as_bytes();
    let client_hs_bytes = client_hs.as_bytes();
    let server_ap_bytes = server_ap.as_bytes();
    let client_ap_bytes = client_ap.as_bytes();
    try expect_traffic_key(allocator, server_hs_bytes, server_hs_key(), server_hs_iv());
    try expect_traffic_key(allocator, client_hs_bytes, client_hs_key(), client_hs_iv());
    try expect_traffic_key(allocator, server_ap_bytes, server_ap_key(), server_ap_iv());
    try expect_traffic_key(allocator, client_ap_bytes, client_ap_key(), client_ap_iv());

    // The server's Finished covers the transcript through CertificateVerify;
    // the client's covers it through the server's Finished.
    let whole = try transcript(allocator, true);
    defer whole.deinit(allocator);
    let whole_bytes = whole.as_bytes();
    let through_verify = whole_bytes[0..mem::len(whole_bytes) - 36];
    var hash = [32]u8{};
    let hash_view = hash.as_mut_bytes();
    tls::transcript_hash(through_verify, hash_view);
    let hash_bytes = hash.as_bytes();
    try expect_finished(allocator, server_hs_bytes, hash_bytes, server_finished_data());
    var whole_hash = [32]u8{};
    let whole_hash_view = whole_hash.as_mut_bytes();
    tls::transcript_hash(whole_bytes, whole_hash_view);
    let whole_hash_bytes = whole_hash.as_bytes();
    try expect_finished(allocator, client_hs_bytes, whole_hash_bytes, client_finished_data());
}

fn expect_opened(
    allocator: Allocator,
    key_hex: []u8,
    iv_hex: []u8,
    sequence: i64,
    record_hex: []u8,
    want_type: u8,
    want_hex: []u8
) -> tls::Failure!void {
    let key = try bytes_of_hex(allocator, key_hex);
    defer key.deinit(allocator);
    let iv = try bytes_of_hex(allocator, iv_hex);
    defer iv.deinit(allocator);
    let record = try bytes_of_hex(allocator, record_hex);
    defer record.deinit(allocator);
    let key_bytes = key.as_bytes();
    let iv_bytes = iv.as_bytes();
    let record_bytes = record.as_bytes();
    var opened = string::new(allocator);
    defer opened.deinit(allocator);
    let content_type = try tls::open_record(allocator, tls::CipherSuite::Aes128GcmSha256,
        key_bytes, iv_bytes, sequence, record_bytes, &var opened);
    testing::expect_equal<u8>(want_type, content_type);
    let opened_bytes = opened.as_bytes();
    try expect_hex(allocator, want_hex, opened_bytes);
    return;
}

fn expect_sealed(
    allocator: Allocator,
    key_hex: []u8,
    iv_hex: []u8,
    sequence: i64,
    content_type: u8,
    content_hex: []u8,
    want_hex: []u8
) -> mem::Error!void {
    let key = try bytes_of_hex(allocator, key_hex);
    defer key.deinit(allocator);
    let iv = try bytes_of_hex(allocator, iv_hex);
    defer iv.deinit(allocator);
    let content = try bytes_of_hex(allocator, content_hex);
    defer content.deinit(allocator);
    let key_bytes = key.as_bytes();
    let iv_bytes = iv.as_bytes();
    let content_bytes = content.as_bytes();
    var sealed = string::new(allocator);
    defer sealed.deinit(allocator);
    try tls::seal_record(allocator, tls::CipherSuite::Aes128GcmSha256,
        key_bytes, iv_bytes, sequence, content_type, content_bytes, &var sealed);
    let sealed_bytes = sealed.as_bytes();
    try expect_hex(allocator, want_hex, sealed_bytes);
    return;
}

test "the RFC 8448 server records open to the messages the RFC lists" {
    let allocator = mem::page_allocator();
    var messages = string::new(allocator);
    defer messages.deinit(allocator);
    try messages.append_bytes(allocator, encrypted_extensions());
    try messages.append_bytes(allocator, certificate());
    try messages.append_bytes(allocator, certificate_verify());
    try messages.append_bytes(allocator, server_finished());
    let messages_hex = messages.as_bytes();
    try expect_opened(allocator, server_hs_key(), server_hs_iv(), 0, server_hs_record(),
        tls::content_handshake(), messages_hex);
    // The server's NewSessionTicket took sequence 0 under these keys.
    try expect_opened(allocator, server_ap_key(), server_ap_iv(), 1, server_app_record(),
        tls::content_application_data(), app_payload());
    try expect_opened(allocator, server_ap_key(), server_ap_iv(), 2, server_alert_record(),
        tls::content_alert(), "0100");
}

test "the RFC 8448 client records seal byte for byte" {
    let allocator = mem::page_allocator();
    var finished = string::new(allocator);
    defer finished.deinit(allocator);
    try finished.append_bytes(allocator, "14000020");
    try finished.append_bytes(allocator, client_finished_data());
    let finished_hex = finished.as_bytes();
    try expect_sealed(allocator, client_hs_key(), client_hs_iv(), 0, tls::content_handshake(),
        finished_hex, client_finished_record());
    try expect_sealed(allocator, client_ap_key(), client_ap_iv(), 0, tls::content_application_data(),
        app_payload(), client_app_record());
    try expect_sealed(allocator, client_ap_key(), client_ap_iv(), 1, tls::content_alert(),
        "0100", client_alert_record());
}

fn expect_bad_record(allocator: Allocator, sequence: i64, record_hex: []u8) -> mem::Error!void {
    let key = try bytes_of_hex(allocator, server_ap_key());
    defer key.deinit(allocator);
    let iv = try bytes_of_hex(allocator, server_ap_iv());
    defer iv.deinit(allocator);
    let record = try bytes_of_hex(allocator, record_hex);
    defer record.deinit(allocator);
    let key_bytes = key.as_bytes();
    let iv_bytes = iv.as_bytes();
    let record_bytes = record.as_bytes();
    var opened = string::new(allocator);
    defer opened.deinit(allocator);
    if tls::open_record(allocator, tls::CipherSuite::Aes128GcmSha256,
        key_bytes, iv_bytes, sequence, record_bytes, &var opened) |_| {
        testing::expect(false);
    } else |err| {
        testing::expect(err == tls::Error::BadRecord);
    }
    testing::expect_equal<i64>(0, opened.len());
    return;
}

test "a record under the wrong sequence, with a changed byte, or with another header is refused" {
    let allocator = mem::page_allocator();
    try expect_bad_record(allocator, 0, server_app_record());
    var changed = string::new(allocator);
    defer changed.deinit(allocator);
    try changed.append_bytes(allocator, server_app_record());
    let bytes = changed.as_mut_bytes();
    bytes[20] = 48;
    let changed_hex = changed.as_bytes();
    try expect_bad_record(allocator, 1, changed_hex);
    // A TLS 1.0 version in the header, and a length that does not match.
    try expect_bad_record(allocator, 1, "17030100432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d");
    try expect_bad_record(allocator, 1, "17030300442e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d");
    try expect_bad_record(allocator, 1, "1703030002");
}

test "a ClientHello carries what the client offers and a ServerHello reads back" {
    let allocator = mem::page_allocator();
    let random = try bytes_of_hex(allocator, "cb34ecb1e78163ba1c38c6dacb196a6dffa21a8d9912ec18a2ef6283024dece7");
    defer random.deinit(allocator);
    let share = try bytes_of_hex(allocator, client_public());
    defer share.deinit(allocator);
    let random_bytes = random.as_bytes();
    let share_bytes = share.as_bytes();
    var hello = string::new(allocator);
    defer hello.deinit(allocator);
    try tls::write_client_hello(allocator, &var hello, random_bytes, random_bytes, "server", share_bytes);
    let bytes = hello.as_bytes();
    // The type, the 24-bit length, the version, the random.
    testing::expect_equal<u8>(1, bytes[0]);
    testing::expect_equal<i64>(mem::len(bytes) - 4, (cast<i64>(bytes[2]) << 8) | cast<i64>(bytes[3]));
    try expect_hex(allocator, "0303", bytes[4..6]);
    testing::expect(mem::equal_bytes(bytes[6..38], random_bytes));
    // The session id, then the suites and the null compression.
    testing::expect_equal<u8>(32, bytes[38]);
    testing::expect(mem::equal_bytes(bytes[39..71], random_bytes));
    try expect_hex(allocator, "000413011303", bytes[71..77]);
    try expect_hex(allocator, "0100", bytes[77..79]);
    // The extensions end with the key share.
    let count = mem::len(bytes);
    testing::expect(mem::equal_bytes(bytes[count - 32..count], share_bytes));
    try expect_hex(allocator, "003300260024001d0020", bytes[count - 42..count - 32]);
    if tls::message_length(bytes) |whole| {
        testing::expect_equal<i64>(count, whole);
    } else {
        testing::expect(false);
    }
    if tls::message_length(bytes[0..count - 1]) |_| {
        testing::expect(false);
    }

    // The RFC 8448 ServerHello answers an empty session id with an empty one.
    let server = try bytes_of_hex(allocator, server_hello());
    defer server.deinit(allocator);
    let server_bytes = server.as_bytes();
    let read = try tls::read_server_hello(server_bytes, "");
    testing::expect(read.suite == tls::CipherSuite::Aes128GcmSha256);
    testing::expect(!read.retry);
    let key_share = server_bytes[read.key_share_start..read.key_share_end];
    try expect_hex(allocator, server_public(), key_share);
    if tls::read_server_hello(server_bytes, random_bytes) |_| {
        testing::expect(false);
    } else |err| {
        testing::expect(err == tls::Error::IllegalParameter);
    }
}

test "the RFC 8448 Certificate, CertificateVerify and Finished read back" {
    let allocator = mem::page_allocator();
    let message = try bytes_of_hex(allocator, certificate());
    defer message.deinit(allocator);
    let message_bytes = message.as_bytes();
    var chain = array::new<string::String>(allocator);
    defer chain.deinit(allocator);
    try tls::read_certificate(allocator, message_bytes, &var chain);
    testing::expect_equal<i64>(1, chain.len());
    if chain.at(0) |der| {
        testing::expect_equal<i64>(432, der.len());
    }
    let verify = try bytes_of_hex(allocator, certificate_verify());
    defer verify.deinit(allocator);
    let verify_bytes = verify.as_bytes();
    let read = try tls::read_certificate_verify(verify_bytes);
    testing::expect_equal<i64>(0x0804, read.scheme);
    testing::expect_equal<i64>(128, read.signature_end - read.signature_start);
    let finished = try bytes_of_hex(allocator, server_finished());
    defer finished.deinit(allocator);
    let finished_bytes = finished.as_bytes();
    let verify_data = try tls::read_finished(finished_bytes);
    try expect_hex(allocator, server_finished_data(), verify_data);
}
