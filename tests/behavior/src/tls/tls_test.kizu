import std::array;
import std::crypto;
import std::mem;
import std::string;
import std::testing;
import std::tls;

// RFC 8448 §3 is one complete TLS 1.3 handshake with every secret, key,
// and record written down. The key schedule here is held to those
// secrets, from the key exchange to the application traffic keys, and
// the record layer to those records: what the RFC's server sealed opens
// to the messages it lists, and what its client sent is sealed byte for
// byte.

fn bytes_of_hex(allocator: Allocator, hex: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var at = 0;
    while at + 1 < mem::len(hex) {
        let high = hex_value(hex[at]);
        let low = hex_value(hex[at + 1]);
        try out.append_byte(allocator, cast<u8>(high * 16 + low));
        at = at + 2;
    }
    return move out;
}

fn hex_value(byte: u8) -> i64 {
    let value = cast<i64>(byte);
    if value >= 97 {
        return value - 87;
    }
    return value - 48;
}

fn hex_of(allocator: Allocator, bytes: []u8) -> mem::Error!string::String {
    let digits = "0123456789abcdef";
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    for 0..mem::len(bytes) |index| {
        let value = cast<i64>(bytes[index]);
        try out.append_byte(allocator, digits[value >> 4]);
        try out.append_byte(allocator, digits[value & 15]);
    }
    return move out;
}

fn expect_hex(allocator: Allocator, want: []u8, bytes: []u8) -> mem::Error!void {
    let hex = try hex_of(allocator, bytes);
    defer hex.deinit(allocator);
    let got = hex.as_bytes();
    testing::expect_equal<[]u8>(want, got);
    return;
}

