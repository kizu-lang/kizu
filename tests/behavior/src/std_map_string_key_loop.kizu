import std::map;
import std::mem;
import std::string;
import std::testing;

test "std map string key loop" {
    let allocator = mem::page_allocator();
    var symbols = map::Map<[]u8, i64>(allocator);
    var index = 0;
    while index < 2 {
        if index >= 0 {
            var key_builder = string::String(allocator);
            try key_builder.append_bytes("symbol");
            let key = key_builder.as_bytes();
            try symbols.insert(key, index);
            key_builder.deinit();
        }
        index = index + 1;
    }
    testing::expect(symbols.contains("symbol"));
    symbols.deinit();
}
