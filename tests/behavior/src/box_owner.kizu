import std::mem;
import std::string;
import std::testing;

pub struct Score {
    pub value: i64,
}

// A boxed copyable payload reads back through a shared borrow and hands the
// cell back with shallow deinit.
test "box holds one owned value behind an allocator" {
    let allocator = mem::page_allocator();
    let boxed = try mem::box<Score>(allocator, Score { value: 41 });
    let seen = boxed.borrow();
    testing::expect_equal<i64>(41, seen.value);
    boxed.deinit();
}

// borrow_mut writes land in the cell: a later shared borrow observes them.
test "box borrow_mut writes through to the payload" {
    let allocator = mem::page_allocator();
    var boxed = try mem::box<Score>(allocator, Score { value: 1 });
    let cell = boxed.borrow_mut();
    cell.value = cell.value + 41;
    let seen = boxed.borrow();
    testing::expect_equal<i64>(42, seen.value);
    boxed.deinit();
}

fn make_name(allocator: Allocator, text: []u8) -> !string::String {
    var name = string::new(allocator);
    errdefer name.deinit();
    try name.append_bytes(text);
    return name;
}

// An owner payload is closed the same way an owner-element container is:
// deinit_all takes the payload out, consumes it, then releases the cell
// (ADR-0091).
test "box deinit_all consumes an owner payload" {
    let allocator = mem::page_allocator();
    let boxed = try mem::box<string::String>(allocator, try make_name(allocator, "alice"));
    let held = boxed.borrow();
    testing::expect_equal<i64>(5, held.len());
    boxed.deinit_all();
}

// A fixed-buffer allocator serves Box like every other container, and the
// cleanup registered with defer runs through the same lowering.
test "fixed buffer allocator backs box" {
    var buf = [256]u8{};
    let scratch = buf.as_mut_bytes();
    let alloc = mem::fixed_buffer(scratch);
    let boxed = try mem::box<Score>(alloc, Score { value: 7 });
    defer boxed.deinit();
    let seen = boxed.borrow();
    testing::expect_equal<i64>(7, seen.value);
}
