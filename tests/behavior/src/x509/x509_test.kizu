// p256_pkcs8_pem is p256_pkcs8 as a PEM file.
fn p256_pkcs8_pem() -> []u8 {
    return
        \\-----BEGIN PRIVATE KEY-----
        \\MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgya+p2EW6dRZrXCFX
        \\Z7HWk05Qw9s26JsSe4piKxIPZyGhRANCAARg/tS6JVqdMclh63TGNW1owEm4kjth
        \\+mzmaWIuYPKftnkD/hAIuLyZpBrp6VYovGTy8bIMLX6fUXejwpTURiKZ
        \\-----END PRIVATE KEY-----
    ;
}

fn bytes_of_hex_lines(allocator: Allocator, hex: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var high = -1;
    for 0..mem::len(hex) |index| {
        let value = hex_value(hex[index]);
        if value < 0 or hex[index] == 10 {
            continue;
        }
        if high < 0 {
            high = value;
        } else {
            try out.append_byte(allocator, cast<u8>(high * 16 + value));
            high = -1;
        }
    }
    return move out;
}

fn parsed_algorithm(allocator: Allocator, hex: []u8) -> x509::Failure!x509::KeyAlgorithm {
    let der = try bytes_of_hex_lines(allocator, hex);
    defer der.deinit(allocator);
    let bytes = der.as_bytes();
    let key = try x509::parse_private_key(bytes);
    let algorithm = key.algorithm;
    return algorithm;
}

test "a private key of each shape is read and named" {
    let allocator = mem::page_allocator();
    let p256 = try parsed_algorithm(allocator, p256_pkcs8());
    testing::expect(p256 == x509::KeyAlgorithm::EcdsaP256);
    let p384 = try parsed_algorithm(allocator, p384_sec1());
    testing::expect(p384 == x509::KeyAlgorithm::EcdsaP384);
    let rsa1 = try parsed_algorithm(allocator, rsa_pkcs1());
    testing::expect(rsa1 == x509::KeyAlgorithm::Rsa);
    let rsa8 = try parsed_algorithm(allocator, rsa_pkcs8());
    testing::expect(rsa8 == x509::KeyAlgorithm::Rsa);
}

test "a key that is cut short, or not a key, is malformed" {
    let allocator = mem::page_allocator();
    let der = try bytes_of_hex_lines(allocator, p256_pkcs8());
    defer der.deinit(allocator);
    let bytes = der.as_bytes();
    let count = mem::len(bytes);
    let cut = bytes[0..count - 5];
    let cut_result = private_key_failure(cut);
    testing::expect_equal<[]u8>("malformed", cut_result);
    let empty_result = private_key_failure("");
    testing::expect_equal<[]u8>("malformed", empty_result);
    let certificate = try bytes_of_hex(allocator, leaf_hex());
    defer certificate.deinit(allocator);
    let certificate_bytes = certificate.as_bytes();
    let certificate_result = private_key_failure(certificate_bytes);
    testing::expect_equal<[]u8>("malformed", certificate_result);
}

fn private_key_failure(der: []u8) -> []u8 {
    if x509::parse_private_key(der) |key| {
        let _ = key.algorithm;
        return "parsed";
    } else |err| {
        return match err {
            Malformed => "malformed",
            Unsupported => "unsupported",
            _ => "other",
        };
    }
}

test "the EC scalar and the RSA parts are the bytes the key file holds" {
    let allocator = mem::page_allocator();
    let der = try bytes_of_hex_lines(allocator, p256_pkcs8());
    defer der.deinit(allocator);
    let bytes = der.as_bytes();
    let key = try x509::parse_private_key(bytes);
    let scalar = key.scalar();
    let want = try bytes_of_hex(allocator, "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721");
    defer want.deinit(allocator);
    let want_bytes = want.as_bytes();
    testing::expect(mem::equal_bytes(scalar, want_bytes));
    let rsa_der = try bytes_of_hex_lines(allocator, rsa_pkcs1());
    defer rsa_der.deinit(allocator);
    let rsa_bytes = rsa_der.as_bytes();
    let rsa = try x509::parse_private_key(rsa_bytes);
    let parts = rsa.rsa_key();
    testing::expect(mem::len(parts.modulus) == 257);
    testing::expect(mem::len(parts.public_exponent) == 3);
    testing::expect(mem::len(parts.prime1) >= 128 and mem::len(parts.prime1) <= 129);
    testing::expect(mem::len(parts.coefficient) >= 1);
}

fn signs_and_verifies(allocator: Allocator, key_hex: []u8, public_hex: []u8, hash: crypto::Hash, message: []u8) -> x509::Failure!bool {
    let der = try bytes_of_hex_lines(allocator, key_hex);
    defer der.deinit(allocator);
    let public = try bytes_of_hex_lines(allocator, public_hex);
    defer public.deinit(allocator);
    let bytes = der.as_bytes();
    let key = try x509::parse_private_key(bytes);
    var digest = [64]u8{};
    let view = digest.as_mut_bytes();
    crypto::digest_of(hash, message, view);
    let digest_view = view[0..crypto::digest_length(hash)];
    var salt = [64]u8{};
    let salt_view = salt.as_mut_bytes();
    crypto::digest_of(hash, "salt", salt_view);
    let salt_bytes = salt_view[0..crypto::digest_length(hash)];
    let signature = try x509::sign(allocator, &key, hash, digest_view, salt_bytes);
    defer signature.deinit(allocator);
    let made = signature.as_bytes();
    let public_bytes = public.as_bytes();
    if key.algorithm == x509::KeyAlgorithm::Rsa {
        return x509::rsa_pss_signature_verifies(hash, public_bytes, digest_view, made);
    }
    return x509::ecdsa_signature_verifies(public_bytes, digest_view, made);
}

test "a signature made from a key file verifies under the matching public key" {
    let allocator = mem::page_allocator();
    let p256_public = "0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299";
    let p384_public =
        \\04ec3a4e415b4e19a4568618029f427fa5da9a8bc4ae92e02e06aae5286b300c64def8f0ea9055866064a254515480bc13
        \\8015d9b72d7d57244ea8ef9ac0c621896708a59367f9dfb9f54ca84b3f1c9db1288b231c3ae0d4fe7344fd2533264720
    ;
    testing::expect(try signs_and_verifies(allocator, p256_pkcs8(), p256_public, crypto::Hash::Sha256, "sample"));
    testing::expect(try signs_and_verifies(allocator, p384_sec1(), p384_public, crypto::Hash::Sha384, "sample"));
    testing::expect(try signs_and_verifies(allocator, rsa_pkcs1(), rsa_public(), crypto::Hash::Sha256, "sample"));
    testing::expect(try signs_and_verifies(allocator, rsa_pkcs8(), rsa_public(), crypto::Hash::Sha512, "sample"));
}

test "the DER of an ECDSA signature is the RFC 6979 numbers as INTEGERs" {
    let allocator = mem::page_allocator();
    let der = try bytes_of_hex_lines(allocator, p256_pkcs8());
    defer der.deinit(allocator);
    let bytes = der.as_bytes();
    let key = try x509::parse_private_key(bytes);
    var digest = [32]u8{};
    let view = digest.as_mut_bytes();
    crypto::sha256("sample", view);
    let hash = digest.as_bytes();
    let signature = try x509::sign(allocator, &key, crypto::Hash::Sha256, hash, "");
    defer signature.deinit(allocator);
    // r and s both have their top bit set, so each INTEGER is 33 bytes.
    let want = try bytes_of_hex_lines(allocator,
        \\3046022100efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716
        \\022100f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8
    );
    defer want.deinit(allocator);
    let made = signature.as_bytes();
    let want_bytes = want.as_bytes();
    testing::expect(mem::equal_bytes(made, want_bytes));
}

test "a digest of the wrong length for the curve is unsupported" {
    let allocator = mem::page_allocator();
    let der = try bytes_of_hex_lines(allocator, p256_pkcs8());
    defer der.deinit(allocator);
    let bytes = der.as_bytes();
    let key = try x509::parse_private_key(bytes);
    var digest = [48]u8{};
    let view = digest.as_mut_bytes();
    crypto::sha384("sample", view);
    let hash = digest.as_bytes();
    if x509::sign(allocator, &key, crypto::Hash::Sha384, hash, "") |made| {
        made.deinit(allocator);
        testing::expect(false);
    } else |err| {
        testing::expect(err == x509::Error::Unsupported);
    }
}

test "a PEM block decodes to the DER it wraps" {
    let allocator = mem::page_allocator();
    let decoded = try x509::decode_pem(allocator, p256_pkcs8_pem(), "PRIVATE KEY");
    defer decoded.deinit(allocator);
    let want = try bytes_of_hex_lines(allocator, p256_pkcs8());
    defer want.deinit(allocator);
    let got = decoded.as_bytes();
    let want_bytes = want.as_bytes();
    testing::expect(mem::equal_bytes(got, want_bytes));
    let any = try x509::decode_pem(allocator, p256_pkcs8_pem(), "");
    defer any.deinit(allocator);
    let any_bytes = any.as_bytes();
    testing::expect(mem::equal_bytes(any_bytes, want_bytes));
    if x509::decode_pem(allocator, p256_pkcs8_pem(), "CERTIFICATE") |other| {
        other.deinit(allocator);
        testing::expect(false);
    } else |err| {
        testing::expect(err == x509::Error::Malformed);
    }
}

test "PEM blocks are found one after another and a broken body is malformed" {
    let allocator = mem::page_allocator();
    let text =
        \\some text before
        \\-----BEGIN CERTIFICATE-----
        \\AQID
        \\-----END CERTIFICATE-----
        \\-----BEGIN CERTIFICATE-----
        \\BAUGBw==
        \\-----END CERTIFICATE-----
        \\-----BEGIN CERTIFICATE-----
        \\AQ=
        \\-----END CERTIFICATE-----
    ;
    var count = 0;
    var from = 0;
    while x509::next_pem_block(text, from) |block| {
        count = count + 1;
        let label = block.label(text);
        testing::expect(mem::equal_bytes(label, "CERTIFICATE"));
        if count == 1 {
            let first = try x509::decode_pem_block(allocator, text, &block);
            defer first.deinit(allocator);
            let first_bytes = first.as_bytes();
            testing::expect(mem::len(first_bytes) == 3 and first_bytes[0] == 1 and first_bytes[2] == 3);
        }
        if count == 2 {
            let second = try x509::decode_pem_block(allocator, text, &block);
            defer second.deinit(allocator);
            let second_bytes = second.as_bytes();
            testing::expect(mem::len(second_bytes) == 4 and second_bytes[3] == 7);
        }
        if count == 3 {
            if x509::decode_pem_block(allocator, text, &block) |third| {
                third.deinit(allocator);
                testing::expect(false);
            } else |err| {
                testing::expect(err == x509::Error::Malformed);
            }
        }
        from = block.next;
    }
    testing::expect(count == 3);
    if x509::next_pem_block("no block here", 0) |stray| {
        let _ = stray;
        testing::expect(false);
    }
}
