import std::array;
import std::mem;
import std::testing;

// Field is also the spelling of a builtin static-parameter token. The local
// declaration wins in type position because top-level names precede builtins.
pub struct Field {
    pub index: i64
}

pub struct Holder {
    pub fields: array::Array<Field>
}

test "current module type names precede builtins" {
    let allocator = mem::page_allocator();
    var fields = array::new<Field>(allocator);
    errdefer fields.deinit(allocator);
    try fields.append(Field { index: 7 });
    var holder = Holder { fields: move fields };
    defer holder.deinit(allocator);
    if holder.fields.at(0) |field| {
        testing::expect_equal<i64>(7, field.index);
    } else {
        testing::fail("stored field is missing");
    }
}
