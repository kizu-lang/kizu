import std::testing;

fn rotate_left(value: u64, count: u64) -> u64 {
    return value << count | value >> (64 - count);
}

fn shift_left(value: i64, amount: i64) -> i64 {
    return value << amount;
}

test "bitwise operators on i64" {
    testing::expect_equal<i64>(8, 0b1100 & 0x0A);
    testing::expect_equal<i64>(14, 0b1100 | 0x0A);
    testing::expect_equal<i64>(6, 0b1100 ^ 0x0A);
    testing::expect_equal<i64>(-13, ~12);
    testing::expect_equal<i64>(1_000, 1_000);
}

test "bitwise binds between comparison and arithmetic" {
    testing::expect(1 | 2 == 3);
    testing::expect(6 & 3 + 1 == 4);
    testing::expect_equal<i64>(7, 1 | 2 | 4);
    testing::expect_equal<i64>(1032, 1 << 10 | 1 << 3);
}

test "shift follows the width rule" {
    testing::expect_equal<i64>(1024, 1 << 10);
    testing::expect_equal<i64>(-4, -16 >> 2);
    testing::expect_equal<i64>(0, 1 << 64);
    testing::expect_equal<i64>(-1, -1 >> 64);
    testing::expect_equal<i64>(0, shift_left(1, 200));
    testing::expect_equal<i64>(-1, (1 << 64) - 1);
    let byte = cast<u8>(0xF0);
    testing::expect(byte >> 4 == 15);
    testing::expect(byte << 4 == 0);
    testing::expect(byte >> 8 == 0);
    let word = cast<u64>(1) << 63;
    testing::expect(word >> 63 == 1);
    testing::expect(rotate_left(word, 1) == 1);
    testing::expect(rotate_left(word, 0) == word);
}

test "literals take the other operand's integer type" {
    let flags = cast<u8>(0xAB);
    testing::expect(flags & 0x0F == 11);
    testing::expect(0x0F & flags == 11);
    testing::expect(flags + 100 == 15);
    testing::expect(flags == 171);
}

test "unsigned division reads the sign of the type" {
    let top = cast<u64>(1) << 63;
    testing::expect(top / 2 == cast<u64>(1) << 62);
    testing::expect(top % 3 == 2);
    testing::expect(top > 0);
}
