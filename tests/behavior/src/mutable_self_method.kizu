import std::mem;
import std::testing;

struct Counter {
    pub count: i64,
}

fn (self: &var Counter) bump() -> void {
    self.count = self.count + 1;
    return;
}

fn (self: &var Counter) bump_twice() -> void {
    self.bump();
    self.bump();
    return;
}

// A `&var self` method mutates the caller's binding in place, including when
// one mutating method calls another through its own borrowed receiver.
test "mutable self method writes through the receiver" {
    var hits = Counter { count: 0 };
    hits.bump_twice();
    hits.bump();
    testing::expect_equal<i64>(3, hits.count);
}

struct Selector {
    pub cursor: i64,
    pub selected: i64,
}

fn (self: &Selector) peek() -> i64 {
    return self.cursor * 10;
}

fn (self: &var Selector) select(index: i64) -> void {
    self.selected = index;
    self.cursor = self.cursor + 1;
}

fn (self: &var Selector) advance() -> void {
    self.select(self.cursor);
}

// A `&var self` call may read its own receiver in argument position: the
// exclusive borrow is two-phase and activates after the arguments settle, so
// a state machine can feed its own state to its own transition.
test "mutable self call reads its receiver in argument position" {
    var sel = Selector { cursor: 3, selected: 0 };
    sel.advance();
    testing::expect_equal<i64>(3, sel.selected);
    testing::expect_equal<i64>(4, sel.cursor);
    sel.select(sel.peek());
    testing::expect_equal<i64>(40, sel.selected);
    testing::expect_equal<i64>(5, sel.cursor);
}

struct BytesIter {
    pub bytes: []u8,
    pub index: i64,
}

fn iter(bytes: []u8) -> BytesIter {
    return BytesIter { bytes: bytes, index: 0 };
}

fn (self: BytesIter) has_next() -> bool {
    return self.index < mem::len(self.bytes);
}

fn (self: &var BytesIter) next() -> u8 {
    let byte = self.bytes[self.index];
    self.index = self.index + 1;
    return byte;
}

// A cursor struct advancing itself is the shape an iterator takes; over
// static bytes it needs no tie.
test "mutable self methods drive a byte cursor" {
    var it = iter("kizu");
    var total = 0;
    while it.has_next() {
        total = total + cast<i64>(it.next());
    }
    testing::expect_equal<i64>(451, total);
}
