import std::process;
import std::testing;

// SPEC §15: `std::process::unix_millis()` は Unix epoch からの壁時計
// milliseconds を `i64` で返す。値そのものは実行時刻なので、ここでは
// 「epoch millis として妥当な範囲にある」ことだけを約束する。

test "unix_millis reads the wall clock as epoch milliseconds" {
    let now = process::unix_millis();
    // 2024-01-01T00:00:00Z より後、2100-01-01T00:00:00Z より前。
    testing::expect(now > 1704067200000);
    testing::expect(now < 4102444800000);
}
