import std::map;
import std::mem;
import std::string;
import std::testing;

test "std map remove keeps order and hands the value back" {
    let allocator = mem::page_allocator();
    var counts = map::new<[]u8, i64>(allocator);
    defer counts.deinit(allocator);
    try counts.insert(allocator, "a", 1);
    try counts.insert(allocator, "b", 2);
    try counts.insert(allocator, "c", 3);
    if counts.remove(allocator, "b") |value| {
        testing::expect_equal<i64>(2, value);
    } else {
        testing::fail("b is missing");
    }
    if counts.remove(allocator, "b") |_| {
        testing::fail("b was removed twice");
    }
    testing::expect_equal<i64>(2, counts.len());
    testing::expect_equal<bool>(false, counts.contains("b"));
    if counts.key_at(1) |key| {
        testing::expect_equal<[]u8>("c", key);
    } else {
        testing::fail("c lost its place");
    }
    try counts.insert(allocator, "b", 20);
    if counts.key_at(2) |key| {
        testing::expect_equal<[]u8>("b", key);
    } else {
        testing::fail("b did not come back last");
    }
}

test "std map remove moves an owner value out" {
    let allocator = mem::page_allocator();
    var names = map::new<i64, string::String>(allocator);
    defer names.deinit(allocator);
    try names.insert(allocator, 7, try string::from_bytes(allocator, "seven"));
    try names.insert(allocator, 8, try string::from_bytes(allocator, "eight"));
    if names.remove(allocator, 7) |taken| {
        let text = taken.as_bytes();
        testing::expect_equal<[]u8>("seven", text);
        taken.deinit(allocator);
    } else {
        testing::fail("seven is missing");
    }
    testing::expect_equal<i64>(1, names.len());
    if names.at(8) |name| {
        let text = name.as_bytes();
        testing::expect_equal<[]u8>("eight", text);
    } else {
        testing::fail("eight is missing");
    }
}
