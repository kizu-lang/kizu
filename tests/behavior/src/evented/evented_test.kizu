import std::fmt;
import std::io;
import std::mem;
import std::net;
import std::string;
import std::testing;

// What an evented Io promises, as the caller sees it. The worker is an
// ordinary function taking an ordinary Io: whether it can stop in the middle
// of a read is the Io's business, not its own.
//
// That two of them interleave at their waits is what `examples/io_evented.kizu`
// shows, by printing from inside. What is asserted here is the contract around
// them: a blocking Io runs the work where it is offered, an evented one runs
// it on the loop, and a cancel reaches a worker that is standing in a wait.

error Failure = io::Error or net::Error or mem::Error;

struct Counter {
    seen: i64,
}

fn bump(handle: Io, allocator: Allocator, job: &var Counter) -> void {
    job.seen = job.seen + 1;
    return;
}

struct Waiter {
    conn: net::TcpStream,
    got: string::String,
    read: i64,
    stopped: bool,
}

struct OwnedSender {
    conn: net::TcpStream,
}

fn (self: OwnedSender) deinit() -> void {
    self.conn.deinit();
    return;
}

fn (self: Waiter) deinit(allocator: Allocator) -> void {
    self.got.deinit(allocator);
    self.conn.deinit();
    return;
}

// A worker answers void: there is no caller standing under it to `try` into,
// so what it wants to report it writes into the state it was lent.
fn drink(handle: Io, allocator: Allocator, job: &var Waiter) -> void {
    // A failure here is what a cancelled wait looks like from inside: the
    // worker has no caller to `try` into, so it records it and returns.
    let got = job.conn.read_into(handle, allocator, &var job.got, 64) catch -1;
    if got < 0 {
        job.stopped = true;
        return;
    }
    job.read = got;
    return;
}

fn send_owned(handle: Io, allocator: Allocator, job: OwnedSender) -> void {
    var held = move job;
    defer held.deinit();
    held.conn.write_all(handle, "owned") catch return;
    return;
}

fn can_start_counter(handle: Io, allocator: Allocator) -> bool {
    var job = Counter { seen: 0 };
    var future = io::async<Counter>(
        handle, allocator, bump, &var job) catch return false;
    future.deinit(allocator);
    return true;
}

test "a future takes its storage from the named allocator" {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    var storage = [1024]u8{};
    let scratch = storage.as_mut_bytes();
    let limited = mem::fixed_buffer(scratch);

    // A worker stack cannot fit. Success here would mean async silently used
    // the process allocator instead of the allocator at its call site.
    testing::expect(!can_start_counter(handle, limited));
}

test "a blocking Io runs the work where it is offered" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var job = Counter { seen: 0 };
    var future = try io::async<Counter>(handle, allocator, bump, &var job);
    // Nothing has been awaited and the work is already done: with nothing to
    // run it beside, offering it is running it.
    testing::expect(future.finished());
    future.deinit(allocator);
    testing::expect_equal<i64>(1, job.seen);
}

test "an evented Io runs the work on the loop" {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();
    var job = Counter { seen: 0 };
    var future = try io::async<Counter>(handle, allocator, bump, &var job);
    // The loop has not run, so neither has the worker.
    testing::expect(!future.finished());
    future.await();
    testing::expect(future.finished());
    future.deinit(allocator);
    testing::expect_equal<i64>(1, job.seen);
}

test "a worker parked in a read is resumed when the bytes arrive" {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();

    var door = try net::tcp_listen(handle, "127.0.0.1:0");
    defer door.deinit();
    var address = try loopback(allocator, try door.local_port());
    defer address.deinit(allocator);
    var near = try dial(handle, &address);
    defer near.deinit();
    var far = try door.accept(handle);
    errdefer far.deinit();

    var job = Waiter {
        conn: move far,
        got: string::new(allocator),
        read: 0,
        stopped: false,
    };
    defer job.deinit(allocator);
    var future = try io::async<Waiter>(handle, allocator, drink, &var job);
    errdefer future.deinit(allocator);

    // One thread means the send has to be first; that two workers take turns
    // at their waits is what the example shows. What is asserted here is that
    // a read reached through the loop reads what a blocking one would.
    try near.write_all(handle, "hello");
    future.await();

    testing::expect(future.finished());
    future.deinit(allocator);
    testing::expect_equal<i64>(5, job.read);
    testing::expect_equal<i64>(5, job.got.len());
    testing::expect(!job.stopped);
}

test "a task set owns each worker state" {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();

    var door = try net::tcp_listen(handle, "127.0.0.1:0");
    defer door.deinit();
    var address = try loopback(allocator, try door.local_port());
    defer address.deinit(allocator);
    var near = try dial(handle, &address);
    errdefer near.deinit();
    var far = try door.accept(handle);
    errdefer far.deinit();

    var waiting = Waiter {
        conn: move near,
        got: string::new(allocator),
        read: 0,
        stopped: false,
    };
    defer waiting.deinit(allocator);
    var future = try io::async<Waiter>(
        handle, allocator, drink, &var waiting);
    errdefer future.deinit(allocator);

    var tasks = try io::task_set_new(handle, allocator);
    defer tasks.deinit(allocator);
    let sender = OwnedSender { conn: move far };
    errdefer sender.deinit();
    try io::spawn<OwnedSender>(
        &var tasks,
        send_owned,
        move sender
    );

    future.await();
    future.deinit(allocator);
    testing::expect_equal<i64>(5, waiting.read);
    testing::expect_equal<i64>(5, waiting.got.len());
    testing::expect(!waiting.stopped);
}

test "cancel stops a parked worker and lets it unwind" {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();

    var door = try net::tcp_listen(handle, "127.0.0.1:0");
    defer door.deinit();
    var address = try loopback(allocator, try door.local_port());
    defer address.deinit(allocator);
    var near = try dial(handle, &address);
    defer near.deinit();
    var far = try door.accept(handle);
    errdefer far.deinit();

    var job = Waiter {
        conn: move far,
        got: string::new(allocator),
        read: 0,
        stopped: false,
    };
    defer job.deinit(allocator);
    var future = try io::async<Waiter>(handle, allocator, drink, &var job);

    // Nobody sends anything, so the read parks. The cancel arrives there as a
    // failure, and the worker returns through the path it already wrote.
    future.cancel();
    testing::expect(future.finished());
    future.deinit(allocator);
    testing::expect(job.stopped);
    testing::expect_equal<i64>(0, job.read);
}

test "a parked read still runs out of its deadline" {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();

    var door = try net::tcp_listen(handle, "127.0.0.1:0");
    defer door.deinit();
    var address = try loopback(allocator, try door.local_port());
    defer address.deinit(allocator);
    var near = try dial(handle, &address);
    defer near.deinit();
    var far = try door.accept(handle);
    errdefer far.deinit();
    far.set_read_deadline(net::deadline_in_millis(50));

    var job = Waiter {
        conn: move far,
        got: string::new(allocator),
        read: 0,
        stopped: false,
    };
    defer job.deinit(allocator);
    var future = try io::async<Waiter>(handle, allocator, drink, &var job);

    // The deadline is the caller's, and it is the same deadline either way:
    // the loop is what waits now, so the loop is what stops waiting.
    future.await();
    testing::expect(future.finished());
    future.deinit(allocator);
    testing::expect(job.stopped);
}

// A worker that awaits another worker turns the loop from inside its own
// stack. The loop must skip whatever it is standing on: resuming that would
// overwrite the way back out and jump into a context already running.
struct Nest {
    outer: i64,
    inner: Inner,
}

struct Inner {
    ran: i64,
}

fn count_inner(handle: Io, allocator: Allocator, job: &var Inner) -> void {
    job.ran = job.ran + 1;
    return;
}

fn count_outer(handle: Io, allocator: Allocator, job: &var Nest) -> void {
    job.outer = job.outer + 1;
    var started = io::async<Inner>(
        handle, allocator, count_inner, &var job.inner) catch return;
    started.await();
    started.deinit(allocator);
    return;
}

test "a worker can start a worker and wait for it" {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();

    var job = Nest { outer: 0, inner: Inner { ran: 0 } };
    var future = try io::async<Nest>(handle, allocator, count_outer, &var job);
    future.await();
    future.deinit(allocator);
    testing::expect_equal<i64>(1, job.outer);
    testing::expect_equal<i64>(1, job.inner.ran);
}

fn loopback(allocator: Allocator, port: i64) -> Failure!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    try out.append_bytes(allocator, "127.0.0.1:");
    try fmt::append_i64(allocator, &var out, port);
    return move out;
}

fn dial(handle: Io, address: &string::String) -> Failure!net::TcpStream {
    let bytes = address.as_bytes();
    let stream = try net::tcp_connect(handle, bytes);
    return move stream;
}
