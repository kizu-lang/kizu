import std::array;
import std::crypto;
import std::crypto::x509;
import std::mem;
import std::string;
import std::testing;

// Certificates and key files another implementation wrote, so that
// std::crypto::x509 is held to what it wrote and not only to what Kizu
// writes.
//
// The chains were issued with LibreSSL 3.3.6's `openssl ca`: a root, an
// intermediate under it, and a leaf for example.net and *.example.net under
// that. The root and the intermediate are valid from 2025-01-01 and the leaf
// from 2026-01-01, all to 2035-01-01. In the P-384 chain the root and the
// intermediate have P-384 keys and sign with ECDSA-SHA384; in the RSA chain
// the root has a 2048-bit key and the intermediate a 3072-bit one, the root
// signing with SHA384WithRSA and the intermediate with SHA512WithRSA. Every
// leaf has a P-256 key. `openssl verify` accepts each leaf under its root.
// The other root is an unrelated P-256 one.
//
// The key files are OpenSSL 3.0.14's writer (node's crypto) in PKCS #8,
// SEC 1 or PKCS #1, and PKCS #8 PEM, of keys whose signatures are
// published: RFC 6979's P-256 and P-384 keys (A.2.5, A.2.6), signing the
// SHA-256 and SHA-384 of "sample", and the 3072-bit key of NIST CAVP's
// SigGenPSS_186-3.txt (p and q recovered from its n, e and d), signing
// NIST's first message under each hash with NIST's salt. An ECDSA signature
// is RFC 6979's r and s as DER INTEGERs, the way a CertificateVerify holds
// them.

fn bytes_of_hex_lines(allocator: Allocator, hex: []u8) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    var high = -1;
    for 0..mem::len(hex) |index| {
        let byte = cast<i64>(hex[index]);
        var value = -1;
        if byte >= 48 and byte <= 57 {
            value = byte - 48;
        } else if byte >= 97 and byte <= 102 {
            value = byte - 87;
        }
        if value < 0 {
            continue;
        }
        if high < 0 {
            high = value;
        } else {
            try out.append_byte(allocator, cast<u8>(high * 16 + value));
            high = -1;
        }
    }
    return move out;
}

// jan_2030 is 2030-01-01T00:00:00Z, within every certificate's validity.
fn jan_2030() -> i64 {
    return 1893456000;
}

// jul_2025 is 2025-07-01T00:00:00Z, before the leaves are valid.
fn jul_2025() -> i64 {
    return 1751328000;
}

fn error_name(err: x509::Error) -> []u8 {
    return match err {
        Malformed => "Malformed",
        Unsupported => "Unsupported",
        Expired => "Expired",
        NameMismatch => "NameMismatch",
        BadSignature => "BadSignature",
        UnknownIssuer => "UnknownIssuer",
    };
}

fn expect_chain(
    allocator: Allocator,
    leaf_hex: []u8,
    intermediate_hex: []u8,
    root_hex: []u8,
    host: []u8,
    now: i64,
    want: []u8
) -> mem::Error!void {
    var chain = array::new<string::String>(allocator);
    defer chain.deinit(allocator);
    try chain.append(allocator, try bytes_of_hex_lines(allocator, leaf_hex));
    try chain.append(allocator, try bytes_of_hex_lines(allocator, intermediate_hex));
    var roots = array::new<string::String>(allocator);
    defer roots.deinit(allocator);
    try roots.append(allocator, try bytes_of_hex_lines(allocator, root_hex));
    if x509::verify_chain(&chain, &roots, host, now) {
        testing::expect_equal<[]u8>(want, "ok");
    } else |err| {
        testing::expect_equal<[]u8>(want, error_name(err));
    }
    return;
}

// decode_pem_body puts the BEGIN and END lines of a PRIVATE KEY block
// around base64 lines and decodes the block. The lines are put on here
// rather than written out so that this file holds no private key block for
// a secret scanner to stop on: the keys are RFC 6979's and NIST's published
// test keys.
fn decode_pem_body(allocator: Allocator, body: []u8) -> x509::Failure!string::String {
    var text = string::new(allocator);
    defer text.deinit(allocator);
    // A Kizu literal carries no escapes, so the line breaks go in as bytes.
    try text.append_bytes(allocator, "-----BEGIN ");
    try text.append_bytes(allocator, "PRIVATE KEY-----");
    try text.append_byte(allocator, 10);
    try text.append_bytes(allocator, body);
    try text.append_byte(allocator, 10);
    try text.append_bytes(allocator, "-----END ");
    try text.append_bytes(allocator, "PRIVATE KEY-----");
    try text.append_byte(allocator, 10);
    let bytes = text.as_bytes();
    let der = try x509::decode_pem(allocator, bytes, "PRIVATE KEY");
    return move der;
}

// signs reads a key file -- DER, or the base64 of a PEM block when `pem`
// is set -- signs the digest of the message under `hash` with the salt, and
// reports whether the signature is `want`.
fn signs(
    allocator: Allocator,
    key_text: []u8,
    pem: bool,
    hash: crypto::Hash,
    message_hex: []u8,
    salt_hex: []u8,
    want_hex: []u8
) -> x509::Failure!bool {
    let der = if pem {
        try decode_pem_body(allocator, key_text)
    } else {
        try bytes_of_hex_lines(allocator, key_text)
    };
    defer der.deinit(allocator);
    let message = try bytes_of_hex_lines(allocator, message_hex);
    defer message.deinit(allocator);
    let salt = try bytes_of_hex_lines(allocator, salt_hex);
    defer salt.deinit(allocator);
    let want = try bytes_of_hex_lines(allocator, want_hex);
    defer want.deinit(allocator);
    let der_bytes = der.as_bytes();
    let key = try x509::parse_private_key(der_bytes);
    var digest = [64]u8{};
    let view = digest.as_mut_bytes();
    let message_bytes = message.as_bytes();
    crypto::digest_of(hash, message_bytes, view);
    let digest_view = view[0..crypto::digest_length(hash)];
    let salt_bytes = salt.as_bytes();
    let signature = try x509::sign(allocator, &key, hash, digest_view, salt_bytes);
    defer signature.deinit(allocator);
    let made = signature.as_bytes();
    let want_bytes = want.as_bytes();
    return mem::equal_bytes(made, want_bytes);
}

test "OpenSSL's P-384 and RSA chains verify, and fail for the reasons they fail" {
    let allocator = mem::page_allocator();
    try expect_chain(allocator, p384_leaf(), p384_inter(), p384_root(), "example.net", jan_2030(), "ok");
    try expect_chain(allocator, p384_leaf(), p384_inter(), p384_root(), "api.example.net", jan_2030(), "ok");
    try expect_chain(allocator, p384_leaf(), p384_inter(), p384_root(), "a.b.example.net", jan_2030(), "NameMismatch");
    try expect_chain(allocator, p384_leaf(), p384_inter(), p384_root(), "example.net", jul_2025(), "Expired");
    try expect_chain(allocator, p384_leaf(), p384_inter(), other_root(), "example.net", jan_2030(), "UnknownIssuer");
    try expect_chain(allocator, rsa_leaf(), rsa_inter(), rsa_root(), "example.net", jan_2030(), "ok");
    try expect_chain(allocator, rsa_leaf(), rsa_inter(), rsa_root(), "api.example.net", jan_2030(), "ok");
    try expect_chain(allocator, rsa_leaf(), rsa_inter(), rsa_root(), "a.b.example.net", jan_2030(), "NameMismatch");
    try expect_chain(allocator, rsa_leaf(), rsa_inter(), rsa_root(), "example.net", jul_2025(), "Expired");
    try expect_chain(allocator, rsa_leaf(), rsa_inter(), other_root(), "example.net", jan_2030(), "UnknownIssuer");
}

test "key files OpenSSL wrote sign to the published signatures" {
    let allocator = mem::page_allocator();
    testing::expect(try signs(allocator, p256_pkcs8(), false, crypto::Hash::Sha256, "73616d706c65", "", p256_signature()));
    testing::expect(try signs(allocator, p256_bare(), false, crypto::Hash::Sha256, "73616d706c65", "", p256_signature()));
    testing::expect(try signs(allocator, p256_pem(), true, crypto::Hash::Sha256, "73616d706c65", "", p256_signature()));
    testing::expect(try signs(allocator, p384_pkcs8(), false, crypto::Hash::Sha384, "73616d706c65", "", p384_signature()));
    testing::expect(try signs(allocator, p384_bare(), false, crypto::Hash::Sha384, "73616d706c65", "", p384_signature()));
    testing::expect(try signs(allocator, p384_pem(), true, crypto::Hash::Sha384, "73616d706c65", "", p384_signature()));
    testing::expect(try signs(allocator, rsa_pkcs8(), false, crypto::Hash::Sha256, nist_sha256_msg(), nist_sha256_salt(), nist_sha256_sig()));
    testing::expect(try signs(allocator, rsa_bare(), false, crypto::Hash::Sha256, nist_sha256_msg(), nist_sha256_salt(), nist_sha256_sig()));
    testing::expect(try signs(allocator, rsa_pem(), true, crypto::Hash::Sha256, nist_sha256_msg(), nist_sha256_salt(), nist_sha256_sig()));
    testing::expect(try signs(allocator, rsa_pkcs8(), false, crypto::Hash::Sha384, nist_sha384_msg(), nist_sha384_salt(), nist_sha384_sig()));
}

