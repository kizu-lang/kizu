import std::mem;
import std::testing;

extern "c" fn malloc(size: usize) -> ?ptr<u8>
extern "c" fn free(address: ?ptr<u8>) -> void
struct Pair {
    small: u8,
    large: i64,
}

extern "c" struct Options {
    cols: u16,
    rows: u16,
    max: usize,
}

test "size_of gives the bytes a value takes on the target" {
    testing::expect_equal<usize>(1, mem::size_of<u8>());
    testing::expect_equal<usize>(4, mem::size_of<i32>());
    testing::expect_equal<usize>(16, mem::size_of<Pair>());
    testing::expect_equal<usize>(16, mem::size_of<Options>());
    testing::expect_equal<usize>(8, mem::size_of<ptr<u8>>());
}

test "size_of sizes a C allocation for one value" {
    // SAFETY: malloc returns storage of the size asked for, or null.
    let storage = unsafe malloc(mem::size_of<Pair>()) orelse return;
    // SAFETY: storage holds size_of<Pair> bytes, one Pair.
    let pair = unsafe cast<ptr<Pair>>(storage);
    // SAFETY: pair is fresh storage for one Pair.
    unsafe ptr_write(pair, Pair { small: 3, large: 40 });
    // SAFETY: pair holds the Pair written above.
    let read = unsafe ptr_read(pair);
    testing::expect_equal<i64>(43, cast<i64>(read.small) + read.large);
    // SAFETY: storage came from malloc and nothing reads it after this.
    unsafe free(storage);
}
