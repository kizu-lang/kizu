import std::testing;

fn countdown(n: i64, total: i64) -> i64 {
    if n == 0 {
        return total;
    }
    return countdown(n - 1, total + n);
}

fn sum(n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    return n + sum(n - 1);
}

fn factorial(n: u64) -> u64 {
    if n < 2 {
        return 1;
    }
    return factorial(n - 1) * n;
}

fn doubled(acc: i64, n: i64) -> i64 {
    if n == 0 {
        return acc;
    }
    return 2 * doubled(acc + 1, n - 1);
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

test "a call in tail position returns what the recursion would" {
    testing::expect_equal<i64>(55, countdown(10, 0));
}

test "a call whose result is combined before it returns reads each level's own values" {
    testing::expect_equal<i64>(55, sum(10));
    testing::expect(factorial(10) == 3628800);
    testing::expect_equal<i64>(32, doubled(1, 3));
    testing::expect_equal<i64>(6765, fib(20));
}
