import std::testing;

// An element write gives an array local storage of its own. Assigning the
// whole array inside a loop stores into that storage, so every turn after the
// first reads the array the previous turn assigned.
test "a for loop reassigns an array an element write gave storage" {
    var xs = [3]i64{};
    xs[0] = 7;
    var total: i64 = 0;
    for 0..2 |_| {
        total = total + xs[0];
        xs = [3]i64{ 1, 1, 1 };
    }
    testing::expect_equal<i64>(8, total);
    testing::expect_equal<i64>(1, xs[0]);
}

// A `while` reaches its header without a latch, and holds to the same rule.
test "a while loop reassigns an array an element write gave storage" {
    var xs = [3]i64{};
    xs[2] = 5;
    var turn: i64 = 0;
    var total: i64 = 0;
    while turn < 3 {
        total = total + xs[2];
        xs = [3]i64{ 0, 0, turn };
        turn = turn + 1;
    }
    testing::expect_equal<i64>(6, total);
    testing::expect_equal<i64>(2, xs[2]);
}
