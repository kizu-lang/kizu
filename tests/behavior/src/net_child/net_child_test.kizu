import std::io;
import std::mem;
import std::net;
import std::process;
import std::string;
import std::testing;

// docs/std/net.md 子プロセス: a Child's status is its exit code or 128 plus
// the signal, a program that cannot start exits 127, an argument the host's
// argv cannot carry is InvalidLength, a stream that was not piped is Closed,
// try_wait does not wait, and `env` / `set_dir` change only what the child
// starts with. The children are `sh`, so these run where the
// pipes do; Windows spawns nothing (OperationFailed) and is skipped.

error Failure = net::Error or mem::Error;

fn shell(allocator: Allocator, script: []u8) -> Failure!net::Command {
    var command = try net::command(allocator, "sh");
    errdefer command.deinit(allocator);
    try command.arg(allocator, "-c");
    try command.arg(allocator, script);
    return move command;
}

test "try_wait answers null while the child runs and the status after" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try shell(allocator, "cat > /dev/null; exit 4");
    defer command.deinit(allocator);
    command.set_stdin(net::Stdio::Pipe);
    var child = try command.spawn(handle);
    defer child.deinit();
    // The child is blocked reading a pipe this process has not closed.
    let early = try child.try_wait(handle) orelse -1;
    testing::expect_equal<i64>(-1, early);
    child.close_stdin();
    let status = try child.wait(handle);
    testing::expect_equal<i64>(4, status);
    let again = try child.try_wait(handle) orelse -1;
    testing::expect_equal<i64>(4, again);
}

test "kill ends the child and wait reports the signal" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try shell(allocator, "cat > /dev/null");
    defer command.deinit(allocator);
    command.set_stdin(net::Stdio::Pipe);
    var child = try command.spawn(handle);
    defer child.deinit();
    try child.kill(handle);
    let status = try child.wait(handle);
    testing::expect_equal<i64>(128 + 9, status);
}

test "a program that cannot start exits 127" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try net::command(allocator, "kizu-no-such-program");
    defer command.deinit(allocator);
    var child = try command.spawn(handle);
    defer child.deinit();
    let status = try child.wait(handle);
    testing::expect_equal<i64>(127, status);
}

test "an empty program or an argument with a NUL is InvalidLength" {
    let allocator = mem::page_allocator();
    if net::command(allocator, "") |command| {
        command.deinit(allocator);
        testing::fail("an empty program was accepted");
    } else |failed| {
        testing::expect(failed == net::Error::InvalidLength);
    }
    var command = try net::command(allocator, "sh");
    defer command.deinit(allocator);
    var bytes = [3]u8{};
    bytes[0] = cast<u8>(97);
    bytes[2] = cast<u8>(98);
    let view = bytes.as_bytes();
    if command.arg(allocator, view) {
        testing::fail("an argument with a NUL was accepted");
    } else |failed| {
        testing::expect(failed == net::Error::InvalidLength);
    }
}

// stdout reads what a child prints to its end.
fn stdout_of(handle: Io, allocator: Allocator, command: &net::Command) -> Failure!string::String {
    var child = try command.spawn(handle);
    defer child.deinit();
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    while try child.read_stdout_into(handle, allocator, &var out, 64) > 0 {}
    let status = try child.wait(handle);
    testing::expect_equal<i64>(0, status);
    return move out;
}

test "env lays bindings over the inherited environment and the last one wins" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try shell(
        allocator,
        \\printf '%s|%s|%s' "$KIZU_CHILD_A" "$KIZU_CHILD_B" "$HOME"
    );
    defer command.deinit(allocator);
    command.set_stdout(net::Stdio::Pipe);
    try command.env(allocator, "KIZU_CHILD_A", "first");
    try command.env(allocator, "KIZU_CHILD_B", "b=c");
    try command.env(allocator, "KIZU_CHILD_A", "second");
    try command.env(allocator, "HOME", "/kizu-home");
    let out = try stdout_of(handle, allocator, &command);
    defer out.deinit(allocator);
    let said = out.as_bytes();
    testing::expect(mem::equal_bytes(said, "second|b=c|/kizu-home"));
}

test "the environment a child does not override is inherited" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    // PATH is inherited, or `sh` would not find `printf` -- and it is printed
    // to say it arrived unchanged.
    var command = try shell(
        allocator,
        \\printf '%s' "$PATH"
    );
    defer command.deinit(allocator);
    command.set_stdout(net::Stdio::Pipe);
    try command.env(allocator, "KIZU_CHILD_A", "set");
    let out = try stdout_of(handle, allocator, &command);
    defer out.deinit(allocator);
    let said = out.as_bytes();
    let path = process::env("PATH") orelse "";
    testing::expect(mem::equal_bytes(said, path));
}

test "set_dir starts the child in the directory and a missing one exits 127" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try shell(allocator, "pwd -P | tr -d '[:space:]'");
    defer command.deinit(allocator);
    command.set_stdout(net::Stdio::Pipe);
    try command.set_dir(allocator, "/");
    let out = try stdout_of(handle, allocator, &command);
    defer out.deinit(allocator);
    let said = out.as_bytes();
    testing::expect(mem::equal_bytes(said, "/"));

    var missing = try shell(allocator, "exit 0");
    defer missing.deinit(allocator);
    try missing.set_dir(allocator, "/kizu-no-such-directory");
    var child = try missing.spawn(handle);
    defer child.deinit();
    let status = try child.wait(handle);
    testing::expect_equal<i64>(127, status);
}

test "a binding or directory the host cannot carry is InvalidLength" {
    let allocator = mem::page_allocator();
    var command = try net::command(allocator, "sh");
    defer command.deinit(allocator);
    var bytes = [3]u8{};
    bytes[0] = cast<u8>(97);
    bytes[2] = cast<u8>(98);
    let nul = bytes.as_bytes();
    expect_invalid(command.env(allocator, "", "x"));
    expect_invalid(command.env(allocator, "A=B", "x"));
    expect_invalid(command.env(allocator, nul, "x"));
    expect_invalid(command.env(allocator, "A", nul));
    expect_invalid(command.set_dir(allocator, ""));
    expect_invalid(command.set_dir(allocator, nul));
}

fn expect_invalid(result: net::Error!void) -> void {
    if result {
        testing::fail("a value the host cannot carry was accepted");
    } else |failed| {
        testing::expect(failed == net::Error::InvalidLength);
    }
}

test "a stream that was not piped is Closed" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try shell(allocator, "exit 0");
    defer command.deinit(allocator);
    command.set_stdout(net::Stdio::Null);
    var child = try command.spawn(handle);
    defer child.deinit();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    if child.read_stdout_ready(handle, allocator, &var out, 64) |_| {
        testing::fail("a stream that was not piped was read");
    } else |failed| {
        testing::expect(failed == net::Error::Closed);
    }
    let status = try child.wait(handle);
    testing::expect_equal<i64>(0, status);
}

test "standard error is read on its own pipe" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try shell(allocator, "printf out; printf err 1>&2; exit 5");
    defer command.deinit(allocator);
    command.set_stdout(net::Stdio::Null);
    command.set_stderr(net::Stdio::Pipe);
    var child = try command.spawn(handle);
    defer child.deinit();
    var poller = try net::poller_new(handle, 2);
    defer poller.deinit();
    try poller.watch_child_stderr(handle, &child, 0);
    var err = string::new(allocator);
    defer err.deinit(allocator);
    var open = true;
    while open {
        let count = try poller.wait(handle, net::deadline_in_millis(5000));
        testing::expect(count > 0);
        if try child.read_stderr_ready(handle, allocator, &var err, 64) |got| {
            if got == 0 {
                child.close_stderr();
                open = false;
            }
        }
    }
    let said = err.as_bytes();
    testing::expect(mem::equal_bytes(said, "err"));
    let status = try child.wait(handle);
    testing::expect_equal<i64>(5, status);
}

test "deinit reaps a child that was never waited for" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try shell(allocator, "cat > /dev/null");
    defer command.deinit(allocator);
    command.set_stdin(net::Stdio::Pipe);
    let child = try command.spawn(handle);
    // Without the kill in deinit this would wait on a child that is still
    // waiting on its input.
    child.deinit();
}

test "read_stdout_into reads to the end and write_stdin_all waits on a full pipe" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    let handle = io::blocking();
    var command = try shell(allocator, "wc -c");
    defer command.deinit(allocator);
    command.set_stdin(net::Stdio::Pipe);
    command.set_stdout(net::Stdio::Pipe);
    var child = try command.spawn(handle);
    defer child.deinit();
    // More than a pipe holds, so the write has to wait for the child to read.
    var payload = string::new(allocator);
    defer payload.deinit(allocator);
    var filled = 0;
    while filled < 200000 {
        try payload.append_byte(allocator, cast<u8>(120));
        filled = filled + 1;
    }
    let bytes = payload.as_bytes();
    try child.write_stdin_all(handle, bytes);
    child.close_stdin();
    var out = string::new(allocator);
    defer out.deinit(allocator);
    while try child.read_stdout_into(handle, allocator, &var out, 64) > 0 {}
    let text = out.as_bytes();
    let count = trim(text);
    testing::expect(mem::equal_bytes(count, "200000"));
    let status = try child.wait(handle);
    testing::expect_equal<i64>(0, status);
}

struct Slow {
    child: net::Child,
    got: string::String,
}

fn (self: Slow) deinit(allocator: Allocator) -> void {
    self.got.deinit(allocator);
    self.child.deinit();
    return;
}

fn read_all(handle: Io, allocator: Allocator, job: &var Slow) -> void {
    while true {
        let got = job.child.read_stdout_into(handle, allocator, &var job.got, 64) catch return;
        if got == 0 {
            return;
        }
    }
    return;
}

// On an evented Io a read waiting on a child parks only its worker: the
// caller starts a second child and reads it to the end while the first worker
// is still waiting.
test "read_stdout_into parks its worker on an evented Io" {
    comptime if std::target::is_windows() {
        return;
    }
    let allocator = mem::page_allocator();
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);

    var slow_command = try shell(allocator, "sleep 0.5; echo slow");
    defer slow_command.deinit(allocator);
    slow_command.set_stdout(net::Stdio::Pipe);
    let slow_child = try slow_command.spawn(handle);
    var slow = Slow { child: move slow_child, got: string::new(allocator) };
    defer slow.deinit(allocator);

    var fast_command = try shell(allocator, "echo fast");
    defer fast_command.deinit(allocator);
    fast_command.set_stdout(net::Stdio::Pipe);
    var fast_got = string::new(allocator);
    defer fast_got.deinit(allocator);

    var running = try io::async<Slow>(handle, allocator, read_all, &var slow);
    errdefer running.deinit(allocator);
    var fast = try fast_command.spawn(handle);
    defer fast.deinit();
    while try fast.read_stdout_into(handle, allocator, &var fast_got, 64) > 0 {}
    testing::expect(!running.finished());
    running.await();
    running.deinit(allocator);

    let fast_text = fast_got.as_bytes();
    let fast_line = trim(fast_text);
    testing::expect(mem::equal_bytes(fast_line, "fast"));
    let slow_text = slow.got.as_bytes();
    let slow_line = trim(slow_text);
    testing::expect(mem::equal_bytes(slow_line, "slow"));
}

// trim drops the spaces `wc` pads with and the newline that ends a line.
fn trim(bytes: []u8) -> []u8 {
    var start = 0;
    var end = mem::len(bytes);
    while start < end and (bytes[start] == cast<u8>(32) or bytes[start] == cast<u8>(10)) {
        start = start + 1;
    }
    while end > start and (bytes[end - 1] == cast<u8>(32) or bytes[end - 1] == cast<u8>(10)) {
        end = end - 1;
    }
    return bytes[start..end];
}
