import std::mem;
import std::string;
import std::testing;

test "compare orders bytes by the first one they differ in" {
    testing::expect_equal<i64>(0, mem::compare("alice", "alice"));
    testing::expect_equal<i64>(-1, mem::compare("alice", "bob"));
    testing::expect_equal<i64>(1, mem::compare("bob", "alice"));
    testing::expect_equal<i64>(-1, mem::compare("visit7", "visit9"));
}

test "compare puts a prefix before what it starts" {
    testing::expect_equal<i64>(-1, mem::compare("user", "users"));
    testing::expect_equal<i64>(1, mem::compare("users", "user"));
    testing::expect_equal<i64>(-1, mem::compare("", "a"));
    testing::expect_equal<i64>(1, mem::compare("a", ""));
    testing::expect_equal<i64>(0, mem::compare("", ""));
}

test "compare reads bytes as unsigned" {
    let allocator = mem::page_allocator();
    var high = string::new(allocator);
    defer high.deinit(allocator);
    try high.append_byte(allocator, 200);
    var low = string::new(allocator);
    defer low.deinit(allocator);
    try low.append_byte(allocator, 100);
    let high_bytes = high.as_bytes();
    let low_bytes = low.as_bytes();
    testing::expect_equal<i64>(1, mem::compare(high_bytes, low_bytes));
    testing::expect_equal<i64>(-1, mem::compare(low_bytes, high_bytes));
}

test "equal_bytes agrees with compare" {
    testing::expect_equal<bool>(true, mem::equal_bytes("alice", "alice"));
    testing::expect_equal<bool>(false, mem::equal_bytes("alice", "alicf"));
    testing::expect_equal<bool>(false, mem::equal_bytes("alice", "alic"));
    testing::expect_equal<bool>(true, mem::equal_bytes("", ""));
}

// test
// features: std-mem compare equal-bytes lexical prefix unsigned
