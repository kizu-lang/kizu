// Methods named like the ones method_lend_scope calls, taking `&var` where
// those take a shared borrow: the receiver of `poke`, the argument of `note`.
// They are declared in a module of their own because that is how the names
// meet in a real program, and nothing here has to be renamed for it.

pub struct Counter {
    pub n: i64,
}

pub fn (self: &var Counter) poke(n: i64) -> i64 {
    self.n = self.n + n;
    return self.n;
}

pub fn (self: &Counter) note(total: &var i64) -> void {
    total.* = total.* + self.n;
}
