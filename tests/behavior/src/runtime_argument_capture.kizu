import std::fmt;
import std::mem;
import std::string;
import std::testing;

struct User {
    name: []u8
}

fn (self: &User) append_display(out: &var string::String) -> !void {
    return fmt::append(out, "User(", self.name, ")");
}

impl fmt::Display for User;

struct Counter {
    value: i64
}

fn (self: &var Counter) bump() -> void {
    self.value = self.value + 1;
    return;
}

fn bump_captured(parts: ...) -> void {
    comptime for parts |T, part| {
        part.bump();
    }
    return;
}

fn bump_borrowed(first: &var Counter, second: &var Counter) -> void {
    bump_captured(first, second);
    return;
}

fn cleanup_all(parts: ...) -> !void {
    comptime for parts |T, part| {
        errdefer part.deinit();
        part.deinit();
    }
    return;
}

fn number(value: i64) -> !i64 {
    return value;
}

fn sum_fallible(parts: ...) -> !i64 {
    var total = 0;
    comptime for parts |T, part| {
        total = total + try part;
    }
    return total;
}

fn expect_seven(parts: ...) -> void {
    comptime for parts |T, part| {
        testing::expect_equal<i64>(7, part);
    }
    return;
}

fn shadow_capture(parts: ...) -> void {
    comptime for parts |T, part| {
        if true {
            let part = 7;
            expect_seven(part);
        }
    }
    return;
}

test "fmt displays builtins and a borrowed user type" {
    let allocator = mem::page_allocator();
    let user = User { name: "Aki" };
    let count = 3;
    let ready = true;
    let built = try fmt::format(
        allocator,
        "user=", &user,
        ", count=", &count,
        ", ready=", &ready
    );
    defer built.deinit();
    let bytes = built.as_bytes();
    testing::expect_equal<[]u8>("user=User(Aki), count=3, ready=true", bytes);
    let empty = try fmt::format(allocator);
    defer empty.deinit();
    let empty_bytes = empty.as_bytes();
    testing::expect_equal<[]u8>("", empty_bytes);
}

test "captured mutable borrows remain caller storage" {
    var first = Counter { value: 1 };
    var second = Counter { value: 4 };
    bump_borrowed(&var first, &var second);
    testing::expect_equal<i64>(2, first.value);
    testing::expect_equal<i64>(5, second.value);
    shadow_capture(&var first);
}

test "fallible capture gives every owner an explicit cleanup name" {
    let allocator = mem::page_allocator();
    let first = try string::from_bytes(allocator, "first");
    errdefer first.deinit();
    let second = try string::from_bytes(allocator, "second");
    errdefer second.deinit();
    try cleanup_all(move first, move second);
}

test "error union values use the same capture path as fixed parameters" {
    testing::expect_equal<i64>(7, try sum_fallible(number(3), number(4)));
}
