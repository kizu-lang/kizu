import std::map;
import std::mem;
import std::string;
import std::testing;

enum BindingKind {
    Function,
    Local,
    TypeName,
}

fn declare(
    symbols: &var map::Map<[]u8, BindingKind>,
    name: []u8,
    kind: BindingKind
) -> !void {
    try symbols.insert(name, kind);
    return;
}

fn resolve(
    symbols: &map::Map<[]u8, BindingKind>,
    name: []u8
) -> !BindingKind {
    return symbols.get(name);
}

test "std map resolver scope" {
    let allocator = mem::page_allocator();
    var symbols = map::new<[]u8, BindingKind>(allocator);
    var owned_name = string::new(allocator);

    try owned_name.append_bytes("node");
    let node_name = owned_name.as_bytes();
    try symbols.insert(node_name, BindingKind::Local);
    owned_name.deinit();

    try declare(symbols, "parse_expr", BindingKind::Function);

    testing::expect_equal<i64>(2, symbols.len());
    testing::expect(symbols.contains("node"));
    testing::expect(!symbols.contains("missing"));

    let local = try resolve(symbols, "node");
    testing::expect(local == BindingKind::Local);

    let function = try resolve(symbols, "parse_expr");
    testing::expect(function == BindingKind::Function);

    symbols.deinit();
}
