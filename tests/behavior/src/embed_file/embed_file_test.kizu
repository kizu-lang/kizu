import std::mem;
import std::testing;

// The path is relative to tests/behavior/kizu.toml, not to this file.
fn sample() -> []u8 {
    return @embed_file("src/embed_file/sample.txt");
}

test "an embedded file is its bytes as the file holds them" {
    let text = sample();
    // No escape is read and the final newline is kept: `a "b" \c` and `\n`.
    testing::expect_equal<i64>(9, mem::len(text));
    testing::expect(mem::equal_bytes(text[0..2], "a "));
    testing::expect_equal<i64>(34, cast<i64>(text[2]));
    testing::expect_equal<i64>(92, cast<i64>(text[6]));
    testing::expect_equal<i64>(10, cast<i64>(text[8]));
}

test "an embedded file is a constant like a string literal" {
    let first = sample();
    let second = @embed_file("src/embed_file/sample.txt");
    testing::expect(mem::equal_bytes(first, second));
    testing::expect(mem::equal_bytes(first[0..1], "a"));
}
