import std::testing;

fn same_value<T>(value: T) -> T {
    return value;
}

fn is_i64<T>(value: T) -> bool {
    comptime if T == type<i64> {
        return true;
    } else {
        return false;
    }
}

test "minimal generics" {
    testing::expect_equal<i64>(7, same_value<i64>(7));
    testing::expect_equal<[]u8>("kizu", same_value<[]u8>("kizu"));
    testing::expect(is_i64<i64>(1));
    testing::expect_equal<bool>(false, is_i64<bool>(false));
}

// An instance and a plain function may share every character but the
// separator between the generic's name and its argument. They are two
// functions, and every backend has to keep them apart.
fn same_value_i64(value: i64) -> i64 {
    return value + 1;
}

test "a generic instance does not collide with a plain function" {
    testing::expect_equal<i64>(7, same_value<i64>(7));
    testing::expect_equal<i64>(8, same_value_i64(7));
}
