    try wire.append_bytes(allocator, "Content-Length: 5");
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "Transfer-Encoding: chunked");
    try crlf(allocator, &var wire);
    try crlf(allocator, &var wire);
    let raw = wire.as_bytes();
    try client.write_all(handle, raw);

    if refused(handle, allocator, &var server, 1048576) {
        testing::fail("a request with two framings was accepted");
    } else |err| {
        testing::expect(true);
    }

    var reply = string::new(allocator);
    defer reply.deinit(allocator);
    try drain(handle, allocator, &var client, &var reply);
