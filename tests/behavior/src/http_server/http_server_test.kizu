test "a coding this server does not speak is still refused" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    var wire = string::new(allocator);
    defer wire.deinit(allocator);
    try wire.append_bytes(allocator, "POST /upload HTTP/1.1");
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "Transfer-Encoding: gzip, chunked");
    try crlf(allocator, &var wire);
    try crlf(allocator, &var wire);
    let raw = wire.as_bytes();
    try client.write_all(handle, raw);

    if server.accept_head(handle, allocator) |exchange| {
        exchange.deinit(allocator);
        testing::fail("an unknown coding list was accepted");
    } else |err| {
        testing::expect(true);
    }
}

test "a caller that took the body owns its deadline" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    // The head promises a hundred bytes and four arrive.
    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    var wire = string::new(allocator);
    defer wire.deinit(allocator);
    try wire.append_bytes(allocator, "POST /upload HTTP/1.1");
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "Content-Length: 100");
    try crlf(allocator, &var wire);
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "four");
    let raw = wire.as_bytes();
    try client.write_all(handle, raw);

    var held = try server.accept_head(handle, allocator);
    defer held.deinit(allocator);
    held.set_read_deadline(net::deadline_in_millis(50));
    var out = string::new(allocator);
    defer out.deinit(allocator);
    // The four buffered bytes come out without touching the socket.
    let first = try held.read_into(handle, allocator, &var out, 4096);
    testing::expect_equal<i64>(4, first);
    // The rest never arrives, and the deadline is not handed back per call.
    if held.read_into(handle, allocator, &var out, 4096) |_| {
        testing::fail("a read of the missing body returned");
    } else |err| {
        testing::expect(true);
    }
}

test "writing past a declared length is refused before it reaches the peer" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /stream HTTP/1.1", "");

    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    try held.respond_head(handle, allocator, http::Framing::Length(6));
    try held.write_all(handle, allocator, "abc");
    testing::expect_equal<i64>(3, held.owes());
    if held.write_all(handle, allocator, "much longer than three") {
        testing::fail("a body past its declared length was written");
    } else |err| {
        testing::expect(true);
    }
    // The refusal happened before the socket, so what is owed is untouched and
    // the caller can still write the rest correctly.
    testing::expect_equal<i64>(3, held.owes());
    try held.write_all(handle, allocator, "def");
    testing::expect_equal<i64>(0, held.owes());
}

test "a body that stops short is visible to the caller" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /stream HTTP/1.1", "");

    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    try held.respond_head(handle, allocator, http::Framing::Length(10));
    try held.write_all(handle, allocator, "short");
    // Nothing can refuse this one: a body that is never finished only becomes
    // wrong at the close, and a deinit has nowhere to report it. The count is
    // what a caller checks instead.
    testing::expect_equal<i64>(5, held.owes());
}

test "framings without a length count nothing" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /events HTTP/1.1", "");

    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    try held.respond_head(handle, allocator, http::Framing::UntilClose);
    testing::expect_equal<i64>(0, held.owes());
    try held.write_all(handle, allocator, "as much as it likes, there is no number");
    testing::expect_equal<i64>(0, held.owes());
}

fn serve_chunked(
    handle: Io,
    allocator: Allocator,
    server: &var http::Server
) -> Failure!void {
    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    try held.response.header(allocator, "Content-Type", "text/plain");
    try held.respond_head(handle, allocator, http::Framing::Chunked);
    try held.write_all(handle, allocator, "hello");
    // A zero-length write is dropped: a zero-length chunk is the terminator.
    try held.write_all(handle, allocator, "");
    try held.write_all(handle, allocator, " there, chunked");
    try held.finish_body(handle, allocator);
    return;
}

test "a chunked body sizes each write and ends with a terminator" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /chunked HTTP/1.1", "");
    try serve_chunked(handle, allocator, &var server);

    var reply = string::new(allocator);
    defer reply.deinit(allocator);
    try drain(handle, allocator, &var client, &var reply);
    let wire = reply.as_bytes();
    testing::expect(contains(wire, "Transfer-Encoding: chunked"));
    testing::expect(!contains(wire, "Content-Length"));
    // 5 = "hello", F = " there, chunked", 0 = the terminator.
    testing::expect(contains(wire, "5"));
    testing::expect(contains(wire, "hello"));
    testing::expect(contains(wire, "F"));
    testing::expect(contains(wire, " there, chunked"));
}

test "a declared length that was not written is refused at finish" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /short HTTP/1.1", "");

    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    try held.respond_head(handle, allocator, http::Framing::Length(10));
    try held.write_all(handle, allocator, "short");
    if held.finish_body(handle, allocator) {
        testing::fail("a body five bytes short was finished");
    } else |err| {
        testing::expect(true);
    }
    // Finishing is still open: the caller can write what it owes and finish.
    try held.write_all(handle, allocator, "12345");
    try held.finish_body(handle, allocator);
}

test "finishing a body twice is refused" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /chunked HTTP/1.1", "");

    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    try held.respond_head(handle, allocator, http::Framing::Chunked);
    try held.write_all(handle, allocator, "one");
    try held.finish_body(handle, allocator);
    if held.finish_body(handle, allocator) {
        testing::fail("a body was finished twice");
    } else |err| {
        testing::expect(true);
    }
}

// serve_connection answers every request one connection carries, and answers
// how many that was. The loop is the connection's lifetime, written where it
// can be read.
fn serve_connection(
    handle: Io,
    allocator: Allocator,
    server: &var http::Server
) -> Failure!i64 {
    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    var answered = 0;
    var more = true;
    while more {
        var body = string::new(allocator);
        defer body.deinit(allocator);
        try body.append_bytes(allocator, "seen ");
        try fmt::append_i64(allocator, &var body, answered);
        let text = body.as_bytes();
        try held.respond_text(handle, allocator, 200, "text/plain", text);
        answered = answered + 1;
        more = try held.next(handle, allocator, 1048576);
    }
    return answered;
}

test "a connection can carry more than one request when the limits allow it" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var limits = http::default_limits();
    limits.max_requests = 3;
    var server = try http::listen_with(handle, allocator, "127.0.0.1:0", limits);
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    // Three requests written up front. Reading the first head reads all of
    // them, so the second and third come out of what was already in hand.
    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    var index = 0;
    while index < 3 {
        try send_request(handle, allocator, &var client, "GET /again HTTP/1.1", "");
        index = index + 1;
    }

    let answered = try serve_connection(handle, allocator, &var server);
    testing::expect_equal<i64>(3, answered);

    var reply = string::new(allocator);
    defer reply.deinit(allocator);
    try drain(handle, allocator, &var client, &var reply);
    let wire = reply.as_bytes();
    testing::expect(contains(wire, "seen 0"));
    testing::expect(contains(wire, "seen 1"));
    testing::expect(contains(wire, "seen 2"));
    // The last one says the connection is done; the first two do not.
    testing::expect(contains(wire, "Connection: close"));
}

test "the default carries a finite one hundred requests" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    let limits = http::default_limits();
    testing::expect_equal<i64>(100, limits.max_requests);
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    var sent = 0;
    while sent < 100 {
        try send_request(handle, allocator, &var client, "GET /again HTTP/1.1", "");
        sent = sent + 1;
    }

    let answered = try serve_connection(handle, allocator, &var server);
    testing::expect_equal<i64>(100, answered);
}

test "a request that says close ends the connection whatever the limits allow" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var limits = http::default_limits();
    limits.max_requests = 8;
    var server = try http::listen_with(handle, allocator, "127.0.0.1:0", limits);
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    var wire = string::new(allocator);
    defer wire.deinit(allocator);
    try wire.append_bytes(allocator, "GET /once HTTP/1.1");
    try crlf(allocator, &var wire);
    try wire.append_bytes(allocator, "Connection: keep-alive, close");
    try crlf(allocator, &var wire);
    try crlf(allocator, &var wire);
    let raw = wire.as_bytes();
    try client.write_all(handle, raw);

    let answered = try serve_connection(handle, allocator, &var server);
    testing::expect_equal<i64>(1, answered);
}

test "a body framed by the close ends the connection with it" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var limits = http::default_limits();
    limits.max_requests = 8;
    var server = try http::listen_with(handle, allocator, "127.0.0.1:0", limits);
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /events HTTP/1.1", "");

    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    try held.respond_head(handle, allocator, http::Framing::UntilClose);
    try held.write_all(handle, allocator, "no length to find");
    try held.finish_body(handle, allocator);
    // The peer has no way to know where this body ended except the close, so
    // the connection cannot carry another request whatever the limits say.
    testing::expect(!try held.next(handle, allocator, 1048576));
}

test "asking for the next request before answering this one is a failure" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var limits = http::default_limits();
    limits.max_requests = 8;
    var server = try http::listen_with(handle, allocator, "127.0.0.1:0", limits);
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET / HTTP/1.1", "");

    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    if held.next(handle, allocator, 1048576) |_| {
        testing::fail("an unanswered exchange carried on to the next request");
    } else |err| {
        testing::expect(true);
    }
}

// serve_chunked_then_one answers a chunked body and then, on the same
// connection, an ordinary one. It is its own frame so the connection is
// released before anyone reads: the second answer is the last, and the close
// is what tells the client so.
fn serve_chunked_then_one(
    handle: Io,
    allocator: Allocator,
    server: &var http::Server
) -> Failure!void {
    var held = try server.accept(handle, allocator, 1048576);
    defer held.deinit(allocator);
    try held.respond_head(handle, allocator, http::Framing::Chunked);
    try held.write_all(handle, allocator, "first");
    try held.finish_body(handle, allocator);
    // Chunked says where the body ended without ending the connection.
    testing::expect(try held.next(handle, allocator, 1048576));
    try held.respond_text(handle, allocator, 200, "text/plain", "second");
    return;
}

test "a chunked answer keeps the connection" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var limits = http::default_limits();
    limits.max_requests = 4;
    var server = try http::listen_with(handle, allocator, "127.0.0.1:0", limits);
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /a HTTP/1.1", "");
    try send_request(handle, allocator, &var client, "GET /b HTTP/1.1", "");

    try serve_chunked_then_one(handle, allocator, &var server);

    var reply = string::new(allocator);
    defer reply.deinit(allocator);
    try drain(handle, allocator, &var client, &var reply);
    let wire = reply.as_bytes();
    testing::expect(contains(wire, "first"));
    testing::expect(contains(wire, "second"));
}

test "a connection can be taken before its request is complete" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    // A request line and nothing else: the head is not finished.
    try client.write_all(handle, "GET /slow HTTP/1.1");
    try crlf_on(handle, allocator, &var client);

    var held = try take_ready(handle, allocator, &var server);
    defer held.deinit(allocator);

    // Nothing waits: the answer is that there is more to come.
    testing::expect_equal<[]u8>("need more", try state(handle, allocator, &var held));
    testing::expect_equal<[]u8>("need more", try state(handle, allocator, &var held));

    // The blank line finishes it, and the same call says so.
    try crlf_on(handle, allocator, &var client);
    testing::expect_equal<[]u8>("request", try settled(handle, allocator, &var held));
    let target = held.request.target.as_bytes();
    testing::expect_equal<[]u8>("/slow", target);
}

test "a body arriving in pieces is read without waiting" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    var head = string::new(allocator);
    defer head.deinit(allocator);
    try head.append_bytes(allocator, "POST /upload HTTP/1.1");
    try crlf(allocator, &var head);
    try head.append_bytes(allocator, "Content-Length: 10");
    try crlf(allocator, &var head);
    try crlf(allocator, &var head);
    let head_bytes = head.as_bytes();
    try client.write_all(handle, head_bytes);

    var held = try take_ready(handle, allocator, &var server);
    defer held.deinit(allocator);
    // The head is what `advance` reads. It is complete, so the request is.
    testing::expect_equal<[]u8>("request", try settled(handle, allocator, &var held));

    // The body is the caller's to read, and reading it never waits either.
    var body = string::new(allocator);
    defer body.deinit(allocator);
    try client.write_all(handle, "01234");
    try soak(handle, allocator, &var held, &var body, 5);
    let half = body.as_bytes();
    testing::expect_equal<[]u8>("01234", half);
    try client.write_all(handle, "56789");
    try soak(handle, allocator, &var held, &var body, 10);
    let whole = body.as_bytes();
    testing::expect_equal<[]u8>("0123456789", whole);
}

// soak reads what has arrived, without waiting, until the body holds `want`
// bytes. A poller loop would go back to its wait between these calls; this
// spins because the test is both ends of the connection.
fn soak(
    handle: Io,
    allocator: Allocator,
    held: &var http::Exchange,
    out: &var string::String,
    want: i64
) -> Failure!void {
    while out.len() < want {
        let got = try held.read_ready_into(handle, allocator, out, 4096);
        if got |count| {
            if count == 0 {
                return;
            }
        }
    }
    return;
}

test "a peer that goes away before finishing is closed, not a failure" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    errdefer client.deinit();
    try client.write_all(handle, "GET /gone HTTP/1.1");
    try crlf_on(handle, allocator, &var client);

    var held = try take_ready(handle, allocator, &var server);
    defer held.deinit(allocator);
    testing::expect_equal<[]u8>("need more", try state(handle, allocator, &var held));
    client.deinit();
    testing::expect_equal<[]u8>("closed", try settled(handle, allocator, &var held));
}

// take_ready loops accept_ready until the connection this test just opened is
// there. In a server the poller says when; a test can ask again.
test "a connection that says nothing runs out of time and is told so" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var limits = http::default_limits();
    limits.read_head_millis = 30;
    var server = try http::listen_with(handle, allocator, "127.0.0.1:0", limits);
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    // Connects and says nothing. A poller never reports it, so the only way a
    // loop can notice is to look.
    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();

    var held = try take_ready(handle, allocator, &var server);
    errdefer held.deinit(allocator);
    testing::expect(!held.expired(process::monotonic_millis()));
    try idle(handle, 60);
    testing::expect(held.expired(process::monotonic_millis()));

    held.refuse_expired(handle, allocator);
    held.deinit(allocator);

    var reply = string::new(allocator);
    defer reply.deinit(allocator);
    try drain(handle, allocator, &var client, &var reply);
    let answer_bytes = reply.as_bytes();
    testing::expect(contains(answer_bytes, "408"));
}

test "a connection that finished its head has the body's time, not the head's" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var limits = http::default_limits();
    limits.read_head_millis = 30;
    var server = try http::listen_with(handle, allocator, "127.0.0.1:0", limits);
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    try send_request(handle, allocator, &var client, "GET /quick HTTP/1.1", "");

    var held = try take_ready(handle, allocator, &var server);
    defer held.deinit(allocator);
    testing::expect_equal<[]u8>("request", try settled(handle, allocator, &var held));

    // The head's 30 milliseconds are gone; the body's are what applies now.
    try idle(handle, 60);
    testing::expect(!held.expired(process::monotonic_millis()));
}

// idle spends milliseconds without waiting on anything. A poller with nothing
// to watch is the clock a program with no sleep has.
fn idle(handle: Io, millis: i64) -> Failure!void {
    var poller = try net::poller_new(handle, 1);
    defer poller.deinit();
    let _ = try poller.wait(handle, net::deadline_in_millis(millis));
    return;
}

struct ConcurrentServer {
    server: http::Server,
    accepted: i64,
}

struct ReplyWaiter {
    conn: net::TcpStream,
    bytes: string::String,
}

fn (self: ReplyWaiter) deinit(allocator: Allocator) -> void {
    self.bytes.deinit(allocator);
    self.conn.deinit();
    return;
}

fn collect_reply(handle: Io, allocator: Allocator, state: &var ReplyWaiter) -> void {
    drain(handle, allocator, &var state.conn, &var state.bytes) catch return;
    return;
}

fn (self: ConcurrentServer) deinit(allocator: Allocator) -> void {
    self.server.deinit(allocator);
    return;
}

fn serve_owned_exchange(
    handle: Io,
    allocator: Allocator,
    exchange: http::Exchange
) -> void {
    var current = move exchange;
    defer current.deinit(allocator);
    let arrived = current.read_head(handle, allocator) catch return;
    if !arrived {
        return;
    }
    let target = current.request.target.as_bytes();
    let path = http::path_of(target);
    current.respond_text(
        handle, allocator, 200, "text/plain", path) catch return;
    return;
}

fn accept_two_owned(
    handle: Io,
    allocator: Allocator,
    job: &var ConcurrentServer
) -> void {
    var tasks = io::task_set_new(handle, allocator) catch return;
    defer tasks.deinit(allocator);
    while true {
        let exchange = job.server.accept_connection(handle, allocator) catch return;
        io::spawn<http::Exchange>(
            &var tasks,
            serve_owned_exchange,
            move exchange
        ) catch return;
        job.accepted = job.accepted + 1;
    }
    return;
}

test "one quiet connection does not hold the next request behind its head" {
    var loop = try io::loop_new();
    defer loop.deinit();
    let handle = io::evented(&var loop);
    let allocator = mem::page_allocator();

    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    errdefer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var quiet = try net::tcp_connect(handle, address_bytes);
    defer quiet.deinit();
    var loud = try net::tcp_connect(handle, address_bytes);
    errdefer loud.deinit();

    // The first connection has a request line but not the blank line that
    // finishes its head. The second request is complete.
    try quiet.write_all(handle, "GET /quiet HTTP/1.1");
    try crlf_on(handle, allocator, &var quiet);
    try send_request(handle, allocator, &var loud, "GET /loud HTTP/1.1", "");

    var job = ConcurrentServer {
        server: move server,
        accepted: 0,
    };
    defer job.deinit(allocator);
    var accepting = try io::async<ConcurrentServer>(
        handle, allocator, accept_two_owned, &var job);
    errdefer accepting.deinit(allocator);
    var reply = ReplyWaiter {
        conn: move loud,
        bytes: string::new(allocator),
    };
    defer reply.deinit(allocator);
    var reading = try io::async<ReplyWaiter>(
        handle, allocator, collect_reply, &var reply);
    // Waiting for the loud reply drives the accept loop and both owned
    // connection workers. The quiet worker remains parked in read_head.
    reading.await();
    reading.deinit(allocator);
    accepting.cancel();
    accepting.deinit(allocator);
    testing::expect_equal<i64>(2, job.accepted);

    let wire = reply.bytes.as_bytes();
    testing::expect(contains(wire, "HTTP/1.1 200 OK"));
    testing::expect(contains(wire, "/loud"));
}

test "the server holds the connections it is not answering" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var server = try http::listen(handle, allocator, "127.0.0.1:0");
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var quiet = try net::tcp_connect(handle, address_bytes);
    defer quiet.deinit();
    var loud = try net::tcp_connect(handle, address_bytes);
    defer loud.deinit();

    // Only the second one speaks, so it is the one handed out -- the first is
    // held inside the server, costing the loop nothing while it waits.
    try send_request(handle, allocator, &var loud, "GET /loud HTTP/1.1", "");
    var current = try server.first(handle, allocator, 1048576);
    expect_target(&current, "/loud");

    // Now the quiet one speaks. Handing the first back is what lets the server
    // reach it, and it was there all along. The speaking happens in the frame
    // that owns the exchange, because that frame is the one that can clean it
    // up if anything fails.
    var following = try speak_then_hand_back(
        handle, allocator, &var server, &var quiet, "GET /quiet HTTP/1.1",
        move current);
    defer following.deinit(allocator);
    expect_target(&following, "/quiet");
}

test "a connection that may carry another comes back with the next request" {
    let handle = io::blocking();
    let allocator = mem::page_allocator();
    var limits = http::default_limits();
    limits.max_requests = 4;
    var server = try http::listen_with(handle, allocator, "127.0.0.1:0", limits);
    defer server.deinit(allocator);
    let port = try server.local_port();
    var address = try loopback(allocator, port);
    defer address.deinit(allocator);
    let address_bytes = address.as_bytes();

    var client = try net::tcp_connect(handle, address_bytes);
    defer client.deinit();
    // Both requests at once. The second is already in the connection's buffer
    // when the first is answered, so no wait will ever mention it -- the loop
    // has to look at what it is holding, and it does.
    try send_request(handle, allocator, &var client, "GET /one HTTP/1.1", "");
    try send_request(handle, allocator, &var client, "GET /two HTTP/1.1", "");

    var current = try server.first(handle, allocator, 1048576);
    expect_target(&current, "/one");
    var following = try hand_back(handle, allocator, &var server, move current);
    defer following.deinit(allocator);
    expect_target(&following, "/two");
}

// speak_then_hand_back answers, sets another caller talking, and hands the
// connection back -- all inside the frame that owns the exchange.
fn speak_then_hand_back(
    handle: Io,
    allocator: Allocator,
    server: &var http::Server,
    client: &var net::TcpStream,
    line: []u8,
    held: http::Exchange
) -> Failure!http::Exchange {
    var current = move held;
    errdefer current.deinit(allocator);
    try current.respond_text(handle, allocator, 200, "text/plain", "ok");
    try send_request(handle, allocator, client, line, "");
    let following = try server.next(handle, allocator, move current, 1048576);
    return move following;
}

// hand_back answers the exchange it owns and gives it back for the next one.
// It owns it because a slot that is handed back and re-bound cannot carry an
// `errdefer`, so the frame that answers is the frame that holds.
fn hand_back(
    handle: Io,
    allocator: Allocator,
    server: &var http::Server,
    held: http::Exchange
) -> Failure!http::Exchange {
    var current = move held;
    errdefer current.deinit(allocator);
    try current.respond_text(handle, allocator, 200, "text/plain", "ok");
    let following = try server.next(handle, allocator, move current, 1048576);
    return move following;
}

fn expect_target(held: &http::Exchange, want: []u8) -> void {
    let target = held.request.target.as_bytes();
    let path = http::path_of(target);
    testing::expect_equal<[]u8>(want, path);
    return;
}

fn take_ready(
    handle: Io,
    allocator: Allocator,
    server: &var http::Server
) -> Failure!http::Exchange {
    while true {
        if try server.accept_ready(handle, allocator) |held| {
            return move held;
        }
    }
    return http::Error::Incomplete;
}

fn state(
    handle: Io,
    allocator: Allocator,
    held: &var http::Exchange
) -> Failure![]u8 {
    let progress = try held.advance(handle, allocator);
    return match progress {
        NeedMore => "need more",
        Request => "request",
        Closed => "closed",
    };
}

// settled is `state` for the answers that arrive rather than the ones that do
// not. `advance` reads once and reports what it found, so bytes still in
// flight read as "need more" -- which a server hears from its poller and a
// test has to ask for again.
fn settled(
    handle: Io,
    allocator: Allocator,
    held: &var http::Exchange
) -> Failure![]u8 {
    var tries = 0;
    while tries < 10000 {
        let answer = try state(handle, allocator, held);
        if !mem::equal_bytes(answer, "need more") {
            return answer;
        }
        tries = tries + 1;
    }
    return "need more";
}

fn crlf_on(
    handle: Io,
    allocator: Allocator,
    stream: &var net::TcpStream
) -> Failure!void {
    var wire = string::new(allocator);
    defer wire.deinit(allocator);
    try crlf(allocator, &var wire);
    let bytes = wire.as_bytes();
    try stream.write_all(handle, bytes);
    return;
}
