import std::testing;

// A test is named by a string, and a symbol cannot carry most of what a
// string can. These names differ only in what the symbol drops, so they
// lower to distinct functions only because each test's place in declaration
// order is part of its symbol.

test "足し算" {
    testing::expect_equal<i64>(2, 1 + 1);
}

test "引き算" {
    testing::expect_equal<i64>(0, 1 - 1);
}

test "a b" {
    testing::expect_equal<i64>(1, 1 * 1);
}

test "a-b" {
    testing::expect_equal<i64>(1, 1 / 1);
}
