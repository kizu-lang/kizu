import std::mem;
import std::string;
import std::testing;

// A `for` index is a value. A later local of the same name that lives in
// storage, because a method writes through it, does not change how the index
// is read.
test "a for index shares its name with a later local that has storage" {
    let allocator = mem::page_allocator();
    var total: i64 = 0;
    for 0..4 |row| {
        total = total + row;
    }
    var row = string::new(allocator);
    defer row.deinit(allocator);
    try row.append_bytes(allocator, "ab");
    testing::expect_equal<i64>(6, total);
    testing::expect_equal<i64>(2, row.len());
}

// The same holds when the local comes first and the loop reuses its name
// after the local's scope has ended.
test "a for index shares its name with an earlier local that has storage" {
    let allocator = mem::page_allocator();
    var length: i64 = 0;
    if true {
        var row = string::new(allocator);
        defer row.deinit(allocator);
        try row.append_bytes(allocator, "abc");
        length = row.len();
    }
    var total: i64 = 0;
    for 1..4 |row| {
        total = total + row;
    }
    testing::expect_equal<i64>(3, length);
    testing::expect_equal<i64>(6, total);
}
