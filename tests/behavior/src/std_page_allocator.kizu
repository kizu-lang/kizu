import std::arena;
import std::array;
import std::map;
import std::mem;
import std::string;
import std::testing;

struct User {
    pub name: []u8,
}

test "std page allocator" {
    let allocator = mem::page_allocator();

    let values = array::new<i64>(allocator);
    defer values.deinit();

    var text = string::new(allocator);
    defer text.deinit();

    let names = map::new<[]u8, i64>(allocator);
    defer names.deinit();

    let users = arena::new<User>(allocator);
    defer users.deinit();

    try values.append(41);
    try values.append(1);
    testing::expect_equal<i64>(2, values.len());
    testing::expect_equal<i64>(41, values.get_or_panic(0));

    try text.append_bytes("page");
    try text.append_byte(cast<u8>(45));
    try text.append_bytes("allocator");
    testing::expect_equal<i64>(14, text.len());

    try names.insert("values", values.len());
    testing::expect_equal<i64>(2, names.get("values") orelse -1);

    let alice = users.add(User { name: "alice" });
    testing::expect_equal<[]u8>("alice", users.get(alice).name);

    let more = array::new<i64>(allocator);
    defer more.deinit();
    try more.append(42);
    testing::expect_equal<i64>(42, more.get_or_panic(0));
}
