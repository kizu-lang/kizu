// The behavior suite is one package so that it links once and runs once.
//
// A case belongs here when what it checks is an assertion about the language,
// not a program worth reading. `examples/` keeps the ones whose output is the
// point; those still run one at a time, which is what makes them examples.
//
// Each module is its own namespace, so two cases may both declare `User`
// without either having to be renamed.
test "behavior suite is reachable" {
    std::testing::expect(true);
}
