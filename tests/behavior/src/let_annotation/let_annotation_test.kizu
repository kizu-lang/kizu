import std::mem;
import std::string;
import std::testing;

// A declared type is the initializer's context, under the rules an argument
// has: `null` and a bare literal take their type from it, a plain value wraps
// into a declared `?T`, and a type that already matches is a check.

test "a declared optional starts empty and takes a value later" {
    var found: ?i64 = null;
    testing::expect_equal<i64>(-1, found orelse -1);
    found = 7;
    testing::expect_equal<i64>(7, found orelse -1);
    found = null;
    testing::expect_equal<i64>(-1, found orelse -1);
}

test "a declared width types the literal" {
    let byte: u8 = 255;
    testing::expect(byte == 255);
    let half: f32 = 1.5;
    testing::expect(half * 2.0 == 3.0);
    let negative: i32 = -8;
    testing::expect(negative + 8 == 0);
}

test "a plain value wraps into a declared optional" {
    let wide: ?i64 = 9;
    testing::expect_equal<i64>(9, wide orelse 0);
    let flag: ?bool = true;
    testing::expect(flag orelse false);
}

test "a declared type that matches is a check and nothing more" {
    let allocator = mem::page_allocator();
    var text: string::String = string::new(allocator);
    defer text.deinit(allocator);
    try text.append_bytes(allocator, "kizu");
    let view: []u8 = text.as_bytes();
    testing::expect_equal<[]u8>("kizu", view);
    let count: i64 = text.len();
    testing::expect_equal<i64>(4, count);
}
