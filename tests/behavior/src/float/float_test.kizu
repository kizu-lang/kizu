import std::float;
import std::testing;

fn mean(a: f64, b: f64) -> f64 {
    return (a + b) / 2.0;
}

fn as_f32(value: f32) -> f32 {
    return value;
}

test "float arithmetic and comparison follow IEEE 754" {
    testing::expect(mean(1.0, 2.0) == 1.5);
    testing::expect(0.1 + 0.2 != 0.3);
    testing::expect(1.0 / 3.0 * 3.0 == 1.0);
    let inf = 1.0 / 0.0;
    testing::expect(inf > 1e22 * 1e22);
    testing::expect(-inf < 0.0);
    let nan = 0.0 / 0.0;
    testing::expect(nan != nan);
    testing::expect(!(nan == nan));
    testing::expect(!(nan < 1.0));
    testing::expect(!(nan >= 1.0));
    testing::expect(-(2.0) == 0.0 - 2.0);
}

test "casts round, truncate, and saturate" {
    testing::expect(cast<f64>(7) == 7.0);
    testing::expect(cast<f64>(cast<u64>(1) << 63) == cast<f64>(cast<u64>(1) << 62) * 2.0);
    testing::expect_equal<i64>(2, cast<i64>(2.9));
    testing::expect_equal<i64>(-2, cast<i64>(-2.9));
    testing::expect_equal<i64>(9223372036854775807, cast<i64>(1e22));
    testing::expect_equal<i64>(-9223372036854775807 - 1, cast<i64>(-1e22));
    testing::expect_equal<i64>(0, cast<i64>(0.0 / 0.0));
    testing::expect(cast<u8>(-1.0) == 0);
    testing::expect(cast<u8>(255.9) == 255);
    testing::expect(cast<i32>(1e10) == 2147483647);
    testing::expect(cast<f64>(cast<f32>(0.1)) != 0.1);
    testing::expect(cast<f64>(cast<f32>(0.5)) == 0.5);
}

test "literals take f32 from context" {
    let small = as_f32(1.5);
    testing::expect(small * 2.0 == 3.0);
    testing::expect(2.0 * small == 3.0);
    testing::expect(small < 2.0);
    testing::expect(cast<f64>(small) == 1.5);
    testing::expect(1_000.5 == 1000.5);
    testing::expect(2.5E3 == 2500.0);
    testing::expect(1e-3 * 1000.0 == 1.0);
}

test "bits round-trip through std::float" {
    testing::expect(float::bits(0.0) == 0);
    testing::expect(float::bits(1.0) == 0x3FF0000000000000);
    testing::expect(float::bits(-2.0) == cast<u64>(1) << 63 | 0x4000000000000000);
    testing::expect(float::from_bits(float::bits(0.1)) == 0.1);
    testing::expect(float::from_bits(0x7FF0000000000000) == 1.0 / 0.0);
}
