import std::float;
import std::math;
import std::testing;

// A function whose result is chosen by a comparison returns the value the
// taken branch names, for every input the comparison can see: halves on
// either side, signed zeros, infinities and NaN, which compares false.

fn round_bits(value: f64) -> u64 {
    return float::bits(math::round<f64>(value));
}

fn clamp_unit(value: f64) -> f64 {
    if value < 0.0 {
        return 0.0;
    }
    if value > 1.0 {
        return 1.0;
    }
    return value;
}

fn sign(value: i64) -> i64 {
    if value < 0 {
        return -1;
    }
    if value > 0 {
        return 1;
    }
    return 0;
}

fn step_toward(from: f64, to: f64, by: f64) -> f64 {
    var next = from;
    if from < to {
        next = from + by;
    } else {
        next = from - by * 0.5;
    }
    return next * 2.0;
}

fn half_or_twice(value: f32) -> f32 {
    if value >= 1.0 {
        return value * 0.5;
    }
    return value + value;
}

test "round picks the nearest whole away from zero at halves" {
    let inputs = [10]f64{ 0.5, -0.5, 1.5, -2.5, 2.4999999999999996, -0.3, 0.0, 7.0, 4503599627370497.0, -1.75 };
    let wants = [10]f64{ 1.0, -1.0, 2.0, -3.0, 2.0, -0.0, 0.0, 7.0, 4503599627370497.0, -2.0 };
    for 0..10 |k| {
        testing::expect_equal<u64>(float::bits(wants[k]), round_bits(inputs[k]));
    }
}

test "round keeps signed zeros, infinities and NaN" {
    testing::expect_equal<u64>(float::bits(-0.0), round_bits(-0.0));
    testing::expect_equal<u64>(float::bits(-0.0), round_bits(-0.49));
    testing::expect_equal<u64>(float::bits(math::infinity<f64>()), round_bits(math::infinity<f64>()));
    testing::expect_equal<u64>(float::bits(-math::infinity<f64>()), round_bits(-math::infinity<f64>()));
    testing::expect(float::is_nan(math::round<f64>(math::nan<f64>())));
    testing::expect(math::round<f32>(-2.5) == -3.0);
}

test "a chain of returns picks the first comparison that holds" {
    testing::expect_equal<f64>(0.0, clamp_unit(-3.0));
    testing::expect_equal<f64>(1.0, clamp_unit(3.0));
    testing::expect_equal<f64>(0.25, clamp_unit(0.25));
    testing::expect_equal<u64>(float::bits(-0.0), float::bits(clamp_unit(-0.0)));
    testing::expect(float::is_nan(clamp_unit(math::nan<f64>())));
    testing::expect_equal<f64>(1.0, clamp_unit(math::infinity<f64>()));
    let values = [5]i64{ -7, 0, 9, -1, 1 };
    let wants = [5]i64{ -1, 0, 1, -1, 1 };
    for 0..5 |k| {
        testing::expect_equal<i64>(wants[k], sign(values[k]));
    }
}

test "a float value chosen by a branch is the branch's value" {
    testing::expect_equal<f64>(4.0, step_toward(1.0, 5.0, 1.0));
    testing::expect_equal<f64>(9.0, step_toward(5.0, 1.0, 1.0));
    testing::expect_equal<f64>(9.0, step_toward(5.0, 5.0, 1.0));
    testing::expect(float::is_nan(step_toward(math::nan<f64>(), 1.0, 1.0)));
    testing::expect(half_or_twice(3.0) == 1.5);
    testing::expect(half_or_twice(0.5) == 1.0);
    testing::expect(float::is_nan(cast<f64>(half_or_twice(math::nan<f32>()))));
}
