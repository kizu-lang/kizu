import std::testing;

// A loop keeps what it does: the values read after it, the writes it makes
// through a borrow, and the checks it runs on every turn, whether or not the
// turns compute anything else.

fn bump(total: &var i64) -> void {
    total.* = total.* + 1;
}

test "a counter read after its loop holds the last count" {
    var i = 0;
    while i < 1000 {
        i = i + 1;
    }
    testing::expect_equal<i64>(1000, i);
}

test "an accumulator read after its loop holds every turn" {
    var sum = 0;
    for 0..10 |k| {
        sum = sum + k;
    }
    testing::expect_equal<i64>(45, sum);
}

test "a write through a borrow happens on every turn" {
    var total = 0;
    for 0..5 |k| {
        bump(&var total);
    }
    testing::expect_equal<i64>(5, total);
}

test "a counter stepping by two stops past its bound" {
    var j = 0;
    while j < 9 {
        j = j + 2;
    }
    testing::expect_equal<i64>(10, j);
}

test "loops that compute nothing leave the code after them as it was" {
    for 0..100000 |k| {
        let _ = k * 3;
    }
    for 0..300 |a| {
        for 0..300 |b| {
            let _ = a + b;
        }
    }
    var after = 0;
    for 100..5 |k| {
        after = after + k;
    }
    testing::expect_equal<i64>(0, after);
}
