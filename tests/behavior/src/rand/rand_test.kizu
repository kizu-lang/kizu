import std::rand;
import std::testing;

fn draws_match(seed: i64, count: i64) -> bool {
    var left = rand::new(seed);
    var right = rand::new(seed);
    var index = 0;
    while index < count {
        if left.next() != right.next() {
            return false;
        }
        index = index + 1;
    }
    return true;
}

fn all_below(seed: i64, bound: i64, count: i64) -> bool {
    var rng = rand::new(seed);
    var index = 0;
    while index < count {
        let value = rng.below(bound);
        if value < 0 or value >= bound {
            return false;
        }
        index = index + 1;
    }
    return true;
}

test "same seed gives the same sequence" {
    testing::expect(draws_match(42, 1000));
    testing::expect(draws_match(-9223372036854775807, 100));
    testing::expect(draws_match(0, 100));
}

test "different seeds diverge from the first draw" {
    var a = rand::new(1);
    var b = rand::new(2);
    testing::expect(a.next() != b.next());
    var known = rand::new(42);
    testing::expect_equal<i64>(2350856279, known.next());
}

test "next stays in range" {
    var rng = rand::new(3);
    var index = 0;
    var max = 0;
    while index < 10000 {
        let value = rng.next();
        testing::expect(value >= 0);
        testing::expect(value <= 4294967086);
        if value > max {
            max = value;
        }
        index = index + 1;
    }
    testing::expect(max > 4000000000);
}

test "below covers every value of a small range" {
    testing::expect(all_below(5, 1, 100));
    testing::expect(all_below(5, 7, 1000));
    var rng = rand::new(11);
    var seen = 0;
    var hits = 0;
    var index = 0;
    while index < 200 {
        let value = rng.below(4);
        if value == 0 { hits = hits + 1; }
        if value == 3 { seen = seen + 1; }
        index = index + 1;
    }
    testing::expect(hits > 0);
    testing::expect(seen > 0);
}
