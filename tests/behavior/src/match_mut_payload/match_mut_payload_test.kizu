import std::mem;
import std::string;
import std::testing;

// SPEC §6.8: a match through a `&var` place -- `&var self`, or a field of
// it -- binds an owner payload as a `&var` borrow of where it lies, so the
// arm can call the payload's `&var self` methods and the change is seen
// through the union afterwards. A `var` local matched by name still moves
// its payload out (ADR-0090).

union Stream {
    Plain(string::String),
    Secure(string::String),
}

fn (self: &var Stream) push(allocator: Allocator, byte: u8) -> mem::Error!void {
    match self {
        Plain(s) => {
            try s.append_byte(allocator, byte);
        },
        Secure(s) => {
            try s.append_byte(allocator, byte);
            try s.append_byte(allocator, byte);
        },
    }
    return;
}

fn (self: &var Stream) grow(allocator: Allocator) -> mem::Error!i64 {
    let added = match self {
        Plain(s) => {
            try s.append_byte(allocator, 66);
            1
        },
        Secure(s) => {
            try s.append_byte(allocator, 67);
            try s.append_byte(allocator, 67);
            2
        },
    };
    return added;
}

fn (self: &Stream) len() -> i64 {
    return match self {
        Plain(s) => s.len(),
        Secure(s) => s.len(),
    };
}

fn (self: Stream) deinit(allocator: Allocator) -> void {
    match self {
        Plain(s) => s.deinit(allocator),
        Secure(s) => s.deinit(allocator),
    }
    return;
}

struct Holder {
    stream: Stream,
    pushed: i64,
}

fn (self: &var Holder) push(allocator: Allocator, byte: u8) -> mem::Error!void {
    match self.stream {
        Plain(s) => {
            try s.append_byte(allocator, byte);
        },
        Secure(s) => {
            try s.append_byte(allocator, byte);
            try s.append_byte(allocator, byte);
        },
    }
    self.pushed = self.pushed + 1;
    return;
}

fn (self: Holder) deinit(allocator: Allocator) -> void {
    self.stream.deinit(allocator);
    return;
}

test "a match on `&var self` writes through the payload" {
    let allocator = mem::page_allocator();
    var stream = Stream::Secure(string::new(allocator));
    defer stream.deinit(allocator);
    try stream.push(allocator, 65);
    testing::expect_equal<i64>(2, stream.len());
    let added = try stream.grow(allocator);
    testing::expect_equal<i64>(2, added);
    testing::expect_equal<i64>(4, stream.len());
}

test "a match on a field of `&var self` writes through the payload" {
    let allocator = mem::page_allocator();
    var holder = Holder { stream: Stream::Plain(string::new(allocator)), pushed: 0 };
    defer holder.deinit(allocator);
    try holder.push(allocator, 65);
    try holder.push(allocator, 66);
    testing::expect_equal<i64>(2, holder.pushed);
    testing::expect_equal<i64>(2, holder.stream.len());
}

test "a match on a field of a `var` local writes through the payload" {
    let allocator = mem::page_allocator();
    var holder = Holder { stream: Stream::Secure(string::new(allocator)), pushed: 0 };
    defer holder.deinit(allocator);
    match holder.stream {
        Plain(s) => {
            try s.append_byte(allocator, 65);
        },
        Secure(s) => {
            try s.append_bytes(allocator, "abc");
        },
    }
    testing::expect_equal<i64>(3, holder.stream.len());
}
