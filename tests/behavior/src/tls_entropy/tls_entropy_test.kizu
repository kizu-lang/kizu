import std::array;
import std::crypto::x509;
import std::fmt;
import std::http;
import std::io;
import std::mem;
import std::net;
import std::string;
import std::testing;
import std::tls;

// A connection draws every random byte of its handshake from its
// `tls::Entropy`, so two connections over the same predictable seed send
// the same bytes. Both ends are Kizu here, each with its own seed, and a
// relay between them keeps what each direction sent. If either end drew one
// byte from the host's source instead -- the hello's random, a key share, the
// RSA-PSS salt -- the second connection would differ from the first.
//
// The certificates are self-signed for localhost, one over a P-256 key and
// one over a 2048-bit RSA key, valid from 2026-11-13 to 2049-11-12, written
// by LibreSSL 3.3.6's `openssl req -x509`; the keys are PKCS #8. The RSA
// one matters on its own: the CertificateVerify's salt is drawn for every
// key but read only by RSA-PSS.

error Failure = tls::Failure or http::Failure or io::Error or mem::Error;

enum KeyKind {
    P256,
    Rsa,
}

fn certificate_pem(kind: KeyKind) -> []u8 {
    if kind == KeyKind::P256 {
        return p256_certificate();
    }
    return rsa_certificate();
}

// The keys are their PKCS #8 DER in hex.
fn key_hex(kind: KeyKind) -> []u8 {
    if kind == KeyKind::P256 {
        return p256_key();
    }
    return rsa_key();
}

