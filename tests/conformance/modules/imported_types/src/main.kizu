import app::token;

pub struct Slot {
    pub kind: token::TokenKind;
    pub token: token::Token;
}

pub extern "kizu_test" fn current() -> token::Token

pub fn accept(kind: token::TokenKind, token_value: token::Token) -> void {
    return;
}

pub fn main() -> void {
    let kind = token::TokenKind::Ident;
    let value = token::Token { kind: kind, start: 0, end: 1 };
    token::ready();
    accept(kind, value);
    return;
}
