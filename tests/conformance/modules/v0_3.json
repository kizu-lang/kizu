{
  "version": "v0.3-modules",
  "cases": [
    {
      "name": "basic",
      "mode": "check",
      "path": "tests/conformance/modules/basic",
      "root_source": "tests/conformance/modules/basic/src/main.kizu",
      "features": ["module-graph", "import", "pub", "multi-file-check"]
    },
    {
      "name": "missing_import",
      "mode": "error",
      "path": "tests/conformance/modules/missing_import",
      "root_source": "tests/conformance/modules/missing_import/src/main.kizu",
      "stderr_contains": "missing module `app::missing`",
      "features": ["module-graph", "import", "diagnostics"]
    },
    {
      "name": "private_module_access",
      "mode": "error",
      "path": "tests/conformance/modules/private_module_access",
      "root_source": "tests/conformance/modules/private_module_access/src/main.kizu",
      "stderr_contains": "private declaration `lexer::hidden` is not visible",
      "features": ["module-graph", "visibility", "diagnostics"]
    },
    {
      "name": "private_type_leak",
      "mode": "error",
      "path": "tests/conformance/modules/private_type_leak",
      "root_source": "tests/conformance/modules/private_type_leak/src/main.kizu",
      "stderr_contains": "public signature exposes private type `lexer::Secret`",
      "features": ["module-graph", "visibility", "diagnostics"]
    },
    {
      "name": "private_field_construction",
      "mode": "error",
      "path": "tests/conformance/modules/private_field_construction",
      "root_source": "tests/conformance/modules/private_field_construction/src/main.kizu",
      "stderr_contains": "private field `app::lexer::Token.secret` is not visible",
      "features": ["module-graph", "visibility", "diagnostics"]
    }
  ]
}
