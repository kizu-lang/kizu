{
  "version": "v0.3-modules",
  "cases": [
    {
      "name": "basic",
      "mode": "check",
      "path": "tests/conformance/modules/basic",
      "root_source": "tests/conformance/modules/basic/src/main.kizu",
      "features": ["module-graph", "import", "pub", "multi-file-check"]
    },
    {
      "name": "missing_import",
      "mode": "error",
      "path": "tests/conformance/modules/missing_import",
      "root_source": "tests/conformance/modules/missing_import/src/main.kizu",
      "stderr_contains": "missing module `app::missing`",
      "features": ["module-graph", "import", "diagnostics"]
    }
  ]
}
