{
  "version": "v0.2",
  "cases": [
    {
      "name": "std_mem",
      "mode": "run",
      "path": "examples/std_mem.kizu",
      "stdout": "15\ntrue\ntrue\nlexer token\nlexer\n108\n",
      "features": ["std-mem", "[]const u8", "error-union"]
    },
    {
      "name": "negative_std_mem_wrong_type",
      "mode": "error",
      "command": "check",
      "path": "examples/negative/std_mem_wrong_type.kizu",
      "stderr_contains": "expects []const u8",
      "features": ["std-mem", "type-check"]
    },
    {
      "name": "negative_std_mem_slice_out_of_bounds",
      "mode": "error",
      "command": "run",
      "path": "examples/negative/std_mem_slice_out_of_bounds.kizu",
      "stderr_contains": "range out of bounds",
      "features": ["std-mem", "bounds", "error-union"]
    },
    {
      "name": "negative_std_mem_byte_at_out_of_bounds",
      "mode": "error",
      "command": "run",
      "path": "examples/negative/std_mem_byte_at_out_of_bounds.kizu",
      "stderr_contains": "index out of bounds",
      "features": ["std-mem", "bounds", "error-union"]
    }
  ]
}
