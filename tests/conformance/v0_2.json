{
  "version": "v0.2",
  "cases": [
    {
      "name": "std_mem",
      "mode": "run",
      "path": "examples/std_mem.kizu",
      "stdout": "15\ntrue\ntrue\nlexer token\nlexer\n108\n",
      "features": ["std-mem", "[]const u8", "error-union"]
    },
    {
      "name": "std_array",
      "mode": "run",
      "path": "examples/std_array.kizu",
      "stdout": "2\n2\n10\n32\n",
      "features": ["std-array", "allocator", "error-union"]
    },
    {
      "name": "std_array_token_list",
      "mode": "run",
      "path": "examples/std_array_token_list.kizu",
      "stdout": "2\nTokenKind::Ident\nTokenKind::Number\n",
      "features": ["std-array", "self-host", "enum"]
    },
    {
      "name": "std_array_borrow",
      "mode": "run",
      "path": "examples/std_array_borrow.kizu",
      "stdout": "let\nvar\n",
      "features": ["std-array", "borrow", "mutation"]
    },
    {
      "name": "negative_std_mem_wrong_type",
      "mode": "error",
      "command": "check",
      "path": "examples/negative/std_mem_wrong_type.kizu",
      "stderr_contains": "expects []const u8",
      "features": ["std-mem", "type-check"]
    },
    {
